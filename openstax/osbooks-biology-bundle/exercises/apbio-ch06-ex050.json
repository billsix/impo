   "stimulus_html": "",
   "stem_html": "Why is ATP considered the energy currency of the cell?",
   "answers": [
    {
     "id": 1005302,
     "content_html": "It accepts energy from chemical reactions."
    },
    {
     "id": 1005303,
     "content_html": "It holds energy at the site of release from substrates."
    },
    {
     "id": 1005304,
     "content_html": "It is a protein."
    },
    {
     "id": 1005305,
     "content_html": "It can transport energy to locations within the cell."
    }
