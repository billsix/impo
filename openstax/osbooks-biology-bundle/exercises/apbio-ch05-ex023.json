 "questions": [
  {
   "id": 334198,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What will happen to the opening of the sodium-potassium pump if no ATP is present in a cell?",
   "answers": [
    {
     "id": 842459,
     "content_html": "It will remain facing the extracellular space, with sodium ions bound."
    },
    {
     "id": 842460,
     "content_html": "It will remain facing the extracellular space, with potassium ions bound."
    },
    {
     "id": 842461,
     "content_html": "It will remain facing the cytoplasm, but no sodium ions would bind."
    },
    {
     "id": 842462,
     "content_html": "It will remain facing the cytoplasm, with sodium ions bound."
    }
   ],
