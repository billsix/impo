 "questions": [
  {
   "id": 285897,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "According to the findings of the Urey and Miller experiment, the primitive atmosphere consisted of water in the form of steam, methane, ammonia, and hydrogen gases. If there was so much hydrogen gas in the early atmosphere, why is there so little now?",
   "answers": [
    {
     "id": 820002,
     "content_html": "Hydrogen gas is so light with a molecular weight of 1 that the excess diffused into space over time and is now absent from the atmosphere."
    },
    {
     "id": 820003,
     "content_html": "Hydrogen combined with ammonia to make ammonium."
    },
    {
     "id": 820004,
     "content_html": "It was all used up in the production of organic molecules."
    },
    {
     "id": 820005,
     "content_html": "The excess hydrogen gas was dissolved in the early oceans."
    }
   ],
