 "questions": [
  {
   "id": 232616,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Consider that the number of ATP molecules formed through cellular respiration varies. Identify the claim that accounts for these differences.",
   "answers": [
    {
     "id": 720609,
     "content_html": "The ATPs produced are immediately utilized in the anaplerotic reactions that are used for the replenishment of the intermediates."
    },
    {
     "id": 720608,
     "content_html": "Most of the ATPs produced are rapidly used for the phosphorylation of certain compounds found in plants."
    },
    {
     "id": 720610,
     "content_html": "Transport of NADH from cytosol to mitochondria is an active process that decreases the number of ATPs produced."
    },
    {
     "id": 720607,
     "content_html": "A large number of ATP molecules are used in the detoxification of xenobiotic compounds produced during cellular respiration."
    }
   ],
