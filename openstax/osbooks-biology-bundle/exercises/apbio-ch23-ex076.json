   "id": 520059,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If green light was used rather than white light to irradiate a sunflower seedling, what would happen?",
   "answers": [
    {
     "id": 1015725,
     "content_html": "Green light is absorbed by the plant. The seedling would not bend, but it would grow tall and spindly as if grown in the dark."
    },
    {
     "id": 1015726,
     "content_html": "Green light is not absorbed by the plant. The seedling would not bend, but it would grow tall and spindly as if grown in the dark."
    },
    {
     "id": 1015727,
     "content_html": "Green light is not absorbed by the plant. The seedling would not grow tall and spindly, but it would bend."
    },
    {
