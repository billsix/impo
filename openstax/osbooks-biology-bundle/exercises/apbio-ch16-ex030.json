 "questions": [
  {
   "id": 522278,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Gene A is thought to be associated with color blindness. The protein corresponding to gene A is isolated. Analysis of the protein recovered shows there are actually two different proteins that differ in molecular weight that correspond to gene A. What is one reason why there may be two proteins corresponding to the gene?",
   "answers": [
    {
     "id": 1021993,
     "content_html": "One protein had a 5’ cap and a poly-A tail in its mRNA, and the other protein did not."
    },
    {
     "id": 1021994,
     "content_html": "One protein had a 5’ UTR and a 3’ UTR in its RNA, and the other protein did not."
    },
    {
     "id": 1021995,
     "content_html": "The gene was alternatively spliced."
    },
    {
     "id": 1021996,
     "content_html": "The gene produced mRNA molecules with differing stability."
    }
   ],
