   "id": 285899,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is DNA replication like an assembly line?",
   "answers": [
    {
     "id": 820010,
     "content_html": "It consists of many biochemical machines that functions specifically in order to drive a specific action like an assembly line."
    },
    {
     "id": 820011,
     "content_html": "It consists of many biochemical machines that have the same function in order to drive a specific action like an assembly line."
    },
    {
     "id": 820012,
     "content_html": "It consists of many biochemical machines where each functions randomly in order to drive a specific action like an assembly line."
    },
    {
     "id": 820013,
     "content_html": "It consists of many biochemical machines that functions in order to drive a non-specific action like an assembly line."
    }
   ],
