 "questions": [
  {
   "id": 529581,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/58af426b5ac5701e.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Alex Yartsev/Deranged Physiology)</figcaption>\n</figure>\n",
   "stem_html": "<p>The graphs show the pressure and volume changes in normal rabbits, and rabbits whose lung surfactant was removed.</p>\n<p>What is the effect of removing the surfactant from the lungs?</p>",
   "answers": [
    {
     "id": 1036372,
     "content_html": "The lungs inflate to same volume, but their highest pressure is lower."
    },
    {
     "id": 1036373,
     "content_html": "When inflated, the lungs have the same pressure, but their volume is lower."
    },
    {
     "id": 1036374,
     "content_html": "When inflated, the lungs have both lower pressure and lower volume."
    },
    {
     "id": 1036375,
     "content_html": "The lungs can inflate to the  same volume and pressure as before."
    }
   ],
