 "questions": [
  {
   "id": 529719,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is one advantage of a four chambered heart over a three chambered heart?",
   "answers": [
    {
     "id": 1036812,
     "content_html": "Oxygenated blood carried by the right side of the heart is completely separated from the left side carrying deoxygenated blood, which assists in more efficient movement of oxygen around the body and aids in allowing the body to quickly move when needed."
    },
    {
     "id": 1036813,
     "content_html": "A four-chambered heart keeps oxygenated and deoxygenated blood separated and has double circulation whereas a three-chambered heart has a single circulation. This assists in more efficient movement of oxygen around the body."
    },
    {
     "id": 1036814,
     "content_html": "Oxygenated and deoxygenated blood are kept separate in a four-chambered heart, which assists in more efficient movement of carbon dioxide around the body."
    },
    {
     "id": 1036815,
     "content_html": "Oxygenated and deoxygenated blood are kept separate in a four-chambered heart, which assists in more efficient movement of oxygen around the body and aids in allowing the body to move quickly when needed."
    }
