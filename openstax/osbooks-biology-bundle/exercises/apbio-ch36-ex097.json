   "stimulus_html": "",
   "stem_html": "Describe phototaxis.",
   "answers": [
    {
     "id": 1249155,
     "content_html": "Phototaxis is the directed movement of an organism in response to gravity."
    },
    {
     "id": 1249154,
     "content_html": "Phototaxis is the long-range movement of an organism in response to a change in season."
    },
    {
     "id": 1249153,
     "content_html": "Phototaxis is the movement of an organism in search of food."
    },
    {
     "id": 1249156,
     "content_html": "Phototaxis is the directed movement of an organism in response to light."
    }
   ],
