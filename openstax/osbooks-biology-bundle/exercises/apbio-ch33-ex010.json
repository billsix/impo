 "questions": [
  {
   "id": 535161,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the complement system?",
   "answers": [
    {
     "id": 1047152,
     "content_html": "The complement system contains macrophages that phagocytize foreign pathogens."
    },
    {
     "id": 1047153,
     "content_html": "The complement system monitors MHC I molecules on cells and destroys any cell that displays an antigen belonging to a pathogen."
    },
    {
     "id": 1047154,
     "content_html": "The complement system contains a group of about 20 proteins in the blood that attack pathogens in a cascading fashion to mark and destroy them."
    },
    {
     "id": 1047155,
     "content_html": "The complement system is made up of antibodies specific to each pathogen that are synthesized when a pathogen enters the body."
    }
   ],
