   "id": 534658,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/4ce674fbed36a8d0.jpg\" alt=\"Illustration of a wound site on the wall of a blood vessel with fibrinogen collecting at the site and a pointer labeling the area “clot.”\"></p>\n\n<p>The diagram shows a fibrin clot forming within a blood vessel. What constituents of the blood interact to form the clot?</p>\n",
   "answers": [
    {
     "id": 1045436,
     "content_html": "red blood cells, serum, and vitamin K"
    },
    {
     "id": 1045437,
     "content_html": "ribrin, megakaryocytes and blood proteins"
    },
    {
     "id": 1045438,
     "content_html": "granulocytes, platelets and red blood cells"
    },
    {
     "id": 1045439,
     "content_html": "platelets, fibrinogen, and clotting factors"
    }
   ],
