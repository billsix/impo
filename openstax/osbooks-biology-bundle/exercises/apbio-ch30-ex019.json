 "questions": [
  {
   "id": 529231,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What does FEV1/FVC measure and why will the ratio increase with lung fibrosis?",
   "answers": [
    {
     "id": 1035908,
     "content_html": "the forced expiratory volume in one second in relation to the total forced vital capacity; lung fibrosis causes the lungs to decrease in size"
    },
    {
     "id": 1035909,
     "content_html": "the functional expiratory volume in one second in relation to the total functional vital capacity; lung fibrosis causes the lungs to decrease in size"
    },
    {
     "id": 1035910,
     "content_html": "the functional expiratory volume in one second in relation to the total functional vital capacity; lung fibrosis causes the lungs to become less pliable"
    },
    {
     "id": 1035911,
     "content_html": "the forced expiratory volume in one second in relation to the total forced vital capacity; lung fibrosis causes the lungs to become less pliable"
    }
   ],
