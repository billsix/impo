 "questions": [
  {
   "id": 519854,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does selective uptake of water and mineral take place in a root?",
   "answers": [
    {
     "id": 1014939,
     "content_html": "Water and minerals must follow entirely a path between cells, where selectivity occurs."
    },
    {
     "id": 1014940,
     "content_html": "Water and minerals must follow entirely a path between cells, where no selectivity occurs."
    },
    {
     "id": 1014941,
     "content_html": "Water and minerals must cross the endodermis."
    },
    {
     "id": 1014942,
     "content_html": "Water and minerals must cross the tracheids of the xylem."
    }
   ],
