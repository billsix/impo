 "questions": [
  {
   "id": 640240,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The bones of the human skeleton are classified by their shapes. How does the structure of sesamoid bones differ from that of short bones?",
   "answers": [
    {
     "id": 1248460,
     "content_html": "Sesamoid bones are small and flat, whereas short bones are approximately equal in height and width."
    },
    {
     "id": 1248459,
     "content_html": "Sesamoid bones are thin and broad, whereas short bones have a central shaft and two ends."
    },
    {
     "id": 1248458,
     "content_html": "Sesamoid bones are small, flat, and irregularly shaped, whereas short bones are cuboidal in shape."
    },
    {
     "id": 1248457,
     "content_html": "Sesamoid bones are thin and broad, whereas short bones are small and flat."
    }
   ],
