   "stimulus_html": "",
   "stem_html": "Which molecule carries information in a form that is inherited from one generation to another?",
   "answers": [
    {
     "id": 719194,
     "content_html": "Hereditary information is stored in DNA."
    },
    {
     "id": 719193,
     "content_html": "Hereditary information is stored in mRNA."
    },
    {
     "id": 719192,
     "content_html": "Hereditary information is stored in proteins."
    },
    {
     "id": 719191,
     "content_html": "Hereditary information is stored in tRNA."
