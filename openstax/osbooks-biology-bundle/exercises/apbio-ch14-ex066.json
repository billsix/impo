 "questions": [
  {
   "id": 509179,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A mutation has occurred in the DNA and in the mRNA for a gene. Discuss which would have a more significant effect on gene expression. Why?",
   "answers": [
    {
     "id": 996952,
     "content_html": "Both will result in the production of defective proteins. The DNA mutation, if not corrected, is permanent, while the mRNA mutation will only affect proteins made from that mRNA strand. Production of defective protein ceases when the mRNA strand deteriorates."
    },
    {
     "id": 996953,
     "content_html": "Both will result in the production of defective proteins. The DNA mutation, if not corrected, is permanent, while the mRNA mutation will not affect proteins made from that mRNA strand. Production of defective protein continues when the mRNA strand deteriorates."
    },
    {
     "id": 996954,
     "content_html": "Only DNA will result in the production of defective proteins. The DNA mutation, if not corrected, is permanent. Production of defective protein ceases when the DNA strand deteriorates."
    },
    {
     "id": 996955,
     "content_html": "Only mRNA will result in the production of defective proteins. The mRNA mutation will only affect proteins made from that mRNA strand. Production of defective protein ceases when the mRNA strand deteriorates."
    }
   ],
