 "questions": [
  {
   "id": 503091,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the connection between anabolic and catabolic chemical reactions in a metabolic pathway.",
   "answers": [
    {
     "id": 988495,
     "content_html": "Catabolic reactions produce energy and simpler compounds, whereas anabolic reactions involve the use of energy to make more complex compounds."
    },
    {
     "id": 988496,
     "content_html": "Catabolic reactions produce energy and complex compounds are formed, whereas in anabolic reactions free energy is utilized by complex compounds to make simpler molecules."
    },
    {
     "id": 988497,
     "content_html": "Catabolic reactions utilize energy and gives simpler compounds, whereas in anabolic reactions, energy is produced and simpler compounds are used to make complex molecules."
    },
    {
     "id": 988498,
     "content_html": "Catabolic reactions produce energy and water molecules, whereas in anabolic reactions this free energy is utilized by simpler compounds to make only proteins and nucleic acids."
    }
   ],
