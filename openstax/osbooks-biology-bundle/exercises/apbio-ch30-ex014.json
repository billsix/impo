   "id": 529135,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What kinds of injuries or disease could spirometry best detect?",
   "answers": [
    {
     "id": 1035828,
     "content_html": "infections of the trachea, larynx or pharynx"
    },
    {
     "id": 1035829,
     "content_html": "a decrease in the capacity of the lungs to hold air"
    },
    {
     "id": 1035830,
     "content_html": "mucus buildup in the nasal cavities"
    },
    {
     "id": 1035831,
     "content_html": "a reduction in alveoli in the lungs"
    }
   ],
