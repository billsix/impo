 "questions": [
  {
   "id": 520157,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Storage facilities for fruits and vegetables are usually refrigerated and well ventilated. Why are these conditions advantageous?",
   "answers": [
    {
     "id": 1016115,
     "content_html": "Refrigeration slows chemical reactions, including fruit ripening. Ventilation adds the ethylene gas that speeds up fruit maturation."
    },
    {
     "id": 1016116,
     "content_html": "Refrigeration slows chemical reactions, including fruit maturation. Ventilation removes the ethylene gas that reduces fruit ripening."
    },
    {
     "id": 1016117,
     "content_html": "Refrigeration slows chemical reactions, including fruit maturation. Ventilation removes the ethylene gas that speeds up fruit ripening."
    },
    {
     "id": 1016118,
     "content_html": "Refrigeration removes the ethylene gas that speeds up fruit ripening. Ventilation slows chemical reactions, including fruit maturation."
    }
