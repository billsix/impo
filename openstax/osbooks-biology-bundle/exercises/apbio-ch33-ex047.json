 "questions": [
  {
   "id": 535520,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A person given a flu vaccine in November comes down with a severe case of influenza in January. What can you conclude about the flu vaccine and cross reactivity?",
   "answers": [
    {
     "id": 1048376,
     "content_html": "The flu vaccine elicited antibodies in the person’s body that were specific to a particular flu virus. Unfortunately, the flu virus that infected the person later in January was different enough for cross reactivity to occur between the virus antigens causing the infection."
    },
    {
     "id": 1048377,
     "content_html": "The flu vaccine suppresses antibodies in the person’s body that were specific to a particular flu virus. Unfortunately, the flu virus that infected the person later in January was different enough for cross reactivity to occur between the virus antigens causing the infection."
    },
    {
     "id": 1048378,
     "content_html": "The flu vaccine suppresses antibodies in the person’s body that were specific to a particular flu virus. Unfortunately, the flu virus that infected the person later in January was similar enough for cross reactivity to occur between the virus antigens causing the infection."
    },
    {
     "id": 1048379,
     "content_html": "The flu vaccine suppresses antibodies in the person’s body that were specific to a particular flu virus. Unfortunately, the flu virus that infected the person later in January was similar enough for cross reactivity to occur between the virus antigens causing the infection."
    }
