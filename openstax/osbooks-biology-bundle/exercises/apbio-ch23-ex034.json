 "questions": [
  {
   "id": 519810,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/cfcc5e90ad8018da.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Susan Patterson/Gardening Know How)</figcaption>\n</figure>",
   "stem_html": "<p>Girding is cutting the bark of a tree in a ring, as shown in the image. This will kill the tree.</p>\n<p>What does this tell us about trees?</p>",
   "answers": [
    {
     "id": 1014763,
     "content_html": "The bark is important for the tree's defense. Without it, the tree is open to infections and may die."
    },
    {
     "id": 1014764,
     "content_html": "Trees use their bark to control their water loss. Removing a part of the bark means the tree will lose more water than normal, leading to its death."
    },
    {
     "id": 1014765,
     "content_html": "Trees are dicots, and cutting a ring around them destroys all their phloem."
    },
    {
     "id": 1014766,
     "content_html": "The tree relies on its bark for producing energy. Without a section of its bark, the tree wil be short on ehergy."
    }
   ],
