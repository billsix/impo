  {
   "id": 511806,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The RNA world hypothesis proposes that the first complex molecule was RNA and it preceded protein formation. Which major function of the ribosomal RNA supports the hypothesis?",
   "answers": [
    {
     "id": 1000862,
     "content_html": "rRNA has catalytic properties in the large subunit and it assembles proteins."
    },
    {
     "id": 1000863,
     "content_html": "rRNA is a protein molecule that helps in the synthesis of other proteins."
    },
    {
     "id": 1000864,
     "content_html": "rRNA is essential for the transcription process."
    },
    {
     "id": 1000865,
     "content_html": "rRNA plays a major role in post-translational processes."
    }
   ],
