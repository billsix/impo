 "context": "<figure id=\"fig-ch18_03_02\"><span data-type=\"media\" id=\"fs-idp57861136\" data-alt=\" In the gradual speciation example, a founder species of bird diverges into one species with a hooked beak, and another with strait beak. Over time, the hooked beak gets longer and thinner, and the straight beak gets shorter and fatter. In the punctuated equilibrium example, as in the graduated speciation example, the founder species diverges into one species with a hooked break and another with a straight beak. However, in this case the hooked and straight beaks gives rise immediately to long, thin and short, fat beaks.\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/96a7a037aee084df2c0093f8800ea964a150ce68\" data-media-type=\"image/png\" alt=\" In the gradual speciation example, a founder species of bird diverges into one species with a hooked beak, and another with strait beak. Over time, the hooked beak gets longer and thinner, and the straight beak gets shorter and fatter. In the punctuated equilibrium example, as in the graduated speciation example, the founder species diverges into one species with a hooked break and another with a straight beak. However, in this case the hooked and straight beaks gives rise immediately to long, thin and short, fat beaks.\" width=\"525\" id=\"5\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 639836,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe a situation in which punctuated equilibrium is more likely to take place.",
   "answers": [
    {
     "id": 1246860,
     "content_html": "There is a significant change in the environment over time, such as the breakup of a supercontinent due to tectonic activity."
    },
    {
     "id": 1246861,
     "content_html": "A species that has a competitor outcompetes it and drives it to extinction, freeing up more resources."
    },
    {
     "id": 1246863,
     "content_html": "There is a sudden and significant change in the environment, such as a volcanic eruption that divides a population that once shared a habitat."
    },
    {
     "id": 1246862,
     "content_html": "There is a stable and unchanging environment in which a species can flourish."
    }
   ],
