 "questions": [
  {
   "id": 233310,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Treatment of cancer is often called a “fight against biology.” Explain why the use of p53 supports this statement.",
   "answers": [
    {
     "id": 723383,
     "content_html": "because normal cells are often negatively affected by cancer treatments, including p53"
    },
    {
     "id": 723384,
     "content_html": "because cancer cells are always affected by current cancer treatments, including p53"
    },
    {
     "id": 723386,
     "content_html": "because normal cells are often negatively affected by cancer treatments, with the exception of p53"
    },
    {
     "id": 723385,
     "content_html": "because cancer cells often aren’t affected by cancer treatments, with the exception of p53"
    }
   ],
