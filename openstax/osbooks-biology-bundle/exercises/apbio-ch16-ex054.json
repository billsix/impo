 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1687530\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"2\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n<span data-type=\"media\" id=\"fs-id2334394\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/3a8a3714193df8a64fa275ff78aacb82e680555a\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"3\">\n</span>\n    <p id=\"fs-id2126300\">Watch <a href=\"https://openstaxcollege.org/l/p53_cancer\" target=\"_blank\" rel=\"noopener nofollow\">this animation</a> to learn more about the use of p53 in fighting cancer.</p>\n</div>\n</div>\n",
