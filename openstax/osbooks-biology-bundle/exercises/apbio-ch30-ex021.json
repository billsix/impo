 "questions": [
  {
   "id": 529239,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/09be31e2380c5a8e.jpg\" alt=\"The illustration shows a body cell at left with the label PO2 = 46 mm Hg and a blood vessel at right with the label PO2 = 46 mm Hg. \"></p>\n\n<p>Our body systems work to maintain homeostasis by adjusting when body cells need more oxygen or are experiencing a buildup of carbon dioxide. How would the body likely respond if some of its cells were experiencing the situation pictured?</p>\n",
   "answers": [
    {
     "id": 1035940,
     "content_html": "Generating neural signals that stimulate the heart to beat at a faster rate."
    },
    {
     "id": 1035941,
     "content_html": "Releasing hormones that stimulate body cells to undergo more active transport."
    },
    {
     "id": 1035942,
     "content_html": "Releasing red blood cells that can accept oxygen using diffusion as opposed to facilitated passive transport."
    },
    {
     "id": 1035943,
     "content_html": "Adjust blood pH to decrease the partial pressure of CO<sub>2</sub> in the body cells."
    }
   ],
