   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Would an organism that is constantly in a hypertonic environment likely be an osmoregulator or an osmoconformer? Why?",
   "answers": [
    {
     "id": 1046008,
     "content_html": "osmoconformer, because it would need to prevent water from leaving its body to remain alive"
    },
