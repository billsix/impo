 "questions": [
  {
   "id": 550750,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Humans are very active in modifying ecosystems worldwide. If a new set of buildings on the edge of a forest block sunlight from reaching the majority of one part of the forest, what might happen to that part of the forest?",
   "answers": [
    {
     "id": 1082628,
     "content_html": "Herbivores would occur in high abundance."
    },
    {
     "id": 1082629,
     "content_html": "Plants would occur in high abundance."
    },
    {
     "id": 1082630,
     "content_html": "Everything would remain the same."
    },
    {
     "id": 1082631,
     "content_html": "Herbivores would occur in low abundance."
    }
   ],
