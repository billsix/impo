 "questions": [
  {
   "id": 334395,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The bioluminescent bacteria <em>Vibrio fischeri</em> produces luminescence only if the population reaches a certain density. What is the advantage of an autoinducer?",
   "answers": [
    {
     "id": 843229,
     "content_html": "An autoinducer allows the producer to act independently of the presence of other cells."
    },
    {
     "id": 843230,
     "content_html": "An autoinducer does not diffuse away from the cell."
    },
    {
     "id": 843232,
     "content_html": "An autoinducer allows a positive feedback loop, which increases the response in proportion to the population size."
    },
    {
     "id": 843231,
     "content_html": "An autoinducer presents no advantage for the cell."
    }
   ],
