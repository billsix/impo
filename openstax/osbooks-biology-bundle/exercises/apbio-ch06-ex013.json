 "questions": [
  {
   "id": 232494,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the underlying principle that supports the idea that all living organisms share the same core processes and features?",
   "answers": [
    {
     "id": 720123,
     "content_html": "All organisms must harvest energy from their environment and convert it to ATP to carry out cellular functions."
    },
    {
     "id": 720120,
     "content_html": "Plants produce their own energy and pass it on to animals."
    },
    {
     "id": 720121,
     "content_html": "Herbivores, carnivores, and omnivores coexist for the survival of all."
    },
    {
     "id": 720122,
     "content_html": "Glucose is the primary source of energy for all cellular functions."
    }
   ],
