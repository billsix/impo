 "questions": [
  {
   "id": 664477,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<i>Thiomargarita namibiensis</i> is a large single cell organism, which can reach lengths of 700μm. The cell is classified as a bacterium. What is the main argument to justify the classification?",
   "answers": [
    {
     "id": 1324691,
     "content_html": "This organism shows simple diffusion for the uptake of nutrients, and is thus classified as a bacterium."
    },
    {
     "id": 1324692,
     "content_html": "This organism does not show presence of any membranous cell organelles, and thus is classified as a bacterium."
    },
    {
     "id": 1324693,
     "content_html": "The existence of these organisms in long chains and pearl appearance classifies them as bacteria."
    },
    {
     "id": 1324694,
     "content_html": "The organism has chloroplasts but lacks mitochondria, and therefore is classified as a bacterium."
    }
   ],
