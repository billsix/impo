 "questions": [
  {
   "id": 544285,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why the fight-or-flight response is advantageous in the short-term but not in the long-term.",
   "answers": [
    {
     "id": 1069809,
     "content_html": "Fight-or-flight reduces access to glucose reserves and these get depleted fairly quickly."
    },
    {
     "id": 1069810,
     "content_html": "Fight-or-flight reduces access to glycogen reserves and these get depleted fairly quickly."
    },
    {
     "id": 1069811,
     "content_html": "Fight-or-flight stimulates access to glucose reserves, but these get depleted fairly quickly."
    },
    {
     "id": 1069812,
     "content_html": "Fight-or-flight stimulates access to glycogen reserves, but these get depleted fairly quickly."
    }
