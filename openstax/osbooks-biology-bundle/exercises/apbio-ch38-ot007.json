 "questions": [
  {
   "id": 531826,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The island of Madagascar is located in the tropics 300 miles east of the coast of Africa, from which it separated 165 million years ago. It is characterized by a large number of endemic species. What are the main reasons that Madagascar is a hotspot of endemic biodiversity?",
   "answers": [
    {
     "id": 1040220,
     "content_html": "Madagascar has a climate that is more conducive to evolution than the larger African continent."
    },
    {
     "id": 1040221,
     "content_html": "Madagascar is close to the tropics of Africa and consequently has a large number of species."
    },
    {
     "id": 1040222,
     "content_html": "Madagascar shows species diversity of both temperate and tropical regions."
    },
    {
     "id": 1040223,
     "content_html": "Madagascar has been isolated geographically and species evolved there without interaction with outside influences."
    }
   ],
