   "stimulus_html": "",
   "stem_html": "How does a chaperone work with proteins?",
   "answers": [
    {
     "id": 719138,
     "content_html": "Chaperones assist proteins in folding."
    },
    {
     "id": 719137,
     "content_html": "Chaperones cause the aggregation of polypeptides."
    },
    {
     "id": 719136,
     "content_html": "Chaperones associate with proteins once the target protein is folded."
    },
    {
     "id": 719135,
     "content_html": "Chaperones escort proteins during translation."
    }
