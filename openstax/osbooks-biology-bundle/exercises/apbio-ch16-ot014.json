   "id": 233326,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What could happen if a cell had too much of an activating transcription factor present?",
   "answers": [
    {
     "id": 723450,
     "content_html": "The transcription rate would increase, altering cell function."
    },
    {
     "id": 723447,
     "content_html": "The transcription rate would decrease, inhibiting cell functions."
    },
    {
     "id": 723448,
     "content_html": "The transcription rate decreases due to clogging of the transcription factors."
    },
    {
     "id": 723449,
     "content_html": "The transcription rate increases due to clogging of the transcription factors."
