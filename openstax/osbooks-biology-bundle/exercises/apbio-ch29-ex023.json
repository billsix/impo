 "questions": [
  {
   "id": 546853,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What types of issues related to bone function would you predict for an individual suffering from a genetic lysosomal storage disease?",
   "answers": [
    {
     "id": 1072535,
     "content_html": "Individuals may have deformities in the appendicular skeleton and possible phosphate homeostasis issues."
    },
    {
     "id": 1072536,
     "content_html": "Individual may have skeletal deformities and possible calcium homeostasis issues."
    },
    {
     "id": 1072537,
     "content_html": "Individuals may have axial skeleton deformities and possible calcium homeostasis issues."
    },
    {
     "id": 1072538,
     "content_html": "Individual’s brain would be more prone to injury and a possible calcium homeostasis issues."
    }
   ],
