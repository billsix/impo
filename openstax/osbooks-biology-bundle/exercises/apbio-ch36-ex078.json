   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Construct a sentence that describes the symbiotic relationships of mutualism, commensalism, and parasitism.",
   "answers": [
    {
     "id": 1071200,
     "content_html": "Symbiotic relationships always benefit both species involved."
    },
    {
     "id": 1071201,
     "content_html": "Symbiotic relationships never harm either of the species involved."
    },
    {
     "id": 1071202,
     "content_html": "Symbiotic relationships always benefit at least one of the species involved."
    },
    {
