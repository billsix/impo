   "id": 335752,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The flame cells of a protonephridia filter waste materials out of the blood, or hemolymph, of invertebrates. What would this be most similar to, in function, in the human excretory system?",
   "answers": [
    {
     "id": 848590,
     "content_html": "the ascending loop of henle"
    },
    {
     "id": 848591,
     "content_html": "the descending loop of henle"
    },
    {
     "id": 848592,
     "content_html": "the distal convoluted tubule"
    },
    {
     "id": 848593,
     "content_html": "Bowman's capsule"
    }
   ],
