 "questions": [
  {
   "id": 532050,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>A chain within the food web in the arctic ocean is shown below:</p>\n\n<p>Phytoplankton ─&gt; zooplankton ─&gt; arctic char/cod ─&gt; ringed seal─&gt; polar bear.\n A chain within the arctic food web on land is shown below: \n Lichen/shrub ─&gt; Caribou/hare/small rodent ─&gt; fox/lynx/bird of prey</p>\n\n<p>If polar bears move to land to hunt due to loss of sea ice, what will happen to the balance of the food web?</p>\n",
   "answers": [
    {
     "id": 1040996,
     "content_html": "Polar bears, being top predators, will edge out the other consumers without gaining enough calories themselves."
    },
    {
     "id": 1040997,
     "content_html": "Polar bears, being secondary consumers, will edge out the other consumers without gaining enough calories themselves."
    },
    {
     "id": 1040998,
     "content_html": "Polar bears, being top predators, will edge out the producers without gaining enough calories themselves."
    },
    {
     "id": 1040999,
     "content_html": "Polar bears, being secondary consumers, will edge out the producers without gaining enough calories themselves."
    }
   ],
