 "questions": [
  {
   "id": 233311,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The <em>E. coli</em> bacteria can have several mutations that affect the lac operon system. One mutation inhibits the ability of RNA polymerase to bind to the lac operon. How would this affect the cell?",
   "answers": [
    {
     "id": 723389,
     "content_html": "The cell would make more lactose."
    },
    {
     "id": 723388,
     "content_html": "There would be no lactose outside of the cell."
    },
    {
     "id": 723387,
     "content_html": "The cell would not be able to process tryptophan."
    },
    {
     "id": 723390,
     "content_html": "The cell would not be able to process lactose."
    }
   ],
