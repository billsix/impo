 "questions": [
  {
   "id": 233478,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/42e48a74def45d8f.jpg\" alt=\"\">\n<figcaption>(credit: modification of work from RetrieverMan)</figcaption>\n</figure>\n",
   "stem_html": "<p>A labrador retriever suffers from a mutation while growing. A patch of gold-colored fur turns black.</p>\n<p>Would the same mutation affect this dog's offspring?</p>",
   "answers": [
    {
     "id": 724057,
     "content_html": "Yes, mutations are hereditary and are passed on to offspring."
    },
    {
     "id": 724056,
     "content_html": "There is a 50% chance of the offpsring getting the mutation, based on which chromosome gets from which parent."
    },
    {
     "id": 724055,
     "content_html": "Unless the other parent has the same mutation, the offspring would not get the mutation."
    },
    {
     "id": 724058,
     "content_html": "No, a mutation in the fur would not affect the germ cells of the dog and would not pass to its offspring."
    }
   ],
