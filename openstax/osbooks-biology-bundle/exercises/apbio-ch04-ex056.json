  {
   "id": 639546,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are the similarities and differences between the structures of centrioles and flagella?",
   "answers": [
    {
     "id": 1245733,
     "content_html": "Centrioles and flagella are made of microtubules but show different arrangements."
    },
    {
     "id": 1245732,
     "content_html": "Centrioles are made of microtubules but flagella are made of microfilaments and both show the same arrangement."
    },
    {
     "id": 1245731,
     "content_html": "Centrioles and flagella are made of microfilaments. Centrioles have a 9 + 2 arrangement."
    },
    {
     "id": 1245730,
     "content_html": "Centrioles are made of microtubules and flagella are made of microfilaments and both have different structures."
    }
