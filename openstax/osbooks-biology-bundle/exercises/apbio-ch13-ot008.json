  {
   "id": 639713,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If the effects of Klinefelter syndrome are compared to the effects of Down Syndrome, this disorder is ______.",
   "answers": [
    {
     "id": 1246383,
     "content_html": "more severe than Down syndrome, due to gene deletions in this syndrome"
    },
    {
     "id": 1246382,
     "content_html": "more severe than Down syndrome, due to trisomy in Klinefelter syndrome"
    },
    {
     "id": 1246381,
     "content_html": "less severe than Down syndrome, due to monosomy in Down Syndrome"
    },
    {
     "id": 1246384,
     "content_html": "less severe than Down syndrome, due to X-inactivation in this disorder"
    }
