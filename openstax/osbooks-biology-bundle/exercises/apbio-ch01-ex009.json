  {
   "id": 620862,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which example most clearly shows a way that humans can respond directly to a change in the environment?",
   "answers": [
    {
     "id": 1185100,
     "content_html": "We shiver when we are cold and sweat when we are hot."
    },
    {
     "id": 1185097,
     "content_html": "We walk by putting our front leg forward and pushing off with our back leg."
    },
    {
     "id": 1185098,
     "content_html": "We are able to breathe in and out unconsciously."
    },
    {
     "id": 1185099,
     "content_html": "Our hair and fingernails grow at a constant rate over time."
    }
   ],
