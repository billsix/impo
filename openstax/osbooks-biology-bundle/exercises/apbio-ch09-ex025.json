   "stimulus_html": "",
   "stem_html": "What is the function of a phosphatase?",
   "answers": [
    {
     "id": 1004680,
     "content_html": "A phosphatase removes phosphorylated amino acids from proteins."
    },
    {
     "id": 1004681,
     "content_html": "A phosphatase removes the phosphate group from phosphorylated amino acid residues in a protein."
    },
    {
     "id": 1004682,
     "content_html": "A phosphatase phosphorylates serine, threonine, and tyrosine residues."
    },
    {
     "id": 1004683,
     "content_html": "A phosphatase degrades second messengers in the cell."
    }
