   "id": 535490,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Humans have both special and general senses. Which statement explains what both types of senses have in common?",
   "answers": [
    {
     "id": 1048256,
     "content_html": "All types of senses undergo sensory transduction by converting a stimulus into a chemical signal via the central nervous system."
    },
    {
     "id": 1048257,
     "content_html": "All types of senses undergo sensory transduction by converting a stimulus into an electrical signal via the peripheral nervous system."
    },
    {
     "id": 1048258,
