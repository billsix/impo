  {
   "id": 242522,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/acec39a6d0a2bb3b.jpg\" alt=\"\">\n<figcaption>(credit: modification of work from United States Environmental Protection Agency)</figcaption>\n</figure>\n",
   "stem_html": "<p>This graph shows the US emissions of greenhouse gasses by sector. Note this graph has electricity use distributed to various sectors.</p>\n<p>Make a claim based on this graph.</p>",
   "answers": [
    {
     "id": 759549,
     "content_html": "A 20% decrease in greenhouse gas emissions by agricultural activities would reduce the total emissions by about 5%."
    },
    {
     "id": 759550,
     "content_html": "A 20% decrease in greenhouse gas emissions by industry would reduce the total emissions by about 6%"
    },
    {
     "id": 759548,
     "content_html": "A 20% decrease in greenhouse gas emissions by transportation would reduce the total emissions by about 5%"
    },
    {
     "id": 759547,
     "content_html": "A 20% decrease in greenhouse gas emissions by residential and commercial use would reduce the total emissions by about 8%"
    }
   ],
