 "questions": [
  {
   "id": 511877,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain what personalized medicine is and how it can be used to treat cancer.",
   "answers": [
    {
     "id": 1001146,
     "content_html": "Personalized medicines would vary based on the type of mutations and the gene’s expression pattern."
    },
    {
     "id": 1001147,
     "content_html": "The medicines are given based on the type of tumor found in the body of an individual."
    },
    {
     "id": 1001148,
     "content_html": "The personalized medicines are provided based only on the symptoms of the patient."
    },
    {
     "id": 1001149,
     "content_html": "The medicines tend to vary depending on the severity and the stage of the cancer."
    }
   ],
