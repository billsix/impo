   "id": 513208,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Human papillomavirus can cause cervical cancer. The virus encodes E6, a protein that binds p53. Based on this fact and what you know about p53, what effect do you think E6 binding has on p53 activity?",
   "answers": [
    {
     "id": 1004520,
     "content_html": "E6 activates p53."
    },
    {
     "id": 1004521,
     "content_html": "E6 protects p53 from degradation."
    },
    {
     "id": 1004522,
     "content_html": "E6 mutates p53."
    },
    {
     "id": 1004523,
     "content_html": "E6 binding marks p53 for degradation."
    }
   ],
