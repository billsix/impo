 "questions": [
  {
   "id": 519768,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Analyzing cross-sections of different parts of a plant in a plant anatomy class, students categorized the most frequently encountered types of cells in plant tissues. Which student gave the most accurate report?",
   "answers": [
    {
     "id": 1014595,
     "content_html": "Student A reported that meristematic cells were the most abundant."
    },
    {
     "id": 1014596,
     "content_html": "Student B tallied mostly collenchyma cells."
    },
    {
     "id": 1014597,
     "content_html": "Student C noticed mostly sclerenchyma cells."
    },
    {
     "id": 1014598,
     "content_html": "Student D observed that parenchyma cells were the most abundant."
    }
   ],
