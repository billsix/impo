 "questions": [
  {
   "id": 521023,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/a06aca70fc0342d4.jpg\" alt=\"The figure shows a graph correlating the body temperature of an animal and the time of the day. The animal's body temperature varies; it is 15° Celsius throughout the night and until 11 a m. After being exposed to the sun, the body temperature increases to between 30 and 35° Celsius, and decreases on two occasions due to cloud presence.  \">\n(credit: modification of work by Terrien, J. et al./<i>Frontiers in Bioscience</i>)\n</figure>",
   "stem_html": "<p>This graph shows the body temperature of an animal in various hours of the day.</p>\n<p>What can be said about this animal?</p>",
   "answers": [
    {
     "id": 1018401,
     "content_html": "The animal keeps its body temperature relatively constant."
    },
    {
     "id": 1018402,
     "content_html": "The animal is most active during the morning hours."
    },
    {
     "id": 1018403,
     "content_html": "The animal is more active when it's body temperature is above 30 °C."
    },
    {
     "id": 1018404,
     "content_html": "The animal is active at night."
    }
   ],
