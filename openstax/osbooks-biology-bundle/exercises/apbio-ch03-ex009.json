  {
   "id": 285887,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Urey and Miller proposed that a series of reactions occurred, which ultimately resulted in amino acid formation. Which of the following is true based upon their theory?",
   "answers": [
    {
     "id": 819962,
     "content_html": "Hydrogen and nitrogen combined to create amino acids."
    },
    {
     "id": 819963,
     "content_html": "Hydrogen and oxygen combined to create macromolecules."
    },
    {
     "id": 819964,
     "content_html": "Nitrogenous bases combined to form monomers then RNA."
    },
    {
     "id": 819965,
     "content_html": "Periodic elements combined to create molecules then DNA."
    }
   ],
