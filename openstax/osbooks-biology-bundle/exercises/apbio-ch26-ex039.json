 "questions": [
  {
   "id": 535201,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Voltage-gated ion channels are essential for producing an action potential and returning a neuron to its resting state. Why would it be impossible to trigger an action potential without voltage-gated ion channels?",
   "answers": [
    {
     "id": 1047308,
     "content_html": "The cell would not undergo depolarization, which is necessary to fire an action potential and then return the cell to the resting state."
    },
    {
     "id": 1047309,
     "content_html": "The cell would not undergo repolarization, which is necessary to fire an action potential and then return the cell to the resting state."
    },
    {
     "id": 1047310,
     "content_html": "The cell would not undergo depolarization, repolarization, and hyperpolarization, which are necessary to fire an action potential and then return the cell to the resting state."
    },
    {
     "id": 1047311,
     "content_html": "The cell would not undergo depolarization and hyperpolarization, which are necessary to fire an action potential and then return the cell to the resting state."
    }
   ],
