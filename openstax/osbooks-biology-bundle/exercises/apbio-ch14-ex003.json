   "stimulus_html": "",
   "stem_html": "What is bacterial transformation?",
   "answers": [
    {
     "id": 1020136,
     "content_html": "The transformation of a bacterium occurs during replication."
    },
    {
     "id": 1020137,
     "content_html": "It is the transformation of a bacterium into a pathogenic form."
    },
    {
     "id": 1020138,
     "content_html": "Transformation of bacteria involves changes in its chromosome."
    },
    {
     "id": 1020139,
     "content_html": "Transformation is a process in which external DNA is taken up by a cell, thereby changing morphology and physiology."
    }
