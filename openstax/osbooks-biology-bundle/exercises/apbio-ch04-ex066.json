 "questions": [
  {
   "id": 504064,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If there is a mutation in the gene for collagen, such as the one involved in Ehlers-Danlos syndrome, and the individual produces defective collagen, would it affect coagulation? Why or why not?",
   "answers": [
    {
     "id": 990913,
     "content_html": "Yes. The syndrome affects the clotting factors and platelet aggregation."
    },
    {
     "id": 990914,
     "content_html": "Yes. Collagen is a component of platelets, required for clotting."
    },
    {
     "id": 990915,
     "content_html": "No. Coagulation is not affected because collagen is not required for coagulation."
    },
    {
     "id": 990916,
     "content_html": "Yes. Collagen excretes tissue factor, required for clotting."
    }
   ],
