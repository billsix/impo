   "stimulus_html": "",
   "stem_html": "Which of the following observations contributed to cell theory?",
   "answers": [
    {
     "id": 991075,
     "content_html": "Animal and plant cells have nuclei and organelles."
    },
    {
     "id": 991076,
     "content_html": "Minerals cannot give rise to living organisms."
    },
    {
     "id": 991077,
     "content_html": "Prokaryotic and eukaryotic cells are surrounded by a plasma membrane."
    },
    {
     "id": 991078,
     "content_html": "Viruses replicate."
    }
