 "questions": [
  {
   "id": 334152,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Is the nuclear membrane part of the endomembrane system? Why or why not?",
   "answers": [
    {
     "id": 842282,
     "content_html": "The nuclear membrane is not a part of the endomembrane system as the endoplasmic reticulum is a separate organelle of the cell."
    },
    {
     "id": 842283,
     "content_html": "The nuclear membrane is considered a part of the endomembrane system as it is continuous with the Golgi body."
    },
    {
     "id": 842285,
     "content_html": "The nuclear membrane is part of the endomembrane system as it is continuous with the rough endoplasmic reticulum."
    },
    {
     "id": 842284,
     "content_html": "The nuclear membrane is not considered a part of the endomembrane system as the nucleus is a separate organelle."
    }
   ],
