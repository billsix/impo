 "questions": [
  {
   "id": 524085,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Carbohydrates often get a bad reputation for their role in promoting weight gain when consumed in excess. However, carbohydrates are necessary for biological functions. Why is it important to consume carbohydrates?",
   "answers": [
    {
     "id": 1028884,
     "content_html": "Carbohydrates are broken down into glucose, which provides energy as ATP through metabolic pathways. ATP helps to maintain connective tissue."
    },
    {
     "id": 1028885,
     "content_html": "Carbohydrates are broken down into glucose, which is essential for blood clotting."
    },
    {
     "id": 1028886,
     "content_html": "Carbohydrates, along with proteins, help maintain connective tissue and are essential to blood clotting."
    },
    {
     "id": 1028887,
     "content_html": "Carbohydrates are broken down into glucose, which provides energy as ATP through metabolic pathways. ATP is required for proper cellular function."
    }
   ],
