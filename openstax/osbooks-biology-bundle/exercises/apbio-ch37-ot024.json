 "questions": [
  {
   "id": 550779,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do scientists more commonly analyze net primary productivity compared with gross primary productivity?",
   "answers": [
    {
     "id": 1082732,
     "content_html": "Net primary productivity incorporates features like production at present and next trophic levels, whereas gross primary productivity does not."
    },
    {
     "id": 1082733,
     "content_html": "Net primary productivity is the rate at which photosynthetic primary producers incorporate energy from the sun."
    },
    {
     "id": 1082734,
     "content_html": "As net primary productivity is the energy content available to the organisms of the next trophic level."
    },
    {
     "id": 1082735,
     "content_html": "As respiration and heat loss uses energy of the primary producer, therefore, net primary productivity is what is actually available to primary consumers."
    }
   ],
