   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which best describes the crisis related to antibiotics?",
   "answers": [
    {
     "id": 1016603,
     "content_html": "It is becoming too expensive to manufacture effective antibiotics."
    },
    {
     "id": 1016604,
     "content_html": "It takes too much time to develop effective antibiotics; infections spread before treatment is available."
    },
    {
     "id": 1016605,
     "content_html": "Bacteria are increasingly resistant to antibiotics used to treat and eradicate infections."
    },
    {
     "id": 1016606,
     "content_html": "People are increasingly allergic to antibiotics commonly used in treatment."
    }
   ],
