   "stem_html": "What is the role of electrons in the electron transfer chain?",
   "answers": [
    {
     "id": 989463,
     "content_html": "to dephosphorylate ATP, producing ADP"
    },
    {
     "id": 989464,
     "content_html": "to power active transport pumps"
    },
    {
     "id": 989465,
     "content_html": "to reduce heme in complex III"
    },
    {
     "id": 989466,
     "content_html": "to oxidize oxygen"
    }
