   "stem_html": "How is the Earth's atmosphere today different from the primitive atmosphere Miller and Urey modeled in the lab?",
   "answers": [
    {
     "id": 1003984,
     "content_html": "The modern atmosphere is more oxidizing and lacks hydrogen."
    },
    {
