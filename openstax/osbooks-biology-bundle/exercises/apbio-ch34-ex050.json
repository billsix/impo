 "questions": [
  {
   "id": 517101,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/2d247bb5abd10933.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Sarah Mo/The NEI Connection)</figcaption>\n</figure>\n",
   "stem_html": "<p>The graph shows the ovarian reserve and the changing levels of hormones during menapause.</p>\n<p>Make a claim based on this graph.</p>",
   "answers": [
    {
     "id": 1011286,
     "content_html": "During menapause the secretion of progesterone is increased."
    },
    {
     "id": 1011287,
     "content_html": "The ovaries contain a finite reserve of ovarian follicles in the body."
    },
    {
     "id": 1011288,
     "content_html": "New ovarian follicles are continuously produced through meiosis."
    },
    {
     "id": 1011289,
     "content_html": "During menapause the secretion of follicle stimulating hormone (FSH) is reduced."
    }
   ],
