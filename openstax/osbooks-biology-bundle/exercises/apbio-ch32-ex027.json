 "questions": [
  {
   "id": 535051,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the structure of the nephron?",
   "answers": [
    {
     "id": 1046714,
     "content_html": "The nephron consists of three parts: the glomerulus, the renal tubule, and the associated capillary network originating from the cortical radiate arteries."
    },
    {
     "id": 1046715,
     "content_html": "The nephron consists of three parts: the renal corpuscle, the Bowman’s capsule, and the associated capillary network originating from the cortical radiate arteries."
    },
    {
     "id": 1046716,
     "content_html": "The nephron consists of three parts: the renal corpuscle, the renal tubule, and the associated capillary network originating from the segmental renal artery."
    },
    {
     "id": 1046717,
     "content_html": "The nephron consists of three parts: the renal corpuscle, the renal tubule, and the associated capillary network originating from the cortical radiate arteries."
    }
