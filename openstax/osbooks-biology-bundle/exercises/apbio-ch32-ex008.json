 "questions": [
  {
   "id": 242210,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/cba1fd5a4233117c.jpg\" alt=\"\">\n(credit: modification of work by KDS4444/Wikipedia, CC0)\n</figure>",
   "stem_html": "<p>This image shows a U-shaped tube with a semi-permeable membrane separating it into two. The membrane allows small molecules to pass through, but not larger molecules.</p>\n<p>Sugar, a large molecule, is added to left arm of the U-shaped tube. Make a claim about what will happen next.</p>",
   "answers": [
    {
     "id": 758302,
     "content_html": "The water level will increase equally in both arms because of the added volume of the sugar."
    },
    {
     "id": 758301,
     "content_html": "The water level  will increase slightly on the left arm because of the added volume of the sugar."
    },
    {
     "id": 758300,
     "content_html": "The water level will increase considerably on the left arm because of the added volume of the sugar, as well as more water going to left arm due to osmotic pressure."
    },
    {
     "id": 758303,
     "content_html": "The water level will increase  slightly on the right arm because water going to right arm due to osmotic pressure."
    }
   ],
