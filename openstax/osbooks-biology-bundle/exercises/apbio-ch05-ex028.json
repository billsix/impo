   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the sodium-potassium pump make the interior of the cell negatively charged?",
   "answers": [
    {
     "id": 1004826,
     "content_html": "by expelling anions"
    },
    {
     "id": 1004827,
     "content_html": "by pulling in anions"
    },
    {
     "id": 1004828,
     "content_html": "by expelling more cations than it takes in"
    },
    {
     "id": 1004829,
     "content_html": "by taking in and expelling an equal number of cations"
    }
