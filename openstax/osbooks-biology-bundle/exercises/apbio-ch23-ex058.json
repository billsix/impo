 "questions": [
  {
   "id": 520852,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Justify the claim that a compound leaf gives a plant a selective advantage to avoid herbivory by describing the mechanism that makes this benefit true.",
   "answers": [
    {
     "id": 1017979,
     "content_html": "Compound leaves produce specific types of chemical compounds that are harmful to herbivores."
    },
    {
     "id": 1017980,
     "content_html": "It is more efficient for large herbivores to eat large, simple leaves."
    },
    {
     "id": 1017981,
     "content_html": "Compound leaves are thicker and tougher than simple leaves.\n"
    },
    {
     "id": 1017982,
     "content_html": "It is more difficult for large herbivores to locate the small leaflets of compound leaves."
    }
   ],
