   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/e09b7a78fac924de.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Douglas Wilkin, Ph.D. and Barbara Akre/ck12)</figcaption>\n</figure>",
   "stem_html": "<p>The image shows the parts of a leaf.</p>\n<p>Which part(s) are the vascular tissue?</p>",
   "answers": [
    {
     "id": 1247794,
     "content_html": "Epidermis, including stoma and guard cells."
    },
    {
     "id": 1247793,
     "content_html": "Mesophyll, including xylem and pholem."
    },
    {
     "id": 1247792,
     "content_html": "Mesophyll, excluding xylem and pholem."
    },
    {
     "id": 1247795,
     "content_html": "The xylem and the pholem."
    }
