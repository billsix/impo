   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The enzyme ployadenylate polymerase catalyzes the addition of adenosine monophosphate to the 3’ ends of mRNAs to form a poly-A tail. If the enzyme were blocked so that it could not function, the result would be:",
   "answers": [
    {
     "id": 723191,
     "content_html": "increased mRNA stability in eukaryotes, and decreased mRNA stability in prokaryotes"
    },
    {
     "id": 723194,
     "content_html": "decreased mRNA stability in eukaryotes, and no effect in prokaryotes"
    },
    {
     "id": 723192,
     "content_html": "no effect in eukaryotes, and increased mRNA stability in prokaryotes"
    },
    {
