 "questions": [
  {
   "id": 233220,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You sequence a gene of interest and isolate the matching mRNA. You find that the mRNA is considerably shorter than the DNA sequence. Why is that?",
   "answers": [
    {
     "id": 723023,
     "content_html": "There was an experimental mistake. The mRNA should have the same length as the gene."
    },
    {
     "id": 723024,
     "content_html": "The mRNA should be longer than the DNA sequence because the promoter is also transcribed."
    },
    {
     "id": 723026,
     "content_html": "The processed mRNA is shorter because introns were removed."
    },
    {
     "id": 723025,
     "content_html": "The mRNA is shorter because the signal sequence to cross the nuclear membrane was removed."
    }
   ],
