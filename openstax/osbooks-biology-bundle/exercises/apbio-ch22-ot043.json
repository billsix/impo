  {
   "id": 520324,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Nitrogen is an essential element that is widely available in the atmosphere. Because eukaryotes cannot use nitrogen in its gaseous form, they benefit from prokaryotes’ conversion of gaseous nitrogen to <strong>__</strong>__.",
   "answers": [
    {
     "id": 1016747,
     "content_html": "nitrates, a form of nitrogen they can use"
    },
    {
     "id": 1016748,
     "content_html": "phosphate, a different essential element they can use"
    },
    {
     "id": 1016749,
     "content_html": "ammonia, a form of nitrogen they can use"
    },
    {
     "id": 1016750,
     "content_html": "hydrogen, a different essential element they can use"
    }
   ],
