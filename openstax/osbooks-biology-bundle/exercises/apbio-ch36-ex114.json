 "questions": [
  {
   "id": 242730,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A biologist hypothesizes birds of various species recognize the predator warning calls of other bird species. The biologist has established several feeders in a forest where birds come to feed regularly. They are spread out over a wide area, making it difficult to observe all of the boxes at the same time. Describe how the biologist can use this site to collect data to test his hypothesis.",
   "answers": [
    {
     "id": 760382,
     "content_html": "The biologist can use video cameras to record the behavior of birds coming to the feeders."
    },
    {
     "id": 760381,
     "content_html": "The biologist can leave an audio recorder near the feeders."
    },
    {
     "id": 760380,
     "content_html": "The biologist can record the behavior of birds by comparing them with other birds using video cameras."
    },
    {
     "id": 760379,
     "content_html": "The biologist could observe the birds continually for one month."
    }
   ],
