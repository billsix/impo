 "questions": [
  {
   "id": 503396,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are the roles of ATP and NADPH in photosynthesis?",
   "answers": [
    {
     "id": 989567,
     "content_html": "ATP and NADPH are forms of chemical energy produced from the light dependent reactions to be used in the light independent reactions that produce sugars."
    },
    {
     "id": 989568,
     "content_html": "ATP and NADPH are forms of chemical energy produced from the light independent reactions, to be used in the light dependent reactions that produce sugars."
    },
    {
     "id": 989569,
     "content_html": "ATP and NADPH are forms of chemical energy produced from the light dependent reactions to be used in the light independent reactions that produce proteins."
    },
    {
     "id": 989570,
     "content_html": "ATP and NADPH are forms of chemical energy produced from the light dependent reactions to be used in the light independent reactions that use sugars as reactants."
    }
   ],
