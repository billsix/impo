 "questions": [
  {
   "id": 233660,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does a phylogenetic tree relate to the passing of time?",
   "answers": [
    {
     "id": 724786,
     "content_html": "A phylogenetic tree relates to the passing of time because species branch off from each other at regular time intervals."
    },
    {
     "id": 724787,
     "content_html": "A phylogenetic tree is not related to the passing of time because speciation is based on geographic changes."
    },
    {
     "id": 724788,
     "content_html": "The phylogenetic tree only shows the order in which things took place."
    },
    {
     "id": 724789,
     "content_html": "A phylogenetic tree relates to the passing of time when the diagram also shows how long ago the divergence from the common ancestor occurred."
    }
   ],
