 "questions": [
  {
   "id": 232492,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Cell metabolism is a complex process that uses many types of chemicals in a variety of processes. Which of the following statements provides the best and most accurate evidence of this concept?",
   "answers": [
    {
     "id": 720114,
     "content_html": "A lack of available glucose inhibits the process of photosynthesis."
    },
    {
     "id": 720113,
     "content_html": "A loss of available carbohydrates inhibits cell mitosis."
    },
    {
     "id": 720112,
     "content_html": "A lack of triglycerides restricts production of ATP."
    },
    {
     "id": 720115,
     "content_html": "A loss of enzymes would result in cell death."
    }
   ],
