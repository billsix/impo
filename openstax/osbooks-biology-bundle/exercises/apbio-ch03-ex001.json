 "questions": [
  {
   "id": 503039,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What role do electrons play in dehydration synthesis and hydrolysis?",
   "answers": [
    {
     "id": 988287,
     "content_html": "Sharing of electrons between monomers occurs in both dehydration synthesis and hydrolysis."
    },
    {
     "id": 988288,
     "content_html": "The sharing of electrons between monomers occurs in hydrolysis only."
    },
    {
     "id": 988289,
     "content_html": "<span data-math=\"\\text{H}^+\">\\text{H}^+</span> and <span data-math=\"\\text{OH}^-\">\\text{OH}^-</span> ions share electrons with the respective monomers in dehydration synthesis."
    },
    {
     "id": 988290,
     "content_html": "<span data-math=\"\\text{H}^+\">\\text{H}^+</span> and <span data-math=\"\\text{OH}^-\">\\text{OH}^-</span> ions share electrons with the respective monomers in hydrolysis."
    }
   ],
