 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1425951\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-id1712253\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/c77f65bdb09c2dd83af798143d2bbc67b3e29170\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"130\" height=\"130\">\n</span>\n<p id=\"fs-id1443321\">Visit <a href=\"https://openstaxcollege.org/l/hydrolysis\" target=\"_blank\" rel=\"noopener nofollow\">this site</a> to see visual representations of dehydration synthesis and hydrolysis.</p>\n</div>\n</div>",
