 "questions": [
  {
   "id": 233657,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe how organisms are classified in the taxonomic classification system.",
   "answers": [
    {
     "id": 724777,
     "content_html": "The taxonomic classification system uses a hierarchical model to organize living organisms. At each sublevel, the organisms are more similar."
    },
    {
     "id": 724774,
     "content_html": "The taxonomic classification system uses a hierarchical model to organize living organisms. At each sublevel, the number of organisms increases."
    },
    {
     "id": 724775,
     "content_html": "The categories in the taxonomic classification system are organized from smaller, more specific categories to larger categories."
    },
    {
     "id": 724776,
     "content_html": "In the hierarchal model for the taxonomic classification system, from the point of origin, the groups become less specific."
    }
   ],
