 "context": "<figure id=\"fig-ch16_03_02\" class=\"  \"><span data-type=\"media\" id=\"fs-id3078242\" data-alt=\"Nucleosomes are depicted as wheel-like structures. The nucleosomes are made up of histones, and have DNA wrapped around the outside. Each histone has a tail that juts out from the wheel. When DNA and the histone tails are methylated, the nucleosomes pack tightly together so there is no free DNA. Transcription factors cannot bind, and genes are not expressed. Acetylation of histone tails results in a looser packing of the nucleosomes. Free DNA is exposed between the nucleosomes, and transcription factors are able to bind genes on this exposed DNA.\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/21703a304d313f4e52ad7b327de7da791ca7ef1d\" data-media-type=\"image/png\" alt=\"Nucleosomes are depicted as wheel-like structures. The nucleosomes are made up of histones, and have DNA wrapped around the outside. Each histone has a tail that juts out from the wheel. When DNA and the histone tails are methylated, the nucleosomes pack tightly together so there is no free DNA. Transcription factors cannot bind, and genes are not expressed. Acetylation of histone tails results in a looser packing of the nucleosomes. Free DNA is exposed between the nucleosomes, and transcription factors are able to bind genes on this exposed DNA.\" width=\"450\" id=\"4\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 639777,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The X chromosome is very large compared to the Y chromosome. Expressing both copies of most of these genes would cause developmental problems. How is this challenge overcome in female mammals?",
   "answers": [
    {
     "id": 1246635,
     "content_html": "Methylation of DNA and hypo-acetylation of histones causes the nucleosomes to pack tightly together, inactivating one of the X chromosomes at random in each cell."
    },
    {
     "id": 1246634,
     "content_html": "Methylation of DNA and hypo-acetylation of histones causes the nucleosomes to pack tightly together, inactivating the top half of the paternal chromosome and the bottom half of the maternal chromosome."
    },
    {
     "id": 1246633,
     "content_html": "Acetylation of DNA and hyper-methylation of histones causes the nucleosomes to unwind, inactivating one of the X chromosomes at random in each cell."
    },
    {
     "id": 1246632,
     "content_html": "Acetylation of DNA and hyper-methylation of histones causes the nucleosomes to unwind, inactivating only the paternal chromosome."
    }
   ],
