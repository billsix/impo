 "questions": [
  {
   "id": 233200,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Would you be able to determine which RNA polymerase you isolated from a eukaryotic cell without analyzing its products?",
   "answers": [
    {
     "id": 722943,
     "content_html": "No, because they have the same <span data-math=\"\\unicode[Arial]{x3B1}\">\\unicode[Arial]{x3B1}</span>-amanitin sensitivity in all products."
    },
    {
     "id": 722944,
     "content_html": "No, quantitative analysis of products is done to determine the type of polymerase."
    },
    {
     "id": 722946,
     "content_html": "Yes, they can be determined as they differ in <span data-math=\"\\unicode[Arial]{x3B1}\">\\unicode[Arial]{x3B1}</span>-amanitin sensitivity."
    },
    {
     "id": 722945,
     "content_html": "Yes, they can be determined by the number of molecules that bind to DNA."
    }
   ],
