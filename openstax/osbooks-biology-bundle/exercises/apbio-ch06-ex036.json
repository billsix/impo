 "questions": [
  {
   "id": 503105,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Based on your understanding of the different types of energy, make a claim explaining the conversion of energy that occurs when the sluice of a dam is opened.",
   "answers": [
    {
     "id": 988551,
     "content_html": "Kinetic energy stored in the water held by the dam will convert to potential energy when the water falls through the opening of the sluice."
    },
    {
     "id": 988552,
     "content_html": "Potential energy stored in the water held by the dam will convert to electrical energy when the water falls through the opening of the sluice."
    },
    {
     "id": 988553,
     "content_html": "Hydrothermal energy stored in the water held by the dam will convert to kinetic energy when the water falls through the opening of the sluice."
    },
    {
     "id": 988554,
     "content_html": "Potential energy stored in the water held by the dam will convert to kinetic energy when the water falls through the opening of the sluice."
    }
   ],
