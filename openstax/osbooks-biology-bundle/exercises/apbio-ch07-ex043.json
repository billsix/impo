 "questions": [
  {
   "id": 639622,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Would you describe metabolic pathways as inherently wasteful or inherently economical? Justify your answer by explaining why you chose it.",
   "answers": [
    {
     "id": 1246026,
     "content_html": "Metabolic pathways are wasteful, as they perform uncoordinated catabolic and anabolic reactions that waste some of the energy that is stored."
    },
    {
     "id": 1246025,
     "content_html": "Metabolic pathways are economical due to the presence of anaplerotic reactions that replenish the intermediates."
    },
    {
     "id": 1246027,
     "content_html": "Metabolic pathways are economical due to feedback inhibition. Also, intermediates from one pathway can be utilized by other pathways."
    },
    {
     "id": 1246024,
     "content_html": "Metabolic pathways are wasteful, as most of the energy produced is utilized in maintaining the reduced environment of the cytosol."
    }
   ],
