 "questions": [
  {
   "id": 640394,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If the type of organism and the type of the habitat are known, what would be easiest to predict?\n",
   "answers": [
    {
     "id": 1249068,
     "content_html": "Reproductive strategies are fairly easy to predict."
    },
    {
     "id": 1249065,
     "content_html": "Nutritional strategies are fairly easy to predict."
    },
    {
     "id": 1249066,
     "content_html": "Both reproductive and nutritional strategies are fairly easy to predict."
    },
    {
     "id": 1249067,
     "content_html": "Neither reproductive nor nutritional strategies are fairly easy to predict."
    }
