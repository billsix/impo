   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is it necessary for most muscle cells to be under voluntary control?",
   "answers": [
    {
     "id": 1018209,
     "content_html": "to facilitate response to local conditions of tissues"
    },
    {
     "id": 1018210,
     "content_html": "to facilitate movement of bone"
    },
    {
     "id": 1018211,
     "content_html": "to speed up or slow down the autonomic nervous system"
    },
    {
     "id": 1018212,
     "content_html": "to facilitate movement of internal organs"
    }
