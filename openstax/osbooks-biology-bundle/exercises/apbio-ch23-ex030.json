 "questions": [
  {
   "id": 519794,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Students observe several slides of tissue cross-sections under the microscope. They are asked to develop a key system to classify the slides as coming from either monocot or dicots. What key system should the students develop?",
   "answers": [
    {
     "id": 1014699,
     "content_html": "In monocots, the vascular bundles form a distinct ring. In dicots, the vascular bundles are scattered in the ground tissue."
    },
    {
     "id": 1014700,
     "content_html": "In monocots, the vascular tissue forms a characteristic X shape in the center. In dicots, the phloem and xylem cells are scattered in the pith."
    },
    {
     "id": 1014701,
     "content_html": "In monocots, the vascular bundles are scattered in the ground tissue. In dicots the vascular bundles form a distinct ring."
    },
    {
     "id": 1014702,
     "content_html": "In monocot roots, the pith is absent or very small. In dicots, the pith is large and well developed."
    }
   ],
