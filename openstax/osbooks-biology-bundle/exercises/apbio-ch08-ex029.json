 "questions": [
  {
   "id": 232695,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Consider the processes involved in photosynthesis and the locations where they occur. Choose the statement that makes the best case for why the light-dependent reactions of photosynthesis take place in the thylakoid.",
   "answers": [
    {
     "id": 720925,
     "content_html": "Photosystem I is anchored to the membrane, but photosystem II is not."
    },
    {
     "id": 720926,
     "content_html": "The cytochrome complex requires a membrane for chemiosmosis to occur."
    },
    {
     "id": 720924,
     "content_html": "The light-dependent reactions depend on the presence of carbon dioxide."
    },
    {
     "id": 720923,
     "content_html": "Light energy is absorbed by the thylakoid membrane."
    }
   ],
