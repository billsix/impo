 "questions": [
  {
   "id": 519864,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do many ornamental plants that thrive indoors originate on the floor of tropical rainforest, where they grow under the canopy of trees?",
   "answers": [
    {
     "id": 1014979,
     "content_html": "Growing under the rainforest’s canopy made these plants adapt to less water and nutrients."
    },
    {
     "id": 1014980,
     "content_html": "With their narrow leaves, these plants are adapted to grow in low light."
    },
    {
     "id": 1014981,
     "content_html": "With their broad leaves, these plants are adapted to grow in low light, like that usually found indoors."
    },
    {
     "id": 1014982,
     "content_html": "Growing under the rainforest’s canopy provides the plants with more water and nutrients, which they also need as indoor plants."
    }
   ],
