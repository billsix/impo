 "questions": [
  {
   "id": 509401,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the enzyme reverse transcriptase violate the central dogma of molecular biology in HIV?",
   "answers": [
    {
     "id": 997288,
     "content_html": "The enzyme reverse transcriptase reverse transcribes the RNA in the genome of HIV to DNA."
    },
    {
     "id": 997289,
     "content_html": "The enzyme reverse transcriptase translates the RNA of the HIV into protein and then back to DNA."
    },
    {
     "id": 997290,
     "content_html": "The enzyme reverse transcriptase transcribes the DNA straight into the protein molecules."
    },
    {
     "id": 997291,
     "content_html": "The enzyme reverse transcriptase transcribes DNA to RNA, then again to DNA. There is no protein synthesis."
    }
   ],
