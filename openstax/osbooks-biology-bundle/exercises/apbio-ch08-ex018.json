 "questions": [
  {
   "id": 232684,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which excited electrons play a role in the formation of NADPH?",
   "answers": [
    {
     "id": 720881,
     "content_html": "Electrons from PS I cause the reduction of NADPH to <span data-math=\"\\text{NADP}^+\\!\">\\text{NADP}^+\\!</span>."
    },
    {
     "id": 720880,
     "content_html": "Electrons from PSII cause the reduction of <span data-math=\"\\text{NADP}^+\">\\text{NADP}^+</span> to NADPH."
    },
    {
     "id": 720882,
     "content_html": "Electrons from PS I cause the reduction of <span data-math=\"\\text{NADP}^+\\!\">\\text{NADP}^+\\!</span> to NADPH."
    },
    {
     "id": 720879,
     "content_html": "Electrons are gained which causes the oxidation of <span data-math=\"\\text{NADP}^+\\!\">\\text{NADP}^+\\!</span>."
    }
   ],
