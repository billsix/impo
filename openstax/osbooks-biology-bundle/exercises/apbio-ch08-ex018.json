 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm66463072\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"11\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n<span data-type=\"media\" id=\"fs-idm120938560\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/a0e046e085a7a9139464e73beacafd17fd502b31\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"12\">\n</span>\n<p id=\"fs-idm54765440\">Watch this <a href=\"https://openstaxcollege.org/l/light_reactions\" target=\"_blank\" rel=\"noopener nofollow\">video</a> to view the process of photosynthesis within a leaf.</p>\n</div>\n</div>",
