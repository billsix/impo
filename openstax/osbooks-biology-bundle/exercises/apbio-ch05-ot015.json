   "stimulus_html": "",
   "stem_html": "What is the difference between primary and secondary active transport?",
   "answers": [
    {
     "id": 1346219,
     "content_html": "Primary active transport is indirectly dependent on ATP, while secondary active transport is directly dependent on ATP."
    },
    {
     "id": 1346220,
     "content_html": "Primary active transport is directly dependent on ATP, while secondary active transport is indirectly dependent on ATP."
    },
    {
     "id": 1346218,
     "content_html": "Primary active transport does not require ATP, while secondary active transport is indirectly dependent on ATP."
    },
    {
     "id": 1346217,
     "content_html": "Primary active transport is indirectly dependent on ATP, while secondary active transport does not require ATP"
