  {
   "id": 232957,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe one reason why the garden pea was an excellent model system for studying inheritance.",
   "answers": [
    {
     "id": 721971,
     "content_html": "The garden pea has flowers that close tightly to promote cross-fertilization."
    },
    {
     "id": 721974,
     "content_html": "The garden pea has flowers that close tightly to prevent cross-fertilization."
    },
    {
     "id": 721972,
     "content_html": "The garden pea does not mature in one season and is a perennial plant."
    },
    {
     "id": 721973,
     "content_html": "Male and female reproductive parts attain maturity at different times, promoting self-fertilization."
    }
