 "questions": [
  {
   "id": 534670,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the heart’s internal pacemaker?",
   "answers": [
    {
     "id": 1045484,
     "content_html": "An internal implant sends an electrical impulse through the heart."
    },
    {
     "id": 1045485,
     "content_html": "It is an electrical impulse that starts in cardiac muscle cells at the sinoatrial node."
    },
    {
     "id": 1045486,
     "content_html": "It is the excitation of cardiac muscle cells at the atrioventricular node followed by the sinoatrial node."
    },
    {
     "id": 1045487,
     "content_html": "It starts in the aorta."
    }
   ],
