 "questions": [
  {
   "id": 232657,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>What type of cellular respiration is represented in the following equation, and why?</p>\n\n<div data-math=\"\\text{CO}_2 + \\text{H}_2 + \\text{NADH} \\rightarrow \\text{CH}_4 + \\text{H}_2\\text{O} + \\text{NAD}^+\">\\text{CO}_2 + \\text{H}_2 + \\text{NADH} \\rightarrow \\text{CH}_4 + \\text{H}_2\\text{O} + \\text{NAD}^+</div>\n",
   "answers": [
    {
     "id": 720774,
     "content_html": "Anaerobic respiration, because the final electron acceptor is inorganic."
    },
    {
     "id": 720773,
     "content_html": "Aerobic respiration, because oxygen is the final electron acceptor."
    },
    {
     "id": 720772,
     "content_html": "Anaerobic respiration, because NADH donates its electrons to a methane molecule."
    },
    {
     "id": 720771,
     "content_html": "Aerobic respiration, because water is being produced as a product."
    }
   ],
