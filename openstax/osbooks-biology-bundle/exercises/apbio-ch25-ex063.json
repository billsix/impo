 "questions": [
  {
   "id": 524190,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "a. What are micelles?<br>\n b. Why are micelles integral to lipid absorption?",
   "answers": [
    {
     "id": 1029088,
     "content_html": "a. Micelles are lipoproteins designed for the transport of lipids that enter lacteals. <br>\n b. Micelles facilitate absorption by microvilli, where the fatty acids and proteins diffuse out to form lipoproteins."
    },
    {
     "id": 1029089,
     "content_html": "a. Micelles are lipoproteins designed for the transport of lipids that enter lacteals. <br>\n b. Micelles facilitate absorption by microvilli, where the fatty acids and monoglycerides diffuse out to form triglycerides."
    },
    {
     "id": 1029090,
     "content_html": "a. Micelles are bile salt–surrounded fatty acids and phospholipids.<br>\n b. Micelles facilitate absorption by microvilli, where the fatty acids and monoglycerides diffuse out to form triglycerides."
    },
    {
     "id": 1029091,
     "content_html": "a. Micelles are bile salt–surrounded fatty acids and monoglycerides.<br>\n b. Micelles facilitate absorption by microvilli, where the fatty acids and monoglycerides diffuse out to form triglycerides."
    }
   ],
