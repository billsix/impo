  {
   "id": 334197,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Potassium is a necessary nutrient in order to maintain the function of our cells. What would occur to a person that is deficient in potassium?",
   "answers": [
    {
     "id": 842455,
     "content_html": "The excess sodium disrupts the membrane components."
    },
    {
     "id": 842456,
     "content_html": "The excess sodium increases action potential generation."
    },
    {
     "id": 842458,
     "content_html": "The cell would not be able to get rid of extra sodium."
    },
    {
     "id": 842457,
     "content_html": "The cell would not be able to bring sodium into the cell."
    }
   ],
