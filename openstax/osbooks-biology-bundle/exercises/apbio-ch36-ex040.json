 "questions": [
  {
   "id": 335973,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain the factors that may have contributed to the extinction of the woolly mammoth, and caused it to occur over a long period of time.",
   "answers": [
    {
     "id": 849462,
     "content_html": "Deforestation affected the ability of the woolly mammoth to find adequate habitat and food, and humans contributed to declines in their population by hunting them."
    },
    {
     "id": 849465,
     "content_html": "Climate change affected the ability of the woolly mammoth to find adequate habitat and food, and humans contributed to the decline in their population by hunting them."
    },
    {
     "id": 849463,
     "content_html": "Climate change affected the ability of the woolly mammoth to find adequate food even though they had plenty of habitat, and humans contributed to declines in their population by hunting them."
    },
    {
     "id": 849464,
     "content_html": "Climate change affected the ability of the woolly mammoth to find adequate habitat and food, and a plague affected Earth during that time causing their extinction."
    }
   ],
