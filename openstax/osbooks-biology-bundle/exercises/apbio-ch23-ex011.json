 "questions": [
  {
   "id": 519557,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Students are asked to sort tissue slides into simple and complex tissues. How should they recognize a complex tissue through the microscope?",
   "answers": [
    {
     "id": 1014351,
     "content_html": "Complex tissue has a variety of cell types that fulfill different functions."
    },
    {
     "id": 1014352,
     "content_html": "Only complex tissue is observed in adult plants."
    },
    {
     "id": 1014353,
     "content_html": "Complex tissue appears only in lateral roots and branches."
    },
    {
     "id": 1014354,
     "content_html": "Complex tissues contain cells that are strikingly different in appearance but perform the same function."
    }
   ],
