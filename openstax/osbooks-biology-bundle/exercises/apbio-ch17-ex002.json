 "questions": [
  {
   "id": 511881,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Examine the figure, which illustrates a molecular cloning experiment. You are working in this molecular biology lab and, unbeknownst to you, your lab partner left the foreign genomic DNA you are planning to clone on the lab bench overnight instead of storing it in the freezer. As a result, the DNA was degraded by nucleases, but you and your partner still used it in the experiment. The plasmid, on the other hand, is fine. What results would you predict from your cloning experiment?",
   "answers": [
    {
     "id": 1001162,
     "content_html": "There will be no colonies on the bacterial plate."
    },
    {
     "id": 1001163,
     "content_html": "There will be blue colonies only on the bacterial plate."
    },
    {
     "id": 1001164,
     "content_html": "There will be blue and white colonies on the bacterial plate."
    },
    {
     "id": 1001165,
     "content_html": "The will be white colonies only on the bacterial plate."
    }
   ],
