 "questions": [
  {
   "id": 668845,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>\n<img src=\"exercises/media/a8e3d5804ddc6277.png\" alt=\"Diagram showing arrows from UV light to skin exposure to damage to DNA to p53 activated to p21 activated to apoptosis to skin peels.\">\n</p><br>\n<p>The diagram illustrates the role of p53 in response to UV exposure. What would be the result of a mutation in the p53 gene that inactivates it?</p>",
   "answers": [
    {
     "id": 1333527,
     "content_html": "Skin will peel in response to UV exposure."
    },
    {
     "id": 1333528,
     "content_html": "Apoptosis will occur in response to UV exposure."
    },
    {
     "id": 1333529,
     "content_html": "No DNA damage will occur in response to UV exposure."
    },
    {
     "id": 1333530,
     "content_html": "No peeling of skin will occur in response to UV exposure."
    }
   ],
