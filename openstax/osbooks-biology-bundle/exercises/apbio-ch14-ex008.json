 "questions": [
  {
   "id": 504457,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain Griffith’s transformation experiments. What did he conclude from them?",
   "answers": [
    {
     "id": 992409,
     "content_html": "Two strains of S. pneumoniae were used for the experiment. Griffith injected a mouse with heat- inactivated S strain (pathogenic) and R strain (non-pathogenic). The mouse died and S strain was recovered from the dead mouse. He concluded that external DNA is taken up by a cell that changed morphology and physiology."
    },
    {
     "id": 992410,
     "content_html": "Two strains of Vibrio cholerae were used for the experiment. Griffith injected a mouse with heat-inactivated S strain (pathogenic) and R strain (non-pathogenic). The mouse died and S strain was recovered from the dead mouse. He concluded that external DNA is taken up by a cell that reversed the effects of heat inactivation."
    },
    {
     "id": 992411,
     "content_html": "Two strains of S. pneumoniae were used for the experiment. Griffith injected a mouse with heat-inactivated S strain (pathogenic) and R strain (non-pathogenic). The mouse died and R strain was recovered from the dead mouse. He concluded that external DNA is taken up by a cell that changed morphology and physiology."
    },
    {
     "id": 992412,
     "content_html": "Two strains of S. pneumoniae were used for the experiment. Griffith injected a mouse with heat-activated S strain (pathogenic) and R strain (non-pathogenic). The mouse died and S strain was recovered from the dead mouse. He concluded that mutation occurred in the DNA of the cell that changed morphology and physiology."
    }
   ],
