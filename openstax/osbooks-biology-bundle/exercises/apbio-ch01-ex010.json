 "questions": [
  {
   "id": 503302,
   "is_answer_order_important": true,
   "stimulus_html": "Watch <a href=\"https://openstax.org/l/rotating_DNA\" rel=\"nofollow\" target=\"_blank\">this gif animation</a> that animates the three-dimensional structure of the DNA molecule in the image.\n<img src=\"exercises/media/8866038088a898a1.jpg\" alt=\"dna molecule model\">",
   "stem_html": "The word helix means spiral. What does this tell you about the structure of DNA, which is a double helix macromolecule?",
   "answers": [
    {
     "id": 989191,
     "content_html": "The nucleotides of the two strands bond together with spiral bonds."
    },
    {
     "id": 989192,
     "content_html": "A double-stranded DNA molecule has two spiral strands bound together."
    },
    {
     "id": 989193,
     "content_html": "DNA is a double helix because it has two strands held together like a spiral staircase."
    },
    {
     "id": 989194,
     "content_html": "Nucleotides are spiral-shaped molecules that bond together to form DNA."
    }
   ],
