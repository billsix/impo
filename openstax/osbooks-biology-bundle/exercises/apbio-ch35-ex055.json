 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm11769824\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"5\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n<span data-type=\"media\" id=\"fs-idp194191472\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20210823.155019/resources/a8f22aaddc3c68bf8bbae6a71ba6f3e66d36ae9c\" data-media-type=\"image/jpeg\" alt=\"QR Code representing a URL\" width=\"120\" id=\"6\">\n</span>\n<p id=\"fs-idp160786320\">Watch this <a href=\"https://openstaxcollege.org/l/climate_plants\" target=\"_window\">NASA video</a> to discover the mixed effects of global warming on plant growth. While scientists found that warmer temperatures in the 1980s and 1990s caused an increase in plant productivity, this advantage has since been counteracted by more frequent droughts.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 242500,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/3742047e77dce00c.jpg\" alt=\"\">\n<figcaption>(credit: modification of work from The Guardian)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image shows changes in the winter ice around the North Pole.</p>\n<p>Make a claim based on this image.</p>",
   "answers": [
    {
     "id": 759461,
     "content_html": "The changes in the ice are caused by human activity."
    },
    {
     "id": 759462,
     "content_html": "The animals that live on the ice are experiencing habitat loss."
    },
    {
     "id": 759460,
     "content_html": "The changes in the ice are part of the cyclic climate changes that happen on Earth."
    },
    {
     "id": 759459,
     "content_html": "There are no plants affected by the change in ice cover."
    }
   ],
