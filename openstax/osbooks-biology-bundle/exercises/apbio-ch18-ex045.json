   "id": 233476,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which is least likely to be a factor that increases the probability of speciation by adaptive radiation?",
   "answers": [
    {
     "id": 724049,
     "content_html": "There are vacant ecological niches nearby."
    },
    {
     "id": 724050,
     "content_html": "Genetic drift in a population increases."
    },
    {
     "id": 724048,
     "content_html": "There are isolated regions with suitable habitats."
    },
    {
     "id": 724047,
     "content_html": "There are few competitor species."
    }
