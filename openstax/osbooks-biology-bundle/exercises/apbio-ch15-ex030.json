 "questions": [
  {
   "id": 509419,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In eukaryotes, pre-mRNAs are processed to form mature mRNAs. How does the mRNA editing that occurs in <em>Trypanosoma brucei</em> differ from mRNA processing that occurs in all eukaryotes?",
   "answers": [
    {
     "id": 997296,
     "content_html": "mRNA editing changes the coding sequence of the mRNA, but mRNA processing does not."
    },
    {
     "id": 997297,
     "content_html": "mRNA editing splices out noncoding RNA, but mRNA processing does not."
    },
    {
     "id": 997298,
     "content_html": "mRNA editing adds a cap of 5’-methylguanosine to the mRNA, but mRNA processing does not."
    },
    {
     "id": 997299,
     "content_html": "mRNA editing adds a 3’ poly-A tail, but mRNA processing does not."
    }
   ],
