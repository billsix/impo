 "questions": [
  {
   "id": 232228,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What type of compound functions in hormone production, contributes to membrane flexibility, and is the starting molecule for bile salts?",
   "answers": [
    {
     "id": 719062,
     "content_html": "All steroid molecules help in the mentioned functions."
    },
    {
     "id": 719063,
     "content_html": "Cholesterol, which is a lipid and also a steroid, functions here."
    },
    {
     "id": 719061,
     "content_html": "Glycogen, which is a multi-branched polysaccharide of glucose, is the compound."
    },
    {
     "id": 719060,
     "content_html": "Phosphatidylcholine that is a phospholipid with a choline head group, which serves the functions."
    }
   ],
