  {
   "id": 529709,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about circulatory systems is false?",
   "answers": [
    {
     "id": 1036772,
     "content_html": "In closed circulatory systems, blood flows through vessels that are separate from the interstitial fluid of the body."
    },
    {
     "id": 1036773,
     "content_html": "The earthworm has a closed circulatory system."
    },
    {
     "id": 1036774,
     "content_html": "In an open circulatory system, hemolymph empties into the body cavity."
    },
    {
     "id": 1036775,
     "content_html": "Lobsters are organisms that have closed circulatory systems."
    }
   ],
