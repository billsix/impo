   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/25ef3c53581ef180.jpg\" alt=\"\">\n<figcaption>(credit: modification of work from University of Michigan Medical School)</figcaption>\n</figure>\n",
