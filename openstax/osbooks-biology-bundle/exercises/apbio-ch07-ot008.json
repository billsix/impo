 "questions": [
  {
   "id": 232641,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Red blood cells (RBCs) do not perform aerobic respiration, but they do perform glycolysis. Provide the reasoning necessary to explain why all cells need an energy source, and predict what would happen if glycolysis were blocked in a sample of  RBCs.",
   "answers": [
    {
     "id": 720709,
     "content_html": "Cells need energy to perform cell division. Blocking glycolysis in RBCs interrupts the process of mitosis, leading to nondisjunction."
    },
    {
     "id": 720710,
     "content_html": "Cells require energy to perform certain basic functions. Blocking glycolysis in RBCs causes imbalance in the membrane potential, leading to cell death."
    },
    {
     "id": 720708,
     "content_html": "Cells maintain the influx and efflux of organic substances using energy. Blocking glycolysis stops the binding of CO<sub>2</sub> to the RBCs, causing cell death."
    },
    {
     "id": 720707,
     "content_html": "Cells require energy to recognize attacking pathogens. Blocking glycolysis inhibits the process of that recognition, causing invasion of the RBCs by a pathogen."
    }
   ],
