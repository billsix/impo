 "questions": [
  {
   "id": 504143,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "According to this passage, why does <em>P. falciparum</em> only need one drug-resistant dhps allele to express the drug resistance trait?",
   "answers": [
    {
     "id": 991219,
     "content_html": "The drug-resistant dhps allele is co-dominant with the wild type allele."
    },
    {
     "id": 991220,
     "content_html": "Only one dhps allele is present during all stages of the <em>P. falciparum</em> life cycle."
    },
    {
     "id": 991221,
     "content_html": "Only one dhps allele is present when <em>P. falciparum</em> is infectious."
    },
    {
     "id": 991222,
     "content_html": "The drug-resistant dhps allele prevents the wild type allele from being expressed."
    }
   ],
