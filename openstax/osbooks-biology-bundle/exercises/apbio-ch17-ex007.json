 "questions": [
  {
   "id": 522308,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the role of the plasmid in molecular cloning?",
   "answers": [
    {
     "id": 1022113,
     "content_html": "They are used to create clones."
    },
    {
     "id": 1022114,
     "content_html": "They are used as vectors to insert genes into bacteria."
    },
    {
     "id": 1022115,
     "content_html": "They are a functional part of binary fission."
    },
    {
     "id": 1022116,
     "content_html": "They contain the circular chromosome of prokaryotic organisms."
    }
