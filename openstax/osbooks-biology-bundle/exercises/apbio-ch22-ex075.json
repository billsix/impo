   "id": 520417,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Consider the images from the Exxon Valdez oil spill in Alaska in 1989. Make a case on what the success of bioremediation of oil spills depends.",
   "answers": [
    {
     "id": 1017073,
     "content_html": "Success depends on the presence of only aromatic and highly branched hydrocarbon chain compounds, and the temperature."
    },
    {
     "id": 1017074,
     "content_html": "Success depends on the presence of less nonvolatile and more aromatic and highly branched hydrocarbon chain compounds, and the temperature."
    },
    {
     "id": 1017075,
     "content_html": "Success depends on the type of oil compounds, the presence of naturally-occurring oil-solubilizing prokaryotes in the ocean, and the type of water body."
    },
    {
     "id": 1017076,
     "content_html": "Success depends on the type of oil compounds, the presence of naturally-occurring oil-solubilizing prokaryotes in the ocean, and the temperature."
    }
