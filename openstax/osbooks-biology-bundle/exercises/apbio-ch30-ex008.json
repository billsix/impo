 "questions": [
  {
   "id": 529083,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What structures of the respiratory system warm and remove impurities from inhaled air?",
   "answers": [
    {
     "id": 1035740,
     "content_html": "The epiglottis deflects impurities out of the trachea and into the esophagus, while the nasal cavity warms the air."
    },
    {
     "id": 1035741,
     "content_html": "Hair and mucus in the nose and trachea catch impurities, while the nasal cavity warms the air."
    },
    {
     "id": 1035742,
     "content_html": "Saliva in the mouth and hair in the trachea catch impurities, while the pharynx warms the air."
    },
    {
     "id": 1035743,
     "content_html": "The closed-off compartments of the larynx trap impurities in the air and warm the air."
    }
   ],
