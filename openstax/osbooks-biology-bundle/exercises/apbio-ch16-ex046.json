 "questions": [
  {
   "id": 233302,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "New drugs are being developed that decrease DNA methylation and prevent the removal of acetyl groups from histone proteins. Explain how these drugs could affect gene expression to help kill tumor cells.",
   "answers": [
    {
     "id": 723354,
     "content_html": "These drugs maintain the demethylated and the acetylated forms of the DNA to keep transcription of necessary genes “on”."
    },
    {
     "id": 723352,
     "content_html": "The demethylated and the acetylated forms of the DNA are reversed when the silenced gene is expressed."
    },
    {
     "id": 723353,
     "content_html": "The drug methylates and acetylates the silenced genes to turn them back “on”."
    },
    {
     "id": 723351,
     "content_html": "Drugs maintain DNA methylation and acetylation to silence unimportant genes in cancer cells."
    }
   ],
