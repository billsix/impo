  {
   "id": 639663,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/5542bb5570a1be80.jpg\" alt=\"Pictured are 23 chromosome pairs.\"></p>\n\n<p>Which of the following statements about structure 1 on the karyotype is not true?</p>\n",
   "answers": [
    {
     "id": 1246190,
     "content_html": "Structure 1 consists of homologous chromosomes."
    },
    {
     "id": 1246191,
     "content_html": "The two parts of structure 1 will have genes in different loci."
    },
    {
     "id": 1246189,
     "content_html": "The two parts of structure 1 originate from different parents."
    },
    {
     "id": 1246188,
     "content_html": "The two parts of structure 1 will have slightly different sequences of nucleotides."
    }
   ],
