 "questions": [
  {
   "id": 503422,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the passage of energy from light until it is captured in the primary electron acceptor.",
   "answers": [
    {
     "id": 989671,
     "content_html": "Chlorophyll molecules in the photosystems are excited and pass the energy to the primary electron acceptor where the energy is used to excite electrons from the splitting of water."
    },
    {
     "id": 989672,
     "content_html": "<i>Chlorophyll a</i> molecules in the photosystems are excited and pass the energy to the primary electron acceptor where the energy is used to excite electrons from the splitting of water."
    },
    {
     "id": 989673,
     "content_html": "<i>Chlorophyll b</i> molecules in the photosystems are excited and pass the energy to the primary electron acceptor where the energy is used to excite electrons from the splitting of water."
    },
    {
     "id": 989674,
     "content_html": "Chlorophyll molecules in the photosystems absorb light and get excited in the primary electron acceptor from where the energy is used to excite electrons from the splitting of water."
    }
   ],
