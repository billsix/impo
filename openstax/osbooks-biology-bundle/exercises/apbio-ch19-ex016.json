 "questions": [
  {
   "id": 639847,
   "is_answer_order_important": true,
   "stimulus_html": "Before Darwinian evolution became the prevailing theory of the field, French naturalist Jean-Baptiste Lamarck theorized that acquired traits could, in fact, be inherited; while this hypothesis has largely been unsupported, scientists have recently begun to realize that Lamarck was not completely wrong. Visit this <a href=\"http://openstax.org/l/epigenetic\" rel=\"nofollow\" target=\"_blank\">site</a> to learn more.",
   "stem_html": "Explain naturalist Jean-Baptiste Lamarck’s theory on heritability.",
   "answers": [
    {
     "id": 1246906,
     "content_html": "Lamarck theorized that individuals more fit to their environment would me more likely to survive, reproduce, and pass on their genes."
    },
    {
     "id": 1246907,
     "content_html": "Lamarck theorized that traits that parents acquired in their lifetime could be inherited by offspring in an attempt to improve."
    },
    {
     "id": 1246905,
     "content_html": "Lamarck theorized that traits in offspring were a blend of traits from the two parents."
    },
    {
     "id": 1246904,
     "content_html": "Lamarck theorized that inbreeding would lead to higher proportions of homozygous recessive genotypes, potentially conferring recessive diseases onto offspring."
    }
   ],
