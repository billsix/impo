 "questions": [
  {
   "id": 545001,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Ralph is always thirsty and recently learned that he synthesizes mutated antidiuretic hormone (ADH). Apply your understanding of the role of ADH to explain why Ralph would be at higher risk for diabetes insipidus.",
   "answers": [
    {
     "id": 1070253,
     "content_html": "ADH helps in the loss of water. Overproduction of ADH would cause improper functioning of kidneys."
    },
    {
     "id": 1070254,
     "content_html": "Underproduction of ADH inhibits the release of aldosterone that would cause improper functioning of kidneys."
    },
    {
     "id": 1070255,
     "content_html": "ADH helps retain water. Underproduction of ADH would cause improper functioning of kidneys."
    },
    {
     "id": 1070256,
     "content_html": "ADH helps in retaining electrolytes. Underproduction of ADH would cause improper functioning of kidneys."
    }
   ],
