 "questions": [
  {
   "id": 548805,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements best explains how infected prions cause disease?",
   "answers": [
    {
     "id": 1078275,
     "content_html": "Infected prions cause disease by transmitting nucleic acids to normal prion proteins."
    },
    {
     "id": 1078276,
     "content_html": "Infected prions cause disease by converting DNA to RNA in normal prion proteins."
    },
    {
     "id": 1078277,
     "content_html": "Infected prions cause disease by converting the shapes of normal proteins."
    },
    {
     "id": 1078278,
     "content_html": "Infected prions cause disease by replicating the normal form of the protein."
    }
   ],
