 "questions": [
  {
   "id": 535219,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/2215922850ee48c4.jpg\" alt=\"Illustration of a nerve cell including soma, axon, and axon terminal, with three panels below describing direction of travel of an action potential through a neuron. In the topmost diagram, the cell is depolarized at the soma. In the middle diagram, the cell is depolarizing along the axon and repolarization is occurring behind depolarization. In the third diagram, the cell is depolarizing along the axon and repolarization is occurring behind depolarization, with resting occurring behind repolarization.\"></p>\n\n<p>This figure shows the transfer of an action potential through a neuron. What is occurring in panel 3?</p>\n",
   "answers": [
    {
     "id": 1047380,
     "content_html": "Depolarization occurs closest to the cell body."
    },
    {
     "id": 1047381,
     "content_html": "The first part of the neuron cannot fire another action potential."
    },
    {
     "id": 1047382,
     "content_html": "The first part of the neuron can fire another action potential."
    },
    {
     "id": 1047383,
     "content_html": "Sodium channels have closed."
    }
   ],
