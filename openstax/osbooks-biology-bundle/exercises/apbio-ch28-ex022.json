 "questions": [
  {
   "id": 544279,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Erythropoietin stimulates red blood cell production and thus increases the amount of oxygen supplied to muscles and, consequently, endurance. Explain why erythropoietin might be potentially dangerous if taken to enhance athletic performance.",
   "answers": [
    {
     "id": 1069785,
     "content_html": "Erythropoietin increases blood viscosity, which makes it difficult for blood to circulate within the body."
    },
    {
     "id": 1069786,
     "content_html": "Erythropoietin decreases blood viscosity, which makes it difficult for blood to circulate within the body."
    },
    {
     "id": 1069787,
     "content_html": "Erythropoietin increases the activity of anorexigenic neurons, which makes it difficult for blood to circulate within the body."
    },
    {
     "id": 1069788,
     "content_html": "Erythropoietin increases blood viscosity, which reduces hunger and promotes a feeling of satiety."
    }
   ],
