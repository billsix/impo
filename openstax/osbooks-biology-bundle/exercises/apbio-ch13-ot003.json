 "questions": [
  {
   "id": 639710,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In a test cross for two characteristics (dihybrid cross), can the predicted frequency of recombinant offspring be  60%? Justify your claim with relevant reasoning.",
   "answers": [
    {
     "id": 1246372,
     "content_html": "No. The predicted frequency of recombinant offspring ranges from  0% (for linked traits) to 50% (for unlinked traits) because of both parental and nonparental cases."
    },
    {
     "id": 1246371,
     "content_html": "Yes. The predicted frequency of recombinant offspring can be 60% if genes are located very far from each other."
    },
    {
     "id": 1246370,
     "content_html": "Yes. The predicted frequency can be 60% if crossing over occurs during every meiotic event."
    },
    {
     "id": 1246369,
     "content_html": "No. The predicted frequency can never be 60% due to the presence of mutations such as deletions."
    }
   ],
