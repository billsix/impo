 "questions": [
  {
   "id": 233122,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You are looking at two fragments of DNA. Both have the sequence CATTCTG on one strand and GTAAGAC on the other. One of the fragments is exposed to UV light, the other is not. What will happen to the fragments and how might these mutations be repaired?",
   "answers": [
    {
     "id": 722634,
     "content_html": "The fragment exposed to UV light contains thymine dimers. Thymines lying adjacent to each other can form thymine dimers when exposed to UV light. They can be repaired by nucleotide excision."
    },
    {
     "id": 722631,
     "content_html": "The fragment exposed to UV light contains adenine dimers. Adenines lying adjacent to each other can form dimers when exposed to UV light. They can be repaired by nucleotide excision."
    },
    {
     "id": 722632,
     "content_html": "The fragment exposed to UV light contains thymine dimers. Thymines lying parallel to each other can form thymine dimers when exposed to UV light. They can be repaired by nucleotide excision."
    },
    {
     "id": 722633,
     "content_html": "The fragment exposed to UV light contains thymine dimers. Thymines lying adjacent to each other can form thymine dimers when exposed to UV light. They can be synthesized by nucleotide excision."
    }
   ],
