 "questions": [
  {
   "id": 677232,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are the advantages and disadvantages of light microscopes? What are the advantages and disadvantages of electron microscopes?",
   "answers": [
    {
     "id": 1346180,
     "content_html": "Advantage: In light microscopes, the light beam does not kill the cell. Electron microscopes are helpful in viewing intricate details of a specimen and have high resolution. Disadvantage: Light microscopes have low resolving power. Electron microscopes are costly and require killing the specimen."
    },
    {
     "id": 1346179,
     "content_html": "Advantage: Light microscopes have high resolution. Electron microscopes are helpful in viewing surface details of a specimen. Disadvantage: Light microscopes kill the cell. Electron microscopes are costly and low resolution."
    },
    {
     "id": 1346178,
     "content_html": "Advantage: Light microscopes have high resolution. Electron microscopes are helpful in viewing surface details of a specimen. Disadvantage: Light microscopes can be used only in the presence of light and are costly. Electron microscopes uses short wavelength of electrons and hence have lower magnification."
    },
    {
     "id": 1346177,
     "content_html": "Advantage: Light microscopes have high magnification. Electron microscopes are helpful in viewing surface details of a specimen. Disadvantage: Light microscopes can be used only in the presence of light and have lower resolution. Electron microscopes can be used only for viewing ultra-thin specimens."
    }
   ],
