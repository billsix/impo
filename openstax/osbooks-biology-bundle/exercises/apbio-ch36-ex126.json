 "questions": [
  {
   "id": 242736,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/8f55a709b59e136e.jpg\" alt=\"\">\n(credit: modification of work by Animal Planet's Meerkat Manor)\n</figure>",
   "stem_html": "<p>This image shows a meerkat looking out to spot predators as other meerkats forage.</p>\n<p>Which option describes this behavior?</p>",
   "answers": [
    {
     "id": 760405,
     "content_html": "It is a mating display. Males who can guard without eating are more fit and are more attractive to females."
    },
    {
     "id": 760404,
     "content_html": "It is a fixed action pattern. When some meerkats start foraging, the last meerkat keeps repeating this behavior."
    },
    {
     "id": 760403,
     "content_html": "It is a kinesis. When multiple meerkats bend down, some meerkats get into the guarding pose in response."
    },
    {
     "id": 760406,
     "content_html": "It is altruistic behavior. The meerkat chooses not to eat to increase the chances of its kin surviving."
    }
   ],
