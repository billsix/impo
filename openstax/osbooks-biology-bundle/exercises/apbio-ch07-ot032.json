    {
     "id": 720805,
     "content_html": "decreased activity of phosphofructokinase"
    },
    {
     "id": 720806,
     "content_html": "increased activity of pyruvate kinase"
    },
    {
     "id": 720804,
     "content_html": "decreased activity of isocitrate dehydrogenase"
    },
    {
     "id": 720803,
     "content_html": "slowdown of the electron transport chain"
