 "questions": [
  {
   "id": 241288,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/bc55846c84182854.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Riju Agrawal/Foreign Policy)</figcaption>\n</figure>",
   "stem_html": "<p>This graph shows the antibiotic resistance to penicillin in different countries. The x-axis shows the use of penicillin for treating outpatients (patients who are treated and sent home; patients who are not hospitalized).</p>\n<p>Noting penicillin is one of the many antibiotic drugs, make a hypothesis about antibiotic use in the countries seen in the graph.</p>",
   "answers": [
    {
     "id": 754614,
     "content_html": "France is using high amounts of antibiotics in treating outpatients and can benefit from a policy change."
    },
    {
     "id": 754613,
     "content_html": "The Netherlands are using very little antibiotics in treating outpatients and can be a model country in this regard."
    },
    {
     "id": 754612,
     "content_html": "Italy uses antibiotics in outpatient treatment more than usual, but has less resistance than expected. It can make a model country."
    },
    {
     "id": 754615,
     "content_html": "There is not enough information to make a hypothesis about antibiotic use in the graph."
    }
   ],
