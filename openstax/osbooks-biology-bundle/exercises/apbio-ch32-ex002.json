   "id": 534773,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is the sodium ion at the highest concentration in extracellular fluid?",
   "answers": [
    {
     "id": 1045902,
     "content_html": "Sodium diffuses freely through the cell membrane."
    },
    {
     "id": 1045903,
     "content_html": "The sodium/potassium pump removes sodium ions from the cell."
    },
    {
     "id": 1045904,
     "content_html": "The blood contains a high concentration of sodium."
    },
    {
     "id": 1045905,
     "content_html": "Sodium is actively taken up by the cells for use in the cytoplasm."
    }
   ],
