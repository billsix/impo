   "stimulus_html": "",
   "stem_html": "Which of the following statements does not accurately describe muscle contraction?",
   "answers": [
    {
     "id": 1073133,
     "content_html": "During muscle contraction, the sarcomere shortens."
    },
    {
     "id": 1073134,
     "content_html": "During muscle contraction, the thick and thin filaments shorten."
    },
    {
     "id": 1073135,
     "content_html": "During muscle contraction, the H zone shortens."
    },
    {
     "id": 1073136,
     "content_html": "During muscle contraction, the A band does not shorten."
    }
