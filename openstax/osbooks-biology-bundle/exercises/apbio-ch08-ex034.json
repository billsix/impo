 "questions": [
  {
   "id": 282889,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Discuss how membranes in chloroplasts contribute to the organelles’ essential functions.",
   "answers": [
    {
     "id": 819506,
     "content_html": "The inner membrane contains the chemicals needed for the Calvin cycle and also components of the light dependent reactions. The thylakoid membrane contains photosystems I and II, as well as the enzyme <span data-math=\"\\text{NADP}^+\">\\text{NADP}^+</span> reductase."
    },
    {
     "id": 819507,
     "content_html": "The inner membrane contains only the chemicals needed for the Calvin cycle. The thylakoid membrane contains components of the light dependent reactions, photosystems I and II, and the enzyme <span data-math=\"\\text{NADP}^+\">\\text{NADP}^+</span> reductase."
    },
    {
     "id": 819508,
     "content_html": "The inner membrane contains components of the light dependent reactions as well as photosystems I and II. The thylakoid membrane contains the chemicals needed for the Calvin cycle and also the enzyme <span data-math=\"\\text{NADP}^+\">\\text{NADP}^+</span> reductase."
    },
    {
     "id": 819509,
     "content_html": "The inner membrane contains the chemicals needed for the Calvin cycle, components of the light dependent reactions and photosystems I and II. The thylakoid membrane contains the enzyme <span data-math=\"\\text{NADP}^+\">\\text{NADP}^+</span> reductase."
    }
   ],
