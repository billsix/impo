 "questions": [
  {
   "id": 507859,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Spores are structures produced by some plants and all fungi. Apply your understanding of what defines the types of cells organisms possess and the functions of those cells to identify the statement that accurately defines and describes spores.",
   "answers": [
    {
     "id": 995124,
     "content_html": "Spores are haploid reproductive cells that can produce haploid organisms through mitosis."
    },
    {
     "id": 995125,
     "content_html": "Spores are diploid precursors to gametes that give rise to gametes when environmental conditions are favorable."
    },
    {
     "id": 995126,
     "content_html": "Spores are haploid reproductive cells that can produce diploid cells without fertilization."
    },
    {
     "id": 995127,
     "content_html": "Spores are diploid somatic cells formed only during asexual reproduction and so are not formed by meiosis."
    }
   ],
