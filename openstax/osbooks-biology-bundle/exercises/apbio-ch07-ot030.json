   "stimulus_html": "",
   "stem_html": "Which of the following statements about catabolic pathways is false?",
   "answers": [
    {
     "id": 989535,
     "content_html": "Carbohydrates can feed into oxidative phosphorylation."
    },
    {
     "id": 989536,
     "content_html": "Glycogen can be broken down into glucose and feed into glycolysis."
    },
    {
     "id": 989537,
     "content_html": "Amino acids can feed into pyruvate oxidation."
    },
    {
     "id": 989538,
     "content_html": "Fatty acids can feed into the citric acid cycle."
    }
