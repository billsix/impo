  {
   "id": 517109,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is necessary for normal human fertilization to occur?",
   "answers": [
    {
     "id": 1011318,
     "content_html": "Many eggs must be released."
    },
    {
     "id": 1011319,
     "content_html": "The uterus must be enlarged."
    },
    {
     "id": 1011320,
     "content_html": "One sperm needs to penetrate one egg."
    },
    {
     "id": 1011321,
     "content_html": "Secretion of pituitary FSH and LH must decrease."
    }
   ],
