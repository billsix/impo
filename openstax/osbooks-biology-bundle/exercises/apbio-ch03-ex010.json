 "questions": [
  {
   "id": 513062,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does Stanley Miller and Harold Urey’s model support the claim that simple precursors present on early Earth could have assembled into complex molecules necessary for life?",
   "answers": [
    {
     "id": 1003968,
     "content_html": "The simple molecules assembled to form amino acids and nucleic acids."
    },
    {
     "id": 1003969,
     "content_html": "The organic molecules assembled to form large complexes such as starch and RNA."
    },
    {
     "id": 1003970,
     "content_html": "The inorganic molecules assembled to form the amino acids and nucleic acids."
    },
    {
     "id": 1003971,
     "content_html": "The inorganic molecules assembled to form large complexes such as starch and RNA."
    }
   ],
