 "questions": [
  {
   "id": 504349,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Tay-Sachs disease is an autosomal recessive disorder that causes severe problems in neurons. Children who receive two copies of the gene rarely live beyond the age of five. There is no cure for the disease. During a genetic screening, a couple is told that both partners carry the recessive gene. What kind of benefit does this couple have by knowing this information?",
   "answers": [
    {
     "id": 991985,
     "content_html": "scientific"
    },
    {
     "id": 991986,
     "content_html": "financial"
    },
    {
     "id": 991987,
     "content_html": "medical"
    },
    {
     "id": 991988,
     "content_html": "there is no benefit."
    }
   ],
