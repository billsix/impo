 "questions": [
  {
   "id": 534631,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Plasma and serum are common terms. Both are important parts of blood. What is the difference between blood plasma and blood serum?",
   "answers": [
    {
     "id": 1045323,
     "content_html": "Blood plasma is made up of blood serum and other components. Serum is the component of plasma containing blood coagulation factors."
    },
    {
     "id": 1045324,
     "content_html": "Blood serum is made up of blood plasma and other components. Plasma is the component of serum containing blood coagulation factors."
    },
    {
     "id": 1045325,
     "content_html": "Blood plasma is made of blood serum and other components. Serum is the component of plasma without the blood coagulation factors."
    },
    {
     "id": 1045326,
     "content_html": "Blood plasma is made up of blood serum and other components. Serum is the component of plasma, which lacks antibodies and hormones."
    }
