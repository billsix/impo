 "questions": [
  {
   "id": 504461,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which piece of evidence supports that the material Miescher discovered in white blood cells was DNA? What did he name the material and why?",
   "answers": [
    {
     "id": 992425,
     "content_html": "The precipitate contained sulfur. He called the material globulin because it formed clumps."
    },
    {
     "id": 992426,
     "content_html": "The precipitate contained oxygen. He called the material hemease because it was found in the blood."
    },
    {
     "id": 992427,
     "content_html": "The precipitate contained phosphorus. He called the material nuclein because it was found in the nucleus."
    },
    {
     "id": 992428,
     "content_html": "The precipitate contained protein. He called the material animolicule because it was universal to all animals tested."
    }
   ],
