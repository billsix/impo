 "questions": [
  {
   "id": 546502,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how two different species can coexist in the same habitat according to the competitive exclusion principle.",
   "answers": [
    {
     "id": 1071176,
     "content_html": "Two species can coexist in the same habitat as long as they do not share the same trophic level."
    },
    {
     "id": 1071177,
     "content_html": "Two species can coexist in the same habitat as long as they do not share the same mates."
    },
    {
     "id": 1071178,
     "content_html": "Two species can coexist in the same habitat as long as they do not share the same resources."
    },
    {
     "id": 1071179,
     "content_html": "Two species can coexist in the same habitat as long as they do not share the same life span."
    }
   ],
