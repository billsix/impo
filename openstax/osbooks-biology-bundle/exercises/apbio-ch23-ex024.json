   "id": 520812,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Scientists are cataloguing slides of plant cross-sections. They are interested in finding examples of secondary growth. Which example contributes to secondary growth?",
   "answers": [
    {
     "id": 1017883,
     "content_html": "apical meristem, which contributes to increase in length"
    },
    {
     "id": 1017884,
     "content_html": "vascular cambium, which contributes to increase in thickness or girth"
    },
    {
     "id": 1017885,
     "content_html": "root region, which shows an increase in root hairs"
    },
    {
     "id": 1017886,
     "content_html": "stems, which show an increase in number of leaves"
    }
   ],
