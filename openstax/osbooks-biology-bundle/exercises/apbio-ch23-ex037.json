 "questions": [
  {
   "id": 519822,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "One of the major concepts of biology is that form follows function. If that is so, what can be deduced from the shape and location of the root cap?",
   "answers": [
    {
     "id": 1014811,
     "content_html": "It provides protection to the root tip."
    },
    {
     "id": 1014812,
     "content_html": "It absorbs water and minerals."
    },
    {
     "id": 1014813,
     "content_html": "It acts as a storage tissue."
    },
    {
     "id": 1014814,
     "content_html": "It replicates actively to elongate the root."
    }
   ],
