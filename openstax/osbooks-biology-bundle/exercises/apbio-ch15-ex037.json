 "questions": [
  {
   "id": 233210,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Can you predict how alternative splicing may lead to an economy of genes? Do you need a different gene for every protein that the cell can produce?",
   "answers": [
    {
     "id": 722986,
     "content_html": "No, alternative splicing can lead to the synthesis of several proteins from a single gene."
    },
    {
     "id": 722985,
     "content_html": "Yes, alternative splicing can lead to the synthesis of several forms of mRNA from a single gene, building more complex proteins."
    },
    {
     "id": 722984,
     "content_html": "No, alternative splicing can lead to the synthesis of several forms of codons from a set of genes."
    },
    {
     "id": 722983,
     "content_html": "Yes, alternative splicing can lead to the synthesis of several forms of ribosomes from a set of genes, but only one protein per gene."
    }
   ],
