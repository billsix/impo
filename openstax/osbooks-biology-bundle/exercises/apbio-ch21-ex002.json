  {
   "id": 534925,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Viruses were first discovered after the development of the porcelain filter, called the Chamberland-Pasteur filter. How did the porcelain filter enable scientists to discover viruses?",
   "answers": [
    {
     "id": 1046525,
     "content_html": "The porcelain filter removed diseases from a liquid sample."
    },
    {
     "id": 1046526,
     "content_html": "The porcelain filter removed virions from a liquid sample."
    },
    {
     "id": 1046527,
     "content_html": "The porcelain filter removed bacteria from a liquid sample."
    },
    {
     "id": 1046528,
     "content_html": "The porcelain filter removed a disease from tobacco plants."
    }
   ],
