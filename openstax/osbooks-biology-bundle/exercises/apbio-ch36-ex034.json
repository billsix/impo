 "questions": [
  {
   "id": 242577,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/b73b2a3353fc3321.jpg\" alt=\"\">\n(credit: modification of work by Tinker, M.T., et al./<i>Journal Wildlife Management</i>)\n</figure>",
   "stem_html": "<p>This graph shows the population of sea otters in a location near Alaska.</p>\n<p>Make a claim on the carrying capacity of the environment, based on this information.</p>",
   "answers": [
    {
     "id": 759769,
     "content_html": "The carrying capacity is constant around 600 individuals."
    },
    {
     "id": 759770,
     "content_html": "The carrying capacity was constant for a some years between 1990 and 2010, but dropped afterwards."
    },
    {
     "id": 759768,
     "content_html": "The carrying capacity was low in 1980s, but gradually increased to 600 individuals."
    },
    {
     "id": 759767,
     "content_html": "The carrying capacity is around 300 individuals and the population is correcting an overshot."
    }
   ],
