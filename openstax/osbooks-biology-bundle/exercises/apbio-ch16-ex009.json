 "questions": [
  {
   "id": 522164,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would happen if the operator sequence of the <em>lac</em> operon contained a mutation that prevented the repressor protein from binding the operator?",
   "answers": [
    {
     "id": 1021682,
     "content_html": "In the presence of lactose, the lac operon will not be transcribed."
    },
    {
     "id": 1021683,
     "content_html": "In the absence of lactose, the lac operon will be transcribed."
    },
    {
     "id": 1021684,
     "content_html": "The cAMP-CAP complex will not increase RNA synthesis."
    },
    {
     "id": 1021685,
     "content_html": "The RNA polymerase will not bind the promoter."
    }
   ],
