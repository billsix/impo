 "questions": [
  {
   "id": 511871,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement is correct regarding the distinction between prokaryotic and eukaryotic gene expression?",
   "answers": [
    {
     "id": 1001122,
     "content_html": "Prokaryotes regulate gene expression at the level of transcription whereas eukaryotes regulate at multiple levels including epigenetic, transcriptional and translational."
    },
    {
     "id": 1001123,
     "content_html": "Prokaryotes regulate gene expression at the level of translation whereas eukaryotes regulate at the level of transcription to manipulate protein levels."
    },
    {
     "id": 1001124,
     "content_html": "Prokaryotes regulate gene expression with the help of repressors and activators whereas eukaryotes regulate expression by degrading mRNA transcripts, thereby controlling protein levels."
    },
    {
     "id": 1001125,
     "content_html": "Prokaryotes control protein levels using epigenetic modifications whereas eukaryotes control protein levels by regulating the rate of transcription and translation."
    }
   ],
