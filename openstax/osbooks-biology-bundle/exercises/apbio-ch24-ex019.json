   "id": 520473,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What purpose is served when osteoclasts break down bone?",
   "answers": [
    {
     "id": 1017281,
     "content_html": "deposition of bone material into the bone matrix"
    },
    {
     "id": 1017282,
     "content_html": "facilitation of osteoclast persistence without using excess energy"
    },
    {
     "id": 1017283,
     "content_html": "providing access to calcium stored in the tissue"
    },
    {
     "id": 1017284,
     "content_html": "facilitation of compact bone structure"
    }
   ],
