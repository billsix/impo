   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Circadian rhythm refers to a pattern of behavior that recurs on a daily schedule in the absence of an external stimulus. Flowers open and close according to a circadian rhythm. If a plant is transferred to a dark environment, what will happen?",
   "answers": [
    {
     "id": 1015777,
     "content_html": "Flowers will stay closed."
    },
    {
     "id": 1015778,
     "content_html": "Flowers will stay open."
    },
    {
     "id": 1015779,
     "content_html": "Flowers will open and close every day at the same time."
    },
    {
     "id": 1015780,
     "content_html": "Flowers will open and close at random times."
    }
