 "questions": [
  {
   "id": 233296,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A mutation is found in eIF-2 that impairs the initiation of translation. The mutation could affect all but one of the following functions of eIF-2. Which one would not be affected?",
   "answers": [
    {
     "id": 723329,
     "content_html": "The mutation prevents eIF-2 from binding to RNA."
    },
    {
     "id": 723330,
     "content_html": "The mutation prevents eIF-2 from being phosphorylated."
    },
    {
     "id": 723328,
     "content_html": "The mutation prevents eIF-2 from binding to GTP."
    },
    {
     "id": 723327,
     "content_html": "The mutation prevents eIF-2 from binding to the 40S ribosomal subunit."
    }
   ],
