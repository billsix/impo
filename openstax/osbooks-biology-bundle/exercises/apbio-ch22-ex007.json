   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The most substantial difficulty in culturing prokaryotes in laboratory settings is related to _____.",
   "answers": [
    {
     "id": 1078572,
     "content_html": "the lack of knowledge about their needs for growth"
    },
    {
     "id": 1078573,
     "content_html": "growth requirements that are too difficult to meet"
    },
    {
     "id": 1078574,
     "content_html": "inefficient methods for resuscitation of viable but nonculturable (VBNC) organisms"
    },
    {
     "id": 1078575,
     "content_html": "the expense of techniques such as polymerase chain reaction (PCR)"
    }
