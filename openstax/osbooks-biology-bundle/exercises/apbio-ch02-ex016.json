 "questions": [
  {
   "id": 671629,
   "is_answer_order_important": true,
   "stimulus_html": "To learn more about water, visit the U.S. Geological Survey Water Science for Schools All About Water! website.",
   "stem_html": "Water takes up 333 million cubic miles on Earth, yet access to drinking water is a critical issue for many communities around the world. Explain why this is so.",
   "answers": [
    {
     "id": 1342943,
     "content_html": "Drinking water is only obtained by rain water harvesting."
    },
    {
     "id": 1342944,
     "content_html": "Only 3 percent of the total water on earth is freshwater which is found only in glaciers."
    },
    {
     "id": 1342945,
     "content_html": "Only 3 percent of the total water on earth is freshwater, out of which 68 percent is found in glaciers."
    },
    {
     "id": 1342946,
     "content_html": "Drinking water is only obtained by desalination treatments of salt water found on earth."
    }
   ],
