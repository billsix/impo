   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The side effects of menopause can be diminished by hormone replacement therapy (HRT). However, many doctors are hesitant to recommend it. What are the possible reasons for this?",
   "answers": [
    {
     "id": 743763,
     "content_html": "Its negative side effects, which include increased risk of colon cancer, osteoporosis, heart disease, macular degeneration, and possibly depression"
    },
    {
     "id": 743764,
     "content_html": "Its negative side effects, which include increased risk of stroke or heart attack, blood clots, breast cancer, ovarian cancer, endometrial cancer, gall bladder disease, and possibly depression."
    },
    {
     "id": 743765,
