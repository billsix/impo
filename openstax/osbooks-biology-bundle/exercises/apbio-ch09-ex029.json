 "questions": [
  {
   "id": 503518,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Analyze the connection between cell signaling pathways and cell growth to answer the following question: How does the extracellular matrix control the growth of cells?",
   "answers": [
    {
     "id": 990055,
     "content_html": "Contact of receptors with the extracellular matrix maintains equilibrium of the cell and provides optimal pH for the growth of the cells."
    },
    {
     "id": 990056,
     "content_html": "Contact of the receptor with the extracellular matrix helps maintain concentration gradients across membrane, resulting in the flow of ions."
    },
    {
     "id": 990057,
     "content_html": "The extracellular matrix provides nutrients for the cell, supporting receptor function."
    },
    {
     "id": 990058,
     "content_html": "The extracellular matrix connects the cell to the external environment and ensures correct positioning of the cell to prevent metastasis."
    }
   ],
