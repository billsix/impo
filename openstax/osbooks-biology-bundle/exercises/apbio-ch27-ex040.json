   "id": 535885,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You are having a debate with someone in a library. A librarian asks you to “speak softer.” What characteristic of sound does the librarian want you to change and how can you change it?",
   "answers": [
    {
     "id": 1049819,
     "content_html": "wavelength, by lowering the amplitude at which you are speaking"
    },
    {
     "id": 1049820,
     "content_html": "amplitude, by lowering the frequency at which you are speaking"
    },
    {
     "id": 1049821,
     "content_html": "frequency, by lowering the volume at which you are speaking"
    },
    {
     "id": 1049822,
     "content_html": "amplitude, by lowering the volume at which you are speaking."
    }
   ],
