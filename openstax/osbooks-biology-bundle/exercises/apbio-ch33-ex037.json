 "questions": [
  {
   "id": 535461,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A healthy person produces antibodies to pathogens that invade the body. However, if this person becomes infected with HIV, the body loses the ability to produce antibodies. Research has shown that the virus attacks and destroys CD4+T cells. Why does destruction of CD4+T cells lead to a loss of antibody synthesis in HIV-infected patients?",
   "answers": [
    {
     "id": 1048140,
     "content_html": "CD4+T cells are a required intermediate in a series of cell-to-cell signaling events that must be completed before B cells can mature."
    },
    {
     "id": 1048141,
     "content_html": "CD4+T cells have CD4 molecules covalently bound to their cell surfaces and do not induce apoptosis in other cells during an immune response."
    },
    {
     "id": 1048142,
     "content_html": "CD4+T cell counts are about 1,000 per microliter in a healthy person, but drop below 400 per microliter in a person who cannot mount an immune response."
    },
    {
     "id": 1048143,
     "content_html": "CD4+T cell precursors are formed in the bone marrow and then migrate to the thymus, where they develop their T cell receptors."
    }
   ],
   "hints": [],
