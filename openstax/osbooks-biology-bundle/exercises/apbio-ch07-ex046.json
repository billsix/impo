 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id2121507\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-id1631696\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/bdd672e674245ef7fb989343f346d672e711a44c\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-id2054751\">Visit this <a href=\"https://openstaxcollege.org/l/electron_transp\" target=\"_blank\" rel=\"noopener nofollow\">site</a> to see an animation of the electron transport chain and ATP synthesis.</p>\n</div>\n</div>\n",
 "stimulus_html": "",
 "questions": [
  {
   "id": 639627,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement best describes the formation and importance of the hydrogen ion gradient during the electron transport chain? ",
   "answers": [
    {
     "id": 1246046,
     "content_html": "A hydrogen ion gradient across the membrane establishes a concentration gradient and not an electrical gradient, thus assisting during the electron transport chain."
    },
    {
     "id": 1246047,
     "content_html": "A hydrogen ion gradient is established by pumping hydrogen ions across the membrane from the matrix in the intermembrane space. Its uneven distribution across the membrane establishes both concentration and electrical gradients."
    },
    {
     "id": 1246045,
     "content_html": "A hydrogen ion gradient is established by pumping hydrogen ions across the membrane from the intermembrane space into the matrix and its uneven distribution across the membrane establishes concentration and electrical gradients."
    },
    {
     "id": 1246044,
     "content_html": "Hydrogen ions are present in the intermembrane space from the beginning and results in the formation of gradients necessary for the function of ATP synthase."
    }
   ],
