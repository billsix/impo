 "questions": [
  {
   "id": 535207,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does the human body need more than its skin to function as a barrier to infecting pathogens?",
   "answers": [
    {
     "id": 1047332,
     "content_html": "Skin works only against some types of bacteria. To prevent the entry of other pathogens, other physical or chemical barriers are needed."
    },
    {
     "id": 1047333,
     "content_html": "Skin does not provide a broad coverage against invasion of the body by any foreign particle, so it is not a very effective barrier."
    },
    {
     "id": 1047334,
     "content_html": "Pathogens could enter the body through several places that are not covered by skin that need to have a barrier to prevent infection."
    },
    {
     "id": 1047335,
     "content_html": "Skin acts only as a chemical barrier against pathogens. The body also needs physical barriers to prevent various types of infection."
    }
   ],
