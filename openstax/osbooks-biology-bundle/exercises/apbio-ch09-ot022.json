 "questions": [
  {
   "id": 507601,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Signal transduction pathways regulate a range of responses in cells. The mitogen-activated protein (MAP) kinase cascade triggered by receptor tyrosine kinases (RTKs) results in cell division. Predict likely scenarios of abnormalities in the MAPK pathway leading to uncontrolled cell proliferation.",
   "answers": [
    {
     "id": 994568,
     "content_html": "gain of function mutation in RAS protein, mutation in I κ -B, loss of function mutation in genes for MAPK kinase pathway, regulated phosphorylation cascade"
    },
    {
     "id": 994569,
     "content_html": "loss of function mutation in RAS protein and gain of function mutation in RAF protein, I κ -B permanently bound to NF- κ B, regulated phosphorylation cascade"
    },
    {
     "id": 994570,
     "content_html": "RAS protein unable to hydrolyze its bound GTP, loss of function mutation in I κ -B, gain of function mutation in genes for MAPK kinase pathway, unregulated phosphorylation cascade"
    },
    {
     "id": 994571,
     "content_html": "unregulated phosphorylation cascade, loss of function mutation in RAS and RAF protein, mutation in genes for MAPK kinase pathway, regulated phosphorylation cascade"
    }
   ],
