 "questions": [
  {
   "id": 530396,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two cultures of bacteria are separated by a filter that blocks the movement of cells but allows free exchange of anything smaller than a bacterial cell. On one side of the filter, a sample of penicillin-resistant cells in culture broth is added. On the second side of the filter, a culture of penicillin-sensitive cells in culture is added. After 24 hours, resistant cells appear on the side with the cells sensitive to penicillin. Evaluate these findings to answer the following: Which three genetic mechanisms can account for the appearance of the penicillin-resistant cells  on the other side of the filter?",
   "answers": [
    {
     "id": 1037536,
     "content_html": "transformation, transduction, and conjugation"
    },
    {
     "id": 1037537,
     "content_html": "transformation, transduction, and mutation"
    },
    {
     "id": 1037538,
     "content_html": "transformation, conjugation, and mutation"
    },
    {
