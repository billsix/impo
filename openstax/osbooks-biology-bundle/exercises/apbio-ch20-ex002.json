 "context": "<figure id=\"fig-ch20_01_05\">\n<span data-type=\"media\" id=\"fs-idp24152896\" data-alt=\"Illustration shows the taxonomic groups shared by various species. All of the organisms shown are in the domain Eukarya: plants, insects, fish, rabbits, cats, foxes, jackals wolves, and dogs. Of theses, insects, fish, rabbits, cats, foxes, jackals, wolves and dogs are in the kingdom Animalia. Within the kingdom Animalia, fish, rabbits, cats, foxes, jackals, wolves, and dogs are in the phylum Chordata. Rabbits, cats, foxes, jackals, wolves, and dogs are in the class Mammalia. Cats, foxes, jackals, wolves, and dogs are in the order Carnivora. Foxes, jackals, wolves, and dogs are in the family Canidae. Jackals, wolves and dogs are in the genus Canis. Wolves and Dogs and have the species name Canis lupus. Dogs have the subspecies name Canis lupus familiaris.\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/4e14b42775471f52bab2c4a8f2f393dbca1a3540\" data-media-type=\"image/jpg\" alt=\"Illustration shows the taxonomic groups shared by various species. All of the organisms shown are in the domain Eukarya: plants, insects, fish, rabbits, cats, foxes, jackals wolves, and dogs. Of theses, insects, fish, rabbits, cats, foxes, jackals, wolves and dogs are in the kingdom Animalia. Within the kingdom Animalia, fish, rabbits, cats, foxes, jackals, wolves, and dogs are in the phylum Chordata. Rabbits, cats, foxes, jackals, wolves, and dogs are in the class Mammalia. Cats, foxes, jackals, wolves, and dogs are in the order Carnivora. Foxes, jackals, wolves, and dogs are in the family Canidae. Jackals, wolves and dogs are in the genus Canis. Wolves and Dogs and have the species name Canis lupus. Dogs have the subspecies name Canis lupus familiaris.\" width=\"500\" id=\"9\">\n</span>\n\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 233647,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "At what levels are cats and dogs considered to be part of the same group?",
   "answers": [
    {
     "id": 724735,
     "content_html": "Cats and dogs are only found together in the Domain level."
    },
    {
     "id": 724738,
     "content_html": "Cats and dogs are in the same group beginning at the Domain level and including the sublevels Kingdom, Phylum, Class, and Order."
    },
    {
     "id": 724736,
     "content_html": "Cats and dogs are in the same group beginning at the Family level."
    },
    {
     "id": 724737,
     "content_html": "Cats and dogs are part of the same group beginning with the Order: Carnivora level."
    }
   ],
