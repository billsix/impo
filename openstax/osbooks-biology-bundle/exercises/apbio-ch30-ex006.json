 "questions": [
  {
   "id": 547186,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Emphysema is a disease characterized by a great reduction in the number of functioning alveoli in the lungs. What effect would emphysema likely have on the respiratory system?",
   "answers": [
    {
     "id": 1073813,
     "content_html": "Less gas exchange would occur with the blood."
    },
    {
     "id": 1073814,
     "content_html": "Less air could travel through the trachea."
    },
    {
     "id": 1073815,
     "content_html": "Air could no longer pass through the nasal cavity."
    },
    {
     "id": 1073816,
     "content_html": "Air could no longer vibrate the vocal cords of the larynx."
    }
   ],
