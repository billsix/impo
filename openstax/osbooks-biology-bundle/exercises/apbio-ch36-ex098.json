 "questions": [
  {
   "id": 546584,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Monarch butterflies in the eastern regions of North America migrate thousands of miles to an area in Mexico in the fall and then back to northern regions in the spring. Explain how this migration behavior came to be established in this species.",
   "answers": [
    {
     "id": 1071490,
     "content_html": "Each new generation learned the migration behavior by observing older generations and mimicking their behavior patterns."
    },
    {
     "id": 1071491,
     "content_html": "In very early generations of this species, a few individuals found that migration improved their chances for survival and taught their young to carry on the behavior."
    },
    {
     "id": 1071492,
     "content_html": "Individuals that migrated survived through the winter, whereas individuals that did not migrate died, leading to selection for migration in later generations."
    },
    {
     "id": 1071493,
     "content_html": "When this butterfly emerged as a new species, by chance it inherited the genetic material that underlies long-distance migration behavior from its ancestor."
    }
   ],
