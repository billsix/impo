 "questions": [
  {
   "id": 639792,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Changes in epigenetic modifications alter the accessibility and transcription of DNA. Describe how environmental stimuli, such as ultraviolet light exposure, could modify gene expression.",
   "answers": [
    {
     "id": 1246693,
     "content_html": "UV rays could cause methylation and deacetylation of the genes that could alter the accessibility and transcription of DNA."
    },
    {
     "id": 1246692,
     "content_html": "The UV rays could cause phosphorylation and acetylation of the DNA and histones which could alter the transcriptional capabilities of the DNA."
    },
    {
     "id": 1246691,
     "content_html": "UV rays could cause methylation and phosphorylation of the DNA bases which could become dimerized rendering no accessibility of DNA."
    },
    {
     "id": 1246690,
     "content_html": "The UV rays can cause methylation and acetylation of histones making the DNA more tightly packed and leading to inaccessibility."
    }
   ],
