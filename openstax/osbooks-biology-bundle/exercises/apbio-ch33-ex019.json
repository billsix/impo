 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp73081248\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-idm11357488\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/bd3a77048f1c3a8da1973259e79e009fe1a59e55\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idp44884592\">This <a href=\"https://openstaxcollege.org/l/immune_system\" target=\"_blank\" rel=\"noopener nofollow\">animation</a> from Rockefeller University shows how dendritic cells act as sentinels in the body's immune system.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 535409,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What key role do dendritic cells play in the human immune response?",
   "answers": [
    {
     "id": 1047932,
     "content_html": "Dendritic cells directly kill infected cells and emit cytokines, which amplify the immune response."
    },
    {
     "id": 1047933,
     "content_html": "Dendritic cells recognize foreign proteins and prepare them to be displayed to immune cells in the lymph. This activates an immune response."
    },
    {
     "id": 1047934,
     "content_html": "Dendritic cells identify tumor cells or cells infected with viruses and destroy them."
    },
    {
     "id": 1047935,
     "content_html": "Dendritic cells act as phagocytes. They engulf and digest pathogens."
    }
   ],
