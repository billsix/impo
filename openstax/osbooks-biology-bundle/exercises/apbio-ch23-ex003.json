 "questions": [
  {
   "id": 522409,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An herbicide causes roots to shrivel and die. What is the most direct consequence for a plant treated with the herbicide?",
   "answers": [
    {
     "id": 1022515,
     "content_html": "The plant will grow normally but will not bloom."
    },
    {
     "id": 1022516,
     "content_html": "The plant will dry out because water is not reaching all its organs."
    },
    {
     "id": 1022517,
     "content_html": "New leaves will form to compensate for the dying of roots"
    },
    {
     "id": 1022518,
     "content_html": "The plant will grow normally but will not produce fruit"
    }
   ],
