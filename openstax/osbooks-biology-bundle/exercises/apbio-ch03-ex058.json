   "stem_html": "Where is the linkage made that combines two amino acids?",
   "answers": [
    {
     "id": 978370,
     "content_html": "between the R group of one amino acid and the R group of the second"
    },
    {
     "id": 978371,
     "content_html": "between the carboxyl group of one amino acid and the amino group of the other"
    },
    {
     "id": 978372,
     "content_html": "between the 6 carbon of both amino acids"
    },
    {
     "id": 978373,
     "content_html": "between the nitrogen atoms of the amino groups in the amino acids"
    }
