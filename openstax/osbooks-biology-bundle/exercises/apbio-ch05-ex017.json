 "questions": [
  {
   "id": 639562,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Both of the regular intravenous solutions administered in medicine, normal saline and lactated Ringer’s solution, are isotonic, such as seen in the middle image here. Why is this important?\n<img src=\"exercises/media/de2c6418afcafc84.png\" alt=\"The left part of this illustration shows shriveled red blood cells bathed in a hypertonic solution. The middle part shows healthy red blood cells bathed in an isotonic solution, and the right part shows bloated red blood cells bathed in a hypotonic solution.\">",
   "answers": [
    {
     "id": 1245796,
     "content_html": "Isotonic solutions maintain equilibrium and avoid the exchange of materials to or from the blood."
    },
    {
     "id": 1245795,
     "content_html": "Isotonic solutions disrupt equilibrium and allow better exchange of materials in the blood."
    },
    {
     "id": 1245794,
     "content_html": "Isotonic solutions increase the pH of blood and allow better absorption of saline in blood."
    },
    {
     "id": 1245793,
     "content_html": "Isotonic solutions decrease the pH of the blood and avoid the exchange of materials to or from the blood."
    }
   ],
