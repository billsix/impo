 "questions": [
  {
   "id": 535405,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do natural killer cells react to healthy cells compared to cells infected with a pathogen?",
   "answers": [
    {
     "id": 1047916,
     "content_html": "Natural killer cells recognize MHC I on a healthy cell and do not kill it, while the infected cells that do not present MHC I are killed."
    },
    {
     "id": 1047917,
     "content_html": "Natural killer cells recognize MHC I on an infected cell and kill it, while the healthy cells that do not present MHC I are not killed."
    },
    {
     "id": 1047918,
     "content_html": "Natural killer cells recognize MHC II on a healthy cell and do not kill it, while the infected cells that do not present MHC II are killed."
    },
    {
     "id": 1047919,
     "content_html": "Natural killer cells recognize MHC II on an infected cell and kill it, while the healthy cells that do not present MHC II are not killed."
    }
   ],
