  {
   "id": 242078,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/40acde5da02fc725.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by David Chambers/Cambridge University Press)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image shows the pressures in different areas of the lung for a person that is standing upright.</p>\n<p>Which part of the lung has the highest air ventilation (V) and blood perfusion (Q) ratio (V/Q)?</p>",
   "answers": [
    {
     "id": 757775,
     "content_html": "The uppermost part of the lung."
    },
    {
     "id": 757774,
     "content_html": "The upper middle part of the lung."
    },
    {
     "id": 757773,
     "content_html": "The lower middle part of the lung."
    },
    {
     "id": 757772,
     "content_html": "The lowermost part of the lung."
    }
   ],
