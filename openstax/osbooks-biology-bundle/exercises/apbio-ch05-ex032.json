 "questions": [
  {
   "id": 513346,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In what important way does receptor-mediated endocytosis differ from phagocytosis?",
   "answers": [
    {
     "id": 1004978,
     "content_html": "It transports only small amounts of fluid."
    },
    {
     "id": 1004979,
     "content_html": "It does not involve the pinching off of membrane."
    },
    {
     "id": 1004980,
     "content_html": "It brings in only a specifically targeted substance."
    },
    {
     "id": 1004981,
     "content_html": "It brings substances into the cell, while phagocytosis removes substances."
    }
   ],
