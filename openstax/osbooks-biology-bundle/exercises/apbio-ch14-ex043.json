 "questions": [
  {
   "id": 509109,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe how the model of DNA replication illustrates the function of topoisomerase.",
   "answers": [
    {
     "id": 996736,
     "content_html": "Topoisomerase relieves the pressure that results from supercoiling by breaking and reforming DNA’s phosphate backbone ahead of the replication fork."
    },
    {
     "id": 996737,
     "content_html": "Topoisomerase increases the pressure to increase supercoiling by breaking and reforming DNA’s phosphate backbone ahead of the replication fork."
    },
    {
     "id": 996738,
     "content_html": "Topoisomerase relieves the pressure that results from supercoiling by breaking and reforming DNA’s nucleotide base pairs ahead of the replication fork."
    },
    {
     "id": 996739,
     "content_html": "Topoisomerase relieves the pressure that results from separation of DNA strands by breaking and reforming DNA’s phosphate backbone ahead of the replication fork."
    }
   ],
