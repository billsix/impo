 "questions": [
  {
   "id": 550731,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare and contrast food chains and food webs. What are the strengths of each concept in describing ecosystems?",
   "answers": [
    {
     "id": 1082552,
     "content_html": "Both food chain and food web follow a single path as energy is transferred in an ecosystem. Food chains are easier to follow and experiment with but less accurate whereas food webs are more holistic and complex."
    },
    {
     "id": 1082553,
     "content_html": "Both food web and food chain describe energy transfer dynamics in an ecosystem. Food chains are non-linear systems which are easier to follow and experiment with whereas food webs are linear, holistic and can be directly used as input for simulation models."
    },
    {
     "id": 1082554,
     "content_html": "Both food chain and food web follow a single path as energy is transferred in an ecosystem. Food chains are linear systems, easier to follow and used directly as input for simulation models, whereas food webs are non-linear, accurate, holistic and flexible for analytical modeling."
    },
    {
     "id": 1082555,
     "content_html": "Both food web and food chain describe energy transfer dynamics in an ecosystem. Food chains are linear systems, easier to follow and experiment with whereas food webs are non-linear, accurate and holistic and can be directly used as input for simulation models."
    }
   ],
