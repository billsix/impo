 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp1850384\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n    <span data-type=\"media\" id=\"fs-idm16982416\" data-alt=\"QR Code representing a URL\">\n        <img src=\"https://openstax.org/apps/archive/20241024.164013/resources/d52f705fd2fbcb379358a984945d274bb86e3f40\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n    </span>\n    <p id=\"fs-idp75993600\">Watch a <a href=\"https://www.khanacademy.org/science/biology/her/tree-of-life/v/viruses\" target=\"_blank\" rel=\"noopener nofollow\">video</a> on viruses, identifying structures, modes of transmission, replication, and more.</p>\n</div>\n</div>",
