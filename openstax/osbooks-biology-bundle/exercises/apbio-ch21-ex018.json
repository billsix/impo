 "questions": [
  {
   "id": 548518,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do viruses penetrate a host cell?",
   "answers": [
    {
     "id": 1077695,
     "content_html": "To get inside the host cell, the virus forces the cell to lyse, or break open."
    },
    {
     "id": 1077696,
     "content_html": "To get inside a host cell, the virus produces proteins and copies its genome."
    },
    {
     "id": 1077697,
     "content_html": "To get inside a host cell, the virus attaches to a variable receptor site on the host cell."
    },
    {
     "id": 1077698,
     "content_html": "To get inside a host cell, the virus can fuse the membrane of the cell."
    }
   ],
