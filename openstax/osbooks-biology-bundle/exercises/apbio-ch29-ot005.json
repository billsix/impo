   "id": 546769,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "While on vacation, you discover the carcass of an unusual new organism on the beach. As a scientist, you decide to chemically analyze the carcass in order to characterize it. The chemical analysis reveals significant amounts of chitin. Determine from this result what other molecule might you also find associated with the skeletal system of this organism.",
   "answers": [
    {
     "id": 1072209,
     "content_html": "calcium carbonate"
    },
    {
     "id": 1072210,
     "content_html": "calcium phosphate"
    },
    {
     "id": 1072211,
     "content_html": "hydroxyapatite"
    },
    {
     "id": 1072212,
     "content_html": "magnesium carbonate"
    }
   ],
