 "questions": [
  {
   "id": 519824,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A technician is preparing microscope slides that will display the different stages of mitosis from root samples. He compares sections from several areas of the root. Which is the best prediction of his observation?",
   "answers": [
    {
     "id": 1014819,
     "content_html": "The technician will see mostly mitotic cells in the root cap."
    },
    {
     "id": 1014820,
     "content_html": "The technician will observe mitotic figures in the meristematic tissue below the cap."
    },
    {
     "id": 1014821,
     "content_html": "The technician will observe cell division in the elongation zone."
    },
    {
     "id": 1014822,
     "content_html": "The technician will see that most mitotic cells are in the maturation zone."
    }
   ],
