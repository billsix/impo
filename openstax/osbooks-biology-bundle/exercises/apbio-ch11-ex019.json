 "questions": [
  {
   "id": 507855,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "One of the ways that sexual reproduction enhances the diversity of offspring from the same parents is through a process called crossing over. Provide the reasoning that supports this concept by identifying the structures and meiotic phase involved in crossing over.",
   "answers": [
    {
     "id": 995108,
     "content_html": "Crossing over occurs between tetrads during prophase I."
    },
    {
     "id": 995109,
     "content_html": "Crossing over occurs between sister chromatids during metaphase I."
    },
    {
     "id": 995110,
     "content_html": "Crossing over occurs between non-sister chromatids of homologous chromosomes during prophase I."
    },
    {
     "id": 995111,
     "content_html": "Crossing over occurs between non-homologous chromosomes during telophase I and cytokinesis."
    }
   ],
