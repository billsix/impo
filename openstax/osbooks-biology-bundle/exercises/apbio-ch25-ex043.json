 "questions": [
  {
   "id": 524043,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "a. Why is it necessary to consume essential nutrients?<br>\n b. What are two examples of fat-soluble essential vitamins, and what are their functions in the human body?",
   "answers": [
    {
     "id": 1028796,
     "content_html": "a. Essential nutrients are not synthesized by the body and are not necessary for proper body function.<br>\n b. Vitamins B and C are two fat-soluble essential vitamins. Vitamin B helps maintain eyesight, and vitamin C is essential for blood clotting."
    },
    {
     "id": 1028797,
     "content_html": "a. Essential nutrients are not synthesized by the body but are necessary for proper body function.<br>\n b. Vitamins A and K are two fat-soluble essential vitamins. Vitamin A helps maintain connective tissue, and vitamin K is essential for blood clotting."
    },
    {
     "id": 1028798,
     "content_html": "a. Essential nutrients are synthesized by the body and are necessary for proper body function.<br>\n b. Vitamins D and K are two fat-soluble essential vitamins. Vitamin D helps maintain a stable nervous system, and vitamin K is essential for blood clotting."
    },
    {
     "id": 1028799,
     "content_html": "a. Essential nutrients are not synthesized by the body but are necessary for proper body function.<br>\n b. Vitamins A and K are two fat-soluble essential vitamins. Vitamin A helps maintain eyesight, and vitamin K is essential for blood clotting."
    }
