 "questions": [
  {
   "id": 503532,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The RAS protein is a G-protein connected with the response to receptor tyrosine kinases (RTKs) that initiates the MAPK kinase cascade when GDP is released and GTP uploaded. Mutations in the RAS protein, which interfere with its GTPase activity, are common in cancer. Examine the connection between the inability of RAS to hydrolyze GTP and uncontrolled cell proliferation.  Select the best explanation of this connection below.",
   "answers": [
    {
     "id": 990111,
     "content_html": "RAS, when bound to GTP, becomes permanently inactive even in the presence of the ligand, and no longer regulates cell division."
    },
    {
     "id": 990112,
     "content_html": "RAS, when bound to GTP, becomes permanently active even in the absence of the ligand, and no longer regulates cell division."
    },
    {
     "id": 990113,
     "content_html": "RAS, when bound to GTP, forms a dimer after binding to the ligand, and causes uncontrolled division, but it remains inactive when the ligand is absent."
    },
    {
     "id": 990114,
     "content_html": "RAS, when bound to GTP, does not form a dimer after binding to the ligand but stimulates downstream signaling to occur and causes uncontrolled cell division."
    }
   ],
