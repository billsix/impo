 "questions": [
  {
   "id": 548961,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Scientists believe that the first organisms on Earth were extremophiles. Justify this claim with relevant evidence of what scientists know about Earth's early environment.",
   "answers": [
    {
     "id": 1078604,
     "content_html": "Earth’s early environment was full of extreme places with high levels of oxygen in the atmosphere, no ozone to shield Earth’s surface from mutagenic radiation, much geologic upheaval, and volcanic activity. Extremophiles are bacteria and archaea that are adapted to grow in extreme environments."
    },
    {
     "id": 1078605,
     "content_html": "Earth’s early environment was full of extreme places with little oxygen in the atmosphere, no ozone to shield Earth’s surface from mutagenic radiation, much geologic upheaval and volcanic activity. Extremophiles are bacteria and archaea that are adapted to grow in extreme environments."
    },
    {
     "id": 1078606,
     "content_html": "Earth’s early environment was full of extreme places with little oxygen in the atmosphere and excessive concentrations of ozone that contributed to mutagenic radiation. Extremophiles are phototrophic bacteria and cyanobacteria that are adapted to grow in extreme environments."
    },
    {
     "id": 1078607,
     "content_html": "For the first two billion years of Earth’s existence, the atmosphere had no molecular oxygen."
    }
   ],
