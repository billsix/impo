 "questions": [
  {
   "id": 522395,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Define aneuploidy.",
   "answers": [
    {
     "id": 1022459,
     "content_html": "Aneuploidy is a mutation that causes the genome of a cell to break down."
    },
    {
     "id": 1022460,
     "content_html": "Aneuploidy is the condition of having too many or too few chromosomes as a result of an error during cell division."
    },
    {
     "id": 1022461,
     "content_html": "Aneuploidy is the condition of having every chromosome be inactive, resulting in an inviable embryo."
    },
    {
     "id": 1022462,
     "content_html": "Aneuploidy is a prezygotic barrier in which the gametes of two distinct species will not fertilize each other."
    }
   ],
