 "questions": [
  {
   "id": 242381,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What function does the diversity of the variable region of an antibody help it perform?",
   "answers": [
    {
     "id": 758985,
     "content_html": "It helps in communication of antibodies with other components of immune system."
    },
    {
     "id": 758984,
     "content_html": "It helps the antibodies to function with very low affinity and specificity."
    },
    {
     "id": 758986,
     "content_html": "It enables many different antibodies to be made that all have different specificities of binding."
    },
    {
     "id": 758983,
     "content_html": "It enables many different antibodies to be made that all have same specificities of binding."
    }
   ],
