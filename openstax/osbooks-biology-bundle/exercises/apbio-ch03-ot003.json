   "stem_html": "In the metabolism of a cell, why is hydrolysis used?",
   "answers": [
    {
     "id": 978490,
     "content_html": "Hydrolysis breaks down polymers."
    },
    {
     "id": 978491,
     "content_html": "Hydrolysis is used to form linkages in DNA."
    },
    {
     "id": 978492,
     "content_html": "Hydrolysis is used to produce proteins."
    },
    {
     "id": 978493,
     "content_html": "Hydrolysis synthesizes new macromolecules."
    }
