   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/0427390fe70bef0d.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Organismal Biology/Georgia Tech Biological Sciences, under CC BY-NC-SA 3.0 license)</figcaption>\n</figure>\n",
