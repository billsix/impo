 "questions": [
  {
   "id": 503526,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The poison from the krait snake’s bungarotoxin binds irreversibly to acetylcholine receptors, interfering with acetylcholine binding at the synapse. What then do you predict is the effect of bungarotoxin binding on the post synaptic cell?",
   "answers": [
    {
     "id": 990087,
     "content_html": "cAMP production is inhibited."
    },
    {
     "id": 990088,
     "content_html": "Bungarotoxin G-proteins are not activated."
    },
    {
     "id": 990089,
     "content_html": "Ion movement in the cell is inhibited."
    },
    {
     "id": 990090,
     "content_html": "Phosphorylation cascade is inhibited."
    }
   ],
