 "questions": [
  {
   "id": 530212,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Glycolysis, or the breakdown of glucose, is a process used by almost all organisms as a way to release energy stored within glucose molecules. This energy can then be stored in cells as ATP, which powers cell processes when needed. What does this show, in terms of the evolutionary history of cells using glycolysis?",
   "answers": [
    {
     "id": 1037328,
     "content_html": "Glycolysis has been conserved despite the independent evolution of the three domains of life."
    },
    {
     "id": 1037329,
     "content_html": "Prokaryotes would likely not benefit from the Krebs cycle or the ETC."
    },
    {
     "id": 1037330,
     "content_html": "Prokaryotes likely evolved after eukaryotes."
    },
    {
     "id": 1037331,
     "content_html": "Glycolysis is the only way in which living things can break down glucose."
    }
   ],
