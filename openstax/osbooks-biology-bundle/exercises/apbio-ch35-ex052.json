 "questions": [
  {
   "id": 535743,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens to aquatic life in deep lakes when water freezes during the winter months?",
   "answers": [
    {
     "id": 1049257,
     "content_html": "During winters, layer of ice falls on water surface as it is less dense than water. Water is densest at 7° C and retains its liquid form below the water surface. The aquatic life can exist in liquid water."
    },
    {
     "id": 1049258,
     "content_html": "During winters, the aquatic life exists in liquid water, which is present below the surface layer, by consuming more resources so they can survive during the harsh winter season."
    },
    {
     "id": 1049259,
     "content_html": "During winters, a layer of ice forms on the water surface, as ice is less dense than water. Water is densest at 4°C and retains its liquid form below the water surface, where the ice layer is. In liquid water, the aquatic life can survive using the resources available."
    },
    {
     "id": 1049260,
     "content_html": "During winters, ice forms only on the surface and a few meters below the surface of water. Water is densest at 4°C and retains its liquid form below the water surface, where the ice layer is. In liquid water, the aquatic life can exist using the resources available."
    }
   ],
