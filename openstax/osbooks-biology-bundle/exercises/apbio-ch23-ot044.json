  {
   "id": 640086,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "On a field trip, students collect a few samples to analyze back in their classroom. One student picks a blade of grass in the field and identifies it as a dicot leaf, but his partner thinks it is a monocot. Which explanation supports his partner’s opinion?",
   "answers": [
    {
     "id": 1247850,
     "content_html": "The leaf displays a thin lamina."
    },
    {
     "id": 1247849,
     "content_html": "There is no petiole."
    },
    {
     "id": 1247848,
     "content_html": "The margins are serrated."
    },
    {
     "id": 1247851,
     "content_html": "The venation is parallel."
    }
   ],
