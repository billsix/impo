 "questions": [
  {
   "id": 535117,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The Malpighian tubules filter waste materials out of the blood, or hemolymph, of insects. There are cells lining the tubules that pump solutes (mainly ions) into the space surrounding the Malpighian tubules. If you observed a gradual increase in the solute concentration outside of the Malpighian tubules, what would you expect to happen?",
   "answers": [
    {
     "id": 1046978,
     "content_html": "Water would be drawn out of the hemolymph within the tubule."
    },
    {
     "id": 1046979,
     "content_html": "Water would be drawn into the tubule."
    },
    {
     "id": 1046980,
     "content_html": "Ions would be drawn out of the hemolymph within the tubule."
    },
    {
     "id": 1046981,
     "content_html": "Ions would be drawn into the tubule."
    }
   ],
