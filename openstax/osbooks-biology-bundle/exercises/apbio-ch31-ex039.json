   "stimulus_html": "",
   "stem_html": "How do arteries differ from veins?",
   "answers": [
    {
     "id": 1045516,
     "content_html": "Arteries have thicker smooth muscle layers to accommodate the changes in pressure from the heart."
    },
    {
     "id": 1045517,
     "content_html": "Arteries carry plasma."
    },
    {
     "id": 1045518,
     "content_html": "Arteries have thinner smooth muscle layers and valves and move blood by the action of skeletal muscle."
    },
    {
     "id": 1045519,
     "content_html": "Arteries are thin walled."
    }
   ],
