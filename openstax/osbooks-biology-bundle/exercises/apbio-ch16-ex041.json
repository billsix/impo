 "questions": [
  {
   "id": 639793,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Protein modifications can alter gene expression in many ways. Describe how phosphorylation of proteins can alter gene expression.",
   "answers": [
    {
     "id": 1246697,
     "content_html": "Phosphorylation of proteins can alter translation, RNA shuttling, RNA stability or post transcriptional modification."
    },
    {
     "id": 1246696,
     "content_html": "Phosphorylation of proteins can alter DNA replication, cell division, pathogen recognition and RNA stability."
    },
    {
     "id": 1246695,
     "content_html": "Phosphorylated proteins affect only translation and can cause cancer by altering the p53 function."
    },
    {
     "id": 1246694,
     "content_html": "Phosphorylated proteins affect only RNA shuttling, RNA stability, and post-translational modifications."
    }
   ],
