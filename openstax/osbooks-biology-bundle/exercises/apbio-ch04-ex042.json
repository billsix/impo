 "questions": [
  {
   "id": 285911,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Radioactive amino acids are fed to a cell in culture for a short amount of time. This is called a pulse. You follow the appearance of radioactive proteins in the cell compartments. In which organelles and in what order does radioactivity appear?",
   "answers": [
    {
     "id": 820058,
     "content_html": "endoplasmic reticulum - lysosomes - Golgi body - vesicle - extracellular region"
    },
    {
     "id": 820059,
     "content_html": "endoplasmic reticulum - vesicles - Golgi body - vesicles - extracellular region"
    },
    {
     "id": 820060,
     "content_html": "Golgi Body - vesicles - endoplasmic reticulum - vesicles - extracellular region"
    },
    {
     "id": 820061,
     "content_html": "nucleus - endoplasmic reticulum - Golgi body - vesicle - extracellular region"
    }
   ],
