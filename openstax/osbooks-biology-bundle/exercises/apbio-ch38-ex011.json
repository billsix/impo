 "questions": [
  {
   "id": 531824,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which factor explains that in general, temperate and polar regions have less biodiversity than tropical regions?",
   "answers": [
    {
     "id": 1040212,
     "content_html": "The tropical regions are subjected to extreme changes of season."
    },
    {
     "id": 1040213,
     "content_html": "The polar regions were populated earliest in the history of Earth."
    },
    {
     "id": 1040214,
     "content_html": "The polar regions receive more intense solar energy."
    },
    {
     "id": 1040215,
     "content_html": "The tropical regions contain more micro-ecosystems."
    }
   ],
