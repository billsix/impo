 "questions": [
  {
   "id": 531747,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What statement about risk genes in Alzheimer’s disease is true?",
   "answers": [
    {
     "id": 1039904,
     "content_html": "Risk genes do not guarantee that a person will get Alzheimer’s disease."
    },
    {
     "id": 1039905,
     "content_html": "Risk genes account for &lt;5% of Alzheimer’s cases."
    },
    {
     "id": 1039906,
     "content_html": "Risk genes directly cause a disease."
    },
    {
     "id": 1039907,
     "content_html": "Individuals with risk genes have symptoms that develop when an individual is in their 40s or 50s."
    }
   ],
