 "questions": [
  {
   "id": 242105,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Define a closed circulatory system and compare the differences in heart structure for animals with closed circulatory systems.",
   "answers": [
    {
     "id": 757882,
     "content_html": "A closed circulatory system is a system in which the blood mixes with the interstitial fluid. Fish have a two-chambered heart. Amphibians and reptiles have a three-chambered heart, but the latter has little mixing of blood. Mammals and birds have a four-chambered heart and double circulation."
    },
    {
     "id": 757883,
     "content_html": "A closed circulatory system is a system in which blood is separate from the interstitial fluid. Fish have a two-chambered heart. Amphibians and reptiles have a three-chambered heart, but the latter has little mixing of blood. Mammals and birds have a four-chambered heart and double circulation."
    },
