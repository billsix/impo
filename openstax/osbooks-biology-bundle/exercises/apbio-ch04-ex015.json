 "questions": [
  {
   "id": 677234,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Eukaryotic cells contain complex organelles that carry out their chemical reactions. While prokaryotes lack many of these complex organelles, they have a variety of unique structures of their own. Most prokaryotic cells can, however, exchange nutrients with the outside environment faster than most eukaryotic cells. Why is this so?",
   "answers": [
    {
     "id": 1346188,
     "content_html": "Most prokaryotic cells are smaller and have a higher surface area-to-volume ratio than eukaryotic cells."
    },
    {
     "id": 1346185,
     "content_html": "Most prokaryotic cells are larger and have a higher surface area-to-volume ratio than eukaryotic cells."
    },
    {
     "id": 1346186,
     "content_html": "Most prokaryotic cells are smaller and have a lower surface area-to-volume ratio than eukaryotic cells."
    },
    {
     "id": 1346187,
     "content_html": "Most prokaryotic cells are larger and have a lower surface area-to-volume ratio than eukaryotic cells."
    }
