 "questions": [
  {
   "id": 242264,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do contractile vacuoles work as excretory systems in microorganisms?",
   "answers": [
    {
     "id": 758516,
     "content_html": "Contractile vacuoles excrete excess water and waste by the process of endocytosis, in which these vacuoles merge with cell membrane and expel wastes into the environment."
    },
    {
     "id": 758517,
     "content_html": "Contractile vacuoles excrete uric acid by the process of exocytosis, in which water as well as uric acid is excreted by contraction of a cell when the vacuole merges with the cell membrane."
    },
    {
     "id": 758518,
     "content_html": "Contractile vacuoles excrete excess water and uric acid by the process of endocytosis when the vacuole merges with the cell membrane."
    },
    {
     "id": 758519,
     "content_html": "Contractile vacuoles excrete excess water and waste by the process of exocytosis, in which the vacuoles merge with the cell membrane and expel wastes into the environment."
    }
   ],
