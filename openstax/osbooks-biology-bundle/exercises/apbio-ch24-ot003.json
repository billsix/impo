 "questions": [
  {
   "id": 520421,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Radial symmetry is typically found in aquatic organisms. What is radial symmetry and why is it advantageous to certain aquatic organisms?",
   "answers": [
    {
     "id": 1017089,
     "content_html": "Radially symmetric means that a plane cut from the front to back of the organism produces distinct left and right sides that are mirror images of each other. It helps certain aquatic organisms to extract food from surrounding environments."
    },
    {
     "id": 1017090,
     "content_html": "Radially symmetric means that a plane cut from the front to back of the organism produces distinct left and right sides that are mirror images of each other. It helps certain aquatic organisms to perform photosynthesis."
    },
    {
     "id": 1017091,
     "content_html": "Radially symmetric means that a plane cut along its longitudinal axis will produce equal halves, and there is no distinct left or right. It helps certain aquatic organisms to perform photosynthesis."
    },
    {
     "id": 1017092,
     "content_html": "Radially symmetric means that a plane cut along its longitudinal axis to produce equal halves, and there is no distinct left or right. It helps certain aquatic organisms to extract food from surrounding environments."
    }
