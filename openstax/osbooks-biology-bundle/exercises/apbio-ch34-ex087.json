 "questions": [
  {
   "id": 238542,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "During organogenesis, the ectoderm forms the neural cells and the epidermal cells. How do the ectoderm cells determine which type of cells to form?",
   "answers": [
    {
     "id": 743906,
     "content_html": "Growth factors signal some of the ectodermal cells to form epidermal cells, and the remaining cells form the neural plate."
    },
    {
     "id": 743903,
     "content_html": "The notochord cells of the mesoderm signal the ectodermal cells to form epidermal cells as well as the neural plate."
    },
    {
     "id": 743904,
     "content_html": "Growth factors signal some of the ectodermal cells to form epidermal cells, and the remaining cells form neural crest cells."
    },
    {
     "id": 743905,
     "content_html": "Proteins involved in the Wnt signaling pathway signal the ectodermal cells to form the epidermal cells and the neural plate."
    }
   ],
