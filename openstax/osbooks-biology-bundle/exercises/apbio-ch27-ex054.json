 "questions": [
  {
   "id": 544193,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain what happens once visual signals reach the visual cortex.",
   "answers": [
    {
     "id": 1069497,
     "content_html": "Some signals go to the temporal lobe, which detects “where” information, and other signals go to the parietal lobe, which detects “where” and “what” signals."
    },
    {
     "id": 1069498,
     "content_html": "Some signals go to the parietal lobe, which detects “where” information, and other signals go to the temporal lobe, which detects “what” signals."
    },
    {
     "id": 1069499,
     "content_html": "Some signals go to the parietal lobe, which detects “where” and “what” information and other signals go to the temporal lobe, which also detects “where” and “what” signals."
    },
    {
     "id": 1069500,
     "content_html": "Some signals go to the parietal lobe, which detects “where” information, and other signals go to the temporal lobe, which detects “where” and “what” signals."
    }
