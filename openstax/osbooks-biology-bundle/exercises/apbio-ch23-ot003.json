 "questions": [
  {
   "id": 519535,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Plant scientists are interested in isolating meristematic tissue for an experiment. They sample several regions of a plant. Which sample is most likely to contain meristematic tissue?",
   "answers": [
    {
     "id": 1014263,
     "content_html": "the thin epidermis that covers an onion bulb"
    },
    {
     "id": 1014264,
     "content_html": "a sample of fruit tissue "
    },
    {
     "id": 1014265,
     "content_html": "a sample of actively dividing cells located at the tip of an onion root"
    },
    {
     "id": 1014266,
     "content_html": "a region of the mesenchyme"
    }
   ],
