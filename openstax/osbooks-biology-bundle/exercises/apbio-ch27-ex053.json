 "questions": [
  {
   "id": 544183,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Discuss how the relationship between photoreceptors and bipolar cells is different from other sensory receptors and adjacent cells.",
   "answers": [
    {
     "id": 1069481,
     "content_html": "Photoreceptors and bipolar cells are depolarized, whereas other sensory receptors typically remain polarized."
    },
    {
     "id": 1069482,
     "content_html": "Photoreceptors and bipolar cells are hyperpolarized, whereas other sensory receptors typically remain polarized."
    },
    {
     "id": 1069483,
     "content_html": "Photoreceptors and bipolar cells are depolarized, whereas other sensory receptors typically become hyperpolarized."
    },
    {
     "id": 1069484,
     "content_html": "Photoreceptors and bipolar cells are hyperpolarized, whereas other sensory receptors typically become depolarized."
    }
   ],
