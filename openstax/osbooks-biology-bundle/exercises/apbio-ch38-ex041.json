 "questions": [
  {
   "id": 532034,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how the increase in human population and resource use causes increased extinction rates by altering ecosystems.",
   "answers": [
    {
     "id": 1040932,
     "content_html": "Human population growth leads to unsustainable resource use, habitat destruction, and the unsustainable fishing and hunting of wild animal populations. All these incidences results in a slow evolutionary rate of formation of new species."
    },
    {
     "id": 1040933,
     "content_html": "Human population growth leads to unsustainable resource use, habitat destruction, and the unsustainable fishing and hunting of wild animal populations. Climate change also occurs due to excessive use of fossil fuels."
    },
    {
     "id": 1040934,
     "content_html": "Human population growth leads to unsustainable resource use, habitat destruction, and unsustainable fishing and hunting of wild animal populations. Excessive use of fossil fuels is leading to reduced populations of fish species."
    },
    {
     "id": 1040935,
     "content_html": "Human population growth leads to unsustainable resource use, habitat destruction, and unsustainable fishing and hunting of wild animal populations. Larger human populations are also leading to decreased value of products obtained from species."
    }
   ],
