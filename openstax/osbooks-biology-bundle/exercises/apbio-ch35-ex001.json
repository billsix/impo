 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp144624304\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-idp221826272\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/b12ad7997750136db3c859af70561c4f99568c38\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idp245465824\">Climate change can alter where organisms live, which can sometimes directly affect human health. Watch the PBS video <a href=\"https://openstaxcollege.org/l/climate_health\" target=\"_blank\" rel=\"noopener nofollow\">“Feeling the Effects of Climate Change”</a> in which researchers discover a pathogenic organism living far outside of its normal range.</p>\n</div>\n</div>\n",
 "stimulus_html": "",
 "questions": [
  {
   "id": 535584,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The fungus <i>Cryptococcus gattii </i>has been known to cause a fatal illness. This fungus originally found in the tropics is now growing in parts of North America. What have scientists found out about this fungus?",
   "answers": [
    {
     "id": 1048632,
     "content_html": "The fungus was inadvertently introduced in North America by travelers"
    },
    {
     "id": 1048633,
     "content_html": "This fungus acquired pathogenic characteristics over time."
    },
    {
     "id": 1048634,
     "content_html": "The disease was caused by contact with infected people"
    },
    {
     "id": 1048635,
     "content_html": "The fungus started growing more in colder climates as temperatures have risen due to global warming."
    }
   ],
