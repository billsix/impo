 "questions": [
  {
   "id": 504119,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "On average, prokaryotic cells are smaller than eukaryotic cells. What are some advantages to small cell size? What are some advantages to large cell size?",
   "answers": [
    {
     "id": 991123,
     "content_html": "Small, prokaryotic cells do not expend energy in intracellular transport of substances. Larger eukaryotic cells have organelles, which enable them to produce complex substances."
    },
    {
     "id": 991124,
     "content_html": "Small, prokaryotic cells easily escape the spontaneous changes in environmental conditions. Large, eukaryotic cells have complex mechanisms to cope with such changes."
    },
    {
     "id": 991125,
     "content_html": "Small, prokaryotic cells divide at a higher rate. Large, eukaryotic cells show division with genetic variations."
    },
    {
     "id": 991126,
     "content_html": "Small, prokaryotic cells have fewer phospholipids in their membrane. Large, eukaryotic cells have more transport proteins in their phospholipid bilayer, supporting efficient transport of molecules."
    }
   ],
