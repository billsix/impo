 "questions": [
  {
   "id": 546482,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Predict how ecosystems in the northernmost land regions will be affected by human population change in the next 50 years.",
   "answers": [
    {
     "id": 1071096,
     "content_html": "Biodiversity of these northernmost regions will remain constant as humans will find other more habitable locations to house their growing numbers."
    },
    {
     "id": 1071097,
     "content_html": "The populations of organisms presently inhabiting these regions will shift as global warming causes many species to decline and new species to move in."
    },
    {
     "id": 1071098,
     "content_html": "The carrying capacity of these regions for humans will decrease as the human population increases exponentially."
    },
    {
     "id": 1071099,
     "content_html": "Ecosystems can be expected to remain untouched by humans as new technologies are developed to sustain a growing population."
    }
   ],
