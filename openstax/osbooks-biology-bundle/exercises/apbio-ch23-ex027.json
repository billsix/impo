 "questions": [
  {
   "id": 519784,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "While examining the stump of a recently cut tree, you count four thick rings alternating with four rings that are much narrower and appear denser. From this observation, you should conclude that the tree is <strong>__</strong>.",
   "answers": [
    {
     "id": 1014659,
     "content_html": "two years old, because each ring corresponds to a season"
    },
    {
     "id": 1014660,
     "content_html": "three years old, because the first ring you observe is the primary xylem"
    },
    {
     "id": 1014661,
     "content_html": "four years old, because secondary xylem grows only in the spring and fall of each year"
    },
    {
     "id": 1014662,
     "content_html": "eight years old, because there are eight rings in all"
    }
   ],
