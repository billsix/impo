   "id": 503330,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens when a chemical is reduced during a reaction?",
   "answers": [
    {
     "id": 989303,
     "content_html": "The compound is reduced to a simpler form."
    },
    {
     "id": 989304,
     "content_html": "An electron is added to the chemical."
    },
    {
     "id": 989305,
     "content_html": "A hydrogen atom is removed from the substrate."
    },
    {
     "id": 989306,
     "content_html": "It acts as part of a catabolic reaction."
    }
   ],
