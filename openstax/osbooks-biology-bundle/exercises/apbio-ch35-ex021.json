   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Plants living in deserts have adaptations such as hair on leaves and a thick cuticle. What purpose do these adaptations serve?",
   "answers": [
    {
     "id": 1047964,
     "content_html": "to conserve water"
    },
    {
     "id": 1047965,
     "content_html": "to prevent exposure to sunlight"
    },
    {
     "id": 1047966,
     "content_html": "to increase oxygen intake"
    },
    {
     "id": 1047967,
     "content_html": "to decrease carbon dioxide intake"
    }
   ],
