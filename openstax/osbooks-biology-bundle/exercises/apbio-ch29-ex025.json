 "questions": [
  {
   "id": 546863,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An individual suffers from osteogenesis imperfecta, a genetic disorder most commonly resulting from defects in collagen production and processing. Determine from the options below which types of issues related to bone development and repair you would expect to be associated with such a disorder.",
   "answers": [
    {
     "id": 1072575,
     "content_html": "Bones are abnormally weak, brittle, and highly flexible. In severe cases, individuals may have abnormal bone formation as manifested by thicker and longer bones, resulting in a taller stature."
    },
    {
     "id": 1072576,
     "content_html": "Bones are abnormally weak and prone to breakage and fracturing upon mild trauma. In severe cases, individuals may have abnormal bone formation as manifested by thicker and longer bones, resulting in a taller stature."
    },
    {
     "id": 1072577,
     "content_html": "Bones are abnormally weak and highly flexible. In severe cases, individuals may have abnormal bone formation as manifested by thinner and/or shorter bones, perhaps resulting in a shorter stature."
    },
    {
     "id": 1072578,
     "content_html": "Bones are abnormally weak and prone to breakage and fracturing upon mild trauma. In severe cases, individuals may have abnormal bone formation as manifested by thinner and/or shorter bones, perhaps resulting in a shorter stature."
    }
   ],
