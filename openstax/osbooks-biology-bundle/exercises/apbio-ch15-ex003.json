   "id": 233176,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The DNA of virus A is inserted into the protein coat of virus B. The combination virus is used to infect <em>E. coli</em>. The virus particles produced by the infection are analyzed for DNA and protein contents. What results would you expect?",
   "answers": [
    {
     "id": 722849,
     "content_html": "DNA and protein from B"
    },
    {
     "id": 722850,
     "content_html": "DNA and protein from A"
    },
    {
     "id": 722848,
     "content_html": "DNA from A and protein from B"
    },
    {
     "id": 722847,
     "content_html": "DNA from B and protein from A"
    }
