 "questions": [
  {
   "id": 547331,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Construct a statement to describe the type of signal used by birds to communicate the presence of a predator to other birds.",
   "answers": [
    {
     "id": 1074211,
     "content_html": "Birds release chemical compounds into the air that other birds rapidly recognize as signals of the presence of a predator."
    },
    {
     "id": 1074212,
     "content_html": "Birds flash visual signals such as wing flapping to communicate warnings to other birds whenever a predator is present."
    },
    {
     "id": 1074213,
     "content_html": "Birds physically touch other birds using tactile signals when they observe a predator entering their location."
    },
    {
     "id": 1074214,
     "content_html": "Birds make aural signals such as calls that other birds can hear and learn about a predator that has been observed in the area."
    }
   ],
