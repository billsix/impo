 "questions": [
  {
   "id": 241157,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare the lytic and lysogenic reproductive cycles of viruses. Provide reasoning to make a case for which cycle has the potential to produce the most virions.",
   "answers": [
    {
     "id": 754092,
     "content_html": "The lytic cycle can theoretically produce more virions, as the viral genome is incorporated into the host cell’s genome replicating along with the host cell."
    },
    {
     "id": 754091,
     "content_html": "The lysogenic cycle can theoretically produce more virions, as the reproductive cycle of viruses undergoing lysogeny is much faster than the reproductive cycle of viruses following the lytic cycle."
    },
    {
     "id": 754093,
     "content_html": "The lysogenic cycle can theoretically produce more virions, as the viral genome is incorporated into the host cell’s genome and is replicated along with the host cell."
    },
    {
     "id": 754090,
     "content_html": "The lytic cycle can theoretically produce more virions, as the prophage following the lysogenic cycle ultimately gets excised from the host cell’s genome and enters the lytic cycle."
    }
   ],
