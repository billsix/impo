 "questions": [
  {
   "id": 242666,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Prairie dogs are considered a keystone species in the western U.S. because of their extensive burrowing activities and their role as a prey animal. Explain why these characteristics would result in the keystone role of prairie dogs in their ecosystem.",
   "answers": [
    {
     "id": 760123,
     "content_html": "Prairie dogs provide protection and shelter for small animals and harm predator animals in the ecosystem."
    },
    {
     "id": 760126,
     "content_html": "Without the prairie dogs, the ecosystem might collapse due to lack of protection and shelter for small animals and lack of prey to sustain large predator animals."
    },
    {
     "id": 760124,
     "content_html": "Prairie dogs dig underground burrows, reducing aeration in the soil and preventing excessive growth of plants above ground."
    },
    {
     "id": 760125,
     "content_html": "The burrows prairie dogs dig underground provide shelter for other species of animals as well as protection from predators, but prevent growth of plants above ground."
    }
   ],
