   "id": 529715,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Fish and birds have closed circulation. They both have a systemic circulatory system, which delivers blood from the heart and out to the organs of the body. Birds differ from fish in that they have a circuit that leads through the lungs and back to the heart. What is this called?",
   "answers": [
    {
     "id": 1036796,
     "content_html": "pulmonary circulatory circuit"
    },
    {
     "id": 1036797,
     "content_html": "gill circulatory circuit"
    },
    {
     "id": 1036798,
     "content_html": "pulmocutaneous circulatory circuit"
    },
    {
     "id": 1036799,
     "content_html": "lymph circulatory circuit"
    }
   ],
