 "questions": [
  {
   "id": 502972,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is it impossible for humans to digest food that contains cellulose?",
   "answers": [
    {
     "id": 988057,
     "content_html": "There is no energy available in fiber."
    },
    {
     "id": 988058,
     "content_html": "An inactive form of cellulase in human digestive tract renders it undigested and removes it as waste."
    },
    {
     "id": 988059,
     "content_html": "The acidic environment in the human stomach makes it impossible to break the bonds in cellulose."
    },
    {
     "id": 988060,
     "content_html": "Human digestive enzymes cannot break down the <span data-math=\"\\unicode[Arial]{x3B2}\">\\unicode[Arial]{x3B2}</span>-1,4 glycosidic linkage in cellulose, which requires a special enzyme that is absent in humans."
    }
   ],
