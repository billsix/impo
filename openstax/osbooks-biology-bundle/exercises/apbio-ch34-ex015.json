 "questions": [
  {
   "id": 517023,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In sexual reproduction, two cells of a species combine to form another cell. Why is this useful?",
   "answers": [
    {
     "id": 1011166,
     "content_html": "It produces new combination of genes, which enables offspring to survive during environmental changes."
    },
    {
     "id": 1011167,
     "content_html": "It results in the production of many offspring in a short period of time."
    },
    {
     "id": 1011168,
     "content_html": "It does not involve gamete formation and requires less energy."
    },
    {
     "id": 1011169,
     "content_html": "It allows immobile organisms to reproduce in the absence of a mate."
    }
   ],
