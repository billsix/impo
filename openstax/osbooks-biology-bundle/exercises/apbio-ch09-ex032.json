 "questions": [
  {
   "id": 503524,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Thyroid hormone is a lipid-soluble signal molecule that crosses the membrane of all cells. Why would a cell fail to respond to the thyroid hormone?",
   "answers": [
    {
     "id": 990079,
     "content_html": "The MAPK cascade leading to cell activation is defective in the target cells."
    },
    {
     "id": 990080,
     "content_html": "The DNA sequence it binds to underwent a mutation."
    },
    {
     "id": 990081,
     "content_html": "There is no intracellular receptor for thyroid hormone in the cell."
    },
    {
     "id": 990082,
     "content_html": "The second messenger does not recognize the signal from the receptor."
    }
   ],
