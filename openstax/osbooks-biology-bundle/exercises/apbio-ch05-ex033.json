 "questions": [
  {
   "id": 324300,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement that describes processes of receptor-mediated endocytosis, exocytosis, and the changes in the membrane organization involved with each?",
   "answers": [
    {
     "id": 835817,
     "content_html": "Receptor-mediated endocytosis involves the binding of a ligand to its receptor, resulting in the formation of a clathrin-coated vesicle that enters the cell. In exocytosis, waste material is enveloped in a vesicle that fuses with the interior of the plasma membrane via attachment proteins."
    },
    {
     "id": 835818,
     "content_html": "In receptor-mediated endocytosis, waste material is enveloped in a membrane that fuses with the interior of the plasma membrane via attachment proteins. Exocytosis involves the opsonization of the receptor and its ligand in a clathrin-coated vesicles."
    },
    {
     "id": 835819,
     "content_html": "In receptor-mediated endocytosis, waste material is enveloped in a membrane that fuses with the interior of the plasma membrane via attachment proteins. Exocytosis involves the opsonization of the receptor and its ligand in caveolae-coated vesicles."
    },
    {
     "id": 835820,
     "content_html": "Receptor-mediated endocytosis involves the opsonization of the receptor and its ligand in clathrin-coated vesicles. In exocytosis, waste material is enveloped in a membrane that fuses with the exterior of the plasma membrane via attachment proteins."
    }
   ],
