 "questions": [
  {
   "id": 529711,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements best defines the open circulatory system?",
   "answers": [
    {
     "id": 1036780,
     "content_html": "In an open circulatory system, blood mixes with interstitial fluid in the hemocoel."
    },
    {
     "id": 1036781,
     "content_html": "In an open circulatory system, the blood is separated from the bodily interstitial fluid and contained in blood vessels."
    },
    {
     "id": 1036782,
     "content_html": "Blood circulates unidirectionally from the heart around a systemic circulatory root."
    },
    {
     "id": 1036783,
     "content_html": "An open circulatory system uses more energy than a closed circulatory system."
    }
   ],
