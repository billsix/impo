 "questions": [
  {
   "id": 503103,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following comparisons or contrasts between endergonic and exergonic reactions is false?",
   "answers": [
    {
     "id": 988543,
     "content_html": "All endergonic and exergonic reactions require the same amount of energy to overcome an activation barrier."
    },
    {
     "id": 988544,
     "content_html": "Endergonic reactions have a positive <span data-math=\"\\Delta G\">\\Delta G</span> and exergonic reactions have a negative <span data-math=\"\\Delta G\">\\Delta G</span>."
    },
    {
     "id": 988545,
     "content_html": "Endergonic reactions consume energy and exergonic reactions release energy."
    },
    {
     "id": 988546,
     "content_html": "Endergonic reactions are not spontaneous and exergonic reactions are spontaneous."
    }
   ],
