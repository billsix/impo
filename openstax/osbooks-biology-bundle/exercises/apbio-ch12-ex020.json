 "questions": [
  {
   "id": 639700,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Use your understanding of the type of inheritance associated with color blindness to provide and justify an answer to the following question: Can a human male be a carrier of red-green color blindness?",
   "answers": [
    {
     "id": 1246332,
     "content_html": "Yes, males can be the carriers of red-green color blindness, as color blindness is autosomal dominant."
    },
    {
     "id": 1246333,
     "content_html": "No, males cannot be the carriers of red-green color blindness, as color blindness is X-linked."
    },
    {
     "id": 1246331,
     "content_html": "No, males cannot be the carriers of red-green color blindness, as color blindness is Y-linked."
    },
    {
     "id": 1246330,
     "content_html": "Yes, males can be the carriers of red-green color blindness, as color blindness is autosomal recessive."
    }
   ],
