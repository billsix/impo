 "questions": [
  {
   "id": 535672,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why there are more Merkel’s disks and Meissner’s corpuscles in your fingertips than in your palms.",
   "answers": [
    {
     "id": 1048982,
     "content_html": "These two types of thermoreceptors are used to detect warmth and cold which is necessary to maintain body temperature."
    },
    {
     "id": 1048983,
     "content_html": "These two types of mechanoreceptors are used to detect fine details necessary for many roles of fingertips but not palms such as typing."
    },
    {
     "id": 1048984,
     "content_html": "These two types of proprioceptors are used to detect fine details necessary for many roles of fingertips but not palms, such as typing."
    },
    {
     "id": 1048985,
     "content_html": "These two types of mechanoreceptors are used to detect fine details, which are necessary for many roles of fingertips as well as palms."
    }
   ],
