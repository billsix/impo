 "questions": [
  {
   "id": 520989,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/d4e786895408291a.jpg\" alt=\"\">\n(credit: modification of work by Matthew Hemphill, Borna Dabiri, and Sylvain Gabriele/Eurekalert)\n</figure>",
   "stem_html": "<p>This image shows two neurons. The neuron on the left is healthy. The neuron on the right is damaged and has retracted its arms.</p>\n<p>What is a likely result of the damage shown here?</p>",
   "answers": [
    {
     "id": 1018281,
     "content_html": "The damaged neuron would not be able to receive input properly."
    },
    {
     "id": 1018282,
     "content_html": "The damaged neuron would not be able to synthesize proteins."
    },
    {
     "id": 1018283,
     "content_html": "The damaged neuron would not be able to grow in size."
    },
    {
     "id": 1018284,
     "content_html": "The damaged neuron would not be able to carry nerve signals."
    }
   ],
