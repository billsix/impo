 "questions": [
  {
   "id": 233064,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can Chargaff’s rules be used to identify different species?",
   "answers": [
    {
     "id": 722402,
     "content_html": "The base pairs are not found in equal ratios. The ratios vary between species, but do not vary by any significant amount among different individuals of the same species."
    },
    {
     "id": 722401,
     "content_html": "The amount of adenine is equal to the amount of thymine. The amount of cytosine varies between species, but does not vary by any significant amount among different individuals of the same species."
    },
    {
     "id": 722400,
     "content_html": "The base pairs are found in equal quantities. Different species have different molecular weight of DNA."
    },
    {
     "id": 722399,
     "content_html": "the amount of guanine is equal to the amount of thymine. The amount of cytosine varies between species, but does not vary by any significant amount among different individuals of the same species."
    }
   ],
