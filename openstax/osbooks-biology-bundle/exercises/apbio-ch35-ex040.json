 "questions": [
  {
   "id": 535620,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Deserts and subtropical deserts experience low precipitation and extremes in temperature. For a plant to survive and reproduce, what adaptations should it have? Why?",
   "answers": [
    {
     "id": 1048776,
     "content_html": "To survive, they need prop roots, reduced foliage and fleshy leaves with sunken stomata to reduce transpiration. Also, they should have seeds that can remain dormant over long periods."
    },
    {
     "id": 1048777,
     "content_html": "To survive, they need deep roots, reduced foliage and fleshy leaves with sunken stomata to reduce transpiration. Also, they should have seeds that can remain dormant over long periods."
    },
    {
     "id": 1048778,
     "content_html": "To survive, they need deep roots, reduced foliage and fleshy leaves with sunken stomata to reduce transpiration. Also, these plants need to grow in clumps."
    },
    {
     "id": 1048779,
     "content_html": "To survive, they need deep roots, increased foliage, and fleshy leaves with sunken stomata to reduce transpiration. Also, the plants need seeds that can remain dormant over long periods."
    }
   ],
