 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1568451\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-id2004550\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/7f5ab2d95bc1cd3fa7ce37dcd253a7c4afbfd17c\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"130\" height=\"130\">\n</span>\n<p id=\"fs-id1469809\">Visit this <a href=\"https://openstaxcollege.org/l/simple_pendulum\" target=\"_blank\" rel=\"noopener nofollow\">site</a> and select “A simple pendulum” on the menu (under “Harmonic Motion”) to see the shifting kinetic (K) and potential energy (U) of a pendulum in motion.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 503097,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Apply the relationship between potential and kinetic energy as depicted in the pendulum model to predict changes in energy that occur as a child swings on a swing set.",
   "answers": [
    {
     "id": 988519,
     "content_html": "Kinetic energy increases when the child swings downward; potential energy increases when the child swings upward."
    },
    {
     "id": 988520,
     "content_html": "Kinetic energy decreases when the child swings downward; potential energy decreases when the child swings upward."
    },
    {
     "id": 988521,
     "content_html": "Kinetic energy increases when the child swings upward; potential energy increases when the child swings downward."
    },
    {
     "id": 988522,
     "content_html": "Kinetic energy increases when the child swings downward; potential energy increases when the child swings downward."
    }
