 "questions": [
  {
   "id": 507851,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would be the outcome of blocking the S phase of interphase?",
   "answers": [
    {
     "id": 995092,
     "content_html": "The cell would enter karyokinesis."
    },
    {
     "id": 995093,
     "content_html": "DNA replication would not occur."
    },
    {
     "id": 995094,
     "content_html": "Centrosomes would be duplicated."
    },
    {
     "id": 995095,
     "content_html": "The cytoskeleton would be dismantled."
    }
   ],
