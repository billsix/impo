 "questions": [
  {
   "id": 520165,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A Venus fly trap has a very low sensitivity threshold, yet it can tell the difference between the light touch of an insect and a drop of rainwater or wind. Make a claim proposing a mechanism for how the Venus fly trap can differentiate between a random stimulus and an actual prey.",
   "answers": [
    {
     "id": 1016147,
     "content_html": "Hair-like appendages on the surface of the leaves respond to repeated contact."
    },
    {
     "id": 1016148,
     "content_html": "Hair-like appendages on the surface of the leaves respond to a single contact."
    },
    {
     "id": 1016149,
     "content_html": "Hair-like appendages on the surface of the leaves respond to chemical stimulus from the insect."
    },
    {
     "id": 1016150,
     "content_html": "Hair-like appendages on the surface of the leaves respond to electrical stimulus from the insect."
    }
   ],
