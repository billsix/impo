   "id": 517125,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What occurs as a result of fertilization of an egg and sperm?",
   "answers": [
    {
     "id": 1011382,
     "content_html": "Fertilization restores diploidy."
    },
    {
     "id": 1011383,
     "content_html": "Fertilization always results in a viable embryo."
    },
    {
     "id": 1011384,
     "content_html": "Fertilization merges two diploid cells into a haploid cell."
    },
    {
     "id": 1011385,
     "content_html": "Fertilization precedes ovulation."
    }
   ],
