 "questions": [
  {
   "id": 507857,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In prophase I, the homologous chromosomes are paired up and linked together. Which explanation best describes the structures and mechanisms responsible for this action?",
   "answers": [
    {
     "id": 995116,
     "content_html": "The synaptonemal complex is a protein lattice that binds chromosomes together across their length and maintains their tight alignment."
    },
    {
     "id": 995117,
     "content_html": "Tetrads act as a sort of \"glue\" that prevents the chromosomes from separating along their length and maintains chromosome alignment."
    },
    {
     "id": 995118,
     "content_html": "The centromere consists of cohesin proteins that bind paired chromosomes at their tips."
    },
    {
     "id": 995119,
     "content_html": "Cohesin proteins make up the synaptonemal complex that binds chromosomes together at their centromeres."
    }
   ],
