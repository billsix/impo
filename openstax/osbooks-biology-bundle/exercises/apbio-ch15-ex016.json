   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If the <span data-math=\"\\rho\">\\rho</span> protein is missing, will a prokaryotic gene be terminated?",
   "answers": [
    {
     "id": 997248,
     "content_html": "It depends on the gene."
    },
    {
     "id": 997249,
     "content_html": "No, the rho protein is essential."
    },
    {
     "id": 997250,
     "content_html": "Transcription termination is not required."
    },
    {
     "id": 997251,
     "content_html": "Yes, the rho protein is not involved in transcription."
    }
