  {
   "id": 242620,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Predict and explain the effects of human population on biodiversity many years in the future.",
   "answers": [
    {
     "id": 759942,
     "content_html": "Biodiversity will decline as human population increases because of habitat loss, increased pollution, and climate change."
    },
    {
     "id": 759941,
     "content_html": "Biodiversity will decline as human population increases because of enhanced food supplies, medical advances, and development of renewable energy sources."
    },
    {
     "id": 759940,
     "content_html": "Biodiversity will increase as human population increases because of habitat loss, increased pollution, and climate change."
    },
    {
     "id": 759939,
     "content_html": "Biodiversity will increase as human population increases because of enhanced food supplies, medical advances, and development of renewable energy sources."
    }
