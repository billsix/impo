 "questions": [
  {
   "id": 233452,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/9c5ab810a70fae60.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Kelly A. Frazer, et al./Genome Research, Cold Spring Harbor Laboratory Press)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image compares the genes on human chromosome 7 with genes found on the mouse genome.</p>\n<p>What is a conclusion we can draw from this comparison?</p>",
   "answers": [
    {
     "id": 723953,
     "content_html": "All the genes in human chromosome 7 can be found in the mouse genome."
    },
    {
     "id": 723954,
     "content_html": "Humans and mice share some genes."
    },
    {
     "id": 723952,
     "content_html": "Human chromosome 7 and mouse chromosome 7 are homologous."
    },
    {
     "id": 723951,
     "content_html": "The human genome is larger than the mouse genome."
    }
   ],
