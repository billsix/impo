 "questions": [
  {
   "id": 242793,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/459921e7defd24c9.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Bert Tolkamp, et al./SAC)</figcaption>\n</figure>\n",
   "stem_html": "<p>The table shows feed conversion ratios (FCR) for different farm animals. FCR is calculated by dividing the amount of feed given to the animal by the animal's edible weight. \"Broiler\" chickens are chicken raised for their meat.</p>\n<p>Make a claim based on this data.</p>",
   "answers": [
    {
     "id": 760633,
     "content_html": "Sheep are more efficient than cows in meat production."
    },
    {
     "id": 760632,
     "content_html": "Geese and broiler chickens have the same efficiency."
    },
    {
     "id": 760634,
     "content_html": "Ducks are marginally more efficient than turkeys."
    },
    {
     "id": 760631,
     "content_html": "Beef is the most efficient animal to raise for meat."
    }
   ],
