   "id": 517842,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which is the following would be supported by Lamarck's theory?",
   "answers": [
    {
     "id": 1012346,
     "content_html": "Natural selection leads to changes in organisms over time."
    },
    {
     "id": 1012347,
     "content_html": "The strong arms of a gorilla are the result of is parents constantly climbing, lifting, and fighting."
    },
    {
     "id": 1012348,
     "content_html": "Lack of resources led to the death of three of four fox cubs."
    },
    {
     "id": 1012349,
     "content_html": "The founder effect is when a few individuals in a population are separated from the original population."
    }
