 "questions": [
  {
   "id": 334553,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare and contrast the roles of DNA polymerase I and DNA ligase in DNA replication.",
   "answers": [
    {
     "id": 843850,
     "content_html": "DNA polymerase I removes the RNA primers from the developing copy of DNA. DNA ligase seals the ends of the new segment, especially the Okazaki fragments."
    },
    {
     "id": 843847,
     "content_html": "DNA polymerase I adds the RNA primers to the already developing copy of DNA. DNA ligase separates the ends of the new segment, especially the Okazaki fragments."
    },
    {
     "id": 843848,
     "content_html": "DNA polymerase I seals the ends of the new segment, especially the Okazaki fragments. DNA ligase removes the RNA primers from the developing copy of DNA."
    },
    {
     "id": 843849,
     "content_html": "DNA polymerase I removes the enzyme primase from the developing copy of DNA. DNA ligase seals the ends of the old segment, especially the Okazaki fragments."
    }
   ],
