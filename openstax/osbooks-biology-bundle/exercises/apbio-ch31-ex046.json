 "questions": [
  {
   "id": 534734,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/aaacf6a1810d2c82.jpg\" alt=\"Illustration of human heart with features of internal anatomy labeled counterclockwise starting from the top left: pulmonary artery, superior vena cava, right atrium, pulmonary valve (semilunar), tricuspid valve (atrioventricular), right ventricle, inferior vena cava, aorta, pulmonary artery, left atrium, aortic valve (semilunar), mitral valve (atrioventricular), left ventricle\"></p>\n\n<p>The diagram shows the internal anatomy of the heart. How would blood circulation beyond the heart be affected if the pulmonary valve could not open?</p>\n",
   "answers": [
    {
     "id": 1045746,
     "content_html": "Blood could not reach the rest of the body."
    },
    {
     "id": 1045747,
     "content_html": "Blood could not reach the lungs."
    },
    {
     "id": 1045748,
     "content_html": "Blood could not return from the lungs."
    },
    {
     "id": 1045749,
     "content_html": "Blood could not return from the rest of the body."
    }
   ],
