 "questions": [
  {
   "id": 521051,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are the roles of vasodilation and vasoconstriction in maintaining body temperature?",
   "answers": [
    {
     "id": 1018513,
     "content_html": "Vasodilation allows for radiation and evaporative heat loss, and vasoconstriction brings blood to the core to conserve heat by vital organs."
    },
    {
     "id": 1018514,
     "content_html": "Vasodilation brings blood to the core to conserve heat by vital organs, and vasoconstriction results in radiation and evaporative heat loss."
    },
    {
     "id": 1018515,
     "content_html": "Vasodilation results in the formation of an insulating layer between skin and internal organs causing heat conservation and brings blood to the core to conserve heat."
    },
    {
     "id": 1018516,
     "content_html": "Vasodilation results in radiation and evaporative heat loss, and vasoconstriction transfers heat from arteries to veins to warm blood returning to the heart."
    }
   ],
