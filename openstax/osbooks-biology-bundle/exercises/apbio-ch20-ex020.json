 "questions": [
  {
   "id": 530206,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "James Lake of the UCLA/NASA Astrobiology Institute presented new evidence regarding the evolution of eukaryotic cells. He hypothesized that eukaryotes developed from an endosymbiotic gene fusion between the two other domains of life. Evaluate from the options provided which kind of genetic evidence would best support this hypothesis.",
   "answers": [
    {
     "id": 1037312,
     "content_html": "The mitochondrial DNA of the two other domains resembles that of other eukaryotes."
    },
    {
     "id": 1037313,
     "content_html": "The chloroplasts of eukaryotes contain a double cell layer."
    },
    {
     "id": 1037314,
     "content_html": "All eukaryotic genes are identical to either Archaea or Bacteria."
    },
    {
     "id": 1037315,
     "content_html": "Some eukaryotic genes resemble those of Archaea,  some resemble those of Bacteria, and some are unlike the genes of either domain."
    }
   ],
