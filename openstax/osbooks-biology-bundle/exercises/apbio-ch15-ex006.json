 "questions": [
  {
   "id": 233179,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If mRNA is complementary to the DNA template strand and the DNA template stand is complementary to the DNA non-template strand, why are base sequences of mRNA and the DNA non-template strand not identical? Could they ever be?",
   "answers": [
    {
     "id": 722862,
     "content_html": "No, they cannot be identical because the T nucleotide in DNA is replaced with U nucleotide in RNA and AUG is the start codon."
    },
    {
     "id": 722859,
     "content_html": "No, they cannot be identical because the T nucleotide in RNA is replaced with U nucleotide in DNA."
    },
    {
     "id": 722860,
     "content_html": "They can be identical if methylation of the U nucleotide in RNA occurs and gives T nucleotide."
    },
    {
     "id": 722861,
     "content_html": "They can be identical if de-methylation of the U nucleotide in RNA occurs and gives T nucleotide."
    }
   ],
