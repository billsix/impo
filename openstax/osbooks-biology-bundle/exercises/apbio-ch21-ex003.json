   "id": 534929,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In the late 1930s, scientists got their first good view of viruses. How did this happen?",
   "answers": [
    {
     "id": 1046541,
     "content_html": "The development of the light microscope helped scientists discover many viruses of all types of living organisms."
    },
    {
     "id": 1046542,
     "content_html": "The development of the viral receptor helped scientists discover many viruses of all types of living organisms."
    },
    {
     "id": 1046543,
     "content_html": "The development of the porcelain filter helped scientists discover many viruses of all types of living organisms."
    },
    {
     "id": 1046544,
     "content_html": "The development of the electron microscope helped scientists discover many viruses of all types of living organisms."
    }
