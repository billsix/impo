 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm36204976\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-idm152353712\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/4a8dd90c4276b768f6116d6ad9fd768849cc7552\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idp109090224\">Visit <a href=\"https://openstaxcollege.org/l/nanoscopy\" target=\"_blank\" rel=\"noopener nofollow\">this interactive site</a> to see an entire animal (a zebrafish embryo) at the cellular and sub-cellular level. Use the zoom and navigation functions for a virtual nanoscopy exploration.</p>\n</div>\n</div>",
