 "questions": [
  {
   "id": 504111,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If a peripheral membrane protein were synthesized inside the lumen of the ER, would it end up on the inside or outside of the plasma membrane?",
   "answers": [
    {
     "id": 991099,
     "content_html": "The vesicle travels from the endoplasmic reticulum to get embedded in plasma membrane."
    },
    {
     "id": 991100,
     "content_html": "The vesicle travels from the Golgi to the plasma membrane to release the protein outside."
    },
    {
     "id": 991101,
     "content_html": "The vesicle travels from the endoplasmic reticulum to the plasma membrane, and returns to the Golgi apparatus to get modified."
    },
    {
     "id": 991102,
     "content_html": "The vesicle moves from the endoplasmic reticulum into the cytoplasmic area, remaining there."
    }
   ],
