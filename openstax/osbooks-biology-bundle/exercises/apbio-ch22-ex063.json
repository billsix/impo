 "questions": [
  {
   "id": 639902,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/6a3e249c8c61887f.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Riju Agrawal/Foreign Policy)</figcaption>\n</figure>",
   "stem_html": "<p>This graph shows the antibiotic resistance to penicillin in different countries. The x-axis shows the use of penicillin for treating outpatients (patients who are treated and sent home; patients who are not hospitalized).</p>\n<p>Make a claim about penicillin resistance based on this graph.</p>",
   "answers": [
    {
     "id": 1247126,
     "content_html": "Penicillin resistance is not related to its use in treating outpatients."
    },
    {
     "id": 1247127,
     "content_html": "Penillicin resistance increases in countries which use it to treat outpatients."
    },
    {
     "id": 1247125,
     "content_html": "Penillicin resistance decreases in countries which use it to treat outpatients."
    },
    {
     "id": 1247124,
     "content_html": "Penicillin resistance may increase or decrease in countries which use it to treat outpatients, based on other factors."
    }
   ],
