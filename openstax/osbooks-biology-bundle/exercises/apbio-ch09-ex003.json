 "questions": [
  {
   "id": 503482,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following properties prevents the ligands of cell-surface receptors from entering the cell?",
   "answers": [
    {
     "id": 989911,
     "content_html": "The molecules bind to the extracellular domain."
    },
    {
     "id": 989912,
     "content_html": "The molecules are hydrophilic and cannot penetrate the hydrophobic interior of the plasma membrane."
    },
    {
     "id": 989913,
     "content_html": "The molecules are attached to transport proteins that deliver them through the bloodstream to target cells."
    },
    {
     "id": 989914,
     "content_html": "The ligands are able to penetrate the membrane, directly influencing gene expression upon receptor binding."
    }
   ],
