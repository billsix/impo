 "questions": [
  {
   "id": 504411,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/05ac65302b5abbcf.jpg\" alt=\"The illustration shows a Drosophila genetic map. The gene for aristae length occurs at 0 centimorgans, or cM. The gene for body color occurs at 48.5 cM. The gene for red versus cinnabar eye color occurs at 57.5 cM. The gene for wing length occurs at 65.5 cM, and the gene for red versus brown eye color occurs at 104.5 cM. One cM is equivalent to a recombination frequency of 0.01.\"></p>\n\n<p>Based on the diagram, which of the following statements is true?</p>\n",
   "answers": [
    {
     "id": 992233,
     "content_html": "Recombination of the body color and red/cinnabar eye alleles will occur more frequently than recombination of the alleles for wing length and aristae length."
    },
    {
     "id": 992234,
     "content_html": "Recombination of the body color and aristae length alleles will occur more frequently than recombination of red/ brown eye alleles and the aristae length alleles."
    },
    {
     "id": 992235,
     "content_html": "Recombination of the gray/black body color and long/short aristae alleles will not occur."
    },
    {
     "id": 992236,
     "content_html": "Recombination of the red/brown eye and long/short aristae alleles will occur more frequently than recombination of the alleles for wing length and body color."
    }
   ],
   "hints": [],
