  {
   "id": 517043,
   "is_answer_order_important": true,
   "stimulus_html": "<img src=\"exercises/media/e18341fa0bea067b.jpg\" alt=\"\">",
   "stem_html": "Which of the following statements about hormone regulation of the female reproductive cycle is true?",
   "answers": [
    {
     "id": 1011246,
     "content_html": "LH and FSH are produced in the ovaries, and estradiol and progesterone are produced in the pituitary."
    },
    {
     "id": 1011247,
     "content_html": "Estradiol and progesterone secreted from the corpus luteum cause the myometrium to thicken."
    },
    {
     "id": 1011248,
     "content_html": "Progesterone is produced by the corpus luteum."
    },
    {
     "id": 1011249,
     "content_html": "Secretion of GnRH by the hypothalamus is inhibited by high levels of estradiol, but stimulated by low levels of estradiol."
    }
   ],
