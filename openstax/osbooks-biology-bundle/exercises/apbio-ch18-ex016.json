 "questions": [
  {
   "id": 233447,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do scientists consider vestigial structures evidence for evolution?",
   "answers": [
    {
     "id": 723931,
     "content_html": "Vestigial structures are the result of convergent evolution, so they are good evidence that natural selection act similarly in similar environmental conditions."
    },
    {
     "id": 723934,
     "content_html": "Vestigial structures are the result of common ancestry, so they are good evidence that different populations of organisms evolved from a common point."
    },
    {
     "id": 723932,
     "content_html": "Vestigial structures are the result of convergent evolution, so they are good evidence for an end goal to evolution."
    },
    {
     "id": 723933,
     "content_html": "Vestigial structures are the result of common ancestry, so they are good evidence for a common origin of all life."
    }
   ],
