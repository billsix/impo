   "id": 495747,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/3e98cbfeb346ae39.jpg\" alt=\"\">\n<figcaption>(credit: Fisher Scientific, CC BY-SA 4.0)</figcaption>\n\n</figure>",
   "stem_html": "Western blot is a lab technique used to measure the presence of a specific protein in a sample. This is a protein ladder that is run along side the sample for comparison. The sample runs from top to bottom. What is the relationship between the green line and the red line?",
   "answers": [
    {
     "id": 978386,
     "content_html": "The red line is lighter"
    },
    {
     "id": 978387,
     "content_html": "The red line is heavier"
    },
    {
     "id": 978388,
     "content_html": "The red line has more alpha helixes"
    },
    {
     "id": 978389,
     "content_html": "The red line has more beta pleated sheets"
    }
