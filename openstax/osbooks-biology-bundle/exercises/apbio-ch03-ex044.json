  {
   "id": 495735,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do phospholipids contribute to cell membrane structure?",
   "answers": [
    {
     "id": 978339,
     "content_html": "Phospholipids orient their heads towards the polar molecules and tails in the interior of the membrane, thus forming a bilayer."
    },
    {
     "id": 978340,
     "content_html": "Phospholipids orient their tails towards the polar molecules of water solutions, and heads in the interior of the membrane, thus forming a bilayer."
    },
    {
     "id": 978341,
     "content_html": "Phospholipids orient their heads towards the non-polar molecules and tails in the interior of the membrane, forming a bilayer."
    },
    {
     "id": 978342,
     "content_html": "Phospholipids orient their tails towards the polar molecules and heads in the non-polar side of the membrane, forming a bilayer."
    }
   ],
