   "stimulus_html": "",
   "stem_html": "What is the main prerequisite for clearance at the <span data-math=\"\\text{G}_2\">\\text{G}_2</span> checkpoint?",
   "answers": [
    {
     "id": 1246225,
     "content_html": "The cell has a reached a sufficient size."
    },
    {
     "id": 1246224,
     "content_html": "The cell has an adequate stockpile of nucleotides."
    },
    {
     "id": 1246226,
     "content_html": "An accurate and complete DNA replication has occurred."
    },
    {
     "id": 1246223,
     "content_html": "Proper attachment of mitotic spindle fibers to kinetochores has occurred."
