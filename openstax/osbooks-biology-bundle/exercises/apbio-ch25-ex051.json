   "stem_html": "Which of the following statements about digestive processes is true?",
   "answers": [
    {
     "id": 1028900,
     "content_html": "Bile emulsifies lipids in the small intestine."
    },
    {
     "id": 1028901,
     "content_html": "Trypsin and lipase in the stomach digest protein."
    },
    {
     "id": 1028902,
     "content_html": "Amylase, maltase, and lactase in the mouth digest carbohydrates."
    },
    {
     "id": 1028903,
     "content_html": "Peptides are primarily absorbed in the large intestines."
    }
