 "questions": [
  {
   "id": 507878,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how the orientation of homologous chromosomes during metaphase I of meiosis contributes to greater variation in gametes.",
   "answers": [
    {
     "id": 995152,
     "content_html": "The random alignment of homologous chromosomes at the metaphase plate ensures the random destination of the chromosomes in the daughter cells."
    },
    {
     "id": 995153,
     "content_html": "Because homologous chromosomes dissociate from the spindle fibers during metaphase I, they move randomly to the daughter cells."
    },
    {
     "id": 995154,
     "content_html": "The homologous chromosomes are paired tightly during metaphase I and undergo crossover as the synaptonemal complex forms a lattice around them."
    },
    {
     "id": 995155,
     "content_html": "Recombination of maternal and paternal chromosomes occurs in metaphase I because the homologous chromosomes are not connected at their centromeres."
    }
   ],
