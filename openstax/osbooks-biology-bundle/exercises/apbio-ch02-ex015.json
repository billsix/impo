 "questions": [
  {
   "id": 503182,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "One of the risks for people with diabetes is diabetic ketoacidosis, a build-up of acid in the blood stream. Explain why this is dangerous to humans.",
   "answers": [
    {
     "id": 988859,
     "content_html": "Diabetic ketoacidosis decreases the normal pH (8.35-8.45) to a lower value."
    },
    {
     "id": 988860,
     "content_html": "Diabetic ketoacidosis increases normal pH level of blood disrupting biological processes."
    },
    {
     "id": 988861,
     "content_html": "Diabetic ketoacidosis keeps pH level of blood constant which disrupts biological processes."
    },
    {
     "id": 988862,
     "content_html": "Diabetic ketoacidosis decreases normal pH (7.35-7.45) to a lower value."
    }
   ],
