   "stimulus_html": "",
   "stem_html": "Which of the following statements about animal digestion is true?",
   "answers": [
    {
     "id": 1020584,
     "content_html": "Roughage is digested very quickly."
    },
    {
     "id": 1020585,
     "content_html": "Birds eat large quantities at one time."
    },
    {
     "id": 1020586,
     "content_html": "Birds have a four-chambered stomach."
    },
    {
     "id": 1020587,
     "content_html": "In pseudo-ruminants, roughage is digested in the cecum."
    }
