   "id": 544269,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A new antagonist molecule has been discovered that binds to and blocks plasma membrane receptors. Make a claim describing the effect this antagonist will have on testosterone, which is a steroid hormone.",
   "answers": [
    {
     "id": 1069745,
     "content_html": "This molecule will block testosterone from binding to its receptor."
    },
    {
     "id": 1069746,
     "content_html": "This molecule will block testosterone from activating cAMP signaling."
    },
    {
     "id": 1069747,
     "content_html": "This molecule will increase testosterone-mediated signaling."
    },
    {
     "id": 1069748,
     "content_html": "This molecule will not affect testosterone-mediated signaling."
    }
