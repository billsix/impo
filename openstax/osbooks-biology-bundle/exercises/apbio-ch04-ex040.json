 "questions": [
  {
   "id": 504257,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You are looking at a sample under a light microscope and observe a new type of cell. You come to the conclusion that it is a bacterium and not a eukaryotic cell. What would you observe to come to this conclusion?",
   "answers": [
    {
     "id": 991673,
     "content_html": "The cell has a cell wall."
    },
    {
     "id": 991674,
     "content_html": "The cell has a flagellum."
    },
    {
     "id": 991675,
     "content_html": "The cell does not have a nucleus."
    },
    {
     "id": 991676,
     "content_html": "The cell has a negative gram stain."
    }
   ],
