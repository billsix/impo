 "questions": [
  {
   "id": 509251,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Discuss the effects of point mutations on a DNA strand.",
   "answers": [
    {
     "id": 997144,
     "content_html": "Mutations can cause a single change in an amino acid. A nonsense mutation can stop the replication or reading of that strand. Insertion or deletion mutations can cause a frame shift. This can result in non-functional proteins."
    },
    {
     "id": 997145,
     "content_html": "Mutations can cause a single change in amino acid. A missense mutation can stop the replication or reading of that strand. Insertion or deletion mutations can cause a frame shift. This can result in non-functional proteins."
    },
    {
     "id": 997146,
     "content_html": "Mutations can cause a single change in amino acid. A nonsense mutation can stop the replication or reading of that strand. Substitution mutations can cause a frame shift. This can result in non-functional proteins."
    },
    {
     "id": 997147,
     "content_html": "Mutations can cause a single change in amino acid. A nonsense mutation can stop the replication or reading of that strand. Insertion or deletion mutations can cause a frame shift. This can result in functional proteins."
    }
