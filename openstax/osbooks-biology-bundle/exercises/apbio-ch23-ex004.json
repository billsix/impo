 "questions": [
  {
   "id": 522415,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Scientists label cells in the lateral meristem of a sapling with a dye to follow the developmental fate of the cells. After several weeks, sections are prepared from the sapling and observed under the microscope. Which tissues are most likely to be stained by the dye that was injected into the lateral meristem?",
   "answers": [
    {
     "id": 1022539,
     "content_html": "Vascular tissue to transport nutrients and water"
    },
    {
     "id": 1022540,
     "content_html": "The tip of plant to promote growth of plant"
    },
    {
     "id": 1022541,
     "content_html": "Secondary xylem to increase girth of stem"
    },
    {
     "id": 1022542,
     "content_html": "Epidermis to cover the plant"
    }
   ],
