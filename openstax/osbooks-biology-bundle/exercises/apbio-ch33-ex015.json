 "questions": [
  {
   "id": 535211,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Suppose a person was born without the ability to produce MHC I molecules. What problem would that create?",
   "answers": [
    {
     "id": 1047348,
     "content_html": "A person without the ability to produce MHC I molecules would die immediately."
    },
    {
     "id": 1047349,
     "content_html": "A person without the ability to produce MHC I molecules would recognize self as non-self, resulting in autoimmune disease."
    },
    {
     "id": 1047350,
     "content_html": "The person’s immune system would not be able to distinguish self and non-self. This would make the person very vulnerable to infection."
    },
    {
     "id": 1047351,
     "content_html": "The person’s immune system would not be able to destroy foreign pathogen due to lack of hydrolytic enzymes. This would make the person very vulnerable to infection."
    }
   ],
