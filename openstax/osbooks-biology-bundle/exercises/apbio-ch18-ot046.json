 "questions": [
  {
   "id": 334774,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe a situation where hybrid reproduction would cause two species to continue divergence.",
   "answers": [
    {
     "id": 844711,
     "content_html": "If two closely related species continue to produce hybrids, the hybrids will compete with both species, causing them to find new niches which will further their divergence"
    },
    {
     "id": 844712,
     "content_html": "If two closely related species continue to produce hybrids, they will develop reproductive barriers to prevent production of hybrids, to ensure that they remain separate species."
    },
    {
     "id": 844714,
     "content_html": "If two closely related species continue to produce hybrids that are less fit than the parent species, there would be reinforcement of divergence."
    },
    {
     "id": 844713,
     "content_html": "If two closely related species continue to produce hybrids they will always converge into a single species"
    }
   ],
