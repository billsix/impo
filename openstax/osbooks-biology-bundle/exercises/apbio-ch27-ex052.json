 "context": "<figure id=\"fig-ch36_05_06\" class=\" \">\n<span data-type=\"media\" id=\"fs-idm2994016\" data-alt=\" Graph plots normalized absorbance for rods and S, M and L cones against wavelength. For all four cell types, the trend is an approximately bell-shaped curve with a steeper decrease than increase. For S cones the peak absorbance is 420 nanometers. For rods the peak absorbance is 498 nanometers. For M cones the peak absorbance is 534 nanometers. For L cones the peak absorbance is 564 nanometers.\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/1d1433f265f77354d9440c220ac2874230e7cfa6\" data-media-type=\"image/jpg\" alt=\" Graph plots normalized absorbance for rods and S, M and L cones against wavelength. For all four cell types, the trend is an approximately bell-shaped curve with a steeper decrease than increase. For S cones the peak absorbance is 420 nanometers. For rods the peak absorbance is 498 nanometers. For M cones the peak absorbance is 534 nanometers. For L cones the peak absorbance is 564 nanometers.\" width=\"380\" height=\"238\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 544179,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>This graph shows the wavelengths of light the rods and cones of the eye can detect.</p>\n<p>What receptors are active if you are seeing a white building on a bright day?</p>",
   "answers": [
    {
     "id": 1069465,
     "content_html": "All three cones in your eyes are  stimulated when you see the color white. The rods do not play a role in color vision."
    },
    {
     "id": 1069466,
     "content_html": "The L and M cones are stimulated in your eyes when you see the color white. The rods do not play a role in color vision."
    },
    {
     "id": 1069467,
     "content_html": "The S cones and the rods are stimulated in your eyes when you see the color white."
    },
    {
     "id": 1069468,
     "content_html": "The L cones and the rods are stimulated in your eyes when you see the color white."
    }
   ],
