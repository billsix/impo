 "questions": [
  {
   "id": 535113,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In terms of evolution, why might the urea cycle have evolved in organisms?",
   "answers": [
    {
     "id": 1046962,
     "content_html": "so organisms could adapt to the changing environment when terrestrial life forms evolved"
    },
    {
     "id": 1046963,
     "content_html": "so organisms could evolve the ability to switch between direct ammonia excretion and urea"
    },
    {
     "id": 1046964,
     "content_html": "so organisms could reduce their excretion of ammonia in the form of urea"
    },
    {
     "id": 1046965,
     "content_html": "so organisms could adapt to the changing environment and excrete higher concentrations of uric acid"
    }
   ],
