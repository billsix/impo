 "questions": [
  {
   "id": 507621,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Using the yeast mating factor as an example, support the hypothesis that signaling pathways appeared early in evolution and are well-conserved. Evaluate the explanations provided to select the one that best supports the hypothesis.",
   "answers": [
    {
     "id": 994640,
     "content_html": "Signaling in yeast uses the RTK pathway and is evolutionarily conserved, like insulin signaling in humans."
    },
    {
     "id": 994641,
     "content_html": "Signaling in yeast uses G-protein coupled receptors for signaling and is evolutionarily conserved, like insulin signaling in humans."
    },
    {
     "id": 994642,
     "content_html": "Signaling in yeast uses an endocrine pathway and is evolutionarily conserved, like insulin signaling in humans."
    },
    {
     "id": 994643,
     "content_html": "Mating factor in yeast uses an autocrine signaling pathway and is evolutionarily conserved."
    }
   ],
