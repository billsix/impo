 "questions": [
  {
   "id": 640333,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are some advantages of internal compared with external fertilization?",
   "answers": [
    {
     "id": 1248831,
     "content_html": "Internal fertilization leads to more genetic variations and increases the survival rates of offsprings."
    },
    {
     "id": 1248830,
     "content_html": "Internal fertilization increases the survival rates of offspring, and large numbers of offspring are produced."
    },
    {
     "id": 1248832,
     "content_html": "Internal fertilization increases the survival rates of offspring, and the chance of fertilization with a specific partner also increases."
    },
    {
     "id": 1248829,
     "content_html": "Internal fertilization increases the survival rates of offspring and decreases the chance of fertilization with a specific partner."
    }
   ],
