 "questions": [
  {
   "id": 334644,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The lac operon consists of regulatory regions such as the promoter as well as the structural genes lacZ, lacY, and lacA, which code for proteins involved in lactose metabolism. What would be the outcome of a missense mutation in one of the structural genes of the lac operon?",
   "answers": [
    {
     "id": 844205,
     "content_html": "Mutation in structural genes will stop transcription."
    },
    {
     "id": 844206,
     "content_html": "Mutated lacY will prevent CAP from binding."
    },
    {
     "id": 844207,
     "content_html": "Mutated lacA will metabolize lactose or maltodextrin."
    },
    {
     "id": 844208,
     "content_html": "Transcription will continue but lactose will not be metabolized properly."
    }
   ],
