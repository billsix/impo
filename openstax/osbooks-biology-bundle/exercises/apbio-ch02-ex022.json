 "questions": [
  {
   "id": 503172,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Discuss how buffers help prevent drastic swings in pH.",
   "answers": [
    {
     "id": 988819,
     "content_html": "Buffers absorb excess hydrogen and hydroxide ions to prevent increases or decrease in pH. An example is the bicarbonate system in human body."
    },
    {
     "id": 988820,
     "content_html": "Buffers absorb extra hydrogen ions to prevent increases or decreases in pH. An example is the bicarbonate system in the human body."
    },
    {
     "id": 988821,
     "content_html": "Buffers absorb excess hydroxide ions to prevent increases or decreases in pH. An example of that is the bicarbonate system in the human body."
    },
    {
     "id": 988822,
     "content_html": "Buffers absorb excess hydrogen and hydroxide ions to prevent increases or decreases in pH. An example of that is carbonate system in human body."
    }
   ],
