 "questions": [
  {
   "id": 546522,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Positive water potential is applied on the left side of a tube by increasing Ψp so that the water level rises on the right side. The equation for water potential is: Ψsystem = Ψtotal = Ψs + Ψp + Ψg + Ψm where Ψs, Ψp, Ψg, and Ψm refer to the solute, pressure, gravity, and matric potentials, respectively. Could you equalize the water level on each side of the tube by adding solute?",
   "answers": [
    {
     "id": 1071256,
     "content_html": "Yes, water level can be equalized by adding solute to the right side of the tube so that water moves toward the left until the water levels are equal."
    },
    {
     "id": 1071257,
     "content_html": "No, water level cannot be equalized on both sides of the tubes by adding solutes with no other action."
    },
    {
     "id": 1071258,
     "content_html": "Yes, water level can be equalized by adding solute to the left side of the tube so that water moves toward the left until the water levels are equal."
    },
    {
     "id": 1071259,
     "content_html": "No, water level cannot be equalized by adding solutes because solutes are always pulled down by gravity, thereby not letting water equalize."
    }
   ],
