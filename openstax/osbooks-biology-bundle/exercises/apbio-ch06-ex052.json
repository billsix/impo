   "id": 344747,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is true about the energy released by the hydrolosis of ATP?",
   "answers": [
    {
     "id": 859266,
     "content_html": "It is equal to <span data-math=\"{-57}\\,\\text{kJ/mol}\">{-57}\\,\\text{kJ/mol}</span>."
    },
    {
     "id": 859267,
     "content_html": "The cell harnesses it as heat energy in order to perform work."
    },
    {
     "id": 859268,
     "content_html": "It is primarily stored between the alpha and beta phosphates."
    },
    {
     "id": 859269,
     "content_html": "It provides energy to coupled reactions."
    }
