 "questions": [
  {
   "id": 639783,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A mutation within the promoter region can alter gene transcription. Describe how this can happen.",
   "answers": [
    {
     "id": 1246658,
     "content_html": "Mutated promoters decrease the rate of transcription by altering the binding site for the transcription factor."
    },
    {
     "id": 1246657,
     "content_html": "Mutated promoters increase the rate of transcription by altering the binding site for the transcription factor."
    },
    {
     "id": 1246659,
     "content_html": "Mutated promoters alter the binding site for transcription factors to increase or decrease the rate of transcription."
    },
    {
     "id": 1246656,
     "content_html": "Mutated promoters alter the binding site for transcription factors and thereby cease transcription of the adjacent gene."
    }
   ],
