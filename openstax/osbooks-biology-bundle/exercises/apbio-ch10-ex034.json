 "questions": [
  {
   "id": 507727,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "FtsZ is a prokaryotic protein and tubulin is a eukaryotic protein. These two proteins share many structural and functional similarities and are believed to have evolved from the same ancestral protein. However, there are also some important differences between these proteins. In what way are these proteins different?",
   "answers": [
    {
     "id": 994916,
     "content_html": "Tubulin proteins can rapidly disassemble, but FtsZ proteins cannot."
    },
    {
     "id": 994917,
     "content_html": "Tubulin proteins can form long filaments, but FtsZ proteins cannot."
    },
    {
     "id": 994918,
     "content_html": "Tubulin uses GTP as an energy source, but FtsZ does not."
    },
    {
     "id": 994919,
     "content_html": "Tubulin pulls chromosomes apart, but FtsZ does not."
    }
   ],
