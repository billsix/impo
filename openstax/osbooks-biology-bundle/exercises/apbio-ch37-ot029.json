 "questions": [
  {
   "id": 550800,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>Why does this figure show a higher value of gross productivity for the decomposers than the tertiary consumers?</p>\n\n<p><img src=\"exercises/media/74be18fa338dd554.jpg\" alt=\"A flow chart shows values for gross productivity and net productivity for producers, consumers and decomposers. Sunlight produces 1 million, 700 thousand kilocalories per meter squared per year of energy. Primary producers have a gross productivity of 20810 and a net productivity of 7618. Primary consumers have a gross productivity of 3368 and a net productivity of 1103. Secondary consumers have a gross productivity of 383 and a net productivity of 111. Tertiary consumers have a gross productivity of 21 and a net productivity of 5. Decomposers have a gross productivity of 5060. Total heat and respiration from all producers, consumers and decomposers is 20810\"></p>\n",
   "answers": [
    {
     "id": 1082804,
     "content_html": "Due to the difference in conversion efficiencies of decomposers and tertiary consumers."
    },
    {
     "id": 1082805,
     "content_html": "Because large animals are tertiary consumers whereas small microorganisms are decomposers."
    },
    {
     "id": 1082806,
     "content_html": "Because tertiary consumers only consume secondary consumers whereas decomposers consume dead components of each trophic level."
    },
    {
     "id": 1082807,
     "content_html": "Because tertiary consumers only consume primary consumers whereas decomposers consume dead components of each trophic level."
    }
   ],
