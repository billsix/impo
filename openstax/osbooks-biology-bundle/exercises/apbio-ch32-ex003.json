   "id": 640292,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is given to dehydrated human patients when they need to be given fluids intravenously?",
   "answers": [
    {
     "id": 1248667,
     "content_html": "Water, which is hypotonic with respect to body fluids."
    },
    {
     "id": 1248668,
     "content_html": "Saline at a concentration that is isotonic with respect to body fluids."
    },
    {
     "id": 1248666,
     "content_html": "Glucose because it is a non-electrolyte."
    },
    {
     "id": 1248665,
     "content_html": "blood"
    }
