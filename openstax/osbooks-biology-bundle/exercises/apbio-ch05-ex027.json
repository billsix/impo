  {
   "id": 503069,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why must active transport of molecules across plasma membranes function continuously?",
   "answers": [
    {
     "id": 988407,
     "content_html": "Diffusion cannot occur in certain cells."
    },
    {
     "id": 988408,
     "content_html": "Diffusion is constantly moving solutes in opposite directions."
    },
    {
     "id": 988409,
     "content_html": "Facilitated diffusion works in the same direction as active transport."
    },
    {
     "id": 988410,
     "content_html": "Not all membranes are amphiphilic."
    }
   ],
