 "questions": [
  {
   "id": 232473,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If a doctor injected a patient with what was labeled as an isotonic saline solution, but then the patient died, and an autopsy revealed that several of the patient's red blood cells had burst, such as in the image on the right, would it be true that the injected solution was really isotonic? Why or why not?\n<img src=\"exercises/media/30270f0051f016ad.png\" alt=\"The left part of this illustration shows shriveled red blood cells bathed in a hypertonic solution. The middle part shows healthy red blood cells bathed in an isotonic solution, and the right part shows bloated red blood cells bathed in a hypotonic solution.\">",
   "answers": [
    {
     "id": 720038,
     "content_html": "False, the solution was hypertonic."
    },
    {
     "id": 720037,
     "content_html": "False, the solution was osmotic."
    },
    {
     "id": 720039,
     "content_html": "False, the solution was hypotonic."
    },
    {
     "id": 720036,
     "content_html": "True, the solution was isotonic."
    }
   ],
