 "questions": [
  {
   "id": 535157,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between natural killer cells and macrophages?",
   "answers": [
    {
     "id": 1047136,
     "content_html": "Natural killer cells are not always present in the body and must be induced, whereas macrophages are constantly present."
    },
    {
     "id": 1047137,
     "content_html": "Natural killer cells actually kill foreign cells, whereas macrophages serve only a signaling function."
    },
    {
     "id": 1047138,
     "content_html": "Only macrophages can invade host tissues to fight foreign cells that make their way into those tissues."
    },
    {
     "id": 1047139,
     "content_html": "Natural killer cells kill foreign cells through the processes of lysis and proteolysis, whereas macrophages kill foreign cells by phagocytosis."
    }
   ],
