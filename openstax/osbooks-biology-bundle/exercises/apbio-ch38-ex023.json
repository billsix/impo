     "id": 1040500,
     "content_html": "promoting scab formation"
    },
    {
     "id": 1040501,
     "content_html": "speeding healing of wounds"
    },
    {
     "id": 1040502,
     "content_html": "relaxing muscle pain"
    },
    {
     "id": 1040503,
     "content_html": "a blood thinner"
