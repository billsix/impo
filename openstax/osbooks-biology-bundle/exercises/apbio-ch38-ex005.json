   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In an effort to enter all identified species on Earth into a digital catalog, scientists are preparing a unique tag for each species. The following algorithms have been generated to create unique tags. Estimate which algorithm is best suited for the task.",
   "answers": [
    {
     "id": 849725,
     "content_html": "an algorithm that creates 15,000 to 20,000 unique tags"
    },
    {
     "id": 849726,
     "content_html": "an algorithm that creates 150,000 to 200,000 unique tags"
    },
    {
     "id": 849728,
     "content_html": "an algorithm that creates 1.5 million to 2 million unique tags"
    },
    {
     "id": 849727,
     "content_html": "an algorithm that creates 10 million to 20 million unique tags"
    }
