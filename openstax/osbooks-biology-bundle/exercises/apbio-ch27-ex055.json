 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm15641344\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"9\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n    <span data-type=\"media\" id=\"fs-idp180165168\" data-alt=\"QR Code representing a URL\">\n    <img src=\"https://openstax.org/apps/archive/20220509.174553/resources/12d4d4fa41c1cc60bb8f0469273ac7f9849a354d\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"10\">\n    </span>\n<p id=\"fs-idp49670576\">Click through this <a href=\"https://openstaxcollege.org/l/ear_anatomy\" target=\"_blank\" rel=\"noopener nofollow\">interactive tutorial</a> to review the parts of the ear and how they function to process sound.</p>\n        </div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 241809,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Imagine that your friend’s pet dog ran off into the woods while she was hiking. After about 10 minutes while she still hiked, your friend whistled for her dog, who came running back to her. Explain how the dog was able to use your friend’s whistling to find her, even though she had moved from the location at which the dog had last seen her.",
   "answers": [
    {
     "id": 756698,
     "content_html": "The dog was used to his master’s whistling. This enabled the dog to determine where the sound was coming from."
    },
    {
     "id": 756697,
     "content_html": "The dog was used to the hiking place. This enabled the dog to determine where the sound was coming from."
    },
    {
     "id": 756696,
     "content_html": "The ears of the dog received the sounds at the same time. This enabled the dog to use the timing of sound reception in each ear to determine where the sound was coming from."
    },
    {
     "id": 756699,
     "content_html": "The two ears of the dog received the sounds at slightly different times. This enabled the dog to use the timing of sound reception in each ear to determine where the sound was coming from."
    }
   ],
