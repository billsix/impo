   "id": 503727,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is an example of passive transport across a membrane?",
   "answers": [
    {
     "id": 990291,
     "content_html": "the movement of <span data-math=\"\\text{H}^+\\!\">\\text{H}^+\\!</span> into a thylakoid disc during photosynthesis"
    },
    {
     "id": 990292,
     "content_html": "the uptake of glucose in the intestine"
    },
    {
     "id": 990293,
     "content_html": "the uptake of mineral ions into root hair cells of plants"
    },
    {
     "id": 990294,
     "content_html": "the movement of water from the descending loop of a nephron into the interstitium"
    }
