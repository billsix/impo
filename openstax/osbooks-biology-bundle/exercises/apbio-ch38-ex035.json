  {
   "id": 531986,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Loss of biodiversity and accelerations of extinction rates have several causes. Which of the following situations causes direct loss of biodiversity owing to loss of habitat?",
   "answers": [
    {
     "id": 1040836,
     "content_html": "fishing cod at a rate that is greater than natural replacement"
    },
    {
     "id": 1040837,
     "content_html": "converting a prairie to a farm field"
    },
    {
     "id": 1040838,
     "content_html": "introduction of an invasive ornamental plant in a new ecosystem"
    },
    {
     "id": 1040839,
     "content_html": "emission of greenhouse gases increasing the average temperatures of an area"
    }
   ],
