   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare and contrast veins and arteries.",
   "answers": [
    {
     "id": 1045580,
     "content_html": "Both veins and arteries have three distinct layers. Veins take blood away from the heart and arteries bring blood back to the heart."
    },
    {
     "id": 1045581,
     "content_html": "Both veins and arteries have three distinct layers. Arteries take blood away from the heart and veins bring blood back to the heart."
    },
    {
     "id": 1045582,
     "content_html": "Both veins and arteries have valves to prevent the backflow of blood. Arteries take blood away from the heart and veins bring blood back to the heart."
    },
    {
     "id": 1045583,
     "content_html": "Both veins and arteries have valves to prevent the backflow of blood. Veins take blood away from the heart and arteries bring blood back to the heart."
