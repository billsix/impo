 "questions": [
  {
   "id": 550725,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If a scientist wanted to monitor a desert food chain, what type of model might they develop and why?",
   "answers": [
    {
     "id": 1082528,
     "content_html": "An analytical model would be ideal because they can address simple, linear ecosystem components that are mathematically complex."
    },
    {
     "id": 1082529,
     "content_html": "A simulation model would be ideal because they can address simple, linear systems that are mathematically complex."
    },
    {
     "id": 1082530,
     "content_html": "An analytical model would be ideal as they are considered ecologically more realistic than any other model."
    },
    {
     "id": 1082531,
     "content_html": "A simulation model would be ideal because it uses numerical techniques to solve problems and visualize the complex relationships that exist in the ecosystem."
    }
   ],
