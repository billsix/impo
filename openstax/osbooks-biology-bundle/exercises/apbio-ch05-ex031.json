 "questions": [
  {
   "id": 513344,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens to the membrane of a vesicle after exocytosis?",
   "answers": [
    {
     "id": 1004970,
     "content_html": "It leaves the cell."
    },
    {
     "id": 1004971,
     "content_html": "It is disassembled by the cell."
    },
    {
     "id": 1004972,
     "content_html": "It fuses with and becomes part of the plasma membrane."
    },
    {
     "id": 1004973,
     "content_html": "It is used again in another exocytosis event."
    }
   ],
