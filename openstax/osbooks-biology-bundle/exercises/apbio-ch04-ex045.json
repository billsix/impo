 "questions": [
  {
   "id": 639544,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do the nucleus and the endomembrane system work together for protein synthesis?",
   "answers": [
    {
     "id": 1245725,
     "content_html": "The endomembrane system processes and ships proteins specified by the nucleus. In the nucleus, DNA is used to make RNA which exits the nucleus and enters the cytoplasm of the cell. The ribosomes on the rough ER use the RNA to create the different types of protein needed by the body."
    },
    {
     "id": 1245724,
     "content_html": "The endomembrane system processes and ships proteins specified by the nucleus. From the nucleus, DNA exits and enters the cytoplasm of the cell. The ribosomes on the rough ER use the DNA to create the different types of protein needed by the body."
    },
    {
     "id": 1245723,
     "content_html": "The endomembrane system processes and ships proteins specified by the nucleus. In the nucleus, DNA is used to make RNA which exits the nucleus and enters the cytoplasm of the cell. The smooth ER uses the RNA to create the different types of protein needed by the body."
    },
    {
     "id": 1245722,
     "content_html": "The endomembrane system processes and ships proteins specified by the nucleus. In the nucleus, DNA is used to make RNA which exits the nucleus and enters the cytoplasm of the cell. The ribosomes on the smooth ER use the RNA to create the different types of protein needed by the body."
    }
   ],
