 "questions": [
  {
   "id": 343560,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/9958143c13e9f45b.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Andrew K. Joe, et al./<i>American Association for Cancer Research</i>)</figcaption>\n</figure>",
   "stem_html": "<p>The two graphs show the results of a study on a cancer drug. The left graph shows the results control group, untreated cancer cells. The right graph shows the results for the cells treated with the drug.</p>\n<p>What can be said about this drug?</p>",
   "answers": [
    {
     "id": 856074,
     "content_html": "The drug does not have an effect on cancer cells."
    },
    {
     "id": 856075,
     "content_html": "The drug causes the cells to go through the G1 phase slower."
    },
    {
     "id": 856076,
     "content_html": "The drug causes the cells to go through the G1 phase faster."
    },
    {
     "id": 856077,
     "content_html": "The drug arrests the cell cycle at the G1 phase."
    }
   ],
