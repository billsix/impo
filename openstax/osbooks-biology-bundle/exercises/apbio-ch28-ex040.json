 "questions": [
  {
   "id": 241914,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/086d000c0802c547.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Stephen L. Aronoff, MD, FACP, FACE, et al./DiabetesSpectrum)</figcaption>\n</figure>\n",
   "stem_html": "The graph shows the blood glucose, insulin and glucagon levels of a healthy person and a diabetic person. Take special note of the y-axis scale for glucose and insulin. Take note of the data before insulin infusion (unfilled circles). Make a claim based on these graphs.",
   "answers": [
    {
     "id": 757119,
     "content_html": "The diabetic person cannot secrete high levels of insulin."
    },
    {
     "id": 757118,
     "content_html": "The diabetic person can secrete comparable amounts of insulin to a healthy person, but the insulin cannot reduce blood glucose."
    },
    {
     "id": 757117,
     "content_html": "The sugar levels of a diabetic person and a healthy person are about the same after a meal."
    },
    {
     "id": 757116,
     "content_html": "The diabetic person secretes very high amounts of insulin right after a meal."
    }
   ],
