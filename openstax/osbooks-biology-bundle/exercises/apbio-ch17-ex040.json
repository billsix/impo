   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the greatest challenge facing genome sequencing?",
   "answers": [
    {
     "id": 1246762,
     "content_html": "the lack of resources and use of chemicals for the sequencing of the DNA fragments"
    },
    {
     "id": 1246763,
     "content_html": "the ethical issues such as discrimination based on person’s genetics"
    },
    {
     "id": 1246761,
     "content_html": "the use of chemicals during the sequencing methods that could incorporate mutations"
    },
    {
     "id": 1246760,
     "content_html": "the scientific issues, like conserving the human genome sequences"
    }
