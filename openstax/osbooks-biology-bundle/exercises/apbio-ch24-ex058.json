   "id": 520449,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does hibernation differ in small animals such as ground squirrels and larger animals such as bears?",
   "answers": [
    {
     "id": 1017201,
     "content_html": "Smaller animals can engage in torpor while larger animals cannot."
    },
    {
     "id": 1017202,
     "content_html": "Larger animals can engage in torpor while smaller animals cannot."
    },
    {
     "id": 1017203,
     "content_html": "Smaller animals cannot remain inactive throughout the entire winter while larger animals can."
    },
    {
     "id": 1017204,
     "content_html": "Larger animals cannot remain inactive throughout the entire winter while smaller animals can."
    }
