 "questions": [
  {
   "id": 668830,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What type of evidence for life was most likely found in a 3.5 billion year old rock?",
   "answers": [
    {
     "id": 1333467,
     "content_html": "Scientists found bones buried in the rock that resemble bones of living animals."
    },
    {
     "id": 1333468,
     "content_html": "Dead cells buried in the rock superficially resemble living prokaryotic cells."
    },
    {
     "id": 1333469,
     "content_html": "The fossil superficially resembles living microbial mats that exist today."
    },
    {
     "id": 1333470,
     "content_html": "Scientists found fossilized prokaryotic cells in the rock that are able to grow and divide."
    }
   ],
