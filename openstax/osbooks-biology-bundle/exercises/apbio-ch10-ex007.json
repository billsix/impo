 "questions": [
  {
   "id": 507636,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Gout is a form of arthritis that causes a painful inflammation of joints. One treatment for gout is colchicine, a medication that inhibits mitosis. Explain why this medication is beneficial for people with gout and why it can cause undesirable side effects, such as low white blood cell counts.",
   "answers": [
    {
     "id": 994696,
     "content_html": "Colchicine increases inflammation by inhibiting mitosis. Inhibition of mitosis results in decreased white blood count."
    },
    {
     "id": 994697,
     "content_html": "Colchicine decreases inflammation by inhibiting mitosis. Inhibition of mitosis results in decreased white blood count."
    },
    {
     "id": 994698,
     "content_html": "Colchicine increases inflammation by inhibiting mitosis. Inhibition of mitosis results in increased white blood count."
    },
    {
     "id": 994699,
     "content_html": "Colchicine decreases inflammation by inhibiting mitosis. Inhibition of mitosis results in increased white blood count."
    }
