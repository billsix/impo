 "questions": [
  {
   "id": 334505,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements most accurately describes domestication syndrome?",
   "answers": [
    {
     "id": 843662,
     "content_html": "Genes responsible for temperament are on the same chromosome as genes responsible for certain facial features."
    },
    {
     "id": 843659,
     "content_html": "A single gene codes for both temperament and certain facial features, such as jaw size."
    },
    {
     "id": 843660,
     "content_html": "Genes responsible for mild temperament are only expressed when genes encoding a cute face are also present."
    },
    {
     "id": 843661,
     "content_html": "The products of genes encoding temperament interact with the products of genes encoding facial features."
    }
   ],
