 "questions": [
  {
   "id": 238512,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What do the rising levels of FSH and LH in the follicular phase cause?",
   "answers": [
    {
     "id": 743786,
     "content_html": "The follicles on the surface of the ovary start growing in preparation for ovulation."
    },
    {
     "id": 743785,
     "content_html": "The endometrium starts to thicken."
    },
    {
     "id": 743784,
     "content_html": "The corpus luteum starts secreting progesterone."
    },
    {
     "id": 743783,
     "content_html": "One of the mature follicles bursts, releasing the egg."
    }
   ],
