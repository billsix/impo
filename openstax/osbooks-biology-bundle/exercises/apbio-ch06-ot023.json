   "stimulus_html": "",
   "stem_html": "Which best describes the effect of inputting energy into a living system?",
   "answers": [
    {
     "id": 989263,
     "content_html": "Energy input must exceed energy loss to maintain order and to power cellular processes."
    },
    {
     "id": 989264,
     "content_html": "It fuels metabolism."
    },
    {
     "id": 989265,
     "content_html": "Inputting energy into a living system leads to death."
    },
    {
     "id": 989266,
     "content_html": "The energy is used to produce carbohydrates."
    }
