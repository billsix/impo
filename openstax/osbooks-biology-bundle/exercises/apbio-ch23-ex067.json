   "id": 519896,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A pulse of sugars labelled with a fluorescent dye is supplied to leaves of young plants. After a brief interval, tissue sections are obtained from the plant and examined under the fluorescence microscope. Tissues are scored for the presence of fluorescence and ranked from very high to low fluorescence. Which cells would contain the most fluorescence?",
   "answers": [
    {
     "id": 1015099,
     "content_html": "xylem"
    },
    {
     "id": 1015100,
     "content_html": "companion cells"
    },
    {
     "id": 1015101,
     "content_html": "sieve elements"
    },
    {
     "id": 1015102,
     "content_html": "epidermis"
    }
   ],
