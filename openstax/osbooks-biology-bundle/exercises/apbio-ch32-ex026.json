 "questions": [
  {
   "id": 242239,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is excretion important in order to achieve osmotic balance?",
   "answers": [
    {
     "id": 758418,
     "content_html": "The body accumulates water within itself when excretion does not occur, which can have dire consequences."
    },
    {
     "id": 758417,
     "content_html": "Excretion regulates the movement of water within the membranes, which ultimately maintains osmotic balance."
    },
    {
     "id": 758416,
     "content_html": "In the absence of excretion, there is a shift in the concentrations, which disrupts osmotic balance."
    },
    {
     "id": 758419,
     "content_html": "The body builds up many chemical compounds that need to be excreted to maintain homeostasis and osmotic balance."
    }
   ],
