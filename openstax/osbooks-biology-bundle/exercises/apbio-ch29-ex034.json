 "questions": [
  {
   "id": 546952,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/ed25eb3d27cc068f.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Dwane Ross Stewart/ResearchGate)</figcaption>\n</figure>\n",
   "stem_html": "<p>The graph shows the frequency of joint injury per 1000 exposure hours among malerugby players sustained during a season against the site of injury. Shoulder and hip joints are ball and socket. Elbow and knee joints are hinge. Wrist joint is condyloid.</p>\n<p>Make a claim based on this graph.</p>",
   "answers": [
    {
     "id": 1072915,
     "content_html": "Hinge joints are stronger than ball and socket joints."
    },
    {
     "id": 1072916,
     "content_html": "Among ball and socket joints, the one with less movement is stronger."
    },
    {
     "id": 1072917,
     "content_html": "Among hinge joints, the one with more movement is stronger."
    },
    {
     "id": 1072918,
     "content_html": "Condyloid joints are stronger than hinge joints."
    }
   ],
