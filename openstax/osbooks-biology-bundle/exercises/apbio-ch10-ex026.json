 "questions": [
  {
   "id": 507696,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain the roles of the positive cell cycle regulators compared to the negative regulators.",
   "answers": [
    {
     "id": 994836,
     "content_html": "Positive regulators promote the cell cycle but negative regulators initiate apoptosis."
    },
    {
     "id": 994837,
     "content_html": "Positive regulators block the cell division in cancerous cells but negative regulators promote in such cells."
    },
    {
     "id": 994838,
     "content_html": "Positive regulators promote the cell cycle but negative regulators arrest the cell cycle until certain events have occurred."
    },
    {
     "id": 994839,
     "content_html": "Positive regulators show positive feedback mechanisms but negative regulators show negative feedback in the cell cycle."
    }
   ],
