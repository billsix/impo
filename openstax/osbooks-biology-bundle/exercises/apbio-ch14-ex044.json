   "stimulus_html": "",
   "stem_html": "You isolate a cell strain in which the joining together of Okazaki fragments is impaired and suspect that a mutation has occurred in an enzyme found at the replication fork. Which enzyme is most likely to be mutated?",
   "answers": [
    {
     "id": 872044,
     "content_html": "DNA ligase"
    },
    {
     "id": 872041,
     "content_html": "DNA polymerase III"
    },
    {
     "id": 872042,
     "content_html": "helicase"
    },
    {
     "id": 872043,
     "content_html": "topoisomerase"
    }
