 "questions": [
  {
   "id": 232342,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/5c6d9ccaa6e82f58.jpg\" alt=\"A sphere and a cube are illustrated. They appear to be equal in size\"></p>\n<p>Which of the following is true regarding the surface-to-volume ratios of the cube and the sphere when the diameter of the sphere is equal to the side of the cube?</p>\n",
   "answers": [
    {
     "id": 719517,
     "content_html": "The sphere will have a higher surface area than the cube."
    },
    {
     "id": 719516,
     "content_html": "The cube will have twice the surface area of the sphere."
    },
    {
     "id": 719515,
     "content_html": "The sphere will have a higher surface area-to-volume ratio than the cube."
    },
    {
     "id": 719518,
     "content_html": "The surface area to volume ratios will be equal"
    },
    {
     "id": 719514,
     "content_html": "The sphere will have a lower surface area-to-volume ratio than the cube."
    }
   ],
