 "questions": [
  {
   "id": 639646,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between intracellular signaling and intercellular signaling?",
   "answers": [
    {
     "id": 1246122,
     "content_html": "Intracellular signaling occurs between cells of two different species. Intercellular signaling occurs between two cells of the same species."
    },
    {
     "id": 1246121,
     "content_html": "Intracellular signaling occurs between two cells of same species. Intercellular signaling occurs between cells of two different species."
    },
    {
     "id": 1246123,
     "content_html": "Intracellular signaling occurs within a cell. Intercellular signaling occurs between cells."
    },
    {
     "id": 1246120,
     "content_html": "Intracellular signaling occurs between cells. Intercellular signaling occurs within cell."
    }
   ],
