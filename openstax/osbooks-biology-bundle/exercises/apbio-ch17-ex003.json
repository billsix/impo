 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1397608\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"eip-id1412962\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/9d39122d8a86c4e9f9c645b86c6c78d3663c88ed\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\"> </span> \n<p id=\"fs-id1242332\">View an <a href=\"https://openstaxcollege.org/l/recombination\" target=\"_blank\" rel=\"noopener nofollow\">animation of recombination in cloning</a> from the DNA Learning Center.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 511883,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are the functions of the restriction enzymes and DNA ligase in recombination?",
   "answers": [
    {
     "id": 1001170,
     "content_html": "Restriction enzymes restrict the recombination process. DNA ligase ligates the products of recombination with each other."
    },
    {
     "id": 1001171,
     "content_html": "DNA ligase splices DNA at a specific point, so the new piece of DNA can be inserted. Restriction enzymes stitch together the new gene to the existing piece of DNA."
    },
    {
     "id": 1001172,
     "content_html": "Restriction enzymes splice DNA at a specific point, so the new piece of DNA can be inserted. DNA ligase stitches together the new foreign gene to the existing piece of DNA."
    },
    {
     "id": 1001173,
     "content_html": "Restriction enzymes splice the existing piece of DNA only to accommodate the new piece of DNA. DNA ligase ligates the new DNA with the existing DNA."
    }
   ],
