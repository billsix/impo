 "questions": [
  {
   "id": 520252,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A bacterium requires only a particular amino acid as an organic nutrient and lives in a completely lightless environment. What mode of nutrition (free energy and carbon) does it use? Justify your response.",
   "answers": [
    {
     "id": 1016463,
     "content_html": "Chemoheterotroph, as it must rely on chemical sources of energy living in a lightless environment and a heterotroph if it uses organic compounds for its carbon source."
    },
    {
     "id": 1016464,
     "content_html": "Chemoorganotroph, as it must rely on chemical sources of energy living in a lightless environment and an organotroph if it uses organic compounds for its carbon source."
    },
    {
     "id": 1016465,
     "content_html": "Chemolitoautotroph, as it must rely on chemical sources of energy living in a lightless environment and an autotroph if it uses organic compounds for its carbon source."
    },
    {
     "id": 1016466,
     "content_html": "Chemoheterotroph, as it must rely on chemical sources of energy living in a lightless environment and a heterotroph if it uses organic compounds for its carbon source."
    }
   ],
