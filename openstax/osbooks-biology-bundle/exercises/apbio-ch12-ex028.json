 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1760153\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"9\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n                <span data-type=\"media\" id=\"fs-id2270968\" data-alt=\"QR Code representing a URL\">\n                    <img src=\"https://openstax.org/apps/archive/20220509.174553/resources/10b5df20ac29d3c18c5672313eee59c9fa9651fe\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"130\" id=\"10\">\n                </span>\n                <p id=\"fs-id1671213\">Eye color in humans is determined by multiple genes. Use the <a href=\"https://openstaxcollege.org/l/eye_color_calc\" target=\"_blank\" rel=\"noopener nofollow\">Eye Color Calculator</a> to predict the eye color of children from parental eye color.</p>\n            </div>\n</div>\n",
 "stimulus_html": "",
 "questions": [
  {
   "id": 232978,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A couple produces a green-eyed child, although both of the parents have brown eyes. Based on your understanding of inheritance of the trait of eye color in humans, provide a claim for how this outcome is genetically possible.",
   "answers": [
    {
     "id": 722057,
     "content_html": "Both parents are homozygous for the dominant trait of brown eyes."
    },
    {
     "id": 722058,
     "content_html": "Both parents are heterozygous, having the green trait on the green-blue eye gene."
    },
    {
     "id": 722056,
     "content_html": "Both parents are heterozygous with the recessive trait of brown eyes."
    },
    {
     "id": 722055,
     "content_html": "Both parents are homozygous, having the green trait on the green-blue eye gene."
    }
   ],
