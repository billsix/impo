 "questions": [
  {
   "id": 531086,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Humans have altered their own carrying capacity. Explain how humans have changed their carrying capacity and the consequences of this change.",
   "answers": [
    {
     "id": 1039660,
     "content_html": "By limiting their own carrying capacity, humans have enabled their population to grow rapidly."
    },
    {
     "id": 1039661,
     "content_html": "By decreasing their own carrying capacity, humans have enabled their population to grow slowly."
    },
    {
     "id": 1039662,
     "content_html": "By stabilizing their own carrying capacity, humans have enabled their population to grow steadily."
    },
    {
     "id": 1039663,
     "content_html": "By increasing their own carrying capacity, humans have enabled their population to grow exponentially."
    }
   ],
