 "questions": [
  {
   "id": 242618,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain the correlation between age structure and the level of economic development observed in many countries.",
   "answers": [
    {
     "id": 759933,
     "content_html": "There is no correlation between the characteristics of age structures and the level of economic development."
    },
    {
     "id": 759932,
     "content_html": "Countries that are more economically developed tend to have fewer middle-aged individuals and more young individuals than undeveloped countries."
    },
    {
     "id": 759931,
     "content_html": "A larger ratio of very young individuals to very old individuals characterizes the age structures of countries with the highest economic development."
    },
    {
     "id": 759934,
     "content_html": "Age structures of economically undeveloped countries show greater proportions of children and fewer proportions of elderly people."
    }
   ],
