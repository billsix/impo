   "id": 640420,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If an ecosystem is considered to be highly resilient, what can be inferred about that ecosystem?",
   "answers": [
    {
     "id": 1249167,
     "content_html": "The ecosystem is in a steady state."
    },
    {
     "id": 1249166,
     "content_html": "The ecosystem has the ability to remain in equilibrium despite disturbance."
    },
    {
     "id": 1249168,
     "content_html": "The ecosystem recovers quickly from disturbance."
    },
    {
     "id": 1249165,
     "content_html": "The ecosystem is exposed to disturbances."
    }
   ],
