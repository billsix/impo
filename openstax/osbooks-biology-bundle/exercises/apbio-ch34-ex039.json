   "id": 517047,
   "is_answer_order_important": true,
   "stimulus_html": "<img src=\"exercises/media/4e7398f5958aa85b.jpg\" alt=\"\">",
   "stem_html": "Which of the following statements about the menstrual cycle is TRUE?",
   "answers": [
    {
     "id": 1011254,
     "content_html": "Estrogen levels rise during the luteal phase of the ovarian cycle and the secretory phase of the uterine cycle."
    },
    {
     "id": 1011255,
     "content_html": "Menstruation occurs much before LH and FSH levels peak."
    },
    {
     "id": 1011256,
     "content_html": "Menstruation occurs after progesterone levels rise."
    },
    {
     "id": 1011257,
     "content_html": "Progesterone levels rise before ovulation, while estrogen levels rise after."
    }
   ],
