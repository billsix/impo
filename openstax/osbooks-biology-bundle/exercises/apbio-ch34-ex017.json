   "id": 517025,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is broadcast spawning considered advantageous?",
   "answers": [
    {
     "id": 1011174,
     "content_html": "Production of many eggs increases the chance of fertilization."
    },
    {
     "id": 1011175,
     "content_html": "Production of many sperm increases the chance of fertilization."
    },
    {
     "id": 1011176,
     "content_html": "It results in mixing of genes and greater genetic diversity."
    },
    {
     "id": 1011177,
     "content_html": "Animals that are motile carry out this process."
    }
