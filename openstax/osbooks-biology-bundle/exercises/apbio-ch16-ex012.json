 "questions": [
  {
   "id": 233269,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would be the result of a mutation in the repressor protein that prevented it from binding lactose?",
   "answers": [
    {
     "id": 723219,
     "content_html": "The repressor will bind to lactose when it is removed from the operator."
    },
    {
     "id": 723222,
     "content_html": "The repressor will bind the operator in the presence of lactose."
    },
    {
     "id": 723220,
     "content_html": "The repressor will not bind the operator in the presence of lactose."
    },
    {
     "id": 723221,
     "content_html": "The repressor will not bind the operator in the absence of lactose."
    }
   ],
