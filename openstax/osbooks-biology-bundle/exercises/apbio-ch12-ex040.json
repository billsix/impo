 "questions": [
  {
   "id": 334493,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A couple planning a family hopes to eventually have three children. What is the probability that the couple will have three daughters? Justify your claim with reasoning.",
   "answers": [
    {
     "id": 843612,
     "content_html": "<span data-math=\"% <![CDATA[\n{1\\over2}%]]>\">% </span>; this is always the probability of having a daughter"
    },
    {
     "id": 843613,
     "content_html": "<span data-math=\"% <![CDATA[\n{1\\over3}%]]>\">% </span>; the probability depends on the number of offspring"
    },
    {
     "id": 843614,
     "content_html": "<span data-math=\"% <![CDATA[\n{1\\over6}%]]>\">% </span>; this is the probability of having one daughter times the number of offspring"
    },
    {
     "id": 843615,
     "content_html": "<span data-math=\"% <![CDATA[\n{1\\over8}%]]>\">% </span>; this is the probaility of having one daughter, cubed"
    }
   ],
