 "questions": [
  {
   "id": 640154,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are some dietary lipids a necessary part of a balanced diet?",
   "answers": [
    {
     "id": 1248118,
     "content_html": "Dietary lipids aid in the absorption of water-soluble vitamins, including B and C, which are needed for various bodily functions."
    },
    {
     "id": 1248117,
     "content_html": "Dietary lipids aid in the absorption of some minerals, including folic acid, iron, and magnesium, which are needed for various bodily functions."
    },
    {
     "id": 1248116,
     "content_html": "Dietary lipids aid in the absorption of vitamins, including A, B, C, D, E, and K, which are needed for various bodily functions"
    },
    {
     "id": 1248119,
     "content_html": "Dietary lipids aid in the absorption of fat-soluble vitamins, including A, D, E, and K, which are needed for various bodily functions."
    }
   ],
