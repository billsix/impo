 "questions": [
  {
   "id": 233109,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do the linear chromosomes in eukaryotes ensure that their ends are replicated completely?",
   "answers": [
    {
     "id": 722582,
     "content_html": "The ends of the linear chromosomes are maintained by the activity of the telomerase enzyme."
    },
    {
     "id": 722579,
     "content_html": "The ends of the linear chromosomes are maintained by the formation of a replication fork."
    },
    {
     "id": 722580,
     "content_html": "The ends of the linear chromosomes are maintained by the continuous joining of Okazaki fragments."
    },
    {
     "id": 722581,
     "content_html": "The ends of the linear chromosomes are maintained by the action of the polymerase enzyme."
    }
   ],
