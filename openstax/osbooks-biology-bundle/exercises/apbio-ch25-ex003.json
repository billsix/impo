 "context": "<figure id=\"fig-ch34_01_11\" class=\" \"><span data-type=\"media\" id=\"fs-idp170388752\" data-alt=\"Illustration shows a cross section of the small intestine, the lumen, or inside of which has many fingerlike projections called villi. Muscle layers wrap around the outside of the intestine, and blood vessels interact with the muscle layer. A blowup shows that capillaries and lymphatic vessels travel up inside the villi. The surface of each villus is covered with hairline microvilli.\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/b254e8d30a1adabb91df2c900c119be34e58ddb4\" data-media-type=\"image/png\" alt=\"Illustration shows a cross section of the small intestine, the lumen, or inside of which has many fingerlike projections called villi. Muscle layers wrap around the outside of the intestine, and blood vessels interact with the muscle layer. A blowup shows that capillaries and lymphatic vessels travel up inside the villi. The surface of each villus is covered with hairline microvilli.\" width=\"500\" height=\"236\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 521680,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about the small intestine is true?",
   "answers": [
    {
     "id": 1020520,
     "content_html": "Absorptive cells that line the small intestine have small projections that increase surface area and aid in the absorption of food."
    },
    {
     "id": 1020521,
     "content_html": "The outside of the small intestine has many folds, called villi."
    },
    {
     "id": 1020522,
     "content_html": "Microvilli are lined with blood vessels as well as lymphatic vessels."
    },
    {
     "id": 1020523,
     "content_html": "The inside of the small intestine is called the lymphatic vessel."
    }
   ],
