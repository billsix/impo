 "questions": [
  {
   "id": 242359,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are naïve B or T cells and how do they function in cell-mediated and humoral immune responses?",
   "answers": [
    {
     "id": 758897,
     "content_html": "Naïve B and T cells are lymphocytes of the B and T types that have come into contact with pathogenic antigens. Naïve T cells produce antibodies in the humoral immune response, while naïve B cells stimulate the cell-mediated immune response."
    },
    {
     "id": 758896,
     "content_html": "Naïve B and T cells are lymphocytes of the B and T types that normally circulate in the body at all times and have not come into contact with any pathogenic antigens. Activated T cells produce antibodies in the humoral immune response, while activated B cells stimulate the cell-mediated immune response."
    },
    {
     "id": 758898,
     "content_html": "Naïve B and T cells are lymphocytes of the B and T types that normally circulate in the body at all times and have not come into contact with any pathogenic antigens. Activated B cells produce antibodies in the humoral immune response, while activated T cells stimulate the cell-mediated immune response."
    },
    {
     "id": 758895,
     "content_html": "Naïve B and T cells are lymphocytes of the B and T types that have come into contact with pathogenic antigens. Naïve B cells produce antibodies in the humoral immune response, while naïve T cells stimulate the cell-mediated immune response."
    }
