 "questions": [
  {
   "id": 519850,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the advantage of a root cap covering the apical meristem of a root?",
   "answers": [
    {
     "id": 1014923,
     "content_html": "It provides protection and helps in absorption."
    },
    {
     "id": 1014924,
     "content_html": "It increases the surface area of root for absorption of water and minerals."
    },
    {
     "id": 1014925,
     "content_html": "It protects meristem against injury and provides lubrication for the growing root to dig through soil."
    },
    {
     "id": 1014926,
     "content_html": "It protects the meristem against injury and helps in absorption."
    }
   ],
