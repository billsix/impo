 "questions": [
  {
   "id": 232460,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements appropriately describe the role of clathrin in neutrophils based on your understanding of phagocytosis?",
   "answers": [
    {
     "id": 719986,
     "content_html": "Clathrin tethers the antigen to the cytoskeleton."
    },
    {
     "id": 719985,
     "content_html": "Clathrin opposes phagocytosis."
    },
    {
     "id": 719984,
     "content_html": "Clathrin marks the antigen on the invading cell  for phagocytosis by neutrophils."
    },
    {
     "id": 719987,
     "content_html": "Clathrin stabilizes the inward facing surface of the plasma membrane, which engulfs the antigen."
    }
   ],
