 "questions": [
  {
   "id": 233488,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>Populations of a plant species have been found growing in the mountains at altitudes above 2,500 meters. Populations of a plant that appears similar, with slight differences, have been found in the same mountains at altitudes below 2,300 meters.</p>\n<p>How can you test if speciation has taken place?</p>",
   "answers": [
    {
     "id": 724097,
     "content_html": "Test if the slight differences in phenotype are eliminated when the two plants are grown in the same environment."
    },
    {
     "id": 724098,
     "content_html": "If the seeds from the plants can be cross fertilized and developed into fertile offspring, the two populations are not yet reproductively isolated and remain one species."
    },
    {
     "id": 724096,
     "content_html": "If genes transplanted between the plants function successfully, then the plants must be similar enough to each other to belong to the same species."
    },
    {
     "id": 724095,
     "content_html": "If scientists are able to find the common ancestor of the two groups in the fossil record or in neighboring communities, then they can determine whether the plants have diverged into separate species or remain a single species."
    }
   ],
   "hints": [],
