   "id": 335634,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/a17e2e2bae459980.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Laura A B Wilson and Marcelo R Sánchez-Villagra/National Center for Biotechnology Information)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image shows the skull of a large aquatic rodent called coypu.</p>\n<p>Make a claim about suture joints based on this image.</p>",
   "answers": [
    {
     "id": 848119,
     "content_html": "Suture joints are seen only in mammal species."
    },
    {
     "id": 848120,
     "content_html": "Suture joints are seen only in humans."
    },
    {
     "id": 848122,
     "content_html": "Early mammals had suture joints."
    },
    {
     "id": 848121,
     "content_html": "Suture joints are only seen in warm blooded animals."
    }
   ],
