 "questions": [
  {
   "id": 639795,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Targeted therapies are used in patients with a certain gene expression pattern. A targeted therapy that prevents the activation of the estrogen receptor in breast cancer would be beneficial to what type of patient?",
   "answers": [
    {
     "id": 1246702,
     "content_html": "patients who express the EGFR receptor in normal cells"
    },
    {
     "id": 1246703,
     "content_html": "patients with a mutation that inactivates the estrogen receptor"
    },
    {
     "id": 1246705,
     "content_html": "patients with over-expression of ER alpha in their tumor cells"
    },
    {
     "id": 1246704,
     "content_html": "patients with over-expression of VEGF, which helps in tumor angiogenesis"
    }
   ],
