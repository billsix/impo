 "questions": [
  {
   "id": 546578,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between innate and learned behaviors?",
   "answers": [
    {
     "id": 1071468,
     "content_html": "Innate behaviors can change based on previous experiences, whereas learned behaviors remain the same throughout an organism’s life."
    },
    {
     "id": 1071469,
     "content_html": "Innate behaviors are controlled by genes, whereas genes play no role in learned behaviors."
    },
    {
     "id": 1071470,
     "content_html": "Innate behaviors allow an organism to adapt to new situations by applying previous experiences, whereas learned behaviors allow an organism to respond quickly."
    },
    {
     "id": 1071471,
     "content_html": "Innate behaviors are involuntary responses to stimuli, whereas learned behaviors change based on an organism’s experiences."
    }
   ],
