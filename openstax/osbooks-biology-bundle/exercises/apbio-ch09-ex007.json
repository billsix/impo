 "questions": [
  {
   "id": 513278,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Aldosterone is a steroid hormone that regulates reabsorption of sodium ions in the kidney tubular cells. What is the probable mechanism of action of aldosterone?",
   "answers": [
    {
     "id": 1004716,
     "content_html": "It binds gated ion channels and causes a flow of ions in the cell."
    },
    {
     "id": 1004717,
     "content_html": "It binds cell surface receptors and activates synthesis of cAMP."
    },
    {
     "id": 1004718,
     "content_html": "It binds to cell surface receptors and activates a phosphorylation cascade."
    },
    {
     "id": 1004719,
     "content_html": "It binds to an intracellular receptor and activates gene transcription."
    }
   ],
