 "questions": [
  {
   "id": 503099,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Consider a pendulum swinging. Which type(s) of energy is/are associated with the pendulum in the following instances:\n\n<ol>\n  <li>the moment at which it completes one cycle, just before it begins to fall back towards the other end</li>\n  <li>the moment that it is in the middle between the two ends</li>\n  <li>just before it reaches the end of one cycle (before step 1)</li>\n</ol>\n",
   "answers": [
    {
     "id": 988527,
     "content_html": "<ol>\n  <li>potential and kinetic</li>\n  <li>potential and kinetic</li>\n  <li>kinetic</li>\n</ol>\n"
    },
    {
     "id": 988528,
     "content_html": "<ol>\n  <li>potential</li>\n  <li>potential and kinetic</li>\n  <li>potential and kinetic</li>\n</ol>\n"
    },
    {
     "id": 988529,
     "content_html": "<ol>\n  <li>potential</li>\n  <li>kinetic</li>\n  <li>potential and kinetic</li>\n</ol>\n"
    },
    {
     "id": 988530,
     "content_html": "<ol>\n  <li>potential and kinetic</li>\n  <li>kinetic</li>\n  <li>kinetic</li>\n</ol>\n"
    }
   ],
