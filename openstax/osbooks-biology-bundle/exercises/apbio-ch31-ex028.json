 "questions": [
  {
   "id": 534654,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Many platelets converge and stick together at a wound site, eventually forming a platelet plug, also called a fibrin clot. Platelets continue to arrive at the wound site until the plug is completely formed. Describe the feedback mechanisms taking place and predict what would likely happen if part of the platelet plug broke away before the wound was healed.",
   "answers": [
    {
     "id": 1045418,
     "content_html": "A positive feedback loop, which would restart if part of the platelet plug broke away, calling more platelets to the site to repair the broken plug."
    },
    {
     "id": 1045419,
     "content_html": "A negative feedback loop, which would restart if part of the platelet plug broke away, calling more platelets to the site to repair the broken plug."
    },
    {
     "id": 1045420,
     "content_html": "A positive feedback loop, which would not restart if part of the platelet plug broke away."
    },
    {
     "id": 1045421,
     "content_html": "A negative feedback loop, which would not restart if part of the platelet plug broke away."
    }
   ],
