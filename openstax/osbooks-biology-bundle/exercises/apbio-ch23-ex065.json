   "id": 519888,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Plants can modify their water potential by opening and closing their stomata to modulate the rate of respiration according to environmental conditions. Which of the following environmental conditions would cause the stomata to close?",
   "answers": [
    {
     "id": 1015067,
     "content_html": "increased temperature"
    },
    {
     "id": 1015068,
     "content_html": "high oxygen concentration"
    },
    {
     "id": 1015069,
     "content_html": "high relative humidity"
    },
    {
     "id": 1015070,
     "content_html": "high light levels"
    }
   ],
