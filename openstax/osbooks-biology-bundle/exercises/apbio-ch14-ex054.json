   "stimulus_html": "",
   "stem_html": "What are autonomously replicating sequences (ARS)?",
   "answers": [
    {
     "id": 1020228,
     "content_html": "areas of prokaryotic chromosomes that initiate copying"
    },
    {
     "id": 1020229,
     "content_html": "portions of prokaryotic chromosomes that can be transferred from one organism to another"
    },
    {
     "id": 1020230,
     "content_html": "areas of eukaryotic chromosomes that are equivalent to the origin of replication in <em>E. coli</em>"
    },
    {
     "id": 1020231,
     "content_html": "portions of eukaryotic chromosomes that replicate independent of the parent chromosome"
    }
