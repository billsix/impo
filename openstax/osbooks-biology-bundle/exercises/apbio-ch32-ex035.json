 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp248393600\" class=\"interactive-embedded-reading\" data-label=\"\">\n<div data-type=\"title\">Link to Learning</div>\n<span data-type=\"media\" id=\"fs-idp128208352\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/7a4ba5fa989c7cd75b76f7f28c6eb57c6f05c81d\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idp156844736\">See a dissected cockroach, including a close-up look at its Malpighian tubules, in this <a href=\"https://openstax.org/l/malpighian\" target=\"_blank\" rel=\"noopener nofollow\">video</a>.</p>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 535071,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are Malpighian tubules and which organism possesses them?",
   "answers": [
    {
     "id": 1046794,
     "content_html": "Malpighian tubules are the tubules within a nephron in humans."
    },
    {
     "id": 1046795,
     "content_html": "Malpighian tubules are the opening of the digestive sac in box jellyfish."
    },
    {
     "id": 1046796,
     "content_html": "Malpighian tubules are organs that filter waste from hemolymph in cockroaches."
    },
    {
     "id": 1046797,
     "content_html": "Malpighian tubules are tiny, bulb-shaped organs that open to an excretory pore in leeches."
    }
   ],
