 "questions": [
  {
   "id": 548610,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Researchers have been able to develop a variety of anti-HIV drugs, such as the drug AZT. How does the drug AZT work?",
   "answers": [
    {
     "id": 1077987,
     "content_html": "AZT blocks the enzyme called HIV protease, which the virus uses to reproduce itself."
    },
    {
     "id": 1077988,
     "content_html": "AZT blocks the HIV integrase enzyme, which the virus uses to insert its viral DNA into the DNA of the host cell."
    },
    {
     "id": 1077989,
     "content_html": "AZT prevents reverse transcriptase and HIV protease enzyme from functioning inside the body."
    },
    {
     "id": 1077990,
     "content_html": "AZT prevents reverse transcriptase from making DNA from the viral RNA genome."
    }
   ],
