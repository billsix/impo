 "questions": [
  {
   "id": 531054,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/716eb68e29850d0d.jpg\" alt=\"\">\n(credit: modification of work by Tinker, M.T., et al./<i>Journal Wildlife Management</i>)\n</figure>",
   "stem_html": "<p>This graph shows the population of sea otters in a location in Alaska.</p>\n<p>What would you expect the population to be in 2020 based on this graph?</p>",
   "answers": [
    {
     "id": 1039532,
     "content_html": "About 30,000, which is the probable carrying capacity for otters in this region."
    },
    {
     "id": 1039533,
     "content_html": "Below 26,000, because the otter population has risen above the carrying capacity in 2010."
    },
    {
     "id": 1039534,
     "content_html": "Close to 40,000 because the otters are experiencing an exponential growth curve."
    },
    {
     "id": 1039535,
     "content_html": "About 26,000, because it is unlikely the otter population can grow beyond this number."
    }
   ],
