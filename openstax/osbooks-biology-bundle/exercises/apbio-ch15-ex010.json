 "questions": [
  {
   "id": 639742,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When comparing transcription of heritable information in prokaryotes and eukaryotes, which events are the same?",
   "answers": [
    {
     "id": 1246499,
     "content_html": "Transcription by polymerase, recognition of a consensus sequence in the promoter, and termination by a hairpin loop are conserved."
    },
    {
     "id": 1246498,
     "content_html": "Translation by polymerase, recognition of a consensus sequence in the promoter, and termination by a hairpin loop are conserved."
    },
    {
     "id": 1246497,
     "content_html": "Transcription by polymerase, recognition of a highly variable sequence in the promoter, and termination by a hairpin loop are conserved."
    },
    {
     "id": 1246496,
     "content_html": "Transcription by polymerase, recognition of a consensus sequence in the promoter, and elongation by a hairpin loop are conserved."
    }
   ],
