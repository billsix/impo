 "questions": [
  {
   "id": 242460,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/518702af0e450a91.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Fred Van Dyke and Rachel L. Lamb/SpringerLink)</figcaption>\n</figure>\n",
   "stem_html": "<p>The graph shows how many species of vascular (more advanced) plants are at each latitude. Latitude is 0° at equator and 90° at each of the two poles.</p>\n<p>Make a claim about this graph.</p>",
   "answers": [
    {
     "id": 759301,
     "content_html": "There are no vascular plants at latitudes above 60°."
    },
    {
     "id": 759300,
     "content_html": "There total biomass of vascular plants decreases as latitude gets higher."
    },
    {
     "id": 759302,
     "content_html": "There are few species of vascular plants that have adapted to living at higher latitudes."
    },
    {
     "id": 759299,
     "content_html": "At higher latitudes, nonvascular plant dominate the environment."
    }
   ],
