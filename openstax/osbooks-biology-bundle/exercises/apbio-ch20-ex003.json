 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp51250272\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"10\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n<span data-type=\"media\" id=\"fs-idp32472192\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/822beac61d5bc8e9e7eaa816354502a7a64b8f9e\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"11\">\n</span>\n<p id=\"fs-idp40663360\">Visit this <a href=\"https://openstaxcollege.org/l/classify_life\" target=\"_blank\" rel=\"noopener nofollow\">website</a> to classify three organisms—bear, orchid, and sea cucumber—from kingdom to species. To launch the game, under Classifying Life, click the picture of the bear or the Launch Interactive button.</p>\n</div>\n</div>\n",
 "stimulus_html": "",
 "questions": [
  {
   "id": 233648,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Using the taxonomic classification system, which Kingdom category best describes a bear?",
   "answers": [
    {
     "id": 724740,
     "content_html": "Plantae: Multicellular organisms that get their energy through photosynthesis."
    },
    {
     "id": 724741,
     "content_html": "Animalia: Multicellular organismsthat get their energy through ingesting other organisms."
    },
    {
     "id": 724739,
     "content_html": "Fungi: Single-celled and multi-celled organisms that get their energy mainly by absorbing nutrients from their surroundings and not through photosynthesis."
    }
   ],
