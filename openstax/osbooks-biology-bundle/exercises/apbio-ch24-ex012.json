 "questions": [
  {
   "id": 520393,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Ectotherms and endotherms have different strategies for generating and maintaining body heat. Explain why ectotherms are more dependent on the environment for body heat than endotherms and how endotherms are able to generate and maintain body temperature.",
   "answers": [
    {
     "id": 1016977,
     "content_html": "Ectotherms use external thermal heat whereas endotherms use metabolically generated heat to help regulate and maintain body temperatures."
    },
    {
     "id": 1016978,
     "content_html": "Ectotherms use external heat to help regulate and maintain body temperatures whereas endotherms have constantly varying internal temperatures."
    },
    {
     "id": 1016979,
     "content_html": "Ectotherms use metabolically-generated heat to maintain a constant body temperature whereas endotherms use metabolically generated heat to regulate body temperature within a wider range."
    },
    {
     "id": 1016980,
     "content_html": "Ectotherms use external thermal energy to help regulate and maintain body temperatures whereas endotherms maintain a constant body temperature."
    }
   ],
