 "questions": [
  {
   "id": 238511,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What does a female contraceptive pill that inhibits the release of GnRH from the hypothalamus do?",
   "answers": [
    {
     "id": 743782,
     "content_html": "reduce the secretion of FSH and LH from the anterior pituitary gland"
    },
    {
     "id": 743780,
     "content_html": "initiate ovulation"
    },
    {
     "id": 743781,
     "content_html": "increase the flow phase of the menstrual cycle"
    },
    {
     "id": 743779,
     "content_html": "increase the production of estrogen and progesterone by the ovaries"
    }
   ],
