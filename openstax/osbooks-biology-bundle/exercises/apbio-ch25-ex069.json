 "questions": [
  {
   "id": 524212,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/fd5ea14490365858.jpg\" alt=\"\">\n(credit: modification of work by Gavião, Maria Beatriz Duarte, &amp; Bilt, Andries Van der/<i>Journal of Applied Oral Science</i>)\n</figure>\n",
   "stem_html": "<p>The table shows the results of a study where people were shown different foods and their saliva production was measured.</p>\n<p>What is a claim we can write from this data?</p>",
   "answers": [
    {
     "id": 1029176,
     "content_html": "Seeing food items triggers saliva production. The nature of the food item does not make a lot of difference in how much saliva is produced."
    },
    {
     "id": 1029177,
     "content_html": "Seeing food items triggers saliva production. The nature of the food item affects how much saliva is produced greatly."
    },
    {
     "id": 1029178,
     "content_html": "People constantly salivate. Saliva production does not noticeably increase when we see food items."
    },
    {
     "id": 1029179,
     "content_html": "People constantly salivate. Saliva production increases once people start eating, not before."
    }
   ],
