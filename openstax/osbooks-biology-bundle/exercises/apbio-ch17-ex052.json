 "questions": [
  {
   "id": 639819,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can proteomics complement genomics?",
   "answers": [
    {
     "id": 1246798,
     "content_html": "The genes are responsible to produce proteins and this implies that proteomics complements genomics."
    },
    {
     "id": 1246797,
     "content_html": "Genomics is responsible to decide the structure of the proteins, and, thereby, the result of proteomic studies."
    },
    {
     "id": 1246799,
     "content_html": "The genome is constant but the proteome is dynamic as different tissues possess the same genes but express different genes, thereby complementing genomics."
    },
    {
     "id": 1246796,
     "content_html": "The study of genes is incomplete without the study of their respective proteins and thus they complement each other."
    }
   ],
