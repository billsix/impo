  {
   "id": 623768,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/2efe9d6586907cc9.jpg\" alt=\"\">\n(credit: modification of work by Lambert, R./<i>Journal of Applied Microbiology</i>)\n</figure>",
   "stem_html": "<p>This image shows the growth rate of some types of bacteria in different pH values.</p>\n<p>Based on this image, and keeping in mind the skin forms a barrier against many types of bacteria, make a claim about the likely values for skin's pH.</p>",
   "answers": [
    {
     "id": 1196599,
     "content_html": "A neutral pH of 7.0."
    },
    {
     "id": 1196598,
     "content_html": "Around 6.5."
    },
    {
     "id": 1196597,
     "content_html": "Between 5.5 and 7.5."
    },
    {
     "id": 1196600,
     "content_html": "More than 7.5 or less than 5.5."
    }
   ],
