 "questions": [
  {
   "id": 640157,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do ingestion and digestion differ?",
   "answers": [
    {
     "id": 1248130,
     "content_html": "Ingestion is taking food in through mouth, where mechanical digestion begins. Chemical digestion begins in the stomach, where food is further broken down into smaller molecules that can be absorbed and used by the body."
    },
    {
     "id": 1248131,
     "content_html": "Ingestion is the process of taking in food through the mouth, where mechanical and chemical digestion begins to break down the food into smaller molecules that can be absorbed and used by the body."
    },
    {
     "id": 1248129,
     "content_html": "Ingestion is taking food in through the mouth, where mechanical and chemical digestion begins. Digestion in the stomach breaks down proteins and fats present in food into smaller molecules that can be absorbed and used by the body."
    },
    {
     "id": 1248128,
     "content_html": "Ingestion is the transfer of food from the mouth to the esophagus, where mechanical and chemical digestion begin to break down the food into smaller molecules that can be absorbed and used by the body."
    }
   ],
