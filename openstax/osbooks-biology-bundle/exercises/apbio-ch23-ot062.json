 "questions": [
  {
   "id": 241442,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A botanist compares the number of stomata between two plants. The first plant, a eucalyptus, has stomata equally distributed on both sides of the leaf. The second plant has most of its stomata on the underside of the leaf. Comparing the leaves, evaluate what the positioning of the stomata indicates about which leaf surfaces on the two plants receive light in their natural environment.",
   "answers": [
    {
     "id": 755230,
     "content_html": "The first plant receives light only on the upper surface of the leaves, whereas the leaves of the second plant are equally exposed to sunlight."
    },
    {
     "id": 755229,
     "content_html": "The first plant receives light only on the lower surface, whereas the second plant receives light only on the upper surface."
    },
    {
     "id": 755228,
     "content_html": "The first plant receives light only on the upper surface, whereas the second plant receives light only on the lower surface."
    },
    {
     "id": 755231,
     "content_html": "The first plant has leaves that are equally exposed to sunlight, whereas the second plant receives light only on the upper surface."
    }
   ],
