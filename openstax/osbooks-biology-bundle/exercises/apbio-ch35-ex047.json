 "questions": [
  {
   "id": 535733,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Corals have a mutualistic relationship with photosynthetic algae in the photic zones of water. What purpose does this serve?",
   "answers": [
    {
     "id": 1049217,
     "content_html": "Corals are able to derive their nutrition from the algae and thus survive in the nutritionally poor water."
    },
    {
     "id": 1049218,
     "content_html": "Corals are able to accumulate calcium carbonate from the algae."
    },
    {
     "id": 1049219,
     "content_html": "They can form coral reefs because of this association."
    },
    {
     "id": 1049220,
     "content_html": "The corals provide protection to the algae."
    }
   ],
