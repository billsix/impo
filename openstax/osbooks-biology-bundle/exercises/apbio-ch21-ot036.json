 "context": "<figure id=\"fig-ch21_04_01\" class=\" \"><span data-type=\"media\" id=\"fs-idp95920944\" data-alt=\"Part a illustrates how normal prion protein (PRP) is converted into the disease-causing form (PRP). PRPsc may spontaneously form in brain tissue, may be introduced when a mutant form of the protein misfolds, or may introduced into the brain tissue by inoculation. The misfolded protein causes normal PRP already present in the brain to misfold. A chain reaction occurs, leading to a large amount of misfolded protein.\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/de5c288ea9f9bbf9e14f4a41341347607d61ade7\" data-media-type=\"image/jpg\" alt=\"Part a illustrates how normal prion protein (PRP) is converted into the disease-causing form (PRP). PRPsc may spontaneously form in brain tissue, may be introduced when a mutant form of the protein misfolds, or may introduced into the brain tissue by inoculation. The misfolded protein causes normal PRP already present in the brain to misfold. A chain reaction occurs, leading to a large amount of misfolded protein.\" width=\"550\" height=\"232\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 548829,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Review the image of a prion and the brain tissue  that it has infected. Apply your understanding of prions to select the best answer to the following: Why is the transmission of a prion not reliant upon genes made of DNA or RNA?",
   "answers": [
    {
     "id": 1078353,
     "content_html": "DNA or RNA, though present, is not transmitted when a prion causes infection."
    },
    {
     "id": 1078354,
     "content_html": "The prion does not contain any DNA or RNA."
    },
    {
     "id": 1078355,
     "content_html": "Only parts of DNA or RNA are transmitted in a prion."
    },
    {
     "id": 1078356,
     "content_html": "Far more protein than DNA or RNA is transmitted in a prion."
    }
   ],
