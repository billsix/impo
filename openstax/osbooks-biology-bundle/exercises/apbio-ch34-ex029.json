  {
   "id": 238490,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is an oocyte released from a human ovary so it can enter the oviduct?",
   "answers": [
    {
     "id": 743697,
     "content_html": "the beating action of the flagellum on the oocyte"
    },
    {
     "id": 743698,
     "content_html": "the force of the follicular ejection directing the oocyte into the oviduct"
    },
    {
     "id": 743696,
     "content_html": "the wavelike beating of cilia lining the oviduct"
    },
    {
     "id": 743695,
     "content_html": "muscular contraction of the ovaries"
    }
