 "questions": [
  {
   "id": 513276,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The gas nitric oxide has been identified as a signaling molecule. Which of the following mechanisms of action would you expect from a gaseous molecule?",
   "answers": [
    {
     "id": 1004708,
     "content_html": "It binds to a G-protein-linked receptor."
    },
    {
     "id": 1004709,
     "content_html": "It binds to a receptor tyrosine kinase."
    },
    {
     "id": 1004710,
     "content_html": "It binds to a gated ion channel."
    },
    {
     "id": 1004711,
     "content_html": "It binds to an intracellular receptor."
    }
   ],
