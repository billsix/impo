   "id": 529759,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Serum is used to diagnose and monitor diseases, and it is also used to classify blood types. Which of the following statements best describes serum?",
   "answers": [
    {
     "id": 1036972,
     "content_html": "It is a liquid consisting of 90% water and has coagulation factors."
    },
    {
     "id": 1036973,
     "content_html": "It is plasma without the coagulation factors."
    },
    {
     "id": 1036974,
     "content_html": "Serum is only made of albumin."
    },
    {
     "id": 1036975,
     "content_html": "Serum is the same substance as interstitial fluid."
    }
   ],
