   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements regarding early embryonic stages is false?",
   "answers": [
    {
     "id": 1011390,
     "content_html": "The endoderm, mesoderm, and ectoderm are germ layers."
    },
    {
     "id": 1011391,
     "content_html": "The trophoblast is a germ layer."
    },
    {
     "id": 1011392,
     "content_html": "The inner cell mass is a source of embryonic stem cells."
    },
    {
     "id": 1011393,
     "content_html": "The blastula is often a hollow ball of cells."
    }
