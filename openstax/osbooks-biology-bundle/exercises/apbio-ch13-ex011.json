 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id2571351\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-id1876100\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/a6f3a05ebf82fb6b430bb089db6a8b9730115f03\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-id2491521\">Visualize the addition of a chromosome that leads to Down syndrome in this <a href=\"https://openstaxcollege.org/l/down_syndrome\" target=\"_blank\" rel=\"noopener nofollow\">video simulation</a>.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 504403,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A woman's risk of having a baby with a chromosomal abnormality such as Down syndrome increases with her increasing age. From the options given, make a claim  that explains the specific biological consequences of age that make it a risk factor.",
   "answers": [
    {
     "id": 992201,
     "content_html": "Cells are more likely to make mistakes as humans age due to an increase in the nondisjunction of cells during cell division."
    },
    {
     "id": 992202,
     "content_html": "The chance of this type of disorder increases with age due to increased mistakes in the mitotic cells."
    },
    {
     "id": 992203,
     "content_html": "There are increased risks of translocation mutations with age, even though other mutation rates are constant, and this increases the risk."
    },
    {
     "id": 992204,
     "content_html": "The risk of having a child with Down syndrome is associated primarily with lifestyle factors that change with age."
    }
   ],
