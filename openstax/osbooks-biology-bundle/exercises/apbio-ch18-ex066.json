 "questions": [
  {
   "id": 663478,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is false?",
   "answers": [
    {
     "id": 1320689,
     "content_html": "Gradual speciation and punctuated equilibrium both result in the divergence of species."
    },
    {
     "id": 1320690,
     "content_html": "Punctuated equilibrium is most likely to occur in a large population in a stable environment."
    },
    {
     "id": 1320691,
     "content_html": "In the punctuated equilibrium model, gradualism is not excluded."
    },
    {
     "id": 1320692,
     "content_html": "In the gradual speciation model, traits change incrementally."
    }
   ],
