 "questions": [
  {
   "id": 535524,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/42cf8b3e2a03a163.jpg\" alt=\"The illustration shows bacterial toxins encountering a host cell with toxin receptors. It then shows antibodies bound in complex to the toxins outside of the host cell.\"></p>\n<p>The diagram illustrates a process taking place during an immune response.</p>\n<p>Which option describes what is happening in this diagram?</p>\n",
   "answers": [
    {
     "id": 1048392,
     "content_html": "The antibodies bind to bacteria, preventing them from dividing."
    },
    {
     "id": 1048393,
     "content_html": "The antibodies bind to bacteria, facilitating their consumption by a macrophage."
    },
    {
     "id": 1048394,
     "content_html": "The antibodies bind to toxic molecules released by bacteria, preventing them from entering cells."
    },
    {
     "id": 1048395,
     "content_html": "The antibodies bind to toxic molecules released by bacteria, stopping their movement through the body."
    }
   ],
