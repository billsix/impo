 "questions": [
  {
   "id": 495749,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You have been identifying the sequence of a segment of a protein. The sequence to date is: leucine-methionine-tyrosine-alanine-glutamine-lysine-glutamate. You insert arginine between the leucine and methionine. What effect would this have on the segment?",
   "answers": [
    {
     "id": 978394,
     "content_html": "Arginine is a negatively charged amino acid and could attach to the glutamate at the end of the segment"
    },
    {
     "id": 978395,
     "content_html": "Inserting arginine places a positively charged amino acid in a portion that is non-polar, creating the possibility of a hydrogen bond in this area."
    },
    {
     "id": 978396,
     "content_html": "There would be no effect other than an additional amino acid."
    },
    {
     "id": 978397,
     "content_html": "The arginine could attach to the lysine and bend the protein chain at this point."
    }
   ],
   "hints": [],
