 "questions": [
  {
   "id": 669434,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Mitochondria are observed in plant cells that contain chloroplasts. Why do you find mitochondria in photosynthetic tissue?",
   "answers": [
    {
     "id": 1334431,
     "content_html": "Mitochondria are not needed but are an evolutionary relic."
    },
    {
     "id": 1334432,
     "content_html": "Mitochondria and chloroplasts work together to use light energy to make sugars."
    },
    {
     "id": 1334433,
     "content_html": "Mitochondria participate in the Calvin cycle/light independent reactions of photosynthesis."
    },
    {
     "id": 1334434,
     "content_html": "Mitochondria are required to break down sugars and other materials for energy."
    }
   ],
