 "questions": [
  {
   "id": 639752,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which step in the transcription of eukaryotic RNA differs the most from its prokaryotic counterpart?",
   "answers": [
    {
     "id": 1246538,
     "content_html": "The initiation step in eukaryotes requires an initiation complex with enhancers and transcription factors. Also, the separation of the DNA strand is different as histones are involved."
    },
    {
     "id": 1246537,
     "content_html": "The initiation step in prokaryotes requires an initiation complex with enhancers and transcription factors. Also, the separation of the DNA strand is different as histones are involved."
    },
    {
     "id": 1246536,
     "content_html": "The elongation step in eukaryotes requires an initiation complex with enhancers and transcription factors. Also, the separation of the DNA strand is different as histones are involved."
    },
    {
     "id": 1246535,
     "content_html": "The initiation step in eukaryotes requires an initiation complex with enhancers and transcription factors. Also, the separation of the DNA strand is different as histones are not involved."
    }
   ],
