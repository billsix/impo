  {
   "id": 503153,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>What property of carbon makes it essential for organic life?</p>\n",
   "answers": [
    {
     "id": 988743,
     "content_html": "Carbon can form up to four covalent bonds, allowing it to form carbon chains."
    },
    {
     "id": 988744,
     "content_html": "Carbon can form more than four covalent bonds, allowing it to form carbon chains."
    },
    {
     "id": 988745,
     "content_html": "Carbon can form more than four covalent bonds, but can only form short chains."
    },
    {
     "id": 988746,
     "content_html": "Carbon can form up to four covalent bonds, but can only form short chains."
    }
