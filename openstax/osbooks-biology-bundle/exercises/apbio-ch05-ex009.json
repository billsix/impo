   "id": 503739,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "One type of mutation in the CFTR protein prevents the transport of chloride ions through the channel. Which of the following is most likely to be observed in the lungs of patients with this mutation?",
   "answers": [
    {
     "id": 990323,
     "content_html": "dehydrated epithelial cells"
    },
    {
     "id": 990324,
     "content_html": "dehydrated mucus"
    },
    {
     "id": 990325,
     "content_html": "mucus with excess water"
    },
    {
     "id": 990326,
     "content_html": "mucus with high electrolyte concentration"
    }
   ],
