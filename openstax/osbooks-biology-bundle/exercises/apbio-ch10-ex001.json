 "questions": [
  {
   "id": 507626,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is nucleosome formation required for the packaging of DNA?",
   "answers": [
    {
     "id": 994656,
     "content_html": "Nucleosome formation results in compaction of the DNA to form chromatin."
    },
    {
     "id": 994657,
     "content_html": "Nucleosome formation results in DNA synthesis."
    },
    {
     "id": 994658,
     "content_html": "Nucleosome formation decreases the number of introns in DNA."
    },
    {
     "id": 994659,
     "content_html": "Nucleosome formation increases the number of introns in the DNA."
    }
   ],
