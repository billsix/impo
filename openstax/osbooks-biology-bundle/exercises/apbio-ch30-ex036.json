 "questions": [
  {
   "id": 529613,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is it more important to have a detector for carbon monoxide than other household gases, such as ammonia or natural gas?",
   "answers": [
    {
     "id": 1036492,
     "content_html": "Because carbon monoxide is tasteless and has a light odor, which is detected very late in exposure."
    },
    {
     "id": 1036493,
     "content_html": "Because carbon monoxide has a stronger odor, making it more unpleasant and dangerous."
    },
    {
     "id": 1036494,
     "content_html": "Because carbon monoxide is odorless and tasteless, unlike ammonia and household natural gas which have distinct smells."
    },
    {
     "id": 1036495,
     "content_html": "Because carbon monoxide should not be present in the environment at all."
    }
   ],
