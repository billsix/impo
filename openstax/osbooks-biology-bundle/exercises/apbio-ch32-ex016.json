   "stem_html": "Which of the following statements about the nephron is false?",
   "answers": [
    {
     "id": 861845,
     "content_html": "The collecting duct empties into the distal convoluted tubule."
    },
    {
     "id": 861842,
     "content_html": "The Bowman’s capsule surrounds the glomerulus."
    },
    {
     "id": 861843,
     "content_html": "The loop of Henle is between the proximal and distal convoluted tubules."
    },
    {
     "id": 861844,
     "content_html": "The loop of Henle empties into the distal convoluted tubule."
    }
