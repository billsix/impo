 "questions": [
  {
   "id": 513304,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In addition to a plasma membrane, a eukaryotic cell has organelles, such as mitochondria, that also have membranes. In which way would these membranes differ?",
   "answers": [
    {
     "id": 1004810,
     "content_html": "The proportion of phosphate within the phospholipids will vary."
    },
    {
     "id": 1004811,
     "content_html": "Only certain membranes contain phospholipids."
    },
    {
     "id": 1004812,
     "content_html": "Only certain membranes are selectively permeable."
    },
    {
     "id": 1004813,
     "content_html": "The proportions of proteins, lipids, and carbohydrates will vary."
    }
   ],
