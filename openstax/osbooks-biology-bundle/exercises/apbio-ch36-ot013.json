 "questions": [
  {
   "id": 242550,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A pond ecosystem in an open field begins to be shaded by the growth of trees around its perimeter. Predict changes in this pond after the trees grow large enough to completely shade the pond.",
   "answers": [
    {
     "id": 759662,
     "content_html": "The population sizes of all organisms will decrease in response to lower energy flowing into the pond."
    },
    {
     "id": 759661,
     "content_html": "The population densities of all organisms will increase in response to lower temperatures in the pond."
    },
    {
     "id": 759660,
     "content_html": "The population distributions of large organisms will shift from clumped to random in response to lower energy flowing into the pond."
    },
    {
     "id": 759659,
     "content_html": "The population distributions of small organisms will shift from uniform to clumped in response to lower temperatures in the pond."
    }
   ],
