 "questions": [
  {
   "id": 530254,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe an analogous structure.",
   "answers": [
    {
     "id": 1037376,
     "content_html": "A penguin and a seagull both have wings. The penguin uses wings to swim while the seagull uses wings to fly."
    },
    {
     "id": 1037377,
     "content_html": "Lizards and whales have similar skeleton structures, but they have a different habitat and lifestyle."
    },
    {
     "id": 1037378,
     "content_html": "Birds and butterflies have wings with similar characteristics for flight even though their wings do not share an evolutionary relationship."
    },
    {
     "id": 1037379,
     "content_html": "The bone structure in leg of a cat is very similar to the bone structure in the arm of a human, but the functions of the limbs are very different."
    }
   ],
