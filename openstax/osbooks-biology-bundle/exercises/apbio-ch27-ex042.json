 "questions": [
  {
   "id": 535897,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The moon has less gravity than Earth. How might this affect vestibular sensation of an astronaut on the Moon?",
   "answers": [
    {
     "id": 1049867,
     "content_html": "Vestibular sensation relies on gravity’s effects to function properly. At a different gravity, the perception of motion would be different."
    },
    {
     "id": 1049868,
     "content_html": "Vestibular sensation does not rely on gravity’s effects, but requires pressure. Inside a pressurized suit, the astronaut would not feel any different."
    },
    {
     "id": 1049869,
     "content_html": "Vestibular sensation cannot function without Earth's gravity. On the Moon, astronauts would need to function completely without it."
    },
    {
     "id": 1049870,
     "content_html": "Vestibular sensation function with better efficiency in lower gravity. On the Moon, the astronauts senses would be enchanced."
    }
   ],
