  {
   "id": 545237,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Blood pressure and blood volume are increased by the production of the hormones antidiuretic hormone (ADH) and aldosterone. Describe how renin promotes release of ADH and aldosterone.",
   "answers": [
    {
     "id": 1070261,
     "content_html": "Renin cleaves angiotensinogen."
    },
    {
     "id": 1070262,
     "content_html": "Renin directly simulates ADH and aldosterone production."
    },
    {
     "id": 1070263,
     "content_html": "Renin produces angiotensin II."
    },
    {
     "id": 1070264,
     "content_html": "Angiotensin I is converted to angiotensin II."
    }
   ],
