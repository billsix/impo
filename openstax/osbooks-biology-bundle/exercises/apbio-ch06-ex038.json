 "questions": [
  {
   "id": 503107,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the position of the transition state on a vertical energy scale, from low to high, relative to the position of the reactants and products, for both endergonic and exergonic reactions.",
   "answers": [
    {
     "id": 988559,
     "content_html": "The transition state of the reaction exists at a lower energy level than the reactants. Activation energy is always positive regardless of whether the reaction is exergonic or endergonic."
    },
    {
     "id": 988560,
     "content_html": "The transition state of the reaction exists at a higher energy level than the reactants. Activation energy is always positive regardless of whether the reaction is exergonic or endergonic."
    },
    {
     "id": 988561,
     "content_html": "The transition state of the reaction exists at a lower energy level than the reactants. Activation energy is always negative regardless of whether the reaction is exergonic or endergonic."
    },
    {
     "id": 988562,
     "content_html": "The transition state of the reaction exists at an intermediate energy level than that of the reactants. Activation energy is always positive regardless of whether the reaction is exergonic or endergonic."
    }
   ],
