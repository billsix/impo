  {
   "id": 242602,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how climate change might lead to a decrease in one population’s carrying capacity and an increase in the carrying capacity of a different population.",
   "answers": [
    {
     "id": 759867,
     "content_html": "Plant species that are drought-resistant would decline in warm temperatures whereas other species would thrive in number in such a climate."
    },
    {
     "id": 759868,
     "content_html": "Plant species that are pest-resistant would thrive in warm temperatures whereas other species would decline in number in such a climate."
    },
    {
     "id": 759869,
     "content_html": "Plant species that are drought-resistant would decline in cold temperatures whereas other species would thrive in number in such a climate."
    },
    {
