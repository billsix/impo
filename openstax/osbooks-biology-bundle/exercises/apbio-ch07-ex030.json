   "stimulus_html": "",
   "stem_html": "What would be the outcome if hydrogen ions were able to diffuse through the mitochondrial membrane into the mitochondria without the need for integral membrane proteins?",
   "answers": [
    {
     "id": 720602,
     "content_html": "ATP would not be produced."
    },
    {
     "id": 720601,
     "content_html": "Pyruvate would not be produced."
    },
    {
     "id": 720600,
     "content_html": "Citric acid would not be produced."
    },
    {
     "id": 720599,
     "content_html": "Carbon dioxide would not be produced."
    }
