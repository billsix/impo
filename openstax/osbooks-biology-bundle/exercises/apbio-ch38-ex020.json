 "questions": [
  {
   "id": 531876,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The Svalbard Global Seed Vault is located on Spitsbergen island in Norway, which has an arctic climate. Why might an arctic climate be good for seed storage?",
   "answers": [
    {
     "id": 1040420,
     "content_html": "Such severe climatic conditions don’t let seeds dry out; they retain water and remain viable."
    },
    {
     "id": 1040421,
     "content_html": "The ground is permanently frozen, so the seeds will be kept at 10°C even if the electricity fails."
    },
    {
     "id": 1040422,
     "content_html": "Because such a climate extends the dormancy periods of seeds to more than what is normal."
    },
    {
     "id": 1040423,
     "content_html": "Because the ground is permanently frozen, the seeds will be kept below 0°C even if electricity fails."
    }
   ],
