 "questions": [
  {
   "id": 233355,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A researcher wants to study cancer cells from a patient with breast cancer. Is cloning the cancer cells an option?",
   "answers": [
    {
     "id": 723565,
     "content_html": "The cancer cells should be cloned along with a biomarker for better detection and study."
    },
    {
     "id": 723564,
     "content_html": "The cells should be screened first in order to assure their carcinogenic nature."
    },
    {
     "id": 723566,
     "content_html": "The cancer cells, being clones of each other already, should directly be grown in a culture media and then studied."
    },
    {
     "id": 723563,
     "content_html": "The cancer cells should be extracted using the specific antibodies."
    }
   ],
