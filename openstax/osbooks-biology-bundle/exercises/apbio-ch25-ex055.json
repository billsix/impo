   "stimulus_html": "",
   "stem_html": "In protein digestion, what happens in the stomach?",
   "answers": [
    {
     "id": 1028956,
     "content_html": "Aminopeptidase and dipeptidase break peptides into amino acids."
    },
    {
     "id": 1028957,
     "content_html": "Pepsin breaks proteins into peptides."
    },
    {
     "id": 1028958,
     "content_html": "Trypsin, elastase, and chymotrypsin break proteins into peptides."
    },
    {
     "id": 1028959,
     "content_html": "Carboxypeptidase breaks peptides into amino acids and peptides."
    }
   ],
