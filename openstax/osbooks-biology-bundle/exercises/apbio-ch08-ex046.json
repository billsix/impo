 "questions": [
  {
   "id": 232712,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Carbon, in the form of CO<sub>2</sub>, must be taken from the atmosphere and attached to an existing organic molecule in the Calvin cycle. Therefore, the carbon is bound to the molecule. The products of the cycle only occur because of the added carbon. What are the products of the Calvin cycle and what is regenerated?",
   "answers": [
    {
     "id": 720994,
     "content_html": "The product of the Calvin cycle is glyceraldehyde-3 phosphate and RuBP is regenerated."
    },
    {
     "id": 720993,
     "content_html": "The product of the Calvin cycle is glyceraldehyde-3 phosphate and RuBisCO is regenerated."
    },
    {
     "id": 720992,
     "content_html": "The product of the Calvin cycle is a 3-PGA molecule and glyceraldehyde-3 phosphate is regenerated."
    },
    {
     "id": 720991,
     "content_html": "The product of the Calvin cycle is glyceraldehyde-3 phosphate and oxygen is regenerated."
    }
   ],
