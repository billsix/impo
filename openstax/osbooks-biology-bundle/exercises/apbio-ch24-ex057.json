 "questions": [
  {
   "id": 520443,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is hibernation not a good option for small animals like the hummingbirds to help reduce its metabolic rate and conserve its need for food?",
   "answers": [
    {
     "id": 1017177,
     "content_html": "Hummingbirds have a fast metabolic rate and a large surface area to volume ratio."
    },
    {
     "id": 1017178,
     "content_html": "Hummingbirds are unable to lower their metabolic rate and body temperature to enter hibernation."
    },
    {
     "id": 1017179,
     "content_html": "Hummingbirds migrate south for the winter."
    },
    {
     "id": 1017180,
     "content_html": "Hummingbirds live a short life."
    }
   ],
