 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp21663728\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"5\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n<span data-type=\"media\" id=\"fs-idp95692752\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/57736625d32526ed8d5935195ec23b844d29ae4b\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"6\">\n</span>\n<p id=\"fs-idm44792448\">Head to this <a href=\"https://openstaxcollege.org/l/tree_of_life\" target=\"_blank\" rel=\"noopener nofollow\">website</a> to see interactive exercises that allow you to explore the evolutionary relationships among species.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 639857,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the main function of the ITOL (Interactive Tree of Life) website?",
   "answers": [
    {
     "id": 1246946,
     "content_html": "iTOL is a website that provides the history about the Tree of Life."
    },
    {
     "id": 1246945,
     "content_html": "iTOL is a website that provides guidelines for researching data to create a phylogenetic tree."
    },
    {
     "id": 1246947,
     "content_html": "iTOL is an online tool that provides the display and manipulation of pre-computed phylogenetic trees, and you can upload and display your own trees and data."
    },
    {
     "id": 1246944,
     "content_html": "iTOL is a website that explains the evolutionary relationships among species."
    }
   ],
