   "stimulus_html": "",
   "stem_html": "Which of the following is true of light detection?",
   "answers": [
    {
     "id": 1069393,
     "content_html": "Humans see most of the light spectrum."
    },
    {
     "id": 1069394,
     "content_html": "Light signals can pass through a vacuum into the eye."
    },
    {
     "id": 1069395,
     "content_html": "Decibels are used as the unit of wavelength."
    },
    {
     "id": 1069396,
     "content_html": "Violet light has a longer wavelength than red light."
    }
