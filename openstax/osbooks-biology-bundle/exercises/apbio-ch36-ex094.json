 "questions": [
  {
   "id": 242683,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Workers wear a special costume when interacting with whooping crane chicks. Justify the need for this process.",
   "answers": [
    {
     "id": 760193,
     "content_html": "Whooping crane chicks undergo habituation in which the chicks make a bond with the objects they see in the environment. Therefore, workers must wear a special costume to fool each chick into thinking it is associating with an adult whooping crane."
    },
    {
     "id": 760194,
     "content_html": "Whooping crane chicks undergo imprinting with the first object they see. Therefore, workers must wear a special costume to fool each chick into thinking it is associating with an adult whooping crane to avoid creating the expectation it will mate with a human."
    },
    {
     "id": 760192,
     "content_html": "Whooping crane chicks undergo imprinting with the first animal that feeds them. Therefore, workers must wear a special costume to fool each chick into thinking it is associating with an adult whooping crane to avoid creating the expectation that it will mate with a human."
    },
    {
     "id": 760191,
     "content_html": "Whooping cranes undergo habituation in which the chicks only make a bond with the first object they see. The young chicks only trust that first object to feed them. Thus workers must wear a special costume to fool the chick into thinking it is associating with an adult whooping crane."
    }
   ],
