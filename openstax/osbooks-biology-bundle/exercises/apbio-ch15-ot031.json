 "questions": [
  {
   "id": 511831,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A tRNA is chemically modified so that the amino acid bound is different than the one specified by its anticodon. Which codon in the mRNA would the tRNA recognize: the one specified by its anticodon or the one that matches the modified amino acid it carries?",
   "answers": [
    {
     "id": 1000962,
     "content_html": "The anticodon will match the codon in mRNA."
    },
    {
     "id": 1000963,
     "content_html": "The anticodon will match with the modified amino acid it carries."
    },
    {
     "id": 1000964,
     "content_html": "The anticodon will lose the specificity for the tRNA molecule."
    },
    {
     "id": 1000965,
     "content_html": "The enzyme amino acyl tRNA synthetase would lose control over the amino acid."
    }
   ],
