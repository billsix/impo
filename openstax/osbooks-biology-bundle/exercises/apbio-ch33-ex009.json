  {
   "id": 535159,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the function of major histocompatibility class (MHC) I molecules?",
   "answers": [
    {
     "id": 1047144,
     "content_html": "MHC I molecules assist with strengthening the cell membrane."
    },
    {
     "id": 1047145,
     "content_html": "MHC I molecules present antigens on the surface of a cell."
    },
    {
     "id": 1047146,
     "content_html": "MHC I molecules allow movement of materials across the cell membrane."
    },
    {
     "id": 1047147,
     "content_html": "MHC I molecules provide signals for processes involved in cell division."
    }
   ],
