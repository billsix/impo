   "stimulus_html": "",
   "stem_html": "Which hormone elicits the “fight or flight” response, and under which circumstance is it released?",
   "answers": [
    {
     "id": 1047002,
     "content_html": "anti-diuretic hormone; presence of alcohol in the blood"
    },
    {
     "id": 1047003,
     "content_html": "atrial natriuretic peptide; high blood pressure"
    },
    {
     "id": 1047004,
     "content_html": "aldosterone; low water content in the blood"
    },
    {
     "id": 1047005,
     "content_html": "epinephrine; extreme stress"
