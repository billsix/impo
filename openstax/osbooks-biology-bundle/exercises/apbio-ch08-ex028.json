 "questions": [
  {
   "id": 232694,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Applying your understanding of how processes of photosynthesis are connected, select the best description of the electron transfer pathway from photosynthesis II to photosynthesis I in the light-dependent reactions.",
   "answers": [
    {
     "id": 720921,
     "content_html": "After splitting water in PS-I, high-energy electrons are delivered through the chloroplast electron transport chain to PS-II."
    },
    {
     "id": 720920,
     "content_html": "After the photosynthesis reaction, released products like glucose help in the transfer of electrons from PS-II to PS-I."
    },
    {
     "id": 720922,
     "content_html": "After splitting water in PS-II, high-energy electrons are delivered through the chloroplast electron transport chain to PS-I."
    },
    {
     "id": 720919,
     "content_html": "After the completion of the light-dependent reactions, the electrons are transferred from PS-II to PS-I."
    }
   ],
