 "questions": [
  {
   "id": 503129,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/f7770c4670b5dd3e.jpg\" alt=\"Table showing the electronegativity of several elements. They are: nitrogen, 3.04. Hydrogen, 2.20. Chlorine, 3.16. Oxygen, 3.44. Lithium, 0.98. Fluorine, 3.98. \"></p>\n\n<p>Based on the information provided in the table, which of the following statements is correct?</p>\n",
   "answers": [
    {
     "id": 988647,
     "content_html": "In NH<sub>3</sub>, the nitrogen atom carries a partial positive charge and the hydrogen atoms acquire a partial negative charge."
    },
    {
     "id": 988648,
     "content_html": "In H<sub>2</sub>O, the hydrogen atoms acquire a partial negative charge, and the oxygen atom carries a partial positive charge."
    },
    {
     "id": 988649,
     "content_html": "In aqueous HCl, the hydrogen atom carries a partial positive charge, and the chlorine atom carries a partial negative charge."
    },
    {
     "id": 988650,
     "content_html": "In LiF, the lithium atom carries a positive charge, and the fluorine atom carries a negative charge."
    }
   ],
