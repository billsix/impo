 "questions": [
  {
   "id": 242298,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/f8f178fc7d06dcbd.jpg\" alt=\"\">\n(credit: modification of work by Shatoor, Prof. Abdullah et al./<i>African Journal of Pharmacy and Pharmacology</i>)\n</figure>",
   "stem_html": "<p>This graph shows the results of an experiment on some rabbits. The rabbits were injected by increasing amounts of epinephrine, shown in the x-axis. The y-axis shows the heart rate of the rabbit.</p>\n<p>What is a claim that can be done from this graph?</p>",
   "answers": [
    {
     "id": 758653,
     "content_html": "Even very small amounts of epinephrine trigger a big response."
    },
    {
     "id": 758654,
     "content_html": "Epinephrine does not have a lot of effect until its concentration reaches a threshold."
    },
    {
     "id": 758652,
     "content_html": "There is no upper limit to the effect of epinephrine."
    },
    {
     "id": 758651,
     "content_html": "Increasing epinephrine decreases the rate of the heart beat."
    }
   ],
