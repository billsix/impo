 "questions": [
  {
   "id": 242179,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/7188a42668c513e7.jpg\" alt=\"\">\n(credit: modification of work by Diaz, Brandon et al./<i>International Journal of Surgery Case Reports</i>)\n</figure>",
   "stem_html": "<p>This image shows the white blood count of a person that was hospitalized with a serious infection.</p>\n<p>What is a claim that can be said based on the image?</p>",
   "answers": [
    {
     "id": 758178,
     "content_html": "The white blood cell count remained consistently high during the hospital stay."
    },
    {
     "id": 758177,
     "content_html": "The white blood cell of a healthy person does not change a lot."
    },
    {
     "id": 758179,
     "content_html": "The white blood cell count peaked at day 3 and gradually went down afterwards."
    },
    {
     "id": 758176,
     "content_html": "The white blood cell count peaked at day 6 and stayed at that level for rest of the hospital stay."
    }
   ],
