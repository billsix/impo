 "questions": [
  {
   "id": 547337,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The ability of rats to learn how to run a maze is an example of cognitive learning. Describe what happens during cognitive learning.",
   "answers": [
    {
     "id": 1074235,
     "content_html": "Cognitive learning is a type of learning that occurs early in an animal’s development when it learns to bond to an object or animal."
    },
    {
     "id": 1074236,
     "content_html": "Cognitive learning occurs when an animal learns to associate a stimulus with a behavior not normally associated with that stimulus."
    },
    {
     "id": 1074237,
     "content_html": "Cognitive learning occurs when an animal learns a behavior in response to a positive stimulus or negative stimulus."
    },
    {
     "id": 1074238,
     "content_html": "Cognitive learning is the most complex type of learning that involves multiple types of brain processes to carry out."
    }
   ],
