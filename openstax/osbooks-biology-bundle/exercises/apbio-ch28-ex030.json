  {
   "id": 241894,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/385101e8a1bfc966.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Jose M Garcia, et al./NCBI, under CC BY 4.0 license)</figcaption>\n</figure>\n",
   "stem_html": "<p>The graph shows the concentration of growth hormone (GH) in younger and older people of both genders.</p>\n<p>Make a claim based on this graph.</p>",
   "answers": [
    {
     "id": 757038,
     "content_html": "GH production is higher in young females, compared to young males."
    },
    {
     "id": 757037,
     "content_html": "In old people, GH production almost completely stops."
    },
    {
     "id": 757039,
     "content_html": "GH production is slightly higher in old males, compared to old females."
    },
    {
     "id": 757036,
     "content_html": "In young people, GH production is high all throughout the day."
    }
   ],
