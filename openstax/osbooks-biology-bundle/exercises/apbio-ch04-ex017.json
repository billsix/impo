 "questions": [
  {
   "id": 504151,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What determines the upper limit of cell size?",
   "answers": [
    {
     "id": 991251,
     "content_html": "Pathogen defense. A very large cell is defenseless against pathogens that are present in every environment."
    },
    {
     "id": 991252,
     "content_html": "Surface area-to-volume ratio. Some organisms, such as slime molds, get around this by instead of having separate cells having a branching cytoplasm with a high surface area-to-volume ratio."
    },
    {
     "id": 991253,
     "content_html": "The van Der Walls forces are insufficient to hold together cell membranes of greater than 500 microns in diameter. Some organisms, such as slime molds, get around this by incorporating G proteins into the plasma membrane."
    },
    {
     "id": 991254,
     "content_html": "Because of the specific gravity of water, the main component of the cytosol, a cell of greater than 500 microns in diameter will collapse in on itself in air, and a cell greater than 300 microns in diameter will collapse in on itself under water."
    }
   ],
