 "questions": [
  {
   "id": 504463,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how forensic scientists are able to use DNA analysis to identify individuals.",
   "answers": [
    {
     "id": 992433,
     "content_html": "Comparison of DNA from a known source or individual with analysis of the sequence of an unknown sample of DNA allows scientists to find out if both of them are similar or not."
    },
    {
     "id": 992434,
     "content_html": "DNA from the unknown sample is sequenced and analyzed. The result of the analysis is then matched with any random population. The matching individual then helps in forensics."
    },
    {
     "id": 992435,
     "content_html": "Comparison of DNA from a known source or individual with analysis of the sequence of bases in strands of an unknown sample of RNA allows scientists to find out if both of them are similar or not."
    },
    {
     "id": 992436,
     "content_html": "Comparison of DNA from a known source or individual with analysis of the sugars and phosphates in strands of an unknown sample of DNA allows scientists to find out if both of them are similar or not."
    }
   ],
