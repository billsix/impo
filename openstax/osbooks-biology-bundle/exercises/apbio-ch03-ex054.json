  {
   "id": 495741,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Vegans are people who do not consume any animal products in their diet. Why do vegans need to pay special attention to the protein they eat?",
   "answers": [
    {
     "id": 978362,
     "content_html": "Plant proteins contain all of the essential as well as non-essential amino acids."
    },
    {
     "id": 978363,
     "content_html": "It is more difficult to obtain all essential amino acids from single plant sources."
    },
    {
     "id": 978364,
     "content_html": "Plant proteins contain only non-essential amino acids."
    },
    {
     "id": 978365,
     "content_html": "Plants proteins do not have all of the non-essential amino acids, but do contain the essential amino acids."
    }
   ],
