 "questions": [
  {
   "id": 511891,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In separating DNA for genomic analysis, evaluate the potential consequences of RNA contaminating the sample during the cell lysis step. What are these consequences, and what consideration should be made, if any, in adjusting the technique?",
   "answers": [
    {
     "id": 1001202,
     "content_html": "DNA separates into the supernatant; no corrective action needed."
    },
    {
     "id": 1001203,
     "content_html": "DNA is destroyed by the protease; RNA and DNA must be isolated during the cell lysis step."
    },
    {
     "id": 1001204,
     "content_html": "DNA is unaffected by the RNA; no corrective action needed."
    },
    {
     "id": 1001205,
     "content_html": "DNA combines with the RNA; RNA and DNA must be isolated during the cell lysis step."
    }
   ],
