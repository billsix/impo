   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement about diseases is false?",
   "answers": [
    {
     "id": 1016547,
     "content_html": "An epidemic is a disease that occurs in a high number of individuals in a population at a time."
    },
    {
     "id": 1016548,
     "content_html": "A pandemic is a widespread, usually worldwide, epidemic."
    },
    {
     "id": 1016549,
     "content_html": "An endemic disease is a disease that is constantly present, usually at high incidence, in a population."
    },
    {
     "id": 1016550,
     "content_html": "An emerging disease is a disease that has appeared in a population for the first time."
    }
