   "id": 535506,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe how the steps of sensory perception would be affected if a person sustains damage to axons that lead from sensory receptors to the central nervous system.",
   "answers": [
    {
     "id": 1048320,
     "content_html": "Reception would not be affected. However, signal transduction and perception will be incomplete."
    },
