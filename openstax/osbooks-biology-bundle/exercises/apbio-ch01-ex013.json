   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are viruses not considered living?",
   "answers": [
    {
     "id": 1245483,
     "content_html": "They are not made of cells."
    },
    {
     "id": 1245482,
     "content_html": "Viruses do not have genetic material."
    },
    {
     "id": 1245481,
     "content_html": "Viruses have DNA and RNA."
    },
    {
     "id": 1245480,
     "content_html": "Viruses are obligate parasites and require a host."
    }
