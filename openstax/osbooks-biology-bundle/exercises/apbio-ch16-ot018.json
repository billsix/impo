   "stimulus_html": "",
   "stem_html": "A mutation in the 5’UTR that prevents any proteins from binding to the region will_____________.",
   "answers": [
    {
     "id": 723466,
     "content_html": "increase or decrease the stability of the RNA molecule"
    },
    {
     "id": 723465,
     "content_html": "prevent translation of the RNA molecule"
    },
    {
     "id": 723464,
     "content_html": "prevent splicing of the RNA molecule"
    },
    {
     "id": 723463,
     "content_html": "increase or decrease the length of the poly-A tail"
    }
