   "id": 546865,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/3d65d0895fbb3194.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Krishnavedala/Wikipedia, under CC BY-SA 3.0 license)</figcaption>\n</figure>\n",
   "stem_html": "<p>This graph shows the pressure-volume relationship of a gas.</p>\n<p>A gas originally occupying 35 units is squeezed in a container half this size. Based on the graph, how will the pressureo of the gas change?</p>",
   "answers": [
    {
     "id": 1072583,
     "content_html": "The pressure will be halved."
    },
    {
     "id": 1072584,
     "content_html": "The pressure will be doubled."
    },
    {
     "id": 1072585,
     "content_html": "The pressure will be one quarter of what it was."
    },
    {
     "id": 1072586,
     "content_html": "The pressure will be four times what it was."
    }
   ],
