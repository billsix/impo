 "questions": [
  {
   "id": 639552,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the structure of a plasmodesma differ from that of a gap junction?",
   "answers": [
    {
     "id": 1245757,
     "content_html": "Gap junctions are essential for transportation in animal cells and plasmodesmata are essential for the movement of substances in plant cells."
    },
    {
     "id": 1245756,
     "content_html": "Gap junctions are found to provide attachment in animal cells and plasmodesmata are essential for attachment of plant cells."
    },
    {
     "id": 1245755,
     "content_html": "Plasmodesmata are essential for communication between animal cells and gap junctions are necessary for attachment of cells in plant cells."
    },
    {
     "id": 1245754,
     "content_html": "Plasmodesmata help in transportation and gap junctions help in attachment, in plant cells."
    }
   ],
