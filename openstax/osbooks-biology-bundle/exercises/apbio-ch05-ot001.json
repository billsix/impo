 "questions": [
  {
   "id": 677238,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "According to the fluid mosaic model of the plasma cell membrane, what is the location of carbohydrates in the cell membranes?",
   "answers": [
    {
     "id": 1346201,
     "content_html": "Carbohydrates are in contact with the aqueous fluid both inside and outside the cell."
    },
    {
     "id": 1346202,
     "content_html": "Carbohydrates are present only on the interior surface of a membrane."
    },
    {
     "id": 1346204,
     "content_html": "Carbohydrates are present only on the exterior surface of a membrane."
    },
    {
     "id": 1346203,
     "content_html": "Carbohydates span only the interior of a membrane."
    }
   ],
