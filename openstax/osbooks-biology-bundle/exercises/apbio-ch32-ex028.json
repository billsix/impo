 "questions": [
  {
   "id": 535053,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the loop of Henle act as a countercurrent multiplier? ",
   "answers": [
    {
     "id": 1046722,
     "content_html": "The descending limb of the loop of Henle is water permeable, so the water flows from the filtrate to the interstitial fluid. Osmolality in the limb decreases, and it is lower inside the loop than in the interstitial fluid. As the filtrate enters the ascending limb, Na<sup>+</sup> and Cl<sup>-</sup>  ions exit through ion channels present in the cell membrane. Further up, only sodium is passively transported out of the filtrate."
    },
    {
     "id": 1046723,
     "content_html": "The descending limb of the loop of Henle is water impermeable, so the water flows from the filtrate to the interstitial fluid. Osmolality in the limb increases, and it is higher inside the loop than in the interstitial fluid. As the filtrate enters the ascending limb, Na<sup>+</sup>  and Cl<sup>-</sup> ions exit through ion channels present in the cell membrane. Further up, only sodium is passively transported out of the filtrate."
    },
    {
     "id": 1046724,
     "content_html": "The descending limb of the loop of Henle is water impermeable, so the water flows from the filtrate to the interstitial fluid. Osmolality in the limb increases, and it is higher inside the loop than in the interstitial fluid. As the filtrate enters the ascending limb, Na<sup>+</sup>  and Cl<sup>-</sup> ions exit through ion channels present in the cell membrane. Further up, sodium is actively transported out of the filtrate, and chlorine ions follow."
    },
    {
     "id": 1046725,
     "content_html": "The descending limb of the loop of Henle is water permeable, so the water flows from the filtrate to the interstitial fluid. Osmolality in the limb increases, and it is higher inside the loop than in the interstitial fluid. As the filtrate enters the ascending limb, Na<sup>+</sup> and Cl<sup>-</sup> ions exit through ion channels present in the cell membrane. Further up, sodium is actively transported out of the filtrate, and chlorine ions follows."
    }
   ],
