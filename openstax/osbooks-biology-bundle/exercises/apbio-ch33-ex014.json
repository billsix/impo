 "questions": [
  {
   "id": 535209,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why might different MHC I molecules between donor and recipient cells lead to rejection of a transplanted organ or tissue?",
   "answers": [
    {
     "id": 1047340,
     "content_html": "The natural killer cells in the recipient will identify the MHC I molecules on transplanted organ as non-self proteins, causing lysis of transplanted cells. Other host cells will join to phagocytize the foreign cells."
    },
    {
     "id": 1047341,
     "content_html": "The neutrophils in the recipient will identify the MHC I molecules on transplanted organ as non-self proteins, causing lysis of transplanted cells. Other host cells will join to phagocytize the foreign cells."
    },
    {
     "id": 1047342,
     "content_html": "B lymphocytes in the recipient will identify the MHC I molecules on transplanted organ as non-self proteins. The foreign cells will then be engulfed and destroyed by B lymphocytes."
    },
    {
     "id": 1047343,
     "content_html": "The macrophages in the recipient will identify the MHC I molecules on transplanted organ as non-self proteins, causing lysis of transplanted cells. Other host cells will join to phagocytize the foreign cells."
    }
   ],
