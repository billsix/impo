   "id": 534666,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about the heart is false?",
   "answers": [
    {
     "id": 1045468,
     "content_html": "The mitral valve separates the left ventricle from the left atrium."
    },
    {
     "id": 1045469,
     "content_html": "Blood travels through the bicuspid valve to the left atrium."
    },
    {
     "id": 1045470,
     "content_html": "Both the aortic and the pulmonary valves are semilunar valves."
    },
    {
     "id": 1045471,
     "content_html": "The mitral valve is an atrioventricular valve."
    }
   ],
