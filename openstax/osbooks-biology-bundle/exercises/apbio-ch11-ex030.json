 "questions": [
  {
   "id": 521488,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is a disadvantage of sexual reproduction over asexual forms of reproduction?",
   "answers": [
    {
     "id": 1019752,
     "content_html": "Half the population is capable of carrying offspring."
    },
    {
     "id": 1019753,
     "content_html": "Identical offspring are not produced."
    },
    {
     "id": 1019754,
     "content_html": "Adaptation to rapidly changing environments is more difficult."
    },
    {
     "id": 1019755,
     "content_html": "Mutation rates are slower."
    }
   ],
