   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe how stress promotes water retention, which can lead to weight gain.",
   "answers": [
    {
     "id": 1070213,
     "content_html": "Stress decreases osmolality, which increases antidiuretic hormone secretion. Antidiuretic hormone helps retain water."
    },
    {
     "id": 1070214,
     "content_html": "Stress increases osmolality, which increases antidiuretic hormone secretion. Antidiuretic hormone helps retain water."
    },
    {
     "id": 1070215,
     "content_html": "Stress increases osmolality, which decreases antidiuretic hormone secretion. Antidiuretic hormone helps with water loss."
    },
