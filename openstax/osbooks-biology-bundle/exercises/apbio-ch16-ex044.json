 "questions": [
  {
   "id": 522282,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In a new cancer treatment, a cold virus is genetically modified so that it binds to, enters, and is replicated in cells, causing them to burst. The modified cold virus cannot replicate when wildtype p53 protein is present in the cell. How does this treatment treat cancer without harming healthy cells?",
   "answers": [
    {
     "id": 1022009,
     "content_html": "The modified virus only infects and enters cancer cells."
    },
    {
     "id": 1022010,
     "content_html": "The modified virus replicates in normal and cancer cells."
    },
    {
     "id": 1022011,
     "content_html": "The modified virus only infects and enters normal cells."
    },
    {
     "id": 1022012,
     "content_html": "The modified virus replicates only in cancer cells."
    }
   ],
