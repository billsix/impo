 "questions": [
  {
   "id": 639610,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What do the electrons added to <span data-math=\"\\text{NAD}^{+} {\\!}\">\\text{NAD}^{+} {\\!}</span> do in aerobic respiration?",
   "answers": [
    {
     "id": 1245982,
     "content_html": "They become part of a fermentation pathway."
    },
    {
     "id": 1245983,
     "content_html": "They go to another pathway for ATP production."
    },
    {
     "id": 1245981,
     "content_html": "They energize the acetyl group in the citric acid cycle."
    },
    {
     "id": 1245980,
     "content_html": "They are converted to NADP."
    }
   ],
