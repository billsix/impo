 "questions": [
  {
   "id": 513456,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are chemoautotrophs not considered the same as photoautotrophs if they both extract energy and make sugars?",
   "answers": [
    {
     "id": 1005418,
     "content_html": "Chemoautotrophs use wavelengths of light not available to photoautotrophs."
    },
    {
     "id": 1005419,
     "content_html": "Chemoautotrophs extract energy from inorganic chemical compounds."
    },
    {
     "id": 1005420,
     "content_html": "Photoautotrophs prefer the blue side of the visible light spectrum."
    },
    {
     "id": 1005421,
     "content_html": "Photoautotrophs make glucose, while chemoautotrophs make galactose."
    }
   ],
