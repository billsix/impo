 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm28058352\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-idp12938736\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/5e7b6037f9bc1391400641f4e8e61df3ea77bb58\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idp101416624\">Watch this 23-second stop-motion <a href=\"https://openstaxcollege.org/l/conidia\" target=\"_blank\" rel=\"noopener nofollow\">video</a> showing a neutrophil that searches for and engulfs fungus spores during an elapsed time of about 79 minutes.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 535145,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the action shown in the video clip (<a href=\"http://openstaxcollege.org/l/conidia\" rel=\"nofollow\" target=\"_blank\">http://openstaxcollege.org/l/conidia</a>) demonstrate an immune response?",
   "answers": [
    {
     "id": 1047088,
     "content_html": "Neutrophils phagocytize pathogens invading the body and release chemical histamines that cause pathogen destruction and removal from the body. This prevents pathogens from producing toxic compounds that harm cells."
    },
    {
     "id": 1047089,
     "content_html": "Neutrophils phagocytize pathogens invading the body, resulting in their death and removal from the body. This prevents pathogens from multiplying or producing toxic compounds that harm human cells."
    },
    {
     "id": 1047090,
     "content_html": "Neutrophils are phagocytic and are the first responders to infection. They produce large quantities of cytokines, which cause pathogen destruction and removal from the body."
    },
    {
     "id": 1047091,
     "content_html": "Neutrophils produce cytokines that help phagocytes to recognize foreign material that will destroy and remove pathogens from the body."
    }
   ],
