  {
   "id": 639626,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What impact, if any, do high levels of ATP have on glycolysis?",
   "answers": [
    {
     "id": 1246042,
     "content_html": "They increase the activity of enzymes involved with glycolysis."
    },
    {
     "id": 1246043,
     "content_html": "The high levels decrease the activity of enzymes involved with glycolysis."
    },
    {
     "id": 1246041,
     "content_html": "They have no effect on the activity of any enzymes involved with glycolysis."
    },
    {
     "id": 1246040,
     "content_html": "The high levels slow down only glycolysis."
    }
