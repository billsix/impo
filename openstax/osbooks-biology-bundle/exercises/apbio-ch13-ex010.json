 "context": "<figure id=\"fig-ch13_02_02\"><span data-type=\"media\" id=\"fs-id1788358\" data-alt=\"This illustration shows nondisjunction that occurs during meiosis I. Nondisjunction during meiosis I occurs when a homologous pair fails to separate, and results in two gametes with n + 1 chromosomes, and two gametes with n − 1 chromosomes. Nondisjunction during meiosis II would occur when sister chromatids fail to separate, and results in one gamete with n + 1 chromosomes, one gamete with n − 1 chromosomes, and two normal gametes.\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/9031516ce352da8522ff3e1014a095cb234b064d\" data-media-type=\"image/jpg\" alt=\"This illustration shows nondisjunction that occurs during meiosis I. Nondisjunction during meiosis I occurs when a homologous pair fails to separate, and results in two gametes with n + 1 chromosomes, and two gametes with n − 1 chromosomes. Nondisjunction during meiosis II would occur when sister chromatids fail to separate, and results in one gamete with n + 1 chromosomes, one gamete with n − 1 chromosomes, and two normal gametes.\" width=\"350\" height=\"360\">\n</span>\n\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 521572,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about nondisjunction is true?",
   "answers": [
    {
     "id": 1020088,
     "content_html": "Nondisjunction only results in gametes with n+1 or n-1 chromosomes."
    },
    {
     "id": 1020089,
     "content_html": "Nondisjunction occurring during meiosis II results in <span data-math=\"50\\%\">50\\%</span> normal gametes."
    },
    {
     "id": 1020090,
     "content_html": "Nondisjunction during meiosis I results in <span data-math=\"50\\%\">50\\%</span> normal gametes."
    },
    {
     "id": 1020091,
     "content_html": "Nondisjunction always results in four different kinds of gametes."
    }
   ],
