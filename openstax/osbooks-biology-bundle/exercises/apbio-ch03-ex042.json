 "questions": [
  {
   "id": 639512,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are three functions that lipids serve in plants and/or animals?",
   "answers": [
    {
     "id": 1245599,
     "content_html": "Lipids serve in the storage of energy, as a structural component of hormones, and also as signaling molecules."
    },
    {
     "id": 1245598,
     "content_html": "Lipids serve in the storage of energy, as carriers for the transport of proteins across the membrane, and as signaling molecules."
    },
    {
     "id": 1245597,
     "content_html": "Lipids serve in the breakdown of stored energy molecules, as signaling molecules, and as structural components of hormones."
    },
    {
     "id": 1245596,
     "content_html": "Lipids serve in the breakdown of stored energy molecules, as signaling molecules, and as channels for protein transport."
    }
   ],
