 "questions": [
  {
   "id": 517454,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Until recently, three species of short-tailed pythons, <em>Python curtus</em>, <em>Python brongersmai</em>, and <em>Python breitensteini</em> were considered one species. However, due to the different locations in which they are found, they have become three distinct species. What is this an example of?",
   "answers": [
    {
     "id": 1011678,
     "content_html": "divergent evolution"
    },
    {
     "id": 1011679,
     "content_html": "sympatric speciation"
    },
    {
     "id": 1011680,
     "content_html": "allopatric speciation"
    },
    {
     "id": 1011681,
     "content_html": "variation"
    }
   ],
