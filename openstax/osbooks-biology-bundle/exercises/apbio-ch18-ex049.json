 "questions": [
  {
   "id": 517334,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which type of speciation, allopatric or sympatric, is more common? Why?",
   "answers": [
    {
     "id": 1011606,
     "content_html": "Allopatric speciation is more common because it prevents gene flow between the species."
    },
    {
     "id": 1011607,
     "content_html": "Allopatric speciation is more common because it involves stronger prezygotic barriers."
    },
    {
     "id": 1011608,
     "content_html": "Sympatric speciation is more common because it prevents gene flow between the species."
    },
    {
     "id": 1011609,
     "content_html": "Sympatric speciation is more common because it involves stronger prezygotic barriers."
    }
   ],
