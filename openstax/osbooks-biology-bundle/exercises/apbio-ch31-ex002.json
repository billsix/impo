 "questions": [
  {
   "id": 529707,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is an advantage of an open circulatory system?",
   "answers": [
    {
     "id": 1036764,
     "content_html": "It uses less metabolic energy."
    },
    {
     "id": 1036765,
     "content_html": "It enables an organism to move faster."
    },
    {
     "id": 1036766,
     "content_html": "It is a more efficient way to move gases, nutrients, and waste around an organism’s body."
    },
    {
     "id": 1036767,
     "content_html": "It allows organisms to grow larger."
    }
   ],
