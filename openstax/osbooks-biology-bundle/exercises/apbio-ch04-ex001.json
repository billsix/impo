 "questions": [
  {
   "id": 654299,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are electron microscopes crucial for the study of cell biology?",
   "answers": [
    {
     "id": 1289091,
     "content_html": "Only electron microscopes can be used to view internal structures."
    },
    {
     "id": 1289092,
     "content_html": "Some electron microscopes allow visualization of external surfaces at very high magnification in a way that is not possible with standard light microscopes."
    },
    {
     "id": 1289093,
     "content_html": "Scanning electron microscopes can show internal structures clearly at very high magnifications."
    },
    {
     "id": 1289094,
     "content_html": "Electron microscopes are easier to use and less expensive than light microscopes."
    }
   ],
