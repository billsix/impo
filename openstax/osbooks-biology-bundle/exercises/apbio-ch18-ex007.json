  {
   "id": 511913,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the processes described is divergent evolution?",
   "answers": [
    {
     "id": 1001290,
     "content_html": "Groups of organisms evolve in different directions from a common point."
    },
    {
     "id": 1001291,
     "content_html": "A new species develops rapidly when an event cuts off a portion of a population."
    },
    {
     "id": 1001292,
     "content_html": "Groups of organisms independently evolve to similar forms."
    },
    {
     "id": 1001293,
     "content_html": "A species evolves when a few members move to a new geographical area."
    }
