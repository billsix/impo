 "questions": [
  {
   "id": 520322,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Apply your understanding of how organisms synthesize macromolecules to determine which of the following statements best explains which organisms require nitrogen fixation to occur, and why.",
   "answers": [
    {
     "id": 1016739,
     "content_html": "Prokaryotes cannot use gaseous nitrogen to synthesize macromolecules, so gaseous nitrogen must be converted into ammonia."
    },
    {
     "id": 1016740,
     "content_html": "Prokaryotes cannot use ammonia to synthesize macromolecules, so ammonia must be converted into gaseous nitrogen."
    },
    {
     "id": 1016741,
     "content_html": "Eukaryotes cannot use ammonia to synthesize macromolecules, so ammonia must be converted into gaseous nitrogen."
    },
    {
     "id": 1016742,
     "content_html": "Eukaryotes cannot use gaseous nitrogen to synthesize macromolecules, so gaseous nitrogen must be converted into ammonia."
    }
