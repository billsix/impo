 "questions": [
  {
   "id": 544281,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe why Type 1 diabetes is considered an autoimmune disease.",
   "answers": [
    {
     "id": 1069793,
     "content_html": "The immune system attacks the hypothalamus, which prevents thyroxine production to regulate blood glucose."
    },
    {
     "id": 1069794,
     "content_html": "The immune system attacks cells of the pituitary gland, which prevents insulin production to regulate blood glucose."
    },
    {
     "id": 1069795,
     "content_html": "The immune system attacks beta cells of the pancreas, which prevents insulin production to regulate blood glucose."
    },
    {
     "id": 1069796,
     "content_html": "The immune system attacks beta cells of the pancreas, which prevents insulin production to regulate growth."
    }
   ],
