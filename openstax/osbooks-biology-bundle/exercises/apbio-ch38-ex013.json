   "id": 531832,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Analyze the major evidence scientists provide for the cause of the Cretaceous–Paleogene mass extinction.",
   "answers": [
    {
     "id": 1040244,
     "content_html": "the unusual abundance of iridium in the Cretaceous-Paleogene layers, the disappearance of some species at its transition, volcanic activity that led to global warming, and the crater found in the Yucatan peninsula"
    },
    {
     "id": 1040245,
     "content_html": "the unusual abundance of iridium in the Cretaceous-Paleogene layers, gamma-ray burst caused by a nearby supernova, and the crater found in the Yucatan peninsula"
    },
    {
     "id": 1040246,
     "content_html": "the unusual abundance of iridium in the Cretaceous-Paleogene layers, the disappearance of so many species at its transition, asteroid impact, and volcanic eruptions at large"
    },
    {
