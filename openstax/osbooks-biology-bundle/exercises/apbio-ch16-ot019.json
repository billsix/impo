 "questions": [
  {
   "id": 233331,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can external stimuli alter post-transcriptional control of gene expression?",
   "answers": [
    {
     "id": 723467,
     "content_html": "UV rays can alter methylation and acetylation of proteins."
    },
    {
     "id": 723470,
     "content_html": "RNA binding proteins are modified through phosphorylation."
    },
    {
     "id": 723468,
     "content_html": "External stimuli can cause deacetylation and demethylation of the transcript."
    },
    {
     "id": 723469,
     "content_html": "UV rays can cause dimerization of the RNA binding proteins."
    }
   ],
