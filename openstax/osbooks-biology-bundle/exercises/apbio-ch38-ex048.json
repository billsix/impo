   "stimulus_html": "",
   "stem_html": "Which of the following statements is not supported by the graph?",
   "answers": [
    {
     "id": 862380,
     "content_html": "There are more vulnerable fishes than critically endangered and endangered fishes combined."
    },
    {
     "id": 862379,
     "content_html": "There are more critically endangered amphibians than vulnerable, endangered and critically endangered reptiles combined."
    },
    {
     "id": 862381,
     "content_html": "Within each group, there are more critically endangered species than vulnerable species."
    },
    {
     "id": 862378,
     "content_html": "A greater percentage of bird species are critically endangered than mollusk species."
    }
