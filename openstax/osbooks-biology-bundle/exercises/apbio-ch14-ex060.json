 "context": "<figure id=\"fig-ch14_06_05\"><span data-type=\"media\" id=\"fs-id2221137\" data-alt=\"Illustration shows different types of point mutations that result from a single amino acid substitution. In a silent mutation, no change in the amino acid sequence occurs. In a missense mutation, one amino acid is substituted for another. In a nonsense mutation, a stop codon is substituted for an amino acid. In a frameshift mutation, one or more bases is added or deleted, resulting in a change in the reading frame.\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/7e47a8dfec12b8cbda375c7071482974a87793d2\" data-media-type=\"image/png\" alt=\"Illustration shows different types of point mutations that result from a single amino acid substitution. In a silent mutation, no change in the amino acid sequence occurs. In a missense mutation, one amino acid is substituted for another. In a nonsense mutation, a stop codon is substituted for an amino acid. In a frameshift mutation, one or more bases is added or deleted, resulting in a change in the reading frame.\" width=\"325\" height=\"415\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 509157,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A frameshift mutation that results in the insertion of three nucleotides is often less deleterious than a mutation that results in the insertion of one nucleotide. Why?",
   "answers": [
    {
     "id": 996928,
     "content_html": "Addition of three nucleotides does not shift the reading frame."
    },
    {
     "id": 996929,
     "content_html": "Addition of three nucleotides shifts the reading frame."
    },
    {
     "id": 996930,
     "content_html": "Addition of three nucleotides incorporates two amino acids."
    },
    {
     "id": 996931,
     "content_html": "Addition of three nucleotides removes two amino acids."
    }
   ],
