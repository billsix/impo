 "questions": [
  {
   "id": 535922,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Carbon dioxide, methane, and nitrous oxide are considered greenhouse gases because___.",
   "answers": [
    {
     "id": 1049967,
     "content_html": "They trap solar radiation released from the sun as it reaches the Earth’s surface, similar to the glass in a greenhouse."
    },
    {
     "id": 1049968,
     "content_html": "They are found mostly in green houses."
    },
    {
     "id": 1049969,
     "content_html": "These gases are essential for plant growth in a green house."
    },
    {
     "id": 1049970,
     "content_html": "They trap solar radiation, which is converted into thermal radiation on the Earth’s surface of which some is reradiated back into the atmosphere."
    }
   ],
