 "questions": [
  {
   "id": 503326,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is phosphorylation as it occurs in chemical reactions?",
   "answers": [
    {
     "id": 989287,
     "content_html": "Phosphorylation refers to the attachment of a phosphate group to another molecule to facilitate a chemical reaction."
    },
    {
     "id": 989288,
     "content_html": "Phosphorylation is the uptake of a phosphorous molecule by an ATP molecule to power chemical reactions."
    },
    {
     "id": 989289,
     "content_html": "Phosphorylation is the release of a third phosphorous molecule of ATP during hydrolysis."
    },
    {
     "id": 989290,
     "content_html": "Phosphorylation is the breakdown of a pyrophosphate molecule which gives phosphate ions."
    }
   ],
