   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the symbiotic relationship of mutualism.",
   "answers": [
    {
     "id": 1249135,
     "content_html": "Only one species benefits and the other derives no benefit or harm from the relationship."
    },
    {
     "id": 1249134,
     "content_html": "One species benefits and the other is harmed by the relationship."
    },
    {
     "id": 1249136,
     "content_html": "Both species benefit from the relationship."
    },
    {
     "id": 1249133,
     "content_html": "Neither species benefits nor is either species harmed."
    }
