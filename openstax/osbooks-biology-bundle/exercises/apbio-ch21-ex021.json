   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about the viral replication cycle is accurate?",
   "answers": [
    {
     "id": 1077759,
     "content_html": "The viral replication cycle does not affect the structure of the host cell."
    },
    {
     "id": 1077760,
     "content_html": "The viral replication cycle cannot affect genetic material of the host cell."
    },
    {
     "id": 1077761,
     "content_html": "The viral replication cycle has seven basic steps."
    },
    {
     "id": 1077762,
     "content_html": "The viral replication cycle can change cell functions or even destroy the host cell."
    }
