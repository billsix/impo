 "questions": [
  {
   "id": 503512,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does NF-κB induce gene expression?",
   "answers": [
    {
     "id": 990031,
     "content_html": "A small, hydrophobic ligand binds to NF-κB, activating it."
    },
    {
     "id": 990032,
     "content_html": "NF-κB is phosphorylated and is then free to enter the nucleus to bind DNA."
    },
    {
     "id": 990033,
     "content_html": "NF-κB is a kinase that phosphorylates a transcription factor that binds DNA and promotes protein production."
    },
    {
     "id": 990034,
     "content_html": "Phosphorylation of the inhibitor IκB dissociates the complex between it and NF-κB, allowing NF-κB to enter the nucleus and stimulate transcription."
    }
   ],
