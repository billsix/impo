 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm24896976\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-idm60005600\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/f73e1870136764c32136f2870fd34e20e7e51e38\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idp135135216\">This <a href=\"https://openstaxcollege.org/l/influenza\" target=\"_blank\" rel=\"noopener nofollow\">video</a> explains how influenza attacks the body.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 548500,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The <a href=\"https://youtu.be/jkNxmTrrZSk\" rel=\"nofollow\" target=\"_blank\">video</a> shows how viruses replicate in our body. Using the terminology provided in the video, explain how a virus attaches to a cell in our body?",
   "answers": [
    {
     "id": 1077623,
     "content_html": "When the virus capsule makes contact with the cell, it bursts, and then the virions attach to the cell."
    },
    {
     "id": 1077624,
     "content_html": "If a key on the virus fits a lock on the surface of the cell, the virus will attach to the cell."
    },
    {
     "id": 1077625,
     "content_html": "The keys automatically attach to all the locks."
    },
    {
     "id": 1077626,
     "content_html": "The welcoming committee interlocks with the virus."
    }
   ],
