  {
   "id": 334716,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You are offered the opportunity to have your genome sequenced. Considering the goals of genome sequencing, determine from the options provided which information you might be able to learn about yourself.",
   "answers": [
    {
     "id": 844486,
     "content_html": "identify the ancestry and genetic origin of diseases and their susceptibility to drugs"
    },
    {
     "id": 844483,
     "content_html": "identify potential drugs that can rectify a disease, symptoms of the disease, and its severity"
    },
    {
     "id": 844484,
     "content_html": "predict symptoms of a disease, vectors to be used in gene therapy, and the causal organism of the disease"
    },
    {
     "id": 844485,
     "content_html": "determine the pedigree of a disease, produce recombinants, and detect the presence of extracellular genes using FISH"
    }
   ],
