 "questions": [
  {
   "id": 640434,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Paleontologists analyzing fossils from a newly discovered site with layers spanning multiple geological periods found that one of the youngest layers probably correlates with a mass extinction event. Which is the following would be evidence supporting this claim?",
   "answers": [
    {
     "id": 1249215,
     "content_html": "Over 95% of species present in the oldest layer are not present in the layer in question."
    },
    {
     "id": 1249214,
     "content_html": "An asteroid impact altered the geological terrain significantly."
    },
    {
     "id": 1249213,
     "content_html": "All of the fossils observed were of larger sized organisms."
    },
    {
     "id": 1249216,
     "content_html": "Over 50% of the species present in the layer just below are missing in this layer."
    }
   ],
