   "stem_html": "Many forms of modified organs exist in plants. What is a rhizome?",
   "answers": [
    {
     "id": 1014675,
     "content_html": "an underground stem with fleshy leaves modified for food storage as in onions"
    },
    {
     "id": 1014676,
     "content_html": "a solid, underground stem covered with scales formed by some plants such as crocuses"
    },
    {
     "id": 1014677,
     "content_html": "an aboveground stem with buds as seen in strawberry plants"
    },
    {
     "id": 1014678,
     "content_html": "a modified horizontal stem that grows underground as seen in irises"
