   "id": 525485,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens to glycogen when blood sugar drops?",
   "answers": [
    {
     "id": 1030344,
     "content_html": "It stimulates the release of insulin, which can regulate the blood sugar level."
    },
    {
     "id": 1030345,
     "content_html": "It is released from the liver and converted to glucose to increase blood sugar levels."
    },
    {
     "id": 1030346,
     "content_html": "It is converted to starch, which breaks down to form glucose and increase blood sugar levels."
    },
    {
     "id": 1030347,
     "content_html": "It is released from the liver and converted to pyruvate, which can then form glucose to increase blood sugar levels."
    }
   ],
