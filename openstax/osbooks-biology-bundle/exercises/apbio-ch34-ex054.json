 "questions": [
  {
   "id": 517103,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A couple has been trying to conceive for some time and goes to an endocrinologist for advice. If the endocrinologist diagnoses an obstruction in the oviducts of the female, what type of treatment can she recommend?",
   "answers": [
    {
     "id": 1011294,
     "content_html": "opting for in vivo fertilization or ligation of the fallopian tubes surgically so that the tubes are sealed"
    },
    {
     "id": 1011295,
     "content_html": "opting for in vivofertilization or removal of the obstruction surgically and then re-ligation of the ends of the fallopian tubes"
    },
    {
     "id": 1011296,
     "content_html": "opting for in vitro fertilization or ligation of the fallopian tubes surgically so that the tubes are sealed"
    },
    {
     "id": 1011297,
     "content_html": "opting for in vitro fertilization or removal of the obstruction surgically and then re-ligation of the ends of the fallopian tubes"
    }
   ],
