  {
   "id": 241915,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/889af35578b48155.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Stephen L. Aronoff, MD, FACP, FACE, et al./DiabetesSpectrum)</figcaption>\n</figure>\n",
   "stem_html": "<p>The graph shows the blood glucose, insulin and glucagon levels of a healthy person after a carbohydrate-rich (CHO) meal.</p>\n<p>Make a claim based on this graph.</p>",
   "answers": [
    {
     "id": 757122,
     "content_html": "Insulin causes blood sugar to increase."
    },
    {
     "id": 757121,
     "content_html": "Glucagon causes blood sugar to decrease."
    },
    {
     "id": 757120,
     "content_html": "Insulin and glucagon both reduce the blood sugar."
    },
    {
     "id": 757123,
     "content_html": "Insulin and and glucagon have opposite effects on glucose."
    }
   ],
