 "questions": [
  {
   "id": 521603,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which set of results was found in the Meselson and Stahl’s experiments?",
   "answers": [
    {
     "id": 1020212,
     "content_html": "The original chromosome was kept intact and a duplicate was made."
    },
    {
     "id": 1020213,
     "content_html": "The original chromosome was split and half went to each duplicate."
    },
    {
     "id": 1020214,
     "content_html": "The original chromosome was mixed with new material and each duplicate strand contained both old and new."
    },
    {
     "id": 1020215,
     "content_html": "The original chromosome was used as a template for two new chromosomes and discarded."
    }
   ],
