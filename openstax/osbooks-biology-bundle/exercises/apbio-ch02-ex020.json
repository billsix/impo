   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is true?",
   "answers": [
    {
     "id": 1003878,
     "content_html": "Acids and bases cannot mix together."
    },
    {
     "id": 1003879,
     "content_html": "Acids and bases can neutralize each other."
    },
    {
     "id": 1003880,
     "content_html": "Acids, not bases, can change the pH of a solution."
    },
    {
     "id": 1003881,
     "content_html": "Acids donate hydroxide ions (<span data-math=\"\\text{OH}^-\">\\text{OH}^-</span>); bases donate hydrogen ions (<span data-math=\"\\text{H}^+\">\\text{H}^+</span>)."
    }
