  {
   "id": 524232,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Chemical and electrical synapse are two mechanisms by which signals can be transferred between neurons. Which of the following occurs during chemical synapse?",
   "answers": [
    {
     "id": 1029256,
     "content_html": "Repolarization at the presynaptic membrane"
    },
    {
     "id": 1029257,
     "content_html": "Calcium influx causes synaptic vesicles to fuse to the membrane"
    },
    {
     "id": 1029258,
     "content_html": "Neurotransmitters diffuse out of gap junctions"
    },
    {
     "id": 1029259,
     "content_html": "Neurotransmitters bind to synaptic vesicles"
    }
   ],
