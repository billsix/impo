   "id": 640295,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What tends to happen to cells in a hypotonic environment?",
   "answers": [
    {
     "id": 1248679,
     "content_html": "They remain the same size."
    },
    {
     "id": 1248678,
     "content_html": "They shrink due to water loss."
    },
    {
     "id": 1248677,
     "content_html": "They allow water to flow in and out at the same rate."
    },
    {
     "id": 1248680,
     "content_html": "They swell due to water gain."
    }
   ],
