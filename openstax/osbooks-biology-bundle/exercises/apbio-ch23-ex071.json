   "id": 519906,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The process of bulk flow transports fluids in a plant. What are the two main bulk flow processes?",
   "answers": [
    {
     "id": 1015139,
     "content_html": "Movement of water up the xylem and movement of solutes up and down the phloem"
    },
    {
     "id": 1015140,
     "content_html": "Movement of water up the phloem and movement of solutes up and down the xylem."
    },
    {
     "id": 1015141,
     "content_html": "Movement of water up and down the xylem and movement of solutes up the phloem"
    },
    {
     "id": 1015142,
     "content_html": "Movement of solutes up the xylem and movement of water up and down the phloem"
    }
