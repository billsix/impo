   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how pheromones differ from other odorants, from the perspective of the recipient of the signal.",
   "answers": [
    {
     "id": 1049447,
     "content_html": "Pheromones are sent to the main olfactory bulb instead of the amygdala and are not consciously perceived."
