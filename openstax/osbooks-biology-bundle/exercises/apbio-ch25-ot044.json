 "questions": [
  {
   "id": 524148,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "On a cellular level, why must food be broken down?",
   "answers": [
    {
     "id": 1029048,
     "content_html": "Large molecules present in intact food pass through the digestive epithelium and enter the cell through the membrane, thereby damaging the nuclear membrane. Hence it must be broken down."
    },
    {
     "id": 1029049,
     "content_html": "Fats present in intact food contain very large molecules, which cannot pass through cell membranes. Fats need to be passed through the digestive epithelium to be utilized."
    },
    {
     "id": 1029050,
     "content_html": "Large molecules present in intact food cannot pass through cell membranes. Nutrients need to be passed through the digestive epithelium to be utilized."
    },
    {
     "id": 1029051,
     "content_html": "Large molecules, if not broken down, produce toxic substances that pass through the epithelium of the digestive tract and are utilized by the cells. This can be lethal to the cell."
    }
   ],
