 "questions": [
  {
   "id": 668851,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Differences in human blood types show how genetic differences have evolved over time, affecting red blood cell structure. What is the basis for blood type classifications?",
   "answers": [
    {
     "id": 1333551,
     "content_html": "It is based on antigens made of carbohydrates, specifically glycoside and N-acetylglucosamine, found on the surface of red blood cells."
    },
    {
     "id": 1333552,
     "content_html": "It is based on antigens made of proteins, specifically glycolipids and glycoproteins, found on the surface of red blood cells."
    },
    {
     "id": 1333553,
     "content_html": "It is based on antigens made of proteins, specifically peripheral and integral proteins, found on the surface of the red blood cell."
    },
    {
     "id": 1333554,
     "content_html": "It is based on antigens made of lipids, specifically glycerophospholipids, found on the surface of red blood cells."
    }
   ],
