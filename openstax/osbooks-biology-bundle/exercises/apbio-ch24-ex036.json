   "id": 521035,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When faced with a sudden drop in environmental temperature, an endothermic animal will <strong>__</strong><strong>__</strong>.",
   "answers": [
    {
     "id": 1018449,
     "content_html": "experience a substantial drop in its body temperature"
    },
    {
     "id": 1018450,
     "content_html": "find a warm rock on which to bask"
    },
    {
     "id": 1018451,
     "content_html": "increase muscle activity to generate heat"
    },
    {
     "id": 1018452,
     "content_html": "increase fur or fat to increase insulation"
    }
