 "questions": [
  {
   "id": 529235,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Measures of lung function include forced expiratory volume (FEV) and functional vital capacity (FVC). Make a claim that identifies what conditions of the lungs would cause an increase in FEV1/FVC, and what would cause a decrease FEV1/FVC.",
   "answers": [
    {
     "id": 1035924,
     "content_html": "This ratio increases when there is decreased resistance in the lung, as when lung quality is improved through medical treatment. Obstructive lung disease would decrease the ratio as the lungs become stiff and less pliable."
    },
    {
     "id": 1035925,
     "content_html": "Obstructive lung disease would increase this ratio as the lungs become stiff and less pliable. Restrictive lung disease would decrease this ratio, as there is increased resistance in the lung."
    },
    {
     "id": 1035926,
     "content_html": "Restrictive lung disease would increase this ratio as the lungs become stiff and less pliable. Medical treatment of damaged lungs decreases this ratio, as there is increased resistance in the lung."
    },
    {
     "id": 1035927,
     "content_html": "This ratio increases as the lungs become stiff and less pliable, as with obstructive lung disease. An improvement in condition to restrictive lung disease decreases the ratio, when there is increased resistance in the lung."
    }
   ],
