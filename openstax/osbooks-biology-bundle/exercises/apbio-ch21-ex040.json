 "questions": [
  {
   "id": 623764,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "For most people, the measles virus does not cause a serious illness. Symptoms include fever and a rash, but the symptoms are usually gone in about a week. However, for some, the measles virus can be much more serious. How can the measles virus cause a potentially fatal illness?",
   "answers": [
    {
     "id": 1196583,
     "content_html": "Measles can cause meningococcal disease, which causes severe headaches, seizures and in severe cases can be life-threatening."
    },
    {
     "id": 1196582,
     "content_html": "Measles can cause variant Creutzfeldt–Jakob disease, which causes severe headaches, seizures and in severe cases can be life-threatening."
    },
    {
     "id": 1196584,
     "content_html": "Measles can cause encephalitis/meningitis, which causes severe headaches, seizures and in severe cases can be life-threatening."
    },
    {
     "id": 1196581,
     "content_html": "Measles can cause Legionnaires’ disease, which causes severe headaches, seizures and in severe cases can be life-threatening."
    }
   ],
