 "questions": [
  {
   "id": 503468,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the role of rribulose 1,5, bisphosphate carboxylase/oxygenase, abbreviated RuBisCO, in photosynthesis?",
   "answers": [
    {
     "id": 989855,
     "content_html": "It catalyzes the reaction between <span data-math=\"\\text{CO}_2\">\\text{CO}_2</span> and ribulose bisphosphate (RuBP)."
    },
    {
     "id": 989856,
     "content_html": "It catalyzes the reaction that produces glyceraldehyde3-phosphate (G3P)."
    },
    {
     "id": 989857,
     "content_html": "It catalyzes the reaction that regenerates RuBP."
    },
    {
     "id": 989858,
     "content_html": "It catalyzes the reaction utilizing ATP and NADPH."
    }
   ],
