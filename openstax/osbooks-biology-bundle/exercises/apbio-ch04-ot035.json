 "questions": [
  {
   "id": 503768,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens to the proteins that are synthesized on free ribosomes in the cytoplasm? Do they go through the Golgi apparatus?",
   "answers": [
    {
     "id": 990421,
     "content_html": "These proteins move through the Golgi apparatus and enter in the nucleus."
    },
    {
     "id": 990422,
     "content_html": "These proteins go through the Golgi apparatus and remain in the cytosol."
    },
    {
     "id": 990423,
     "content_html": "The proteins do not go through the Golgi apparatus and move into the nucleus for processing."
    },
    {
     "id": 990424,
     "content_html": "The proteins do not go through the Golgi apparatus and remain free in the cytosol."
    }
   ],
