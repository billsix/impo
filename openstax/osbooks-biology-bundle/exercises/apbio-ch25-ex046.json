 "questions": [
  {
   "id": 524075,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/8a1bb5e1f4e416f9.jpg\" alt=\"A table showing that the average mouse respiration rate at 10 degrees Celsius is .0518 milliliters of oxygen consumed per gram of mass per minute, and at 25 degrees Celsius, the rate is .0321 milliliters of oxygen consumed per gram of mass per minute.\"></p>\n<p>Which option is a claim that can be made based on this study?</p>\n",
   "answers": [
    {
     "id": 1028844,
     "content_html": "The mice at 10°C had a higher rate of ATP production than the mice at 25°C."
    },
    {
     "id": 1028845,
     "content_html": "The mice at 10°C had a lower metabolic rate than the mice at 25°C."
    },
    {
     "id": 1028846,
     "content_html": "The mice at 25°C weighed less than the mice at 10°C."
    },
    {
     "id": 1028847,
     "content_html": "The mice at 25°C were more active than the mice at 10°C."
    }
   ],
