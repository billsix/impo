 "questions": [
  {
   "id": 547335,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe an advantage of a monogamous relationship.",
   "answers": [
    {
     "id": 1074227,
     "content_html": "Having a lot of males around to provide assistance with protecting and feeding offspring ensures that offspring have the best chance of surviving."
    },
    {
     "id": 1074228,
     "content_html": "When very few males are available in a population, this mating system makes sure that each male has a mating partner."
    },
    {
     "id": 1074229,
     "content_html": "In populations where very few females are available, this mating system ensures that no eggs are wasted."
    },
    {
     "id": 1074230,
     "content_html": "The constant presence of one male throughout the offspring rearing process makes it more likely that offspring will survive and be healthier."
    }
   ],
