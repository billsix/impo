 "questions": [
  {
   "id": 495720,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is structurally different between starch and cellulose that gives them different physical properties?",
   "answers": [
    {
     "id": 978280,
     "content_html": " Cellulose is formed by <span data-math=\"\\unicode[Arial]{x3B2}\">\\unicode[Arial]{x3B2}</span>-1,4 glycosidic linkages and crosslinks, making it rigid. Starch has <span data-math=\"\\unicode[Arial]{x3B1}\">\\unicode[Arial]{x3B1}</span>-1.4 and <span data-math=\"\\unicode[Arial]{x3B1}\">\\unicode[Arial]{x3B1}</span>-1.6 glycosidic linkages without the tight crosslinks of cellulose."
    },
    {
     "id": 978281,
     "content_html": "Cellulose has rigid <span data-math=\"\\unicode[Arial]{x3B1}\">\\unicode[Arial]{x3B1}</span>-1,4 glycosidic linkages while starch has less rigid <span data-math=\"\\unicode[Arial]{x3B2}\">\\unicode[Arial]{x3B2}</span>-1,4 glycosidic linkages"
    },
    {
     "id": 978282,
     "content_html": "Cellulose has amylose and amylopectin, making it more rigid than starch."
    },
    {
     "id": 978283,
     "content_html": "Starch has amylose and amylopectin that make it more rigid than cellulose."
    }
   ],
