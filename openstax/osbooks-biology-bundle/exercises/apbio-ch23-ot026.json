 "questions": [
  {
   "id": 519796,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A time course is developed to follow the fate of the vascular bundles in the stem of dicots. Sections along the stem are fixed, stained, and observed under a microscope. Predict what will happen to the vascular bundles in the stem of a dicot as the plant matures, as revealed by the results.",
   "answers": [
    {
     "id": 1014707,
     "content_html": "The vascular bundles join to form growth rings."
    },
    {
     "id": 1014708,
     "content_html": "The vascular bundles divide into primary xylem and primary phloem."
    },
    {
     "id": 1014709,
     "content_html": "The vascular bundles divide into secondary xylem and primary phloem."
    },
    {
     "id": 1014710,
     "content_html": "The vascular bundles die out."
    }
   ],
