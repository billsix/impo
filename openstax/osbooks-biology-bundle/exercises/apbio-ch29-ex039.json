 "questions": [
  {
   "id": 546972,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why can’t actin and myosin interact in the absence of calcium?",
   "answers": [
    {
     "id": 1072993,
     "content_html": "Actin binding sites are covered by acetylcholine to which the troponin complex is attached. This complex is calcium sensitive. Troponin binds to the calcium and moves the tropomyosin from the active site."
    },
    {
     "id": 1072994,
     "content_html": "Myosin binding sites are covered by the troponin complex to which is attached tropomyosin. Tropomyosin is calcium sensitive. It binds to the calcium and moves the troponin binding site."
    },
    {
     "id": 1072995,
     "content_html": "Actin binding sites are covered by tropomyosin to which the troponin complex is attached. This complex is calcium sensitive. Troponin binds to the calcium and moves the tropomyosin from the active site."
    },
    {
     "id": 1072996,
     "content_html": "Myosin binding sites on actin are covered by tropomyosin to which the troponin complex is attached. This complex is calcium sensitive. Troponin binds to the calcium and moves the tropomyosin from the active site."
    }
   ],
