 "questions": [
  {
   "id": 618664,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Treating cancer can be described as a fight against natural biologic processes. Explain what this means in terms of tumor formation.",
   "answers": [
    {
     "id": 1178005,
     "content_html": "Cancer forms when natural defenses are inhibited and cells divide uncontrollably."
    },
    {
     "id": 1178004,
     "content_html": "Mutated cells undergo apoptosis, causing cells to divide uncontrollably."
    },
    {
     "id": 1178003,
     "content_html": "Cancer treatment would require inhibiting apoptosis which is a natural defense."
    },
    {
     "id": 1178002,
     "content_html": "In cancerous cells, apoptosis occurs."
    }
   ],
