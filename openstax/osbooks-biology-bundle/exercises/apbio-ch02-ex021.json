   "stem_html": "Why can some insects walk on water?",
   "answers": [
    {
     "id": 1346164,
     "content_html": "Insects can walk on water because of its high surface tension."
    },
    {
     "id": 1346161,
     "content_html": "Insects can walk on water because it is a polar solvent."
    },
    {
     "id": 1346162,
     "content_html": "Insects can walk on water because they are less dense than water."
    },
    {
