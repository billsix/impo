 "questions": [
  {
   "id": 547016,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between voluntary and involuntary muscles? Give an example of each.",
   "answers": [
    {
     "id": 1073165,
     "content_html": "Voluntary muscles cannot be consciously controlled, such as cardiac muscles. Involuntary muscles can be controlled by an individual’s will, such as skeletal muscles."
    },
    {
     "id": 1073166,
     "content_html": "Voluntary muscles can be controlled by an individual’s will, such as cardiac muscles. Involuntary muscles cannot be consciously controlled, such as skeletal muscles."
    },
    {
     "id": 1073167,
     "content_html": "Voluntary muscles cannot be consciously controlled, such as the movement of legs while walking. Involuntary muscles can be controlled by an individual’s will, such as muscles in the digestive system."
    },
    {
     "id": 1073168,
     "content_html": "Voluntary muscles can be controlled by an individual’s will, such as skeletal muscles. Involuntary muscles cannot be consciously controlled, such as cardiac muscles."
    }
