 "questions": [
  {
   "id": 495734,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why have trans fats been banned from some restaurants? How are they created?",
   "answers": [
    {
     "id": 978335,
     "content_html": "Trans fat is produced by the hydrogenation of oil that makes it more saturated and isomerized. It increases LDL amounts."
    },
    {
     "id": 978336,
     "content_html": "The dehydrogenation of oil forms the trans fat, which contains single bonds in its structure. This increases HDL in the body and has been banned."
    },
    {
     "id": 978337,
     "content_html": "Trans fat is produced by dehydrogenation of oils, which makes it unsaturated. It increases LDL in body."
    },
    {
     "id": 978338,
     "content_html": "The hydrogenation of oil makes the trans fat, which increases the number of double bonds in its structure. It decreases HDL in the body."
    }
   ],
