 "questions": [
  {
   "id": 334654,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how the study of epigenetics can lead to improved treatment of cancer.",
   "answers": [
    {
     "id": 844239,
     "content_html": "Epigenetics would allow new body parts to be synthesized that could replace those damaged by cancer."
    },
    {
     "id": 844238,
     "content_html": "Epigenetics could change the genetic code of all cells in the body to prevent them from becoming cancerous."
    },
    {
     "id": 844237,
     "content_html": "New therapies could be made that changes the genetic code of harmful cancer genes."
    },
    {
     "id": 844240,
     "content_html": "New therapies could be made that do not require altering the cancer cell’s DNA."
    }
   ],
