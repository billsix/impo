 "questions": [
  {
   "id": 639596,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is not true about enzymes?",
   "answers": [
    {
     "id": 1245931,
     "content_html": "They are consumed by the reactions they catalyze."
    },
    {
     "id": 1245930,
     "content_html": "They are usually made of amino acids."
    },
    {
     "id": 1245929,
     "content_html": "They lower the activation energy of chemical reactions."
    },
    {
     "id": 1245928,
     "content_html": "Each one is specific to the particular substrate, or substrates, to which it binds."
    }
   ],
