   "id": 640307,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What substance is secreted by most aquatic animals, and why?",
   "answers": [
    {
     "id": 1248728,
     "content_html": "ammonia, because it can be easily diluted in an aquatic environment"
    },
    {
     "id": 1248727,
     "content_html": "uric acid, because aquatic animals must preserve water"
    },
    {
     "id": 1248726,
     "content_html": "urea, because ammonia needs to be converted before it can safely be stored in the body"
    },
    {
     "id": 1248725,
     "content_html": "chlorine, because it can easily be converted to a gas"
    }
   ],
