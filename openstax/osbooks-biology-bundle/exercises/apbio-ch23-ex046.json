  {
   "id": 519858,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Support the claim that a plant gains advantages by storing a food reserve underground by comparing and selecting from the descriptions below.",
   "answers": [
    {
     "id": 1014955,
     "content_html": "Food reserves are more nutritious underground. The soil conditions make these food reserves abundant."
    },
    {
     "id": 1014956,
     "content_html": "Food reserves underground are hidden from potential predators. The soil conditions make these food reserves abundant."
    },
    {
     "id": 1014957,
     "content_html": "Food reserves are more nutritious underground. Soil conditions such as moisture and temperature are less variable."
    },
    {
     "id": 1014958,
     "content_html": "Food reserves underground are hidden from potential predators. Soil conditions such as moisture and temperature are less variable."
    }
