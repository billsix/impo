   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is part of the cell theory?",
   "answers": [
    {
     "id": 1004152,
     "content_html": "All living organisms are made of cells."
    },
    {
     "id": 1004153,
     "content_html": "All cells contain DNA that they pass on to daughter cells."
    },
    {
     "id": 1004154,
     "content_html": "All cells depend on their surroundings to provide energy."
    },
    {
     "id": 1004155,
     "content_html": "All cells have a nucleus."
    }
