   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Four-o’ clock flowers may be red, pink or white. In the crossing of a true-breeding red and true-breeding white plants, all the offspring are pink. Use a Punnett square to determine the correct genotype of the offspring if the red parent has genotype RR and the white parent has genotype rr.",
   "answers": [
    {
     "id": 1019952,
     "content_html": "RR and Rr"
    },
    {
     "id": 1019953,
     "content_html": "Rr and rr"
    },
    {
     "id": 1019954,
     "content_html": "Rr only"
    },
    {
     "id": 1019955,
     "content_html": "RR only"
    }
