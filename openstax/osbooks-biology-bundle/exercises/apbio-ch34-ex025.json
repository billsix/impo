   "stimulus_html": "",
   "stem_html": "Which of the following statements about the male reproductive system is FALSE?",
   "answers": [
    {
     "id": 1011214,
     "content_html": "The vas deferens carries sperm from the testes to the penis."
    },
    {
     "id": 1011215,
     "content_html": "Sperm mature in the seminiferous tubules in the testes."
    },
    {
     "id": 1011216,
     "content_html": "Both the prostate and bulbourethral glands produce components of the semen."
    },
    {
     "id": 1011217,
     "content_html": "The prostate gland is located in the testes."
    }
