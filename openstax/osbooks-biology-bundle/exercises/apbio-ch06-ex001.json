 "questions": [
  {
   "id": 639578,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "We know that the early atmosphere lacked oxygen. Which claim can best be made based on this knowledge and your understanding of  how Earth evolved?",
   "answers": [
    {
     "id": 1245859,
     "content_html": "Oxygen is a byproduct of anaerobic respiration, so there was very little oxygen in the atmosphere until anaerobic organisms evolved."
    },
    {
     "id": 1245858,
     "content_html": "Oxygen is a byproduct of fermentation, so there was little oxygen in the atmosphere until prokaryotes appeared."
    },
    {
     "id": 1245857,
     "content_html": "Oxygen is a byproduct of aerobic respiration, so there was very little oxygen in the atmosphere until animals evolved."
    },
    {
     "id": 1245860,
     "content_html": "Oxygen is a byproduct of photosynthesis, so there was very little oxygen in the atmosphere until photosynthetic organisms evolved."
    }
   ],
