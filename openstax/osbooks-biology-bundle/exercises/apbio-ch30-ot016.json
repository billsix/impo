 "questions": [
  {
   "id": 529381,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What does elastic recoil in the lungs refer to and does it aid inspiration or expiration?",
   "answers": [
    {
     "id": 1036180,
     "content_html": "the ability of the diaphragm to contract and relax to change the volume of the lung, inspiration"
    },
    {
     "id": 1036181,
     "content_html": "the reserve air in the lungs that is present even after maximum exhalation, expiration"
    },
    {
     "id": 1036182,
     "content_html": "the ability of the bronchioles to expand and retract as air enters and exits, inspiration"
    },
    {
     "id": 1036183,
     "content_html": "the ability of lung tissue to exert pressure back towards the lung’s interior, expiration"
    }
   ],
