 "questions": [
  {
   "id": 639561,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why glucose cannot pass directly through the cell membrane.",
   "answers": [
    {
     "id": 1245791,
     "content_html": "The plasma membrane is impermeable to polar molecules, so transport proteins are required."
    },
    {
     "id": 1245792,
     "content_html": "The plasma membrane is selectively permeable to polar molecules, and a transport protein is required for larger molecules."
    },
    {
     "id": 1245790,
     "content_html": "The plasma membrane is permeable to all polar molecules, but a transport protein is required."
    },
    {
     "id": 1245789,
     "content_html": "The plasma membrane is selectively permeable to all polar molecules and a transport protein is never required for them."
    }
   ],
