   "stimulus_html": "",
   "stem_html": "Why does gout often result in pain?",
   "answers": [
    {
     "id": 1046882,
     "content_html": "The urethra swells, making urination slower and more painful."
    },
    {
     "id": 1046883,
     "content_html": "Uric acid crystals build up in the joints, resulting in painful body movements."
    },
    {
     "id": 1046884,
     "content_html": "Ammonia begins to degrade the linking of the bladder, causing constant pain."
    },
    {
     "id": 1046885,
     "content_html": "Urea is always highly concentrated, resulting in kidney stones that make urination painful."
    }
