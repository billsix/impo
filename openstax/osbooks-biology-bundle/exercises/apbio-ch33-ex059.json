 "questions": [
  {
   "id": 242400,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Researchers have been working on developing methods for stimulating the human immune system to recognize foreign proteins as self proteins. Why would this research be applicable to treating allergies?",
   "answers": [
    {
     "id": 759059,
     "content_html": "In an allergy, a person’s immune system has been compromised, which causes unpleasant symptoms."
    },
    {
     "id": 759060,
     "content_html": "In an allergy, a person’s immune system reacts to its own proteins, which causes unpleasant symptoms."
    },
    {
     "id": 759062,
     "content_html": "In an allergy, a person’s immune system reacts to a harmless protein from the environment, which causes unpleasant symptoms."
    },
    {
     "id": 759061,
     "content_html": "In an allergy, a person’s immune system reacts to a harmless protein from the environment, which causes pleasant symptoms."
    }
   ],
