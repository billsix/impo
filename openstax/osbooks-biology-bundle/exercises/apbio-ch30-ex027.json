 "questions": [
  {
   "id": 529369,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Examine the provided illustration. Make a claim that explains how paralysis of the diaphragm would alter inspiration.",
   "answers": [
    {
     "id": 1036140,
     "content_html": "It would prevent contraction of the intercostal muscles."
    },
    {
     "id": 1036141,
     "content_html": "It would prevent inhalation because the intrapleural pressure would not change."
    },
    {
     "id": 1036142,
     "content_html": "It would decrease the intrapleural pressure and allow more air to enter the lungs."
    },
    {
     "id": 1036143,
     "content_html": "It would slow expiration because the lungs would not relax."
    }
   ],
