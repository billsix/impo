  {
   "id": 504353,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which cellular process underlies Mendel’s law of independent assortment?",
   "answers": [
    {
     "id": 992001,
     "content_html": "Chromosomes align randomly during meiosis."
    },
    {
     "id": 992002,
     "content_html": "Chromosomes can exchange genetic material during crossover."
    },
    {
     "id": 992003,
     "content_html": "Gametes contain half the number of chromosomes of somatic cells."
    },
    {
     "id": 992004,
     "content_html": "Daughter cells are genetically identical to parent cells after mitosis."
    }
   ],
