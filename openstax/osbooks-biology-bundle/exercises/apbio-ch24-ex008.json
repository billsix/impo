 "questions": [
  {
   "id": 520384,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does an asymmetrical body plan differ from radial or bilateral body plans?",
   "answers": [
    {
     "id": 1016945,
     "content_html": "Asymmetrical organisms can produce equal halves if cut along a certain plane, whereas radially and bilaterally symmetric organisms have no distinct pattern."
    },
    {
     "id": 1016946,
     "content_html": "Asymmetrical organisms have no distinct pattern, whereas radially and bilaterally symmetric organisms can produce equal halves if cut along a certain plane."
    },
    {
     "id": 1016947,
     "content_html": "Asymmetrical organisms produce equal halves if cut along a certain plane with no definite right or left side, whereas radially and bilaterally symmetric organisms can produce equal halves."
    },
    {
     "id": 1016948,
     "content_html": "Asymmetrical organisms produce equal halves if cut along a certain plane with definite right and left sides, whereas radially and bilaterally symmetric organisms can produce equal halves."
    }
   ],
