 "questions": [
  {
   "id": 524216,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do hormones regulate digestion?",
   "answers": [
    {
     "id": 1029192,
     "content_html": "Hormones regulate aspects of digestion such as increasing the peristaltic movements in the esophagus when food is sensed."
    },
    {
     "id": 1029193,
     "content_html": "Hormones regulate digestion by signaling when the stomach is full or empty so that an individual will consume food or stop eating."
    },
    {
     "id": 1029194,
     "content_html": "Hormones like gastrin, secretin, adrenocorticotropic are released from the pituitary to regulate which digestive secretions are released."
    },
    {
     "id": 1029195,
     "content_html": "Hormones regulate aspects of digestion such as which digestive secretions are released as well as when they are released."
    }
   ],
