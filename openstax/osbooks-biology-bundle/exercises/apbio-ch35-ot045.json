 "questions": [
  {
   "id": 242511,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/15a7089ae8bc20b7.jpg\" alt=\"\">\n<figcaption>(credit: modification of work from Global Monitoring Laboratory)</figcaption>\n</figure>\n",
   "stem_html": "<p>The red line on the graph shows the monthly carbon dioxide measurements between 2016 and 2021. Each dot represents a month. The year's first dot is January.</p>\n<p>Make a claim based on this data.</p>",
   "answers": [
    {
     "id": 759505,
     "content_html": "Winter months in the Northern hemisphere see more carbon dioxide emissions, possibly due to heating."
    },
    {
     "id": 759506,
     "content_html": "Carbon dioxide emissions peak at summer months, possibly due to increased agricultural and industrial activity."
    },
    {
     "id": 759504,
     "content_html": "Carbon dioxide emissions are constant throughout the year. Summer's increased agricultural activity is balanced by winter heating in the northern hemisphere."
    },
    {
     "id": 759503,
     "content_html": "Carbon dioxide emissions constantly increase during the year, due to increasing population and increased use of fossil fuels."
    }
   ],
