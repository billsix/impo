 "questions": [
  {
   "id": 521594,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens when a dideoxynucleotide is added to a developing DNA strand?",
   "answers": [
    {
     "id": 1020176,
     "content_html": "The chain extends to the end of the DNA strand."
    },
    {
     "id": 1020177,
     "content_html": "The DNA strand is duplicated."
    },
    {
     "id": 1020178,
     "content_html": "The chain is not extended any further."
    },
    {
     "id": 1020179,
     "content_html": "The last codon is repeated."
    }
   ],
