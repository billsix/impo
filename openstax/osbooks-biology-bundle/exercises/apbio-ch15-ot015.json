 "questions": [
  {
   "id": 639751,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following features distinguishes eukaryotic transcription from bacterial transcription?",
   "answers": [
    {
     "id": 1246533,
     "content_html": "Eukaryotic transcription does not start at a consensus sequence."
    },
    {
     "id": 1246532,
     "content_html": "Eukaryotic transcription does not require an initiation complex."
    },
    {
     "id": 1246534,
     "content_html": "Eukaryotic transcription and translation do not take place at the same time."
    },
    {
     "id": 1246531,
     "content_html": "Eukaryotic transcription does not require a termination sequence."
    }
   ],
