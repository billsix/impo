   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What does the term “rooted” mean on a phylogenetic tree diagram?",
   "answers": [
    {
     "id": 724772,
     "content_html": "relationships among species do not show"
    },
    {
     "id": 724773,
     "content_html": "all organisms represented in the diagram relate to a single ancestral lineage"
    },
    {
     "id": 724771,
     "content_html": "a single lineage evolved into a distinct new one"
    },
    {
     "id": 724770,
     "content_html": "a lineage evolved early from the root and remains unbranched"
    }
