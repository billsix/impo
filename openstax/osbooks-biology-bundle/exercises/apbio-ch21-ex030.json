 "questions": [
  {
   "id": 548636,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>The diagram below shows the stages during which a virus infects a host cell, identified by number. During which of the steps does the amount of viral genetic material begin to change within the host cell? Justify your answer with an explanation.</p>\n<p><img src=\"exercises/media/2b63ab668b856b26.jpg\" alt=\"This illustration shows an influenza virus attaching to an epithelial cell. At step 1, the virus enters the cell. At step 2, viral RNA enters the nucleus. At step 3, new viruses are assembled within the cell. At step 4, new viruses leave the host cell.\"></p>\n",
   "answers": [
    {
     "id": 1078027,
     "content_html": "1, because the virus enters the cell."
    },
    {
     "id": 1078028,
     "content_html": "2, because the virus RNA enters the nucleus."
    },
    {
     "id": 1078029,
     "content_html": "3, because new viruses assemble within the cell."
    },
    {
     "id": 1078030,
     "content_html": "4, because viruses leave the cell."
    }
   ],
   "hints": [],
