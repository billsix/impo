 "questions": [
  {
   "id": 521686,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You eat food in order to obtain vital nutrients. How are these nutrients absorbed by your body?",
   "answers": [
    {
     "id": 1020544,
     "content_html": "Food is mechanically and chemically broken down into smaller molecules."
    },
    {
     "id": 1020545,
     "content_html": "Alternating waves of muscular contraction facilitate movement of food."
    },
    {
     "id": 1020546,
     "content_html": "Partially digested food flows into the small intestine and food regurgitation is prevented."
    },
    {
     "id": 1020547,
     "content_html": "Nutrients diffuse across the intestines."
    }
   ],
