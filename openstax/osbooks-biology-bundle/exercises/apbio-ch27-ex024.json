  {
   "id": 535715,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe how gustation and olfaction are similar.",
   "answers": [
    {
     "id": 1049151,
     "content_html": "Both sense different stimuli in the environment."
    },
    {
     "id": 1049152,
     "content_html": "Both can have hundreds of millions of types of receptors."
    },
    {
     "id": 1049153,
     "content_html": "Both obtain stimuli from within the body."
    },
    {
     "id": 1049154,
     "content_html": "Signals from both are transmitted through the medulla."
    }
   ],
