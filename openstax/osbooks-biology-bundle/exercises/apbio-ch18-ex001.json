 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp129618288\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"9\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n<span data-type=\"media\" id=\"fs-idp179668784\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/373f01aed0c6f7a5516d25354f55dc250cbd5ef0\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"10\">\n</span>\n<p id=\"fs-idp120562304\">Visit this <a href=\"https://openstaxcollege.org/l/bone_structures\" target=\"_blank\" rel=\"noopener nofollow\">interactive site</a> to guess which bones structures are homologous and which are analogous, and see examples of evolutionary adaptations to illustrate these concepts.</p>\n</div>\n</div>\n",
 "stimulus_html": "",
 "questions": [
  {
   "id": 233432,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the basic difference between things that are homologous and things that are analogous?",
   "answers": [
    {
     "id": 723871,
     "content_html": "Things that are analogous look similar and things that are homologous do not."
    },
    {
     "id": 723872,
     "content_html": "Things that are analogous have the same function and things that are homologous have different functions."
    },
    {
     "id": 723873,
     "content_html": "Things that are analogous are not a result of evolution, whereas things that are homologous are."
    },
    {
     "id": 723874,
     "content_html": "Things that are analogous result from convergence and things that are homologous result from common ancestry"
    }
   ],
