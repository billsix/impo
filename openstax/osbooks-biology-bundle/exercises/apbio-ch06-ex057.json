   "id": 503143,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Statins reduce the level of cholesterol in the blood. Based on the everyday connection, which of the following might also reduce cholesterol levels in the blood?",
   "answers": [
    {
     "id": 988703,
     "content_html": "a drug that increases HMG-CoA reductase levels"
    },
    {
     "id": 988704,
     "content_html": "a drug that reduces cyclooxygenase levels"
    },
    {
     "id": 988705,
     "content_html": "a drug that reduces lipid levels in the body"
    },
    {
     "id": 988706,
     "content_html": "a drug that blocks the action of acetaminophen"
    }
   ],
