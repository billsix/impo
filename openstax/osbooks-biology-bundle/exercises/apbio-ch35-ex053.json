 "questions": [
  {
   "id": 640374,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain the challenges facing organisms living in the intertidal zone and their adaptations to meet these challenges.",
   "answers": [
    {
     "id": 1248987,
     "content_html": "They are subject to constant exposure to air, sunlight, periods of dryness, and pounding waves. For this reason, some species have an exoskeleton."
    },
    {
     "id": 1248988,
     "content_html": "They are subject to periodic exposures to air, sunlight, periods of dryness, and pounding waves. For this reason, some species have an exoskeleton."
    },
    {
     "id": 1248986,
     "content_html": "They are subject to periodic exposures to air, sunlight, periods of dryness, and pounding waves. For this reason, all species have an exoskeleton."
    },
    {
     "id": 1248985,
     "content_html": "They are subject to periodic exposures to air, sunlight, periods of dryness, and pounding waves. For this reason, most species have an endoskeleton."
    }
   ],
