  {
   "id": 519770,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A student reported vascular tissue while inspecting a cross-section of a plant stem under the microscope. Which cells would allow the student to identify vascular tissue?",
   "answers": [
    {
     "id": 1014603,
     "content_html": "tracheids, vessel elements, sieve-tube cells, and companion cells"
    },
    {
     "id": 1014604,
     "content_html": "cells actively dividing at the apex of the stem"
    },
    {
     "id": 1014605,
     "content_html": "parenchyma cells at the center of the section"
    },
    {
     "id": 1014606,
     "content_html": "cells covered by a cuticle at the outside edge of the section"
    }
   ],
