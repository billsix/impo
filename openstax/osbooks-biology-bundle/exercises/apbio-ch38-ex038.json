 "questions": [
  {
   "id": 532020,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Backpackers returning from a long trip abroad are stopped by customs and asked whether they brought back plants, flowers or fruit from their trip location. Their fruit bought at a local market is confiscated. Why was the fruit confiscated?",
   "answers": [
    {
     "id": 1040876,
     "content_html": "The hikers are supposed to pay duty on imported fruit."
    },
    {
     "id": 1040877,
     "content_html": "The fruit can be processed to produce illicit drugs."
    },
    {
     "id": 1040878,
     "content_html": "The fruit seed could be planted and could eliminate all local species."
    },
    {
     "id": 1040879,
     "content_html": "The fruit may introduce new exotic pests that threaten local plants."
    }
   ],
