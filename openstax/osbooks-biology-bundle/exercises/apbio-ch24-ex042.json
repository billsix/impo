 "questions": [
  {
   "id": 521047,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can an environmental change result in an alteration of gland secretion?",
   "answers": [
    {
     "id": 1018497,
     "content_html": "A receptor detects change, sends a signal to the control center, which sends a signal to the gland to inhibit the gland secretions."
    },
    {
     "id": 1018498,
     "content_html": "A receptor detects change, sends a signal to the control center, which sends a signal to the gland to increase the secretions of the gland."
    },
    {
     "id": 1018499,
     "content_html": "A receptor detects change and sends a signal to the effector directly ,which in this case is the gland."
    },
    {
     "id": 1018500,
     "content_html": "A receptor detects change, sends a signal to the control center, which in turn sends a signal to the effector, which in this case is the gland."
    }
   ],
