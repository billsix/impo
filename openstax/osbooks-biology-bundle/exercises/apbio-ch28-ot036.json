 "questions": [
  {
   "id": 546596,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why it would be problematic if most hormones were regulated by a positive feedback loop.",
   "answers": [
    {
     "id": 1071536,
     "content_html": "Excessive production of actions would be stimulated by hormones such as growth and blood glucose levels."
    },
    {
     "id": 1071537,
     "content_html": "Production of actions would be reduced by hormones such as growth and blood glucose levels."
    },
    {
     "id": 1071538,
     "content_html": "Inhibition of GnRH production by increase in gonad hormone levels."
    },
    {
     "id": 1071539,
     "content_html": "Inhibition of release of insulin by decrease in blood glucose concentrations."
    }
   ],
