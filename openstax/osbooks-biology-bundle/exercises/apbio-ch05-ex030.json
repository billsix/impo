 "questions": [
  {
   "id": 503071,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Salmonella is one of the most common food borne illnesses. When a white blood cell engulfs salmonella bacteria during phagocytosis, salmonella secretes a protein that prevents the fusion of the encased bacteria with the lysosome of the cell. What effect would this have?",
   "answers": [
    {
     "id": 988415,
     "content_html": "The bacteria will be destroyed and will not cause any illness."
    },
    {
     "id": 988416,
     "content_html": "The bacteria will survive but will not cause illness."
    },
    {
     "id": 988417,
     "content_html": "The bacteria will be destroyed, but will still cause illness."
    },
    {
     "id": 988418,
     "content_html": "The bacteria will survive and possibly will cause illness."
    }
   ],
