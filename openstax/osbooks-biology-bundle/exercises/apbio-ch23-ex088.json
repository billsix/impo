  {
   "id": 241472,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In the Northern Hemisphere, owners and managers of plant nurseries have to plan lighting schedules for a long-day plant that will flower in February. What lighting periods and color will be most effective?",
   "answers": [
    {
     "id": 755351,
     "content_html": "Long periods of illumination with light enriched in the red range of the spectrum"
    },
    {
     "id": 755348,
     "content_html": "Short periods of illumination with light enriched in the red range of the spectrum"
    },
    {
     "id": 755349,
     "content_html": "Long periods of illumination with light enriched in the far-red range of the spectrum"
    },
    {
     "id": 755350,
     "content_html": "Short periods of illumination with light enriched in the far-red range of the spectrum"
    }
   ],
