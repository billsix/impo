 "questions": [
  {
   "id": 639652,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Common medications called β-blockers bind to G-protein-linked receptors in heart muscles, blocking adrenaline. They are prescribed to patients with high blood pressure. Based on your understanding of G-protein-linked receptors, can you formulate a hypothesis on their mechanism of action? Evaluate and select from the options given below.",
   "answers": [
    {
     "id": 1246147,
     "content_html": "Adrenaline has a stimulatory effect on heart rate and blood pressure. β-blockers are antagonistic to adrenaline and produce an inhibitory effect."
    },
    {
     "id": 1246146,
     "content_html": "Adrenaline has both a stimulatory and an inhibitory effect on heart rate and blood pressure. β-blockers bind to G-protein-linked receptors and stimulate the inhibitory effect of adrenaline."
    },
    {
     "id": 1246145,
     "content_html": "Adrenaline has an inhibitory effect on heart rate and blood pressure. β-blockers have a synergistic effect along with adrenaline, producing an inhibitory effect."
    },
    {
     "id": 1246144,
     "content_html": "Adrenaline has both a stimulatory and an inhibitory effect on heart rate and blood pressure. β-blockers bind to G-protein-linked receptors and intervene with the inhibitory effect of adrenaline."
    }
   ],
