   "stimulus_html": "",
   "stem_html": "What is a protein’s chaperone?",
   "answers": [
    {
     "id": 1004008,
     "content_html": "a chemical that assists the protein in its enzymatic functions"
    },
    {
     "id": 1004009,
     "content_html": "a second protein that completes the quaternary structure"
    },
    {
     "id": 1004010,
     "content_html": "a chemical that helps the protein fold properly"
    },
    {
     "id": 1004011,
     "content_html": "a chemical that functions as a cofactor for the protein"
    }
