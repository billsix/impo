 "questions": [
  {
   "id": 520113,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe a typical prokaryotic cell.",
   "answers": [
    {
     "id": 1015937,
     "content_html": "It has a cell wall enclosing cell membrane, cytoplasm, ribosomes and nucleoid region with genetic material. It may have a protective capsule, flagellum, pili and plasmids."
    },
    {
     "id": 1015938,
     "content_html": "It has a cell wall enclosing cell membrane, cytoplasm, ribosomes and nucleus containing genetic material. It may have a protective capsule, flagellum, pili and plasmids."
    },
    {
     "id": 1015939,
     "content_html": "It has a cell wall enclosing nuclear membrane, cytoplasm, ribosomes and nucleoid region with genetic material. It may have a protective capsule, flagellum, pili and plasmids."
    },
    {
     "id": 1015940,
     "content_html": "It has a cell wall enclosing nuclear membrane, cytoplasm, mitochondria, vacuoles and nucleoid region with genetic material. It may have a protective capsule, flagellum, pili and plasmids."
    }
   ],
