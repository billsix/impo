   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Based on your understanding of activation energy <i>E</i><sub>A</sub>, is the <i>E</i><sub>A</sub> for ATP hydrolysis relatively low or high? Explain your reasoning.",
   "answers": [
    {
     "id": 988687,
     "content_html": "<i>E</i><sub>A</sub> for ATP hydrolysis is high because considerable energy is released."
    },
    {
     "id": 988688,
     "content_html": "<i>E</i><sub>A</sub> for ATP hydrolysis is high because a low amount of energy is released."
    },
    {
     "id": 988689,
     "content_html": "<i>E</i><sub>A</sub> for ATP hydrolysis is low because considerable energy is released."
    },
    {
     "id": 988690,
     "content_html": "<i>E</i><sub>A</sub> for ATP hydrolysis is intermediate because considerable energy is released."
