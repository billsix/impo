   "id": 233443,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which best describes what happens when an antibiotic is applied to a population of bacteria?",
   "answers": [
    {
     "id": 723917,
     "content_html": "The bacteria develops resistance to the antibiotic in direct response to its application."
    },
    {
     "id": 723916,
     "content_html": "The bacteria’s genetic material mutates in response to the antibiotic, resulting in resistance."
    },
    {
     "id": 723915,
     "content_html": "A gene for resistance, already present in the population, decreases in frequency."
    },
    {
     "id": 723918,
