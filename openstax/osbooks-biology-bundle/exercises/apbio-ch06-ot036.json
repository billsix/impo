   "stem_html": "What is the function of enzymes?",
   "answers": [
    {
     "id": 720477,
     "content_html": "to increase the free energy of reactions"
    },
    {
     "id": 720476,
     "content_html": "to increase the the sum of the heats of formation"
    },
    {
     "id": 720475,
     "content_html": "to lower the randomness of the chemicals in the reaction"
    },
    {
     "id": 720478,
     "content_html": "to lower the activation energy of a reaction"
    }
