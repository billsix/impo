   "id": 232681,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/bf753b51829db37e.jpg\" alt=\"A chloroplast is shown. Letter A points to the outermost surface of the chloroplast. Letter E points to the inner covering directly underneath the outermost surface. Letter C points to a stack of green, flattened disks. Letter B points to the space surrounding the green stacks of flattened disks. Letter D points to a single disk within one of the stacks of flattened disks.\"></p>\n\n<p>Correctly label the indicated parts of a chloroplast.</p>\n",
   "answers": [
    {
     "id": 720867,
     "content_html": "A. stroma, B. outer membrane, C. granum, D. thylakoid, E. inner membrane"
    },
    {
     "id": 720870,
     "content_html": "A. outer membrane, B. stroma, C. granum, D. thylakoid, E. inner membrane"
