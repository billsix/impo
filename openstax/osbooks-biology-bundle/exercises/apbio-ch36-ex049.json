 "questions": [
  {
   "id": 242604,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why doesn’t a frog, which is an r-selected species, care for its offspring in the way a wolf, which is a K-selected species, cares for its offspring?",
   "answers": [
    {
     "id": 759875,
     "content_html": "Frogs have been selected by stable, predictable environments, therefore they do not feel the need to care for their offspring like wolves."
    },
    {
     "id": 759876,
     "content_html": "Frogs use very little energy to produce large numbers of offspring, therefore they do not have enough remaining to nurture them."
    },
    {
     "id": 759877,
     "content_html": "Smaller animals like frogs do not care for their offspring as a lot of them are produced whereas larger animals like wolves only produce a few."
    },
    {
     "id": 759878,
     "content_html": "Frogs expend a lot of energy to produce large numbers of offspring, therefore they do not have enough to nurture them."
    }
   ],
