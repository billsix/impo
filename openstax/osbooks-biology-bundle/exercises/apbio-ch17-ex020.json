 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1550132\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"5\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n<span data-type=\"media\" id=\"fs-id1612653\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/eede7e3a7276424eaabf40fd650e95bdc2393dd3\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"6\"> </span> \n<p id=\"fs-id1465546\">Online Mendelian Inheritance in Man (OMIM) is a searchable online catalog of human genes and genetic disorders. This website shows genome mapping information, and also details the history and research of each trait and disorder. Click this <a href=\"https://openstaxcollege.org/l/OMIM\" target=\"_blank\" rel=\"noopener nofollow\">link</a> to search for traits (such as handedness) and genetic disorders (such as diabetes).</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 233362,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can this database help to support and guide research for rare genetic conditions, like progeria?",
   "answers": [
    {
     "id": 723593,
     "content_html": "The database provides information related to the prevention of a genetic disease."
    },
    {
     "id": 723594,
     "content_html": "The database provides all the information about genes for genetic diseases, their inheritance and their expression. It also provides suggestions for some treatments."
    },
    {
     "id": 723592,
     "content_html": "The database provides information about the symptoms of the disease."
    },
    {
     "id": 723591,
     "content_html": "The database provides information only about the early reported cases."
    }
   ],
