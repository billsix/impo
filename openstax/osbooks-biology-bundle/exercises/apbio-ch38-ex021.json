   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would be the most effective approach to reversing the damage of overfishing?",
   "answers": [
    {
     "id": 1040428,
     "content_html": "Ban all fishing in the oceans of the world for ten years."
    },
    {
     "id": 1040429,
     "content_html": "The damage is irreparable and no measure will reverse the loss."
    },
    {
     "id": 1040430,
     "content_html": "Fish only overabundant invasive species."
    },
    {
     "id": 1040431,
     "content_html": "Set aside 40% of the world's oceans as no-fishing zones with international cooperation for enforcement."
    }
