 "questions": [
  {
   "id": 511839,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements describes prokaryotic transcription of the lac operon?",
   "answers": [
    {
     "id": 1000994,
     "content_html": "When lactose and glucose are present in the medium, transcription of the lac operon is induced."
    },
    {
     "id": 1000995,
     "content_html": "When lactose is present but glucose is absent, the lac operon is repressed."
    },
    {
     "id": 1000996,
     "content_html": "Lactose acts as an inducer of the lac operon when glucose is absent."
    },
    {
     "id": 1000997,
     "content_html": "Lactose acts as an inducer of the lac operon when glucose is present."
    }
   ],
