 "questions": [
  {
   "id": 503502,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Hemophilia is a rare condition in which the blood lacks sufficient clotting factors. These factors are required for the platelets to bind together and form clots. How does the absence of clotting interfere with the cell signals during wound healing?",
   "answers": [
    {
     "id": 989991,
     "content_html": "delay and prevention of the cell signal required for wound healing"
    },
    {
     "id": 989992,
     "content_html": "activate the cell signal required for wound healing"
    },
    {
     "id": 989993,
     "content_html": "activate and enhance the cell signals for wound healing"
    },
    {
     "id": 989994,
     "content_html": "cell signal will remain unaffected"
    }
   ],
