 "questions": [
  {
   "id": 639887,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which best summarizes the conditions of early Earth at the time that life first evolved?",
   "answers": [
    {
     "id": 1247066,
     "content_html": "The atmosphere of early Earth was very different from today’s atmosphere, but most other conditions (such as geologic upheaval and volcanic activity) were very much the same."
    },
    {
     "id": 1247065,
     "content_html": "The atmosphere of early Earth was very much like today’s atmosphere, but many other conditions (such as geologic upheaval and volcanic activity) were very different."
    },
    {
     "id": 1247067,
     "content_html": "Early Earth had a very different atmosphere, was subject to extreme radiation, and had a lot of geologic upheaval and volcanic activity."
    },
    {
     "id": 1247064,
     "content_html": "Early Earth had a very different atmosphere and was subject to extreme radiation, but there was very little geologic upheaval or volcanic activity."
    }
   ],
