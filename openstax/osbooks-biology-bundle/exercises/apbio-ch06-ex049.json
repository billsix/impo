   "id": 503123,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why the lock-and-key model does not adequately represent the relationship between hexokinase and glucose.",
   "answers": [
    {
     "id": 988623,
     "content_html": "Hexokinase changes conformation in presence of glucose"
    },
    {
     "id": 988624,
     "content_html": "Hexokinase induces change in the glucose structure"
    },
    {
     "id": 988625,
     "content_html": "Hexokinase requires an effector molecule to bind at allosteric site"
    },
    {
     "id": 988626,
     "content_html": "Hexokinase binds glucose without any conformational change"
    }
