  {
   "id": 334299,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Apply your understanding of the various components of the electron transport chain to evaluate how the roles of ubiquinone and cytochrome c differ from those of the other components.",
   "answers": [
    {
     "id": 842845,
     "content_html": "CoQ and cytochrome c covalently bind electrons, while NADH dehydrogenase and succinate dehydrogenase are bound to the inner mitochondrial membrane."
    },
    {
     "id": 842846,
     "content_html": "CoQ and cytochrome c are bound to the inner mitochondrial membrane, while NADH dehydrogenase and succinate dehydrogenase are mobile electron carriers."
    },
    {
     "id": 842847,
     "content_html": "CoQ and cytochrome c covalently bind electrons, while NADH dehydrogenase and succinate dehydrogenase are mobile electron carriers."
    },
    {
     "id": 842848,
     "content_html": "CoQ and cytochrome c are mobile electron carriers, while NADH dehydrogenase and succinate dehydrogenase are bound to the inner mitochondrial membrane."
    }
