 "questions": [
  {
   "id": 639673,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the general conditions that must be met at each of the three main cell cycle checkpoints.",
   "answers": [
    {
     "id": 1246229,
     "content_html": "<span data-math=\"\\text{G}_1\">\\text{G}_1</span> checkpoint - assessment of DNA damage, <span data-math=\"\\text{G}_2\">\\text{G}_2</span> - assessment of new DNA, M checkpoint - segregation of sister chromatids in anaphase."
    },
    {
     "id": 1246230,
     "content_html": "<span data-math=\"\\text{G}_1\">\\text{G}_1</span> checkpoint - Energy reserves for s phase, <span data-math=\"\\text{G}_2\">\\text{G}_2</span> checkpoint - assessment of new DNA, M checkpoint- attachment of spindle to kinetochore."
    },
    {
     "id": 1246228,
     "content_html": "<span data-math=\"\\text{G}_1\">\\text{G}_1</span> checkpoint - assessment of DNA damage, <span data-math=\"\\text{G}_2\">\\text{G}_2</span> checkpoint - energy reserves for DNA, M checkpoint - attachment of spindle to kinetochore"
    },
    {
     "id": 1246227,
     "content_html": "<span data-math=\"\\text{G}_1\">\\text{G}_1</span> checkpoint - Energy reserves for S-phase, S checkpoint - synthesis of DNA, <span data-math=\"\\text{G}_2\">\\text{G}_2</span> checkpoint - assessment of new DNA"
    }
   ],
