 "questions": [
  {
   "id": 519563,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statements list two advantages of a taproot?",
   "answers": [
    {
     "id": 1014375,
     "content_html": "It anchors the plant, so that it is not easily uprooted by predators or wind. It is a sink for proteins that is protected from herbivores by being underground."
    },
    {
     "id": 1014376,
     "content_html": "It anchors the plant, so that it is not easily uprooted by predators or wind. It is a source of starches that is protected from herbivores by being underground."
    },
    {
     "id": 1014377,
     "content_html": "It anchors the plant, so that it cannot be uprooted by predators or wind. It is a sink for starches that is protected from herbivores by being underground."
    },
