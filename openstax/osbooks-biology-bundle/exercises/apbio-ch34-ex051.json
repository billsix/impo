 "questions": [
  {
   "id": 238510,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the possible event that would occur if the corpus luteum did not produce increasing amounts of progesterone.",
   "answers": [
    {
     "id": 743775,
     "content_html": "The implanted zygote will not be able to derive sufficient nutrition from the endometrium."
    },
    {
     "id": 743776,
     "content_html": "Even if fertilization is successful, the zygote may not be able to implant successfully. If it does manage to implant, it will not be able to derive sufficient nutrition from the myometrium."
    },
    {
     "id": 743778,
     "content_html": "Even if fertilization is successful, the zygote may not be able to implant successfully. If it does manage to implant, it will not be able to derive sufficient nutrition from the endometrium."
    },
    {
     "id": 743777,
     "content_html": "The contraction of the uterus during childbirth and lactation will not take place, causing problems and complications in the mother."
    }
   ],
