 "questions": [
  {
   "id": 511843,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would be the outcome of a mutation that prevented DNA bending proteins from being produced?",
   "answers": [
    {
     "id": 1001010,
     "content_html": "decreased transcription because transcription factors would not bind to transcription binding sites"
    },
    {
     "id": 1001011,
     "content_html": "decreased transcription because enhancers would not be able to bind to transcription factors"
    },
    {
     "id": 1001012,
     "content_html": "increased transcription because repressors would not be able to bind to promoter regions"
    },
    {
     "id": 1001013,
     "content_html": "increased transcription because RNA polymerase would be able to increase binding to promoter regions"
    }
   ],
