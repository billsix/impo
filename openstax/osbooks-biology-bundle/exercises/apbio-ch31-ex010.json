 "questions": [
  {
   "id": 529739,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Insects have open circulatory systems in which blood, or hemolymph, circulates through the body cavity rather than through closed blood vessels. Birds, like other vertebrates, have closed circulatory systems in which blood remains within arteries, veins, and capillaries as it circulates. Based on their difference in circulatory system, which of the following statements best describes an organism that would be favored by selection during a food shortage?",
   "answers": [
    {
     "id": 1036892,
     "content_html": "Insects would be favored because an open circulatory system requires less energy."
    },
    {
     "id": 1036893,
     "content_html": "Insects would be favored because an open circulatory system stores energy."
    },
    {
     "id": 1036894,
     "content_html": "Birds would be favored because a closed circulatory system loses less energy to heat."
    },
    {
     "id": 1036895,
     "content_html": "Birds would be favored because a closed circulatory system is more efficient at delivering nutrients."
    }
   ],
