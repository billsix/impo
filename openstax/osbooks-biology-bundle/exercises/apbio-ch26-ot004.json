 "questions": [
  {
   "id": 524234,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Chemical synapse is a multiple-step process in which neurotransmitters undergo transfer and binding to different parts of the cell. What happens when a neurotransmitter binds to ligand-gated ion channels?",
   "answers": [
    {
     "id": 1029264,
     "content_html": "The ligand-gated ion channels open."
    },
    {
     "id": 1029265,
     "content_html": "The presynaptic neuron reuptakes the neurotransmitter."
    },
    {
     "id": 1029266,
     "content_html": "The neurotransmitter diffuses away from the synapse."
    },
    {
     "id": 1029267,
     "content_html": "The neurotransmitter is enzymatically degraded."
    }
   ],
