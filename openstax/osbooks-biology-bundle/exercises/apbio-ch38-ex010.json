 "questions": [
  {
   "id": 614111,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is a likely reason that small animals survived the cataclysmic impact of a large meteorite that caused the massive extinction at the Cretaceous-Paleocene?",
   "answers": [
    {
     "id": 1164431,
     "content_html": "Small animals stopped being hunted by dinosaurs."
    },
    {
     "id": 1164432,
     "content_html": "Small animals do not depend on plants for food."
    },
    {
     "id": 1164434,
     "content_html": "Small animals needed less food for survival and reproduce rapidly."
    },
    {
     "id": 1164433,
     "content_html": "Small animals fed on the dead dinosaurs."
    }
   ],
