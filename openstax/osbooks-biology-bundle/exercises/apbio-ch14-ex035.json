 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1366889\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-id1676042\" data-alt=\"QR Code representing a URL\">\n    <img src=\"https://openstax.org/apps/archive/20240910.161227/resources/ac8619e4d2c40df079d161f6c11c46f8104888ca\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n    <p id=\"fs-id2171177\">Click through <a href=\"https://openstaxcollege.org/l/DNA_replicatio2\" target=\"_blank\" rel=\"noopener nofollow\">this tutorial</a> on DNA replication.</p>\n</div>\n</div>",
