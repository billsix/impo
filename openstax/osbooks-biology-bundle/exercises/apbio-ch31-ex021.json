 "questions": [
  {
   "id": 640281,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the structure of red blood cells allow them to deliver oxygen to the cells of the body?",
   "answers": [
    {
     "id": 1248624,
     "content_html": "Their size and shape allow them to carry and transfer oxygen."
    },
    {
     "id": 1248623,
     "content_html": "Their disc shape contains many small vesicles that allow them to carry and transfer oxygen."
    },
    {
     "id": 1248622,
     "content_html": "They have nuclei and do not contain hemoglobin."
    },
    {
     "id": 1248621,
     "content_html": "They contain coagulation factors and antibodies."
    }
   ],
