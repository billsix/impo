 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm64089424\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-idm19899760\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/a186d5f4646164cfd662b2ec5d9a3de26c3d8351\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idm14682544\">Watch a <a href=\"https://openstaxcollege.org/l/black_death\" target=\"_blank\" rel=\"noopener nofollow\">video</a> on the modern understanding of the Black Death—bubonic plague in Europe during the 14<sup>th</sup> century.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 520270,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How were researchers able to use modern science to determine the agent of disease for the bubonic plague of the 14th century?",
   "answers": [
    {
     "id": 1016531,
     "content_html": "The amino acid sequence of proteins, extracted from the samples taken from skeletons buried in a cemetery from the 14th century, was constructed and compared to that of modern strain of the bacterium <i>Y. enterocolitica</i> and found a close match."
    },
    {
     "id": 1016532,
     "content_html": "The genomic sequence of the DNA, extracted from the samples taken from skeletons buried in a cemetery from the 14th century, was constructed and compared to that of modern strain of the bacterium <i>Y. enterocolitica</i> and found a close match."
    },
    {
     "id": 1016533,
     "content_html": "The gene sequence of 16S rRNA, extracted from the samples taken from skeletons buried in a cemetery from the 14th century, was constructed and compared to that of modern strain of the bacterium <i>Y. pestis</i> and found a close match."
    },
    {
     "id": 1016534,
     "content_html": "The genomic sequence of the DNA, extracted from the samples taken from skeletons buried in a cemetery from the 14th century, was constructed and compared to that of modern strain of the bacterium <i>Y. pestis</i> and found a close match."
    }
   ],
