   "id": 519830,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Selective uptake of minerals in the root is measured and the results are analyzed. If you analyze the data, what should you see?",
   "answers": [
    {
     "id": 1014843,
     "content_html": "Pericycle is the tissue where selectivity takes place."
    },
    {
     "id": 1014844,
     "content_html": "The endodermis acts as a selective barrier for minerals taken up by the root."
    },
    {
     "id": 1014845,
     "content_html": "The epidermis acts as a selective barrier for minerals."
    },
    {
     "id": 1014846,
     "content_html": "The root cap functions as a selective barrier for minerals taken up by the root."
    }
   ],
