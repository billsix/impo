 "questions": [
  {
   "id": 238495,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain the fate of the newly released secondary oocyte after ovulation.",
   "answers": [
    {
     "id": 743717,
     "content_html": "If it fuses with a sperm, the resulting zygote enters the cervix for implantation. If it is not fertilized, it will return to the oviduct."
    },
    {
     "id": 743716,
     "content_html": "If it fuses with a sperm, the resulting zygote enters the uterus for implantation. If it is not fertilized, it will return to oviduct."
    },
    {
     "id": 743718,
     "content_html": "If it fuses with a sperm, the resulting zygote enters the uterus for implantation. If it is not fertilized, it will degrade and exit the body."
    },
    {
     "id": 743715,
     "content_html": "If it fuses with a sperm, the resulting zygote enters the cervix for implantation. If it is not fertilized, it will degrade and exit the body."
    }
