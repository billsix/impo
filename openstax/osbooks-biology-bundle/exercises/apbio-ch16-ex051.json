  {
   "id": 511869,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/4ea63d936548a180.jpg\" alt=\"Operon showing in a line: promoter, operator, trpE, trpD, trpC, trpB, and trpA\"></p>\n\n<p>What happens in the absence of tryptophan?</p>\n",
   "answers": [
    {
     "id": 1001114,
     "content_html": "RNA polymerase binds to the repressor"
    },
    {
     "id": 1001115,
     "content_html": "the repressor binds to the promoter"
    },
    {
     "id": 1001116,
     "content_html": "the repressor dissociates from the operator"
    },
    {
     "id": 1001117,
     "content_html": "RNA polymerase dissociates from the promoter"
    }
   ],
