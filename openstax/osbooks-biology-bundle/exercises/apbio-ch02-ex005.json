 "questions": [
  {
   "id": 503196,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Use the periodic table to describe what a Bohr model of Fluorine (F) would look like and explain why the Bohr model is not an accurate representation of the electron orbitals in fluorine.",
   "answers": [
    {
     "id": 988915,
     "content_html": "A Bohr model would have 2 electron rings, and a Bohr model would not give information about atomic mass"
    },
    {
     "id": 988916,
     "content_html": "A Bohr model would have one electron ring, and a Bohr model would not show the sub-shells of first ring"
    },
    {
     "id": 988917,
     "content_html": "A Bohr model would have 2 electron rings, and a Bohr model would not show the sub-shell of second ring"
    },
    {
     "id": 988918,
     "content_html": "A Bohr model would have one electron ring, and a Bohr model would not give information about number of electron in each ring"
    }
   ],
