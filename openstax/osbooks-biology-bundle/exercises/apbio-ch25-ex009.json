   "stimulus_html": "",
   "stem_html": "Which of the following statements about digestion is true?",
   "answers": [
    {
     "id": 1020624,
     "content_html": "Pepsin is converted to pepsinogen with the help of hydrochloric acid."
    },
    {
     "id": 1020625,
     "content_html": "Starch digestion begins in the mouth."
    },
    {
     "id": 1020626,
     "content_html": "Wave-like muscle movements called peristalsis move food from the stomach to the mouth."
    },
    {
     "id": 1020627,
     "content_html": "Amino acids are absorbed through the intestinal lining of the ileum."
    }
