  {
   "id": 503178,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why the bonds within a water molecule are described as polar covalent bonds.",
   "answers": [
    {
     "id": 988843,
     "content_html": "Hydrogen is more electronegative than oxygen, generating a partial negative charge near the hydrogen atom."
    },
    {
     "id": 988844,
     "content_html": "Hydrogen is more electronegative than oxygen, generating a partial positive charge near the hydrogen atom."
    },
    {
     "id": 988845,
     "content_html": "Oxygen is more electronegative than hydrogen, generating a partial negative charge near the oxygen atoms."
    },
    {
     "id": 988846,
     "content_html": "Oxygen is more electronegative than hydrogen, generating a partial positive charge near the oxygen atoms."
    }
