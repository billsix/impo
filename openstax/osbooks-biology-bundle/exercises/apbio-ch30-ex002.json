 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm57421024\" class=\"interactive-embedded-homework\" data-label=\"\">\n<div data-type=\"title\">Link to Learning</div>\n<span data-type=\"media\" id=\"fs-idm66824288\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/c63ea8f96c89c5b6687c449d43cc686b10aa30bd\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idm160014560\">Watch the following video to review the respiratory system.\n</p>\n<div data-type=\"media\" id=\"eip-id1171744721747\" data-alt=\"lungs_pulmonary\">\n<div class=\"os-has-iframe os-has-link\" data-type=\"switch\">\n<a class=\"os-is-link\" href=\"https://openstax.org/books/biology/pages/39-1-systems-of-gas-exchange\" target=\"_blank\" rel=\"noopener nofollow\" data-media=\"print\">Access multimedia content</a>\n<iframe width=\"660\" height=\"371.4\" src=\"https://www.openstaxcollege.org/l/lungs_pulmonary\" class=\"os-is-iframe\" data-media=\"screen\"><!-- no-selfclose --></iframe>\n</div>\n                 </div>\n</div>",
