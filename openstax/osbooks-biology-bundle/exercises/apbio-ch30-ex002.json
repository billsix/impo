 "questions": [
  {
   "id": 547178,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how the structures of the nasal cavity, oral cavity, and pharynx allow one to breathe even when their nostrils are congested due to a cold.",
   "answers": [
    {
     "id": 1073781,
     "content_html": "The trachea extends into the nose and mouth."
    },
    {
     "id": 1073782,
     "content_html": "The pharynx connects the nasal cavity to the lungs, while the larynx connects the oral cavity to the lungs."
    },
    {
     "id": 1073783,
     "content_html": "The oral and nasal cavities connect to separate lungs."
    },
    {
     "id": 1073784,
     "content_html": "The nasal and oral cavities combine above the pharynx."
    }
   ],
