 "questions": [
  {
   "id": 241213,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/c2748940d2087bd8.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Sean Michael Scully/<i>Science in School</i>)</figcaption>\n</figure>",
   "stem_html": "<p>This graph shows the growth rate of five types of bacteria at different temperatures.</p>\n<p>Separate colonies of each of these bacteria are kept at 45°C for an extended amount of time. Which bacteria would you expect to thrive at such temperatures?</p>",
   "answers": [
    {
     "id": 754316,
     "content_html": "All the colonies would show some growth."
    },
    {
     "id": 754315,
     "content_html": "Thermoanaerobacterium AK17 and thermoanaerobakter AK15 would grow. The rest would not."
    },
    {
     "id": 754317,
     "content_html": "Thermoanaerobacterium AK17, Clostridium AK1 and E. coli CCSC would grow. The rest would not."
    },
    {
     "id": 754314,
     "content_html": "Clostridium AK1, E. coli CCSC and Paenibacillus VH01017 would grow. The rest would not."
    }
   ],
