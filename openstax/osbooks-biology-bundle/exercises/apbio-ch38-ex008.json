  {
   "id": 531786,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Findings from layers dating to the Cambrian geological period show an appearance of many new organisms in addition to older forms of life. The Cambrian explosion corresponds to a time where _____.",
   "answers": [
    {
     "id": 1040060,
     "content_html": "new species radiated from existing species"
    },
    {
     "id": 1040061,
     "content_html": "new species appeared due to spontaneous mutations"
    },
    {
     "id": 1040062,
     "content_html": "ancient species were replaced by newly evolved species"
    },
    {
     "id": 1040063,
     "content_html": "a massive die-out freed ecosystems for new species"
    }
   ],
