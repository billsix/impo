 "context": "<figure id=\"fig-ch15_04_02\"><span data-type=\"media\" id=\"fs-id1480619\" data-alt=\"Illustration shows a spliceosome bound to mRNA. An intron is wrapped around snRNPs associated with the spliceosome. When the splice is complete, the exons on either side of the intron are fused together, and the intron forms a ring structure.\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/f028ff6fc2e744e01aa128971f06dbbdd02c1cb8\" data-media-type=\"image/jpg\" alt=\"Illustration shows a spliceosome bound to mRNA. An intron is wrapped around snRNPs associated with the spliceosome. When the splice is complete, the exons on either side of the intron are fused together, and the intron forms a ring structure.\" width=\"280\" id=\"5\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 334615,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Errors in splicing are implicated in cancers and other human diseases. What kinds of mutations might lead to splicing errors? Think of different possible outcomes if splicing errors occur.",
   "answers": [
    {
     "id": 844090,
     "content_html": "Mutations in the spliceosome recognition sequence at each end of an intron, or in the proteins and RNAs that make up the spliceosome, may occur. Mutations may also add new spliceosome recognition sites."
    },
    {
     "id": 844089,
     "content_html": "Mutations in the spliceosome recognition sequence at each end of an exon, or in the proteins and RNAs that make up the spliceosome, may occur. Mutations may also add new spliceosome recognition sites."
    },
    {
     "id": 844088,
     "content_html": "Mutations in the spliceosome recognition sequence at each end of an intron, or in the proteins and RNAs that make up the spliceosome, may occur. Mutations may also delete existing spliceosome recognition sites."
    },
    {
     "id": 844087,
     "content_html": "Mutations at the each end of intron and exon, or in the proteins and RNAs that make up the spliceosome, may occur. Mutations may also add new spliceosome recognition sites and delete existing sites."
    }
   ],
