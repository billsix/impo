  {
   "id": 513363,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the function of carotenoids in photosynthesis?",
   "answers": [
    {
     "id": 1005046,
     "content_html": "They supplement chlorophyll absorption."
    },
    {
     "id": 1005048,
     "content_html": "They are visible in the fall during leaf color changes."
    },
    {
     "id": 1005050,
     "content_html": "They absorb excess energy and dissipate it as heat."
    },
    {
     "id": 1005052,
     "content_html": "They limit chlorophyll absorption."
    }
   ],
