 "questions": [
  {
   "id": 232640,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You read the claim that glycolysis is an older and more conserved pathway than the citric acid cycle. Evaluate the statements below to select the evidence that provides the strongest support for this claim.",
   "answers": [
    {
     "id": 720705,
     "content_html": "Glycolysis takes place in anaerobic conditions, can metabolize cholesterol and fatty acids, and occurs even in methanogens."
    },
    {
     "id": 720704,
     "content_html": "This pathway occurs in the cytosol, is found in all animals and plants, and does not require oxygen."
    },
    {
     "id": 720706,
     "content_html": "Glycolysis is found in all three domains of living things. It also occurs in anaerobic conditions and in the cytosol."
    },
    {
     "id": 720703,
     "content_html": "This pathway only occurs in the mitochondria. It is highly flexible because it is found in almost all organisms."
    }
   ],
