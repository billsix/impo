 "questions": [
  {
   "id": 520409,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is the relationship between sustainable agriculture and nitrogen fixers called a symbiotic relationship?",
   "answers": [
    {
     "id": 1017041,
     "content_html": "Due to agrobacterium which are nitrogen fixers, plants benefit from an endless supply of nitrogen; soils benefit from being naturally fertilized and bacteria benefit from using photosynthates from plants."
    },
    {
     "id": 1017042,
     "content_html": "Due to rhizobia, which are nitrogen fixers, plants benefit from an endless supply of nitrogen; soils benefit from being naturally fertilized and bacteria benefit from using photosynthates from plants."
    },
    {
     "id": 1017043,
     "content_html": "Due to rhizobia, which are nitrogen fixers, plants benefit from an endless supply of nitrogen; soils benefit from being naturally fertilized and bacteria benefit from using potassium from plants."
    },
    {
     "id": 1017044,
     "content_html": "Due to rhizobia, which are nitrogen fixers, plants benefit from a limited supply of nitrogen; soils benefit from being naturally fertilized and bacteria benefit from using potassium from plants."
    }
   ],
