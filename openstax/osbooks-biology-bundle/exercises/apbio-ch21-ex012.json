 "questions": [
  {
   "id": 548464,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "We know that dogs don't catch the measles from their human companions. Apply your understanding of viruses to make an accurate claim as to why this is so.",
   "answers": [
    {
     "id": 1077575,
     "content_html": "Measles is a DNA virus, and DNA viruses cause human diseases."
    },
    {
     "id": 1077576,
     "content_html": "Dogs do not have glycoproteins."
    },
    {
     "id": 1077577,
     "content_html": "The measles virus can’t attach to dog cells."
    },
    {
     "id": 1077578,
     "content_html": "Dogs do not get RNA viruses."
    }
   ],
