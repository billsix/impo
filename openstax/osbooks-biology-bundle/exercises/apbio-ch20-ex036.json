 "questions": [
  {
   "id": 530364,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What effect has the advancement of DNA technology had on determining phylogeny?",
   "answers": [
    {
     "id": 1037408,
     "content_html": "Morphologic and molecular information often disagree."
    },
    {
     "id": 1037409,
     "content_html": "Scientists are struggling with molecular systematics."
    },
    {
     "id": 1037410,
     "content_html": "Information is not reliable because organisms appear to be closely related when they are not."
    },
    {
     "id": 1037411,
     "content_html": "Computer programs help determine relatedness using DNA sequencing, and morphologic and molecular information is more effective in determining phylogeny."
    }
   ],
