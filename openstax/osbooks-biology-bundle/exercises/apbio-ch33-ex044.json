 "questions": [
  {
   "id": 535486,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do antibodies isolated from the same individual show a variety of constant domains?",
   "answers": [
    {
     "id": 1048240,
     "content_html": "The antibodies were synthesized in response to infections by different pathogens."
    },
    {
     "id": 1048241,
     "content_html": "The antibodies were transmitted as the result of passive immunity."
    },
    {
     "id": 1048242,
     "content_html": "The antibodies have different specificities of antigen binding."
    },
    {
     "id": 1048243,
     "content_html": "The antibodies belong to different classes of immunoglobulin molecules."
    }
   ],
