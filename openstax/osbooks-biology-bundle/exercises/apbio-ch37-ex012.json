   "id": 550713,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is true of trophic levels in an ecosystem?",
   "answers": [
    {
     "id": 1082480,
     "content_html": "Food chains are accurate representations of dynamics in an ecosystem."
    },
    {
     "id": 1082481,
     "content_html": "In terrestrial ecosystems, primary producers commonly eat plants."
    },
    {
     "id": 1082482,
     "content_html": "Food webs are easier to interpret than food chains."
    },
    {
     "id": 1082483,
     "content_html": "The least amount of energy is available at the top of a food chain."
    }
   ],
