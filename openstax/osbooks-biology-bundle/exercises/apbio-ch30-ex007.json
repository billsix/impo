 "questions": [
  {
   "id": 619064,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the structure of alveoli maximize gas exchange?",
   "answers": [
    {
     "id": 1179612,
     "content_html": "Their sac-like structure increases their surface area."
    },
    {
     "id": 1179611,
     "content_html": "Their direct connection to the bronchi maximizes their access to air."
    },
    {
     "id": 1179610,
     "content_html": "They actively transport the gases between the air and blood."
    },
    {
     "id": 1179609,
     "content_html": "They are spheres that fully fill with blood, which will come in contact with air."
    }
   ],
