   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement about postzygotic barriers is false?",
   "answers": [
    {
     "id": 724029,
     "content_html": "They occur after fertilization."
    },
    {
     "id": 724028,
     "content_html": "They include hybrids that are sterile."
    },
    {
     "id": 724027,
     "content_html": "They include hybrid organisms that don’t survive the embryonic stage."
    },
    {
     "id": 724030,
     "content_html": "They include reproductive organ incompatibility."
    }
