   "id": 535127,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are the cause and treatment of Addison’s disease?",
   "answers": [
    {
     "id": 1047016,
     "content_html": "an excess of uric acid in the blood; uric acid-dissolving drugs"
    },
    {
     "id": 1047017,
     "content_html": "an inability to produce anti-diuretic hormone (ADH); drink excess water"
    },
    {
     "id": 1047018,
     "content_html": "an excess of K<sup>+</sup> secretion into the urine; take in excess potassium"
    },
    {
     "id": 1047019,
     "content_html": "an inability to produce aldosterone; take in excess sodium"
    }
   ],
