   "id": 532185,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A preserve design is proposed for a densely populated suburban area. Which overall design plan would be best for preservation of local ecosystems?",
   "answers": [
    {
     "id": 1041504,
     "content_html": "Set up many, small, protected areas."
    },
    {
     "id": 1041505,
     "content_html": "Select one, small area that is isolated from residences."
    },
    {
     "id": 1041506,
     "content_html": "Plan buffer zones around all backyard spaces."
    },
    {
     "id": 1041507,
     "content_html": "Set up several, larger areas to be set aside for natural ecosystems."
    }
   ],
