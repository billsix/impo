 "questions": [
  {
   "id": 639726,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why half of DNA is replicated in a discontinuous fashion.",
   "answers": [
    {
     "id": 1246436,
     "content_html": "Replication of the lagging strand occurs in the direction away from the replication fork in short stretches of DNA, since access to the DNA is always from the 5’ end. This results in pieces of DNA being replicated in a discontinuous fashion."
    },
    {
     "id": 1246433,
     "content_html": "Replication of the leading strand occurs in the direction away from the replication fork in short stretches of DNA, since access to the DNA is always from the 5’ end. This results in pieces of DNA being replicated in a discontinuous fashion."
    },
    {
     "id": 1246434,
     "content_html": "Replication of the lagging strand occurs in the direction of the replication fork in short stretches of DNA, since access to the DNA is always from the 5’ end. This results in pieces of DNA being replicated in a discontinuous fashion."
    },
    {
     "id": 1246435,
     "content_html": "Replication of the lagging strand occurs in the direction away from the replication fork in short stretches of DNA, since access to the DNA is always from the 3’ end. This results in pieces of DNA being replicated in a discontinuous fashion."
    }
   ],
