 "questions": [
  {
   "id": 285921,
   "is_answer_order_important": true,
   "stimulus_html": "<img src=\"exercises/media/f425ea3787e9c765.png\" alt=\"\">",
   "stem_html": "A scientist splices a eukaryotic promoter in front of a bacterial gene and inserts the gene in a bacterial chromosome. Would you expect the bacterium to transcribe the gene?",
   "answers": [
    {
     "id": 820098,
     "content_html": "Initially the bacterium will not transcribe it, but will transcribe after 5’ capping."
    },
    {
     "id": 820099,
     "content_html": "It will not transcribe it because there is no poly A tail in prokaryotes."
    },
    {
     "id": 820100,
     "content_html": "No, prokaryotes use different promoters than eukaryotes."
    },
    {
     "id": 820101,
     "content_html": "Yes, the bacterium would transcribe the eukaryotic gene."
    }
   ],
