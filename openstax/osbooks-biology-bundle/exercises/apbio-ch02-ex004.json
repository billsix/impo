 "questions": [
  {
   "id": 503198,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/93033fe923afd000.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by DePiep/Wikipedia, CC BY-SA 3.0)</figcaption>\n</figure>",
   "stem_html": "Salts are made of a bond between elements of group 1 (such as sodium) and elements of group 17 (such as chlorine). What type of bond forms between these atoms, and which is the electron donor?",
   "answers": [
    {
     "id": 988923,
     "content_html": "Ionic bond. Group 17 donates to group 1 to fill the outer valence shell."
    },
    {
     "id": 988924,
     "content_html": "Covalent bond. Both atoms share electrons equally to complete both outer valence shells."
    },
    {
     "id": 988925,
     "content_html": "Polar covalent bond. Group 17 donates to group 1 to fill the outer valence shell."
    },
    {
     "id": 988926,
     "content_html": "Ionic bond. Group 1 donates to group 17 to fill the outer valence shell."
    }
   ],
