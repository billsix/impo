 "questions": [
  {
   "id": 305647,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Does alternative gene splicing increase or decrease the flexibility of gene expression? Explain your answer.",
   "answers": [
    {
     "id": 825272,
     "content_html": "Flexibility increases because mRNA can be altered after transcription is completed."
    },
    {
     "id": 825273,
     "content_html": "Flexibility increases because genes can be divided and recombined into new genes."
    },
    {
     "id": 825274,
     "content_html": "Flexibility decreases because the mRNA molecule becomes smaller."
    },
    {
     "id": 825275,
     "content_html": "Flexibility decreases because DNA is degraded during alternative splicing."
    }
   ],
