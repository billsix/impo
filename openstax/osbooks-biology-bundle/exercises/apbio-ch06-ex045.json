   "id": 513423,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between the first and second laws of thermodynamics?",
   "answers": [
    {
     "id": 1005286,
     "content_html": "The first law involves creating energy while the second law involves expending it."
    },
    {
     "id": 1005287,
     "content_html": "The first law involves expending energy while the second involves creating it."
    },
    {
     "id": 1005288,
     "content_html": "The first law involves conserving energy while the second law involves the inability to recapture energy."
    },
    {
     "id": 1005289,
     "content_html": "The first law discusses creating energy while the second law discusses the energy requirement for reactions."
    }
   ],
