 "questions": [
  {
   "id": 529093,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/b6c84bb90ba83b89.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by James F. Gillooly, et al./PNAS)</figcaption>\n</figure>\n",
   "stem_html": "<p>The graph shows the total respiratory surface area against body mass for different animals.</p>\n<p>Make a claim based on this graph.</p>",
   "answers": [
    {
     "id": 1035780,
     "content_html": "Larger animals have larger respiratory surfaces."
    },
    {
     "id": 1035781,
     "content_html": "Larger animals have more efficient respiratory surfaces."
    },
    {
     "id": 1035782,
     "content_html": "Smaller animals have higher metabolic rates."
    },
    {
     "id": 1035783,
     "content_html": "Smaller animals have more efficient respiratory surfaces."
    }
   ],
