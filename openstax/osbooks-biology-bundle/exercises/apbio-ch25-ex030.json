   "stimulus_html": "",
   "stem_html": "Which of the following about fats and their storage is true?",
   "answers": [
    {
     "id": 1029332,
     "content_html": "Carbohydrate-rich foods satisfy hunger better than fatty acid–rich food."
    },
    {
     "id": 1029333,
     "content_html": "Obesity is disadvantageous for organisms that live in cold climates."
    },
    {
     "id": 1029334,
     "content_html": "Fat has more calories than protein or carbohydrates."
    },
    {
     "id": 1029335,
     "content_html": "In the presence of excess blood glucose, fatty acids are synthesized and stored in skeletal muscle."
    }
