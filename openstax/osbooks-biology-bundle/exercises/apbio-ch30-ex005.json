   "stem_html": "What advantages does warming air within the nasal passages provide?",
   "answers": [
    {
     "id": 1248519,
     "content_html": "reduces rates of lung infection"
    },
    {
     "id": 1248518,
     "content_html": "prevents foreign objects from entering the lungs"
    },
    {
     "id": 1248520,
     "content_html": "prevents cell damage caused by cold air"
    },
    {
     "id": 1248517,
     "content_html": "reduces fluid accumulation from cold, wet air"
    }
