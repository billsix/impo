 "questions": [
  {
   "id": 238536,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Identify the statement that accurately describes where the embryonic stem cells and germ layers originate after the blastula is formed.",
   "answers": [
    {
     "id": 743882,
     "content_html": "The inner cell mass contains embryonic stem cells, which arrange themselves into three germ layers."
    },
    {
     "id": 743881,
     "content_html": "The trophoblast in the blastula contains embryonic stem cells, which arrange themselves into three germ layers."
    },
    {
     "id": 743880,
     "content_html": "The inner cell mass contains embryonic stem cells, whereas the germ cells originate from the trophoblast."
    },
    {
     "id": 743879,
     "content_html": "The embryonic stem cells and germ layers originate from the blastocoel present inside the blastula."
    }
   ],
