 "questions": [
  {
   "id": 324281,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the process of potocytosis. How does it differ from pinocytosis?",
   "answers": [
    {
     "id": 835741,
     "content_html": "Potocytosis is a form of receptor-mediated endocytosis where molecules are transported via caveolae-coated vesicles. Pinocytosis is a form of exocytosis used for excreting excess water."
    },
    {
     "id": 835742,
     "content_html": "Potocytosis is a form of exocytosis where molecules are transported via clathrin-coated vesicles. Pinocytosis is a form of receptor-mediated endocytosis used for excreting excess water."
    },
    {
     "id": 835743,
     "content_html": "Potocytosis is a form of receptor-mediated endocytosis where molecules are transported via caveolae-coated vesicles. Pinocytosis is a mode of endocytosis used for the absorption of extracellular fluid."
    },
    {
     "id": 835744,
     "content_html": "Potocytosis is a form of receptor-mediated endocytosis used for the absorption of water."
    }
   ],
