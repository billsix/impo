 "questions": [
  {
   "id": 639824,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the scientific meaning of “theory” differ from the common vernacular meaning?",
   "answers": [
    {
     "id": 1246814,
     "content_html": "A scientific theory is a hypothesis that needs to be tested, whereas people often use theory to mean a simple guess."
    },
    {
     "id": 1246813,
     "content_html": "A scientific theory has many parts and exceptions, while people often use it to mean a statement that is a universal rule."
    },
    {
     "id": 1246815,
     "content_html": "A scientific theory is a thoroughly tested set of explanations for a body of observations of nature, while people often use it to mean a guess or speculation."
    },
    {
     "id": 1246812,
     "content_html": "A scientific theory is a hypothetical thought experiment, while people often use it to mean a statement that is somewhat based in fact."
    }
   ],
