   "stimulus_html": "",
   "stem_html": "Which of the following statements about the nitrogen cycle is false?",
   "answers": [
    {
     "id": 1082872,
     "content_html": "Ammonification converts organic nitrogenous matter from living organisms into ammonium (NH4<sup>+</sup>)."
    },
    {
     "id": 1082873,
     "content_html": "Denitrification by bacteria converts nitrates (NO3<sup>-</sup>) to nitrogen gas (N2)."
    },
    {
     "id": 1082874,
     "content_html": "Nitrification by bacteria converts nitrates (NO3<sup>-</sup>) to nitrites (NO2<sup>-</sup>)."
    },
    {
     "id": 1082875,
     "content_html": "Nitrogen fixing bacteria convert nitrogen gas (N2) into organic compounds."
    }
