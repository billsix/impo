 "questions": [
  {
   "id": 232450,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Injection of a potassium solution into a person’s blood is lethal. Potassium is used in capital punishment and euthanasia. Why do you think a potassium solution injection is lethal?",
   "answers": [
    {
     "id": 719944,
     "content_html": "Excess potassium disrupts the membrane components"
    },
    {
     "id": 719945,
     "content_html": "Excess potassium increases action potential generation, leading to uncoordinated organ activity."
    },
    {
     "id": 719947,
     "content_html": "Potassium dissipates the electrochemical gradient in cardiac muscle cells, preventing them from contracting."
    },
    {
     "id": 719946,
     "content_html": "Potassium creates a new concentration gradient across the cell membrane, preventing sodium from leaving the cell."
    }
   ],
