  {
   "id": 548460,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Scientists have proposed a few hypotheses to explain the origin of viruses. Determine which of the following developments best explains how and why scientists clarify and further refine such hypotheses.",
   "answers": [
    {
     "id": 1077559,
     "content_html": "Advances in technology provide historic evidence."
    },
    {
     "id": 1077560,
     "content_html": "Biochemical and genetic information provide historic evidence."
    },
    {
     "id": 1077561,
     "content_html": "Advances in technology provide new types of information for scientists."
    },
    {
     "id": 1077562,
     "content_html": "Advances in technology further prove that viruses have a single common ancestor."
    }
   ],
