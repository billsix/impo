 "questions": [
  {
   "id": 344969,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When closely related individuals mate with each other, or inbreed, the offspring are often not as fit as the offspring of two unrelated individuals. Why?",
   "answers": [
    {
     "id": 860154,
     "content_html": "Inbreeding causes normally silent alleles to be expressed."
    },
    {
     "id": 860155,
     "content_html": "The DNA of close relatives reacts negatively in the offspring."
    },
    {
     "id": 860157,
     "content_html": "Inbreeding can bring together rare, deleterious mutations that lead to harmful phenotypes."
    },
    {
     "id": 860156,
     "content_html": "Close relatives are genetically incompatible."
    }
   ],
