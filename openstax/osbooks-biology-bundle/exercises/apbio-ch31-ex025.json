 "questions": [
  {
   "id": 534627,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare the functions and structures of red and white blood cells.",
   "answers": [
    {
     "id": 1045305,
     "content_html": "Red blood cells lack nuclei at maturity and contain hemoglobin, which distributes oxygen throughout the body. White blood cells are primarily involved in the immune response to identify and target pathogens. They have nuclei and lack hemoglobin"
    },
    {
     "id": 1045306,
     "content_html": "Red blood cells lack nuclei at maturity and contain hemoglobin, which distributes oxygen throughout the body. White blood cells are primarily involved in the immune response to identify and target pathogens. They lack both nuclei and hemoglobin."
    },
    {
     "id": 1045307,
     "content_html": "Red blood cells contain nuclei and hemoglobin, which distributes oxygen throughout the body. White blood cells are primarily involved in the immune response to identify and target pathogens. They lack both nuclei and hemoglobin."
    },
    {
     "id": 1045308,
     "content_html": "Red blood cells lack nuclei at maturity and contain hemoglobin, which is involved in the immune response, assisting in identification and targeting of pathogens. White blood cells distribute oxygen throughout the body. They have nuclei and lack hemoglobin."
    }
   ],
