 "questions": [
  {
   "id": 535231,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p><img src=\"exercises/media/9cb2456a23075a52.jpg\" alt=\"Illustration shows a nervous system “gate” opening and Na+ entering the cell.\"></p>\n<p>This figure depicts an essential component of signal formation and transmission in neurons. What is happening in this figure?</p>\n",
   "answers": [
    {
     "id": 1047428,
     "content_html": "A signal is being transmitted as sodium ions move inside the cell."
    },
    {
     "id": 1047429,
     "content_html": "The channel has just transmitted a signal and can not be activated for a while."
    },
    {
     "id": 1047430,
     "content_html": "The channel is regenerating itself after transmitting a signal."
    },
    {
     "id": 1047431,
     "content_html": "The channel is at rest position. It is not transmitting or recharging."
    }
   ],
