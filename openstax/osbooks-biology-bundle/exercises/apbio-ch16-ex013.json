   "id": 334642,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would happen if bacteria did not have <em>trp</em> R?",
   "answers": [
    {
     "id": 844197,
     "content_html": "The cell would not be able to break down tryptophan."
    },
    {
     "id": 844198,
     "content_html": "The cell will gradually produce more tryptophan over time."
    },
    {
     "id": 844199,
     "content_html": "The cell would not be able to make tryptophan."
    },
    {
     "id": 844200,
     "content_html": "The cell would make tryptophan when it was not needed."
    }
   ],
