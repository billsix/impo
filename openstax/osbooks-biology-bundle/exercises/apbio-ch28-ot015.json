   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/c8b6d66c385923ce.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Gabor Halmos, et al./ScienceDirect)</figcaption>\n</figure>",
   "stem_html": "<p>The image shows how the gonadotrophin-releasing hormone (GnRH) functions in a cell. The GnRH is made up of multiple amino acids.</p>\n<p>What type of hormone is GnRH?</p>",
   "answers": [
    {
     "id": 756986,
     "content_html": "Lipid-soluble hormone."
    },
    {
     "id": 756985,
     "content_html": "RNA-derived hormone."
    },
    {
     "id": 756984,
     "content_html": "Amino acid-derived hormone."
    },
    {
     "id": 756987,
     "content_html": "Peptide hormone."
    }
