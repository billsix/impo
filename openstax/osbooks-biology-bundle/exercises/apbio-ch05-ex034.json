 "questions": [
  {
   "id": 639573,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\"><img src=\"exercises/media/7282478222fc052a.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Mazuraan/Wikipedia, CC BY-SA 4.0)</figcaption></figure>",
   "stem_html": "This is the 3D structure of clathrin, with an individual subunit highlighed in blue. What is a functional reason for this structure?",
   "answers": [
    {
     "id": 1245840,
     "content_html": "Clathrin stabilizes the section of the membrane forming the vesicle."
    },
    {
     "id": 1245837,
     "content_html": "Clathrin is heat resistant."
    },
    {
     "id": 1245838,
     "content_html": "The interlocking clathrin subunits provide a rigid cell structure."
    },
    {
     "id": 1245839,
     "content_html": "Clathrin fuses with the trans Golgi apparatus."
    }
   ],
