  {
   "id": 535415,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/0a7931a79f256e10.jpg\" alt=\"\">\n(credit: modification of work by Geraldine Blanchard Rohner, et al./<i>The Journal of Immunology</i>)</figure>",
   "stem_html": "<p>This graph shows the concentration of a specific antibody after an immunization shot. The horizontal line at each day shows the average value measured for that day. Ignore the 5m value at the start.</p>\n<p>Make a claim based on this graph.</p>",
   "answers": [
    {
     "id": 1047956,
     "content_html": "Antibody production started right after immunization shot and increased in the thirty days following it."
    },
    {
     "id": 1047957,
     "content_html": "Antibody production was highest on the day of the shot and gradually decreased in the thirty days following it."
    },
    {
     "id": 1047958,
     "content_html": "Antibody production was constant for the thirty days following the shot."
    },
    {
     "id": 1047959,
     "content_html": "Antibody production peaked eight days after the shot and then gradually decreased."
    }
   ],
