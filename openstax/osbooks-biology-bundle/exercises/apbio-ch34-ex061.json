  {
   "id": 517113,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens before the baby and placenta are expelled?",
   "answers": [
    {
     "id": 1011334,
     "content_html": "Thinning and dilation of the cervix take place."
    },
    {
     "id": 1011335,
     "content_html": "There is increased blood flow to the baby."
    },
    {
     "id": 1011336,
     "content_html": "Enlargement of the uterus takes place."
    },
    {
     "id": 1011337,
     "content_html": "Increased production of estrogen occurs."
    }
   ],
