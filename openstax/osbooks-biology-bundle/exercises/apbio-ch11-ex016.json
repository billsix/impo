 "questions": [
  {
   "id": 508065,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Reproductive cells in most species are different from the cells that make up the rest of the organism. What are the “body” cells called and how are they different from the reproductive cells?",
   "answers": [
    {
     "id": 995400,
     "content_html": "Body cells are called gametes and they have half the number of chromosomes found in reproductive cells."
    },
    {
     "id": 995401,
     "content_html": "Body cells are called somatic cells and have the same number of chromosomes as reproductive cells."
    },
    {
     "id": 995402,
     "content_html": "Body cells are called somatic cells and have double the number of chromosomes found in reproductive cells."
    },
    {
     "id": 995403,
     "content_html": "Body cells are called gametes and have double the number of chromosomes found in reproductive cells."
    }
   ],
