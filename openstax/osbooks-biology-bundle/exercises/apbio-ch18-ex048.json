 "questions": [
  {
   "id": 517326,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What role do prezygotic and postzygotic barriers play in speciation?",
   "answers": [
    {
     "id": 1011598,
     "content_html": "Prezygotic and postzygotic barriers allow for the formation of less-fit hybrids that reinforces speciation."
    },
    {
     "id": 1011599,
     "content_html": "Prezygotic and postzygotic barriers prevent interbreeding of species such that there is no gene flow between them."
    },
    {
     "id": 1011600,
     "content_html": "Prezygotic and postzygotic barriers prevent migration of the two species, causing them to remain in contact with each other and begin to interbreed."
    },
    {
     "id": 1011601,
     "content_html": "Prezygotic and postzygotic barriers are present only in newly-formed species, allowing scientists to identify the time of divergence of the species."
    }
   ],
