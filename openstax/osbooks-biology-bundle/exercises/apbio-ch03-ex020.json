   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What molecule is joined with glucose to form the disaccharide lactose, and what type of bond joins these molecules?",
   "answers": [
    {
     "id": 988263,
     "content_html": "a glycosidic bond between glucose and lactose"
    },
    {
     "id": 988264,
     "content_html": "a glycosidic bond between glucose and galactose"
    },
    {
     "id": 988265,
     "content_html": "a hydrogen bond between glucose and sucrose"
    },
    {
     "id": 988266,
     "content_html": "a hydrogen bond between glucose and fructose"
    }
