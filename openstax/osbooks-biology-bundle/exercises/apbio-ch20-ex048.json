 "questions": [
  {
   "id": 639866,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What does the Eukaryote-first hypothesis suggest?",
   "answers": [
    {
     "id": 1246982,
     "content_html": "that mitochondria were first established in a prokaryotic host which acquired a nucleus to become the first eukaryotic cell"
    },
    {
     "id": 1246981,
     "content_html": "that the nucleus evolved in prokaryotes first followed by fusion of the new eukaryote with bacteria that became mitochondria"
    },
    {
     "id": 1246983,
     "content_html": "that prokaryotes actually evolved from eukaryotes by losing genes and complexity"
    },
    {
     "id": 1246980,
     "content_html": "that eukaryotes developed Golgi before mitochondria"
    }
   ],
