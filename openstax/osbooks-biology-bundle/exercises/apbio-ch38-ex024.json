 "questions": [
  {
   "id": 531918,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Different varieties of potatoes are known to thrive at different altitudes. What could be the related benefit of maintaining the diversity of potato plants?",
   "answers": [
    {
     "id": 1040588,
     "content_html": "Diverse types of pollinators can be involved."
    },
    {
     "id": 1040589,
     "content_html": "The range of usable land is extended."
    },
    {
     "id": 1040590,
     "content_html": "The taste of potatoes when fried is improved."
    },
    {
     "id": 1040591,
     "content_html": "Resistance to pests can be introduced if necessary."
    }
   ],
