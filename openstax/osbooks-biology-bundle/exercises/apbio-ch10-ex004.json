 "questions": [
  {
   "id": 507630,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare and contrast a human somatic cell to a human gamete.",
   "answers": [
    {
     "id": 994672,
     "content_html": "Somatic cells have 46 chromosomes and are diploid, whereas gametes have half as many chromosomes as found in somatic cells."
    },
    {
     "id": 994673,
     "content_html": "Somatic cells have 23 chromosomes and are diploid, whereas gametes have half as many chromosomes are are present in somatic cells."
    },
    {
     "id": 994674,
     "content_html": "Somatic cells have 46 chromosomes and are haploid, whereas gametes have 23 chromosomes and are diploid."
    },
    {
     "id": 994675,
     "content_html": "Somatic cells have 46 chromosomes with one sex chromosome. In gametes, 23 chromosomes are present with two sex chromosomes."
    }
   ],
