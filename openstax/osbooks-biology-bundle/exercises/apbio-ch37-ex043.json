 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp35259792\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"21\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h4>\n    <span data-type=\"media\" id=\"fs-idm39743472\" data-alt=\"QR Code representing a URL\">\n    <img src=\"https://openstax.org/apps/archive/20210823.155019/resources/07051a0fd74a0ef40d9636d379e639e9266866b5\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"22\">\n    </span>\n<p id=\"fs-idm16011072\">Click this <a href=\"https://openstaxcollege.org/l/climate_change\" target=\"_window\">link</a> to learn more about global climate change.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 242823,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/0de5474da86b9d24.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Donald E. Canfield, et al./Science)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image shows the nitrogen resevoirs on Earth.</p>\n<p>Make a claim based on this image.</p>",
   "answers": [
    {
     "id": 760753,
     "content_html": "Most of the nitrogen on Earth is in the atmosphere."
    },
    {
     "id": 760754,
     "content_html": "Most of the nitrogen on Earth is in the oceans."
    },
    {
     "id": 760752,
     "content_html": "In the oceans, nitrogen is in the form of N2 gas."
    },
    {
     "id": 760751,
     "content_html": "Marine organisms contain more nitrogen than land organisms."
    }
