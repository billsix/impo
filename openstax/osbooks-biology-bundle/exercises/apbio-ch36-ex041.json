 "questions": [
  {
   "id": 640401,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Define carrying capacity of a population and explain whether it changes or remains fixed for a population.",
   "answers": [
    {
     "id": 1249095,
     "content_html": "Carrying capacity is the amount of land needed to support a population, and it is fixed for each population."
    },
    {
     "id": 1249094,
     "content_html": "Carrying capacity is the amount of water and food resources required to support a population and it is fixed for each population."
    },
    {
     "id": 1249096,
     "content_html": "Carrying capacity is the maximum size of a population that can survive using the available resources and it can vary up or down."
    },
    {
     "id": 1249093,
     "content_html": "Carrying capacity is the time needed for a population to reach its maximum size and it can vary up or down."
    }
   ],
