 "questions": [
  {
   "id": 517923,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Justify the claim in biology that there is no perfect organism despite natural selection, by selecting the relevant reasoning to explain why this is true.",
   "answers": [
    {
     "id": 1012594,
     "content_html": "Because natural selection works on a geographic level."
    },
    {
     "id": 1012595,
     "content_html": "Because natural selection works in a random manner, like mutations."
    },
    {
     "id": 1012596,
     "content_html": "Because natural selection is limited by a population’s existing genetic variation."
    },
    {
     "id": 1012597,
     "content_html": "Because natural selection is limited to sexual dimorphism."
    }
   ],
