 "questions": [
  {
   "id": 503536,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Free-living <em>V. fischeri</em> do not luminesce. Why?",
   "answers": [
    {
     "id": 990127,
     "content_html": "The squid provides certain nutrients that allow the bacteria to luminesce."
    },
    {
     "id": 990128,
     "content_html": "The squid produces the luminescent luciferase enzyme, so bacteria living outside the squid do not luminesce."
    },
    {
     "id": 990129,
     "content_html": "The ability to luminesce does not benefit free-living bacteria, so free-living bacteria do not produce luciferase."
    },
    {
     "id": 990130,
     "content_html": "Luciferase is toxic to free-living bacteria, so free-living bacteria do not produce this enzyme."
    }
   ],
