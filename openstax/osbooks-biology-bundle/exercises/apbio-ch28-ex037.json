 "questions": [
  {
   "id": 544997,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain where insulin is stored and under what circumstances it is released.",
   "answers": [
    {
     "id": 1070237,
     "content_html": "It is stored in the pancreas and is released as glucose increases in the blood to enhance the rate of glucose uptake."
    },
    {
     "id": 1070238,
     "content_html": "It is stored in the liver and is released as glucose increases in the blood to enhance the rate of glucose uptake."
    },
    {
     "id": 1070239,
     "content_html": "It is stored in the pancreas and is released as glucose levels decrease in blood to decrease the rate of glucose uptake."
    },
    {
     "id": 1070240,
     "content_html": "It is stored in the liver and is released as glucose levels decrease in the blood to decrease the rate of glucose uptake."
    }
   ],
