   "id": 521574,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Assume a pericentric inversion occurred in one of two homologs prior to meiosis. The other homolog remains normal. During meiosis, what structure, if any, would these homologs assume in order to pair accurately along their lengths?",
   "answers": [
    {
     "id": 1020096,
     "content_html": "V formation"
    },
    {
     "id": 1020097,
     "content_html": "cruciform"
    },
    {
     "id": 1020098,
     "content_html": "a loop"
    },
    {
     "id": 1020099,
     "content_html": "Pairing would not be possible."
    }
