   "id": 531773,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why did the dinosaurs that survived the immediate impact of the meteorite also die off?",
   "answers": [
    {
     "id": 1040008,
     "content_html": "The Earth became unbearably hot."
    },
    {
     "id": 1040009,
     "content_html": "Prolonged drought resulted from the meteorite impact."
    },
    {
     "id": 1040010,
     "content_html": "Debris in the atmosphere formed a thick cloud, which blocked almost all of the sunlight. Plants and animals died."
    },
    {
     "id": 1040011,
     "content_html": "A giant tsunami wiped out all the dinosaurs from the surface of the Earth."
    }
   ],
