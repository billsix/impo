  {
   "id": 520973,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Cardiac muscle contains specialized regions along the plasma membrane called intercalated discs. What is the role of intercalated discs?",
   "answers": [
    {
     "id": 1018217,
     "content_html": "efficiently pass electrical impulses between cardiac cells"
    },
    {
     "id": 1018218,
     "content_html": "facilitate immune response to foreign antigens"
    },
    {
     "id": 1018219,
     "content_html": "cushion body organs from damage"
    },
    {
     "id": 1018220,
     "content_html": "keeps blood vessels in place"
    }
   ],
