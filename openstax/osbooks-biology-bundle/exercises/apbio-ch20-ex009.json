   "id": 233654,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is the best explanation of what systematists do?",
   "answers": [
    {
     "id": 724764,
     "content_html": "Scientists in the field of systematics organize organisms by characteristics."
    },
    {
     "id": 724763,
     "content_html": "Scientists in the field of systematics provide information on how organisms are similar or different."
    },
    {
     "id": 724765,
     "content_html": "Scientists in the field of systematics contribute to building, updating, and maintaining the “tree of life.”"
    },
    {
     "id": 724762,
     "content_html": "Scientists in the field of systematics collect data from fossils."
    }
