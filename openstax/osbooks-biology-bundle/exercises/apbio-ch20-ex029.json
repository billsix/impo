   "id": 530252,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is it important for scientists to distinguish between homologous and analogous characteristics before building phylogenetic trees?",
   "answers": [
    {
     "id": 1037368,
     "content_html": "Phylogenetic trees are based on evolutionary connections, so scientists can use the analogous characteristics to build the phylogenetic trees."
    },
    {
     "id": 1037369,
     "content_html": "Phylogenetic trees are based on evolutionary connections, so scientists can use the homologous characteristics to build the phylogenetic trees."
    },
    {
     "id": 1037370,
     "content_html": "Phylogenetic trees are based on similar functions, so scientists can use the analogous characteristics to build the phylogenetic trees."
    },
