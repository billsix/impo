 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1685480\" class=\"interactive-embedded-reading\" data-label=\"\">\n<div data-type=\"title\">Link to Learning</div>\n<span data-type=\"media\" id=\"fs-id1608815\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/503c763ce207336db8f45dd0a3d6b200d996f4b3\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"130\" height=\"130\">\n</span>\n<p id=\"fs-id1364358\">To see an example of a white blood cell in action, watch a short time-lapse video of the cell capturing two bacteria. It engulfs one and then moves on to the other.\n\n</p>\n<div data-type=\"media\" id=\"eip-id3083425\" data-alt=\"chasing_bcteria\">\n<div class=\"os-has-iframe os-has-link\" data-type=\"switch\">\n<a class=\"os-is-link\" href=\"https://openstax.org/books/biology/pages/4-5-the-cytoskeleton\" target=\"_blank\" rel=\"noopener nofollow\" data-media=\"print\">Access multimedia content</a>\n<iframe width=\"660\" height=\"371.4\" src=\"https://www.openstaxcollege.org/l/chasing_bcteria\" class=\"os-is-iframe\" data-media=\"screen\"><!-- no-selfclose --></iframe>\n</div>\n                 </div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 639545,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The Human Immunodeficiency Virus (HIV) infects and kills white blood cells. Over time, what affect does this have on the body’s immune system?",
   "answers": [
    {
     "id": 1245728,
     "content_html": "The body’s immune system would not be affected by this."
    },
    {
     "id": 1245729,
     "content_html": "The body’s immune system would not be able to fight off pathogens like bacteria with fewer white blood cells. This can increase the risk of illness in HIV patients."
    },
    {
     "id": 1245727,
     "content_html": "The body’s immune system, in order to recoup this loss, will produce more WBC’s."
    },
    {
     "id": 1245726,
     "content_html": "The body’s immune system will fight the pathogens more vigorously in order to compensate for the fewer white blood cells."
    }
   ],
