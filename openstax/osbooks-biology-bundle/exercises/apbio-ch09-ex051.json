 "questions": [
  {
   "id": 639657,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Yeast is considered a good model for learning about signaling in humans. Differentiate between the options provided to propose the characteristics of yeast that support their role as a model.",
   "answers": [
    {
     "id": 1246166,
     "content_html": "Yeasts are prokaryotes. They have a short life cycle, reproduce rapidly, and share similarities with humans in certain regulating mechanisms."
    },
    {
     "id": 1246167,
     "content_html": "Yeasts are eukaryotes. They have a short life cycle, are easy to grow, and share similarities with humans in certain regulating mechanisms."
    },
    {
     "id": 1246165,
     "content_html": "Yeasts are multicellular organisms. They have a predictable life cycle, are easy to grow, and offer contrasts to humans in certain regulating mechanisms."
    },
    {
     "id": 1246164,
     "content_html": "Yeasts are single-celled organisms. They have a complex life cycle like that of humans and share similarities in regulating mechanisms."
    }
   ],
