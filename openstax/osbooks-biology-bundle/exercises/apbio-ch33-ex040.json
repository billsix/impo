 "questions": [
  {
   "id": 535476,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "B cells are important immune cells that fight infections. How is a naïve B cell stimulated to mature into a plasma cell that secretes antibodies?",
   "answers": [
    {
     "id": 1048200,
     "content_html": "T cells secrete cytokines, which help the B cell to multiply and mature into an antibody-producing plasma cell."
    },
    {
     "id": 1048201,
     "content_html": "Natural killer cells secrete cytokines, which help the B cell to multiply and mature into an antibody-producing plasma cell."
    },
    {
     "id": 1048202,
     "content_html": "T cells secrete interferons, which help the B cell to multiply and mature into an antibody-producing plasma cell."
    },
    {
     "id": 1048203,
     "content_html": "Natural killer cells secrete interferons, which help the B cell to multiply and mature into an antibody-producing plasma cell."
    }
