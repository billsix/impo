 "questions": [
  {
   "id": 639612,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Cellular respiration breaks down glucose and releases carbon dioxide and water. Which steps in the oxidation of pyruvate produces carbon dioxide?",
   "answers": [
    {
     "id": 1245991,
     "content_html": "Removal of a carboxyl group from pyruvate releases carbon dioxide. The pyruvate dehydrogenase complex comes into play."
    },
    {
     "id": 1245990,
     "content_html": "Removal of an acetyl group from pyruvate releases carbon dioxide. The pyruvate decarboxylase complex comes into play."
    },
    {
     "id": 1245989,
     "content_html": "Removal of a carbonyl group from pyruvate releases carbon dioxide. The pyruvate dehydrogenase complex comes into play."
    },
    {
     "id": 1245988,
     "content_html": "Removal of coenzyme A from pyruvate releases carbon dioxide. The pyruvate dehydrogenase complex comes into play."
    }
   ],
