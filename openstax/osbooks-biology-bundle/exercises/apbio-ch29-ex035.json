  {
   "id": 546956,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What angular movements occur at the hip joint and knees as you bend down to touch your toes?",
   "answers": [
    {
     "id": 1072931,
     "content_html": "Both the hip joint and knees are flexed."
    },
    {
     "id": 1072932,
     "content_html": "Both the hip joint and knees are extended."
    },
    {
     "id": 1072933,
     "content_html": "The hip joint is extended and the knees are flexed."
    },
    {
     "id": 1072934,
     "content_html": "The hip joint is flexed and the knees are extended."
    }
