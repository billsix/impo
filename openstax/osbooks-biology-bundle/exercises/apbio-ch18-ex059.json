 "questions": [
  {
   "id": 639832,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A biologist studies a population of voles for 20 years. During almost the entire research period, the population stays between 50 and 75 individuals. Additionally, fewer than half of the voles born do not survive to reproduce, due to predation and competition for food. Then, in one generation, 80% of the voles born live to reproduce. The population increases to 110 individuals. What inferences about food and predation can you make for the singular generation in which 80% of offspring survived? What prediction can you make about the genetic and phenotypic variation of future populations for this group of voles?",
   "answers": [
    {
     "id": 1246846,
     "content_html": "Either there was fewer food available or the degree of predation increased. The future generations of this group of voles should evidence fewer genetic variation."
    },
    {
     "id": 1246845,
     "content_html": "Either there was fewer food available or the degree of predation increased. The future generations of this group of voles should evidence greater genetic variation."
    },
    {
     "id": 1246844,
     "content_html": "Either there was more food available or the degree of predation decreased. The future generations of this group of voles should evidence less genetic variation."
    },
    {
     "id": 1246847,
     "content_html": "Either there was more food available or the degree of predation decreased. The future generations of this group of voles should evidence greater genetic variation."
    }
   ],
