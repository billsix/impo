  {
   "id": 519553,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A plant biologist is examining sections of plant tissue under the microscope. The slides are not labeled and the biologist is interested in simple tissues. Which of the following slides is a sample of a simple tissue?",
   "answers": [
    {
     "id": 1014335,
     "content_html": "cells dividing rapidly in a stem"
    },
    {
     "id": 1014336,
     "content_html": "root cambium showing different types of cells"
    },
    {
     "id": 1014337,
     "content_html": "parenchyma showing only one type of cell"
    },
    {
     "id": 1014338,
     "content_html": "leaf displaying the vascular bundle where diverse types of cells are involved in transport"
    }
   ],
