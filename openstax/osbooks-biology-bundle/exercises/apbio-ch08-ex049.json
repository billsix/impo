 "questions": [
  {
   "id": 639640,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The Earth did not contain oxygen in its atmosphere throughout much of its history, even after life on Earth had already began. It did, however, contain carbon dioxide. What does this suggest about when photosynthetic organisms evolved, relative to non-photosynthetic organisms, and why?",
   "answers": [
    {
     "id": 1246098,
     "content_html": "Photosynthetic organisms evolved before non-photosynthetic organisms, because no oxygen was present in the atmosphere when life began."
    },
    {
     "id": 1246099,
     "content_html": "Photosynthetic organisms evolved after non-photosynthetic organisms, because no oxygen was present in the atmosphere when life began."
    },
    {
     "id": 1246097,
     "content_html": "Non-photosynthetic organisms evolved before photosynthetic organisms, because no oxygen was present in the atmosphere when life began."
    },
    {
     "id": 1246096,
     "content_html": "Photosynthetic organisms evoloved before non-photosynthetic organisms, because no carbon dioxide was present in the atmosphere when life began."
    }
