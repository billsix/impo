 "questions": [
  {
   "id": 511861,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Several human diseases are caused by an error in mRNA splicing. Explain why this occurs.",
   "answers": [
    {
     "id": 1001082,
     "content_html": "Once an mRNA is spliced, the original mRNA cannot be created again."
    },
    {
     "id": 1001083,
     "content_html": "Spliced RNA cannot produce proper proteins."
    },
    {
     "id": 1001084,
     "content_html": "Splicing does not occur at all."
    },
    {
     "id": 1001085,
     "content_html": "Splicing occurs in the wrong location on mRNA."
    }
   ],
