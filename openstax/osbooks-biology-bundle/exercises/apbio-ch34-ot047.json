 "questions": [
  {
   "id": 335866,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which best describes the three stages of labor?",
   "answers": [
    {
     "id": 849048,
     "content_html": "During stage one, the cervix thins. During stage two, the cervix is dilated to about 10 cm and the baby is expelled from the uterus. The last stage is the passage of the placenta after the baby has been born."
    },
    {
     "id": 849049,
     "content_html": "During stage one, the cervix thins and is dilated to about 10 cm. During stage two, the baby is expelled from the uterus. The last stage is the passage of the placenta after the baby has been born."
    },
    {
     "id": 849047,
     "content_html": "During stage one, the cervix thins. During stage two, the cervix is dilated to about 10 cm. During the last stage, the baby is expelled from the uterus, followed by the placenta."
    },
    {
     "id": 849046,
     "content_html": "During stage one, the cervix thins and may or may not be dilated. During stage two, the baby is expelled from the uterus. The last stage is the passage of the placenta after the baby has been born."
    }
   ],
