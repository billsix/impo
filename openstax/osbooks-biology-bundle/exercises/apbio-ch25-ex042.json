 "questions": [
  {
   "id": 524039,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/98e8447fd6f6f18a.jpg\" alt=\"\">\n(credit: modification of work \"Did iodized salt raise the IQ of 50 million Americans by 15 points?\" from Giving What We Can)\n</figure>",
   "stem_html": "<p>This graph shows the relation between incidences of goiter (a disease) and iodine concentration in drinking water for a population.</p>\n<p>What is a claim that can be written based on the graph?</p>",
   "answers": [
    {
     "id": 1028780,
     "content_html": "Goiter is not related to iodine intake."
    },
    {
     "id": 1028781,
     "content_html": "High iodine intake may cause goiter."
    },
    {
     "id": 1028782,
     "content_html": "Low iodine intake may cause goiter."
    },
    {
     "id": 1028783,
     "content_html": "Goiter is caused by changes in iodine intake."
    }
   ],
