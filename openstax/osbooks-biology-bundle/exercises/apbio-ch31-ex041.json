 "questions": [
  {
   "id": 534692,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>The heart of a newly discovered mammal species is asymmetric. The right side of the heart is smaller than the left side.</p>\n<p>What is likely to be true about this species?</p>",
   "answers": [
    {
     "id": 1045572,
     "content_html": "The right side of the heart sends blood to the lungs."
    },
    {
     "id": 1045573,
     "content_html": "The right side of the heart sends blood to the body."
    },
    {
     "id": 1045574,
     "content_html": "The right side of the heart sends blood to locations above the heart."
    },
    {
     "id": 1045575,
     "content_html": "The right side of the heart sends blood to only the brain."
    }
   ],
