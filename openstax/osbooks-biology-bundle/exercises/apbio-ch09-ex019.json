  {
   "id": 503504,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Where do DAG and IP3 originate?",
   "answers": [
    {
     "id": 989999,
     "content_html": "They are formed by phosphorylation of cAMP."
    },
    {
     "id": 990000,
     "content_html": "They are ligands expressed by signaling cells."
    },
    {
     "id": 990001,
     "content_html": "They are hormones that diffuse through the plasma membrane to stimulate protein production."
    },
    {
     "id": 990002,
     "content_html": "They are the cleavage products of the inositol phospholipid, PIP2."
    }
   ],
