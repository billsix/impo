 "questions": [
  {
   "id": 504213,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of these is a possible explanation for the presence of a rigid cell wall in plants?",
   "answers": [
    {
     "id": 991497,
     "content_html": "Plants remain exposed to changes in temperature and thus require rigid cell walls to protect themselves."
    },
    {
     "id": 991498,
     "content_html": "Plants are subjected to osmotic pressure and a cell wall helps them against bursting or shrinking."
    },
    {
     "id": 991499,
     "content_html": "Plant cells have a rigid cell wall to protect themselves from grazing animals."
    },
    {
     "id": 991500,
     "content_html": "Plant cells have a rigid cell wall to prevent the influx of waste material."
    }
   ],
