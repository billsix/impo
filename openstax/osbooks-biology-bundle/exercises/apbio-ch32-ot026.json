 "questions": [
  {
   "id": 640302,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A cell has a malfunction in its contractile vacuoles. How would this affect the cell?",
   "answers": [
    {
     "id": 1248707,
     "content_html": "The cell’s nephrons would no longer be able to reabsorb water."
    },
    {
     "id": 1248706,
     "content_html": "The cell’s cytoplasm would become very concentrated."
    },
    {
     "id": 1248705,
     "content_html": "The cell could no longer excrete waste products."
    },
    {
     "id": 1248708,
     "content_html": "The cell would uncontrollably take on water until it burst."
    }
   ],
