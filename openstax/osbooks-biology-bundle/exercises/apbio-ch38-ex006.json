 "questions": [
  {
   "id": 531781,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two genera of birds exist side-by-side on an island. Genus A is characterized by a few species carrying similar genetic material. Genus B contains different species of birds with a wide variety of genetic traits. After a volcanic explosion changes the ecosystem, which genus has the highest probability of surviving the disaster?",
   "answers": [
    {
     "id": 1040040,
     "content_html": "Genus A, which contains well adapted species."
    },
    {
     "id": 1040041,
     "content_html": "Genus B, which has greater genetic diversity and is more likely to have traits that confer an advantage in the new environment."
    },
    {
     "id": 1040042,
     "content_html": "Genus A, which can serve as ancestors for the new species."
    },
    {
     "id": 1040043,
     "content_html": "Genus B, because these species likely evolved from Genus A species in the past."
    }
   ],
