   "stem_html": "Define water’s property of adhesion.",
   "answers": [
    {
     "id": 988335,
     "content_html": "a force that allows surface water molecules to escape and vaporize"
    },
    {
     "id": 988336,
     "content_html": "the attraction between water molecules and other molecules"
    },
    {
     "id": 988337,
     "content_html": "the intermolecular force between water molecules"
    },
    {
     "id": 988338,
     "content_html": "the force that keeps particles dispersed in water"
