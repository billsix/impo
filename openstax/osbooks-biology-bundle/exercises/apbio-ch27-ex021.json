 "questions": [
  {
   "id": 535698,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe how a male snake can physiologically detect the presence of a female that is trying to attract a mate.",
   "answers": [
    {
     "id": 1049083,
     "content_html": "The pheromones secreted by a female dissolve and enter the vomeronasal organ. The dissolved molecules bind to receptors, which send a signal to the hypothalamus, which in turn sends the signal to the amygdala."
    },
    {
     "id": 1049084,
     "content_html": "The pheromones secreted by a female dissolve and enter the vomeronasal organ. The dissolved molecules bind to receptors, which send a signal to the amygdala, which in turn sends the signal to the hypothalamus."
