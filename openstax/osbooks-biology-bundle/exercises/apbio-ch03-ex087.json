 "questions": [
  {
   "id": 495777,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A change in DNA on a chromosome affects all proteins made from that gene for the life of the cell. A change in the RNA involved in protein production is short lived. What is the difference between the effects of the changes in the two types of nucleic acids?",
   "answers": [
    {
     "id": 978442,
     "content_html": "DNA is passed on to the daughter cell, permanently altering the genetic material."
    },
    {
     "id": 978443,
     "content_html": "Although short lived, a change in RNA can be lethal as it sets off a biological feedback loop."
    },
    {
     "id": 978444,
     "content_html": "A change in DNA is benign as DNA has repair mechanisms that RNA lacks."
    },
    {
     "id": 978445,
     "content_html": "Any change in DNA will immediately cause the cell to undergo apoptosis."
    }
   ],
