 "questions": [
  {
   "id": 535881,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/17db2aecb571160e.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Lindsay M. Biga, et al./Oregon State University, under CC BY-SA 4.0 license)</figcaption>\n</figure>",
   "stem_html": "<p>The top two images show the crossection of the utricle when a person is upright.</p>\n<p>What kind of head motion would cause the utricle to have the second shape?</p>",
   "answers": [
    {
     "id": 1049803,
     "content_html": "The person's head is tilted forward."
    },
    {
     "id": 1049804,
     "content_html": "The person's head has rotated to the right, with no change in tilt."
    },
    {
     "id": 1049805,
     "content_html": "The person is slowly accelerating."
    },
    {
     "id": 1049806,
     "content_html": "The person's head has rotated to the left, with no change in tilt."
    }
   ],
