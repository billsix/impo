 "questions": [
  {
   "id": 233455,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following pieces of evidence illustrates evolution as an ongoing process?",
   "answers": [
    {
     "id": 723965,
     "content_html": "Some genes from the bacterium <i>E. coli </i>have sequences that are similar to genes found in humans."
    },
    {
     "id": 723964,
     "content_html": "Marsupial mammals live in just a few places in the world today-Australia, South America, and part of North America."
    },
    {
     "id": 723963,
     "content_html": "The fossil record shows that Rodhocetus, an aquatic mammal related to whales, had a type of ankle bone that is otherwise unique to a group of land animals."
    },
    {
     "id": 723966,
     "content_html": "In the 1940s, infections by the bacterium <i>Staphylococcus aureus </i>could be treated with penicillin; today populations exist that are completely resistant."
    }
   ],
