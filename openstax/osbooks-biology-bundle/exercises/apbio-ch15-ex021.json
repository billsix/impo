     "id": 722922,
     "content_html": "core promoters that bind the preinitiation complex"
    },
    {
     "id": 722919,
     "content_html": "core promoters that occur within genes"
    },
    {
     "id": 722920,
     "content_html": "promoters that occur far upstream of the gene"
    },
    {
     "id": 722921,
     "content_html": "promoters that occur downstream of a gene"
