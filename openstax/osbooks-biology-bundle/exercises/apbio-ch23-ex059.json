 "questions": [
  {
   "id": 522438,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Stomata are usually found in higher numbers on the abaxial or bottom surface of a leaf. Demonstrate why this is the case by explaining the advantage of such an arrangement.",
   "answers": [
    {
     "id": 1022631,
     "content_html": "Presence of stomata on the abaxial or bottom surface ensures that no, or very little, water is lost due to guttation."
    },
    {
     "id": 1022632,
     "content_html": "The abaxial or bottom surface receives more sunlight and water evaporates faster by transpiration."
    },
    {
     "id": 1022633,
     "content_html": "Herbivores are more likely to not eat leaves with stomata on the abaxial or bottom surface."
    },
    {
     "id": 1022634,
     "content_html": "The adaxial or upper surface, by contrast, receives more sunlight and water evaporates faster by transpiration."
    }
   ],
