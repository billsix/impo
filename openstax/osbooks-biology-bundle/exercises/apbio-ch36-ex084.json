 "questions": [
  {
   "id": 546534,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Honey bees are pollinators. Identify the type of symbiotic relationship that exists between honey bees and flowering plants, and explain why your reasoning.",
   "answers": [
    {
     "id": 1071304,
     "content_html": "This is commensalism because bees help plants pollinate and, in turn, obtain nectar from the plants."
    },
    {
     "id": 1071305,
     "content_html": "This is a mutualistic relationship, because bees obtain nectar from the plants, but do not provide any benefits to the plants."
    },
    {
     "id": 1071306,
     "content_html": "This is commensalism, because bees obtain nectar from the plants, but do not provide any benefits to the plants."
    },
    {
     "id": 1071307,
     "content_html": "This is a mutualistic relationship, because bees help plants pollinate and, in turn, obtain nectar from the plants."
    }
