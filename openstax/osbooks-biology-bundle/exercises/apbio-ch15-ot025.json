 "questions": [
  {
   "id": 511828,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would happen if the 5’ methyl guanosine was not added to an mRNA?",
   "answers": [
    {
     "id": 1000950,
     "content_html": "The transcript would degrade when the mRNA moves out of the nucleus to the cytoplasm."
    },
    {
     "id": 1000951,
     "content_html": "The mRNA molecule would stabilize and start the process of translation within the nucleus of the cell."
    },
    {
     "id": 1000952,
     "content_html": "The mRNA molecule would move out of the nucleus and create more copies of the mRNA molecule."
    },
    {
     "id": 1000953,
     "content_html": "The mRNA molecule would not be able to add the poly-A tail on its strand at the 5’ end."
    }
   ],
