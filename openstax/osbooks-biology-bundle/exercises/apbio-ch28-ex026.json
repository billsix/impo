   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Based on your understanding of hormonal regulation, make a claim for which of these scenarios would cause you to receive a burst of energy as your body undergoes a fight-or-flight response.",
   "answers": [
    {
     "id": 1069817,
     "content_html": "sudden increase in your blood calcium levels"
    },
    {
     "id": 1069818,
     "content_html": "sudden release of carbon monoxide in the atmosphere"
    },
    {
     "id": 1069819,
     "content_html": "any threat or life-or-death scenario"
    },
    {
     "id": 1069820,
     "content_html": "physical exercise such as running and swimming"
    }
