 "questions": [
  {
   "id": 548612,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which step in the replication cycle of viruses do you think is most critical for the virus to infect cells? Explain why.",
   "answers": [
    {
     "id": 1077995,
     "content_html": "The attachment step is the most critical, as infection cannot begin if virus does not attach to the host cell."
    },
    {
     "id": 1077996,
     "content_html": "The replication step is the most critical as this step directs protein synthesis."
    },
    {
     "id": 1077997,
     "content_html": "The assembly step is the most critical because new virions are assembled to infect cells."
    },
    {
     "id": 1077998,
     "content_html": "The entry step is the most critical as nucleic acid of virus needs to enter the host cell naked, leaving the capsid outside."
    }
   ],
