   "id": 524087,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following events in digestion and absorption is incorrect?",
   "answers": [
    {
     "id": 1028892,
     "content_html": "Carbohydrate digestion begins in the mouth."
    },
    {
     "id": 1028893,
     "content_html": "Protein is primarily digested in the stomach."
    },
    {
     "id": 1028894,
     "content_html": "Fats are primarily digested in the large intestine."
    },
    {
     "id": 1028895,
     "content_html": "Digested carbohydrate, fat, and protein molecules are absorbed by villi in the small intestine."
    }
   ],
