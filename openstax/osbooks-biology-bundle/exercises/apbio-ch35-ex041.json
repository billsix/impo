 "questions": [
  {
   "id": 535710,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In what ways are the subtropical desert and the arctic tundra similar?",
   "answers": [
    {
     "id": 1049131,
     "content_html": "Both are characterized by animals, which are adapted to burrowing."
    },
    {
     "id": 1049132,
     "content_html": "Both are characterized by plants, which prefer to grow in clumps."
    },
    {
     "id": 1049133,
     "content_html": "Both are characterized by low water availability and, as a result, low net primary productivity."
    },
    {
     "id": 1049134,
     "content_html": "Both are characterized by plants, which are mostly perennials."
    }
   ],
