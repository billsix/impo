 "context": "<figure id=\"fig-ch06_02_05\"><span data-type=\"media\" id=\"fs-id2018830\" data-alt=\"This plot shows the activation energy for an exergonic reaction. As the reaction proceeds, energy initially increases to overcome the activation energy. In a catalyzed reaction, the activation energy is much lower. The energy then decreases such that the Gibbs free energy of the products is less than that of the reactants. The activation energy is the peak of the energy plot minus the energy of the reactants. The Gibbs free energy is the energy of the products minus the energy of the reactants.\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/a64ac2723766deeeb41fd03f689e4a0b0a2f41ee\" data-media-type=\"image/jpg\" alt=\"This plot shows the activation energy for an exergonic reaction. As the reaction proceeds, energy initially increases to overcome the activation energy. In a catalyzed reaction, the activation energy is much lower. The energy then decreases such that the Gibbs free energy of the products is less than that of the reactants. The activation energy is the peak of the energy plot minus the energy of the reactants. The Gibbs free energy is the energy of the products minus the energy of the reactants.\" width=\"280\" id=\"12\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 232507,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the change in Gibbs free energy <span data-math=\"(\\Delta G)\">(\\Delta G)</span> differ between the catalyzed versus uncatalyzed reaction?",
   "answers": [
    {
     "id": 720174,
     "content_html": "<span data-math=\"\\Delta G\">\\Delta G</span> is greater for the forward direction than for the reverse direction."
    },
    {
     "id": 720173,
     "content_html": "<span data-math=\"\\Delta G\">\\Delta G</span> is greater for the uncatalyzed than the catalyzed reaction."
    },
    {
     "id": 720172,
     "content_html": "<span data-math=\"\\Delta G\">\\Delta G</span> is greater for the catalyzed than the uncatalyzed reaction."
    },
    {
     "id": 720175,
     "content_html": "<span data-math=\"\\Delta G\">\\Delta G</span> is the same for the catalyzed and uncatalyzed reactions."
    }
