   "stimulus_html": "",
   "stem_html": "Which of the following statements about viral structure is true?",
   "answers": [
    {
     "id": 1046517,
     "content_html": "Viruses are very similar in structure."
    },
    {
     "id": 1046518,
     "content_html": "The capsomere is made up of small protein subunits called capsids."
    },
    {
     "id": 1046519,
     "content_html": "DNA is the genetic material in all viruses."
    },
    {
     "id": 1046520,
     "content_html": "Glycoproteins help the virus attach to the host cell."
    }
