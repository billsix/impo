 "questions": [
  {
   "id": 517768,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between micro and macroevolution?",
   "answers": [
    {
     "id": 1012282,
     "content_html": "Microevolution describes the evolution of small organisms, such as insects, while macroevolution describes the evolution of large organisms, like people and elephants."
    },
    {
     "id": 1012283,
     "content_html": "Microevolution describes the evolution of microscopic entities, such as molecules and proteins, while macroevolution describes the evolution of whole organisms."
    },
    {
     "id": 1012284,
     "content_html": "Microevolution describes the evolution of organisms in populations, while macroevolution describes the evolution of species over long periods of time."
    },
    {
     "id": 1012285,
     "content_html": "Microevolution describes the evolution of organisms over their lifetimes, while macroevolution describes the evolution of organisms over multiple generations."
    }
   ],
