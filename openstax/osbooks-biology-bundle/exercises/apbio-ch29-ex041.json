 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp78711984\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n    <span data-type=\"media\" id=\"fs-idm17392368\" data-alt=\"QR Code representing a URL\">\n        <img src=\"https://openstax.org/apps/archive/20241024.164013/resources/f42dbb7f0b3765fb1ea0fb36196af0c713e85a20\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n    </span>\n    <p id=\"fs-idm187978960\">View this <a href=\"https://openstaxcollege.org/l/muscle_contract\" target=\"_blank\" rel=\"noopener nofollow\">animation</a> of the cross-bridge muscle contraction.</p>\n</div>\n</div>",
