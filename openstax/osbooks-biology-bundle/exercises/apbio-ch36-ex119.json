 "questions": [
  {
   "id": 547875,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Some animal behaviors can be modified by experience. Which of the following accurately predicts how an experiential factor is likely to affect an animal’s behavior?",
   "answers": [
    {
     "id": 1075627,
     "content_html": "A species of salmon will migrate up the same river regardless of increases in predators that visit these waterways from one year to the next."
    },
    {
     "id": 1075628,
     "content_html": "Female elk that had difficult deliveries of calves will continue to mate with males in succeeding mating seasons."
    },
    {
     "id": 1075629,
     "content_html": "Bears that receive food from humans are later more likely to break into human habitations than bears that are not approached by humans."
    },
    {
     "id": 1075630,
     "content_html": "A bird raised from an egg isolated in a lab environment will give the same alarm call as birds of the same species raised in the wild."
    }
   ],
