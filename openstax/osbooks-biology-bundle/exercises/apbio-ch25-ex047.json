   "is_answer_order_important": true,
   "stimulus_html": "<img src=\"exercises/media/234d105a5e151f60.jpg\" alt=\"\">",
   "stem_html": "<p>The image shows the structure of an ATP molecule.</p>\n<p>When an ATP molecule is broken down for energy, which bonds break?</p>",
   "answers": [
    {
     "id": 1028860,
     "content_html": "The O—H bonds."
    },
    {
     "id": 1028861,
     "content_html": "The P—O bonds."
    },
    {
     "id": 1028862,
     "content_html": "The N—H bonds."
    },
    {
     "id": 1028863,
     "content_html": "The —O— bond."
    }
   ],
