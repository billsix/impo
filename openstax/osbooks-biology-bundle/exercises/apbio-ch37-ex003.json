 "questions": [
  {
   "id": 640425,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do you think the value for gross productivity of the primary producers is the same as the value for total heat and respiration (<span data-math=\"20,810 \\,\\text{kcal}/\\text{m}^2/\\text{yr}\"></span>)?",
   "answers": [
    {
     "id": 1249185,
     "content_html": "Total heat and respiration refers to the energy used by all trophic levels and the energy provided by the primary producers is more than the energy provided by primary consumers to these levels."
    },
    {
     "id": 1249186,
     "content_html": "Gross productivity of primary producers is the same as the value for total heat and respiration because of the high efficiency of conversion of solar energy to energy used by all trophic levels by primary producers."
    },
    {
     "id": 1249187,
     "content_html": "The value for gross productivity of primary producers and total heat and respiration is same as primary producers provide energy to primary consumers and secondary consumers only."
    },
    {
     "id": 1249188,
     "content_html": "Total heat and respiration refers to energy used by all trophic levels and the only accessible energy to these levels is provided by primary producers."
    }
   ],
