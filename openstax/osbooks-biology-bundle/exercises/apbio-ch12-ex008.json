   "stimulus_html": "",
   "stem_html": "<p>The pedigree shown illustrates the inheritance of alkaptonuria, a recessive genetic disorder, in an affected family. Analyze the pedigree to predict the genotypes of the individuals labeled 1, 2, and 3.</p>\n",
   "answers": [
    {
     "id": 1338899,
     "content_html": "1- aa , 2-AA, 3- AA"
    },
    {
     "id": 1338900,
     "content_html": "1-aa, 2-Aa, 3- Aa"
    },
    {
     "id": 1338901,
     "content_html": "1-aa, 2-Aa, 3-AA"
    },
    {
     "id": 1338902,
     "content_html": "1-Aa, 2-Aa, 3-Aa"
    }
