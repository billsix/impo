   "stimulus_html": "",
   "stem_html": "Compare the age structure for Stage 4 to that of Stage 3. What changes in population growth would have to occur for a shift from Stage 3 to Stage 4?",
   "answers": [
    {
     "id": 759907,
     "content_html": "Birth rates and death rates remains same in both Stage 3 and Stage 4."
    },
    {
     "id": 759908,
     "content_html": "Birth rates and death rates decline in Stage 4 compared to Stage 3."
    },
    {
     "id": 759909,
     "content_html": "Death rates decline in Stage 4 compared to Stage 3, but birth rates remain the same."
    },
    {
     "id": 759910,
     "content_html": "Birth rates decline in Stage 4 compared to Stage 3, but death rates remain the same."
