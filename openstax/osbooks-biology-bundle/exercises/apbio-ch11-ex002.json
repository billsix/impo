 "questions": [
  {
   "id": 507910,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following events occurs in both mitosis and meiosis I?",
   "answers": [
    {
     "id": 995248,
     "content_html": "Homologous chromosomes pair together."
    },
    {
     "id": 995249,
     "content_html": "Crossover occurs between chromosomes."
    },
    {
     "id": 995250,
     "content_html": "Chromosomes line up at the metaphase plate."
    },
    {
     "id": 995251,
     "content_html": "Sister chromatids remain attached during anaphase."
    }
   ],
