 "questions": [
  {
   "id": 546512,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain what happens to a forest community after a forest fire.",
   "answers": [
    {
     "id": 1071216,
     "content_html": "The same community is quickly re-established just as it existed before the disturbance."
    },
    {
     "id": 1071217,
     "content_html": "Another mature community with different species grows quickly in place of the original community."
    },
    {
     "id": 1071218,
     "content_html": "Groups of species grow and then are replaced by other groups through a sequential series of changes as the community matures over time."
    },
    {
     "id": 1071219,
     "content_html": "The landscape remains barren for many years until trees grow large enough to provide the shade needed for smaller plants to grow."
    }
   ],
