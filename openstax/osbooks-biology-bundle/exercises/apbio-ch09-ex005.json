 "questions": [
  {
   "id": 513700,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are ion channels necessary to transport ions into or out of a cell?",
   "answers": [
    {
     "id": 1006380,
     "content_html": "Ions are too large to diffuse through the membrane."
    },
    {
     "id": 1006381,
     "content_html": "Ions are charged particles and cannot diffuse through the membrane, thus they require ion channels."
    },
    {
     "id": 1006382,
     "content_html": "Ions bind to hydrophobic molecules within the ion channels."
    },
    {
     "id": 1006383,
     "content_html": "Ions bind to carrier proteins in the bloodstream, which must be removed before transport into the cells."
    }
   ],
