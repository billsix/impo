  {
   "id": 548434,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How did the development of a porcelain filter, called the Chamberland-Pasteur filter, help scientists discover viruses?",
   "answers": [
    {
     "id": 1077449,
     "content_html": "After filtering a liquid plant extract, the scientists could see the virions using the light microscope."
    },
    {
     "id": 1077450,
     "content_html": "After filtering a liquid plant extract, the disease was still transferred to a healthy plant."
    },
    {
     "id": 1077451,
     "content_html": "After filtering a liquid plant extract, the virus cells multiplied."
    },
    {
     "id": 1077452,
     "content_html": "After filtering a liquid plant extract, scientists were able to trace historical footprints."
    }
