 "questions": [
  {
   "id": 504153,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "One of the traits that Mendel examined in pea plants was flower position. Flower position in pea plants is determined by a gene with axial and terminal alleles. Given that axial is dominant to terminal, predict all of the possible F<sub>1</sub> and F<sub>2</sub> genotypes and phenotypes from a cross involving parents that are homozygous for each trait. Express genotypes with conventional genetic abbreviations.\n",
   "answers": [
    {
     "id": 991259,
     "content_html": "F<sub>1</sub>: All AA-axial; F<sub>2</sub>: AA-Axial and aa-terminal."
    },
    {
     "id": 991260,
     "content_html": "F<sub>1</sub>: All aa-terminal; F<sub>2</sub>: AA-Axial and Aa-terminal."
    },
    {
     "id": 991261,
     "content_html": "F<sub>1</sub>: AA-axial and AAa-terminal; F<sub>2</sub>: All AA-axial."
    },
    {
     "id": 991262,
     "content_html": "F<sub>1</sub>: All Aa-axial; F<sub>2</sub>: AA-Axial, Aa-Axial, and aa-terminal."
    }
   ],
