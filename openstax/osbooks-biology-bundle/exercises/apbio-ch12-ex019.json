   "id": 232971,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Construct a Punnett square to predict the offspring in a cross between a dwarf pea plant (homozygous recessive) and a tall pea plant (heterozygous). Determine and identify here the correct phenotypic ratio of the offspring.",
   "answers": [
    {
     "id": 722030,
     "content_html": "1 tall : 1 dwarf"
    },
    {
     "id": 722029,
     "content_html": "1 tall : 2 dwarf"
    },
    {
     "id": 722028,
     "content_html": "3 tall : 1 dwarf"
    },
    {
     "id": 722027,
     "content_html": "1 dwarf : 4 tall"
    }
