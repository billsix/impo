  {
   "id": 545246,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Positive feedback loops are rare in the endocrine system but some do exist. Compare the cause-and-effect situations described below to identify which is an example of a positive feedback loop.",
   "answers": [
    {
     "id": 1070297,
     "content_html": "Insulin facilitates decrease of blood sugar levels."
    },
    {
     "id": 1070298,
     "content_html": "Oxytocin release stimulates milk release."
    },
    {
     "id": 1070299,
     "content_html": "Increased blood calcium levels halt PTH production."
    },
    {
     "id": 1070300,
     "content_html": "Increased amounts of T3 and T4 inhibit further production."
    }
   ],
