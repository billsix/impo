   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement best describes what biologists know about the evolution of viruses?",
   "answers": [
    {
     "id": 1076979,
     "content_html": "Scientists can look at fossil records and similar historic evidence."
    },
    {
     "id": 1076980,
     "content_html": "Much about virus origins and evolution remains unknown."
    },
    {
     "id": 1076981,
     "content_html": "Biologists have accumulated a significant amount of knowledge about how viruses originated."
    },
    {
     "id": 1076982,
     "content_html": "Biologists know exactly when viruses emerged and from where they came."
    }
