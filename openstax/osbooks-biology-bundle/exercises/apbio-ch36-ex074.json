 "questions": [
  {
   "id": 546498,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain what would happen to an animal species classified as a Batesian mimic if it did not have its mimicry attributes.",
   "answers": [
    {
     "id": 1071160,
     "content_html": "The animal species would suffer increased loss through predation because its predators would not learn to avoid eating it."
    },
    {
     "id": 1071161,
     "content_html": "The animal species would suffer decreased loss through predation because it still produces harmful toxins that would kill its predators."
    },
    {
     "id": 1071162,
     "content_html": "The animal species would suffer no long-term loss through predation because it still produces foul tasting compounds that its predators would learn to avoid."
    },
    {
     "id": 1071163,
     "content_html": "The animal species would suffer increased loss through predation because predators would not be deterred by its appearance and would find it to be tasty."
    }
   ],
