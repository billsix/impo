 "questions": [
  {
   "id": 511809,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A mutation in the promoter region of the gene for the beta-globin can cause beta-thalassemia, a hereditary condition which causes anemia. Why would mutations in the promoter region lead to low levels of hemoglobin?",
   "answers": [
    {
     "id": 1000874,
     "content_html": "The globin chains produced are too long to form functional hemoglobin."
    },
    {
     "id": 1000875,
     "content_html": "The globin chains are too short to form functional hemoglobin."
    },
    {
     "id": 1000876,
     "content_html": "Fewer globin chains are synthesized because less mRNA is transcribed."
    },
    {
     "id": 1000877,
     "content_html": "Globin chains do not fold properly and are non-functional."
    }
   ],
