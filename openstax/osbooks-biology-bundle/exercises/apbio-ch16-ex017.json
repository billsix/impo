   "stimulus_html": "",
   "stem_html": "Which of the following statements about epigenetic regulation is false?",
   "answers": [
    {
     "id": 1021977,
     "content_html": "Histone protein charge becomes more positive when acetyl groups are added."
    },
    {
     "id": 1021978,
     "content_html": "DNA molecules are modified within CpG islands."
    },
    {
     "id": 1021979,
     "content_html": "Methylation of DNA and histones causes nucleosomes to pack tightly together."
    },
    {
     "id": 1021980,
     "content_html": "Histone acetylation results in the loose packing of nucleosomes."
    }
