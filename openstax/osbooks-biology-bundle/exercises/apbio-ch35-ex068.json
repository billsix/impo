 "questions": [
  {
   "id": 242524,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/ea4e30b1d4cf9f60.jpg\" alt=\"\">\n<figcaption>(credit: modification of work from Robert Simmon/Earth Observatory)</figcaption>\n</figure>\n",
   "stem_html": "<p>The graph shows carbon dioxide emissions by humans between 1850 and 2019.</p>\n<p>Make a claim based on this graph.</p>",
   "answers": [
    {
     "id": 759558,
     "content_html": "Human-caused carbon dioxide emissions were negligibly low in early 1800s."
    },
    {
     "id": 759557,
     "content_html": "Human-caused carbon dioxide emissions remained constant between 1900 and 1950."
    },
    {
     "id": 759556,
     "content_html": "After 2010, human-caused carbon emissions decreased every year."
    },
    {
     "id": 759555,
     "content_html": "Between 1875 and 2010, human-caused carbon emissions increased every year."
    }
   ],
