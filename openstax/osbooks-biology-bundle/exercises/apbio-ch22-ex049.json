 "questions": [
  {
   "id": 520284,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the statements about the loci of biofilm-related disease is false?",
   "answers": [
    {
     "id": 1016587,
     "content_html": "Biofilms are related to foodborne illnesses because they colonize food surfaces and food-processing equipment."
    },
    {
     "id": 1016588,
     "content_html": "In healthcare environments, biofilms grow on ventilators, shunts, and other medical equipment."
    },
    {
     "id": 1016589,
     "content_html": "Biofilms tend to colonize medical devices such as prostheses, contact lenses, and catheters."
    },
    {
     "id": 1016590,
     "content_html": "Biofilms do not form in open wounds, burned tissue, or internal medical devices such as pacemakers."
    }
   ],
