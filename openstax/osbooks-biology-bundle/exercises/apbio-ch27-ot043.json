 "questions": [
  {
   "id": 544181,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/042c7dcc0f89f100.jpg\" alt=\"\">\n(credit: modification of work by Imaging Tech Solutions)\n</figure>\n",
   "stem_html": "<p>The image is taken by a special camera that can see bats on a dark night.</p>\n<p>Why are human eyes unable to see bats like this?</p>",
   "answers": [
    {
     "id": 1069473,
     "content_html": "Warm objects give out infrared radiation. The frequency of infrared radiation is too low for our eyes to detect."
    },
    {
     "id": 1069474,
     "content_html": "Warm objects give out ultraviolet radiation. The frequency of infrared radiation is too low for our eyes to detect."
    },
    {
     "id": 1069475,
     "content_html": "The camera bounces off infrared light off the bats, and then detects it. Our eyes cannot emit light like the camera does."
    },
    {
     "id": 1069476,
     "content_html": "The camera bounces off ultraviolet light off the bats, and then detects it. Our eyes cannot emit light like the camera does."
    }
   ],
