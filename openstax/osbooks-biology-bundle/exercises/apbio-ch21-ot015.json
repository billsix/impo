   "id": 639876,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does the HIV virus use reverse transcriptase in the replication process?",
   "answers": [
    {
     "id": 1247022,
     "content_html": "The HIV virus uses reverse transcriptase to replicate cells and build proteins."
    },
    {
     "id": 1247021,
     "content_html": "The HIV virus uses reverse transcriptase to erase mutated virions."
    },
    {
     "id": 1247023,
     "content_html": "The HIV virus uses reverse transcriptase because it is a retrovirus."
    },
    {
     "id": 1247020,
     "content_html": "The HIV virus uses reverse transcriptase because it has a DNA genome."
    }
