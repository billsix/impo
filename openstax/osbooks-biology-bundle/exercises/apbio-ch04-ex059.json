 "questions": [
  {
   "id": 639547,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Cells lining the intestine absorb a lot of nutrients. How did those cells adapt to their function?",
   "answers": [
    {
     "id": 1245736,
     "content_html": "Cells use cilia to move nutrients to their surface."
    },
    {
     "id": 1245735,
     "content_html": "Cells grow much larger than adjacent cells to increase intake"
    },
    {
     "id": 1245734,
     "content_html": "Cells are flat and thin to absorb more nutrients."
    },
    {
     "id": 1245737,
     "content_html": "Membrane folds called microvilli increase the surface area."
    }
   ],
