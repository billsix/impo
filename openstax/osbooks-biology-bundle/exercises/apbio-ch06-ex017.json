 "questions": [
  {
   "id": 232498,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is an anabolic pathway? Which of these is an example of an anabolic pathway used by cells in their metabolism?",
   "answers": [
    {
     "id": 720138,
     "content_html": "Anabolic pathways involve the breakdown of nutrient molecules into usable forms. An example is the harvesting of amino acids from dietary proteins."
    },
    {
     "id": 720137,
     "content_html": "Anabolic pathways involve the breakdown of nutrient molecules into useable forms. An example is the use of glycogen by the liver to maintain blood glucose levels."
    },
    {
     "id": 720136,
     "content_html": "Anabolic pathways build new molecules out of the products of catabolic pathways. An example is the separation of fatty acids from triglycerides to satisfy energy needs."
    },
    {
     "id": 720139,
     "content_html": "Anabolic pathways build new molecules out of the products of catabolic pathways. An example is the linkage of nucleotides to form a molecule of mRNA."
    }
   ],
