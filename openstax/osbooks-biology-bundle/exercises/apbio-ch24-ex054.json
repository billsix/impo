 "questions": [
  {
   "id": 521071,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Both negative and positive feedback loops are essential for maintaining proper body functions. Blood calcium and blood clotting are under the control of different feedback loops. Which of these processes is maintained by a positive feedback loop and why?",
   "answers": [
    {
     "id": 1018593,
     "content_html": "Blood clotting is maintained by a positive feedback loop, as clotting is amplified in response by increasing the amount of clotting factors when clotting factors are present."
    },
    {
     "id": 1018594,
     "content_html": "Blood clotting is maintained by a positive feedback loop, as clotting factors are maintained in a specific range and a positive loop helps return the conditions to the set point."
    },
    {
     "id": 1018595,
     "content_html": "Blood calcium is maintained by a positive feedback loop, as calcium levels are amplified in response by increasing the amount of calcium levels when calcium is present."
    },
    {
     "id": 1018596,
     "content_html": "Blood calcium is maintained by a positive feedback loop, as calcium levels are maintained in a specific range and a positive feedback loop helps return the conditions to the set point."
    }
   ],
