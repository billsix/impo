  {
   "id": 503508,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The hormone insulin binds to a receptor tyrosine kinase on the surface of target cells. Which of the following steps takes place before phosphorylation of tyrosine residues?",
   "answers": [
    {
     "id": 990015,
     "content_html": "A tyrosine kinase enzyme must be activated."
    },
    {
     "id": 990016,
     "content_html": "GDP is exchanged for GTP."
    },
    {
     "id": 990017,
     "content_html": "The receptor forms a dimer."
    },
    {
     "id": 990018,
     "content_html": "The insulin molecule is internalized in the cytoplasm."
    }
   ],
