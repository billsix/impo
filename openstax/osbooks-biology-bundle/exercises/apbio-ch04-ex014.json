   "stimulus_html": "",
   "stem_html": "What is a difference between prokaryotic and eukaryotic​ cells?",
   "answers": [
    {
     "id": 991155,
     "content_html": "Both cells have a nucleus but prokaryotic cells lack cytoplasm."
    },
    {
     "id": 991156,
     "content_html": "Both cells have cytoplasm but prokaryotic cells lack a nucleus."
    },
    {
     "id": 991157,
     "content_html": "Both cells have DNA but prokaryotic cells lack a cell membrane."
    },
    {
     "id": 991158,
     "content_html": "Both cells have a cell membrane but prokaryotic cells lack DNA."
    }
