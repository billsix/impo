 "questions": [
  {
   "id": 513429,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An allosteric inhibitor does which of the following?",
   "answers": [
    {
     "id": 1005310,
     "content_html": "binds to an enzyme away from the active site and changes the conformation of the active site, increasing its affinity for substrate binding"
    },
    {
     "id": 1005311,
     "content_html": "binds to an active site and blocks it from binding substrate"
    },
    {
     "id": 1005312,
     "content_html": "binds to an enzyme away from the active site and changes the conformation of the active site, decreasing its affinity for the substrate"
    },
    {
     "id": 1005313,
     "content_html": "binds directly to the active site and mimics the substrate"
    }
   ],
