   "id": 520320,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What treatment is possible for people who have too much C. difficile in their digestive system?",
   "answers": [
    {
     "id": 1016731,
     "content_html": "By taking antibiotics like metronidazole as treatment."
    },
    {
     "id": 1016732,
     "content_html": "They can have a fecal transplant from a healthy donor."
    },
    {
     "id": 1016733,
     "content_html": "They can have urine transplant from a healthy donor."
    },
    {
     "id": 1016734,
     "content_html": "By taking probiotic supplements to restore microbial intestinal community."
    }
   ],
