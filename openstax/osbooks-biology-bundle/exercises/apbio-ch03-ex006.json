 "questions": [
  {
   "id": 639499,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The word hydrolysis is defined as the lysis of water. How does this apply to polymers?",
   "answers": [
    {
     "id": 1245547,
     "content_html": "Polymers break by separating water into hydrogen and hydroxyl group that are added to the monomers."
    },
    {
     "id": 1245546,
     "content_html": "Polymers are synthesized by using the energy released by the breaking of water molecules into hydrogen and hydroxyl group."
    },
    {
     "id": 1245545,
     "content_html": "Polymers are separated into monomers producing energy and water molecules."
    },
    {
     "id": 1245544,
     "content_html": "Polymers are hydrolyzed into monomers using water in the process and are called as dehydration synthesis."
    }
   ],
