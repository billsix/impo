   "stimulus_html": "",
   "stem_html": "A lab technician is looking for a slide that shows an example of permanent tissue. Which slide is the best choice?",
   "answers": [
    {
     "id": 1014271,
     "content_html": "a slide of the apical bud of a stem"
    },
    {
     "id": 1014272,
     "content_html": "a slide obtained from the intercalary meristems"
    },
    {
     "id": 1014273,
     "content_html": "a slide obtained from lateral meristem in the vascular cambium"
    },
    {
     "id": 1014274,
     "content_html": "a slide of secondary xylem"
    }
