 "questions": [
  {
   "id": 639566,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the sodium-potassium pump contribute to the net negative charge of the interior of the cell?",
   "answers": [
    {
     "id": 1245812,
     "content_html": "by expelling more cations than are taken in"
    },
    {
     "id": 1245811,
     "content_html": "The sodium-potassium pump expels three ions <span data-math=\"\\text{K}^+\\!\">\\text{K}^+\\!</span> for every two <span data-math=\"\\text{Na}^+\\!\">\\text{Na}^+\\!</span> inside the cells, creating a net positive charge outside the cell and a net negative charge inside the cell."
    },
    {
     "id": 1245810,
     "content_html": "The sodium-potassium pump helps the development of negative charge inside the cell by making the membrane more permeable to negatively charged proteins."
    },
    {
     "id": 1245809,
     "content_html": "The sodium-potassium pump helps in the development of negative charge inside the cell by making the membrane impermeable to positively charged ions."
    }
   ],
