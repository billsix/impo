 "questions": [
  {
   "id": 334646,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would happen if the operator sequence of the <em>trp</em> operon contained a mutation that prevented the repressor protein from binding to the operator?",
   "answers": [
    {
     "id": 844213,
     "content_html": "In the absence of tryptophan, the genes trpA-E will not be transcribed."
    },
    {
     "id": 844214,
     "content_html": "In the absence of tryptophan, only genes trpE and trpD will be transcribed."
    },
    {
     "id": 844216,
     "content_html": "In the presence of tryptophan, the genes trpA-E will be transcribed."
    },
    {
     "id": 844215,
     "content_html": "In the presence of tryptophan, the trpE gene will not be transcribed."
    }
   ],
