   "stem_html": "Why is it useful for blood to travel slowly through capillary beds?",
   "answers": [
    {
     "id": 1045886,
     "content_html": "To allow antibodies to enter infected cells and to promote the diffusion of fluid into the interstitial space."
    },
    {
     "id": 1045887,
     "content_html": "To assist with gas and nutrient exchange and to prevent the diffusion of fluid into the interstitial space."
    },
