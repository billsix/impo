 "questions": [
  {
   "id": 522312,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is genomics?",
   "answers": [
    {
     "id": 1022129,
     "content_html": "Genomics is the study of entire genomes, including the complete set of genes, their nucleotide sequence and organization, and their interactions within a species and with other species."
    },
    {
     "id": 1022130,
     "content_html": "Genomics is the process of finding the locations of genes on each chromosome."
    },
    {
     "id": 1022131,
     "content_html": "Genomics is an illustration that lists genes and their location on a chromosome."
    },
    {
     "id": 1022132,
     "content_html": "Genomics is a genetic marker, a gene or sequence on a chromosome that co-segregates (shows genetic linkage) with a specific trait."
    }
   ],
