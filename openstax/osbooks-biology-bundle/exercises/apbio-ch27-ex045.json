 "questions": [
  {
   "id": 536125,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how the cornea and sclera are anatomically similar and different.",
   "answers": [
    {
     "id": 1050755,
     "content_html": "Both are part of the ciliary body. However, the cornea is composed of collagen and elastic fibers, whereas the sclera is composed of connective tissue with epithelia."
    },
    {
     "id": 1050756,
     "content_html": "Both are part of the ciliary body. However, the cornea is composed of connective tissue with epithelia, whereas the sclera is composed of collagen and elastic fibers."
    },
    {
     "id": 1050757,
     "content_html": "Both are part of the outer tunic. However, the cornea is composed of collagen and elastic fibers, whereas the sclera is composed of connective tissue with epithelia."
    },
