 "questions": [
  {
   "id": 529365,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What role do the intercostal muscles play in inspiration and expiration?",
   "answers": [
    {
     "id": 1036124,
     "content_html": "They move down, causing inspiration, and move up, causing expiration."
    },
    {
     "id": 1036125,
     "content_html": "They move up, causing inspiration, and move down, causing expiration."
    },
    {
     "id": 1036126,
     "content_html": "They relax, causing inspiration, and contract, causing expiration."
    },
    {
     "id": 1036127,
     "content_html": "They contract, causing inspiration, and relax, causing expiration."
    }
