 "questions": [
  {
   "id": 334230,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain in your own words the difference between a spontaneous reaction and one that occurs instantaneously.",
   "answers": [
    {
     "id": 842587,
     "content_html": "A spontaneous reaction is one which releases free energy and moves to a more stable state. Instantaneous reactions occur rapidly with sudden release of energy."
    },
    {
     "id": 842584,
     "content_html": "A spontaneous reaction is one which utilizes free energy and moves to a more stable state. Instantaneous reactions occur rapidly with sudden release of energy."
    },
    {
     "id": 842585,
     "content_html": "A spontaneous reaction is one which releases free energy and moves to a more stable state. Instantaneous reactions occur rapidly within a system by uptake of energy."
    },
    {
     "id": 842586,
     "content_html": "A spontaneous reaction is one in which the reaction occurs rapidly with sudden release of energy. Instantaneous reaction releases free energy and moves to a more stable state."
    }
   ],
