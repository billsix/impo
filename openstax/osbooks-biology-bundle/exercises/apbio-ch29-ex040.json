 "context": "<figure id=\"fig-ch38_04_05\" class=\" \"><span data-type=\"media\" id=\"fs-idp49716928\" data-alt=\"Illustration shows two actin filaments coiled with tropomyosin in a helix, sitting beside a myosin filament. Each actin filament is made of round actin subunits linked in a chain. A bulbous myosin head with ADP and Pi attached sticks up from the myosin filament. The contraction cycle begins when calcium binds to the actin filament, allowing the myosin head to from a cross-bridge. During the power stroke, the myosin head bends and ADP and phosphate are released. As a result, the actin filament moves relative to the myosin filament. A new molecule of ATP binds to the myosin head, causing it to detach. The ATP hydrolyzes to ADP and Pi, returning the myosin head to the cocked position.\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/62a3455ccd19144c35fa612ed268e06729e38b6a\" data-media-type=\"image/jpg\" alt=\"Illustration shows two actin filaments coiled with tropomyosin in a helix, sitting beside a myosin filament. Each actin filament is made of round actin subunits linked in a chain. A bulbous myosin head with ADP and Pi attached sticks up from the myosin filament. The contraction cycle begins when calcium binds to the actin filament, allowing the myosin head to from a cross-bridge. During the power stroke, the myosin head bends and ADP and phosphate are released. As a result, the actin filament moves relative to the myosin filament. A new molecule of ATP binds to the myosin head, causing it to detach. The ATP hydrolyzes to ADP and Pi, returning the myosin head to the cocked position.\" width=\"320\" height=\"472\">\n</span>\n\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 546979,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about the “power stroke” of muscle contraction is true?",
   "answers": [
    {
     "id": 1073019,
     "content_html": "It occurs when ATP is hydrolyzed to ADP and phosphate."
    },
    {
     "id": 1073020,
     "content_html": "It occurs a new molecule of ATP attaches to the myosin head."
    },
    {
     "id": 1073021,
     "content_html": "It occurs when ADP and phosphate separate from the myosin head."
    },
    {
     "id": 1073022,
     "content_html": "It occurs when ADP and phosphate separate from the actin active site."
    }
   ],
