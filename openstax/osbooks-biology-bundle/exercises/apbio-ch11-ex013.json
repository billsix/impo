 "questions": [
  {
   "id": 507882,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following distinguishes metaphase I from metaphase II?",
   "answers": [
    {
     "id": 995168,
     "content_html": "Metaphase I occurs when homologous chromosome pairs align on the metaphase plate. Metaphase II has sister chromatids of chromosomes aligned at the metaphase plate."
    },
    {
     "id": 995169,
     "content_html": "Metaphase I occurs when chromosomes appear in homologous pairs at the metaphase plate. Metaphase II has single sister chromatids of chromosomes on the spindle. "
    },
    {
     "id": 995170,
     "content_html": "Metaphase I occurs when chromosomes separate the homologous pairs on the spindle. Metaphase II has a single line of chromosomes on the plate. "
    },
    {
     "id": 995171,
     "content_html": "Metaphase I occurs when chromosomes appear in homologous pairs on the spindle. During metaphase II, the chromosomes line up in a double line across the spindle. "
    }
   ],
