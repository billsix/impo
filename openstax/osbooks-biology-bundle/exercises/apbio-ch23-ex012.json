 "questions": [
  {
   "id": 519561,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Plants with shallow roots are more easily damaged by some herbivores. Make a logical case to support this claim.",
   "answers": [
    {
     "id": 1014367,
     "content_html": "Shallow roots do not anchor the plant to the ground and can be easily uprooted. Once the plant is no longer in the ground, the roots are unable to grow back."
    },
    {
     "id": 1014368,
     "content_html": "Plants with shallow roots do not anchor the plant to the ground; meristems can be easily damaged and cannot grow back when not in the ground."
    },
    {
     "id": 1014369,
     "content_html": "Shallow roots do not anchor the plant to the ground and can be easily uprooted. However, once the plant is no longer in the ground, roots recover quickly."
    },
    {
     "id": 1014370,
     "content_html": "Shallow roots anchor the plant to the ground strongly but can be uprooted when soil is damaged, and they grow back very slowly."
    }
   ],
