 "questions": [
  {
   "id": 511800,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A lack of protein in the diet can cause hair loss. Explain why this occurs.",
   "answers": [
    {
     "id": 1000838,
     "content_html": "Due to lack of protein in the diet, our body will not be able to form other proteins; thus, it will conserve the protein it has for critical use, leading to hair loss."
    },
    {
     "id": 1000839,
     "content_html": "Lack of protein in the diet can weaken the immune system, thus leading to hair loss."
    },
    {
     "id": 1000840,
     "content_html": "Due to lack of protein in the diet, energy will be lost, thus leading to hair loss."
    },
    {
     "id": 1000841,
     "content_html": "Lack of protein in the diet will lead to breakage of disulfide bonds between proteins, thus leading to hair loss."
    }
   ],
