 "questions": [
  {
   "id": 521678,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about the digestive system is false?",
   "answers": [
    {
     "id": 1020512,
     "content_html": "Chyme is a mixture of food and digestive juices that is produced in the stomach."
    },
    {
     "id": 1020513,
     "content_html": "Food enters the large intestine before the small intestine."
    },
    {
     "id": 1020514,
     "content_html": "In the small intestine, chyme mixes with bile, which emulsifies fats."
    },
    {
     "id": 1020515,
     "content_html": "The stomach is separated from the small intestine by the pyloric sphincter."
    }
   ],
