 "context": "<figure id=\"fig-ch09_02_01\"><span data-type=\"media\" id=\"fs-id2694648\" data-alt=\"This illustration shows the epidermal growth factor receptor, which is embedded in the plasma membrane. Upon binding of a signaling molecule to the receptor’s extracellular domain, the receptor dimerizes, and intracellular residues are phosphorylated. Phosphorylation of the receptor triggers the phosphorylation of a protein called MEK by RAF. MEK, in turn, phosphorylates ERK. ERK stimulates protein translation in the cytoplasm, and transcription in the nucleus. Activation of ERK stimulates cell proliferation, cell migration and adhesion, and angiogenesis (growth of new blood vessels). ERK inhibits apoptosis.\">\n        <img src=\"https://openstax.org/apps/archive/20240910.161227/resources/6f78261d5a0912fbab9c518ec0d592b6cf3c42e1\" data-media-type=\"image/png\" alt=\"This illustration shows the epidermal growth factor receptor, which is embedded in the plasma membrane. Upon binding of a signaling molecule to the receptor’s extracellular domain, the receptor dimerizes, and intracellular residues are phosphorylated. Phosphorylation of the receptor triggers the phosphorylation of a protein called MEK by RAF. MEK, in turn, phosphorylates ERK. ERK stimulates protein translation in the cytoplasm, and transcription in the nucleus. Activation of ERK stimulates cell proliferation, cell migration and adhesion, and angiogenesis (growth of new blood vessels). ERK inhibits apoptosis.\" width=\"280\" height=\"558\">\n    </span>\n    </figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 620870,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In certain cancers, the GTPase activity of the RAS G-protein is inhibited. This means that the RAS protein can no longer hydrolyze GTP into GDP. What effect would this have on downstream cellular events?",
   "answers": [
    {
     "id": 1185128,
     "content_html": "Cells will not proliferate."
    },
    {
     "id": 1185129,
     "content_html": "ERK is permanently inactivated."
    },
    {
     "id": 1185130,
     "content_html": "Regulated cell division."
    },
    {
     "id": 1185131,
     "content_html": "Uncontrolled cell proliferation."
    }
   ],
