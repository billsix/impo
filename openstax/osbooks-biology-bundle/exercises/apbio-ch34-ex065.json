  {
   "id": 623691,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What occurs in the procedure known as in vitro fertilization (IVF)?",
   "answers": [
    {
     "id": 1196280,
     "content_html": "A sperm is injected into the egg externally."
    },
    {
     "id": 1196279,
     "content_html": "An egg is fertilized by the sperm internally in the oviduct."
    },
    {
     "id": 1196278,
     "content_html": "Eggs and sperm are combined externally and then implanted."
    },
    {
     "id": 1196281,
     "content_html": "Egg and sperm are combined externally and the resulting embryo is implanted."
    }
   ],
