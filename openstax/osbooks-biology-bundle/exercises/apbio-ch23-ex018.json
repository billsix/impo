 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm48920256\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-idp86541056\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/54331aa87e11864385ae0f8f8a593a4a61bcf92b\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idm47088160\">Watch this <a href=\"https://openstaxcollege.org/l/motion_plants\" target=\"_blank\" rel=\"noopener nofollow\">BBC Nature video</a> showing how time-lapse photography captures plant growth at high speed.</p>\n</div>\n</div>",
