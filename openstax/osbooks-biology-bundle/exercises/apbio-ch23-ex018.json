 "questions": [
  {
   "id": 519655,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Watch this BBC Nature video showing how time-lapse photography captures plant growth at high speed. The video shows time lapse photography of the growth of a stem. Which of these is a fast response in a plant that was not recorded in the video? <iframe src=\"https://www.youtube.com/embed/kX2RtDE9BBw\"></iframe>",
   "answers": [
    {
     "id": 1014447,
     "content_html": "opening of a flower"
    },
    {
     "id": 1014448,
     "content_html": "tendrils looping around a support"
    },
    {
     "id": 1014449,
     "content_html": "growth of an apical bud"
    },
    {
     "id": 1014450,
     "content_html": "closing of leaflets on a lightly touched mimosa leaf"
    }
   ],
