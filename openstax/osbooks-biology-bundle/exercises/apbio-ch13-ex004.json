 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id2060998\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n                    <span data-type=\"media\" id=\"fs-id2022792\" data-alt=\"QR Code representing a URL\">\n                        <img src=\"https://openstax.org/apps/archive/20240910.161227/resources/cc3730bb38e4dce8c8a0be50d3838a4356372f4b\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n                    </span>\n                    <p id=\"fs-id2570945\">Review Sturtevant’s process to create a genetic map on the basis of recombination frequencies <a href=\"https://openstaxcollege.org/l/gene_crossover\" target=\"_blank\" rel=\"noopener nofollow\">here</a>.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 504397,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Genetic diversity is the total number of genetic characteristics in a given species. Explain how chromosomal crossover contributes to genetic diversity by providing the specific mechanism responsible for this contribution.",
   "answers": [
    {
     "id": 992177,
     "content_html": "Chromosomal crossover is a specific, non-random process during which chromosomes are linked together and exchange DNA, which contributes to the genetic diversity."
    },
    {
     "id": 992178,
     "content_html": "Chromosomal crossover occurs during meiosis when chromosome pairs are linked and exchange DNA. Thus, crossover increases the variance of genetic combinations in the haploid gamete cell."
    },
    {
     "id": 992179,
     "content_html": "Chromosomal crossover results in the inheritance of enhanced genetic material by offspring, and the subsequent recombination event is not variable in frequency or location."
    },
    {
     "id": 992180,
     "content_html": "Chromosomal crossover occurs during the mitotic process when chromosomes are linked together and recombination takes place, increasing the variance of genetic combinations in the haploid mitotic cells formed from mitosis."
    }
   ],
