   "stimulus_html": "",
   "stem_html": "Which of these describe some of the similarities and differences between glycogen and starch?",
   "answers": [
    {
     "id": 988049,
     "content_html": "Glycogen is less branched than starch and is found in animals."
    },
    {
     "id": 988050,
     "content_html": "Glycogen is more highly branched than starch and is found in plants."
    },
    {
     "id": 988051,
     "content_html": "Starch is less branched than glycogen and is found in plants."
    },
