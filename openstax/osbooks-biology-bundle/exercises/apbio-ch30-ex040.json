 "questions": [
  {
   "id": 529665,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Based on your understanding of how carbon dioxide is transported from body tissues to the lungs, explain the relationship between the chloride shift and the transport of carbon dioxide in the blood.",
   "answers": [
    {
     "id": 1036596,
     "content_html": "The chloride shift allows carbon dioxide, in the form of bicarbonate ions, to enter the blood plasma."
    },
    {
     "id": 1036597,
     "content_html": "The chloride shift creates carbaminohemoglobin within the red blood cells."
    },
    {
     "id": 1036598,
     "content_html": "The chloride shift allows the conversion of carbon dioxide into carbonic acid within red blood cells."
    },
    {
     "id": 1036599,
     "content_html": "The chloride shift prevents the formation of bicarbonate ions in the blood."
    }
   ],
