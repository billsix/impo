 "questions": [
  {
   "id": 639867,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why the classic tree model needs to be revised.",
   "answers": [
    {
     "id": 1246984,
     "content_html": "The model is unable to incorporate DNA evidence."
    },
    {
     "id": 1246985,
     "content_html": "The model is erroneously based on many analogous traits, which have no basis in evolutionary relationships."
    },
    {
     "id": 1246986,
     "content_html": "The model cannot be experimentally verified."
    },
    {
     "id": 1246987,
     "content_html": "The model does not consider the possibility that genes could be transferred between unrelated species."
    }
   ],
