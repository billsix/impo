 "questions": [
  {
   "id": 503138,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Limestone is a naturally occurring mineral rich in calcium carbonate (<span data-math=\"\\text{CaCO}_3\">\\text{CaCO}_3</span>). In water, calcium carbonate dissolves to form carbonate <span data-math=\"({{\\text{CO}_3}}^{2-})\">({{\\text{CO}_3}{\\!}}^{2-})</span>, a weak base that acts as a buffer. Which would you expect to be more affected by acid rain, an environment rich in limestone or an environment poor in limestone?",
   "answers": [
    {
     "id": 988683,
     "content_html": "The presence of limestone would not make a difference."
    },
    {
     "id": 988684,
     "content_html": "An environment rich in limestone would be more affected by acid rain."
    },
    {
     "id": 988685,
     "content_html": "An environment poor in limestone would be more affected by acid rain."
    },
    {
     "id": 988686,
     "content_html": "The impact would depend on the type of vegetation present."
    }
   ],
