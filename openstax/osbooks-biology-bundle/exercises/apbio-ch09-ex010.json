 "context": "<figure id=\"fig-ch09_01_03\"><span data-type=\"media\" id=\"fs-id1430921\" data-alt=\"This illustration shows a hydrophobic signaling molecule that diffuses across the plasma membrane and binds an intracellular receptor in the cytoplasm. The intracellular receptor-signaling molecule complex then travels to the nucleus and binds DNA.\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/80ea90c5ba3e58bafa07f0da6a7c8f2036f6bfbf\" data-media-type=\"image/jpg\" alt=\"This illustration shows a hydrophobic signaling molecule that diffuses across the plasma membrane and binds an intracellular receptor in the cytoplasm. The intracellular receptor-signaling molecule complex then travels to the nucleus and binds DNA.\" width=\"300\" height=\"283\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 639645,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Review the activity involved in a signaling molecule binding to an internal receptor, as depicted in the illustration. Identify the best description of the differences between internal receptors and cell-surface receptors.",
   "answers": [
    {
     "id": 1246119,
     "content_html": "Internal receptors bind to ligands that are hydrophobic and the ligand-receptor complex directly enters the nucleus, initiating transcription and translation. Cell- surface receptors bind to hydrophilic ligands and initiate a signaling cascade that indirectly influences the making of a functional protein."
    },
    {
     "id": 1246118,
     "content_html": "Internal receptors bind to ligands that are hydrophilic and the ligand-receptor complex directly enters the nucleus, initiating transcription and translation. Cell-surface receptors bind to hydrophobic ligands and initiate a signaling cascade that indirectly influences the making of a functional protein."
    },
    {
     "id": 1246117,
     "content_html": "Internal receptors bind to ligands that are hydrophobic and initiate the signaling cascade that indirectly influences the making of a functional protein. Cell-surface receptors bind to hydrophilic ligands and a ligand-receptor complex directly enters the nucleus, initiating transcription and translation."
    },
    {
     "id": 1246116,
     "content_html": "Internal receptors are integral membrane proteins that bind to hydrophobic ligands, initiating a signaling cascade, which indirectly influences the making of a functional protein. Cell-surface receptors bind to hydrophilic ligands and the ligand-receptor complex directly enters the nucleus, initiating transcription and translation."
    }
   ],
