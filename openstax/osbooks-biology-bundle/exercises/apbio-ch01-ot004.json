 "questions": [
  {
   "id": 503257,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is an example of deductive reasoning?",
   "answers": [
    {
     "id": 989011,
     "content_html": "Most swimming animals use fins; therefore, fins are an adaptation to swimming."
    },
    {
     "id": 989012,
     "content_html": "Mitochondria are inherited from the mother; therefore, maternally inherited traits are encoded by mitochondrial DNA"
    },
    {
     "id": 989013,
     "content_html": "Small animals lose more heat than larger animals. One would not expect to find wild mice in the poles."
    },
    {
     "id": 989014,
     "content_html": "Water conservation is a major requirement to survive in the desert. Long leaves increase loss of water by evaporation. Therefore, desert plants should have smaller leaves."
    }
   ],
