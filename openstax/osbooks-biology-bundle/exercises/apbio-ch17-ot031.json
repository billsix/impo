 "questions": [
  {
   "id": 639816,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the reason for studying mitochondrial genomics that is most directly important for humans?",
   "answers": [
    {
     "id": 1246784,
     "content_html": "Mitochondria evolved from bacteria; therefore, their genome is important to study."
    },
    {
     "id": 1246785,
     "content_html": "Mitochondria undergo rapid mutation and it is essential that this pattern be studied."
    },
    {
     "id": 1246787,
     "content_html": "Mitochondria contain DNA, and it is passed on from mother to offspring, which renders it helpful in tracing genealogy."
    },
    {
     "id": 1246786,
     "content_html": "Mitochondria are the only ATP-producing organelles of the cell, thus their genome is important."
    }
   ],
