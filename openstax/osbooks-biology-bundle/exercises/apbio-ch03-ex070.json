 "questions": [
  {
   "id": 495750,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would happen if even one amino acid is substituted for another in a polypeptide? What would be an example? ",
   "answers": [
    {
     "id": 978398,
     "content_html": "The change will definitely not be sufficient to have any effect on the function and structure of the protein."
    },
    {
     "id": 978399,
     "content_html": "The amino acid may not show any significant effect the protein structure and function or it may have a significant effect, as in the case of hemoglobin in individuals with sickle cell trait."
    },
    {
     "id": 978400,
     "content_html": "These changes would increase the possibility of having extra bends and loops in the proteins as in Leber congenital disease."
    },
    {
     "id": 978401,
     "content_html": "These changes would modify the structures of proteins making them nonfunctional."
    }
   ],
