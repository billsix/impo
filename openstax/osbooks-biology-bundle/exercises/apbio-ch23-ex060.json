 "questions": [
  {
   "id": 520856,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Different plants have adaptations to various environmental demands. Differentiate between the scenarios presented to make a claim for which plants have leaves that are adapted to cold temperatures, and which specific adaptations they employ.",
   "answers": [
    {
     "id": 1017995,
     "content_html": "Conifers such as spruce, fir, and pine have oval-shaped leaves with sunken stomata, helping to reduce water loss."
    },
    {
     "id": 1017996,
     "content_html": "Succulents such as aloes and agaves have waxy cuticles with sunken stomata, helping to reduce water loss."
    },
    {
     "id": 1017997,
     "content_html": "Conifers such as spruce, orchids, and pine have needle-shaped leaves with sunken stomata, helping to reduce water loss."
    },
    {
     "id": 1017998,
     "content_html": "Conifers such as spruce, fir, and pine have needle-shaped leaves with sunken stomata, helping to reduce water loss."
    }
