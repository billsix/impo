 "is_vocab": false,
 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idm26586528\" class=\"interactive ost-tag-lo-apbio-ch30-s03-lo02 ost-assessed-feature\" data-label=\"Link to Learning\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<p id=\"fs-idp133557200\">Visit this <a href=\"https://openstax.org/l/breathing\" target=\"_blank\" rel=\"noopener nofollow\">site</a> to view the mechanics of breathing.</p>\n<div data-type=\"injected-exercise\" class=\"os-embed autogenerated-content\" data-injected-from-nickname=\"\" data-injected-from-version=\"13\" data-injected-from-url=\"https://exercises.openstax.org/api/exercises?q=tag:apbio-ch30-ex025\" data-tags=\"apbio-ch30-ex025 exid:apbio-ch30-ex025 context-cnxfeature:fs-idm26586528 lo:stax-apbio:30-03-02 interactive apbio-ch30-s03-lo02 apbio-ch30 apbio-ch30-s03 context-cnxmod:b9c343a3-1afc-4569-864b-721b5452bc02 filter-type:import:has-context blooms:3 assignment-type:homework apbio book:stax-apbio filter-type:import:hs inbook-yes dok:3 book-slug:biology-ap-courses module-slug:biology-ap-courses:30-3-breathing time:medium\" data-is-vocab=\"false\" data-question-count=\"1\" data-is-multipart=\"False\">\n    \n    <div data-type=\"exercise-question\" data-is-answer-order-important=\"true\" data-formats=\"free-response multiple-choice\" id=\"305655\"><div class=\"os-problem-container\">\n        <div data-type=\"question-stem\">How does the downward movement of the diaphragm allow us to breathe?</div>\n        <ol data-type=\"question-answers\" type=\"a\">\n            <li data-type=\"question-answer\" data-correctness=\"\">\n                <div data-type=\"answer-content\">It reduces the volume of the thoracic cavity, increasing the air pressure in the lungs and triggering inhalation.</div>\n                \n            </li>\n            <li data-type=\"question-answer\" data-correctness=\"\">\n                <div data-type=\"answer-content\">It reduces the volume of the thoracic cavity, increasing the air pressure in the lungs and triggering exhalation.</div>\n                \n            </li>\n            <li data-type=\"question-answer\" data-correctness=\"\">\n                <div data-type=\"answer-content\">It creates a partial vacuum in the thoracic cavity into which outside air flows during exhalation.</div>\n                \n            </li>\n            <li data-type=\"question-answer\" data-correctness=\"\">\n                <div data-type=\"answer-content\">It creates a partial vacuum in the thoracic cavity into which outside air flows during inhalation.</div>\n                \n            </li>\n            </ol>\n        </div></div>\n    </div>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
