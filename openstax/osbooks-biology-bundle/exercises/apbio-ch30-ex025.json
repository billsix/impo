   "stem_html": "How does the downward movement of the diaphragm allow us to breathe?",
   "answers": [
    {
     "id": 1072691,
     "content_html": "It reduces the volume of the thoracic cavity, increasing the air pressure in the lungs and triggering inhalation."
    },
    {
     "id": 1072692,
     "content_html": "It reduces the volume of the thoracic cavity, increasing the air pressure in the lungs and triggering exhalation."
    },
    {
     "id": 1072693,
     "content_html": "It creates a partial vacuum in the thoracic cavity into which outside air flows during exhalation."
    },
    {
     "id": 1072694,
     "content_html": "It creates a partial vacuum in the thoracic cavity into which outside air flows during inhalation."
    }
