 "questions": [
  {
   "id": 520388,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/4878db41c0b1b79f.jpg\" alt=\"\">\n(credit: modification of work by Kleiber M./<i>Hilgardia</i>)\n</figure>",
   "stem_html": "<p>The graph shows the relationship between basal metabolic rate and mass for different organisms.</p>\n<p>What is a scientific claim that can be stated based on the graph?</p>",
   "answers": [
    {
     "id": 1016961,
     "content_html": "Basal metabolic rate and body mass are not related."
    },
    {
     "id": 1016962,
     "content_html": "Animals that are bigger have, overall, a higher basal metabolic rate."
    },
    {
     "id": 1016963,
     "content_html": "Animals that are bigger have a lower basal metabolic rate."
    },
    {
     "id": 1016964,
     "content_html": "Animals that are cold blooded have a high basal metabolic rate than warm blooded animals."
    }
   ],
