 "questions": [
  {
   "id": 242348,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between innate and adaptive immune responses?",
   "answers": [
    {
     "id": 758851,
     "content_html": "The adaptive immune system is faster-acting than the innate immune system."
    },
    {
     "id": 758854,
     "content_html": "The adaptive immune system produces a longer-lasting defense than the innate immune system."
    },
    {
     "id": 758852,
     "content_html": "The innate immune system produces a more specific defense than the adaptive immune system."
    },
    {
     "id": 758853,
     "content_html": "The innate immune system has a more sophisticated memory than the adaptive immune system."
    }
   ],
