 "questions": [
  {
   "id": 639727,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "DNA replication is bidirectional and discontinuous; explain your understanding of those concepts.",
   "answers": [
    {
     "id": 1246440,
     "content_html": "DNA polymerase reads the template strand in the 3’ to 5’ direction and adds nucleotides only in the 5’ to 3’ direction. The leading strand is synthesized in the direction of the replication fork. Replication on the lagging strand occurs in the direction away from the replication fork in short stretches of DNA called Okazaki fragments."
    },
    {
     "id": 1246439,
     "content_html": "DNA polymerase reads the template strand in the 5’ to 3’ direction and adds nucleotides only in the 5’ to 3’ direction. The leading strand is synthesized in the direction of the replication fork. Replication on the lagging strand occurs in the direction away from the replication fork in short stretches of DNA called Okazaki fragments."
    },
    {
     "id": 1246438,
     "content_html": "DNA polymerase reads the template strand in the 3’ to 5’ direction and adds nucleotides only in the 5’ to 3’ direction. The leading strand is synthesized in the direction away from the replication fork. Replication on the lagging strand occurs in the direction of the replication fork in short stretches of DNA called Okazaki fragments."
    },
    {
     "id": 1246437,
     "content_html": "DNA polymerase reads the template strand in the 5’ to 3’ direction and adds nucleotides only in the 3’ to 5’ direction. The leading strand is synthesized in the direction of the replication fork. Replication on the lagging strand occurs in the direction away from the replication fork in long stretches of DNA called Okazaki fragments."
    }
   ],
