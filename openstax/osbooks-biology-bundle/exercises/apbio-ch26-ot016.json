 "questions": [
  {
   "id": 531796,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Public speaking can be very stressful. How can anticipating giving a public speech stimulate the sympathetic nervous system?",
   "answers": [
    {
     "id": 1040100,
     "content_html": "During stress, multiple preganglionic neurons can synapse on one postganglionic neuron, and the adrenal gland releases adrenaline."
    },
    {
     "id": 1040101,
     "content_html": "During stress, one preganglionic neuron can synapse on multiple postganglionic neurons, and the thymus gland releases norepinephrine."
    },
    {
     "id": 1040102,
     "content_html": "During stress, one postganglionic neuron can synapse on multiple preganglionic neurons, and the adrenal gland releases norepinephrine."
    },
    {
     "id": 1040103,
     "content_html": "During stress, one preganglionic neuron can synapse on multiple postganglionic neurons, and the adrenal gland releases norepinephrine."
    }
   ],
