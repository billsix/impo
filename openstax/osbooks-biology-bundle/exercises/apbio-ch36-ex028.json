 "questions": [
  {
   "id": 242572,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "During breeding season, many female elk mate with males, but not all mated females become pregnant. Female elk having body fat less than 6% were found to have greatly reduced chances of becoming pregnant than female elk having body fat above 10%. Explain how natural selection was likely involved in establishing this trait in elk.  (credit: USGS Northern Prairie Wildlife Research Center)",
   "answers": [
    {
     "id": 759747,
     "content_html": "Through natural selection, female elk that did not have the energy reserves to carry a pregnancy to term and did not become pregnant died whereas those which became pregnant anyway were favored."
    },
    {
     "id": 759750,
     "content_html": "Natural selection favored the selection of traits preventing pregnancies in female elk with low fat reserves, so this trait has become predominant in natural elk herds observed today."
    },
    {
     "id": 759748,
     "content_html": "Natural selection randomly changes the frequency of genes allowing traits preventing pregnancies in female elk with low fat reserves to be favored."
    },
    {
     "id": 759749,
     "content_html": "Natural selection leads to a sudden inheritable change in the genome of the female elk, ensuring female elk with very high fat reserves to effectively carry out pregnancy."
    }
   ],
   "hints": [],
