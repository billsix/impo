 "questions": [
  {
   "id": 503149,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What property of carboxyl makes carboxyl containing molecules hydrophilic? Which macromolecules contain carboxyl?",
   "answers": [
    {
     "id": 988727,
     "content_html": "Carboxyl groups release <span data-math=\"\\text{H}^{+} {\\!}\">\\text{H}^{+} {\\!}</span>, making its parent molecule hydrophilic. It is found amino acids and fatty acids. "
    },
    {
     "id": 988728,
     "content_html": "Carboxyl groups absorb <span data-math=\"\\text{H}^{+} {\\!}\">\\text{H}^{+} {\\!}</span> ion, making its parent molecule hydrophilic. It is found in phospholipids and triglycerides."
    },
    {
     "id": 988729,
     "content_html": "Carboxyl groups release <span data-math=\"\\text{OH}^{-} {\\!}\">\\text{OH}^{-} {\\!}</span>, making its parent molecule hydrophilic. It is found in phospholipids phosphates and triglycerides"
    },
    {
     "id": 988730,
     "content_html": "Carboxyl groups release <span data-math=\"\\text{OH}^{-} {\\!}\">\\text{OH}^{-} {\\!}</span>, making its parent molecule hydrophilic. It is found in phospholipids and DNA."
    }
   ],
