   "id": 535037,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The kidney is made up of over a million nephrons that give it a granular appearance. What is a nephron?",
   "answers": [
    {
     "id": 1046658,
     "content_html": "a network of capillaries"
    },
    {
     "id": 1046659,
     "content_html": "the cup-shaped chamber surrounding the glomerulus"
    },
    {
     "id": 1046660,
     "content_html": "the functional unit of the kidney"
    },
    {
     "id": 1046661,
     "content_html": "the bow-shaped artery at the base of medullary pyramids"
    }
