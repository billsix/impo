 "questions": [
  {
   "id": 654096,
   "is_answer_order_important": true,
   "stimulus_html": "Visit this <a href=\"https://openstaxcollege.org/l/transcription2\" rel=\"nofollow\" target=\"_blank\">BioStudio animation to see the process of prokaryotic translation.</a>",
   "stem_html": "Why is the stop codon necessary for translation?",
   "answers": [
    {
     "id": 1288562,
     "content_html": "The stop codon is the first step in a series of steps to end translation."
    },
    {
     "id": 1288563,
     "content_html": "The stop codon is necessary to initiate translation."
    },
    {
     "id": 1288564,
     "content_html": "The stop codon ends translation which allows the polypeptide strand to be released."
    },
    {
     "id": 1288565,
     "content_html": "The stop codon ends translation in order to initiate transcription."
    }
   ],
