 "questions": [
  {
   "id": 503498,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Multicellular organisms employ four different categories of chemical signaling. Analyze the following descriptions to select the benefit provided by autocrine signaling.",
   "answers": [
    {
     "id": 989975,
     "content_html": "Autocrine signaling helps cells to communicate with distantly located cells."
    },
    {
     "id": 989976,
     "content_html": "Autocrine signaling connects nearby located cells."
    },
    {
     "id": 989977,
     "content_html": "Autocrine signaling helps to amplify the signal by inducing more signaling production from the cell itself."
    },
    {
     "id": 989978,
     "content_html": "Autocrine signaling is specific only for the cell that produced it, giving it a precise means of messaging."
    }
   ],
