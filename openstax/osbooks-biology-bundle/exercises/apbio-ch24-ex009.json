 "questions": [
  {
   "id": 520386,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are most organisms with exoskeletons relatively small?",
   "answers": [
    {
     "id": 1016953,
     "content_html": "Increases in body weight increase body size by a factor of eight, and the chitin thickness of the exoskeleton has to significantly decrease to accommodate increase in body size."
    },
    {
     "id": 1016954,
     "content_html": "Doubling of body size increases body weight by a factor of eight, and the chitin thickness of the exoskeleton has to significantly decrease to accommodate weight increase."
    },
    {
     "id": 1016955,
     "content_html": "Increases in body weight increase body size by a factor of eight, and the chitin thickness of the exoskeleton has to significantly increase to accommodate increase in body size."
    },
    {
     "id": 1016956,
     "content_html": "Doubling of body size increases body weight by a factor of eight, and the chitin thickness of the exoskeleton has to significantly increase to accommodate weight increase."
    }
