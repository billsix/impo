 "questions": [
  {
   "id": 521768,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is the gallbladder involved in digestion, even though it is considered an accessory organ?",
   "answers": [
    {
     "id": 1020788,
     "content_html": "The gallbladder secretes bile to the duodenum, which uses it to break down proteins. It is considered an accessory organ because food does not directly pass through it."
    },
    {
     "id": 1020789,
     "content_html": "The gallbladder secretes bile to the duodenum, which uses it to break down fats. It is considered an accessory organ because food does not directly pass through it."
    },
    {
     "id": 1020790,
     "content_html": "The gallbladder secretes bile to the ileum, which uses it to break down fats. It is considered an accessory organ because food does not directly pass through it."
    },
    {
     "id": 1020791,
     "content_html": "The gallbladder secretes bile to the ileum, which uses it to break down proteins. It is considered an accessory organ because only a very small amount of digestion takes place in the gallbladder."
    }
   ],
