   "stem_html": "Which of the following statements about the process of digestion is true?",
   "answers": [
    {
     "id": 1028924,
     "content_html": "Organisms absorb large molecules through digestive cells."
    },
    {
     "id": 1028925,
     "content_html": "The last step of digestion is absorption."
    },
    {
     "id": 1028926,
     "content_html": "Food is only mechanically broken down in the mouth."
    },
    {
     "id": 1028927,
     "content_html": "Food is prepared into a bolus before it is swallowed."
    }
