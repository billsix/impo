 "questions": [
  {
   "id": 233287,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe how RBPs can prevent miRNAs from degrading an RNA molecule.",
   "answers": [
    {
     "id": 723294,
     "content_html": "RBPs can bind first to the RNA, thus preventing the binding of miRNA, which degrades RNA."
    },
    {
     "id": 723291,
     "content_html": "RBPs bind the miRNA, thereby protecting the mRNA from degradation."
    },
    {
     "id": 723292,
     "content_html": "RBPs methylate miRNA to inhibit its function and thus stop mRNA degradation."
    },
    {
     "id": 723293,
     "content_html": "RBPs direct miRNA degradation with the help of a DICER protein complex."
    }
   ],
