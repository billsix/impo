 "questions": [
  {
   "id": 241474,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do plants that cannot detect gravity show stunted growth with tangled roots and trailing stems?",
   "answers": [
    {
     "id": 755356,
     "content_html": "Without gravitropism, both roots and seedlings would grow upward."
    },
    {
     "id": 755357,
     "content_html": "Without gravitropism, roots would grow in all directions and seedlings would grow upward."
    },
    {
     "id": 755358,
     "content_html": "Without gravitropism, roots would grow upward but seedlings would not grow upward toward the surface."
    },
    {
     "id": 755359,
     "content_html": "Without gravitropism, roots would grow in all directions but seedlings would not grow upward toward the surface."
    }
   ],
