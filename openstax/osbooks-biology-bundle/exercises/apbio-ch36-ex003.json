 "questions": [
  {
   "id": 535944,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements can be made about the mark and recapture method of counting population numbers?",
   "answers": [
    {
     "id": 1050055,
     "content_html": "Using quadrats for counting individuals in a population increases the accuracy of the mark and recapture method."
    },
    {
     "id": 1050056,
     "content_html": "The greater the number of individuals captured during the first round of mark and recapture, the greater is the overall population size."
    },
    {
     "id": 1050057,
     "content_html": "The mark and recapture method is useful for mammals and birds, but of little use for other organisms."
    },
    {
     "id": 1050058,
     "content_html": "An underestimate of population size would tend to be observed in cases of studies involving animals that learn to seek out bait."
    }
   ],
