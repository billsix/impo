 "questions": [
  {
   "id": 546480,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Predict how human population change in the next 50 years is likely to affect marine ecosystems.",
   "answers": [
    {
     "id": 1071088,
     "content_html": "Humans will decrease their own carrying capacity, which will also decrease the carrying capacities of marine ecosystems."
    },
    {
     "id": 1071089,
     "content_html": "Decreased fishing can be expected, which will lead to rebounds in fish populations and healthier marine ecosystems."
    },
    {
     "id": 1071090,
     "content_html": "Increases in greenhouse gas emissions are likely, with increases in ocean temperatures that trigger shifts in marine populations."
    },
    {
     "id": 1071091,
     "content_html": "Biodiversity of marine ecosystems will increase as humans use engineering to increase food production in the oceans."
    }
   ],
