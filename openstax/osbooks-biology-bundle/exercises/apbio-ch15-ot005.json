 "questions": [
  {
   "id": 511815,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What part of central dogma is not always followed in viruses?",
   "answers": [
    {
     "id": 1000898,
     "content_html": "The flow of information in HIV is from RNA to DNA, then back to RNA to proteins. Influenza viruses never go through DNA."
    },
    {
     "id": 1000899,
     "content_html": "The flow of information is from protein to RNA in HIV virus, while the influenza virus converts DNA to RNA."
    },
    {
     "id": 1000900,
     "content_html": "The flow of information is similar, but nucleic acids are synthesized as a result of translation in HIV and influenza viruses."
    },
    {
     "id": 1000901,
     "content_html": "The flow of information is from RNA to protein. This protein is used to synthesize the DNA of the viruses in HIV and influenza."
    }
   ],
