  {
   "id": 640158,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When you are eating a meal, how do you know when you are full?",
   "answers": [
    {
     "id": 1248134,
     "content_html": "The pituitary gland release hormones when the stomach is full, which therefore reduces hunger."
    },
    {
     "id": 1248135,
     "content_html": "The brain signals when the stomach is full that you are satiated, which therefore reduces hunger."
    },
    {
     "id": 1248133,
     "content_html": "The stomach signals when it is full, which therefore reduces hunger."
    },
    {
     "id": 1248132,
     "content_html": "Low blood sugar levels stimulate a neurotransmitter, which sends a signal to the brain when the stomach is full and therefore reduces hunger."
    }
   ],
