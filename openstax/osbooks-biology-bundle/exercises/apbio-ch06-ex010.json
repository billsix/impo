 "questions": [
  {
   "id": 232491,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement provides the most accurate evidence to support the claim that chemical reactions play a role in energy transfer?",
   "answers": [
    {
     "id": 720111,
     "content_html": "Energy from the breakdown of glucose and other molecules in animals is released as ATP, which transfers energy to other reactions."
    },
    {
     "id": 720110,
     "content_html": "Energy from the breakdown of glucose and other molecules in animals is released in the form of NADP, which transfers energy to other reactions."
    },
    {
     "id": 720109,
     "content_html": "Energy is released in the form of glucose from the breakdown of ATP molecules. These ATP molecules transfer energy from one reaction to other reactions."
    },
    {
     "id": 720108,
     "content_html": "Energy is released in the form of water and oxygen from the breakdown of glucose. These molecules transfer energy from one reaction to other reactions."
    }
   ],
