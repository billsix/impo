 "questions": [
  {
   "id": 520342,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "After branches of woody saplings were trimmed, half of the cuts were covered with a sealant and the other half were left untouched. The plants with sealed cuts fared much better after several weeks. What is the likely reason?",
   "answers": [
    {
     "id": 1016801,
     "content_html": "The sealant stopped evaporation."
    },
    {
     "id": 1016802,
     "content_html": "The plants with sealed cuts grew new branches."
    },
    {
     "id": 1016803,
     "content_html": "The plants with unsealed cuts were infected by pathogens that entered through the cuts."
    },
    {
     "id": 1016804,
     "content_html": "The plants with unsealed cuts lost photosynthates through bleeding of sap."
    }
   ],
