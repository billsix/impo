 "questions": [
  {
   "id": 519814,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A carrot is an example of a tap root. Which of these can also be classified as a tap root?",
   "answers": [
    {
     "id": 1014779,
     "content_html": "the large network of superficial roots of a cactus"
    },
    {
     "id": 1014780,
     "content_html": "a dandelion anchored by a long main root that penetrates deep into the soil"
    },
    {
     "id": 1014781,
     "content_html": "a banyan tree’s system of roots that dangle from the branches"
    },
    {
     "id": 1014782,
     "content_html": "a round organ that stores carbohydrates"
    }
   ],
