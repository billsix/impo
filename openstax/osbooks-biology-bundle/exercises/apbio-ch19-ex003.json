  {
   "id": 323445,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You are trying to test the Hardy-Weinberg model using general information describing a population. Comparing the listed events in that population, determine which would violate the conditions of Hardy-Weinberg equilibrium?",
   "answers": [
    {
     "id": 834989,
     "content_html": "apparent random mating"
    },
    {
     "id": 834990,
     "content_html": "evidence that mutations have occurred"
    },
    {
     "id": 834991,
     "content_html": "the population's large size"
    },
    {
     "id": 834992,
     "content_html": "no evidence of natural selection in the population"
    }
   ],
