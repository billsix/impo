 "context": "<figure id=\"fig-ch09_03_01\"><span data-type=\"media\" id=\"fs-id2258365\" data-alt=\"This illustration shows the pathway by which ERK, a MAP kinase, activates protein synthesis. Phosphorylated ERK phosphorylates MNK1, which in turn phosphorylates eIF-4E, which is associated with mRNA. When eIF-4E is phosphorylated, the mRNA unfolds and protein synthesis begins.\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/02256f308c5272ef2480e7d5754fa4cdc058630d\" data-media-type=\"image/jpg\" alt=\"This illustration shows the pathway by which ERK, a MAP kinase, activates protein synthesis. Phosphorylated ERK phosphorylates MNK1, which in turn phosphorylates eIF-4E, which is associated with mRNA. When eIF-4E is phosphorylated, the mRNA unfolds and protein synthesis begins.\" width=\"320\" height=\"376\">\n</span>\n    </figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 503520,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Signal transduction pathways regulate a broad range of cellular activities, including the MAP kinase cascade pictured here. Propose an example for each one of the following effects of a cell signal: on protein expression, cellular metabolism, and cell division.",
   "answers": [
    {
     "id": 990063,
     "content_html": "protein expression: binding of epinephrine (adrenaline) to a G-protein-linked receptor; cellular metabolism: the MAP-kinase cascade; cell division: promoted by the binding of the EGF to its receptor tyrosine kinase"
    },
    {
     "id": 990064,
     "content_html": "protein expression: the MAP-kinase cascade; cellular metabolism- binding of epinephrine (adrenaline) to a G-protein-linked receptor; cell division promoted by the binding of the EGF to its receptor tyrosine kinase"
    },
    {
     "id": 990065,
     "content_html": "protein expression: binding of the EGF to its receptor tyrosine kinase; cellular metabolism: the MAP-kinase cascade; cell division: FAS-RAS signaling."
    },
    {
     "id": 990066,
     "content_html": "protein expression: RAS signaling; cellular metabolism: binding of the EGF to its receptor tyrosine kinase promotes an increase; cell division: binding of epinephrine (adrenaline) to a G-protein-linked receptor."
    }
   ],
