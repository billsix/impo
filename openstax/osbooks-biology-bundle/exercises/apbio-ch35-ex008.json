   "stimulus_html": "",
   "stem_html": "Photosynthetic organisms are important to most ecosystems because they_____.",
   "answers": [
    {
     "id": 1048792,
     "content_html": "synthesize organic compounds they obtain from decaying heterotrophs."
    },
    {
     "id": 1048793,
     "content_html": "can use carbon dioxide and sunlight and synthesize their own food."
    },
    {
     "id": 1048794,
     "content_html": "use wind energy to synthesize organic compounds."
    },
    {
     "id": 1048795,
     "content_html": "synthesize inorganic compounds from organic compounds."
    }
