 "questions": [
  {
   "id": 529563,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Amphibians, such as frogs, breathe by collecting air in a pouch below their throat. Muscles then contract the pouch and force air into their lungs. Make a claim that explains how this process differs from inhalation in humans and other mammals.",
   "answers": [
    {
     "id": 1036356,
     "content_html": "Inhalation in humans and other mammals involves the openings called spiracles, which connect to the tubular network to allow oxygen to pass into the body."
    },
    {
     "id": 1036357,
     "content_html": "Inhalation in humans and other mammals involves direct diffusion across the outer membrane to meet oxygen requirements. Gases can diffuse quickly through direct diffusion."
    },
    {
     "id": 1036358,
     "content_html": "Inhalation in humans and other mammals involve contracting the thoracic cavity by creating negative pressure in the lungs, which causes air to diffuse into the lungs."
    },
    {
     "id": 1036359,
     "content_html": "Inhalation in humans and other mammals involves expanding the thoracic cavity by creating negative pressure in the lungs, which causes air to diffuse into the lungs."
    }
   ],
