   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/b9b67f264e22e667.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Samantha J Richardson/ResearchGate)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image shows the migration of marsupials.</p>\n<p>Make a hypothesis based on this image.</p>",
   "answers": [
    {
     "id": 1246823,
     "content_html": "Antarctica has fossils of marsupials that are more similar to modern ones."
    },
    {
     "id": 1246822,
     "content_html": "Marsupials first evolved in Africa."
    },
    {
     "id": 1246821,
     "content_html": "The earliest marsupial fossils would be found in Australia."
    },
    {
     "id": 1246820,
     "content_html": "Modern marsupials exist in all continents."
    }
