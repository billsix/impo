   "stem_html": "Transcribe and translate the following DNA sequence (nontemplate strand): 5’-ATGGCCGGTTATTAAGCA-3’",
   "answers": [
    {
     "id": 1000854,
     "content_html": "The mRNA would be 5’-AUGGCCGGUUAUUAAGCA-3’ and the protein will be MAGY."
    },
    {
     "id": 1000855,
     "content_html": "The mRNA would be 3’-AUGGCCGGUUAUUAAGCA-5’ and the protein will be MAGY."
    },
    {
     "id": 1000856,
     "content_html": "The mRNA would be 5’-ATGGCCGGTTATTAAGCA-3’ and the protein will be MAGY."
    },
    {
     "id": 1000857,
     "content_html": "The mRNA would be 5’-AUGGCCGGUUAUUAAGCA-3’ and the protein will be MACY."
