 "questions": [
  {
   "id": 517099,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The endocrine system incorporates feedback mechanisms that maintain homeostasis. Compare the following mechanisms to determine which demonstrates negative feedback by the reproductive system in mammals.",
   "answers": [
    {
     "id": 1011278,
     "content_html": "Increasing levels of testosterone inhibit the production of GnRH, LH, and FSH by the hypothalamus and pituitary."
    },
    {
     "id": 1011279,
     "content_html": "LH and FSH stimulate the interstitial cells of Leydig to release testosterone in males."
    },
    {
     "id": 1011280,
     "content_html": "In females, the growing follicle starts releasing estrogen in increasing amounts."
    },
    {
     "id": 1011281,
     "content_html": "The corpus luteum releases progesterone after ovulation."
    }
   ],
