 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-idp25867456\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n<span data-type=\"media\" id=\"fs-idp58212960\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/c5c49ed28fe06f5fdd79200d4c1238150729f92f\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" height=\"120\">\n</span>\n<p id=\"fs-idp73003104\">Use the menu at the left to navigate to three short <a href=\"https://openstaxcollege.org/l/nastic_mvmt\" target=\"_blank\" rel=\"noopener nofollow\">movies:</a> a Venus fly trap capturing prey, the progressive closing of sensitive plant leaflets, and the twining of tendrils.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 520063,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A Venus fly trap response is triggered by touching the leaves <strong>__</strong>.",
   "answers": [
    {
     "id": 1015741,
     "content_html": "anywhere, because the whole surface of the leaf responds to touch"
    },
    {
     "id": 1015742,
     "content_html": "only on the margins of the leaves where insects usually land"
    },
    {
     "id": 1015743,
     "content_html": "in the center of the leaf, where the touch-sensitive hairs are located"
    },
    {
     "id": 1015744,
     "content_html": "on the petiole followed by the center of leaf which signal the presence of a wandering insect"
    }
   ],
