   "id": 242806,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/42e8ca27d28ad225.jpg\" alt=\"\">\n<figcaption>(credit: modification of work from Wikiwand, under CC BY-SA 4.0 license)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image shows the biomass pyramid in a marine ecosystem.</p>\n<p>Based on this pyramid, make a claim about phytoplankton.</p>",
   "answers": [
    {
     "id": 760686,
     "content_html": "Phytoplankton have very high net production efficiency compared to rest of the animals."
    },
    {
     "id": 760685,
     "content_html": "Phytoplankton have very low net production efficiency compared to rest of the animals."
    },
    {
     "id": 760684,
     "content_html": "Phytoplankton are physically very small compared to the rest of the animals shown here."
    },
    {
     "id": 760683,
     "content_html": "Phytoplankton are physically large compared to the rest of the animals shown here."
    }
