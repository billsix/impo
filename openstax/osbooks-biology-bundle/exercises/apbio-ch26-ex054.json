 "questions": [
  {
   "id": 535233,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Different components of the brain control different parts of the body. One important part of the brain is the occipital lobe. What might happen if an individual’s occipital lobe was damaged?",
   "answers": [
    {
     "id": 1047436,
     "content_html": "The individual would not feel hot or cold."
    },
    {
     "id": 1047437,
     "content_html": "The individual would be unable to form new memories."
    },
    {
     "id": 1047438,
     "content_html": "The individual would be unable to recognize certain objects."
    },
    {
     "id": 1047439,
     "content_html": "The individual would have no sense of smell."
    }
   ],
