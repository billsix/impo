   "id": 519898,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Sugars produced in the leaf are distributed throughout the plant body. An experimenter supplies plants with a pulse of radiolabeled CO<sub>2</sub> in a control chamber. The movement of radioactively labeled sugar is monitored in the plant by analyzing different cells content over time. Where will the radiolabeled sugar appear immediately after detection in the leaf cells?",
   "answers": [
    {
     "id": 1015107,
     "content_html": "tracheids and vessel elements"
    },
    {
     "id": 1015108,
     "content_html": "tracheids and companion cells"
    },
    {
     "id": 1015109,
     "content_html": "vessel elements and companion cells"
    },
    {
     "id": 1015110,
     "content_html": "sieve-tube elements and companion cells"
    }
   ],
