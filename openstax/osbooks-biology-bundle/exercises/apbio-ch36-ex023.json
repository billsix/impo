 "questions": [
  {
   "id": 530768,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Albatrosses are birds that can live to age 60 and older. They usually do not start breeding until they reach age 8 or 9, which is relatively late compared to other bird species. Based on this information, explain conditions that might be a risk to the survival of albatrosses.",
   "answers": [
    {
     "id": 1038410,
     "content_html": "increased chance of individuals dying before reproducing"
    },
    {
     "id": 1038411,
     "content_html": "decreased life spans of individuals"
    },
    {
     "id": 1038412,
     "content_html": "increased chance of offspring dying"
    },
    {
     "id": 1038413,
     "content_html": "decreased chances of mating between individuals"
    }
   ],
