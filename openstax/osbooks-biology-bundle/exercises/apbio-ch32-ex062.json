   "id": 640311,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/4d001a5e298a1406.jpg\" alt=\"\">\n(credit: modification of work by Caravaggi, A. M. et al/<i>Circulation Research</i>)\n</figure>",
   "stem_html": "<p>This graph shows the renin and angiotensin II concentrations in blood.</p>\n<p>What is a claim that can be done from this data? (Hint: Evaluate only the information shown in the graphs.)</p>",
   "answers": [
    {
     "id": 1248743,
     "content_html": "Renin and angiotensin II concentrations are not related to each other."
    },
    {
     "id": 1248744,
     "content_html": "Renin and angiotensin II concentrations are related to each other."
    },
    {
     "id": 1248742,
     "content_html": "Renin production is triggered by angiotensin II."
    },
    {
     "id": 1248741,
     "content_html": "Angiotensin II production is triggered by renin."
    }
