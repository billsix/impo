 "questions": [
  {
   "id": 242498,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If algae grows out of proportion as seen during algal blooms, how does it affect the ecosystem?",
   "answers": [
    {
     "id": 759454,
     "content_html": "Photosynthetic organisms will not be able to grow. The animals and birds that live on those organisms will be affected. As the algae die, oxygen will be depleted, affecting fish and other aquatic animals. The pH of water will change, affecting metabolic processes as well."
    },
    {
     "id": 759451,
     "content_html": "Non-photosynthetic organisms will not be able to grow due to lack of light. The photosynthetic organisms that require them to live will be affected. As the algae die, oxygen will be depleted, affecting fish and other aquatic animals. The pH of water will change, affecting metabolic processes as well."
    },
    {
     "id": 759452,
     "content_html": "Photosynthetic organisms will not be able to grow. The animals and birds that live on those organisms will be affected. As the algae die, carbon dioxide will be depleted, affecting fish and other aquatic animals. The pH of water will change, affecting metabolic processes as well."
    },
    {
     "id": 759453,
     "content_html": "Non-photosynthetic organisms will not be able to grow. The animals and birds that live on those organisms will be affected. As the algae die, carbon dioxide will be depleted, affecting fish and other aquatic animals. The pH of water will change, affecting metabolic processes as well."
    }
   ],
