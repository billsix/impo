   "stem_html": "Why does the immune system attack a transplanted organ?",
   "answers": [
    {
     "id": 990367,
     "content_html": "Glycoproteins and glycolipids on the surface of the organ are similar to those found on pathogens."
    },
    {
     "id": 990368,
     "content_html": "Glycoproteins and glycolipids on the surface of the organ are not recognized by the immune system."
    },
    {
     "id": 990369,
     "content_html": "Glycoproteins and glycolipids on the surface of the organ are toxic to the body."
    },
