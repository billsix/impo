 "questions": [
  {
   "id": 334735,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is so much effort being poured into genome mapping applications?",
   "answers": [
    {
     "id": 844559,
     "content_html": "Genome mapping is necessary to know the base pair difference between the markers."
    },
    {
     "id": 844560,
     "content_html": "The mapping would help scientists understand the role of proteins in specific organelles."
    },
    {
     "id": 844561,
     "content_html": "The mapping technique identifies the role of transposons."
    },
    {
     "id": 844562,
     "content_html": "Genome mapping helps identify faulty alleles, which could cause diseases."
    }
   ],
