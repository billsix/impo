 "questions": [
  {
   "id": 504159,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is it challenging to study the biochemistry of bacterial fossils and determine if the fossils are members of the domain archaea, rather than bacteria?",
   "answers": [
    {
     "id": 991283,
     "content_html": "Bacteria lack rigid structures, thus make the study of fossils difficult."
    },
    {
     "id": 991284,
     "content_html": "Bacteria have rigid structures, but their fossil impression is scarce."
    },
    {
     "id": 991285,
     "content_html": "Fossils of bacteria are rarely found because bacteria were not abundant in the past."
    },
    {
     "id": 991286,
     "content_html": "A fossil of bacteria changes overtime due to the presence of new bacteria living on them."
    }
   ],
