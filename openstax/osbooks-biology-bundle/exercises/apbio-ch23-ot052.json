 "questions": [
  {
   "id": 520854,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Accurately compare and contrast two plant structures, a leaf and a leaflet.",
   "answers": [
    {
     "id": 1017987,
     "content_html": "A leaf petiole attaches directly to the stem at a bud node, whereas a leaflet petiole is attached to the main petiole or the midrib, not the stem."
    },
    {
     "id": 1017988,
     "content_html": "A leaf has reticulate venation, whereas a leaflet shows parallel venation."
    },
    {
     "id": 1017989,
     "content_html": "A leaf petiole attaches to the main petiole or the midrib, not the stem, whereas a leaflet petiole attaches directly to the stem at a bud node."
    },
    {
     "id": 1017990,
     "content_html": "A leaf has parallel venation whereas a leaflet shows reticulate venation."
    }
   ],
