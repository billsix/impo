 "questions": [
  {
   "id": 535039,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do juxtamedullary nephrons differ from cortical nephrons?",
   "answers": [
    {
     "id": 1046666,
     "content_html": "Juxtamedullary nephrons have a longer loop of Henle, allowing them to regulate urine concentration better than cortical nephrons."
    },
    {
     "id": 1046667,
     "content_html": "Juxtamedullary nephrons have a shorter loop of Henle, allowing them to regulate urine concentration better than cortical nephrons."
    },
    {
     "id": 1046668,
     "content_html": "Juxtamedullary nephrons have a larger glomerulus, allowing them to filter blood at a greater rate than cortical nephrons."
    },
    {
     "id": 1046669,
     "content_html": "Juxtamedullary nephrons have a smaller glomerulus, allowing them to filter blood at a greater rate than cortical nephrons."
    }
   ],
