   "id": 550822,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How did fertilizer runoff produce a dead zone in the Chesapeake Bay?",
   "answers": [
    {
     "id": 1082880,
     "content_html": "Excess nitrogen from fertilizer decreases microbial growth, depleting dissolved oxygen in water, thereby killing the fauna of the ecosystem."
    },
    {
     "id": 1082881,
     "content_html": "Fertilizer runoff decreases the carbon dioxide concentration in water, thereby killing fauna of the ecosystem."
    },
    {
     "id": 1082882,
     "content_html": "Fertilizer runoff produces a dead zone in the Chesapeake Bay by increasing oxygen concentration in the ecosystem."
    },
    {
     "id": 1082883,
     "content_html": "Excess nitrogen from fertilizer increases microbial growth, depleting dissolved oxygen in water, thereby killing the fauna of the ecosystem."
    }
