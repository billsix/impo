  {
   "id": 639894,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement comparing the prokaryotes Bacteria and Archaea is false?",
   "answers": [
    {
     "id": 1247094,
     "content_html": "The cytoplasm of both bacterial and archaean prokaryotic cells has a high concentration of dissolved solutes."
    },
    {
     "id": 1247093,
     "content_html": "Osmotic pressure in both types of prokaryotic cells is relatively high."
    },
    {
     "id": 1247092,
     "content_html": "The domains Bacteria and Archaea differ in the use of fatty acids versus phytanal groups in their cell membranes."
    },
    {
     "id": 1247095,
     "content_html": "The domains Bacteria and Archaea have very similar cell wall structure."
    }
   ],
