   "id": 521043,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/57aca1124e84c0c6.jpg\" alt=\"\">\n(credit: modification of work by Jordan Hawes/Wikipedia, CC BY-SA 4.0)\n</figure>\n",
   "stem_html": "<p>This graph shows the body temperature against ambient temperature for two animals that live in the same environment.</p>\n<p>What can be said about these animals?</p>",
   "answers": [
    {
     "id": 1018481,
     "content_html": "Both animals are ectotherms."
    },
    {
     "id": 1018482,
     "content_html": "Both animals are endotherms."
    },
    {
     "id": 1018483,
     "content_html": "Animal 1 is an ectotherm. Animal 2 is an endotherm."
    },
    {
     "id": 1018484,
     "content_html": "Animal 1 is an endotherm. Animal 2 is an ectotherm."
    }
