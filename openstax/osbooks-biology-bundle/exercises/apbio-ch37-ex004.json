 "context": "<div data-type=\"note\" id=\"fs-idp286192144\" class=\"interactive\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<p id=\"fs-idp145311952\">Visit <a href=\"https://openstax.org/l/Darwin_project\" target=\"_blank\" rel=\"noopener nofollow\">The Darwin Project</a> to view a variety of ecosystem models, including simulations that <a href=\"https://openstax.org/l/Darwin_projct2\" target=\"_blank\" rel=\"noopener nofollow\">model predator-prey relationships</a> to learn more.</p>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 550683,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why doesn’t an increased number of prey species in marine ecosystems lead to maximal feeding of predators?",
   "answers": [
    {
     "id": 1082360,
     "content_html": "Because there may not be enough predators that can eat each of the prey species."
    },
    {
     "id": 1082361,
     "content_html": "Non-maximal feeding of predators occurs due to inadequate dispersal of prey species in the marine ecosystems."
    },
    {
     "id": 1082362,
     "content_html": "Non maximal feeding of predators may occur due to the presence of new prey species with effective defenses that are inherited."
    },
    {
     "id": 1082363,
     "content_html": "Because of natural selection, non-maximal feeding of predators occurs."
    }
   ],
