   "id": 238485,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/ee4a3f7c488e266d.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Planet Ocean)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image shows a sea turtle.</p>\n<p>What can be said about the these turtles based on this image?</p>",
   "answers": [
    {
     "id": 743678,
     "content_html": "They are oviparous."
    },
    {
     "id": 743677,
     "content_html": "They are ovoviviparous."
    },
    {
     "id": 743676,
     "content_html": "They are viviparous."
    },
    {
     "id": 743675,
     "content_html": "They do external fertilization."
    }
