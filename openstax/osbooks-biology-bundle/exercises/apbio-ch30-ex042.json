 "questions": [
  {
   "id": 529693,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Based on your understanding of how gases are transported from body tissues to lungs, explain what would happen if no carbonic anhydrase was present in red blood cells.",
   "answers": [
    {
     "id": 1036708,
     "content_html": "Carbon dioxide would be hydrolyzed into carbonic acid or bicarbonate. The maximum amount of carbon dioxide would be transported in the blood away from the tissues."
    },
    {
     "id": 1036709,
     "content_html": "Carbon dioxide would not be hydrolyzed into carbonic acid or bicarbonate. The maximum amount of carbon dioxide would be transported in the blood away from the tissues."
    },
    {
     "id": 1036710,
     "content_html": "Oxygen would not be hydrolyzed into carbonic acid or bicarbonate. Only 50 percent of carbon dioxide would be transported in the blood away from the tissues."
    },
    {
     "id": 1036711,
     "content_html": "Carbon dioxide would not be hydrolyzed into carbonic acid or bicarbonate. Only 15 percent of carbon dioxide would be transported in the blood away from the tissues."
    }
   ],
