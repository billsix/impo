 "context": "<figure id=\"fig-ch08_02_03\" class=\" \"><span data-type=\"media\" id=\"fs-idp102263632\" data-alt=\"The illustration lists the types of electromagnetic radiation in order of increasing wavelength. These include gamma rays, X-rays, ultraviolet, visible, infrared, and radio. Gamma rays have a very short wavelength, on the order of one thousandth of a nanometer. Radio waves have a very long wavelength, on the order of one kilometer. Visible light ranges from 380 nanometers at the violet end of the spectrum, to 750 nanometers at the red end of the spectrum.\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/12f8ce6ac7d7bff28d7ca92f409ae588fd8928f4\" data-media-type=\"image/jpg\" alt=\"The illustration lists the types of electromagnetic radiation in order of increasing wavelength. These include gamma rays, X-rays, ultraviolet, visible, infrared, and radio. Gamma rays have a very short wavelength, on the order of one thousandth of a nanometer. Radio waves have a very long wavelength, on the order of one kilometer. Visible light ranges from 380 nanometers at the violet end of the spectrum, to 750 nanometers at the red end of the spectrum.\" width=\"750\" height=\"363\">\n</span>\n\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 639637,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Review the many types of electromagnetic radiation as pictured on the electromagnetic spectrum. Why are X-rays and ultraviolet (UV) light wavelengths dangerous to living tissues?",
   "answers": [
    {
     "id": 1246087,
     "content_html": "Because UV rays and X-rays are high-energy waves, they penetrate the tissues and thus damage cells."
    },
    {
     "id": 1246086,
     "content_html": "Because UV rays and X-rays are long-wavelength waves, they penetrate the tissues and thus damage cells."
    },
    {
     "id": 1246085,
     "content_html": "Because UV rays and X-rays are low-energy waves, they cannot penetrate tissues and thus damage cells."
    },
    {
     "id": 1246084,
     "content_html": "Because UV rays and X-rays are low-frequency waves, they can penetrate tissues and thus damage cells."
    }
   ],
