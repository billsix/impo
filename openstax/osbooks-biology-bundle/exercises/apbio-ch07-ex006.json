 "questions": [
  {
   "id": 639600,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What role does <span data-math=\"\\text{NAD}^{+} {\\!}\">\\text{NAD}^{+} {\\!}</span> play in redox reactions?",
   "answers": [
    {
     "id": 1245947,
     "content_html": "<span data-math=\"\\text{NAD}^{+} {\\!}\">\\text{NAD}^{+} {\\!}</span>, an oxidizing agent, can accept electrons and protons from organic molecules and get reduced to <span data-math=\"\\text{NADH}\">\\text{NADH}</span>."
    },
    {
     "id": 1245946,
     "content_html": "<span data-math=\"\\text{NAD}^{+} {\\!}\">\\text{NAD}^{+} {\\!}</span>, a reducing agent, can donate its electrons and protons to organic molecules."
    },
    {
     "id": 1245945,
     "content_html": "<span data-math=\"\\text{NAD}^{+} {\\!}\">\\text{NAD}^{+} {\\!}</span>, an oxidizing agent, can accept electrons from organic molecules and get reduced to NADH<sub>2</sub>."
    },
    {
     "id": 1245944,
     "content_html": "<span data-math=\"\\text{NAD}^{+} {\\!}\">\\text{NAD}^{+} {\\!}</span>, a reducing agent, can donate its electrons and protons to inorganic molecules."
    }
   ],
