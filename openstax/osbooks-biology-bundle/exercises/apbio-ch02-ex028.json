 "questions": [
  {
   "id": 513043,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is true?",
   "answers": [
    {
     "id": 1003894,
     "content_html": "Molecules with the formulas <span data-math=\"\\text{CH}_3\\text{CH}_2\\text{OH}\">\\text{CH}_3\\text{CH}_2\\text{OH}</span> and <span data-math=\"\\text{C}_3\\text{H}_6\\text{O}_2\">\\text{C}_3\\text{H}_6\\text{O}_2</span> could be structural isomers."
    },
    {
     "id": 1003895,
     "content_html": "Cis-trans isomers are arranged about a single bond."
    },
    {
     "id": 1003896,
     "content_html": "To be enantiomers, a pair of molecules must have at least three different atoms or groups  connected to a central carbon, but arranged differently."
    },
    {
     "id": 1003897,
     "content_html": "To be enantiomers, a pair of molecules must have four different atoms or groups connected to a central carbon, but arranged differently."
    }
   ],
