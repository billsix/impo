   "stem_html": "How do dialysis machines remove harmful urea from the blood?",
   "answers": [
    {
     "id": 1045894,
     "content_html": "by facilitated diffusion that allows urea to diffuse out of the blood"
    },
    {
     "id": 1045895,
     "content_html": "by active transport, which allows urea to diffuse out of the blood"
    },
    {
     "id": 1045896,
     "content_html": "by creating an osmotic gradient that allows urea to diffuse out of the blood across a permeable membrane"
    },
