 "questions": [
  {
   "id": 524194,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about the enteric endocrine system is true?",
   "answers": [
    {
     "id": 1029104,
     "content_html": "Gastrin stimulates pancreatic enzyme and bile secretion."
    },
    {
     "id": 1029105,
     "content_html": "The enteric endocrine system includes all endocrine cells of the gastrointestinal tract."
    },
    {
     "id": 1029106,
     "content_html": "All hormone-secreting cells in the enteric endocrine system are clustered together."
    },
    {
     "id": 1029107,
     "content_html": "Enteric endocrine system cells secrete enzymes in response to insulin."
    }
   ],
