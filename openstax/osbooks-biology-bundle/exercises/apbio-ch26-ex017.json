 "questions": [
  {
   "id": 640164,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>This figure shows a malformed neuron. Why would this neuron be nonfunctional?</p>\n\n<p><img src=\"exercises/media/6390086a80d1cb3e.jpg\" alt=\"Illustration shows a neuron malformed in that it is lacking axon terminals.\"></p>\n",
   "answers": [
    {
     "id": 1248157,
     "content_html": "This neuron would not be able to receive signals."
    },
    {
     "id": 1248156,
     "content_html": "This neuron would not be able to recharge the signal."
    },
    {
     "id": 1248155,
     "content_html": "This neuron would not be able to integrate information from numerous synapses."
    },
    {
     "id": 1248158,
     "content_html": "This neuron would not be able to send signals."
    }
   ],
