 "context": "<figure id=\"fig-ch16_06_01\"><span data-type=\"media\" id=\"fs-id1453957\" data-alt=\"The eIF2 protein is a translation factor that binds to the small 40S ribosome subunit. When eIF2 is phosphorylated, translation is blocked.\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/3fcec87b1fc84a55fb9e8392353f880cb76b7a6f\" data-media-type=\"image/png\" alt=\"The eIF2 protein is a translation factor that binds to the small 40S ribosome subunit. When eIF2 is phosphorylated, translation is blocked.\" width=\"320\" height=\"191\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 511863,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An increase in phosphorylation levels of eIF-2 has been observed in patients with neurodegenerative diseases such as Alzheimer’s, Parkinson’s and Huntington’s. What impact do you think this might have on protein synthesis?",
   "answers": [
    {
     "id": 1001090,
     "content_html": "It will increase the rate of translation."
    },
    {
     "id": 1001091,
     "content_html": "It will not affect the translation process."
    },
    {
     "id": 1001092,
     "content_html": "It will block the translation of certain proteins."
    },
    {
     "id": 1001093,
     "content_html": "It will produce multiple fragments of polypeptides."
    }
   ],
