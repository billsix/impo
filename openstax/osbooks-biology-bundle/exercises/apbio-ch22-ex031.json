   "id": 520230,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement about the importance of particular nutrients is false?",
   "answers": [
    {
     "id": 1016375,
     "content_html": "Carbon is a macronutrient and major element in all macromolecules."
    },
    {
     "id": 1016376,
     "content_html": "Nitrogen is a macronutrient and necessary component of proteins and nucleic acids."
    },
    {
     "id": 1016377,
     "content_html": "Hydrogen is a macronutrient and key component of many organic compounds and of water."
    },
    {
     "id": 1016378,
     "content_html": "Iron is a macronutrient necessary for the function of cytochromes."
    }
   ],
