 "context": "<figure id=\"fig-ch39_04_02\" class=\" \"><span data-type=\"media\" id=\"fs-idp62015168\" data-alt=\"The graph plots percent oxygen saturation of hemoglobin as a function of oxygen partial pressure. Oxygen saturation increases in an S-shaped curve, from 0 to 100 percent. The curve shifts to the left under conditions of low carbon dioxide, high pH, and low temperature, and to the right in conditions of high carbon dioxide, low pH, or high temperature.\">\n<img src=\"https://openstax.org/apps/archive/20241024.164013/resources/60348be827971010fdebc49ccd47dab53d9bc715\" data-media-type=\"image/jpg\" alt=\"The graph plots percent oxygen saturation of hemoglobin as a function of oxygen partial pressure. Oxygen saturation increases in an S-shaped curve, from 0 to 100 percent. The curve shifts to the left under conditions of low carbon dioxide, high pH, and low temperature, and to the right in conditions of high carbon dioxide, low pH, or high temperature.\" width=\"550\" height=\"284\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 529611,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The kidneys are responsible for removing excess hydrogen ions from the blood. If the kidneys fail, what would happen to blood pH and hemoglobin affinity for oxygen?",
   "answers": [
    {
     "id": 1036484,
     "content_html": "The blood pH will drop and hemoglobin affinity for oxygen will increase."
    },
    {
     "id": 1036485,
     "content_html": "The blood pH will increase and hemoglobin affinity for oxygen will drop."
    },
    {
     "id": 1036486,
     "content_html": "The blood pH will drop and hemoglobin affinity for oxygen will decrease."
    },
    {
     "id": 1036487,
     "content_html": "The blood pH will increase and hemoglobin affinity for oxygen will also increase."
    }
   ],
