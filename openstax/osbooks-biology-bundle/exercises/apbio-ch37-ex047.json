   "stimulus_html": "",
   "stem_html": "What is a potential consequence of excess phosphorus and nitrogen in an ecosystem?",
   "answers": [
    {
     "id": 1082920,
     "content_html": "This could result in increased global temperatures."
    },
    {
     "id": 1082921,
     "content_html": "Subduction can be promoted."
    },
    {
     "id": 1082922,
     "content_html": "These elements might be fixed in excess."
    },
    {
     "id": 1082923,
     "content_html": "A dead zone could be produced from depleted oxygen."
    }
