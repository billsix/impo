   "id": 544245,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how hormones promote homeostasis in the body.",
   "answers": [
    {
     "id": 1069649,
     "content_html": "Hormones increases cell activity by binding to the receptors present in the cell."
    },
    {
     "id": 1069650,
     "content_html": "Hormones facilitate communication between cells present at very distant locations in the body."
    },
    {
     "id": 1069651,
     "content_html": "Hormones facilitate communication between cells at any distance in the body."
    },
    {
     "id": 1069652,
     "content_html": "Hormones mediate changes by directly binding to the intracellular hormone receptors."
    }
   ],
