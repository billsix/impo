 "questions": [
  {
   "id": 535115,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Planaria are flatworms that live in fresh water. Their excretory system, or protonephridia, consists of two tubules connected to a highly branched tube system. The intake end of the tubes contain cilia that propel waste matter down the tubules and out of the body through excretory pores that open on the body surface. Cilia also draw water from the interstitial fluid, allowing for filtration. Any valuable metabolites are recovered by reabsorption. What structure in the human kidneys most closely resembles the excretory pores of the protonephridia, and why?",
   "answers": [
    {
     "id": 1046970,
     "content_html": "The urethral opening, because this is where wastes leave the body"
    },
    {
     "id": 1046971,
     "content_html": "The convoluted tubule, because this is where reabsorption and secretion occur"
    },
    {
     "id": 1046972,
     "content_html": "The glomerulus, because this is where reabsorption and secretion occur"
    },
    {
     "id": 1046973,
     "content_html": "The ureter, because this is where wastes leave the body."
    }
   ],
