 "questions": [
  {
   "id": 233498,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe a situation where hybrid reproduction would cause two species to fuse into one.",
   "answers": [
    {
     "id": 724137,
     "content_html": "Separate species cannot interbreed, so hybrid reproduction does not occur in nature"
    },
    {
     "id": 724138,
     "content_html": "If the hybrid offspring are more fit than the parents, reproduction would likely continue between both species and the hybrids, eventually bringing all organisms under the umbrella of one species"
    },
    {
     "id": 724136,
     "content_html": "Two species that have recently diverged from each other can reproduce with each other, creating hybrid individuals that belong to the species of the parents’ common ancestor."
    },
    {
     "id": 724135,
     "content_html": "If two species occupy the same niche in the same area, they can either compete or they can collaborate and reproduce with each other, eventually fusing into a single species"
    }
   ],
