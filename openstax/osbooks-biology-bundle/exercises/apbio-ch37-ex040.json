   "id": 550816,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare and contrast carbon sources and sinks, and provide one example of each.",
   "answers": [
    {
     "id": 1082860,
     "content_html": "Carbon sources, such as burning fossil fuels, produce carbon while carbon sinks, such as oceans, absorb carbon."
    },
    {
     "id": 1082861,
     "content_html": "Carbon sources, such as volcanic activity, absorb carbon while carbon sinks, such as vegetation, produce carbon."
    },
    {
     "id": 1082862,
     "content_html": "Carbon sources, such as vegetation, produce carbon while carbon sinks, such as volcanic activity, absorb carbon."
    },
    {
     "id": 1082863,
     "content_html": "Carbon sources, such as volcanic activity, produce carbon while carbon sinks, such as burning fossil fuels, absorb carbon."
    }
