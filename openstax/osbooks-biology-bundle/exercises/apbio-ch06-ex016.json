   "id": 232497,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Plants make glucose through a pathway called photosynthesis. The amount of energy captured from light can be expressed as the number of energy containing molecules used to make one molecule of glucose. Which of the following best states the number of each molecule needed?",
   "answers": [
    {
     "id": 720134,
     "content_html": "54 molecules of ATP and 18 molecules of nicotinamide adenine dinucleotide phosphate (NADPH)"
    },
    {
     "id": 720135,
     "content_html": "18 molecules of ATP and 12 molecules of NADPH"
    },
    {
     "id": 720133,
     "content_html": "24 molecules of ATP and 18 molecules of NADPH"
    },
    {
     "id": 720132,
     "content_html": "12 molecules of ATP and 18 molecules of NADPH"
    }
