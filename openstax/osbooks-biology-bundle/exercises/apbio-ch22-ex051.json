  {
   "id": 520292,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement about the cause of resistant bacteria is false?",
   "answers": [
    {
     "id": 1016619,
     "content_html": "The excessive use of antibiotics has resulted in the natural selection of resistant forms of bacteria."
    },
    {
     "id": 1016620,
     "content_html": "Antibiotics are used by patients with colds or the flu, the treatment for which antibiotics are useless."
    },
    {
     "id": 1016621,
     "content_html": "There is excessive use of antibiotics in livestock and in animal feed."
    },
    {
     "id": 1016622,
     "content_html": "Antibiotics are used by patients of different ages and the fact that their ages differ increases resistance."
    }
   ],
