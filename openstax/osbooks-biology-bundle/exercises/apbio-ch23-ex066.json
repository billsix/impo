 "questions": [
  {
   "id": 519890,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Plants regulate their internal water potential by opening and closing stomata. Which events take place when stomata open?",
   "answers": [
    {
     "id": 1015075,
     "content_html": "Water vapor is lost to the external environment, increasing the rate of transpiration."
    },
    {
     "id": 1015076,
     "content_html": "Water vapor is lost to the external environment, decreasing the rate of transpiration."
    },
    {
     "id": 1015077,
     "content_html": "Water vapor enters the spaces in the mesophyll, increasing the rate of transpiration."
    },
    {
     "id": 1015078,
     "content_html": "The rate of photosynthesis drops when stomata open."
    }
   ],
