 "questions": [
  {
   "id": 242401,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A patient has just been informed that they have an autoimmune disease that attacks the salivary glands. How would you explain to the patient what is happening inside their body?",
   "answers": [
    {
     "id": 759066,
     "content_html": "The immune system is producing antibodies against their own proteins present in their salivary glands, causing the salivary glands to break down and become non-functional."
    },
    {
     "id": 759063,
     "content_html": "The ability of the immune system to fight the antigen present in the salivary glands might have been compromised, causing the salivary glands to break down and become non-functional."
    },
    {
     "id": 759064,
     "content_html": "The immune system might have reacted in an abnormal way to an antigen that may have entered salivary glands, causing the salivary glands to break down and become non-functional."
    },
    {
     "id": 759065,
     "content_html": "Some pathogen might have entered the salivary glands, causing the salivary glands to break down and become non-functional."
    }
   ],
