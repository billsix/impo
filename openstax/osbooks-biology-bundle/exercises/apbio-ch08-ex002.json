 "questions": [
  {
   "id": 503392,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how the light reactions and light independent reactions (Calvin cycle) of photosynthesis are interdependent on each other.",
   "answers": [
    {
     "id": 989551,
     "content_html": "The light reactions produces ATP and NADPH, which are then used in the Calvin cycle."
    },
    {
     "id": 989552,
     "content_html": "The light reactions produces NADP<sup>+</sup> and ADP, which are then used in the Calvin cycle."
    },
    {
     "id": 989553,
     "content_html": "The light reactions uses NADPH and ATP, which are produced by the Calvin cycle."
    },
    {
     "id": 989554,
     "content_html": "The light reactions produce only NADPH, which is produced by the Calvin cycle."
    }
   ],
