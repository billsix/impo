   "id": 503725,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Water moves via osmosis across plasma cell membranes in which direction?",
   "answers": [
    {
     "id": 990283,
     "content_html": "from an area with a high concentration of other solutes to a lower one"
    },
    {
     "id": 990284,
     "content_html": "from an area with a high concentration of water to one of lower concentration"
    },
    {
     "id": 990285,
     "content_html": "from an area with a low concentration of water to one of higher concentration."
    },
    {
     "id": 990286,
     "content_html": "throughout the cytoplasm"
    }
   ],
