   "id": 640195,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/345c20a5b85e0e1d.jpg\" alt=\"\">\n(credit: modification of work by Arianna Vignini et al./Hindawi, CC BY-SA 4.0)\n</figure>\n",
   "stem_html": "<p>This graph shows the relation between body-mass index (BMI) and taste sensitivity.</p>\n<p>Which option is a conclusion you can draw from this graph?</p>",
   "answers": [
    {
     "id": 1248283,
     "content_html": "BMI and sense of taste are not related."
    },
    {
     "id": 1248284,
     "content_html": "People with higher BMI tend to have a weaker sense of taste on average."
    },
    {
     "id": 1248282,
     "content_html": "People with higher BMI tend to have a stronger sense of taste on average."
    },
    {
     "id": 1248281,
     "content_html": "People with low BMI tend to have the weakest sense of taste."
    }
   ],
