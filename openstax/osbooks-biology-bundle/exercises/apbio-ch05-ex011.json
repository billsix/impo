 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1512071\" class=\"interactive\" data-label=\"\">\n<h2 class=\"os-title\" data-type=\"title\">\n  <span class=\"os-title-label\">Link to Learning</span>\n</h2>\n<div class=\"os-note-body\">\n<h3 data-type=\"title\" class=\"os-subtitle\">\n  <span class=\"os-subtitle-label\">Link to Learning</span>\n</h3>\n        <span data-type=\"media\" id=\"fs-id1807984\" data-alt=\"QR Code representing a URL\">\n            <img src=\"https://openstax.org/apps/archive/20240910.161227/resources/45fa508157b250e38033bca5b23754712440e23f\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"130\" height=\"130\">\n        </span>\n        <p id=\"fs-id1808984\">For a video illustrating the process of diffusion in solutions, visit this <a href=\"https://openstaxcollege.org/l/dispersion\" target=\"_blank\" rel=\"noopener nofollow\">site</a>.</p>\n    </div>\n</div>",
