 "questions": [
  {
   "id": 503731,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain the difference between the two beakers in this <a href=\"https://openstax.org/l/dispersion\" rel=\"nofollow\" target=\"_blank\">video</a>.",
   "answers": [
    {
     "id": 990307,
     "content_html": "The lower temperature in beaker A causes red dye to diffuse faster than in beaker B."
    },
    {
     "id": 990308,
     "content_html": "The lower temperature in beaker A causes red dye to diffuse slower in it than in beaker B."
    },
    {
     "id": 990309,
     "content_html": "The higher temperature of beaker A causes faster diffusion of red dye in beaker A."
    },
    {
     "id": 990310,
     "content_html": "The higher temperature of beaker B causes slower diffusion of red dye in beaker B."
    }
   ],
