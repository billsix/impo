     "content_html": "Hormone release is stimulated by a change in the blood."
    },
    {
     "id": 1070339,
     "content_html": "Hormone release is stimulated by the external environment."
    },
    {
     "id": 1070340,
     "content_html": "Hormone release is stimulated by another hormone."
