 "questions": [
  {
   "id": 535634,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In a temperate grassland system area of North America, vegetation has been destroyed by fire. What will happen to the net primary productivity and the local ecosystem when rains return in the next season?",
   "answers": [
    {
     "id": 1048832,
     "content_html": "The grasses will grow back, but the herbivores that lived there will not return, as they would have found new land to live on. Therefore, the net primary productivity would decrease."
    },
    {
     "id": 1048833,
     "content_html": "The grasses will not grow back, therefore the herbivores that lived there will not return. Thus, the net primary productivity would decrease."
    },
    {
     "id": 1048834,
     "content_html": "The grasses will grow back and the herbivores that lived there will return. The net primary productivity should also be similar to the previous season."
    },
    {
     "id": 1048835,
     "content_html": "The grasses will grow back and the herbivores that lived there will return. The net primary productivity would be less than the previous season."
    }
   ],
