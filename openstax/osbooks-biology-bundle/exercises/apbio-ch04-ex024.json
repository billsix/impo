 "questions": [
  {
   "id": 639538,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If the nucleolus were not able to carry out its function, what other cellular organelles would be affected?",
   "answers": [
    {
     "id": 1245700,
     "content_html": "The structure of endoplasmic reticulum would not form."
    },
    {
     "id": 1245699,
     "content_html": "The function of lysosomes would be hindered, as hydrolases are formed by nucleolus."
    },
    {
     "id": 1245701,
     "content_html": "The free ribosomes and the rough endoplasmic reticulum, which contains ribosomes, would not form."
    },
    {
     "id": 1245698,
     "content_html": "The Golgi apparatus will not be able to sort proteins properly."
    }
   ],
