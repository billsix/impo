 "questions": [
  {
   "id": 232651,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes complex IV in the electron transport chain?",
   "answers": [
    {
     "id": 720750,
     "content_html": "Complex IV consists of an oxygen molecule held between the cytochrome and copper ions. The electrons flowing finally reach the oxygen, producing water."
    },
    {
     "id": 720749,
     "content_html": "Complex IV contains a molecule of flavin mononucleotide and iron-sulfur clusters. The electrons from NADH are transported here to coenzyme Q."
    },
    {
     "id": 720748,
     "content_html": "Complex IV contains cytochrome b, c, and Fe-S. Here, the proton motive Q cycle takes place."
    },
    {
     "id": 720747,
     "content_html": "Complex IV contains a membrane-bound enzyme that accepts electrons from FADH<sub>2</sub> to make FAD. This electron is then transferred to ubiquinone."
    }
   ],
