 "context": "<figure id=\"fig-ch10_03_04\" class=\"  \"><span data-type=\"media\" id=\"fs-id2682756\" data-alt=\"This illustration shows the regulation of the cell cycle by the Rb protein. Unphosphorylated Rb binds the transcription factor E2F. E2F cannot bind the DNA, and transcription is blocked. Cell growth triggers the phosphorylation of Rb. Phosphorylated Rb releases E2F, which binds the DNA and turns on gene expression, thus advancing the cell cycle.\">\n<img src=\"https://openstax.org/apps/archive/20240910.161227/resources/73c0b8a3698c3c2394afa22291ef62e804e7f358\" data-media-type=\"image/png\" alt=\"This illustration shows the regulation of the cell cycle by the Rb protein. Unphosphorylated Rb binds the transcription factor E2F. E2F cannot bind the DNA, and transcription is blocked. Cell growth triggers the phosphorylation of Rb. Phosphorylated Rb releases E2F, which binds the DNA and turns on gene expression, thus advancing the cell cycle.\" width=\"500\" height=\"326\">\n</span>\n</figure>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 507692,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the function of tumor suppressor proteins in their resting, unphosphorylated state?",
   "answers": [
    {
     "id": 994820,
     "content_html": "They inhibit cell division."
    },
    {
     "id": 994821,
     "content_html": "They enhance the rate of cell division."
    },
    {
     "id": 994822,
     "content_html": "They start the cell cycle, thereby suppressing tumor formation."
    },
    {
     "id": 994823,
     "content_html": "They proof read DNA before cell division."
    }
   ],
