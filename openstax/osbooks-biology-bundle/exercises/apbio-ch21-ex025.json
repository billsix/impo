   "stimulus_html": "",
   "stem_html": "Which of the following statements is false?",
   "answers": [
    {
     "id": 1077955,
     "content_html": "Enveloped viruses and naked viruses both may enter cells using the fusion method."
    },
    {
     "id": 1077956,
     "content_html": "Many enveloped viruses enter the cell by receptor-mediated endocytosis."
    },
    {
     "id": 1077957,
     "content_html": "Naked viruses enter the cell by receptor-mediated endocytosis."
    },
    {
     "id": 1077958,
     "content_html": "Undergoing shape changes and creating channels in the host cell membrane is an alternative method of cell penetration used by naked viruses."
    }
