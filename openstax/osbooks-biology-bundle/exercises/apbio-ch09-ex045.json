 "questions": [
  {
   "id": 639659,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Based on the Evolution Connection, which of the following best describes the evolution of kinases?",
   "answers": [
    {
     "id": 1246172,
     "content_html": "The tyrosine kinases evolved before yeast diverged from other eukaryotes, but the other fifty-five subfamilies of kinases evolved after yeast diverged."
    },
    {
     "id": 1246175,
     "content_html": "Fifty-five subfamilies of kinases evolved before yeast diverged from other eukaryotes, but the tyrosine kinases evolved after yeast diverged."
    },
    {
     "id": 1246173,
     "content_html": "All kinases evolved in yeast, but yeast later lost the tyrosine kinases because they do not need them."
    },
    {
     "id": 1246174,
     "content_html": "The evolution of tyrosine kinases involved in cellular communication occurred about 2.5 billion years ago."
    }
   ],
