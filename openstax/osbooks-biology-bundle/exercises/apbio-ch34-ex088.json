 "questions": [
  {
   "id": 517147,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/99f3629d9698ea37.jpg\" alt=\"\">\n<figcaption>(credit: modification of work by Stephen J. Falchek, MD/MERCK Manual)</figcaption>\n</figure>\n",
   "stem_html": "<p>The image shows a condition called spina bifida. This condition occurs when the neural tube does not close properly at the lower end of the body at the spine.</p>\n<p>What would happen if the neural tube does not properly close at the upper end of the body?</p>",
   "answers": [
    {
     "id": 1011438,
     "content_html": "There would be anomalies in the face of the embryo."
    },
    {
     "id": 1011439,
     "content_html": "The brain of the embryo would not develop properly."
    },
    {
     "id": 1011440,
     "content_html": "The heart and the lungs of the embryo would not develop."
    },
    {
     "id": 1011441,
     "content_html": "There would be anomalies in the arm development."
    }
   ],
