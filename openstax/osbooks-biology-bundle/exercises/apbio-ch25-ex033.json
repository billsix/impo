 "questions": [
  {
   "id": 524002,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Plant materials, such as fruits and vegetables, are difficult to digest because they are difficult to break down. How are humans able to obtain nutrients from fruits and vegetables?",
   "answers": [
    {
     "id": 1028632,
     "content_html": "Humans produce cellulase, which breaks down cellulose."
    },
    {
     "id": 1028633,
     "content_html": "Intestinal flora have enzymes that break down some of the fiber."
    },
    {
     "id": 1028634,
     "content_html": "Bile is released from the gallbladder to break down fiber."
    },
    {
     "id": 1028635,
     "content_html": "In the stomach, pepsin is produced to break down plant material."
    }
   ],
