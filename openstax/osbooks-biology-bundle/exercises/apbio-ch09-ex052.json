 "questions": [
  {
   "id": 503548,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Connect what you have learned about signaling pathways to provide a hypothesis for why signaling differs between types of organisms. Specifically, why is signaling in multicellular organisms more complicated than signaling in single-celled organisms?",
   "answers": [
    {
     "id": 990175,
     "content_html": "Multicellular organisms coordinate between distantly located cells; single-celled organisms communicate only with nearby cells."
    },
    {
     "id": 990176,
     "content_html": "Multicellular organisms involve receptors for signaling; single-celled organisms communicate by fusion of plasma membrane with the nearby cells."
    },
    {
     "id": 990177,
     "content_html": "Multicellular organisms require more time for signal transduction than single-celled organisms, as they show compartmentalization."
    },
    {
     "id": 990178,
     "content_html": "Multicellular organisms require more time for signal transduction than single-celled organisms, as they lack compartmentalization."
    }
   ],
