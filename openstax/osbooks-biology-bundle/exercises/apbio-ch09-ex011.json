  {
   "id": 503492,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Cells grown in the laboratory are mixed with a dye molecule that is unable to pass through the plasma membrane. If a ligand is added to the cells, the dye is then observed entering the cells. Interpreting this result, what type of receptor did the ligand bind to on the cell surface?",
   "answers": [
    {
     "id": 989951,
     "content_html": "G-protein-linked R receptor"
    },
    {
     "id": 989952,
     "content_html": "ligand-gated ion channel"
    },
    {
     "id": 989953,
     "content_html": "voltage-gated ion channel"
    },
    {
     "id": 989954,
     "content_html": "receptor tyrosine kinase"
    }
   ],
