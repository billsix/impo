 "questions": [
  {
   "id": 241214,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Stanley Miller and Harold Urey conducted experiments which demonstrated that several organic compounds could be formed spontaneously by simulating the conditions of Earth's early atmosphere. When Miller and Urey repeated their experiment without providing the electrical discharge, no organic compounds were found. Make a claim to hypothesize what might explain this result. Frame your claim within the context of the conditions of early Earth.",
   "answers": [
    {
     "id": 754320,
     "content_html": "The lack of organic compounds without the sparks indicates that complex organic components are formed from less complex biotic components subjected to solar radiation."
    },
    {
     "id": 754319,
     "content_html": "The first trial of the experiment must have been done incorrectly."
    },
    {
     "id": 754318,
     "content_html": "Abiotic molecules can only develop into organic molecules in the presence of oxygen, so oxygen should be added."
    },
    {
     "id": 754321,
     "content_html": "Lightning, or some form of energy, is needed for the inorganic molecules in the atmosphere to interact with each other. This indicates that a similar energy source was present on early Earth that stimulated the interaction and development."
    }
   ],
