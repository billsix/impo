   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What property enables the residues of the amino acids serine, threonine, and tyrosine to be phosphorylated?",
   "answers": [
    {
     "id": 990007,
     "content_html": "They are polar."
    },
    {
     "id": 990008,
     "content_html": "They are nonpolar."
    },
    {
     "id": 990009,
     "content_html": "They contain a hydroxyl group."
    },
    {
     "id": 990010,
     "content_html": "They occur more frequently in the amino acid sequence of signaling proteins."
    }
