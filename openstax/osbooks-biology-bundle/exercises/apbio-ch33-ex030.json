   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/f0c7956f099d9365.jpg\" alt=\"\">\n(credit: modification of work by Reh0318/Wikipedia, CC BY-SA 4.0)\n</figure>",
   "stem_html": "<p>This image shows how the humoral immune system works.</p>\n<p>What is happening at step 2?</p>",
   "answers": [
    {
     "id": 1048020,
     "content_html": "A B cell is preparing to release antibodies."
    },
    {
     "id": 1048021,
     "content_html": "A B cell is engulfing the antigens."
    },
    {
     "id": 1048022,
     "content_html": "A B cell is displaying the antigens of the pathogen."
    },
    {
     "id": 1048023,
     "content_html": "A B cell is getting ready to divide."
    }
