   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Water bodies can differ in the amount of salt present. Which of the following is a characteristic of an estuary?",
   "answers": [
    {
     "id": 1049209,
     "content_html": "a continuous body of water with high salinity"
    },
    {
     "id": 1049210,
     "content_html": "an area where the salinity varies"
    },
    {
     "id": 1049211,
     "content_html": "a body of water with low salinity"
    },
    {
     "id": 1049212,
     "content_html": "a body of water with low salt entering land"
