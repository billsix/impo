   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is true of geochemical cycles?",
   "answers": [
    {
     "id": 1082844,
     "content_html": "There is a variable amount of each element on Earth."
    },
    {
     "id": 1082845,
     "content_html": "A reservoir is where elements remain through time."
    },
    {
     "id": 1082846,
     "content_html": "Only external energy sources drive movement of elements."
    },
    {
     "id": 1082847,
     "content_html": "Geochemical cycles are characterized by the movement of elements."
    }
   ],
