 "questions": [
  {
   "id": 517462,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the nature of the oogonium and the secondary oocyte? Which process results in the formation of the secondary oocyte?",
   "answers": [
    {
     "id": 1011702,
     "content_html": "A diploid oogonium forms a haploid oocyte by the process of mitosis."
    },
    {
     "id": 1011703,
     "content_html": "A haploid oogonium forms a diploid oocyte by the process of meiosis."
    },
    {
     "id": 1011704,
     "content_html": "A diploid oogonium forms a haploid oocyte by the process of meiosis."
    },
    {
     "id": 1011705,
     "content_html": "A haploid oogonium forms a haploid haploid oocyte by the process of meiosis."
    }
   ],
