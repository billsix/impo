 "questions": [
  {
   "id": 517466,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are the diploid zygotes produced after fertilization of sperm cells produced by spermatogenesis not similar?",
   "answers": [
    {
     "id": 1011718,
     "content_html": "Their chromosome numbers are not the same."
    },
    {
     "id": 1011719,
     "content_html": "The size of the sperm produced are different."
    },
    {
     "id": 1011720,
     "content_html": "Some sperm may have a tail, whereas others may not."
    },
    {
     "id": 1011721,
     "content_html": "Crossing over occurs during spermatogenesis."
    }
   ],
