   "id": 531060,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How would infection of zebras by<i> Bacillus anthracis</i> be described—as a density-dependent or density-independent factor that regulates population growth?",
   "answers": [
    {
     "id": 1039556,
     "content_html": "This is an example of a density-independent factor because it becomes worse as the population density increases."
    },
    {
     "id": 1039557,
     "content_html": "This is an example of a density-dependent factor because it becomes better as the population density increases."
