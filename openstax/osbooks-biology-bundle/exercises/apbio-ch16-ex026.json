 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id2022629\" class=\"interactive-embedded-reading\" data-label=\"\">\n<div data-type=\"title\" id=\"2\">Link to Learning</div>\n<span data-type=\"media\" id=\"fs-id1595515\" data-alt=\"QR Code representing a URL\">\n<img src=\"https://openstax.org/apps/archive/20220509.174553/resources/f1d970b478090e5b9d136e2984ee7684f090ae3c\" data-media-type=\"image/png\" alt=\"QR Code representing a URL\" width=\"120\" id=\"3\">\n</span>\n    <p id=\"fs-id2192558\">View the process of transcription—the making of RNA from a DNA template.\n\n</p>\n<div data-type=\"media\" id=\"eip-id1168020166468\" data-alt=\"transcript_RNA\">\n<div class=\"os-has-iframe os-has-link\" data-type=\"alternatives\">\n<a class=\"os-is-link\" href=\"https://openstax.org/books/biology/pages/16-4-eukaryotic-transcription-gene-regulation\" target=\"_blank\" rel=\"noopener nofollow\">Click to view content</a>\n<iframe width=\"660\" height=\"371.4\" src=\"https://www.openstaxcollege.org/l/transcript_RNA\" class=\"os-is-iframe\"><!-- no-selfclose --></iframe>\n</div>\n                 </div>\n</div>\n",
 "stimulus_html": "",
 "questions": [
  {
   "id": 334665,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the major events that occur during eukaryotic transcription.",
   "answers": [
    {
     "id": 844283,
     "content_html": "DNA unwinds, transcription factors bind, the termination complex forms, and DNA polymerase adds nucleotides to the mRNA."
    },
    {
     "id": 844284,
     "content_html": "DNA unwinds, transcription factors bind, and RNA polymerase adds nucleotides to the mRNA."
    },
    {
     "id": 844282,
     "content_html": "The transcription complex forms, transcription factors add nucleotides to the forming mRNA, and the mRNA disconnects from the DNA."
    },
    {
     "id": 844281,
     "content_html": "Elongation occurs, followed by the formation of the transcription initiation complex and the disconnection of the mRNA strand from DNA."
    }
   ],
