   "id": 521485,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is a likely evolutionary advantage of sexual reproduction over asexual reproduction?",
   "answers": [
    {
     "id": 1019740,
     "content_html": "Sexual reproduction involves fewer steps."
    },
    {
     "id": 1019741,
     "content_html": "Sexual reproduction results in variation in the offspring."
    },
    {
     "id": 1019742,
     "content_html": "Sexual reproduction is more metabolically efficient."
    },
    {
     "id": 1019743,
     "content_html": "Sexual reproduction uses up fewer resources in a given environment."
    }
