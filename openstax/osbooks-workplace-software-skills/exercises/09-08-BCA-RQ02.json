 "questions": [
  {
   "id": 376061,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do you look for public templates in Sheets?",
   "answers": [
    {
     "id": 901912,
     "content_html": "You need to go to the Welcome screen, and search for templates there."
    },
    {
     "id": 901913,
     "content_html": "You need to go to Google.com, and type “X template site:docs.google.com”."
    },
    {
     "id": 901914,
     "content_html": "You can’t because Sheets doesn’t have access to public templates."
    },
    {
     "id": 901915,
     "content_html": "You can look for Microsoft Word templates because they work in Sheets, too."
    }
