 "questions": [
  {
   "id": 365854,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the advantage of using diagrams in a Slides presentation?",
   "answers": [
    {
     "id": 886901,
     "content_html": "Slides automatically designs any diagram that you select."
    },
    {
     "id": 886902,
     "content_html": "You can copy and paste diagrams from other sources without making any modifications."
    },
    {
     "id": 886903,
     "content_html": "You can present complex information in a simple and intuitive way."
    },
    {
     "id": 886904,
     "content_html": "Diagrams make it easier to quickly create a presentation."
    }
   ],
