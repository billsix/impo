 "questions": [
  {
   "id": 366199,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the disadvantage of inserting an Excel chart into a PowerPoint slide as a JPEG or PNG image?",
   "answers": [
    {
     "id": 887617,
     "content_html": "The image is simply a copy that cannot be moved around once it is inserted into a PowerPoint slide."
    },
    {
     "id": 887618,
     "content_html": "The image is simply a copy that cannot be integrated."
    },
    {
     "id": 887619,
     "content_html": "The image is simply a copy that cannot be duplicated to use on more than one slide."
    },
    {
     "id": 887620,
     "content_html": "The image is simply a copy that cannot be updated."
    }
   ],
