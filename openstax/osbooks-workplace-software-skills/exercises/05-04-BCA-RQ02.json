   "id": 361961,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do you navigate to the templates in Docs?",
   "answers": [
    {
     "id": 874465,
     "content_html": "Go to the File menu, then New."
    },
    {
     "id": 874466,
     "content_html": "Go to the Insert menu, then Drawing."
    },
    {
     "id": 874467,
     "content_html": "Go to the Extensions menu, then Add-ons."
    },
    {
     "id": 874468,
     "content_html": "Go to the View menu, then Mode."
    }
   ],
