   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the function of the Caption tool?",
   "answers": [
    {
     "id": 865753,
     "content_html": "It inserts autogenerated text to footnotes."
    },
    {
     "id": 865754,
     "content_html": "It labels all figures, which then can be used to build a table of figures."
    },
    {
     "id": 865755,
     "content_html": "It labels headings, which can then be used to build a table of contents."
    },
    {
     "id": 865756,
     "content_html": "It inserts a reference for the image or table."
    }
