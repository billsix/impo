  {
   "id": 376069,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  is one method to name data ranges?",
   "answers": [
    {
     "id": 901928,
     "content_html": "On the Page Layout tab, use options in the Sheet Options command group."
    },
    {
     "id": 901929,
     "content_html": "Use the Formula Bar."
    },
    {
     "id": 901930,
     "content_html": "Press Ctrl+Shift+Enter."
    },
    {
     "id": 901931,
     "content_html": "On the Formulas tab, select Define Name in the Defined Names command group."
    }
