     "id": 866777,
     "content_html": "It lacks the ability to share links with others."
    },
    {
     "id": 866778,
     "content_html": "It is a cloud storage platform."
    },
    {
     "id": 866779,
     "content_html": "It is incompatible with Microsoft products."
    },
    {
     "id": 866780,
     "content_html": "The organization of files is not predetermined."
