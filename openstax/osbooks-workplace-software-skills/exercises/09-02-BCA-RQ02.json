 "questions": [
  {
   "id": 376025,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are examples of the benefits of using both numerical and text data in your worksheet but keeping them in separate columns?",
   "answers": [
    {
     "id": 901768,
     "content_html": "Numerical data can be combined with text data for writing descriptions of objects and their measurements."
    },
    {
     "id": 901769,
     "content_html": "Text data can be used for autofilling a calculation of multiple scenarios."
    },
    {
     "id": 901770,
     "content_html": "Numerical data can be used in accounting, dates, or number formats, while text is used for descriptions or headers."
    },
    {
     "id": 901771,
     "content_html": "Text and numerical data are easily typed and interpreted by Excel, as it can read words, thus they can be used for computable lists."
    }
   ],
