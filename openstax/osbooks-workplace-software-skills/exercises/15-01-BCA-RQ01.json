 "questions": [
  {
   "id": 366167,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why are collaborative workspaces important?",
   "answers": [
    {
     "id": 887533,
     "content_html": "They promote teamwork and increase productivity during in-office meetings."
    },
    {
     "id": 887534,
     "content_html": "They enable employees to work independently."
    },
    {
     "id": 887535,
     "content_html": "They enable organizations to meet the diverse needs of their employees through remote work options."
    },
    {
     "id": 887536,
     "content_html": "They make it more efficient for organizations to gather the information and resources needed to complete their work."
    }
   ],
