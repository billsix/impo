 "questions": [
  {
   "id": 366338,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What steps should you use to integrate a Word document into an Excel file?",
   "answers": [
    {
     "id": 888005,
     "content_html": "Select the Layout tab and use Page Setup."
    },
    {
     "id": 888006,
     "content_html": "Select the Review tab and use the Changes command."
    },
    {
     "id": 888007,
     "content_html": "Select the Insert Object function and put your cursor where the information should be placed in your Excel document."
    },
    {
     "id": 888008,
     "content_html": "Select the Get Data function and click on the Query Options."
    }
   ],
