   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How does having a clear purpose for your presentation help you connect to your audience?",
   "answers": [
    {
     "id": 886805,
     "content_html": "It helps ensure that your presentation is coherent."
    },
    {
     "id": 886806,
     "content_html": "It helps ensure that your presentation is consistent."
    },
    {
     "id": 886807,
     "content_html": "It helps ensure that your presentation is relevant."
    },
    {
     "id": 886808,
     "content_html": "It helps ensure that your presentation has an appropriate outline."
    }
