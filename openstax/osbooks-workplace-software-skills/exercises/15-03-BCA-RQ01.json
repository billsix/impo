   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do you access all of the slides that have been integrated into a Word document?",
   "answers": [
    {
     "id": 887569,
     "content_html": "from the Review tab"
    },
    {
     "id": 887570,
     "content_html": "by double-clicking on the slide image in the document"
    },
    {
     "id": 887571,
     "content_html": "by pressing Page down"
    },
    {
     "id": 887572,
     "content_html": "by using Ctrl+Click"
    }
