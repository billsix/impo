 "questions": [
  {
   "id": 366209,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is one way to insert a chart from Google Sheets into Google Docs?",
   "answers": [
    {
     "id": 887633,
     "content_html": "You can go to the Insert window menu and use the mouse to choose Chart and then From Sheets."
    },
    {
     "id": 887634,
     "content_html": "You can drag the chart from Google Sheets to Google Docs, as long as they are in separate windows."
    },
    {
     "id": 887635,
     "content_html": "You can use the mouse to select the browser window where Google Sheets is located and then insert the browser window on Google Docs."
    },
    {
     "id": 887636,
     "content_html": "You can use the Print Screen key on the keyboard to copy the chart and then press Ctrl+V at the position where you want to place the chart in Google Docs."
    }
   ],
