   "stimulus_html": "",
   "stem_html": "How does a user inspect if the current cell has input and/or output problems?",
   "answers": [
    {
     "id": 902000,
     "content_html": "The user would use the Step In tool."
    },
    {
     "id": 902001,
     "content_html": "The user would use the Inquire add-in."
    },
    {
     "id": 902002,
     "content_html": "The user would use the Watch Window."
    },
    {
     "id": 902003,
     "content_html": "The user can run the Trace Precedents and Dependents tools."
    }
