 "questions": [
  {
   "id": 365853,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When adding images to your Slides presentation, what should you remember?",
   "answers": [
    {
     "id": 886897,
     "content_html": "Only copyrighted and trademarked images should be used."
    },
    {
     "id": 886898,
     "content_html": "Before you insert the images into your presentation, they must be the correct size."
    },
    {
     "id": 886899,
     "content_html": "You should use the Format menu to insert images."
    },
    {
     "id": 886900,
     "content_html": "The images can come from any source, including pictures on your smartphone."
    }
   ],
