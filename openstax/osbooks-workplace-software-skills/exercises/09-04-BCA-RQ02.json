 "questions": [
  {
   "id": 376035,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify  the steps for automatically highlighting any cells from a column that are greater than a certain number.",
   "answers": [
    {
     "id": 901808,
     "content_html": "Select the cell you want to analyze, click on Conditional Formatting, go to Highlight cell rules, click Greater than, and set the parameters."
    },
    {
     "id": 901809,
     "content_html": "Select the column in question, then click on Conditional Formatting, go to Highlight cell rules, click Greater than, and set the parameters."
    },
    {
     "id": 901810,
     "content_html": "Select the column in question, then click on Conditional Formatting, go to Highlight cell rules, click Between, and set the parameters."
    },
    {
     "id": 901811,
     "content_html": "Select the cell you want to analyze, click on Conditional Formatting, go to Highlight cell rules, and click Top 10%."
    }
   ],
