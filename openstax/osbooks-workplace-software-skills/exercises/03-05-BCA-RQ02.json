   "stimulus_html": "",
   "stem_html": "What is the main use of a watermark?",
   "answers": [
    {
     "id": 865645,
     "content_html": "to add a text or an image behind the body text of all pages"
    },
    {
     "id": 865646,
     "content_html": "to insert an image on top of the header on all papers"
    },
    {
     "id": 865647,
     "content_html": "to apply different font formatting throughout the document"
    },
    {
     "id": 865648,
     "content_html": "to delete the page background on every page"
    }
