 "questions": [
  {
   "id": 366169,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Office’s common user interface fosters integration. What does this mean?",
   "answers": [
    {
     "id": 887541,
     "content_html": "The common user interface enables collaborative workspaces."
    },
    {
     "id": 887542,
     "content_html": "The common user interface makes remote work possible."
    },
    {
     "id": 887543,
     "content_html": "The common user interface allows users to share files, edit documents, and have virtual meetings in real time."
    },
    {
     "id": 887544,
     "content_html": "The common user interface has a similar format and structure in different applications."
    }
   ],
