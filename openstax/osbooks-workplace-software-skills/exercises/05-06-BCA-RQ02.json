 "questions": [
  {
   "id": 361991,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do you open the comment history sidebar?",
   "answers": [
    {
     "id": 874532,
     "content_html": "Select the comment button at the top-right corner of your document."
    },
    {
     "id": 874533,
     "content_html": "Go to Google Drive and right-click your document to see its version history."
    },
    {
     "id": 874534,
     "content_html": "Navigate to your document’s File menu and then toggle Suggesting mode."
    },
    {
     "id": 874535,
     "content_html": "Go to the Insert menu and then choose the Comment command."
    }
   ],
