   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How does recording a macro in Access help enhance database functions?",
   "answers": [
    {
     "id": 887105,
     "content_html": "It creates queries with multiple criteria."
    },
    {
     "id": 887106,
     "content_html": "It enables the building of queries that aggregate."
    },
    {
     "id": 887107,
     "content_html": "It optimizes the Form Wizard to allow users to build a custom form."
    },
    {
     "id": 887108,
     "content_html": "It creates a system to accomplish similar operations easily and efficiently."
    }
