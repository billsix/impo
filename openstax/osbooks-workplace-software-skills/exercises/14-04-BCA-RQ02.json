 "questions": [
  {
   "id": 365943,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the primary purpose of grouping and sorting in Access reports?",
   "answers": [
    {
     "id": 887093,
     "content_html": "to display the report title and general information clearly"
    },
    {
     "id": 887094,
     "content_html": "to organize data into sections such as Report Header and Footer"
    },
    {
     "id": 887095,
     "content_html": "to help users quickly identify patterns and trends in the data"
    },
    {
     "id": 887096,
     "content_html": "to format the report with different font styles and colors"
    }
   ],
