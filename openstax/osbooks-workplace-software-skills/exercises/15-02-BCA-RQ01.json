 "questions": [
  {
   "id": 366336,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What happens to the content of an Excel worksheet when it is integrated into a Word document?",
   "answers": [
    {
     "id": 887997,
     "content_html": "When information in the Excel source file changes, if the file is integrated properly, the information will also be updated in the Word file."
    },
    {
     "id": 887998,
     "content_html": "When information in the Excel source file changes, the information will not be updated in the Word file."
    },
    {
     "id": 887999,
     "content_html": "The Excel data will insert into your Word document as a link."
    },
    {
     "id": 888000,
     "content_html": "The Excel data will insert into your Word document as textual content."
    }
   ],
