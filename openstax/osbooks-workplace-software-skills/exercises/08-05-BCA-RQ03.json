   "stem_html": "What is a social media calendar?",
   "answers": [
    {
     "id": 881600,
     "content_html": "data collected from different social channels to measure performance"
    },
    {
     "id": 881601,
     "content_html": "a tool that allows organizations to engage with members and involves a team of client relations to satisfy clients"
    },
    {
     "id": 881602,
     "content_html": "a spreadsheet or app used to schedule social posts in advance"
    },
    {
