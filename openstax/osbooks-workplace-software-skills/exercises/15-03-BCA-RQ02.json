 "questions": [
  {
   "id": 366185,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When adding Word documents to PowerPoint slides, what happens if you don’t choose the Link box?",
   "answers": [
    {
     "id": 887573,
     "content_html": "The Word document will be embedded into the slide, rather than linked."
    },
    {
     "id": 887574,
     "content_html": "The Word document will be linked, but you will be unable to make any changes to it."
    },
    {
     "id": 887575,
     "content_html": "The Word document will be embedded, with a picture of the information inserted into the PowerPoint slide."
    },
    {
     "id": 887576,
     "content_html": "The Word document will be linked, but you will have to retype some of the information to make it display properly in PowerPoint."
    }
   ],
