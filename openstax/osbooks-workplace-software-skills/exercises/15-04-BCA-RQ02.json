  {
   "id": 366340,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What approach should you use to link only certain information from an Excel file into a PowerPoint slide?",
   "answers": [
    {
     "id": 888013,
     "content_html": "Use the Insert tab, Choose Link approach."
    },
    {
     "id": 888014,
     "content_html": "Use the standard copy-and-paste approach."
    },
    {
     "id": 888015,
     "content_html": "Use the Paste Special approach."
    },
    {
     "id": 888016,
     "content_html": "Use the Display as icon approach."
    }
