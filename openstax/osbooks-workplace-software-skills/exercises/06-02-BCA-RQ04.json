 "questions": [
  {
   "id": 365819,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the advantage of the Design tab over the Design Ideas feature?",
   "answers": [
    {
     "id": 886833,
     "content_html": "The Design tab has an on/off button that provides advanced slide layouts."
    },
    {
     "id": 886834,
     "content_html": "The Design tab enables you to adjust elements of your presentation such as line spacing and columns."
    },
    {
     "id": 886835,
     "content_html": "The Design tab offers the option of using a blank, white canvas to build your presentation."
    },
    {
     "id": 886836,
     "content_html": "The Design tab provides a collection of tools that enable you to change layout designs for all of your slides at once."
    }
   ],
