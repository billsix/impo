   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is one advantage that Excel has over QuickBooks?",
   "answers": [
    {
     "id": 886785,
     "content_html": "Making financial statements is easier."
    },
    {
     "id": 886786,
     "content_html": "Excel is better equipped to do analysis of the numbers."
    },
    {
     "id": 886787,
     "content_html": "Excel makes it easy to track payroll."
    },
    {
     "id": 886788,
     "content_html": "Excel can generate tax reports."
    }
