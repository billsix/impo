  {
   "id": 350598,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the purpose of the Page Setup command group?",
   "answers": [
    {
     "id": 865613,
     "content_html": "It is used to set page margins and the page size."
    },
    {
     "id": 865614,
     "content_html": "It is used to wrap text and align text."
    },
    {
     "id": 865615,
     "content_html": "It is used to insert object and pictures."
    },
    {
     "id": 865616,
     "content_html": "It is used to insert WordArt or a signature line."
    }
