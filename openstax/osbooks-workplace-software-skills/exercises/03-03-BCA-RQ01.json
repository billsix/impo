 "questions": [
  {
   "id": 350609,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the difference between indenting a paragraph and aligning it?",
   "answers": [
    {
     "id": 865625,
     "content_html": "aligning a paragraph will center or position it left or right, whereas increasing the indent will add space in that selection"
    },
    {
     "id": 865626,
     "content_html": "increasing the indent will center and indent left or right, whereas aligning will add a tab space in that selection"
    },
    {
     "id": 865627,
     "content_html": "aligning a paragraph can increase the indent when you place it in the center or left or right"
    },
    {
     "id": 865628,
     "content_html": "indenting a paragraph can increase the alignment when you place it in the center or left or right"
    }
   ],
