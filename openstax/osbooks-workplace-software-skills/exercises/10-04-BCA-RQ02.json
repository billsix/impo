 "questions": [
  {
   "id": 349748,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does the Recommended PivotTable tool provide?",
   "answers": [
    {
     "id": 864797,
     "content_html": "The tool recommends and constructs a PivotTable with several variables based on your data."
    },
    {
     "id": 864798,
     "content_html": "The tool creates both a PivotTable and a PivotChart from the selected data."
    },
    {
     "id": 864799,
     "content_html": "The tool recommends PivotTable variables (i.e., headings) to be the leading data presented in one-dimensional tables."
    },
    {
     "id": 864800,
     "content_html": "The tool recommends appropriate formulas to analyze the data in the PivotTable."
    }
   ],
