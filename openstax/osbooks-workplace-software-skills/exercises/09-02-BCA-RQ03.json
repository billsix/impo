 "questions": [
  {
   "id": 376638,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a benefit of preformatting cells in Excel?",
   "answers": [
    {
     "id": 903059,
     "content_html": "You can automatically fill the data without typing it by inserting an image from the phone."
    },
    {
     "id": 903060,
     "content_html": "You can type the data and Excel will apply the format, so it looks how you want it to."
    },
    {
     "id": 903061,
     "content_html": "You can send a Bluetooth connection to the data, and it will be autofilled."
    },
    {
     "id": 903062,
     "content_html": "You can use the cell references to do mathematical operations."
    }
   ],
