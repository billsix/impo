   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Where would you go to reformat a phone number?",
   "answers": [
    {
     "id": 902016,
     "content_html": "the Format Cells tool in the Number command group on the Home tab"
    },
    {
     "id": 902017,
     "content_html": "in the Page Layout menu in the Themes command group"
    },
    {
     "id": 902018,
     "content_html": "using the Format Painter"
    },
    {
     "id": 902019,
     "content_html": "using Cell Styles from the Home tab"
    }
