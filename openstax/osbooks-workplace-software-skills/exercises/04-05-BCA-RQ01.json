   "id": 375966,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is one way to insert a drawing from Google Drawings into a Doc",
   "answers": [
    {
     "id": 901712,
     "content_html": "You can upload the drawing directly from your desktop."
    },
    {
     "id": 901713,
     "content_html": "You can drag-and-drop a drawing from your desktop."
    },
    {
     "id": 901714,
     "content_html": "You can upload or link to an existing file in Drive."
    },
    {
     "id": 901715,
     "content_html": "You can create a new one from a vector-graphics tool within Docs."
    }
