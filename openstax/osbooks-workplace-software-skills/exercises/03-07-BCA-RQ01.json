 "questions": [
  {
   "id": 365673,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How does the user apply a new font to an entire paragraph in Docs?",
   "answers": [
    {
     "id": 886545,
     "content_html": "Select all of the text, then either go to the Format menu or to the action bar to select a font type from the combo box."
    },
    {
     "id": 886546,
     "content_html": "Place your cursor anywhere in the paragraph and choose the new font from the action bar."
    },
    {
     "id": 886547,
     "content_html": "Navigate to the Format menu and select a new font."
    },
    {
     "id": 886548,
     "content_html": "Select the entire paragraph and choose the font type from the Edit menu."
    }
   ],
