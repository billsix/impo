 "questions": [
  {
   "id": 365842,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a primary difference between Slides and PowerPoint?",
   "answers": [
    {
     "id": 886873,
     "content_html": "Slides is a web-based software application, while PowerPoint is a stand-alone software program."
    },
    {
     "id": 886874,
     "content_html": "PowerPoint is recommended for online collaboration, while Slides is best for self-contained work."
    },
    {
     "id": 886875,
     "content_html": "Slides can only be used offline, while PowerPoint is ideal for mobile application devices."
    },
    {
     "id": 886876,
     "content_html": "PowerPoint can only be used through cloud-based applications, while Slides is a desktop application."
    }
   ],
