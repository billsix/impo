 "questions": [
  {
   "id": 376057,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the difference between the QUOTIENT and DIVIDE functions?",
   "answers": [
    {
     "id": 901896,
     "content_html": "DIVIDE gives you decimals in the result, and QUOTIENT gives you whole numbers."
    },
    {
     "id": 901897,
     "content_html": "There is no difference; they will always produce the same answer."
    },
    {
     "id": 901898,
     "content_html": "QUOTIENT will give a result with the first two decimal places, whereas DIVIDE gives a result that includes all decimal places."
    },
    {
     "id": 901899,
     "content_html": "You can use QUOTIENT in Sheets, and you can use DIVIDE in Excel."
    }
   ],
