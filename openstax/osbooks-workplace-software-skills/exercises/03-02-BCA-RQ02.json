   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Where is the command for putting a section break located?",
   "answers": [
    {
     "id": 865621,
     "content_html": "on the Layout tab, in the Breaks drop-down menu"
    },
    {
     "id": 865622,
     "content_html": "on the Insert tab, in the Page Break drop-down menu"
    },
    {
     "id": 865623,
     "content_html": "on the Insert tab, in the Text Box drop-down menu"
    },
    {
     "id": 865624,
     "content_html": "on the Layout tab, in the Column drop-down menu"
    }
