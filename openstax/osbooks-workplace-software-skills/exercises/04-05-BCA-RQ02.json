 "questions": [
  {
   "id": 350948,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How would you insert the copyright symbol ( © ) into a Doc?",
   "answers": [
    {
     "id": 865805,
     "content_html": "Go to the Insert menu and choose Special characters."
    },
    {
     "id": 865806,
     "content_html": "Find the copyright symbol online and copy and paste it into the document."
    },
    {
     "id": 865807,
     "content_html": "Insert it as a drawing."
    },
    {
     "id": 865808,
     "content_html": "Go the Insert menu and chose Image."
    }
   ],
