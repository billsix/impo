   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do you check to see who has access and what kind of access to a Google file?",
   "answers": [
    {
     "id": 874525,
     "content_html": "Select the comment button at the top-right corner of your document."
    },
    {
     "id": 874526,
     "content_html": "Go to the View menu."
    },
    {
     "id": 874527,
     "content_html": "Examine the file’s version history."
    },
    {
     "id": 874528,
     "content_html": "Choose the Share button."
    }
