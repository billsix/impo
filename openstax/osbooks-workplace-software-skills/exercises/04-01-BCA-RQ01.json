  {
   "id": 350900,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do you add a level to a multilevel list?",
   "answers": [
    {
     "id": 865701,
     "content_html": "Go to the Insert tab and choose bulleted list."
    },
    {
     "id": 865702,
     "content_html": "Use the Tab key or use the Increase Indent tool."
    },
    {
     "id": 865703,
     "content_html": "Highlight the text and choose multilevel lists from the Layout tab."
    },
    {
     "id": 865704,
     "content_html": "Insert a numbered list from the Home tab and press Enter after each line."
    }
   ],
