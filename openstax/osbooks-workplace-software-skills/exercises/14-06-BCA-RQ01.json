 "questions": [
  {
   "id": 366300,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When you import data into Access from an external source, what happens to the source data?",
   "answers": [
    {
     "id": 887909,
     "content_html": "Importing data always alters the source data."
    },
    {
     "id": 887910,
     "content_html": "Importing data is not as flexible as copying and pasting."
    },
    {
     "id": 887911,
     "content_html": "Importing data allows you to modify the structure of linked tables that contain the source data."
    },
    {
     "id": 887912,
     "content_html": "Importing data creates a copy of the data in the destination database without altering the source data."
    }
   ],
