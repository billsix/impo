   "stimulus_html": "",
   "stem_html": "What are the key components of a business memo?",
   "answers": [
    {
     "id": 874380,
     "content_html": "the business logo, the memo sign, the heading, the body text"
    },
    {
     "id": 874381,
     "content_html": "the letterhead, the addressor’s address, the addressee’s address, the body text"
    },
    {
     "id": 874382,
     "content_html": "the business logo, the name, the job position, the contact details"
    },
    {
     "id": 874383,
     "content_html": "the cover, the back cover, the inside flap, the inside center"
    }
