 "questions": [
  {
   "id": 366023,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best explains the process of manually adding a record to a database?",
   "answers": [
    {
     "id": 887269,
     "content_html": "You never add a record manually to a database because this is not a function in Access."
    },
    {
     "id": 887270,
     "content_html": "You are unlikely to add a record manually but can do so when necessary."
    },
    {
     "id": 887271,
     "content_html": "You are likely to add records to ensure that the database matches the production database."
    },
    {
     "id": 887272,
     "content_html": "You will scan records but will not manually input them to update the production database."
    }
   ],
