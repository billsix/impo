 "questions": [
  {
   "id": 366022,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When would you navigate through a database using the navigation buttons on the datasheet?",
   "answers": [
    {
     "id": 887265,
     "content_html": "when you have many records to look at"
    },
    {
     "id": 887266,
     "content_html": "when you want to see thousands of records at a glance"
    },
    {
     "id": 887267,
     "content_html": "when you do not want to take the time to create a query"
    },
    {
     "id": 887268,
     "content_html": "when you are looking at a small set of records (e.g., from a query)"
    }
