 "questions": [
  {
   "id": 365959,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When you export data from Access to Excel, what does the Export Wizard do?",
   "answers": [
    {
     "id": 887117,
     "content_html": "Exporting data from Access to Excel is a manual process that requires copying and pasting."
    },
    {
     "id": 887118,
     "content_html": "The Export Wizard in Access allows you to import data from Excel to Access databases."
    },
    {
     "id": 887119,
     "content_html": "Access creates a link between the data in Access and Excel when exporting data."
    },
    {
     "id": 887120,
     "content_html": "The Export Wizard allows you to save the export routine for future use and automate the export operation."
    }
   ],
