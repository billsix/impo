   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Where do you select the headers you want to use in a PivotTable?",
   "answers": [
    {
     "id": 901984,
     "content_html": "on the Insert tab in the Text command group"
    },
    {
     "id": 901985,
     "content_html": "on the Data tab under What-If Analysis"
    },
    {
     "id": 901986,
     "content_html": "in the PivotTable Field List after creating a PivotTable"
    },
    {
     "id": 901987,
     "content_html": "on the Insert tab using the Insert PivotTable command"
    }
