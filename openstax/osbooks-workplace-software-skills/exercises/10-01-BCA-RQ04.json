 "questions": [
  {
   "id": 349766,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  are the benefits of using data ranges in your worksheets?",
   "answers": [
    {
     "id": 864829,
     "content_html": "You can autofill and compute scenarios."
    },
    {
     "id": 864830,
     "content_html": "You can simultaneously calculate different operations in different worksheets."
    },
    {
     "id": 864831,
     "content_html": "You can save time by not going back to search for named cells."
    },
    {
     "id": 864832,
     "content_html": "You can reorganize the data following different criteria."
    }
   ],
