 "questions": [
  {
   "id": 350954,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do you link to a table in another part of a Doc?",
   "answers": [
    {
     "id": 865813,
     "content_html": "Use the Link tool on the Insert menu and copy the link."
    },
    {
     "id": 865814,
     "content_html": "Create a bookmark to the table and copy the link."
    },
    {
     "id": 865815,
     "content_html": "Choose the Link Objects option from the Insert menu."
    },
    {
     "id": 865816,
     "content_html": "Add a heading to the table, and then link to the heading."
    }
   ],
