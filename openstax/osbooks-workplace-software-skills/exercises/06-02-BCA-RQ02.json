   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you wanted to change the overall color style of a theme you are using, which option would be best?",
   "answers": [
    {
     "id": 886825,
     "content_html": "Go to the Design tab, then Variants."
    },
    {
     "id": 886826,
     "content_html": "Go to the Home tab, then Slides."
    },
    {
     "id": 886827,
     "content_html": "Go to the Insert tab, then Text."
    },
    {
     "id": 886828,
     "content_html": "Go to the View tab, Outline View."
    }
