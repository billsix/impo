 "questions": [
  {
   "id": 365843,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If your workplace uses only Microsoft products, which program would be a better choice for creating a slideshow, and why?",
   "answers": [
    {
     "id": 886877,
     "content_html": "PowerPoint, because it is more feature-rich than Slides"
    },
    {
     "id": 886878,
     "content_html": "PowerPoint, because it is advantageous to remain within your workplace’s software ecosystem"
    },
    {
     "id": 886879,
     "content_html": "Slides, because it is more user-friendly than PowerPoint"
    },
    {
     "id": 886880,
     "content_html": "Slides, because it is better for online collaboration"
    }
   ],
