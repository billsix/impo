 "questions": [
  {
   "id": 624183,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What role did the nomarchs play in the decline of the Old Kingdom and beginning of the First Intermediate Period?",
   "answers": [
    {
     "id": 1198047,
     "content_html": "They instituted important religious practices."
    },
    {
     "id": 1198048,
     "content_html": "They assumed more control over their regions."
    },
    {
     "id": 1198046,
     "content_html": "They allowed for greater Hyksos immigration."
    },
    {
     "id": 1198045,
     "content_html": "They rejected the authority of the priests."
    }
   ],
