     "content_html": "It likely revered ancestors."
    },
    {
     "id": 1198008,
     "content_html": "It likely had some type of government."
    },
    {
     "id": 1198006,
     "content_html": "It likely performed animal sacrifices."
    },
    {
     "id": 1198005,
     "content_html": "It likely had a small population."
