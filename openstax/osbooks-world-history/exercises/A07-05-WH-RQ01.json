   "id": 624349,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How could a person obtain Roman citizenship?",
   "answers": [
    {
     "id": 1198343,
     "content_html": "It was given to provincial governors after a period of service."
    },
    {
     "id": 1198342,
     "content_html": "It was given to those who returned from exile."
    },
    {
     "id": 1198344,
     "content_html": "It was given to a person whose parents were both citizens."
    },
    {
     "id": 1198341,
     "content_html": "It was given to gladiators who had won a certain number of matches."
    }
   ],
