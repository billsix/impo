  {
   "id": 624184,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was significant about the reign of Sobekneferu?",
   "answers": [
    {
     "id": 1198051,
     "content_html": "She was both pharaoh and priest."
    },
    {
     "id": 1198050,
     "content_html": "She was the last pharaoh of the Middle Kingdom."
    },
    {
     "id": 1198049,
     "content_html": "She gave unprecedented power to the nomarchs."
    },
    {
     "id": 1198052,
     "content_html": "She was the first woman to rule since before the Old Kingdom."
    }
   ],
