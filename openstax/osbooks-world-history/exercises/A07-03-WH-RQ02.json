 "questions": [
  {
   "id": 624336,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the nature of Augustus’s inheritance tax?",
   "answers": [
    {
     "id": 1198323,
     "content_html": "It taxed the inheritance of veteran soldiers after a period of service."
    },
    {
     "id": 1198322,
     "content_html": "It taxed money inherited by <i>publicani</i> in certain provinces."
    },
    {
     "id": 1198321,
     "content_html": "It taxed patrons who had a certain number of clients."
    },
    {
     "id": 1198324,
     "content_html": "It taxed inheritances received from persons outside the immediate family."
    }
   ],
