 "questions": [
  {
   "id": 624933,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To what did the term <i>casta</i> in Spanish America refer?",
   "answers": [
    {
     "id": 1199404,
     "content_html": "a social hierarchy encoded in law and based on what were thought to be inherited characteristics"
    },
    {
     "id": 1199403,
     "content_html": "a nativist label for people of African descent, used during the wars of independence"
    },
    {
     "id": 1199402,
     "content_html": "the lowest social layer, linked to a person’s economic status"
    },
    {
     "id": 1199401,
     "content_html": "people of Indigenous descent who lived in the rural areas"
    }
   ],
