   "id": 625221,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did President Kennedy begin a naval blockade of Cuba in 1962?",
   "answers": [
    {
     "id": 1199951,
     "content_html": "to force Fidel Castro from power"
    },
    {
     "id": 1199952,
     "content_html": "to prevent the Soviet Union from installing missiles aimed at the United States"
    },
    {
     "id": 1199950,
     "content_html": "to provide assistance to the government of Fulgencio Batista"
    },
    {
     "id": 1199949,
     "content_html": "to prevent Cuba from using its submarines to mine U.S. harbors"
    }
   ],
