   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  of the following was true of trade across the Islamic world?",
   "answers": [
    {
     "id": 1199139,
     "content_html": "<i>Dhimmis</i> were prohibited from participating in trade."
    },
    {
     "id": 1199140,
     "content_html": "Trade helped expand the reach of Islam."
    },
    {
     "id": 1199138,
     "content_html": "Markets lacked a uniform system of weights and measures."
    },
    {
     "id": 1199137,
     "content_html": "Merchants operated outside the rules of sharia."
    }
