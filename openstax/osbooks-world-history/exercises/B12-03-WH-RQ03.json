 "questions": [
  {
   "id": 625122,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why were people drawn to communism in the 1930s?",
   "answers": [
    {
     "id": 1199767,
     "content_html": "The Communist Party was the most successful organization getting people elected to office."
    },
    {
     "id": 1199766,
     "content_html": "The Communist Party rebranded itself as a mainstream party in the 1930s."
    },
    {
     "id": 1199768,
     "content_html": "The Communist Party offered an alternative to the capitalist systems being undermined by the Great Depression."
    },
    {
     "id": 1199765,
     "content_html": "The Communist Party exploited people’s desire for entertainment by producing movies and holding rallies on a regular basis."
    }
   ],
