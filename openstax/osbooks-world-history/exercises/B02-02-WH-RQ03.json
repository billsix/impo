 "questions": [
  {
   "id": 624733,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  was the result of Portugal’s effort to Christianize the subjects of the Sultanate of Ternate?",
   "answers": [
    {
     "id": 1199064,
     "content_html": "The Muslims of Ternate began a holy war against the Portuguese and drew closer to the Muslim world."
    },
    {
     "id": 1199063,
     "content_html": "The Portuguese successfully converted the majority of the population, who drove out their Muslim rulers."
    },
    {
     "id": 1199062,
     "content_html": "The people of Ternate allied with the Muslims in Majapahit and Ayutthaya to drive out the Portuguese."
    },
    {
     "id": 1199061,
     "content_html": "The Spanish allied with the Portuguese to kill all the residents of Ternate who refused to become Christian."
    }
   ],
