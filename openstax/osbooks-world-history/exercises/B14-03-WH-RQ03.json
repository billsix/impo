   "stimulus_html": "",
   "stem_html": "Why did France, Israel, and the United Kingdom attack Egypt in 1956?",
   "answers": [
    {
     "id": 1199939,
     "content_html": "Egypt launched an air attack on Israel."
    },
    {
     "id": 1199938,
     "content_html": "Egypt defaulted on loans it owed to France and the United Kingdom."
    },
    {
     "id": 1199937,
     "content_html": "Egypt was undergoing a communist revolution."
    },
    {
     "id": 1199940,
     "content_html": "Egypt nationalized the Suez Canal and closed it to Israel."
    }
