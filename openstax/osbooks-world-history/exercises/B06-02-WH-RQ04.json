   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was a result of the Qing dynasty’s trade policies?",
   "answers": [
    {
     "id": 1199292,
     "content_html": "China temporarily enjoyed a favorable balance of trade."
    },
    {
     "id": 1199291,
     "content_html": "The British were forced to focus on their colonies in North America."
    },
    {
     "id": 1199290,
     "content_html": "China was able to dominate Japan politically and militarily."
    },
    {
     "id": 1199289,
     "content_html": "The French suffered defeat in the Seven Years’ War."
    }
