 "questions": [
  {
   "id": 624657,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the lack of laborers in towns and cities affect the European social structure?",
   "answers": [
    {
     "id": 1198940,
     "content_html": "It made it easier for people to set up craft shops, undermining the guild system."
    },
    {
     "id": 1198939,
     "content_html": "It led to an increase in female artisans and business owners."
    },
    {
     "id": 1198938,
     "content_html": "It reduced the size of the merchant class."
    },
    {
     "id": 1198937,
     "content_html": "It led towns to pass laws forbidding apprentices to move elsewhere."
    }
   ],
