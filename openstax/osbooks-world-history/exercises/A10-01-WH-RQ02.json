  {
   "id": 624428,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the Huns affect the migration of Germanic peoples?",
   "answers": [
    {
     "id": 1198507,
     "content_html": "They bribed the Visigoths to invade Italy and sack Rome."
    },
    {
     "id": 1198508,
     "content_html": "They put pressure on the frontier, pushing people into Roman territory."
    },
    {
     "id": 1198506,
     "content_html": "They forced the Vandals to attack the Saxons."
    },
    {
     "id": 1198505,
     "content_html": "They spread Christianity past the frontier of the empire."
    }
   ],
