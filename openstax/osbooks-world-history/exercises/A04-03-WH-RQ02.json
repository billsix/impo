   "stimulus_html": "",
   "stem_html": "According to Zoroastrianism, what happens to people when they die?",
   "answers": [
    {
     "id": 1198111,
     "content_html": "They go to heaven."
    },
    {
     "id": 1198112,
     "content_html": "They sleep until final judgment."
    },
    {
     "id": 1198110,
     "content_html": "They become gods."
    },
    {
     "id": 1198109,
     "content_html": "They are reborn as animals."
    }
