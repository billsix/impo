  {
   "id": 624835,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to mercantilist theory, what is the main purpose of colonies?",
   "answers": [
    {
     "id": 1199239,
     "content_html": "to serve as a home for excess population in the home country"
    },
    {
     "id": 1199238,
     "content_html": "to offer a haven for religious and political dissidents"
    },
    {
     "id": 1199237,
     "content_html": "to increase national prestige"
    },
    {
     "id": 1199240,
     "content_html": "to provide natural resources for the home country"
    }
   ],
