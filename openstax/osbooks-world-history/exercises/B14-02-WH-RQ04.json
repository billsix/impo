   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All  the following were causes of famine during China’s Great Leap Forward <i>except</i>",
   "answers": [
    {
     "id": 1199923,
     "content_html": "the use of farm labor to produce steel and work on construction projects"
    },
    {
     "id": 1199922,
     "content_html": "the requisitioning of grain to feed industrial workers and city dwellers"
    },
    {
     "id": 1199924,
     "content_html": "the destruction of crops during war"
    },
    {
     "id": 1199921,
     "content_html": "natural disasters like floods"
    }
