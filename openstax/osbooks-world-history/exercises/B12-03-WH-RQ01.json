   "stimulus_html": "",
   "stem_html": "What did the Smoot-Hawley Tariff Act do?",
   "answers": [
    {
     "id": 1199759,
     "content_html": "It decreased sales taxes on goods in the United States."
    },
    {
     "id": 1199758,
     "content_html": "It set up a fluctuating tariff system depending on the source of foreign goods."
    },
    {
     "id": 1199760,
     "content_html": "It raised tariffs on foreign goods in the United States and caused other countries to retaliate."
    },
    {
     "id": 1199757,
     "content_html": "It set quotas on foreign goods in the United States."
    }
   ],
