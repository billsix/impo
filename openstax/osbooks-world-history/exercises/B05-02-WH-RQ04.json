   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was a result of the Treaty of Tordesillas?",
   "answers": [
    {
     "id": 1199219,
     "content_html": "Spain was able to colonize the Philippines."
    },
    {
     "id": 1199220,
     "content_html": "Brazil became a Portuguese colony."
    },
    {
     "id": 1199218,
     "content_html": "The Portuguese were prohibited from trading in Africa."
    },
    {
     "id": 1199217,
     "content_html": "Spanish conquistadors could no longer be granted encomiendas."
    }
   ],
