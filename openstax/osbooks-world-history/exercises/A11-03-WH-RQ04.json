 "questions": [
  {
   "id": 624480,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was a defining feature of the earliest supporters of Ali, who became the Shia?",
   "answers": [
    {
     "id": 1198603,
     "content_html": "the refusal to recognize Muhammad as an Islamic prophet"
    },
    {
     "id": 1198604,
     "content_html": "the elevation of the family of Muhammad through his son in-law Ali"
    },
    {
     "id": 1198602,
     "content_html": "a belief in multiple gods that are subservient to the one God of Islam"
    },
    {
     "id": 1198601,
     "content_html": "the refusal to support the Abbasid family over the Umayyads in the Abbasid Revolution"
    }
   ],
