   "stem_html": "What happened to trade during the Great Depression?",
   "answers": [
    {
     "id": 1199763,
     "content_html": "Trade remained at its pre-Depression levels."
    },
    {
     "id": 1199762,
     "content_html": "Trade increased through the United States and Europe but fell elsewhere."
    },
    {
     "id": 1199764,
     "content_html": "Trade decreased across the globe."
    },
    {
     "id": 1199761,
     "content_html": "Trade decreased only in Europe but stayed stable elsewhere."
    }
