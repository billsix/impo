 "questions": [
  {
   "id": 624144,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why were small groups of humans better suited to survival in the Paleolithic Age?",
   "answers": [
    {
     "id": 1197972,
     "content_html": "It was hard to feed larger groups of people."
    },
    {
     "id": 1197971,
     "content_html": "Large groups were more likely to settle."
    },
    {
     "id": 1197970,
     "content_html": "Small groups created more sophisticated tools."
    },
    {
     "id": 1197969,
     "content_html": "Small groups tended to get along better than larger ones."
    }
   ],
