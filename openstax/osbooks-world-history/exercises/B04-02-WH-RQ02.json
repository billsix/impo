  {
   "id": 624794,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was an achievement of Sultan Suleiman’s reign?",
   "answers": [
    {
     "id": 1199159,
     "content_html": "the conquest of Constantinople and the destruction of the Byzantine Empire"
    },
    {
     "id": 1199158,
     "content_html": "the establishment of government-supported schools for children of all religions"
    },
    {
     "id": 1199157,
     "content_html": "the destruction of the Topkapi Palace"
    },
    {
     "id": 1199160,
     "content_html": "the creation of a unified legal code that applied to all parts of the empire"
    }
   ],
