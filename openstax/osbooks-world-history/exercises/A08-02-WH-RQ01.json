 "questions": [
  {
   "id": 624366,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does it mean to call Olmec civilization a “mother culture?”",
   "answers": [
    {
     "id": 1198380,
     "content_html": "Its expansion led to the creation of other similar cultures."
    },
    {
     "id": 1198379,
     "content_html": "It expanded from San Lorenzo to La Venta."
    },
    {
     "id": 1198378,
     "content_html": "It encouraged the production of stone heads in northern Mexico."
    },
    {
     "id": 1198377,
     "content_html": "It founded important Maya city-states."
    }
   ],
