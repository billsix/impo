   "stem_html": "How did Christianity initially reach the kingdom of Aksum?",
   "answers": [
    {
     "id": 1198536,
     "content_html": "It was brought by the Syrian teacher Frumentius."
    },
    {
     "id": 1198535,
     "content_html": "It was introduced by violent ascetic monks."
    },
    {
     "id": 1198534,
     "content_html": "It was practiced by an embassy from the Byzantine court."
    },
    {
     "id": 1198533,
     "content_html": "It was spread by Jewish people from Himyar."
    }
