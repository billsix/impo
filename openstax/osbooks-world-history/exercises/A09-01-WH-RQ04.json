   "stimulus_html": "",
   "stem_html": "For the San people of southern Africa, religion _____.",
   "answers": [
    {
     "id": 1198439,
     "content_html": "included elements of animism"
    },
    {
     "id": 1198440,
     "content_html": "was polytheistic and intimately bound up in the hunt for prey"
    },
    {
     "id": 1198438,
     "content_html": "was based on early Christian models"
    },
    {
     "id": 1198437,
     "content_html": "centered on ritualized foraging for plant buds and seasonal nuts"
    }
