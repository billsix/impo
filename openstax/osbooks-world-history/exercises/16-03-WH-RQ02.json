  {
   "id": 624644,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was true of the plague’s impact on the world of the fourteenth century?",
   "answers": [
    {
     "id": 1198907,
     "content_html": "It began to have a significant impact only when it reached Europe."
    },
    {
     "id": 1198906,
     "content_html": "China was the only region in the world the plague did not reach."
    },
    {
     "id": 1198908,
     "content_html": "The plague had a devastating impact on Europe, Asia, the Middle East, and North Africa."
    },
    {
     "id": 1198905,
     "content_html": "The disease originated in Australia, where it decimated the population before reaching China."
    }
