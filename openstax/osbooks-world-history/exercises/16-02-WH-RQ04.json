   "id": 624636,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What caused many fourteenth-century people to migrate from their homes in search of more hospitable conditions?",
   "answers": [
    {
     "id": 1198895,
     "content_html": "the low cost of travel in the medieval period"
    },
    {
     "id": 1198894,
     "content_html": "the widespread availability of horses and carts"
    },
    {
     "id": 1198893,
     "content_html": "an enormous growth in available wealth across the social hierarchy"
    },
    {
     "id": 1198896,
     "content_html": "worsening environmental conditions"
    }
