   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did the Truman Doctrine promise the United States would do?",
   "answers": [
    {
     "id": 1199896,
     "content_html": "assist countries whose governments were in danger of being overthrown by communist forces"
    },
    {
     "id": 1199895,
     "content_html": "work to eliminate the stockpiling of nuclear weapons"
    },
    {
     "id": 1199894,
     "content_html": "contribute funds to help Europe rebuild following World War II"
    },
    {
     "id": 1199893,
     "content_html": "destroy the Soviet Union"
    }
