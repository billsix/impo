 "questions": [
  {
   "id": 624766,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why didn’t the trading ports of the Swahili coast extend along the full length of the coast of Africa?",
   "answers": [
    {
     "id": 1199107,
     "content_html": "Hostile tribes in the south kept merchants from establishing cities."
    },
    {
     "id": 1199106,
     "content_html": "Tropical diseases in the south made it too dangerous for people to live there."
    },
    {
     "id": 1199105,
     "content_html": "The southern part of the coast had been colonized by the French."
    },
    {
     "id": 1199108,
     "content_html": "The seas there were too rough for the dhows and the monsoon winds too weak."
    }
   ],
