 "questions": [
  {
   "id": 624932,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the Bourbon Era, why did the creole elite adopt Enlightenment ideas?",
   "answers": [
    {
     "id": 1199399,
     "content_html": "those ideas helped them to effectively govern their colonies"
    },
    {
     "id": 1199400,
     "content_html": "those ideas justified their desire for more social and political authority"
    },
    {
     "id": 1199398,
     "content_html": "those ideas drew them closer to their English neighbors in British America"
    },
    {
     "id": 1199397,
     "content_html": "those ideas drew them closer to the Spanish nobility"
    }
   ],
