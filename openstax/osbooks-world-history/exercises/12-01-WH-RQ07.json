   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sumptuary laws enacted under the Tang emperor Gaozong were meant to achieve what purpose?",
   "answers": [
    {
     "id": 1198631,
     "content_html": "restrict the foods women could eat at the Tang Court"
    },
    {
     "id": 1198630,
     "content_html": "enshrine legal proscriptions on women scholars"
    },
    {
     "id": 1198632,
     "content_html": "tighten laws governing the types of clothes women could wear"
    },
    {
     "id": 1198629,
     "content_html": "censor the language used by female courtesans in the poetry they wrote"
    }
   ],
