 "questions": [
  {
   "id": 624986,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What caused the Fashoda Incident?",
   "answers": [
    {
     "id": 1199496,
     "content_html": "France and Britain each sought control of Sudan to connect their colonies by rail."
    },
    {
     "id": 1199495,
     "content_html": "Germany tried to seize some of Britain’s African colonies."
    },
    {
     "id": 1199494,
     "content_html": "Belgium and France both claimed the same territory in the Congo Basin."
    },
    {
     "id": 1199493,
     "content_html": "Egyptians revolted when Britain and France tried to depose their ruler."
    }
   ],
