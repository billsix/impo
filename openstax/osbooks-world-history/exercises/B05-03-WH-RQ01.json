  {
   "id": 624834,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was a key feature of mercantilist theory?",
   "answers": [
    {
     "id": 1199236,
     "content_html": "the measuring of a nation’s wealth in gold and silver"
    },
    {
     "id": 1199235,
     "content_html": "an emphasis on importing more goods than were exported"
    },
    {
     "id": 1199234,
     "content_html": "competition among businesses"
    },
    {
     "id": 1199233,
     "content_html": "a focus on free trade rather than tariffs"
    }
   ],
