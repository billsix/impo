  {
   "id": 625213,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the goal of members of the Non-Aligned Movement?",
   "answers": [
    {
     "id": 1199935,
     "content_html": "to become the industrial equals of the United States and the Soviet Union"
    },
    {
     "id": 1199936,
     "content_html": "to avoid becoming satellites of either the Western or the Eastern Bloc"
    },
    {
     "id": 1199934,
     "content_html": "to avoid becoming communist nations"
    },
    {
     "id": 1199933,
     "content_html": "to establish Western-style forms of democratic government"
    }
   ],
