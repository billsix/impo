 "questions": [
  {
   "id": 624653,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Following the Black Death, the decline of feudalism in western Europe was hastened by what factor?",
   "answers": [
    {
     "id": 1198923,
     "content_html": "Nobles became so wealthy that they no longer relied on peasant labor."
    },
    {
     "id": 1198922,
     "content_html": "The Christian Church abolished the practice of servitude."
    },
    {
     "id": 1198921,
     "content_html": "Monarchs began to appropriate feudal lands for the construction of plague hospitals."
    },
    {
     "id": 1198924,
     "content_html": "Many peasants left rural areas in search of employment in towns and cities."
    }
   ],
