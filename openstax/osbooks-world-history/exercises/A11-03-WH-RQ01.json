 "questions": [
  {
   "id": 624477,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the Muslims create Baghdad as a new capital city?",
   "answers": [
    {
     "id": 1198591,
     "content_html": "No other cities were hospitable to the Arabs, so they needed to build their own."
    },
    {
     "id": 1198590,
     "content_html": "The Abbasids wanted to return the capital of their empire to Arabia."
    },
    {
     "id": 1198589,
     "content_html": "The Byzantines recaptured the old capital city of Damascus."
    },
    {
     "id": 1198592,
     "content_html": "The center of the Islamic world was shifting eastward after the Abbasid Revolution."
    }
   ],
