 "questions": [
  {
   "id": 624969,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did independence affect the economies of Latin American nations?",
   "answers": [
    {
     "id": 1199460,
     "content_html": "It opened their markets to competitive U.S. and European manufactured goods."
    },
    {
     "id": 1199459,
     "content_html": "It reduced the number of wealthy government officials who could afford to purchase luxury goods."
    },
    {
     "id": 1199458,
     "content_html": "It caused European engineers and other skilled workers to return home."
    },
    {
     "id": 1199457,
     "content_html": "It eliminated Spanish and Portuguese subsidies for the development of roads and harbors."
    }
   ],
