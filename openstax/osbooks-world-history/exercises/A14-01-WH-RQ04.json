 "questions": [
  {
   "id": 624563,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Temujin change traditional seminomadic practices for dealing with men captured from the clans or tribes he defeated?",
   "answers": [
    {
     "id": 1198755,
     "content_html": "He ordered all captured enemies killed, sparing no one regardless of class."
    },
    {
     "id": 1198754,
     "content_html": "He ordered all captives enslaved."
    },
    {
     "id": 1198753,
     "content_html": "He ordered commoners killed but spared the leadership of his defeated rivals."
    },
    {
     "id": 1198756,
     "content_html": "He tried and executed the leaders but spared the commoners, even allowing them to join his army."
    }
   ],
