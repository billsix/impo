   "stem_html": "According to Muslim belief, which of the following statements is true?",
   "answers": [
    {
     "id": 1198563,
     "content_html": "Muhammad was the first in a long line of monotheistic prophets."
    },
    {
     "id": 1198562,
     "content_html": "Moses, Jesus, and Muhammad were the same person."
    },
    {
     "id": 1198564,
     "content_html": "Muslims worship the same God as Jewish people and Christians."
    },
    {
     "id": 1198561,
     "content_html": "Islam is a polytheistic faith."
