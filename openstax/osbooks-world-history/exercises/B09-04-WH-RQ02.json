   "stem_html": "What  was the <i>Force Publique</i>?",
   "answers": [
    {
     "id": 1199516,
     "content_html": "an Indigenous army used to discipline Congolese laborers"
    },
    {
     "id": 1199515,
     "content_html": "the Egyptian army that fought to take control of Sudan"
    },
    {
     "id": 1199514,
     "content_html": "a health-care organization in France’s African and Asian colonies"
    },
    {
     "id": 1199513,
     "content_html": "a court for trying French citizens accused of abusing natives of French West Africa"
    }
