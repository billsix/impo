 "questions": [
  {
   "id": 624551,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was the Byzantine emperor unhappy with the development of Outremer?",
   "answers": [
    {
     "id": 1198731,
     "content_html": "The emperor had controlled Jerusalem, and the crusaders took it from him."
    },
    {
     "id": 1198730,
     "content_html": "The emperor was Muslim and believed Jerusalem should stay under Muslim control."
    },
    {
     "id": 1198732,
     "content_html": "The emperor expected the crusaders to return to him the territory they conquered."
    },
    {
     "id": 1198729,
     "content_html": "The emperor did not approve of mixing religion and warfare."
    }
   ],
