  {
   "id": 624989,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the purpose of the 1884–1885 Berlin Conference?",
   "answers": [
    {
     "id": 1199507,
     "content_html": "to punish France for its brutality toward West Africans"
    },
    {
     "id": 1199508,
     "content_html": "to decide which European countries possessed different parts of Africa"
    },
    {
     "id": 1199506,
     "content_html": "to conclude a peace treaty between Italy and Ethiopia"
    },
    {
     "id": 1199505,
     "content_html": "to carve out the industrialized nations’ spheres of influence in China"
    }
   ],
