   "id": 624823,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did other European nations respond to the Treaty of Tordesillas between Spain and Portugal?",
   "answers": [
    {
     "id": 1199224,
     "content_html": "They ignored the treaty."
    },
    {
     "id": 1199223,
     "content_html": "They requested the pope grant them territory as well."
    },
    {
     "id": 1199222,
     "content_html": "They declared war on Spain and Portugal."
    },
    {
     "id": 1199221,
     "content_html": "They abandoned their efforts to explore and colonize the Americas."
    }
