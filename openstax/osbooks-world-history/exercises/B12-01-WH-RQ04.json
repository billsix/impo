  {
   "id": 625105,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did the Kellogg-Briand Pact do?",
   "answers": [
    {
     "id": 1199740,
     "content_html": "It outlawed war as an instrument of foreign policy."
    },
    {
     "id": 1199739,
     "content_html": "It established a French-American alliance for the next five decades."
    },
    {
     "id": 1199738,
     "content_html": "It called for Germany to be blamed for World War I."
    },
    {
     "id": 1199737,
     "content_html": "It set up loans to Latin American countries to cope with economic recessions."
    }
   ],
