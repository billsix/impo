 "questions": [
  {
   "id": 624795,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What best describes scientific and technological study under the Ottomans?",
   "answers": [
    {
     "id": 1199164,
     "content_html": "Ottoman scientists considered scientific study a form of religious devotion and conducted research in a variety of areas, especially medicine and astronomy."
    },
    {
     "id": 1199163,
     "content_html": "Science was strictly controlled by religious authorities, who could suppress discoveries that contradicted religious doctrine."
    },
    {
     "id": 1199162,
     "content_html": "Scientific research was restricted to Muslims; bright students who were members of a millet had to convert to Islam to participate."
    },
    {
     "id": 1199161,
     "content_html": "Ottoman military technology got better over time, but weaponry became heavier and required new methods of transportation."
    }
   ],
