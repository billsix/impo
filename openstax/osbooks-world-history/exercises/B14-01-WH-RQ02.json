  {
   "id": 625194,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What best describes the primary goal of U.S. foreign policy at the beginning of the Cold War?",
   "answers": [
    {
     "id": 1199899,
     "content_html": "maintain an isolationist position and ignore what was happening in the rest of the world"
    },
    {
     "id": 1199898,
     "content_html": "continue to work with the United Kingdom and the Soviet Union to maintain world peace"
    },
    {
     "id": 1199900,
     "content_html": "prevent the Soviet Union from spreading communism outside Eastern Europe"
    },
    {
     "id": 1199897,
     "content_html": "assist European colonies in Asia and Africa to gain their independence"
    }
   ],
