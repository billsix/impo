 "questions": [
  {
   "id": 624543,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did Pope Urban call for the First Crusade while in France and not in Rome?",
   "answers": [
    {
     "id": 1198715,
     "content_html": "France had more Christians than Italy."
    },
    {
     "id": 1198716,
     "content_html": "Rome was occupied by a rival pope supported by the German emperor."
    },
    {
     "id": 1198714,
     "content_html": "France had better systems of communication than Rome."
    },
    {
     "id": 1198713,
     "content_html": "Rome had a significant Muslim population, and the pope did not want them harmed."
    }
   ],
