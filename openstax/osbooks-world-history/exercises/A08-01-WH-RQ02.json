   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What activity best characterizes the Clovis people?",
   "answers": [
    {
     "id": 1198359,
     "content_html": "They were settled agriculturalists."
    },
    {
     "id": 1198358,
     "content_html": "They lived on the salmon abundant in the areas where they lived."
    },
    {
     "id": 1198360,
     "content_html": "They were mobile big-game hunters."
    },
    {
     "id": 1198357,
     "content_html": "They were prolific mound builders."
    }
