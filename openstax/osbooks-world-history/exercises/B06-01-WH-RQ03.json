 "questions": [
  {
   "id": 624855,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is the city once known as New Amsterdam now known as New York?",
   "answers": [
    {
     "id": 1199271,
     "content_html": "Residents of the city voted to rename it in honor of the Duke of York."
    },
    {
     "id": 1199270,
     "content_html": "City leaders changed the name after the Earl of York invested in the city."
    },
    {
     "id": 1199269,
     "content_html": "The Catholic Church modified the name on maps in honor of Saint York."
    },
    {
     "id": 1199272,
     "content_html": "The English renamed the city after they captured it from the Dutch."
    }
   ],
