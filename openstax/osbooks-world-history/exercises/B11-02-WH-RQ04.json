 "questions": [
  {
   "id": 625070,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the United States initially stay neutral in the war?",
   "answers": [
    {
     "id": 1199671,
     "content_html": "The United States did not want to fight either France or Germany, its long-standing allies."
    },
    {
     "id": 1199672,
     "content_html": "The United States had historically stayed out of European affairs."
    },
    {
     "id": 1199670,
     "content_html": "The United States had agreed to follow Canada’s lead and stay out of the war."
    },
    {
     "id": 1199669,
     "content_html": "The United States hoped the war would be quick and it could take over European colonies in the Caribbean when the war ended."
    }
   ],
