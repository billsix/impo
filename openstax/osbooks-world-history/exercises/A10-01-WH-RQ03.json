   "stimulus_html": "",
   "stem_html": "What role did bishops play in Roman governance?",
   "answers": [
    {
     "id": 1198511,
     "content_html": "They served in the Roman military."
    },
    {
     "id": 1198510,
     "content_html": "They instituted monetary reforms in periods of crisis."
    },
    {
     "id": 1198512,
     "content_html": "They participated in ecumenical councils and dominated local politics."
    },
    {
     "id": 1198509,
     "content_html": "They collaborated with pagans in public education."
    }
