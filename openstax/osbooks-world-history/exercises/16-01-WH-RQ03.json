 "questions": [
  {
   "id": 624622,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Mongol leaders of the Il-Khanate become less distinct from their Muslim subjects in the fourteenth century?",
   "answers": [
    {
     "id": 1198864,
     "content_html": "They intermarried with their subjects."
    },
    {
     "id": 1198863,
     "content_html": "They required their subjects to adopt traditional Mongol shamanistic beliefs."
    },
    {
     "id": 1198862,
     "content_html": "They chose to live in the same neighborhoods as the peasants."
    },
    {
     "id": 1198861,
     "content_html": "They replaced all languages and traditions in their realm with newly developed ones."
    }
   ],
