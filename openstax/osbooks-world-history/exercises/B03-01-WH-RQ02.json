 "questions": [
  {
   "id": 624752,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the widespread adoption of Islam help facilitate trans-Saharan trade?",
   "answers": [
    {
     "id": 1199084,
     "content_html": "by giving Muslim merchants, traders, and caravanners a shared set of customs, laws, traditions, and language"
    },
    {
     "id": 1199083,
     "content_html": "by making the caravan trade the exclusive vocation of Tuareg Berber nomads"
    },
    {
     "id": 1199082,
     "content_html": "by opening the markets of the pilgrimage route between Niani and Kilwa"
    },
    {
     "id": 1199081,
     "content_html": "by causing conflict between dissident Muslim groups, thereby opening competing markets for new manufactured goods"
    }
   ],
