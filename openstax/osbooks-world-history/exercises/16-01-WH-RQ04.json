 "questions": [
  {
   "id": 624623,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the Golden Bull clarify the process of selecting a new Holy Roman emperor?",
   "answers": [
    {
     "id": 1198867,
     "content_html": "It declared that Holy Roman emperors would be selected by hereditary succession."
    },
    {
     "id": 1198866,
     "content_html": "It declared that only popes would be eligible to serve as Holy Roman emperors."
    },
    {
     "id": 1198865,
     "content_html": "It declared that the Holy Roman emperors would be required to reside in Rome."
    },
    {
     "id": 1198868,
     "content_html": "It declared that seven princes known as electors would select the Holy Roman emperor."
    }
   ],
