   "id": 624637,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the primary factor that made travel in the fourteenth century far more difficult than today?",
   "answers": [
    {
     "id": 1198899,
     "content_html": "a lack of interest in leaving the homeland"
    },
    {
     "id": 1198900,
     "content_html": "the high cost and limited modes of transportation"
    },
    {
     "id": 1198898,
     "content_html": "the difficulty of traveling with children"
    },
    {
     "id": 1198897,
     "content_html": "the need to first obtain permission from the king or emperor"
    }
