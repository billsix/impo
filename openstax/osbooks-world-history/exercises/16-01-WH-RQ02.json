 "questions": [
  {
   "id": 624621,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Following the conversion of the Il-Khanate ruler Ghazan to Islam in 1295, what occurred in the Il-Khanate?",
   "answers": [
    {
     "id": 1198859,
     "content_html": "Intermarriage between Muslims and non-Muslims became illegal."
    },
    {
     "id": 1198858,
     "content_html": "Muslim subjects were required to adopt the nomadic lifestyle of the Mongols."
    },
    {
     "id": 1198857,
     "content_html": "Il-Khanate rulers embraced Islamic culture and civilization."
    },
    {
     "id": 1198860,
     "content_html": "Buddhism became the most widely practiced and embraced religion in the Il-Khanate."
    }
   ],
