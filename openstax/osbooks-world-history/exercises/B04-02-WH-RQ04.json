 "questions": [
  {
   "id": 624796,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following accurately describes the Sultanate of Women?",
   "answers": [
    {
     "id": 1199167,
     "content_html": "Sultan Suleiman I decided to appoint a woman as his successor in order to confound and confuse his rivals, the Habsburg and the Safavids."
    },
    {
     "id": 1199168,
     "content_html": "Women, usually the wives or mothers of the reigning sultan, were now able to exert considerable influence at court."
    },
    {
     "id": 1199166,
     "content_html": "A matriarchal queendom was established in eastern Anatolia to exert military and social pressure on the Caucasus and Safavid Iran."
    },
    {
     "id": 1199165,
     "content_html": "Most of the businesses and major institutions in the Grand Bazaar were owned by women, and they achieved political influence as a result."
    }
   ],
