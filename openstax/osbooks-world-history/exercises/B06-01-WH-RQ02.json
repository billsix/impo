  {
   "id": 624854,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After their initial founding, how did colonies in the Americas typically relate to their home countries?",
   "answers": [
    {
     "id": 1199268,
     "content_html": "Colonies relied on their home countries for supplies and economic support."
    },
    {
     "id": 1199267,
     "content_html": "Colonies became totally independent."
    },
    {
     "id": 1199266,
     "content_html": "Colonies joined rival empires."
    },
    {
     "id": 1199265,
     "content_html": "Colonies ignored their home countries."
    }
