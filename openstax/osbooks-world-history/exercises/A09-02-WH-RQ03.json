   "stem_html": "How was ironworking technology likely disseminated throughout sub-Saharan Africa?",
   "answers": [
    {
     "id": 1198451,
     "content_html": "It was introduced by Egyptian traders."
    },
    {
     "id": 1198450,
     "content_html": "It was introduced by Nilo-Saharan farmers."
    },
    {
     "id": 1198449,
     "content_html": "It was introduced by Near Eastern conquerors."
    },
    {
     "id": 1198452,
     "content_html": "It was introduced by migrating Bantus."
    }
