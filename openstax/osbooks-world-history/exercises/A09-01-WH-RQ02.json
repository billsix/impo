   "stem_html": "What is a key characteristic of Africa’s Mediterranean climate?",
   "answers": [
    {
     "id": 1198431,
     "content_html": "It is very similar to the climate of the Sahel."
    },
    {
     "id": 1198430,
     "content_html": "It is arid and known for its sandy soils."
    },
    {
     "id": 1198429,
     "content_html": "It is tropical."
    },
    {
     "id": 1198432,
     "content_html": "It is sunny and well suited for farming."
