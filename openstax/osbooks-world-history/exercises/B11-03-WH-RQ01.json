   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why  did Germany sink the RMS <i>Lusitania</i>?",
   "answers": [
    {
     "id": 1199675,
     "content_html": "because it had a large number of British passengers"
    },
    {
     "id": 1199674,
     "content_html": "because it was transporting troops bound for Europe"
    },
    {
     "id": 1199676,
     "content_html": "because it carried ammunition bound for the British army"
    },
    {
     "id": 1199673,
     "content_html": "because it was heavily armed and sailing through the war zone to France"
    }
