   "stimulus_html": "",
   "stem_html": "What is chattel slavery?",
   "answers": [
    {
     "id": 1199251,
     "content_html": "a form of slavery that results from indebtedness"
    },
    {
     "id": 1199252,
     "content_html": "a form of slavery in which enslaved people are treated as pieces of property"
    },
    {
     "id": 1199250,
     "content_html": "a form of slavery in which children do not inherit the status of enslaved parents"
    },
    {
     "id": 1199249,
     "content_html": "a form of slavery in which those enslaved are captured as a result of armed conflict"
    }
