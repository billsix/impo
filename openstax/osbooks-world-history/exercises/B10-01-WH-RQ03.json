 "questions": [
  {
   "id": 625005,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  was an important result of electrifying the workplace?",
   "answers": [
    {
     "id": 1199531,
     "content_html": "It made jobs more dangerous by exposing workers to electrical currents."
    },
    {
     "id": 1199532,
     "content_html": "It enabled factories to stay open later and people to work at night."
    },
    {
     "id": 1199530,
     "content_html": "It provided better heating in the winter."
    },
    {
     "id": 1199529,
     "content_html": "It reduced the strength needed to perform certain tasks, creating more jobs for children."
    }
   ],
