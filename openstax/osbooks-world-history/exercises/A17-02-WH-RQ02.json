 "questions": [
  {
   "id": 624677,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What effect did the Battle of Ankara have on the Janissary system?",
   "answers": [
    {
     "id": 1198967,
     "content_html": "It revealed the potential disloyalty of Janissary forces, leading to the demise of the system."
    },
    {
     "id": 1198966,
     "content_html": "It led the sultans to turn to Egypt as a source of new Janissary recruits."
    },
    {
     "id": 1198968,
     "content_html": "It demonstrated the danger of relying on the Turkish nobility for defense, thus encouraging the development of the Janissary system."
    },
    {
     "id": 1198965,
     "content_html": "It forced the Ottomans to rebuild their Janissary corps because so many were killed."
    }
   ],
