 "questions": [
  {
   "id": 624978,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did colonization in the second half of the nineteenth century differ from colonization in previous centuries?",
   "answers": [
    {
     "id": 1199479,
     "content_html": "Nineteenth-century colonialism was inspired primarily by religious not economic motives."
    },
    {
     "id": 1199478,
     "content_html": "Nineteenth-century colonialism generated very little violence."
    },
    {
     "id": 1199480,
     "content_html": "Nineteenth-century colonies were not usually intended to be settler colonies."
    },
    {
     "id": 1199477,
     "content_html": "Nineteenth-century colonies were largely left to govern themselves with little interference."
    }
   ],
