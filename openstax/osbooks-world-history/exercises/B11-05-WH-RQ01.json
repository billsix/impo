 "questions": [
  {
   "id": 625094,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the tsarist government react to the events of Bloody Sunday?",
   "answers": [
    {
     "id": 1199711,
     "content_html": "The tsar began holding regular meetings with the workers in St. Petersburg."
    },
    {
     "id": 1199710,
     "content_html": "The tsar began an oppressive crackdown and imposed martial law on the city."
    },
    {
     "id": 1199712,
     "content_html": "The tsar agreed to the creation of a legislature, the Duma, that included elected politicians."
    },
    {
     "id": 1199709,
     "content_html": "The tsar declared war against Germany for the shootings of Russian people."
    }
   ],
