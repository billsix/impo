   "stem_html": "Who was Mansa Musa?",
   "answers": [
    {
     "id": 1198827,
     "content_html": "a Christian ruler of the Swahili coast who traveled to China"
    },
    {
     "id": 1198826,
     "content_html": "a Muslim ruler of the Ghana Empire who followed the trans-Saharan trade route to Egypt"
    },
    {
     "id": 1198825,
     "content_html": "a pagan tribal chief who led a revolt against Islamized Africans in West Africa"
    },
    {
     "id": 1198828,
     "content_html": "a Muslim ruler of the Mali Empire who made a pilgrimage to Mecca in the fourteenth century"
    }
