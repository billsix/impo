 "questions": [
  {
   "id": 625087,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the “shell crisis” in Britain?",
   "answers": [
    {
     "id": 1199699,
     "content_html": "the public’s outrage over the closure of munitions factories"
    },
    {
     "id": 1199700,
     "content_html": "the political crisis over whether enough shells were being produced for the war effort"
    },
    {
     "id": 1199698,
     "content_html": "the problem of artillery shells that exploded during loading, causing the deaths of thousands of troops on the western front"
    },
    {
     "id": 1199697,
     "content_html": "the problems caused by Russia’s lack of military supplies for its armies"
    }
   ],
