 "questions": [
  {
   "id": 624901,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What obstacle or obstacles made it difficult for those at the lower end of the socioeconomic ladder to actively participate in the print culture of the Enlightenment?",
   "answers": [
    {
     "id": 1199347,
     "content_html": "lack of interest"
    },
    {
     "id": 1199348,
     "content_html": "low levels of literacy and a lack of leisure time"
    },
    {
     "id": 1199346,
     "content_html": "a widespread shortage of books and other printed materials"
    },
    {
     "id": 1199345,
     "content_html": "royal edicts restricting the practice of reading to all but a small aristocratic elite"
    }
   ],
