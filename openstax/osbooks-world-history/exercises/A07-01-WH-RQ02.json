  {
   "id": 624321,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the toga <i>virilis</i>?",
   "answers": [
    {
     "id": 1198299,
     "content_html": "a garment worn by senators who had recently come into office"
    },
    {
     "id": 1198298,
     "content_html": "a veil worn by girls during their wedding ceremony"
    },
    {
     "id": 1198300,
     "content_html": "a garment worn by boys to mark the transition into manhood and citizenship"
    },
    {
     "id": 1198297,
     "content_html": "a shawl worn at funeral processions to honor the dead"
    }
   ],
