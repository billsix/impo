   "id": 624943,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was one characteristic of the Hidalgo revolt in Mexico?",
   "answers": [
    {
     "id": 1199419,
     "content_html": "the strong support of conservative creole leaders"
    },
    {
     "id": 1199418,
     "content_html": "Hidalgo’s immediate proclamation of independence"
    },
    {
     "id": 1199420,
     "content_html": "the large-scale participation of the Indigenous and mixed-race labor force"
    },
    {
     "id": 1199417,
     "content_html": "the support of the church hierarchy"
    }
   ],
