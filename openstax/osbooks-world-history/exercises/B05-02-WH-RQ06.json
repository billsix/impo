 "questions": [
  {
   "id": 624824,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why were animal-borne infectious diseases more deadly for Indigenous peoples in the Americas than for Europeans?",
   "answers": [
    {
     "id": 1199227,
     "content_html": "The Indigenous peoples led a nomadic lifestyle so they could not rest when they fell ill."
    },
    {
     "id": 1199226,
     "content_html": "A genetic mutation made Indigenous peoples more susceptible to bacterial infections."
    },
    {
     "id": 1199225,
     "content_html": "Indigenous peoples had no experience treating illnesses of any kind."
    },
    {
     "id": 1199228,
     "content_html": "Indigenous peoples had never been exposed to the infectious diseases originating in European domesticated animals."
    }
   ],
