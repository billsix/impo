 "questions": [
  {
   "id": 624337,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was proximity to a seaport important to Roman trade?",
   "answers": [
    {
     "id": 1198328,
     "content_html": "Shipping by sea was less expensive than by land."
    },
    {
     "id": 1198327,
     "content_html": "No road network existed outside Italy."
    },
    {
     "id": 1198326,
     "content_html": "Shipowners had a monopoly on the entire trade network."
    },
    {
     "id": 1198325,
     "content_html": "Romans were interested only in luxury goods from overseas."
    }
   ],
