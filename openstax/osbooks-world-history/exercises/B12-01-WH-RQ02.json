 "questions": [
  {
   "id": 625103,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the U.S. Senate oppose the Treaty of Versailles?",
   "answers": [
    {
     "id": 1199731,
     "content_html": "It was too long a document."
    },
    {
     "id": 1199730,
     "content_html": "The new borders drawn in Europe were believed to be unworkable."
    },
    {
     "id": 1199732,
     "content_html": "The Senate did not want to join the League of Nations, which was established by the treaty."
    },
    {
     "id": 1199729,
     "content_html": "The treaty was dangerous and could cause another war in Europe."
    }
   ],
