 "questions": [
  {
   "id": 624679,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the Mamluk sultans usually treat rebellious Syrian Arabs more leniently than they did rebellious Arab Bedouins in Egypt?",
   "answers": [
    {
     "id": 1198975,
     "content_html": "The Syrian Arabs were protected by the caliph."
    },
    {
     "id": 1198976,
     "content_html": "The Mamluks needed the assistance of Syrian Arabs in fighting the Ottomans and the Mongols."
    },
    {
     "id": 1198974,
     "content_html": "The Bedouins were a greater threat to the lives and property of Egyptians."
    },
    {
     "id": 1198973,
     "content_html": "The leaders of the Syrian Arabs had once been mamluks themselves."
    }
   ],
