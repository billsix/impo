 "questions": [
  {
   "id": 624856,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What explains the relatively harmonious relationship between French colonists and the Indigenous peoples of Canada?",
   "answers": [
    {
     "id": 1199276,
     "content_html": "The French could not afford to anger Indigenous peoples who assisted them in acquiring furs."
    },
    {
     "id": 1199275,
     "content_html": "The French found the Indigenous people of Canada eager to convert to Christianity."
    },
    {
     "id": 1199274,
     "content_html": "The French had little contact with Indigenous peoples and remained within their own settlements."
    },
    {
     "id": 1199273,
     "content_html": "Most of the Indigenous peoples of Canada died as a result of smallpox, so they were easily dominated by the French."
    }
   ],
