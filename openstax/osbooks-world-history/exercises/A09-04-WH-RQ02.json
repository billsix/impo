   "stimulus_html": "",
   "stem_html": "How did the Ptolemaic rulers of Egypt seek to legitimate their rule?",
   "answers": [
    {
     "id": 1198491,
     "content_html": "by enslaving all Egyptians"
    },
    {
     "id": 1198492,
     "content_html": "by adopting Egyptian religious practice and styling themselves as pharaohs"
    },
    {
     "id": 1198490,
     "content_html": "by employing Egyptians in high-level administrative positions"
    },
    {
     "id": 1198489,
     "content_html": "by learning to speak Egyptian"
    }
