 "questions": [
  {
   "id": 624804,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What best describes the way the Safavid shahs dealt with groups competing for political power and influence at court?",
   "answers": [
    {
     "id": 1199183,
     "content_html": "They awarded positions based on hereditary descent from the previous job holder."
    },
    {
     "id": 1199182,
     "content_html": "They gave control of the military to the Qizilbash and served only in an advisory capacity."
    },
    {
     "id": 1199184,
     "content_html": "They enslaved men from the Caucasus and employed them as soldiers to temper the power of the Qizilbash."
    },
    {
     "id": 1199181,
     "content_html": "They heavily preferred ethnic Persians in administrative positions."
    }
   ],
