   "stimulus_html": "",
   "stem_html": "What happened to the Judeans when they were attacked by the Neo-Babylonians in the early sixth century BCE?",
   "answers": [
    {
     "id": 1198120,
     "content_html": "They were deported to Babylon."
    },
    {
     "id": 1198119,
     "content_html": "They fled to Egypt."
    },
    {
     "id": 1198118,
     "content_html": "They became Phoenicians."
    },
    {
     "id": 1198117,
     "content_html": "They became allies of Persia."
    }
