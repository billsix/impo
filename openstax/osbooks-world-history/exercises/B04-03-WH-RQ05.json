 "questions": [
  {
   "id": 624805,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did Abbas relocate his capital to Isfahan?",
   "answers": [
    {
     "id": 1199187,
     "content_html": "It was close to trade outposts on the Mediterranean coast."
    },
    {
     "id": 1199188,
     "content_html": "It was far from the war front with the Ottomans."
    },
    {
     "id": 1199186,
     "content_html": "It was near the migratory paths of the game birds Abbas liked to hunt."
    },
    {
     "id": 1199185,
     "content_html": "It was ideally situated between two major rivers."
    }
   ],
