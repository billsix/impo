 "questions": [
  {
   "id": 624751,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was the camel important to trans-Saharan trade?",
   "answers": [
    {
     "id": 1199079,
     "content_html": "Its obstinate nature makes it hard for handlers to control."
    },
    {
     "id": 1199078,
     "content_html": "It produces a fine wool that can be spun into luxurious textiles."
    },
    {
     "id": 1199077,
     "content_html": "Its milk is used to produce cheese, an important source of protein."
    },
    {
     "id": 1199080,
     "content_html": "Its biological advantages made regular long-distance trade in the Sahara possible."
    }
   ],
