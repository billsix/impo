 "questions": [
  {
   "id": 624133,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  was one of the consequences of the digestive organs moving lower and into a smaller space when members of the <i>Homo</i> genus began walking upright?",
   "answers": [
    {
     "id": 1197951,
     "content_html": "It led them to build shelters."
    },
    {
     "id": 1197952,
     "content_html": "It led them to adopt foods that were easier to digest."
    },
    {
     "id": 1197950,
     "content_html": "It led them to seek protection in trees."
    },
    {
     "id": 1197949,
     "content_html": "It led them to migrate to warmer environments."
    }
   ],
