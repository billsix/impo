  {
   "id": 624739,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "For  what reason did China go to war with Japan in the sixteenth century?",
   "answers": [
    {
     "id": 1199068,
     "content_html": "Japan invaded China’s vassal state of Korea."
    },
    {
     "id": 1199067,
     "content_html": "Japan refused to stop Japanese pirates from raiding the coast of China."
    },
    {
     "id": 1199066,
     "content_html": "Japan invaded Taiwan, which was claimed by China."
    },
    {
     "id": 1199065,
     "content_html": "Japan allied with the Portuguese in their plans to interfere with China’s trade with Spain."
    }
   ],
