  {
   "id": 624911,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was a key difference between the Haitian Revolution and those in British North America and France?",
   "answers": [
    {
     "id": 1199364,
     "content_html": "The Haitian Revolution directly addressed racial inequality."
    },
    {
     "id": 1199363,
     "content_html": "Haiti did not issue a written constitution."
    },
    {
     "id": 1199362,
     "content_html": "The Haitian Revolution was fought by foreign mercenaries."
    },
    {
     "id": 1199361,
     "content_html": "Only Haiti experienced violent battles during its revolution."
    }
   ],
