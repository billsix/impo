   "stimulus_html": "",
   "stem_html": "Why did early trans-Saharan traders move salt across the desert into sub-Saharan Africa?",
   "answers": [
    {
     "id": 1198499,
     "content_html": "Salt was used to mine gold."
    },
    {
     "id": 1198498,
     "content_html": "Salt was heavily taxed by the Romans."
    },
    {
     "id": 1198500,
     "content_html": "Salt was necessary and scarce in the region."
    },
    {
     "id": 1198497,
     "content_html": "Salt was prized for its religious properties."
    }
