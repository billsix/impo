 "questions": [
  {
   "id": 624663,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did invasion by Timur influence the development of the Ottoman state?",
   "answers": [
    {
     "id": 1198947,
     "content_html": "The death of all Bayezid I’s sons at the Battle of Ankara left the Ottoman state without a ruler."
    },
    {
     "id": 1198946,
     "content_html": "Timur’s invasion encouraged the Ottomans’ vassals to rally to their aid, strengthening the Ottoman state."
    },
    {
     "id": 1198948,
     "content_html": "Timur’s invasion and the defeat of Bayezid I encouraged Turkish vassals to break away from Ottoman rule."
    },
    {
     "id": 1198945,
     "content_html": "The need to rebuild the Ottoman military resulted in higher taxes for Ottoman subjects and subsequent revolts."
    }
   ],
