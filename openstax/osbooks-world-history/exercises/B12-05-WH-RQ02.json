 "questions": [
  {
   "id": 625139,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was different about Mao Zedong’s view on Marxism and communism?",
   "answers": [
    {
     "id": 1199799,
     "content_html": "Mao believed communism had already arrived in many countries in the 1800s."
    },
    {
     "id": 1199798,
     "content_html": "Mao believed it was not possible for China to become a communist country."
    },
    {
     "id": 1199800,
     "content_html": "Mao viewed peasants as the workers and landlords as the capitalists."
    },
    {
     "id": 1199797,
     "content_html": "Mao believed revolution in China could happen only if it came from outside."
    }
   ],
