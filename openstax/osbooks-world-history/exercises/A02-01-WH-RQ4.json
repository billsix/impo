   "stem_html": "How  did migrating modern humans reach Australia?",
   "answers": [
    {
     "id": 1197959,
     "content_html": "They walked on exposed land."
    },
    {
     "id": 1197958,
     "content_html": "They walked over frozen ice sheets."
    },
    {
     "id": 1197960,
     "content_html": "They took rafts over open water."
    },
    {
     "id": 1197957,
     "content_html": "They built crude bridges between islands."
    }
