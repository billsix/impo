 "questions": [
  {
   "id": 625026,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  was the <i>katorga</i> system?",
   "answers": [
    {
     "id": 1199576,
     "content_html": "a form of penal servitude in which criminals were sent to labor camps in Siberia"
    },
    {
     "id": 1199575,
     "content_html": "a form of debt bondage used in Brazil"
    },
    {
     "id": 1199574,
     "content_html": "a British system of contracting for passage to another country in exchange for labor"
    },
    {
     "id": 1199573,
     "content_html": "the practice in French brothels of charging prostitutes for food and clothing so they always remained in debt"
    }
   ],
