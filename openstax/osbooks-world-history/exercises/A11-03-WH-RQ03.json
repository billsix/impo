 "questions": [
  {
   "id": 624479,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did the process of Islamization look like during the early Abbasid period?",
   "answers": [
    {
     "id": 1198600,
     "content_html": "Christians adopted the Arabic language and Islamic forms of dress while not necessarily converting to Islam."
    },
    {
     "id": 1198599,
     "content_html": "The entire Indigenous population of the Middle East and North Africa converted to Islam."
    },
    {
     "id": 1198598,
     "content_html": "People feared Muslims and the Muslim faith more generally."
    },
    {
     "id": 1198597,
     "content_html": "Arab-Muslims refused to allow any non-Arabs to convert to Islam."
    }
   ],
