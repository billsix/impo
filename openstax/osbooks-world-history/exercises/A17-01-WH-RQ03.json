 "questions": [
  {
   "id": 624664,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Europeans respond to the Ottomans’ taking control of trade in the eastern Mediterranean and along the Silk Roads?",
   "answers": [
    {
     "id": 1198951,
     "content_html": "The nations of western Europe launched a Crusade to retake control of the trade routes from the Ottomans."
    },
    {
     "id": 1198950,
     "content_html": "Venetian and Genoese traders welcomed Ottoman control because the Ottoman army protected the trade routes and made them safer."
    },
    {
     "id": 1198952,
     "content_html": "Europeans began to seek an all-water, oceanic route to South and East Asia."
    },
    {
     "id": 1198949,
     "content_html": "European merchants objected to paying taxes to the Ottomans and created overland routes to India and East Asia that bypassed Ottoman-controlled lands."
    }
   ],
