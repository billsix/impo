 "questions": [
  {
   "id": 624836,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did mercantilist policies hurt the working class?",
   "answers": [
    {
     "id": 1199243,
     "content_html": "The desire to extract profits from colonies led to the abuse of working-class settlers."
    },
    {
     "id": 1199244,
     "content_html": "Mercantilism advocated keeping wages low."
    },
    {
     "id": 1199242,
     "content_html": "The building up of surpluses of gold and silver led to inflation."
    },
    {
     "id": 1199241,
     "content_html": "Mercantilist policies often led to wars, which had to be fought by working-class soldiers."
    }
   ],
