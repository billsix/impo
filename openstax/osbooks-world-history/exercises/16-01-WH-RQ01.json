 "questions": [
  {
   "id": 624620,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was unique about the Yuan dynasty in Chinese history?",
   "answers": [
    {
     "id": 1198856,
     "content_html": "The entire Chinese state was ruled by someone not of Chinese ancestry."
    },
    {
     "id": 1198855,
     "content_html": "Confucianism was fully embraced throughout the Mongol Empire."
    },
    {
     "id": 1198854,
     "content_html": "There were no rebellions or revolts."
    },
    {
     "id": 1198853,
     "content_html": "China closed its borders to foreign trade for the next several hundred years."
    }
   ],
