  {
   "id": 624445,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Aksumite and Himyarite leaders publicly express their religious devotion?",
   "answers": [
    {
     "id": 1198540,
     "content_html": "by creating inscriptions and building monuments to their faith"
    },
    {
     "id": 1198539,
     "content_html": "by trading only with empires that shared their faith"
    },
    {
     "id": 1198538,
     "content_html": "by forbidding nonbelievers to enter their territory"
    },
    {
     "id": 1198537,
     "content_html": "by making Zoroastrianism the state religion"
    }
   ],
