 "questions": [
  {
   "id": 624820,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the fall of Constantinople to the Ottomans help initiate the Age of Exploration?",
   "answers": [
    {
     "id": 1199211,
     "content_html": "It made allies of Portugal and Spain, who then became partners in the exploration of the globe."
    },
    {
     "id": 1199210,
     "content_html": "It provided Portuguese and Spanish soldiers with valuable military experience they used in conquering the Indigenous peoples of the Americas."
    },
    {
     "id": 1199209,
     "content_html": "It freed funds that had been spent fighting the Ottomans for use in outfitting voyages of exploration."
    },
    {
     "id": 1199212,
     "content_html": "It motivated European nations to search for an all-water route to the Indies that bypassed the Muslim Ottomans."
    }
   ],
