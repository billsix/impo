 "questions": [
  {
   "id": 624695,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did firearms technology affect nomadic groups?",
   "answers": [
    {
     "id": 1199004,
     "content_html": "Firearms eventually made the forms of warfare favored by nomadic groups less effective."
    },
    {
     "id": 1199003,
     "content_html": "The adoption of firearms by nomadic groups threatened the existence of settled societies."
    },
    {
     "id": 1199002,
     "content_html": "The adoption of firearms technology eliminated nomadism as a way of life."
    },
    {
     "id": 1199001,
     "content_html": "The need to pay taxes to support the armed forces of centralized states caused nomads to settle as farmers."
    }
   ],
