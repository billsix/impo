 "questions": [
  {
   "id": 625138,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did women receive the right to vote in so many places in the 1920s?",
   "answers": [
    {
     "id": 1199796,
     "content_html": "as a reward for their efforts and support in World War I"
    },
    {
     "id": 1199795,
     "content_html": "because of political agreements reached in the late 1800s"
    },
    {
     "id": 1199794,
     "content_html": "as a speedy response to women’s requests"
    },
    {
     "id": 1199793,
     "content_html": "because businesses believed the vote would make women more eager to work outside the home"
    }
   ],
