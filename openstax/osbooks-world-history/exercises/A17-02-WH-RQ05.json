   "stimulus_html": "",
   "stem_html": "What was the main reason for the voyages of Zheng He in the fifteenth century?",
   "answers": [
    {
     "id": 1198980,
     "content_html": "to impress other states with the power of China"
    },
    {
     "id": 1198979,
     "content_html": "to encourage trade between China and Europe"
    },
    {
     "id": 1198978,
     "content_html": "to explore the lands of the Arabian Peninsula"
    },
    {
     "id": 1198977,
     "content_html": "to discover a new trade route to India"
    }
