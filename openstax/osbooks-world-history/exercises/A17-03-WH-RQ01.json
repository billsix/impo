 "questions": [
  {
   "id": 624693,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did firearms technology affect the social structure of western European societies?",
   "answers": [
    {
     "id": 1198995,
     "content_html": "It made it easier for small, decentralized states to challenge larger centralized ones."
    },
    {
     "id": 1198994,
     "content_html": "It completely eliminated nomadic herding as a way of life in Europe."
    },
    {
     "id": 1198996,
     "content_html": "It eventually made aristocratic mounted warriors obsolete."
    },
    {
     "id": 1198993,
     "content_html": "It led to the development of an elite class of aristocratic infantry."
    }
   ],
