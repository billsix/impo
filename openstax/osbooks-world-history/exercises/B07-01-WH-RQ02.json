 "questions": [
  {
   "id": 624887,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What premise is the concept of natural rights based on?",
   "answers": [
    {
     "id": 1199323,
     "content_html": "Rights and freedoms are temporary and can be revoked for any reason by political leaders."
    },
    {
     "id": 1199322,
     "content_html": "Rights come into existence only with the creation of human-made laws that derive from a monarch’s authority."
    },
    {
     "id": 1199324,
     "content_html": "People have fundamental rights that cannot be revoked by human-made laws or political leaders."
    },
    {
     "id": 1199321,
     "content_html": "Animals living in a state of nature should be granted the same rights and freedoms as their human counterparts."
    }
   ],
