 "questions": [
  {
   "id": 624681,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did members of the Mamluk army oppose rule by non-mamluks?",
   "answers": [
    {
     "id": 1198983,
     "content_html": "They believed that only their biological relatives were fit to rule."
    },
    {
     "id": 1198982,
     "content_html": "They did not believe that non-mamluks were pious enough."
    },
    {
     "id": 1198984,
     "content_html": "They believed only those who had experienced rigorous training and enslavement were worthy."
    },
    {
     "id": 1198981,
     "content_html": "They resented rule by foreigners."
    }
   ],
