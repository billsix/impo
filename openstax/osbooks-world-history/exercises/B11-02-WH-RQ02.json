   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What helped cause the decline of the Ottoman Empire?",
   "answers": [
    {
     "id": 1199663,
     "content_html": "financial trouble and increasing debt"
    },
    {
     "id": 1199662,
     "content_html": "warfare on its eastern front"
    },
    {
     "id": 1199664,
     "content_html": "nationalism spurring revolts and loss of territory"
    },
    {
     "id": 1199661,
     "content_html": "factional politics within the Empire that caused turmoil among its top ministers"
    }
