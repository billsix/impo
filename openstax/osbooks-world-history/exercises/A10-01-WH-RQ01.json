 "questions": [
  {
   "id": 624427,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What made the Western Roman Empire more prone to societal disruption than the Eastern Roman Empire?",
   "answers": [
    {
     "id": 1198503,
     "content_html": "The West had a larger population of Christians."
    },
    {
     "id": 1198504,
     "content_html": "The West had a longer frontier and was less urbanized."
    },
    {
     "id": 1198502,
     "content_html": "Western cities were ruled exclusively by bishops."
    },
    {
     "id": 1198501,
     "content_html": "German kings rejected Christianity."
    }
   ],
