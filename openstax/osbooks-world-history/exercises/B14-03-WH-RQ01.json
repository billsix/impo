 "questions": [
  {
   "id": 625212,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All  of the following are reasons Yugoslavia did not become part of the Eastern Bloc <i>except</i>",
   "answers": [
    {
     "id": 1199931,
     "content_html": "Tito believed the Soviet Union should treat Yugoslavia as an equal."
    },
    {
     "id": 1199930,
     "content_html": "Tito supported the civil war in Greece, which Stalin did not."
    },
    {
     "id": 1199932,
     "content_html": "Tito did not want Yugoslavia to be a communist country."
    },
    {
     "id": 1199929,
     "content_html": "Tito wanted to incorporate other countries into Yugoslavia, which Stalin opposed."
    }
   ],
