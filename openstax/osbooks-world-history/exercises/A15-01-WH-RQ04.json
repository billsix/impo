 "questions": [
  {
   "id": 624596,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does the “Africanization” of Christianity and Islam in the medieval period refer to?",
   "answers": [
    {
     "id": 1198819,
     "content_html": "the process of converting African communities to monotheism"
    },
    {
     "id": 1198818,
     "content_html": "the development of holy books written in indigenous African languages"
    },
    {
     "id": 1198820,
     "content_html": "the blending of traditional African beliefs with those of Christianity and Islam"
    },
    {
     "id": 1198817,
     "content_html": "the diffusion of traditional African beliefs among the Abrahamic faiths of the Near and Middle East"
    }
   ],
