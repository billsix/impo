 "questions": [
  {
   "id": 624520,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the relationship between the Germanic kings and the non-German aristocracy they ruled?",
   "answers": [
    {
     "id": 1198675,
     "content_html": "They could not find common ground and were often at war."
    },
    {
     "id": 1198676,
     "content_html": "They could work together when religious differences were not a point of contention."
    },
    {
     "id": 1198674,
     "content_html": "They viewed each other as so similar that there were no differences between them."
    },
    {
     "id": 1198673,
     "content_html": "They were able to preserve the Roman Empire until the end of the Middle Ages."
    }
   ],
