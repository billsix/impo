 "questions": [
  {
   "id": 624812,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "For what reason did Henry VIII reject the authority of the Catholic Church?",
   "answers": [
    {
     "id": 1199199,
     "content_html": "He did not believe the pope had the power to forgive people’s sins."
    },
    {
     "id": 1199198,
     "content_html": "He was angry that the pope had sided with France in its military conflicts with England."
    },
    {
     "id": 1199200,
     "content_html": "He was angry that the pope would not annul his marriage to Catherine of Aragon."
    },
    {
     "id": 1199197,
     "content_html": "He rejected the Catholic Church’s doctrine of transubstantiation."
    }
   ],
