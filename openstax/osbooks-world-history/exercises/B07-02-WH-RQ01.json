   "id": 624898,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was <i>not</i> true of European coffeehouses in the eighteenth century?",
   "answers": [
    {
     "id": 1199335,
     "content_html": "They served as important outlets for news and information."
    },
    {
     "id": 1199334,
     "content_html": "They enabled people from a variety of social backgrounds to acquire an informal education."
    },
    {
     "id": 1199336,
     "content_html": "They were centers of royal power and tightly controlled by monarchs."
    },
    {
     "id": 1199333,
     "content_html": "They had their origins in the cities of the Islamic world."
    }
