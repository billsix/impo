   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Brazil differ from the former Spanish colonies after achieving its independence?",
   "answers": [
    {
     "id": 1199455,
     "content_html": "Brazil abolished slavery soon after achieving independence."
    },
    {
     "id": 1199454,
     "content_html": "Brazil was reduced to colonial status only a few years after becoming independent."
    },
    {
     "id": 1199456,
     "content_html": "Brazil was governed by a monarch even after it became independent."
    },
    {
     "id": 1199453,
     "content_html": "Brazil gave women the right to vote when it became independent."
    }
