   "id": 624953,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the most critical issue discussed at the Guayaquil Conference?",
   "answers": [
    {
     "id": 1199443,
     "content_html": "whether Guayaquil should belong to Peru or Gran Colombia"
    },
    {
     "id": 1199442,
     "content_html": "whether independent Spanish America should be monarchical or republican"
    },
    {
     "id": 1199444,
     "content_html": "whether Bolívar or San Martín should have the glory of completing the struggle for independence"
    },
    {
     "id": 1199441,
     "content_html": "how to defeat the Spanish forces in Peru"
    }
   ],
