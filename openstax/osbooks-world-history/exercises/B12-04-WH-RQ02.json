   "stimulus_html": "",
   "stem_html": "What was one consequence of the Balfour Declaration?",
   "answers": [
    {
     "id": 1199783,
     "content_html": "Palestine was turned over to French control."
    },
    {
     "id": 1199784,
     "content_html": "A Jewish homeland was formed in Palestine."
    },
    {
     "id": 1199782,
     "content_html": "Turkey had to adopt Christianity as the state religion."
    },
    {
     "id": 1199781,
     "content_html": "Iraq became an independent kingdom."
    }
