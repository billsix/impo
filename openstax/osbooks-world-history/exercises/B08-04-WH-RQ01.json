 "questions": [
  {
   "id": 624961,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did the relocation of the Portuguese monarchy to Brazil do?",
   "answers": [
    {
     "id": 1199448,
     "content_html": "ended Brazil's colonial status and made it a kingdom on equal footing with Portugal"
    },
    {
     "id": 1199447,
     "content_html": "resulted in Brazil’s independence from Spanish rule"
    },
    {
     "id": 1199446,
     "content_html": "led to war between Portugal and Great Britain"
    },
    {
     "id": 1199445,
     "content_html": "led to the abolition of slavery in Brazil"
    }
   ],
