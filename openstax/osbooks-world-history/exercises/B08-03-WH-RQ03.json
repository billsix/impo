   "id": 624952,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did Simón  Bolívar’s political program for Gran Colombia envision?",
   "answers": [
    {
     "id": 1199439,
     "content_html": "a monarchy to be ruled by a European king"
    },
    {
     "id": 1199438,
     "content_html": "a republican system based on universal suffrage"
    },
    {
     "id": 1199440,
     "content_html": "a republican system with suffrage restricted to the propertied elite"
    },
    {
     "id": 1199437,
     "content_html": "an authoritarian form of government based on his own dictatorship"
    }
   ],
