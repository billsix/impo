 "questions": [
  {
   "id": 625058,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did Germany have fewer colonies than France and Britain in the early twentieth century?",
   "answers": [
    {
     "id": 1199647,
     "content_html": "It had a moral hatred of colonies."
    },
    {
     "id": 1199648,
     "content_html": "It had industrialized and unified later than the other countries."
    },
    {
     "id": 1199646,
     "content_html": "It had a succession of monarchs, each lasting fewer than five years."
    },
    {
     "id": 1199645,
     "content_html": "It had little business or industry in the early twentieth century and no need for colonies."
    }
   ],
