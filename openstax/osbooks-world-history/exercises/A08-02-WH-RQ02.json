   "stimulus_html": "",
   "stem_html": "What was the political organization of the larger Maya world?",
   "answers": [
    {
     "id": 1198383,
     "content_html": "It was a large empire."
    },
    {
     "id": 1198382,
     "content_html": "It was a confederation with one elite city."
    },
    {
     "id": 1198384,
     "content_html": "It was a collection of independent city-states."
    },
    {
     "id": 1198381,
     "content_html": "It was made up of two large multicity kingdoms."
