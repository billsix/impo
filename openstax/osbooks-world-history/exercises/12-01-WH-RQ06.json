 "questions": [
  {
   "id": 624490,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did Tang emperor Wuzong persecute Buddhist monks and nuns?",
   "answers": [
    {
     "id": 1198627,
     "content_html": "Buddhism was illegal under the Tang."
    },
    {
     "id": 1198628,
     "content_html": "Wuzong believed Buddhism threatened the Confucian state and the imperial order."
    },
    {
     "id": 1198626,
     "content_html": "Buddhist monks and nuns routinely protested the religious intolerance of the Tang."
    },
    {
     "id": 1198625,
     "content_html": "Many civil servants in the bureaucracy were Buddhist, which threatened Tang control. "
    }
   ],
