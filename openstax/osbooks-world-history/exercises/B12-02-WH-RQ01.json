   "id": 625111,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was a result of the New Economic Policy?",
   "answers": [
    {
     "id": 1199743,
     "content_html": "It brought the economy completely under government control for the first time."
    },
    {
     "id": 1199744,
     "content_html": "It kept the government in control of the economy but introduced aspects of capitalism."
    },
    {
     "id": 1199742,
     "content_html": "It was rejected by Lenin as too radical."
    },
    {
     "id": 1199741,
     "content_html": "It was rejected by Stalin as too conservative."
    }
