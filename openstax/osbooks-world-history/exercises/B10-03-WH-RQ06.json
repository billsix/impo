 "questions": [
  {
   "id": 625030,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  was a negative result of the abolition of Russian serfdom?",
   "answers": [
    {
     "id": 1199592,
     "content_html": "Domestic serfs received no land and no longer had a place to live."
    },
    {
     "id": 1199591,
     "content_html": "Serfs were required to leave the farms on which they had always lived."
    },
    {
     "id": 1199590,
     "content_html": "Serfs were no longer entitled to food and clothing from their employer."
    },
    {
     "id": 1199589,
     "content_html": "Serfs were no longer protected from arrest by their employers when they committed crimes."
    }
   ],
