  {
   "id": 624997,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In what way did rinderpest harm the colonized people of Africa?",
   "answers": [
    {
     "id": 1199519,
     "content_html": "It killed the corn crop, causing millions to starve to death."
    },
    {
     "id": 1199518,
     "content_html": "It doubled the rate of infant mortality."
    },
    {
     "id": 1199517,
     "content_html": "It caused widespread blindness."
    },
    {
     "id": 1199520,
     "content_html": "It sickened and killed African cattle herds."
    }
   ],
