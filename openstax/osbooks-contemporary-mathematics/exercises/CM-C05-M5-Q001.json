 "questions": [
  {
   "id": 508213,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Plot the following points in the rectangular coordinate system and identify the quadrant in which the point is located:\n<br>\n<ol type=\"a\">\n<li><span data-math=\"\\left( { - 4,2} \\right)\"> \\left( { - 4,2} \\right)</span></li>\n<li><span data-math=\" (–1, –2)\">(–1, –2)</span></li>\n<li><span data-math=\" (3, –5)\">(3, –5)</span></li>\n<li><span data-math=\"\\left(–3,0 \\right)\"> \\left(–3,0 \\right)</span></li>\n<li><span data-math=\" (\\frac{5}{3},2)\"> (\\frac{5}{3},2)</span></li>\n</ol>\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"(–4, 2)\"></span>: For the graph, move 4 units left and 2 units up to plot the point. The point is in quadrant II.</p>\n<p><span data-math=\"(–1, –2)\"></span>: For the graph, move 1 unit left and 2 units down to plot the point. The point is in quadrant III.</p>\n<p><span data-math=\"(3, –5)\"></span>: For the graph, move 3 units right and 5 units down to plot the point. The point is in quadrant IV.</p>\n<p><span data-math=\"(–3, 0)\"></span>: For the graph, move 3 units left and plot the point on the negative <i>x</i>-axis.</p>\n<p><span data-math=\"\\left( {\\frac{5}{3},2} \\right)\"></span>: For the graph, move <span data-math=\"\\frac{5}{3}\"></span> units right and 2 units up to plot the point. The point is in quadrant I.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<img src=\"https://exercises.openstax.org/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBBdjRJIiwiZXhwIjpudWxsLCJwdXIiOiJibG9iX2lkIn19--dad72cc6524e5caff4eacca8a76b6ea82eed0b5f/CS_Figure_05_05_007.jpg\" alt=\"Five points are marked on an x y coordinate plane. The x and y axes range from negative 8 to 8, in increments of 2. The first, second, third, and fourth quadrants are labeled. The points are plotted at the following coordinates: a (negative 4, 2), b (negative 1, negative 2), c (3, negative 5), d (negative 3, 0), and e (negative 1.5, 2). Note: all values are approximate.\">"
