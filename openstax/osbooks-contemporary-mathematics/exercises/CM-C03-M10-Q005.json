 "questions": [
  {
   "id": 506977,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Christina decides to save money for after graduation. Christina starts by setting aside $10. Each week, Christina increases the amount she saves by $5. How much money will Christina save in week 52?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>First week: $10</p>\n<p>Second week: $15</p>\n<p>Third week: $20</p>\n<p>This is an arithmetic sequence where the first term is 10 and the constant difference is 5.</p>\n<p>Use this formula to find the 52nd term: <span data-math=\"{a_i} = {a_1} + d \\times \\left({i - 1} \\right)\"></span>.</p>\n<p><span data-math=\"{a_{52}} = 10 + 5 \\times \\left({52 - 1} \\right) = 10 + 5(51) = 10 + 255 = 265\"></span></p>\n<p>Christina will save $265 in the 52nd week.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Christina will save $265 in week 52."
    }
   ],
   "community_solutions": []
  }
 ],
