   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"3\\frac{2}{7}\"></span></p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>Multiply the integer part by the denominator.</td>\n<td><span data-math=\"3 \\times 7 = 21\"></span></td>\n</tr>\n<tr>\n<td>Add the product to the numerator.</td>\n<td><span data-math=\"21 + 2 = 23\"></span></td>\n</tr>\n<tr>\n<td>Write the sum divided by the denominator.</td>\n<td><span data-math=\"\\frac{{23}}{7}\"></span></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\frac{{23}}{{7}}\">3\\frac{{23}}{{7}}</span>"
    }
