   "id": 496598,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"\\text~p\">\\text~p</span>: <span data-math=\"3 \\times 5 = 14\">3 \\times 5 = 14</span>.",
   "answers": [],
