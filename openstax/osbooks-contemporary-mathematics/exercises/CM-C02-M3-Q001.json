    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The negation is <span data-math=\"p{\\text :}\\ 3 \\times 5 \\ne 14\"></span></p>\n<p>Since <span data-math=\"3 \\times 5 = 15\"></span>, the negation is true.</p>"
    },
    {
