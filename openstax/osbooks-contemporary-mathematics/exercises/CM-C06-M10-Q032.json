 "questions": [
  {
   "id": 519317,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The billing cycle goes from June 15 to July 14, or 30 days. The balance at the start of the billing cycle is $3,825.50. The list of transactions on the card is below. Find the average daily balance.<br>\n<table class=\"unnumbered\" summary=\".\">\n<thead>\n<tr>\n<th><b>Date</b></th>\n<th><b>Activity</b></th>\n<th><b>Amount</b></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>15-Jun</td>\n<td> Billing Date Balance</td>\n<td>$3,825.50</td>\n</tr>\n<tr>\n<td>20-Jun</td>\n<td>Food</td>\n<td>$125.31</td>\n</tr>\n<tr>\n<td>20-Jun</td>\n<td>Clothing</td>\n<td>$345.00</td>\n</tr>\n<tr>\n<td>29-Jun</td>\n<td>Payment</td>\n<td>$750.00</td>\n</tr>\n<tr>\n<td>1-Jul</td>\n<td>Restaurant</td>\n<td>$94.80</td>\n</tr>\n<tr>\n<td>6-Jul</td>\n<td>Gasoline</td>\n<td>$49.75</td>\n</tr>\n<tr>\n<td>6-Jul</td>\n<td>Home Repair Supplies</td>\n<td>$683.94</td>\n</tr>\n<tr>\n<td>6-Jul</td>\n<td>Internet</td>\n<td>$49.99</td>\n</tr>\n<tr>\n<td>10-Jul</td>\n<td>Cell Phone</td>\n<td>$85.00</td>\n</tr>\n<tr>\n<td>10-Jul</td>\n<td>Food</td>\n<td>$175.24</td>\n</tr>\n</tbody>\n</table>",
   "answers": [],
   "hints": [],
