   "id": 545797,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A frame has dimensions of 10 in by 8 in. Calculate the ratio of the sides rounded to the nearest thousandth and determine if the size approximates a golden rectangle.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The ratio of the sides = <span data-math=\"\\frac{{10}}{8} = 1.25\"></span>, which is not too far from the 1.618 for a golden rectangle."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1.25, which is close to a golden rectangle"
    }
   ],
