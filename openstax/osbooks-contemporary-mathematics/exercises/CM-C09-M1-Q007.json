 "questions": [
  {
   "id": 525998,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A hospital orders 250 doses of liquid amoxicillin. Each dose is 5 mL. How many liters of amoxicillin did the hospital order?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Hint: You can make conversion factors out of any quantities that are equivalent, such as 1 dose being equivalent to 5 mL of amoxicillin.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Prefix</td>\n<td>kilo-</td>\n<td>hecto-</td>\n<td>deca-</td>\n<td>base</td>\n<td>deci-</td>\n<td>centi-</td>\n<td>milli-</td>\n</tr>\n<tr>\n<td>Abbreviation</td>\n<td>k</td>\n<td>h</td>\n<td>d</td>\n<td>&nbsp;</td>\n<td>d</td>\n<td>c</td>\n<td>m</td>\n</tr>\n<tr>\n<td>Magnitude</td>\n<td>10<sup>3</sup></td>\n<td>10<sup>2</sup></td>\n<td>10<sup>1</sup></td>\n<td>1</td>\n<td>10<sup>−1</sup></td>\n<td>10<sup>−2</sup></td>\n<td>10<sup>−3</sup></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"250{\\rm{ }}\\cancel{{{\\rm{doses}}}}\\left( {\\frac{{{\\rm{5 \\ }}\\cancel{{{\\rm{mL}}}}}}{{1{\\rm{\\ }}\\cancel{{{\\rm{dose}}}}}}} \\right)\\left( {\\frac{{{\\rm{1\\  L}}}}{{1000{\\rm{\\ }}\\cancel{{{\\rm{mL}}}}}}} \\right) = 1.25{\\rm{\\ liters}}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1.25 L"
    }
   ],
   "community_solutions": []
  }
 ],
