 "questions": [
  {
   "id": 518429,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the initial deposit in an account is $10,000 and the account is worth $12,560 after 7 years, what is the return on investment?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The return on investment (ROI) is the percent difference between the initial investment (<i>P</i>) and the final value of the investment (<i>FV</i>), or <span data-math=\"{\\rm{ROI}} = \\frac{{FV - P}}{P}\"></span>, expressed as a percentage. The length of time of the investment is not considered in ROI.</p>\n<p><span data-math=\"{\\rm{ROI}} = \\frac{{FV - P}}{P} = \\frac{{12,560 - 10,000}}{{10,000}} = \\frac{{2,560}}{{10,000}} = 0.256 = 25.6\\%\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "25.6%"
    }
   ],
   "community_solutions": []
  }
 ],
