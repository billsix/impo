 "questions": [
  {
   "id": 511728,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Kellie makes tables and chairs. Kellie profits $20 from a table (<span data-math=\"t\">t</span>), and $10 from a chair (<span data-math=\"c\">c</span>). The maximum number of tables and chairs Kellie can make in any one day is 12. What is the constraint inequality in this situation?\n",
   "answers": [
    {
     "id": 1000734,
     "content_html": "<span data-math=\"{t + c \\leq 12}\">{t + c \\leq 12}</span>",
     "correctness": "1.0"
    },
    {
     "id": 1000735,
     "content_html": "<span data-math=\"{ 20t + 10c \\leq 12}\">{ 20t + 10c \\leq 12}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000736,
     "content_html": "<span data-math=\"{ 20t + 10c \\geq 12}\">{ 20t + 10c \\geq 12}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000737,
     "content_html": "<span data-math=\"{ 20t + 10c \\leq 70}\">{ 20t + 10c \\leq 70}</span>",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Let <i>t</i> = the number of tables sold.</p>\n<p>Let <i>c</i> = the number of chairs sold.</p>\n<p>Let <i>P</i> = the profit.</p>\n<p>The maximum number of tables and chairs made in a day is 12.</p>\n<p>Break the words into components.</p> \n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>The number of tables</td>\n<td>plus</td>\n<td>the number of chairs</td>\n<td>is no more than</td>\n<td>12</td>\n</tr>\n<tr>\n<td><i>t</i></td>\n<td>+</td>\n<td><i>c</i></td>\n<td>≤</td>\n<td>12</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"t + c \\le 12\"></span></p>\n"
    }
   ],
   "community_solutions": []
  }
 ],
