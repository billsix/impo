 "questions": [
  {
   "id": 529077,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "On your morning commute, you decide to record how long you have to wait each time you get caught at a red light. Here are the times in seconds: 12, 58, 35, 79, 21. What is the range?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The range is the difference between the maximum and the minimum values.</p>\n<p>The maximum is 79.</p>\n<p>The minimum is 12.</p>\n<p>The range is 79 − 12 = 67 seconds.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "67"
    }
   ],
   "community_solutions": []
  }
 ],
