 "stimulus_html": "In the following exercises, compare payments per month and interest rates.",
 "questions": [
  {
   "id": 519012,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A loan for $20,000 is taken out for 5 years. Find the payment if the interest rate is:\n<ol type=\"a\">\n<li>2.9%</li>\n<li>3.9%</li>\n<li>4.9%</li>\n<li>5.9%</li>\n<li>Did the payments increase by the same amount for each 1% jump in interest rate? Describe the pattern.</li>\n</ol>",
   "answers": [],
   "hints": [],
