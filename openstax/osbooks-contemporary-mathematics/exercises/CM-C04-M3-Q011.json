 "questions": [
  {
   "id": 510734,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Convert 137 to base 2.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: Divide the number by 2.</p>\n<p><span data-math=\"137 \\div 2 = 68\"></span> with a remainder. What is it?</p>\n<p><span data-math=\"2 \\times 68 = 136\"></span></p>\n<p><span data-math=\"137-136 = 1\"></span></p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>The remainder is 1.</td>\n<td><span data-math=\"68{\\rm{R}}1\"></span></td>\n</tr>\n<tr>\n<td>In base two, any remainder will be 1.</td>\n<td></td>\n</tr>\n<tr>\n<td>Step 2: Divide the quotient by 2.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"68 \\div 2 = 34\"></span> with no remainder.</td>\n<td><span data-math=\"34{\\rm{R}}0\"></span></td>\n</tr>\n<tr>\n<td>Step 3: Divide the quotient by 2.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"34 \\div 2 = 17\"></span> with remainder 0.</td>\n<td><span data-math=\"17{\\rm{R}}0\"></span></td>\n</tr>\n<tr>\n<td>Step 4: Divide the quotient by 2.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"17 \\div 2 = 8\"></span> with remainder 1.</td>\n<td><span data-math=\"8{\\rm{R}}1\"></span></td>\n</tr>\n<tr>\n<td>Step 5: Divide the quotient by 2.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"8 \\div 2 = 4\"></span> with no remainder.</td>\n<td><span data-math=\"4{\\rm{R}}0\"></span></td>\n</tr>\n<tr>\n<td>Step 6: Divide the quotient by 2.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"4 \\div 2 = 2\"></span> with no remainder.</td>\n<td><span data-math=\"2{\\rm{R}}0\"></span></td>\n</tr>\n<tr>\n<td>Step 7: Divide the quotient by 2.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"2 \\div 2 = 1\"></span> with no remainder.</td>\n<td><span data-math=\"1{\\rm{R}}0\"></span></td>\n</tr>\n<tr>\n<td>Step 8: Divide the quotient by 2.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"1 \\div 2 = 0\"></span> with remainder 1.</td>\n<td><span data-math=\"0{\\rm{R}}1\"></span></td>\n</tr>\n</tbody>\n</table>\n<p>The base 2 number has digits equal to the remainders in reverse order: <span data-math=\"{10001001_2}\"></span>.</p>"
    },
    {
