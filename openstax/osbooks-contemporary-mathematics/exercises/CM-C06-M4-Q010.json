 "questions": [
  {
   "id": 518803,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Isabella decides to deposit $5,500 in a CD but needs to choose between banks that offer CDs. She identifies four banks and finds out the terms of their CDs. Her findings are in the table below.<br>\n<table class=\"unnumbered\" summary=\".\">\n<thead>\n<tr>\n<th>Bank</th>\n<th>Interest Rate</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Smith Bank</td>\n<td>3.08% compounded quarterly</td>\n</tr>\n<tr>\n<td>Park Bank</td>\n<td>3.11% compounded annually</td>\n</tr>\n<tr>\n<td>Town Bank</td>\n<td>3.09% compounded daily</td>\n</tr>\n<tr>\n<td>Community Bank</td>\n<td>3.10% compounded monthly</td>\n</tr>\n</tbody>\n</table>\nWhich bank has the best yield?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Find the effective annual yield of each bank.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td valign=\"top\">Smith Bank</td>\n<td valign=\"top\"><span data-math=\"Y = {\\left({1 + \\frac{{0.0308}}{4}} \\right)^4} - 1 = 0.03115....\"></span><br>Effective annual yield: 3.11%</td>\n</tr>\n<tr>\n<td valign=\"top\">Park Bank</td>\n<td valign=\"top\"><span data-math=\"Y = {\\left({1 + \\frac{{0.0311}}{1}} \\right)^1} - 1 = 0.03\"></span><br>Effective annual yield: 3%</td>\n</tr>\n<tr>\n<td valign=\"top\">Town Bank</td>\n<td valign=\"top\"><span data-math=\"Y = {\\left({1 + \\frac{{0.039}}{{365}}} \\right)^{365}} - 1 = 0.39768....\"></span><br>Effective annual yield: 3.98%</td>\n</tr>\n<tr>\n<td valign=\"top\">Community Bank</td>\n<td valign=\"top\"><span data-math=\"Y = {\\left({1 + \\frac{{0.310}}{{12}}} \\right)^{12}} - 1 = 0.0314427....\"></span><br>Effective annual yield: 3.14%</td>\n</tr>\n</tbody>\n</table>\n<p>Community Bank has the highest effective annual yield at 3.14%.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The effective annual yields for the banks are 3.1158% for Smith Bank, 3.11% for Park Bank, 3.1381% for Town Bank, and 3.144% for Community Bank. Community Bank has the best yield."
    }
   ],
