   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the area of the circle with a radius of 3 cm.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The area of a circle with radius <i>r</i> is <span data-math=\"A = \\pi {r^2}\"></span>.</p>\n<p><span data-math=\"A = \\pi {r^2} = \\pi {\\left( {3{\\text{ cm}}} \\right)^2} = 9\\pi {\\text{ c}}{{\\text{m}}^2} \\approx 28.3{\\text{ c}}{{\\text{m}}^2}\"></span></p>\n<p>The area of the circle is approximately 28.3 square centimeters.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"28.3\\,{\\text{c}}{{\\text{m}}^2}\">28.3\\,{\\text{c}}{{\\text{m}}^2}</span>"
    }
   ],
