   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which metric base unit would be used to measure your weight?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The base metric unit for weight is Newtons, but usually you see the mass measured in grams. When you buy packages of food, for instance, they often have the weight in ounces and the mass in grams."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "grams"
    }
   ],
   "community_solutions": []
  }
 ],
