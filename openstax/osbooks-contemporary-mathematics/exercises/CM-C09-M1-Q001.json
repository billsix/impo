     "solution_type": "summary",
     "content_html": "The base metric unit for weight is Newtons (N), but usually you see the mass measured in grams (g). When you buy packages of food, for instance, they often have the weight in ounces and the mass in grams."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "gram (g)"
    }
   ],
