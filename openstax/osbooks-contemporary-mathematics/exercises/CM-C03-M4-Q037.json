   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Convert  0.34 into fraction form.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: Because 0.34 has two decimal places, write 10 to the second power: 100.</p>\n<p>Step 2: Remove the decimal point from the original number: 34.</p>\n<p>Step 3: Write a fraction with the result from Step 2 in the numerator and the result from Step 1 in the denominator.</p>\n<p><span data-math=\"\\frac{{34}}{{100}}\"></span></p>\n<p>Alternate answer in lowest terms: <span data-math=\"\\frac{{17}}{{50}}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\frac{{34}}{{100}}\">\\frac{{34}}{{100}}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
