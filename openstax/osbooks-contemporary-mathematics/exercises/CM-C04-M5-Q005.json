 "questions": [
  {
   "id": 508976,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Calculate <span data-math=\"{10_6} \\div {3_6}\">{10_6} \\div {3_6}</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use the multiplication table for base 6. Find 10 in the product part of the table where 3 is the column header. The answer is the row header, 2, for that cell.</p>\n<p>The answer is 2<sub>6</sub>.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"{10_6} \\div {3_6} = {2_6}\">{10_6} \\div {3_6} = {2_6}</span>"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 508977,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Calculate <span data-math=\"{50_{12}} \\div {{\\text{A}}_{12}}\">{50_{12}} \\div {{\\text{A}}_{12}}</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use the multiplication table for base 12. Find 50 in the product part of the table where A is the column header. The answer is the row header, 6, for that cell.</p>\n<p>The answer is 6<sub>12</sub>.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"{50_{12}} \\div {{\\text{A}}_{12}} = {6_{12}}\">{50_{12}} \\div {{\\text{A}}_{12}} = {6_{12}}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
