   "id": 531720,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The table below shows the number of players on the rosters of each English Premier League team. Find the mode, median, and mean without technology.\n<table><caption>(source: https://fbref.com/en/comps/9/Premier-League-Stats#all_stats_squads_standard)</caption>\n<thead>\n<tr><th>Team</th>\n<th>Active Players</th>\n<th>Team</th>\n<th>Active Players</th></tr>\n</thead>\n<tbody>\n<tr><td>Manchester United F.C.</td>\n<td>27</td>\n<td>Newcastle United F.C.</td>\n<td>28</td></tr>\n<tr><td>Manchester City F.C.</td>\n<td>24</td>\n<td>Aston Villa F.C.</td>\n<td>24</td></tr>\n<tr><td>Chelsea F.C.</td>\n<td>25</td>\n<td>Fulham F.C.</td>\n<td>27</td></tr>\n<tr><td>Arsenal F.C.</td>\n<td>28</td>\n<td>Southampton F.C.</td>\n<td>24</td></tr>\n<tr><td>Tottenham Hotspur F.C.</td>\n<td>27</td>\n<td>Wolverhampton Wanderers F.C.</td>\n<td>22</td></tr>\n<tr><td>Liverpool F.C.</td>\n<td>30</td>\n<td>Brighton &amp; Hove Albion</td>\n<td>31</td></tr>\n<tr><td>Crystal Palace</td>\n<td>29</td>\n<td>Burnley F.C.</td>\n<td>22</td></tr>\n<tr><td>Everton F.C.</td>\n<td>23</td>\n<td>West Bromwich Albion F.C.</td>\n<td>26</td></tr>\n<tr><td>Leicester City</td>\n<td>25</td>\n<td>Leeds United F.C.</td>\n<td>25</td></tr>\n<tr><td>West Ham United F.C.</td>\n<td>24</td>\n<td>Sheffield United F.C.</td>\n<td>27</td></tr></tbody>\n</table>",
