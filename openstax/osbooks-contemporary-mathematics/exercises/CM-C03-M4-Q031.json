 "questions": [
  {
   "id": 505877,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Riley has a daily calorie intake of 2,200 calories and wants to take in 20% of their calories as protein. How many calories of protein should be in their daily diet?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>What is 20% of 2,200?</p>\n<p><span data-math=\"n\"></span> percent, denoted <span data-math=\"n\\% \"></span>, is the fraction <span data-math=\"\\frac{n}{{100}}.\"></span></p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>Rewrite “of” as multiplication.</td>\n<td><span data-math=\"\\frac{{20}}{{100}} \\times 2,200\"></span></td>\n</tr>\n<tr>\n<td>Use your calculator.</td>\n<td><span data-math=\"440\"></span></td>\n</tr>\n</tbody>\n</table>\n<p>Rily should eat 440 calories of protein.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "440 calories of protein"
    }
   ],
   "community_solutions": []
  }
 ],
