 "questions": [
  {
   "id": 517603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Andy earned $169,450 in wages this year. How much in SSI taxes does Andy owe?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>FICA stands for Federal Insurance Contributions Act of 1935. FICA taxes fund Social Security and Medicare and are automatically withdrawn from your pay. You pay 7.65 percent of your gross pay and your employer matches your amount. Of the 7.65 percent, 6.2 percent goes to Social Security (SSI) and 1.45 percent goes to Medicare. The Social Security (SSI) part only applies to the first $147,000 of your earnings, but the Medicare tax applies to all your gross earnings.</p>\n<p>Only the first $147,000 is taxed for SSI. Ignore the excess.</p>\n<p>Find 6.2% of $147,000 to find the SSI part.</p>\n<p>0.062(147,000) = $9,114 to SSI</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$9,114"
    }
   ],
   "community_solutions": []
  }
 ],
