 "questions": [
  {
   "id": 505845,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "There are approximately <span data-math=\"1 \\times {10^{12}}\">1 \\times {10^{12}}</span> grains of sand in a cubic meter. If the number of grains of sand on the Australian coastline is roughly <span data-math=\"7.5 \\times {10^{21}}\">7.5 \\times {10^{21}}</span> grains, roughly how many cubic meters of sand is there on the Australian coastline?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Divide <span data-math=\"7.5 \\times {10^{21}}\"></span> by <span data-math=\"1 \\times {10^{12}}\"></span>.</p>\n<p>Step 1: Divide the number parts.</p>\n<p><span data-math=\"7.5 \\div 1 = 7.5\"></span></p>\n<p>Step 2: Subtract the exponents of the 10s.</p>\n<p><span data-math=\"21 - 12 = 9\"></span></p>\n<p>Step 3: The result is the answer from Step 1 times 10 raised to the answer from Step 2.</p>\n<p><span data-math=\"7.5 \\times {10^9}\"></span></p>\n<p>Step 4: If the answer is not in scientific notation, adjust it.</p>\n<p><span data-math=\"7.5 \\times {10^9}\"></span></p>\n<p>There are <span data-math=\"7.5 \\times {10^9}\"></span> cubic meters of sand on the Australian coastline.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"7.5 \\times {10^9}\">7.5 \\times {10^9}</span> cubic meters"
    }
   ],
   "community_solutions": []
  }
 ],
