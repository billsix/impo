 "questions": [
  {
   "id": 515767,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You flip a coin 6 times and note the number of heads. What is the sample space of this experiment?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The minimum number of heads is none. The maximum number of heads is 6. Every number between 0 and 6 is possible.</p>\n<p>The sample space: {0, 1, 2, 3, 4, 5, 6}</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "{0, 1, 2, 3, 4, 5, 6}"
    }
   ],
   "community_solutions": []
  }
 ],
