   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"5y = 50\">5y = 50</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Break your sentence into components.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Five times <i>y</i></td>\n<td>is</td>\n<td>50</td>\n</tr>\n<tr>\n<td>5<i>y</i></td>\n<td>=</td>\n<td>50</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"5y = 50\"></span></p>"
    }
   ],
