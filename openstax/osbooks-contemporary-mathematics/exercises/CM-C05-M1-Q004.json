  {
   "id": 507553,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Half of a number <span data-math=\"n\">n</span> is 30.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\frac{1}{2}n = 30\">\\frac{1}{2}n = 30</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Break your sentence into components.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Half of a number <i>n</i></td>\n<td>is</td>\n<td>30</td>\n</tr>\n<tr>\n<td><span data-math=\"\\frac{1}{2}n\"></span></td>\n<td>=</td>\n<td>30</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"\\frac{1}{2}n = 30\"></span></p>\n<p>Alternate answer option:</p>\n<p><span data-math=\"\\frac{n}{2} = 30\"></span></p>"
    }
   ],
   "community_solutions": []
