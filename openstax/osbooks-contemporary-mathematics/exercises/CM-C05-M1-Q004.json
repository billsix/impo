   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"3n - 7 = 2\">3n - 7 = 2</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Break your sentence into components.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>The difference of three times a number</td>\n<td>and 7</td>\n<td>is</td>\n<td>2</td>\n</tr>\n<tr>\n<td>3<i>n</i></td>\n<td>– 7</td>\n<td>=</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n<p>3<i>n</i> – 7 = 2</p>"
    }
   ],
