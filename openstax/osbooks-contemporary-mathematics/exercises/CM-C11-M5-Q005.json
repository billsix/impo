 "is_vocab": false,
 "stimulus_html": "The country of Narnia has grown from two states to three. The house size of the congress has been increased by five and the seats have been reapportioned to accommodate the new state of Chippingford. The constitution mandates the use of the Hamilton method of apportionment. Use this information and the following table to answer the questions.\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>State</th>\n<th>Population (in hundreds)</th>\n<th>Original Apportionment</th>\n<th>Reapportionment</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Beruna</td>\n<td>7600</td>\n<td>39</td>\n<td>40</td>\n</tr>\n<tr>\n<td>Beaversdam</td>\n<td>9720</td>\n<td>51</td>\n<td>50</td>\n</tr>\n<tr>\n<td>Chippingford</td>\n<td>1000</td>\n<td>Not Applicable</td>\n<td>5</td>\n</tr>\n</tbody>\n</table>\n",
 "questions": [
  {
   "id": 545390,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the original house size?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The house size is the number of seats.</p>\n<p><span data-math=\"{\\text{39  +  51  =  90}}\"></span> seats</p>\n<p>The original house size is 90 seats.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "90\n\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545391,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the new house size?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The house size is the number of seats.</p>\n<p><span data-math=\"{\\text{40  +  50  +  5  =  95}}\"></span></p>\n<p>The new house size is 95 seats.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "95"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545392,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How is this reapportionment an example of the new-states paradox?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The existing state of Beaversdam lost a seat to the existing state of Beruna when the new state of Chippingford was added.</p>\n<p>This is an example of the new-state paradox, which occurs when the addition of a new state is accompanied by an increase in seats to maintain the standard ratio of population to seats, but one of the existing states loses a seat in the resulting reapportionment.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The original state of Beaversdam lost a seat to the original state of Beruna when the new state of Chippingford was added."
    }
   ],
   "community_solutions": []
  }
 ],
