 "questions": [
  {
   "id": 340496,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Graphs <i>E</i> and <i>T</i> are isomorphic. Name two isomorphisms.\n<figure>\n<figcaption>Graph <i>E</i> and Graph <i>T</i></figcaption>\n<img src=\"exercises/media/b3d9484082000830.png\" alt=\"Two graphs are labeled graph E and graph T. Graph E has four vertices: a, b, c, and d. The edges connect a b, b c, c d, a c, and a d. Graph T has four vertices: p, q, r, and s. The edges connect p r, p s, r q, s q, and p q.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Answers may vary. There are four possible isomorphisms:\n<br>\n<ul>\n<li><i>a − q</i>, <i>d − s</i>, <i>c − p</i>, and <i>b − r</i>.</li>\n<li><i>a − p</i>, <i>d − s</i>, <i>c − q</i>, and <i>b − r</i>.</li>\n<li><i>a − q</i>, <i>d − r</i>, <i>c − p</i>, and <i>b − s</i>.</li>\n<li><i>a − p</i>, <i>d − r</i>, <i>c − q</i>, and <i>b − s</i>.</li>\n</ul>"
    }
   ],
   "community_solutions": []
  }
 ],
