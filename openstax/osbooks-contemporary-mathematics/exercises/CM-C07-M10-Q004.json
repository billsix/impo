 "is_vocab": false,
 "stimulus_html": "You are rolling a 6-sided die with 3 orange faces, 2 green faces, and 1 blue face.",
 "questions": [
  {
   "id": 516907,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you roll the die 5 times and note the color showing on each roll, is this a binomial experiment?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A binomial trial has two outcomes. A binomial experiment is an experiment with a fixed number of repeated binomial trials, where each trial has the same probability of success.</p>\n<p>This is not binomial because it has more than two outcomes.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "No (more than two outcomes)"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 516908,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you roll the die 5 times and count the number times you roll a green face, is this a binomial experiment?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A binomial trial has two outcomes. A binomial experiment is an experiment with a fixed number of repeated binomial trials, where each trial has the same probability of success.</p>\n<p>This is binomial because it has two outcomes: a green face or no green face.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 516909,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you count how many times you roll the die until you get a blue face, is this a binomial experiment?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A binomial trial has two outcomes. A binomial experiment is an experiment with a fixed number of repeated binomial trials, where each trial has the same probability of success.</p>\n<p>It is not binomial, because you did not determine the number of trials before you started.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "No (number of trials is not fixed)"
    }
   ],
   "community_solutions": []
  }
 ],
