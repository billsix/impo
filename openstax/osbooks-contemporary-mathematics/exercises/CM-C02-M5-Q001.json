     "content_html": "<span data-math=\"p \\to q\">p \\to q</span> is logically equivalent to <span data-math=\"\\text{~}q \\to\\text{~}p.\">\\text{~}q \\to\\text{~}p.</span>\n<table summary=\".\">\n<thead>\n<tr>\n<th><span data-math=\"{p}\">p</span></th>\n<th><span data-math=\"{q}\">{q}</span></th>\n<th><span data-math=\"{p} \\to {q}\">{p} \\to {q}</span></th>\n<th><span data-math=\"\\text{~}{q}\">\\text{~}{q}</span></th>\n<th><span data-math=\"\\text{~}{p}\">\\text{~}{p}</span></th>\n<th><span data-math=\"\\text{~}{q} \\to \\text{~}{p}\">\\text{~}{q} \\to \\text{~}{p}</span></th>\n<th><span data-math=\"\\left( {p} \\to {q} \\right) \\leftrightarrow \\left( {\\text{~}{q} \\to \\text{~}{p}} \\right)\">\\left( {p} \\to {q} \\right) \\leftrightarrow \\left( {\\text{~}{q} \\to \\text{~}{p}} \\right)</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>T</td>\n<td>T</td>\n<td>T</td>\n<td>F</td>\n<td>F</td>\n<td>T</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>T</td>\n<td>F</td>\n<td>F</td>\n<td>T</td>\n<td>F</td>\n<td>F</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>F</td>\n<td>T</td>\n<td>T</td>\n<td>F</td>\n<td>T</td>\n<td>T</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>F</td>\n<td>F</td>\n<td>T</td>\n<td>T</td>\n<td>T</td>\n<td>T</td>\n<td><b>T</b></td>\n</tr>\n</tbody>\n</table>\n"
