 "questions": [
  {
   "id": 519035,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Yuan-Teng receives his award and tuition letter from the college he wants to attend. His tuition, fees, books, and room and board all come to $34,845 for the year. His non-loan awards include an instant scholarship from the school for $17,500, three scholarships he earned from sources he found online, which total $5,600, and a $2,000 scholarship from his employer. What is Yuan-Teng’s college funding gap?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The costs are $34,845.</p>\n<p>The awards are <span data-math=\"{\\text{17,500  +  5,600  +  2,000  =  25,100}}\"></span>.</p>\n<p><span data-math=\"34,845{\\text{ }}-{\\text{ }}25,100{\\text{ }} = {\\text{ }}\\$ 9,745\"></span></p>\n<p>The funding gap is $9,745.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$9,745"
    }
   ],
   "community_solutions": []
  }
 ],
