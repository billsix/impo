   "stimulus_html": "",
   "stem_html": "Solve <span data-math=\"2\\left( {x + 6} \\right) = 3x + 4-\\left( {x + 5} \\right)\">2\\left( {x + 6} \\right) = 3x + 4-\\left( {x + 5} \\right)</span>.",
   "answers": [],
