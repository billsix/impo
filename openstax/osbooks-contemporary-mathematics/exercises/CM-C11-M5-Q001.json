 "is_vocab": false,
 "stimulus_html": "The 1900 census recorded the population of Colorado as 539,700 and that of the U.S. as 76,212,168.",
 "questions": [
  {
   "id": 545373,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Calculate the standard divisor and standard quota for the State of Colorado based on a house size of 356.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"{\\text{Standard Divisor = }}\\frac{{{\\text{Total Population}}}}{{{\\text{House Size}}}} = \\frac{{{\\text{76,212,168}}}}{{{\\text{356 seats}}}} \\approx 214,079.1236{\\text{ people per seat}}\"></span></p>\n<p><span data-math=\"{\\text{Standard Quota = }}\\frac{{{\\text{State Population}}}}{{{\\text{Standard Divisor}}}}{\\text{ = }}\\frac{{{\\text{539,700 people}}}}{{214,079.1236{\\text{ people per seat}}}}{\\text{ = 2}}{\\text{.521 seats}}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The standard divisor is 214,079.1236 citizens per seat. The standard quota for Colorado is 2.5210 seats."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545374,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Calculate the standard divisor and standard quota for the State of Colorado based on a house size of 357.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"{\\text{Standard Divisor = }}\\frac{{{\\text{Total Population}}}}{{{\\text{House Size}}}} = \\frac{{{\\text{76,212,168}}}}{{{\\text{357 seats}}}} \\approx 213,479.4622{\\text{ people per seat}}\"></span></p>\n<p><span data-math=\"{\\text{Standard Quota = }}\\frac{{{\\text{State Population}}}}{{{\\text{Standard Divisor}}}}{\\text{ = }}\\frac{{{\\text{539,700 people}}}}{{213,479.4622{\\text{ people per seat}}}}{\\text{ = 2}}{\\text{.528 seats}}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The standard divisor is 213,479.4622 citizens per seat. The standard quota for Colorado is 2.5281 seats.\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545375,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Did the standard quota increase or decrease when the house size increased?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The house size increased from 356 to 357 seats. The standard quota increased from 2.521 seats to 2.528 seats."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The standard quota increased."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545376,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the Hamilton method of apportionment. Explain how Colorado’s final quota could be smaller with a larger standard quota.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "It must have been the case that either the fractional part 0.5281 ranked lower amongst the other fractional parts of the state quotas than the fractional part 0.5210 did, or there were fewer remaining seats to be distributed, or both."
    }
   ],
   "community_solutions": []
  }
 ],
