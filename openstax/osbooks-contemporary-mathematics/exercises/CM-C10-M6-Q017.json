 "questions": [
  {
   "id": 532570,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The area of the sail in the sailboat is <span data-math=\"125\\,{\\text{f}}{{\\text{t}}^2}.\">125\\,{\\text{f}}{{\\text{t}}^2}.</span> The shortest length is 10 ft. What is the height of the sail?\n<br>\n<img src=\"exercises/media/24faafbad0908b7a.png\" alt=\"A sailboat with the mainsail resembling a right triangle. The height of the mainsail is marked h.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The area of a triangle is <span data-math=\"A = \\frac{1}{2}bh\"></span>, where <i>b</i> represents the base and <i>h</i> represents the height.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"\\frac{1}{2}\\left( {{\\text{10}}} \\right)h = {\\text{ 125 }}\"></span></td>\n<td>Simplify on the left.</td>\n</tr>\n<tr>\n<td><span data-math=\"5h = {\\text{ 125 }}\"></span></td>\n<td>Divide.</td>\n</tr>\n<tr>\n<td><span data-math=\"h = 25\"></span></td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p>The height of the sail is 25 feet.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "25 ft"
    }
   ],
   "community_solutions": []
  }
 ],
