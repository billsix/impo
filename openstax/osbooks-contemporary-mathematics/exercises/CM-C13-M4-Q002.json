 "is_vocab": false,
 "stimulus_html": "Name which keys are one half-step up and one half-step down from the following:",
 "questions": [
  {
   "id": 545536,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "F<sup>#</sup>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>One half-step up or down is one key up or down. Black and white keys count the same.</p>\n<p>One key up from F# is G.</p>\n<p>One key down from F# is F.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "up G, down F"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545537,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "B",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>One half-step up or down is one key up or down. Black and white keys count the same.</p>\n<p>One key up from B is C.</p>\n<p>One key down from B is B♭. (Alternative answer to down: A#)</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "up C, down B<sup>♭</sup>"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545538,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "G<sup>♭</sup>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>One half-step up or down is one key up or down. Black and white keys count the same.</p>\n<p>One key up from G♭ is G.</p>\n<p>One key down from G♭ is F.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "up G, down F"
    }
   ],
   "community_solutions": []
  }
