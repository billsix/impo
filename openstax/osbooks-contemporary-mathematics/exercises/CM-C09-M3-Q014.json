     "solution_type": "summary",
     "content_html": "<span data-math=\"6.75{\\cancel{{{\\text{centimeters}}}}^3}{\\left( {\\frac{{1{\\text{ }}\\cancel{{{\\text{meter}}}}}}{{{\\text{100 }}\\cancel{{{\\text{centimeters}}}}}}} \\right)^3}{\\left( {\\frac{{{\\text{1,000 millimeters}}}}{{{\\text{1 }}\\cancel{{{\\text{meter}}}}}}} \\right)^3} = \\frac{{6.75 \\times {\\text{1,000,}}\\cancel{{{\\text{000,000}}}}}}{{\\cancel{{{\\text{1,000,000}}}}}}{\\text{ m}}{{\\text{m}}^3}{\\mkern 1mu} {\\text{  =  }}{\\mkern 1mu} 6,750{\\text{ m}}{{\\text{m}}^3}\"></span>"
    },
