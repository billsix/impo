     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Prefix</td>\n<td>kilo-</td>\n<td>hecto-</td>\n<td>deca-</td>\n<td>base</td>\n<td>deci-</td>\n<td>centi-</td>\n<td>milli-</td>\n</tr>\n<tr>\n<td>Abbreviation</td>\n<td>k</td>\n<td>h</td>\n<td>da</td>\n<td>&nbsp;</td>\n<td>d</td>\n<td>c</td>\n<td>m</td>\n</tr>\n<tr>\n<td>Magnitude</td>\n<td>10<sup>3</sup></td>\n<td>10<sup>2</sup></td>\n<td>10<sup>1</sup></td>\n<td>1</td>\n<td>10<sup>−1</sup></td>\n<td>10<sup>−2</sup></td>\n<td>10<sup>−3</sup></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"20,000{\\cancel{{{\\rm{centimeters}}}}^2}{\\left( {\\frac{{1{\\rm{\\ meter}}}}{{{\\rm{100 }}\\cancel{{{\\rm{centimeters}}}}}}} \\right)^2} = \\frac{{20,000}}{{10,000}}{\\rm{\\ }}{{\\rm{m}}^2}\\,{\\rm{ = }}\\,2{\\rm{\\ }}{{\\rm{m}}^2}\"></span></p>"
