 "stimulus_html": "In the following, determine how much interest was earned on the investment and the future value of the investment if the investment yields simple interest.",
 "questions": [
  {
   "id": 518466,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Principal is $4,500, annual interest rate is 1.88%, and time is 3 years",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"{\\rm Future\\ Value} = FV = P + I\"></span></p>\n<p><span data-math=\"I = P \\times r \\times t = 4,500 \\times 0.0188 \\times 3 = \\$ 253.80\"></span></p>\n<p><span data-math=\"FV = P + I = 4,500 + 253.80 = \\$4,753.80\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Interest = $253.8, <span data-math=\"FV\">FV</span> = $4,753.80"
    }
