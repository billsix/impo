 "questions": [
  {
   "id": 506195,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the sum of the first 100 terms of the geometric sequence with first term 4 and common ratio 0.3?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The sum of the first <i>n</i> terms of a geometric sequence, with first term <span data-math=\"{a_1}\"></span> and common ratio <i>r</i>, is</p>\n<p><span data-math=\"{s_n} = {a_1}\\left( {\\frac{{1 - {r^n}}}{{1 - r}}} \\right)\"></span>, provided that <span data-math=\"r \\ne 1\"></span>.</p>\n<p><span data-math=\"{s_{100}} = 4\\left( {\\frac{{1 - {{0.3}^{100}}}}{{1 - 0.3}}} \\right) \\approx 5.714\"></span> (rounded to three decimal places)</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "5.714 (rounded to three decimal places)"
    }
   ],
   "community_solutions": []
  }
 ],
