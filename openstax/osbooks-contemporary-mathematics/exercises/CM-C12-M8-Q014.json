 "questions": [
  {
   "id": 544541,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If a graph is composed of two cycles joined only at a single vertex <i>p</i>, then no Hamilton path can be formed starting or ending at any vertex that is adjacent to <i>p</i>. ",
   "answers": [
    {
     "id": 1069975,
     "content_html": "True",
     "correctness": "0.0"
    },
    {
     "id": 1069976,
     "content_html": "False",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This graph may have a Hamilton path that starts on one cycle on a vertex adjacent to <i>p</i> and ends on <i>p.</i> It can go around the first cycle, cross to the second cycle at <i>p</i>, and then go around the second cycle."
