 "stimulus_html": "Write  the cardinal value of each of the following sets in symbolic form.",
 "questions": [
  {
   "id": 493915,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Set <span data-math=\"P\">P</span>  is the set of prime numbers less than 2.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The cardinal value is the number of elements in the set. There are no prime numbers less than 2.</p>\n<span data-math=\"n\\left( {\\rm{P}} \\right) = 0\"></span>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"n(P) = 0\">n(P) = 0</span>"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 493916,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Set <span data-math=\"A\">A</span> is the set of lowercase letters of the English alphabet, <span data-math=\"A = \\{\\text{a,b,c,}\\ldots,\\text{z}\\}\">A = \\{ \\text{a,b,c, \\ldots ,z}\\}</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The cardinal value is the number of elements in the set. There are 26 lowercase letters of the English alphabet.</p>\n<span data-math=\"n\\left( {\\rm{P}} \\right) = 26\"></span>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"n(A) = 26\">n(A) = 26</span>"
    }
   ],
   "community_solutions": []
  }
