 "stimulus_html": "For both of the questions below, <span data-math=\"A\">A</span> is a proper subset of <span data-math=\"U\">U</span>.",
 "questions": [
  {
   "id": 494480,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the universal set <span data-math=\"U = \\left\\{ {{\\text{red, orange, yellow, green, blue, indigo, violet}}} \\right\\}\">U = \\left\\{ {{\\text{red, orange, yellow, green, blue, indigo, violet}}} \\right\\}</span> and set <span data-math=\"A = \\left\\{ {{\\text{yellow, red, blue}}} \\right\\}\">A = \\left\\{ {{\\text{yellow, red, blue}}} \\right\\}</span>, find <span data-math=\"A'\">A'</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"A'\"></span> represents the complement of set <i>A</i>. The complement of set <i>A</i> is the set of all elements in the universal set <i>U</i> that are <i>not</i> in set <i>A</i>. List the elements of <i>U</i> that are not in <i>A</i>.</p>\n<p><span data-math=\"\\{{\\rm orange,\\ green,\\ indigo,\\ violet}\\}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"A' = \\left\\{ {{\\text{orange, green, indigo, violet}}} \\right\\}\">A' = \\left\\{ {{\\text{orange, green, indigo, violet}}} \\right\\}</span>\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 494481,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the universal set <span data-math=\"U = \\{ c|c\\,{\\text{is a cat\\} }}\">U = \\{ c|c\\,{\\text{is a cat\\} }}</span> and  set <span data-math=\"A = \\{ c \\in U|c{\\text{ is not a lion\\}, }}\">A = \\{ c \\in U|c{\\text{ is not a lion\\}, }}</span> find <span data-math=\"A'\">A'</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"A'\"></span> represents the complement of set <i>A</i>. The complement of set <i>A</i> is the set of all elements in the universal set <i>U</i> that are <i>not</i> in set <i>A</i>. List the elements of <i>U</i> that are not in <i>A</i>. Because <i>A</i> includes the cats that are not lions, the complement will include the cats that are lions.</p>\n<p><span data-math=\"A' = \\{c|c\\ {\\rm is\\ a\\ lion}\\} \"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"A' = \\{ c \\in U|c{\\text{ is a lion}}\\}\">A' = \\{ c \\in U|c{\\text{ is a lion}}\\}</span> or <span data-math=\"A' = \\{ c \\in U|c \\notin A\\}\">A' = \\{ c \\in U|c \\notin A\\}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
