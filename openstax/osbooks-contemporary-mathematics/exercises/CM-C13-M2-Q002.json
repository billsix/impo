 "questions": [
  {
   "id": 545594,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using the data in Your Turn 13.5, how much water would be saved in a month if one-third of a town’s population of 15,000 turned the faucet off when brushing their teeth except when rinsing?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Find one-third of a town’s population (15,000 people).</p>\n<p><span data-math=\"\\frac{1}{3}\\left( {15,000} \\right) = 5,000{\\rm{\\ people}}\"></span></p>\n<p>One person saves 210 gallons per month. Use this as a conversion factor.</p>\n<p><span data-math=\"5,000\\cancel{{{\\rm{people}}}}\\left( {\\frac{{210{\\rm{\\ gallons}}}}{{1{\\rm{ }}\\cancel{{{\\rm{person}}}}}}} \\right) = 1,050,000{\\rm{\\ people}}\"></span></p>\n<p>The town would save 1,050,000 gallons per month.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1,050,000 gal"
    }
   ],
   "community_solutions": []
  }
 ],
