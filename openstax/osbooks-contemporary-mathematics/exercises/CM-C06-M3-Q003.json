 "questions": [
  {
   "id": 518459,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Samuel needs to borrow $8,400 to pay for repairs to his small manufacturing facility. He manages to get a simple interest loan at 17.33%, to be paid after 6 months. How much interest will Samuel pay and what is Samuel’s loan payoff amount?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Remember that 6 months is 0.5 years.</p>\n<p><span data-math=\"I = P \\times r \\times t\"></span></p>\n<p><span data-math=\"I = 8,400 \\times 0.1733 \\times 0.5\"></span></p>\n<p>The interest is $727.86.</p>\n<p>The loan payoff is the sum of the principal and the interest.</p>\n<p><span data-math=\"T = P + I = 8,400 + 727.86 = \\$9,127.86\"></span></p>\n<p>The payoff is $9,127.86.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "He will pay $727.86 in interest, payoff is $9,127.86."
    }
   ],
   "community_solutions": []
  }
 ],
