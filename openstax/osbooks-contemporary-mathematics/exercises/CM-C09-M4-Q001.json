 "questions": [
  {
   "id": 526878,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which represents a reasonable value for the weight of a penny:<br>\n2.5 g or 2.5 kg",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A gram is about the weight of a paper clip. A penny weighs about the same as 2.5 paperclips, so 2.5 grams is reasonable."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "2.5 g"
    }
   ],
   "community_solutions": []
  }
