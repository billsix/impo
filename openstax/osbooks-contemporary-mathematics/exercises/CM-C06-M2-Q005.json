 "questions": [
  {
   "id": 516626,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A pharmacy offers students at a nearby college a discount. Jerry purchases ibuprofen, which had an original price of $15.80. The cost to Jerry after the student discount was $13.43. What is the percent discount for students at the pharmacy?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>sale price = original price – discount</p>\n<p>13.43 = 15.80 – discount</p>\n<p>discount = 2.37</p>\n<p>2.37 is what percent of 15.80?</p>\n<p>2.37 = percent discount × 15.80</p>\n<p><span data-math=\"\\frac{{2.37}}{{15.80}}{\\rm{ }}\"></span> = percent discount</p>\n<p>0.15 = percent discount</p>\n<p>The percent discount is 15%.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "15%"
    }
   ],
   "community_solutions": []
  }
 ],
