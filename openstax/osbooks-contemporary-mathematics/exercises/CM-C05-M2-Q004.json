 "questions": [
  {
   "id": 507814,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "On June 7, 2021, the national average price for regular gasoline was $3.053 per gallon. If Aiko fills up his car with 16 gallons, how much is the total cost? Round to the nearest cent.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The average price is $3.053 per gallon. Aiko fills up his car with 16 gallons.</p>\n<p>Total cost = <span data-math=\"16{\\rm{\\ gallons}}\\left( {\\frac{{3.053{\\rm{\\ dollars}}}}{{{\\rm{1\\ gallon}}}}} \\right) \\approx 48.85{\\rm{\\ dollars}}\"></span></p>\n<p>The total cost is $48.85.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Total cost is $48.85"
    }
   ],
   "community_solutions": []
  }
 ],
