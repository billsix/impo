     "images": [],
     "solution_type": "summary",
     "content_html": "This relation is not a function because there are repeated <i>x</i>-values. For example, the <i>x</i>-value 2 is matched with more than one <i>y</i>-value."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "This relation is not a function."
    }
