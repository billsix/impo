   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"\\left\\{ {\\left( {-3,-6} \\right),\\left( {-2,-4} \\right),\\left( {-1,-2} \\right),\\left( {0,0} \\right),\\left( {1,2} \\right),\\left( {2,4} \\right),\\left( {3,6} \\right)} \\right\\}\">\\left\\{ {\\left( {-3,-6} \\right),\\left( {--2,-4} \\right),\\left( {-1,-2} \\right),\\left( {0,0} \\right),\\left( {1,2} \\right),\\left( {2,4} \\right),\\left( {3,6} \\right)} \\right\\}</span>",
