     "images": [],
     "solution_type": "summary",
     "content_html": "This relation is a function because there are no repeated <i>x</i>-values. Each <i>x</i>-value is matched with only one <i>y</i>-value."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "This relation is a function."
    }
   ],
   "community_solutions": []
