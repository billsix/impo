   "stem_html": "<span data-math=\"{\\text{\\{ (8, - 4), (4, - 2), (2, - 1), (0,0), (2,1), (4,2), (8,4)\\} }}\">{\\text{\\{ (8, - 4), (4, - 2), (2, - 1), (0,0), (2,1), (4,2), (8,4)\\} }}</span>",
