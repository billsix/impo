 "questions": [
  {
   "id": 515436,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Josephine is trying to build her class schedule for next semester. Because of her work schedule, she has only 4 class periods that can work for her, and she must take 4 classes. If there are 15 classes that she could take during the first period, 18 during the second, 12 during the third, and 8 during the fourth, how many different schedules could Josephine build?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The Multiplication Rule of Counting says that if there are <i>n</i> ways to accomplish one task and <i>m</i> ways to accomplish a second task, then there are <span data-math=\"n{\\text{ }} \\times {\\text{ }}m\"></span> ways to accomplish both tasks. You can tack on additional tasks by multiplying the number of ways to accomplish those tasks to your previous product.</p>\n<p>Multiply the choices during each class period.</p>\n<p><span data-math=\"15{\\text{ }} \\times {\\text{ }}18{\\text{ }} \\times {\\text{ }}12{\\text{ }} \\times {\\text{ }}8{\\text{ }} = {\\text{ }}25,920\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "25,920"
    }
   ],
   "community_solutions": []
  }
 ],
