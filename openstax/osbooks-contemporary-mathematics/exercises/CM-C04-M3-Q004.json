   "stimulus_html": "",
   "stem_html": "Convert A3C<sub>14</sub> into base 10.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>In base 14,</p>\n<p>A represents the digit 10.</p>\n<p>B represents the digit 11.</p>\n<p>C represents the digit 12.</p>\n<p>D represents the digit 13.</p>\n<p>The place values are powers of 14 in base 14.</p>\n<p><span data-math=\"{\\rm{A3}}{{\\rm{C}}_{14}} = 10 \\times {14^2} + 3 \\times {14^1} + 12 \\times {14^0}\"></span></p>\n<p><span data-math=\"10 \\times 196 + 3 \\times 14 + 12 \\times 1\"></span></p>\n<p><span data-math=\"1,960 + 42 + 12\"></span></p>\n<p><span data-math=\"2,014\"></span></p>"
    },
    {
