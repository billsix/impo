 "is_vocab": false,
 "stimulus_html": "Decide whether the given probabilities were most likely derived theoretically, empirically, or subjectively.",
 "questions": [
  {
   "id": 515877,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A poker player has a 16% chance of making a hand called a flush on the next card.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This is theoretical because you know the composition of a deck and can calculate the chance of drawing a particular card."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "theoretically"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 515878,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Your friend Jacob tells you that there’s a 20% chance he’ll get married in the next 5 years.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Subjective. There is no good way to make measurements or collect data for this probability. A subjective probability is an assignment of a probability to an event using only one’s instincts."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "subjectively"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 515879,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ashley has a coin that they think might not be fair, so they flip it 100 times and note that the result was heads 58 times. So, Ashley says the probability of flipping heads on that coin is about 58%.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Empirical. They are using data from replications to calculate from experience, not from theoretical expected values."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "empirically"
    }
   ],
   "community_solutions": []
  }
