   "stimulus_html": "",
   "stem_html": "Solve the system by a method of your choice:\n<br>\n<span data-math=\"\\left\\{ \\begin{array}{rcl}{y}&amp;{ = }&amp;{\\frac{1}{3}x + 2} \\\\{x - 3y}&amp;{ = }&amp;{7} \\\\ \\end{array}  \\right.\">\\left\\{ \\begin{array}{rcl}{y}&amp;{ = }&amp;{\\frac{1}{3}x + 2} \\\\{x - 3y}&amp;{ = }&amp;{7} \\\\ \\end{array}  \\right.</span>",
   "answers": [],
