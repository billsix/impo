 "questions": [
  {
   "id": 508077,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A  person who weighs 170 pounds on Earth would weigh 64 pounds on Mars. Write this comparison as a ratio.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>There are three ways to write ratios: <i>a</i> to <i>b</i>, <i>a</i>:<i>b</i>, or <i>a</i>/<i>b</i>, which can be written with fraction notation <span data-math=\"\\left( {\\frac{a}{b}} \\right)\"></span>.</p>\n<p>If <span data-math=\"a = 170\"></span> pounds, and <span data-math=\"b = 64\"></span> pounds, the ratio can be written in one of three ways.</p>\n<p>170 to 64</p>\n<p>170:64</p>\n<p><span data-math=\"\\frac{{170}}{{64}}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "With <span data-math=\"a\">a</span> = 170 pounds on Earth, and <span data-math=\"b\">b</span> = 64 pounds on Mars, the ratio is  170 to 64; or 170:64; or <span data-math=\"\\frac{{170}}{{64}}\">\\frac{{170}}{{64}}</span>."
    }
   ],
   "community_solutions": []
  }
 ],
