 "questions": [
  {
   "id": 518279,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Maureen invests $5,000 in a bond with a maturity date in 5 years at a fixed coupon rate of 4.75%. How much is Maureen paid each year and how much does she receive on the maturity date?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use your knowledge of percents. Remember to convert the percentage to a decimal.</p>\n<p>3.1% of 500</p>\n<p><span data-math=\"part = percent \\times total\"></span></p>\n<p><span data-math=\"part = \\left( {0.0475} \\right)\\left( {5,000} \\right)\"></span><span data-math=\" = \\$ 237.50\"></span></p>\n<p>Maureen receives $237.50 per year.</p>\n<p>On the maturity date, she receives the interest and the initial payment.</p>\n<p><span data-math=\"237.50{\\text{ }} + {\\text{ }}5,000{\\text{ }} = {\\text{ }}\\$ 5,237.50\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$237.50 per year, $5,237.50 on maturity date."
    }
   ],
   "community_solutions": []
  }
 ],
