   "id": 517632,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If $5,600 is owed in taxes but there are $4,000 in tax credits, how much income tax is owed?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Subtract the tax credits to find the amount of tax owed.</p>\n<p>5,600 – 4,000 = $1,600</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$1,600"
    }
   ],
