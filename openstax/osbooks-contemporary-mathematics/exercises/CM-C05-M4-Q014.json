   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the following equation,<span data-math=\"\\frac{x}{{{\\text{46 }}}} = \\frac{{20}}{{90}} + 4\">\\frac{x}{{{\\text{46 }}}} = \\frac{{20}}{{90}} + 4</span>, cross multiplication can be used as the first step towards solving for <span data-math=\"x\">x</span>.",
   "answers": [
    {
     "id": 996526,
     "content_html": "True",
     "correctness": "0.0"
    },
    {
     "id": 996527,
