     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Cross multiplication cannot be used as the first step in this equation. You can only have a single rational expression on each side when you cross multiply. You would need to add the expressions on the right side so you had a single rational expression on the right."
    },
