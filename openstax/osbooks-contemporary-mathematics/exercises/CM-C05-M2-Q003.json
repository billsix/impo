 "questions": [
  {
   "id": 507811,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sam and Henry are roommates. Together, they have 68 books. Sam has 26 books. How many books does Henry have?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Let S = Sam’s books and H = Henry’s books.</p>\n<p>Together they have 68 books, so S + H = 68</p>\n<p>Sam has 26 books, so substitute 26 for S.</p>\n<p>26 + H = 68</p>\n<p>Solve for H.</p>\n<p>Step 1: Simplify each side as much as possible.</p>\n<p>26 + H = 68</p>\n<p>Step 2: Collect the variable terms on one side.</p>\n<p>26 + H = 68</p>\n<p>This is already done.</p>\n<p>Step 3: Collect the constant terms on the other side.</p>\n<p>26 + H – 26 = 68 – 26</p>\n<p>H = 42</p>\n<p>Step 4: Make the coefficient of the variable term equal to 1.</p>\n<p>H = 42</p>\n<p>You are already done. This is the solution.</p>\n<p>Step 5: Checking is left to you.</p>\n<p>Henry has 42 books.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Henry has 42 books."
    }
   ],
   "community_solutions": []
  }
 ],
