 "questions": [
  {
   "id": 518403,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Maureen invests $5,000 in a bond with a maturity date in 5 years at a fixed coupon rate of 4.75%. What is Maureen’s annual return on investment?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Maureen’s <i>FV</i> is the $5,000 she invested plus the $1,187.50 she earned for a total of $6,187.50. Her principal was $5,000. The time is 5 years.</p>\n<p>The annual return <span data-math=\" = {\\left( {\\frac{{{\\rm{FV}}}}{P}} \\right)^{\\left( {\\frac{1}{t}} \\right)}} - 1\"></span>, where <i>t</i> is the number of years, <i>FV</i> is the new value, and <i>P</i> is the starting principal. Convert the answer to a percent.</p>\n<p>annual return <span data-math=\" = {\\left( {\\frac{{{\\text{6}},{\\text{187}}.{\\text{50}}}}{{5,000}}} \\right)^{\\left( {\\frac{1}{5}} \\right)}} - 1{\\text{  =  4}}{\\text{.35% }}\"></span></p>\n<p>Maureen’s annual return on investment is 4.35 percent.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "4.35%"
    }
   ],
   "community_solutions": []
  }
 ],
