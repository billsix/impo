     "solution_type": "summary",
     "content_html": "<p>300 shares times $0.38 per share</p>\n<p><span data-math=\"{\\text{300(0}}{\\text{.38)  =  \\$114}}\"></span></p>\n<p>The person earns $114.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$114.00"
    }
