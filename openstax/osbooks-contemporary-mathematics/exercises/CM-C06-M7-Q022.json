   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A person owns 300 shares of stock. It pays $.38 per share this quarter. How much does the share owner earn from the stock that quarter?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
