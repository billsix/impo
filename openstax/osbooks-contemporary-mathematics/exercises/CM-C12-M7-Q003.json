   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The number of ways to arrange <i>n</i> distinct objects is <i>n</i>!.</p>\n<p>There are 5 letters, so there are 5! ways to arrange them.</p>\n<p><span data-math=\"5! = 5 \\cdot 4 \\cdot 3 \\cdot 2 \\cdot 1 = 120\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"5! = 5 \\cdot 4 \\cdot 3 \\cdot 2 \\cdot 1 = 120\">5! = 5 \\cdot 4 \\cdot 3 \\cdot 2 \\cdot 1 = 120</span>"
    }
