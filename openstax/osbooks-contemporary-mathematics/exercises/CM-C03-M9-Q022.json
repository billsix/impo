 "questions": [
  {
   "id": 506087,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The distance from Earth to the moon is <span data-math=\"1.514 \\times {10^{10}}\">1.514 \\times {10^{10}}</span> inches. The thickness of a dollar bill is <span data-math=\"4.3 \\times {10^{ - 3}}\">4.3 \\times {10^{ - 3}}</span>  inches. How many dollar bills must be stacked so the pile reaches the moon?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Divide to find the answer: <span data-math=\"1.514 \\times {10^{10}} \\div 4.3 \\times {10^{ - 3}}\"></span>.</p>\n<p>Step 1: Divide the number parts.</p>\n<p><span data-math=\"1.514 \\div 4.3 \\approx 0.3520930233\"></span></p>\n<p>Step 2: Subtract the exponents of the 10s.</p>\n<p><span data-math=\"10 - (-3) = 13\"></span></p>\n<p>Step 3: The result is the answer from Step 1 times 10 raised to the answer from Step 2.</p>\n<p><span data-math=\"0.3521 \\times {10^{13}}\"></span></p>\n<p>Step 4: If the answer is not in scientific notation, adjust it.</p>\n<p><span data-math=\"3.521 \\times {10^{12}}\"></span></p>\n<p>A pile of dollar bills that reaches the moon would contain approximately <span data-math=\"3.521 \\times {10^{12}}\"></span> dollar bills.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A pile of dollar bills that reaches the moon would contain <span data-math=\"3.521 \\times {10^{12}}\">3.521 \\times {10^{12}}</span>  bills."
    }
   ],
   "community_solutions": []
  }
 ],
