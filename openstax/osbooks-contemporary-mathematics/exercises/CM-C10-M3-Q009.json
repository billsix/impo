 "questions": [
  {
   "id": 533575,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A tree casts a shadow of 180 feet early in the morning. A 10-foot high garage casts a shadow of 30 feet at the same time in the morning. What is the height of the tree?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "\n<p>Set up a proportion to find the missing value. It helps some students to draw two separate triangles. Let <i>x</i> be the height of the tree in feet.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"\\frac{x}{{180}} = \\frac{{10}}{{30}}\"></span></td>\n<td>Multiply.</td>\n</tr>\n<tr>\n<td><span data-math=\"30x = 1,800\"></span></td>\n<td>Divide.</td>\n</tr>\n<tr>\n<td><span data-math=\"x = 60{\\rm{\\ feet}}\"></span></td>\n<td></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "60 ft"
    }
   ],
   "community_solutions": []
  }
 ],
