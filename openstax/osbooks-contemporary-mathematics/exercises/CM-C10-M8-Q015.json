 "questions": [
  {
   "id": 532956,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use the Pythagorean theorem to find the missing length in the triangle shown.<br>\n\n<img src=\"exercises/media/36e1d5b16520a117.png\" alt=\"A right triangle. The legs are labeled b and 3. The hypotenuse is labeled 3 times square root of 5.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The Pythagorean Theorem states <span data-math=\"{a^2} + {b^2} = {c^2}\"></span> where <i>a</i> and <i>b</i> are two sides (legs) of a right triangle and <i>c</i> is the hypotenuse.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"{3^2} + {b^2} = {\\left( {3\\sqrt 5 } \\right)^2}\"></span></td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><span data-math=\"9 + {b^2} = 45\"></span></td>\n<td>Simplify.</td>\n</tr>\n<tr>\n<td><span data-math=\"{b^2} = 36\"></span></td>\n<td>Subtract.</td>\n</tr>\n<tr>\n<td><span data-math=\"b = 6\"></span></td>\n<td>Use the Square Root Property. Lengths cannot be negative.</td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"b = 6\">b = 6</span>"
    }
   ],
   "community_solutions": []
  }
 ],
