 "questions": [
  {
   "id": 506185,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When <i>Streptococcus lactis</i> (<i>S. lactis</i>) is in a milk culture at 37°C, the population of <i>S. lactis</i> doubles in number every 30 minutes. If the culture began with 15 organisms, how many <i>S. lactis</i> bacteria are present in the culture after 20 hours?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>You can use geometric sequences to interpret exponential growth when numbers double every 30 minutes. The common ratio is 2. The first term is 15. The time interval is 30 minutes. In 20 hours, there are 40 of your 30-minute intervals.</p>\n<p><span data-math=\"{a_{20}} = 15{\\left( 2 \\right)^{19}} \\approx 1.6493 \\times {10^{13}}\"></span> bacteria</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "There are <span data-math=\"1.6493 \\times {10^{13}}\">1.6493 \\times {10^{13}}</span> organisms after 20 hours."
    }
   ],
   "community_solutions": []
  }
 ],
