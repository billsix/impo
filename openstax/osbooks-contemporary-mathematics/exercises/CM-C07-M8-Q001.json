 "stimulus_html": "Suppose you’re about to draw one card from a deck containing only these 10 cards: <span data-math=\"{\\text{A}}♡\">{\\text{A}}♡</span>, <span data-math=\"{\\text{A}}♠\">{\\text{A}}♠</span>, <span data-math=\"{\\text{A}}♣\">{\\text{A}}♣</span>, <span data-math=\"{\\text{A}}\\diamondsuit\">{\\text{A}}\\diamondsuit</span>, <span data-math=\"{\\text{K}}♠\">{\\text{K}}♠</span>, <span data-math=\"{\\text{K}}♣\">K♣</span>, <span data-math=\"{\\text{Q}}♡\">{\\text{Q}}♡</span>, <span data-math=\"{\\text{Q}}♠\">{\\text{Q}}♠</span>, <span data-math=\"{\\text{J}}♡\">{\\text{J}}♡</span>, <span data-math=\"{\\text{J}}♠\">{\\text{J}}♠</span>. Decide whether these events are mutually exclusive:",
 "questions": [
  {
   "id": 516368,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"E\">E</span> is the event “the card is an ace” and <span data-math=\"F\">F</span> is the event “the card is a king.”",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"E\"></span> = {A hearts, A spades, A clubs, A diamonds}</p>\n<p><span data-math=\"F\"></span> = {K hearts, K spades, K clubs, K diamonds}</p>\n<p>There are no outcomes in common.</p>\n<p>These are mutually exclusive.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Mutually exclusive\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 516369,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"R\">R</span> is the event “the card is a <span data-math=\"♡\">♡</span> ” and <span data-math=\"E\">E</span> is the event “the card is an ace.”\n",
   "answers": [],
   "hints": [],
