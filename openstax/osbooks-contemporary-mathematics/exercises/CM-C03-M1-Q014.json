 "questions": [
  {
   "id": 504745,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the number of different prime factors of 180.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Because 180 ends in 0, you know it has a factor of 10, which is 2 times 5. Factor out 2 and 5.</p>\n<p><span data-math=\"180 = 2 \\times 5 \\times 18\"></span></p>\n<p>18 is divisible by 2, so factor out 2 again.</p>\n<p><span data-math=\"180 = 2 \\times 2 \\times 5 \\times 9\"></span></p>\n<p>Factor 9.</p>\n<p><span data-math=\"180 = 2 \\times 2 \\times 5 \\times 3 \\times 3\"></span></p>\n<p>180 has three prime factors (2, 3, and 5).</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The number 180 has three prime factors."
    }
   ],
   "community_solutions": []
  }
 ],
