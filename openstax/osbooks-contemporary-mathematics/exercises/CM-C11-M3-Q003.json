 "is_vocab": false,
 "stimulus_html": "Table 11.9 contains a list of the five U.S. states ranked sixth through tenth in the number of representatives in the U.S. House of Representatives, along with the population of that state in 2021. Use the information in the table to answer the questions.\n<table>\n<thead>\n<tr>\n<th>State</th>\n<th>Representative Seats</th>\n<th>State Population</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>(IL) Illinois</td>\n<td>18\n</td><td>12,804,100</td>\n</tr>\n<tr>\n<td>(OH) Ohio</td>\n<td>16</td>\n<td>11,714,600</td>\n</tr>\n<tr>\n<td>(MI) Michigan</td>\n<td>14</td>\n<td>9,992,430</td>\n</tr>\n<tr>\n<td>(GA) Georgia</td>\n<td>14</td>\n<td>10,830,000</td>\n</tr>\n<tr>\n<td>(NC) North Carolina</td>\n<td>13</td>\n<td>10,701,000</td>\n</tr>\n</tbody>\n<tfoot>\n</tfoot><caption>The Sixth through Tenth Ranked U.S. States by Number of Representatives (sources: https://www.census.gov/popclock/ [state population], https://www.britannica.com/topic/United-States-House-of-Representatives-Seats-by-State-1787120 [representative seats])</caption>\n</table>\n",
 "questions": [
  {
   "id": 545080,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the ratio of State Population to Representative Seats for each state to the nearest hundred thousand?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Make a ratio of <span data-math=\"\\frac{{{\\text{State Population}}}}{{{\\text{Representative Seats}}}}\"></span> for each state to the nearest hundred thousand.</p>\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>State</th>\n<th><span data-math=\"\\frac{{{\\text{State Population}}}}{{{\\text{Representative Seats}}}}\"></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>IL</td>\n<td><span data-math=\"\\frac{{12,804,100}}{{18}} \\approx 700,000\"></span></td>\n</tr>\n<tr>\n<td>OH</td>\n<td><span data-math=\"\\frac{{11,714,600}}{{16}} \\approx 700,000\"></span></td>\n</tr>\n<tr>\n<td>MI</td>\n<td><span data-math=\"\\frac{{9,992,430}}{{14}} \\approx 700,000\"></span></td>\n</tr>\n<tr>\n<td>GA</td>\n<td><span data-math=\"\\frac{{10,830,000}}{{14}} \\approx 800,000\"></span></td>\n</tr>\n<tr>\n<td>NC</td>\n<td><span data-math=\"\\frac{{10,701,000}}{{13}} \\approx 800,000\"></span></td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "IL 700,000; OH 700,000; MI 700,000; GA 800,000; NC 700,000"
    }
   ],
   "community_solutions": []
  },
