   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A path that visits each vertex exactly once is a Hamilton path. Recall that a path is a walk that has no repeated vertices or edges. It does not need to start and end on the same vertex.</p>\n<p>This sequence is impossible since <i>c</i> and <i>d</i> are not adjacent.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "No"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544512,
