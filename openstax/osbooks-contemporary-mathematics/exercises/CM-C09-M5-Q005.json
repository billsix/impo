   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which represents a reasonable value for temperature of a hot summer day:<br>\n<ul>\n<li>102 °C,</li>\n<li>37 °C, or</li>\n<li>20 °C?</li>\n</ul>",
   "answers": [],
