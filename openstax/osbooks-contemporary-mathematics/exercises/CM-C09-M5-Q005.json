     "images": [],
     "solution_type": "summary",
     "content_html": "The lesson mentioned that a sample temperature in a hot desert was 104°F or 49°C. Of these choices, 37°C is the most reasonable."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "37 °C"
    }
   ],
