  {
   "id": 511631,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Mitchell currently sells stoves for company A at a salary of $12,000 plus a $150 commission for each stove he sells. Company B offers him a position with a salary of $24,000 plus a $50 commission for each stove he sells. How many stoves would Mitchell need to sell for the options to  equal?",
   "answers": [],
