   ],
   "combo_choices": []
  },
  {
   "id": 511633,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Andrea and Bart go to the local farmers market to purchase some fruit. Andrea buys 4 apples and 5 oranges, which cost $3.10; Bart buys 4 apples and 6 oranges, which cost $3.40. What is the cost of an orange? What is the cost of an apple?",
   "answers": [],
