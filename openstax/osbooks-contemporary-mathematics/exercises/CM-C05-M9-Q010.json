  },
  {
   "id": 511630,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Drew burned 1,800 calories Friday playing 1 hour of basketball and canoeing for 2 hours. Saturday she spent 2 hours playing basketball and 3 hours canoeing and burned 3,200 calories. How many calories did she burn per hour when playing basketball? How many calories did she burn per hour when canoeing?",
   "answers": [],
