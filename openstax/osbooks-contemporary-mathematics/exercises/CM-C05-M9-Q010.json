   ],
   "combo_choices": []
  },
  {
   "id": 511632,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The total number of calories in 2 hot dogs and 3 cups of cottage cheese is 960 calories. The total number of calories in 5 hot dogs and 2 cups of cottage cheese is 1,190 calories. How many calories are in a hot dog? How many calories are in a cup of cottage cheese?",
   "answers": [],
   "hints": [],
   "formats": [
