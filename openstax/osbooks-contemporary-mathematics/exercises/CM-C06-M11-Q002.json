 "questions": [
  {
   "id": 519447,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Carlos buys a car with a negotiated price of $36,250. The sales tax in his region is 6.5%. The dealer charges a $1,200 destination fee and a $450 documentation fee. He must pay for title, registration, and license plates, which come to $21.50. If he has a $7,500 down payment, how much will he have to finance?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Find 6.5% of $36,250.</p>\n<p><span data-math=\"0.065{\\text{ }} \\times {\\text{ }}36,250{\\text{ }} = {\\text{ }}\\$2,356.25\"></span></p>\n<p>Add this to the cost and fees.</p>\n<p><span data-math=\"36,250{\\text{ }} + {\\text{ }}2,356.25{\\text{ }} + {\\text{ }}1,200{\\text{ }} + {\\text{ }}450{\\text{ }} + {\\text{ }}21.20{\\text{ }} = {\\text{ }}\\$40,277.75\"></span></p>\n<p>The car’s total cost is 40,277.75.</p>\n<p>Subtract the $7,500 down payment to get $32,777.75.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$32,777.75"
    }
   ],
   "community_solutions": []
  }
 ],
