 "questions": [
  {
   "id": 545546,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "List the 12 notes forming an octave, beginning with the note G.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Begin with one note and find the next eleven consecutive half-notes to form an octave.</p>\n<p>Start from G and count one key up each time until you have 12 total notes.</p>\n<p>G, G#, A, A#, B, C, C#, D, D#, E, F, F#</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "G, G<sup>#</sup>, A, A<sup>#</sup>, B, C, C<sup>#</sup>, D, D<sup>#</sup>, E, F, F<sup>#</sup>"
    }
   ],
   "community_solutions": []
  }
 ],
