 "is_vocab": false,
 "stimulus_html": "Powerball<sup>®</sup> is a multistate lottery game, which costs $2 to play. Players fill out a ticket by choosing 5 numbers between 1 and 69 (these are the white balls) and then a single number between 1 and 26 (this is the Powerball).",
 "questions": [
  {
   "id": 515735,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many different ways are there to choose the white balls? Players who match these 5 numbers exactly (but not the Powerball) win $1 million.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 515736,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many ways are there to choose the Powerball? Players who correctly pick the Powerball win $4.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 515737,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many ways are there to play the game altogether? Players who match all 5 white balls and the Powerball win (or share) the grand prize. (The grand prize starts at $40 million; if no players win the grand prize, the value goes up for the next drawing. The highest value it has ever reached is $1.586 <i>billion</i>!) How many ways are there to fill out a single Powerball ticket?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  }
 ],
