 "questions": [
  {
   "id": 508107,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A toy Jeep is built on a <span data-math=\"1:16\">1:16</span> scale. The website for the toy Jeep says the toy is <span data-math=\"11.5\">11.5</span> inches long. Based on this, how long is the real Jeep?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Let <i>x</i> = the length of the real Jeep.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>&nbsp;</td>\n<td>Scale</td>\n<td>What I know or want to know</td>\n</tr>\n<tr>\n<td>toy Jeep</td>\n<td>1</td>\n<td>11.5 inches</td>\n</tr>\n<tr>\n<td>real Jeep</td>\n<td>16</td>\n<td><i>x</i></td>\n</tr>\n</tbody>\n</table>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"\\frac{1}{{16}} = \\frac{{11.5}}{x}\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"x = \\left( {16} \\right)\\left( {11.5} \\right)\"></span></td>\n<td>Cross multiply.</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"x = 184{\\rm{\\ inches  =  15\\ feet\\  4\\ inches}}\"></span></p>\n<p>The real Jeep is 184 inches long. You can also express your answer as 15 feet 4 inches or as 15’ 4”.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "184 inches, or 15 feet, 4 inches."
    }
   ],
   "community_solutions": []
  }
 ],
