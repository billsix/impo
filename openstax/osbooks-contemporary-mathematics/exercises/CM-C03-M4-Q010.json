   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"95 \\div 26\"></span> is 3 with a remainder. What is that remainder?</p>\n<p><span data-math=\"26 \\times 3 = 78\"></span></p>\n<p><span data-math=\"95-78 = 17\"></span></p>\n<p>The remainder is 17.</p>\n<p>So, write <span data-math=\"\\frac{{95}}{{26}}\"></span> as <span data-math=\"3\\frac{{17}}{{26}}\"></span>.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"3\\frac{{17}}{{26}}\">3\\frac{{17}}{{26}}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
