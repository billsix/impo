 "questions": [
  {
   "id": 526550,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A bolt of fabric has an area of 136.5 m<sup>2</sup>. What is the area of the bolt of fabric in square centimeters?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Prefix</td>\n<td>kilo-</td>\n<td>hecto-</td>\n<td>deca-</td>\n<td>base</td>\n<td>deci-</td>\n<td>centi-</td>\n<td>milli-</td>\n</tr>\n<tr>\n<td>Abbreviation</td>\n<td>k</td>\n<td>h</td>\n<td>da</td>\n<td>&nbsp;</td>\n<td>d</td>\n<td>c</td>\n<td>m</td>\n</tr>\n<tr>\n<td>Magnitude</td>\n<td>10<sup>3</sup></td>\n<td>10<sup>2</sup></td>\n<td>10<sup>1</sup></td>\n<td>1</td>\n<td>10<sup>−1</sup></td>\n<td>10<sup>−2</sup></td>\n<td>10<sup>−3</sup></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"136.5{\\cancel{{{\\rm{meters}}}}^2}{\\left( {\\frac{{100{\\rm{\\ centimeters}}}}{{{\\rm{1 }}\\cancel{{{\\rm{meter}}}}}}} \\right)^2} = 136.5 \\times 10,000{\\rm{\\ c}}{{\\rm{m}}^2}\\,{\\rm{ = }}\\,1,365,000{\\rm{\\ c}}{{\\rm{m}}^2}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1,365,000 cm<sup>2</sup>"
    }
   ],
   "community_solutions": []
  }
 ],
