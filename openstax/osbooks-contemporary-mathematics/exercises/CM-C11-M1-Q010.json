 "questions": [
  {
   "id": 544815,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A pairwise comparison matrix is given. Determine the winner by the pairwise comparison method. If there is not a winner, explain why. If there is a winner, tell whether the winner is a Condorcet candidate.<br>\n<figure>\n<figcaption> A Pairwise Comparison Matrix</figcaption>\n<img src=\"exercises/media/6b8fc875dabebb93.png\" alt=\"A table shows the pairwise comparison between P, Q, R, S, T, and Z. The data given in the table are as follows. The table shows six rows and seven columns. The column headers are Runner and Opponent, P, Q, R, S, T, and Z. Column one shows P wins, Q wins, R wins, S wins, T wins, and Z wins. Column two shows Nil, Q P 5, R P 2, S P 0, T P 2, and Z P 1. Column three shows P Q 1, Nil, R Q 0, S Q 2, T Q 5, and Z Q 4. Column four shows P R 4, Q R 6, Nil, S R 1, T R 2, and Z R 5. Column five shows P S 6, Q S 4, R S 5, Nil, T S 0, and Z S 1. Column six shows P T 4, Q T 1, R T 4, S T 6, Nil, and Z T 2. Column seven shows P Z 5, Q Z 2, R Z 1, S Z 5, T Z 4, and Nil.\"></figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Compare PQ 1 to QP 5. Because 1 is less than 5, PQ 1 is the loser. Cross out PQ 1.</p>\n<p>Compare PR 4 to RP 2. Because 2 is less than 4, RP 2 is the loser. Cross out RP 2.</p>\n<p>Compare PS 6 to SP 0. Because 0 is less than 6, SP 0 is the loser. Cross it out.</p>\n<p>Continue comparing in this manner until you have completed the table. Because there are no 3s in the table, there will be no ties.</p>\n<p>A win earns 1 point, a tie earns a half point, and a loss earns nothing.</p>\n<p>P has 4 wins (1 point each) for 4 points.</p>\n<p>Q has 3 wins (1 point each) for 3 points.</p>\n<p>R has 2 wins (1 point each) for 2 points.</p>\n<p>S has 2 wins (1 point each) for 2 points.</p>\n<p>T has 2 wins (1 point each) for 2 points.</p>\n<p>Z has 2 wins (1 point each) for 2 points.</p>\n<p>Candidate P wins with 4 points. P is not a Condorcet winner because P lost to Q.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Candidate P wins. Candidate P is not a Condorcet candidate because P lost to Candidate Q."
    }
   ],
   "community_solutions": []
  }
 ],
