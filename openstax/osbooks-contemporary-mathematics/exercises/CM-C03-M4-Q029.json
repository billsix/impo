 "questions": [
  {
   "id": 505858,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  is the total if 25% of the total is 30?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>25% of the total is 30.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>Rewrite “of” as multiplication.</td>\n<td><span data-math=\"\\frac{{25}}{{100}} \\times 30\"></span></td>\n</tr>\n<tr>\n<td>Use your calculator.</td>\n<td><span data-math=\"120\"></span></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "120"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 505859,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  is the total if 45% of the total is 360?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>45% of the total is 360.</p>\n<p><span data-math=\"n\\% \"></span> of <span data-math=\"x\"></span> items is <span data-math=\"\\frac{n}{{100}} \\times x\"></span>.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>Rewrite “of” as multiplication and “is” as equals.</td>\n<td><span data-math=\"\\frac{{45}}{{100}} \\times total = 360\"></span></td>\n</tr>\n<tr>\n<td>Multiply both sides by <span data-math=\"\\frac{{100}}{{45}}\"></span>.</td>\n<td><span data-math=\"\\frac{{100}}{{45}}\\left({\\frac{{45}}{{100}} \\times total} \\right) = \\left({360} \\right)\\left({\\frac{{100}}{{45}}} \\right)\"></span></td>\n</tr>\n<tr>\n<td></td>\n<td><span data-math=\"\\frac{{\\cancel{{100}}}}{{\\cancel{{45}}}}\\left({\\frac{{\\cancel{{45}}}}{{\\cancel{{100}}}} \\times total} \\right) = \\left({360} \\right)\\left({\\frac{{100}}{{45}}} \\right)\"></span></td>\n</tr>\n<tr>\n<td></td>\n<td><span data-math=\"total = 800\"></span></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "800"
    }
   ],
   "community_solutions": []
  }
 ],
