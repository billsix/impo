 "questions": [
  {
   "id": 544423,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the figure shown. Is the circuit <i>a</i> → <i>b</i> → <i>f</i> → <i>e</i> → <i>h</i> → <i>i</i> → <i>g</i> → <i>d</i> → <i>c</i> → <i>a</i> an Euler circuit, a Hamilton cycle, or both?\n<figure>\n<figcaption>Graph <i>T</i></figcaption>\n<img src=\"exercises/media/83285ad6f3f76536.png\" alt=\"Graph T has 9 vertices. The edges connect a b, b f, f e, e h, h i, I g, g d, d c, and c a.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Euler circuits visit every edge exactly once. Hamilton cycles visit every vertex exactly once. This circuit does both, so it is both an Euler circuit and a Hamilton cycle."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "both"
    }
   ],
   "community_solutions": []
  }
 ],
