 "questions": [
  {
   "id": 507099,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Determine which of −38 and 27 is larger using a number line, and express that using both the greater than and the less than notations.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<br>\n<img src=\"https://exercises.openstax.org/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBBdTRJIiwiZXhwIjpudWxsLCJwdXIiOiJibG9iX2lkIn19--1d5381dededc01b51a976d3e4e9994b55808efd1/CS_Figure_03_02_010.jpg\" alt=\"A number line ranges from negative 42 to 30, in increments of 6. Two points are marked at negative 38 and 27.\">\n<br>\n<span data-math=\"27 >  - 38\">27 &gt;  - 38</span> and <span data-math=\"- 38 < 27\">- 38 &lt; 27</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Consider a number line with one tick mark for every integer. To graph –38, you move 38 tick marks to the left of zero. To graph 27, you move 27 tick marks to the right of zero.</p>\n<p>–38 is farther left than 27, so –38 is less than 27.</p>\n<p><span data-math=\"–38 < 27\"></span></p>\n<p><span data-math=\"27 > –38\"></span></p>"
    }
   ],
   "community_solutions": []
  }
 ],
