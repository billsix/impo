  {
   "id": 515582,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Your class is going on a field trip, but there are too many people for one vehicle. Your instructor chooses half the class to take the first vehicle.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "It does not matter in what order the instructor names the students to go in the first vehicle. They are all going in the same vehicle, no matter how the names are called. This is a combination."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "combination"
    }
   ],
