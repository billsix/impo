 "stimulus_html": "Decide whether the following represent permutations or combinations:",
 "questions": [
  {
   "id": 515581,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "On Halloween, you give each kid who comes to your door 3 pieces of candy, taken randomly from a candy dish.",
   "answers": [],
   "hints": [],
   "formats": [
