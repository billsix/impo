 "questions": [
  {
   "id": 517207,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A retailer buys an item for $311.00. What is the retail price if their markup is 60%?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>markup = percent markup × cost</p>\n<p>markup = 0.60 × $311</p>\n<p>markup = $186.60</p>\n<p>retail price = cost + markup</p>\n<p>retail price = 311 + 186.60 = $497.60</p>\n<p>The price after the markup is $497.60.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$497.60"
    }
   ],
   "community_solutions": []
  }
 ],
