 "stimulus_html": "Which of the following numbers are in scientific notation? If the number is not in scientific notation, explain why it is not.",
 "questions": [
  {
   "id": 505727,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"{\\text{42}}{\\text{.67}} \\times {10^{13}}\">{\\text{42}}{\\text{.67}} \\times {10^{13}}</span>",
   "answers": [],
