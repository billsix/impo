   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>This is not a product of a number between 1 and 9 multiplied by 10 raised to an integer power.</p>\n<p>42.67 is bigger than 9.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Is not written in scientific notation; 42.67 is not at least 1 and less than 10."
    }
   ],
