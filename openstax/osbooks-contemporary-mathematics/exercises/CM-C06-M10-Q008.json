  {
   "id": 519337,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The billing cycle for a credit card goes from April 1 to April 30. The balance at the start of the billing cycle is $1,598.00. The list of transactions on the card is below. Find the average daily balance for the billing cycle.\n<br>\n<table class=\"unnumbered\" summary=\".\">\n<thead>\n<tr>\n<th>Date</th>\n<th>Activity</th>\n<th>Amount</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1-Apr</td>\n<td> Billing Date Balance</td>\n<td>$1,598.00</td>\n</tr>\n<tr>\n<td>9-Apr</td>\n<td>Gasoline</td>\n<td>$51.24</td>\n</tr>\n<tr>\n<td>9-Apr</td>\n<td>Food</td>\n<td>$105.56</td>\n</tr>\n<tr>\n<td>9-Apr</td>\n<td>Payment</td>\n<td>$675.00</td>\n</tr>\n<tr>\n<td>13-Apr</td>\n<td>Camping Trip</td>\n<td>$229.75</td>\n</tr>\n<tr>\n<td>21-Apr</td>\n<td>Gasoline</td>\n<td>$38.45</td>\n</tr>\n<tr>\n<td>22-Apr</td>\n<td>Gifts</td>\n<td>$148.88</td>\n</tr>\n<tr>\n<td>22-Apr</td>\n<td>Food</td>\n<td>$49.75</td>\n</tr>\n<tr>\n<td>30-Apr</td>\n<td>Gym Payment</td>\n<td>$74.99</td>\n</tr>\n</tbody>\n</table>",
