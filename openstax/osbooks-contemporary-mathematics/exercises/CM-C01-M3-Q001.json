 "questions": [
  {
   "id": 494475,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Write the relationship between the sets in the following Venn diagram, in words and symbolically.\n<figure>\n<img src=\"exercises/media/d13c9f358eb3f08c.png\" alt=\"A single-set Venn diagram is shaded. Outside the set, it is labeled as 'L equals Lions.' Outside the Venn diagram, 'Parallelograms' is labeled.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><i>L</i> is a subset of <i>U</i> if every element of <i>L</i> is a member of <i>U</i>. Because all lions are cats, every member of the set of Lions is a member of the set of Cats.</p>\n<p><span data-math=\"L \\subset C\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The set of lions is a subset of the universal set of cats. In other words, the Venn diagram depicts the relationship that all lions are cats. This is expressed symbolically as <span data-math=\"{L} \\subset {U}\">{L} \\subset {U}</span>."
    }
   ],
   "community_solutions": []
  }
 ],
