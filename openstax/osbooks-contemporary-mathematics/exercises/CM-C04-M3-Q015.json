   "id": 225453,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A six-digit base 12 number is converted into a base 10 number. The base 10 number has five digits. Was an error committed? How do you know?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Since 12 is larger than 10, the base 10 number cannot have less digits than the base 12 number. Since it did, we know an error has been made."
    }
   ],
   "community_solutions": []
  }
