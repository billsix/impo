 "questions": [
  {
   "id": 516671,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Tina has opened a retail shop and purchased a unique hat for resale. Tina uses a 50% markup and sells the hat for $57.00. How much did the hat cost Tina?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>retail price = cost × (1 + percent markup)</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>57 = cost × (1 + 0.50)</td>\n<td></td>\n</tr>\n<tr>\n<td>57 = cost × (1.5)</td>\n<td>Divide by 1.5.</td>\n</tr>\n<tr>\n<td>$38 = cost</td>\n<td></td>\n</tr>\n<tr>\n<td>Tina’s cost is $38.</td>\n<td></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$38.00"
    }
   ],
   "community_solutions": []
  }
 ],
