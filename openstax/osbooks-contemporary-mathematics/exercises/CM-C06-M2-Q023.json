 "questions": [
  {
   "id": 517211,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the sales tax is 6.8%, what is the total price for an item that has a purchase price of $39.95?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>sales tax = purchase price × tax rate</p>\n<p>sales tax = 39.95 × 0.068</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>sales tax = $2.72</td>\n<td>(rounded to the nearest cent)</td>\n</tr>\n</tbody>\n</table>\n<p>total price = purchase price + sales tax = 39.95 + 2.72 = $42.67</p>\n<p>The total price is $42.67.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$42.67"
    }
   ],
   "community_solutions": []
  }
 ],
