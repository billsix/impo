   "id": 227973,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Determine whether the following statement is true or false and explain your reasoning: Any ranked election that violates the Condorcet criterion also violates the majority criterion.",
   "answers": [],
   "hints": [],
