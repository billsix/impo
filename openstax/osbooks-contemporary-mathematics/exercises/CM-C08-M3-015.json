 "questions": [
  {
   "id": 337393,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Workers for a particular company have complained that their wages are too low, while the management says wages are plenty high. If the company’s salaries are right-skewed, which measure of centrality will the workers choose to represent salary? Which will management choose?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Since the data are right skewed, the mean will be bigger than the mean. Thus, the workers would rather use the median, while the management will prefer the mean."
    }
   ],
   "community_solutions": []
  }
