 "questions": [
  {
   "id": 516669,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Maggie does some research into textbook costs. The <i>Sociology of the Family</i> text she finds sells for $234.36 but costs the store only $189.00. What is the percent markup on the sociology book?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>retail price = cost + markup</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>234.36 = 189 + markup</td>\n<td>Subtract 189.</td>\n</tr>\n</tbody>\n</table>\n<p>45.36 = markup</p>\n<p>The markup is what percent of cost?</p>\n<p>45.36 is what percent of 189?</p>\n<p>45.36 = percent markup × 189</p>\n<p><span data-math=\"\\frac{{45.36}}{{189}}\"></span> = percent markup</p>\n<p>0.24 = percent markup</p>\n<p>24% = percent markup</p>\n<p>The percent markup is 24 percent.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "24%"
    }
   ],
   "community_solutions": []
  }
 ],
