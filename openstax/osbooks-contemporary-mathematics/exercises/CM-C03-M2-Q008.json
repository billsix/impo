 "questions": [
  {
   "id": 504830,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use your calculator to calculate (−18) + 11. Explain how the answer agrees with what was expected.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Use your calculator to find that (–18) + 11 is –7. Because you are adding numbers with opposite signs, the sign of the answer matches the sign of the integer with the larger absolute value. Because |–18| &gt; |11|, the sign of the answer matches the sign of –18."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "−7. Since |−18| &gt; |11|, the answer matches the sign of −18."
    }
   ],
   "community_solutions": []
  }
 ],
