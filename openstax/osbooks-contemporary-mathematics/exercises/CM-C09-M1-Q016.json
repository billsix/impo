   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Prefix</td>\n<td>kilo-</td>\n<td>hecto-</td>\n<td>deca-</td>\n<td>base</td>\n<td>deci-</td>\n<td>centi-</td>\n<td>milli-</td>\n</tr>\n<tr>\n<td>Abbreviation</td>\n<td>k</td>\n<td>h</td>\n<td>d</td>\n<td>&nbsp;</td>\n<td>d</td>\n<td>c</td>\n<td>m</td>\n</tr>\n<tr>\n<td>Magnitude</td>\n<td>10<sup>3</sup></td>\n<td>10<sup>2</sup></td>\n<td>10<sup>1</sup></td>\n<td>1</td>\n<td>10<sup>−1</sup></td>\n<td>10<sup>−2</sup></td>\n<td>10<sup>−3</sup></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"750\\cancel{{{\\rm{kilometers}}}}\\left( {\\frac{{1000{\\rm{ }}\\cancel{{{\\rm{meters}}}}}}{{{\\rm{1 }}\\cancel{{{\\rm{kilometer}}}}}}} \\right)\\left( {\\frac{{1,000{\\rm{\\ millimeters}}}}{{1{\\rm{ }}\\cancel{{{\\rm{meter}}}}}}} \\right) = 750,000,000{\\rm{\\ millimeters}}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "750,000,000 mm"
    }
   ],
