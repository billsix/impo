 "questions": [
  {
   "id": 504787,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify which of the following numbers are prime and which are composite.\n<br>\n31, 56, 213, 48, 701",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>31 and 701 are prime.</p>\n<p>The rest are composite: 56, 213, 48.</p>\n<p><span data-math=\"56 = 2 \\times 2 \\times 2 \\times 7\"></span></p>\n<p><span data-math=\"213 = 3 \\times 71\"></span></p>\n<p><span data-math=\"48 = 2 \\times 2 \\times 2 \\times 2 \\times 3\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "31 and 701 are prime. 56, 213 and 48 are composite."
    }
   ],
   "community_solutions": []
  }
 ],
