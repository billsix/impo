 "is_vocab": false,
 "stimulus_html": "If you flip a fair coin 50 times, the probability of getting 20 or fewer heads is about 10.1% (a fact we’ll learn how to verify later).",
 "questions": [
  {
   "id": 515886,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If <span data-math=\"E\">E</span> is the event “number of heads is 20 or fewer”, describe the event <span data-math=\"E^{\\prime}\">E^{\\prime}</span> using an inequality.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"{\\text{number of heads}} > 20\">{\\text{number of heads}} &gt; 20</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The complement of <i>E</i> is the collection of all the outcomes that are not in <i>E</i>.</p>\n<p><i>E</i> is 20 or fewer heads.</p>\n<p>The complement of <i>E</i> is the number of heads is &gt; 20.</p>\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 515887,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find <span data-math=\"P(E^{\\prime} )\">P(E^{\\prime} )</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The P(complement of <i>E</i>) = 1 – P(<i>E</i>) = 1 – 10.1 = 89.9%."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "89.9%"
    }
   ],
   "community_solutions": []
  }
 ],
