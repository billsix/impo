 "questions": [
  {
   "id": 504751,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the greatest common divisor of 270 and 99 by listing all divisors of each number.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Number</td>\n<td colspan=\"6\">Factors</td>\n</tr>\n<tr>\n<td>270</td>\n<td>2</td>\n<td>3</td>\n<td>3</td>\n<td>3</td>\n<td>5</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>99</td>\n<td>&nbsp;</td>\n<td>3</td>\n<td>3</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>11</td>\n</tr>\n<tr>\n<td>Common</td>\n<td>&nbsp;</td>\n<td>3</td>\n<td>3</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>\nGreatest common divisor is the product of the common factors: <span data-math=\"3 \\times 3 = 9\"></span>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The GCD is 9."
    }
   ],
   "community_solutions": []
  }
 ],
