   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the perimeter of the regular pentagon with side length of 6 cm.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A regular pentagon has five sides of equal length. Therefore, the perimeter of a regular pentagon with a side length of 6 cm is:</p>\n<p><span data-math=\"P = 5(6{\\rm{\\ cm) = 30\\ cm}}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"6(5) = 30\\text{ cm}\">6(5) = 30\\text{ cm}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
