 "stimulus_html": "Write the negation of each statement in words without using the phrase, <i>it is not the case that</i>.",
 "questions": [
  {
   "id": 496603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jackie played softball or she ran track.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"p \\vee q\\; \\equiv \"></span> Jackie played softball or she ran track</p>\n<p><span data-math=\"p:\"></span> Jackie played softball.</p>\n<p><span data-math=\"q:\"></span> Jackie ran track.</p>\n<p>Negations:</p>\n<p><span data-math=\"\\text{~}p:\"></span> Jackie did not play softball.</p>\n<p><span data-math=\"\\text{~}q:\"></span> Jackie did not run track.</p>\n<p>Use De Morgan’s Law:</p>\n<p><span data-math=\"\\text{~}(p \\vee q) \\equiv \\;\\text{~}p \\wedge \\text{~}q\"></span></p>\n<p>The negation <span data-math=\"\\text{~}(p \\vee q)\"></span> is equivalent to <span data-math=\"\\text{~}p \\wedge \\text{~}q\"></span>.</p>\n<p>Jackie did not play softball and she did not run track.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Jackie did not play softball and she did not run track."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 496604,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Brandon studied for his certification exam, and he passed his exam.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"p \\wedge q = \"></span> Brandon studied for his certification exam, and he passed his exam.</p>\n<p><span data-math=\"p:\"></span> Brandon studied for his certification exam.</p>\n<p><span data-math=\"q:\"></span> Brandon passed his exam.</p>\n<p>Negations:</p>\n<p><span data-math=\"\\text{~}p:\"></span> Brandon did not study for his certification exam.</p>\n<p><span data-math=\"\\text{~}q:\"></span> Brandon did not pass his exam.</p>\n<p>Use De Morgan’s Law:</p>\n<p><span data-math=\"\\text{~}(p \\wedge q) \\equiv \\;\\text{~}p \\vee \\text{~}q\"></span></p>\n<p>Brandon did not study for his certification exam, or he did not pass his exam.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<p>Brandon did not study for his certification exam, or he did not pass his exam.</p>"
    }
   ],
   "community_solutions": []
  }
 ],
