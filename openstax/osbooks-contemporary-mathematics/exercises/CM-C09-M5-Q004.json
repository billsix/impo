 "questions": [
  {
   "id": 340478,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To make candy apples, you must boil the sugar mixture for about 20 minutes. Which is the more reasonable value for the temperature of the mixture when boiling:<br>\n<ul>\n<li>48 °C or</li>\n<li>148 °C?</li>\n</ul>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Recall that water boils at 100 °C. The more reasonable value for the temperature of the mixture is 148 °C. So, 48 °C is not sufficient to bring the mixture to a boil."
    }
   ],
   "community_solutions": []
  }
