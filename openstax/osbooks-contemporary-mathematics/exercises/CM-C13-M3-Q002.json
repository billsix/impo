 "questions": [
  {
   "id": 545440,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many pills would be needed for a patient who has been prescribed 25.5 mg of a drug if each pill contains 4.25 mg.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Make a conversion factor out of the fact that one pill is 8.5 mg of the drug.</p>\n<p><span data-math=\"25.5{\\rm{ }}\\cancel{{{\\rm{mg}}}}\\left( {\\frac{{1{\\rm{\\ pill}}}}{{4.25\\cancel{{{\\rm{mg}}}}}}} \\right) = 6{\\rm{\\ pills}}\"></span></p>\n<p>The patient would need 6 pills.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "6 pills"
    }
   ],
   "community_solutions": []
  }
 ],
