 "questions": [
  {
   "id": 518491,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Kentaro will invest some money in a CD that yields 2.75% simple interest when invested for 5 years. How much must Kentaro invest so that after those 5 years his CD is worth $12,000?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The present value, <i>PV</i>, of money deposited at an annual, simple interest rate of <i>r</i> (in decimal form) for time <i>t</i> (in years) with a specified future value of <i>FV</i> is calculated with the formula <span data-math=\"PV = \\frac{{FV}}{{1 + rt}}\"></span>. Present value, in this calculation, is always rounded up. Otherwise, the future value may fall short of the target future value.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"PV = \\frac{{12,000}}{{1 + \\left( {0.0275} \\right)\\left( 5 \\right)}} = \\$ 10,549.46\"></span></td>\n<td>(rounded up to the next cent)</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$10,549.46"
    }
   ],
   "community_solutions": []
  }
 ],
