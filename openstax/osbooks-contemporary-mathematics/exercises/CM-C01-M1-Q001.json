   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Write a set consisting of four small hand tools that might be in a toolbox and label it with a capital <span data-math=\"T\">T</span>.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Set notation lists the elements inside curly braces, separated by commas. Your list may include different tools. Sets are usually designated with capital letters.</p>\n<span data-math=\"T = \\left\\{ {{\\rm{wrench,\\ screwdriver,\\ hammer,\\ pliers}}} \\right\\}\"></span>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "One possible solution: <span data-math=\"T = \\{ {\\text{wrench, screwdriver, hammer, plyers}}\\}\">T = \\{ {\\text{wrench, screwdriver, hammer, plyers}}\\} </span>."
    }
