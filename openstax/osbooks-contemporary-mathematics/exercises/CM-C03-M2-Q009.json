 "questions": [
  {
   "id": 504834,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use your calculator to calculate 38 − 100. Explain how the answer agrees with what was expected.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use your calculator to find that 38 – 100 is –62.</p>\n<p>Because 100 is larger than 38, you expect the difference to be negative.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "−62. Since a larger positive number was subtracted from a smaller positive number, a negative result was expected."
    }
   ],
   "community_solutions": []
  }
 ],
