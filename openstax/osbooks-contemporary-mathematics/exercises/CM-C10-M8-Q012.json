 "questions": [
  {
   "id": 532950,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You are flying a kite on a 60-foot string. The angle of elevation from the ground to the kite is <span data-math=\"{50^ \\circ}\">{50^ \\circ}</span>. How high above the ground is the kite?<br>\n<figure>\n<img src=\"exercises/media/fee4a6b29599fcf2.png\" alt=\"A right triangle. A kite is placed at the top of the triangle. The hypotenuse measures 60 feet. The angle made by the hypotenuse and the horizontal leg measures 50 degrees.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The sine of an angle is the opposite side divided by the hypotenuse: <span data-math=\"\\sin \\alpha = \\frac{{{\\text{opp}}}}{{{\\text{hyp}}}}\"></span>.</p>\n<p><span data-math=\"\\sin 50^\\circ = \\frac{y}{{60}}\"></span></p>\n<p><span data-math=\"y = 60\\left( {\\sin 50^\\circ } \\right)\"></span></p>\n<p><span data-math=\"y \\approx {\\text{ }}46\"></span> feet</p>\n<p>The kite is approximately 46 feet above the ground.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "46 ft"
    }
   ],
   "community_solutions": []
  }
 ],
