 "questions": [
  {
   "id": 526591,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which represents a reasonable value for the volume of a storage area:<br>\n8 m<sup>3</sup>, 8 cm<sup>3</sup>, or 8 mm<sup>3</sup>?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A cubic meter box would measure approximately one yard on each side. An 8 cubic meter space would make a reasonable storage area. The other measures would be much too small."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "8 m<sup>3</sup>"
    }
   ],
   "community_solutions": []
  }
 ],
