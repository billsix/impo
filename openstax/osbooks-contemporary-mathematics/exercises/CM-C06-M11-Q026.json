 "questions": [
  {
   "id": 519453,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "RJ wants to lease a Tahoe in Salt Lake City, Utah. Find the total cost of obtaining his lease if he has a $5,000.00 down payment, $225 in acquisition fees, a security deposit of $750.00, $500.00 in disposition fees, and sales tax of $4,092.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Add the values together.</p>\n<p><span data-math=\"{\\text{5,000  +  225  +  750  +  500  +  4,092  =  \\$10,567}}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$10,567.00"
    }
   ],
   "community_solutions": []
  }
 ],
