 "stimulus_html": "In the following exercises, use the information in the table below.\n<table class=\"unnumbered\" summary=\".\">\n<thead>\n<tr>\n<th>State</th>\n<th>Population</th>\n<th>Original House Size</th>\n<th>New House Size</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><b>A</b></td>\n<td>627</td>\n<td></td>\n<td></td>\n</tr><tr>\n<td><b>B</b></td>\n<td>1,287</td>\n<td>25</td>\n<td></td>\n</tr><tr>\n<td><b>C</b></td>\n<td>973</td>\n<td></td>\n<td><b>32</b></td>\n</tr><tr>\n<td><b>D</b></td>\n<td><b>815</b></td>\n<td></td>\n<td></td>\n</tr><tr>\n<td><b>E</b></td>\n<td>520</td>\n<td></td>\n<td></td>\n</tr><tr>\n<td><b>F</b></td>\n<td>1,510</td>\n<td>50</td>\n<td></td>\n</tr><tr>\n<td><b>G</b></td>\n<td>1,060</td>\n<td></td>\n<td><span data-math=\"\\bf{\\it{h}}\">h</span></td>\n</tr><tr>\n<td><b>H</b></td>\n<td><b>950</b></td>\n<td></td>\n<td></td>\n</tr><tr>\n<td><b>P</b></td>\n<td>1,222</td>\n<td>100</td>\n<td></td>\n</tr><tr>\n<td><b>Q</b></td>\n<td>473</td>\n<td></td>\n<td></td>\n</tr><tr>\n<td><b>R</b></td>\n<td><b>225</b></td>\n<td></td>\n<td><span data-math=\"\\bf{\\it{r}}\">r</span></td>\n</tr><tr>\n<td><b>K</b></td>\n<td>1,688</td>\n<td></td>\n<td></td>\n</tr><tr>\n<td><b>L</b></td>\n<td>7,912</td>\n<td>48</td>\n<td></td>\n</tr><tr>\n<td><b>M</b></td>\n<td><b>1,448</b></td>\n<td></td>\n<td><span data-math=\"\\bf{\\it{m}}\">m</span></td>\n</tr><tr>\n<td><b>T</b></td>\n<td>150</td>\n<td></td>\n<td></td>\n</tr><tr>\n<td><b>U</b></td>\n<td>250</td>\n<td></td>\n<td></td>\n</tr><tr>\n<td><b>V</b></td>\n<td>350</td>\n<td>50</td>\n<td><span data-math=\"\\bf{\\it{w}}\">w</span></td>\n</tr><tr>\n<td><b>W</b></td>\n<td><b>450</b></td>\n<td></td>\n<td></td>\n</tr>\n</tbody>\n</table>",
