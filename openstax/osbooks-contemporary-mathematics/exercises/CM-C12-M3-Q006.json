 "questions": [
  {
   "id": 542307,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose  that a Graph <i>M</i> is a complete graph and Graph <i>N</i> is the complement of <i>M</i>. What are the degrees of the vertices of Graph <i>N</i>? How do you know?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>You know the degrees will be 0.</p>\n<p>One way to find the complement of a graph is to draw the complete graph with the same number of vertices and remove all the edges that were in the original graph. Since the original graph is a complete graph, the complement will have no edges.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The degrees are 0. There are no adjacent vertices in Graph <i>N</i> since all vertices are adjacent in Graph <i>M</i>."
    }
   ],
   "community_solutions": []
  }
 ],
