 "questions": [
  {
   "id": 506183,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sophia deposited $4,000 in an account that earns 5.5% interest compounded yearly. After 20 years, Sophia withdrew all the money in the account to pay for her child’s college. How much money was in the account when Sophia withdrew the money?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>If you deposit <i>P</i> dollars in an account that earns interest compounded yearly, then the amount in the account, <i>A</i>, after <i>t</i> years is calculated with the formula: <span data-math=\"A = P{(1 + r)^t}\"></span>. This is a geometric sequence with constant ratio (1 + <i>r</i>) and first term <span data-math=\"{a_1} = P\"></span>.</p>\n<p><span data-math=\"A = P{(1 + r)^t} = 4,000{(1 + 0.055)^{20}} \\approx \\$ 11,671.03\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The amount in the account was $11,671.03 (rounded to two decimal places)."
    }
   ],
   "community_solutions": []
  }
 ],
