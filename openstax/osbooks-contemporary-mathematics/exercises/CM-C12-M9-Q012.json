 "stimulus_html": "For the following exercises, use the table to create a complete weighted graph in which the vertices are the given cities, and the weights are the distances between them.\n<br>\n<table class=\"unnumbered\" summary=\".\">\n<thead>\n<tr>\n<th>Cities</th>\n<th><i>U</i></th>\n<th><i>V</i></th>\n<th><i>W</i></th>\n<th><i>X</i></th>\n<th><i>Y</i></th>\n<th><i>Z</i></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><i>U</i></td>\n<td>0</td>\n<td>89</td>\n<td>37</td>\n<td>49</td>\n<td>54</td>\n<td>28</td>\n\n</tr><tr>\n<td><i>V</i></td>\n<td>89</td>\n<td>0</td>\n<td>76</td>\n<td>68</td>\n<td>92</td>\n<td>112</td>\n\n</tr><tr>\n<td><i>W</i></td>\n<td>37</td>\n<td>76</td>\n<td>0</td>\n<td>45</td>\n<td>52</td>\n<td>49</td>\n</tr>\n<tr>\n<td><i>X</i></td>\n<td>49</td>\n<td>68</td>\n<td>45</td>\n<td>0</td>\n<td>66</td>\n<td>47</td>\n</tr>\n<tr>\n<td><i>Y</i></td>\n<td>54</td>\n<td>92</td>\n<td>52</td>\n<td>66</td>\n<td>0</td>\n<td>29</td>\n</tr>\n<tr>\n<td><i>Z</i></td>\n<td>28</td>\n<td>112</td>\n<td>49</td>\n<td>47</td>\n<td>29</td>\n<td>0</td>\n</tr>\n</tbody>\n<caption>Distances between Cities <i>U, V, W, X, Y,</i> and <i>Z</i> in kilometers</caption>\n</table>",
