 "questions": [
  {
   "id": 518461,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Heather runs a silk screen t-shirt shop, and seeks a short-term loan to pay for new inventory (paints, blades, shirts). They secure a $3,700 simple interest loan for 60 days, at an annual rate of 18.99%. How much will borrowing the money cost Heather, and what is her loan payoff amount?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Remember that 60 days is <span data-math=\"\\frac{{60}}{{365}}\"></span> years.</p>\n<p><span data-math=\"I = P \\times r \\times t\"></span></p>\n<p><span data-math=\"I = 3,700 \\times 0.1899 \\times \\frac{{60}}{{365}}\"></span></p>\n<p>The interest is $115.51 (rounded to the nearest cent; interest is usually rounded up when paid to the lender).</p>\n<p>The loan payoff is the sum of the principal and the interest.</p>\n<p><span data-math=\"T = P + I = 3,700 + 115.50 = \\$3,815.50\"></span></p>\n<p>The loan payoff is $3,815.50.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The cost to borrow is $115.51 and their payoff is $3,815.51."
    }
   ],
   "community_solutions": []
  }
 ],
