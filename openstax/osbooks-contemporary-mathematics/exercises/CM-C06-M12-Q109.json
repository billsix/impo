 "stimulus_html": "Below is a portion of an amortization table for a 30-year, $228,320 mortgage. Use that table to answer the following questions.\n<figure>\n<figcaption>Amortization table</figcaption>\n<img src=\"exercises/media/ba7d92ac2068a5d0.png\" alt=\"A spreadsheet labeled as amortization schedule calculator. The sheet calculates the repayment for the loan amount of $228,320.00 for an interest rate of 6.10 percent annually and the monthly payment is $1383.61 over 30 years. The factors include calculations such as month, payment, principal, interest, total, and interest and balance.\">\n</figure>",
 "questions": [
  {
   "id": 519580,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the interest rate?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Look at the second row of the table to find the label “Interest Rate (annual).” Beside it, you will see the interest rate is 6.10%."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "6.1%"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 519581,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How much are the payments?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Look at the fifth row of the table to find the label “Monthly Payment.” To the right, you will see the monthly payment is $1,383.61."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$1,383.61"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 519582,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How much of payment 235 goes to principal?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Look at the seventh row. The first column has the label “Month” and the third column has the label “Principal.” Go down to the row that shows Month 235. You will see that the third column in that row shows you the principal for that month is $730.38."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$730.38"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 519583,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How much of payment 215 goes to interest?",
   "answers": [],
   "hints": [],
   "formats": [
