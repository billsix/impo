  {
   "id": 519585,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At what payment does the amount that is applied to mortgage finally exceed the amount applied to interest?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Look at the seventh row. The first column has the label “Month,” the third column has the label “Principal,” and the fourth column has the label “Interest.” Go down the table and look for the first row where the principal is greater than the interest. That happens in the row for Month 225."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Payment 225"
    }
   ],
