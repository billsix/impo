  {
   "id": 519584,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What’s the remaining balance on the mortgage after payment 227?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Look at the seventh row. The first column has the label “Month” and the last column has the label “Balance.” Go down to the row that shows Month 227. You will see that the last column in that row shows you the remaining balance for that month is $133,513.05."
    },
    {
     "images": [],
