 "stimulus_html": "The sales tax in Union County, Oregon, is 7%. Find the sales tax and total price of items based on the purchase price listed.",
 "questions": [
  {
   "id": 517134,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Purchase price = $1,499.00",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>sales tax = purchase price × tax rate</p>\n<p>sales tax = 1,499 × 0.07</p>\n<p>sales tax = $104.93</p>\n<p>total price = purchase price + sales tax = 1,499 + 104.93 = $1,603.93</p>\n<p>The sales tax is $104.93 and the total price is $1,603.93.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sales tax is $104.93; total price is $1,603.93."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 517135,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Purchase price = $26.89",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>sales tax = purchase price × tax rate</p>\n<p>sales tax = 26.89 × 0.07</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>sales tax = $1.88</td>\n<td>(rounded to the nearest cent)</td>\n</tr>\n</tbody>\n</table>\n<p>total price = purchase price + sales tax = 26.89 + 1.88 = $28.77</p>\n<p>The sales tax is $1.88 and the total price is $28.77.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sales tax is $1.88; total price is $28.77."
    }
