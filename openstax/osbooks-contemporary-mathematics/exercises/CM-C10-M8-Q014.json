 "questions": [
  {
   "id": 533294,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the missing lengths of the <span data-math=\"{45^ \\circ } {\\text{-}} {45^ \\circ } {\\text{-}} {90^ \\circ }\">{45^ \\circ } {\\text{-}} {45^ \\circ } {\\text{-}} {90^ \\circ }</span> triangle shown.<br>\n\n<img src=\"exercises/media/31bbdb3d5f3169c0.png\" alt=\"A right triangle. The legs are labeled 10 and b. The hypotenuse is labeled c. The angles at the top, bottom-left, and bottom-right are labeled 45 degrees, 90 degrees, and 45 degrees.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "\n<span data-math=\"\\begin{array}{*{20}{l}}\n  {b = 10} \\\\ \n  {c = 10\\sqrt 2 } \n\\end{array}\">\\begin{array}{*{20}{l}}\n  {b = 10} \\\\ \n  {c = 10\\sqrt 2 } \n\\end{array}</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The set of ratios in a <span data-math=\"{45^ \\circ } {\\text{-}} {45^ \\circ } {\\text{-}} {90^ \\circ }\">{45^ \\circ } {\\text{-}} {45^ \\circ } {\\text{-}} {90^ \\circ }</span> triangle are <span data-math=\"1:1:\\sqrt 2 \"></span>, or <span data-math=\"x:x:x\\sqrt 2 \"></span>.</p>\n<p>10 is <i>x</i>.</p>\n<p>That means <span data-math=\"b = x = {\\text{ }}10\"></span>.</p>\n<p><span data-math=\"c = x\\sqrt 2 = 10\\sqrt 2 \"></span></p>\n<p>The missing lengths are 10 and <span data-math=\"10\\sqrt 2 \"></span>.</p>\n"
    }
   ],
   "community_solutions": []
  }
 ],
