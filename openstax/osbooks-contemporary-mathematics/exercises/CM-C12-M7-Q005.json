 "questions": [
  {
   "id": 544429,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the weight of the Hamilton cycle <i>m</i> → <i>o</i> → <i>p</i> → <i>n</i> → <i>q</i> → <i>m</i> in the given figure.\n<figure>\n<figcaption>Weighted Complete Graph with Five Vertices</figcaption>\n<img src=\"exercises/media/5770194a2bcb6ebc.png\" alt=\"A graph with 5 vertices: m, n, o, p, and q. The edges from m to q, p, o, and n are labeled 5, 5, 3, and 4. The edges from n to q, p, and o are labeled 8, 5, and 6. The edges from p to o and q are labeled 5 and 7. The edge from q to o is labeled 2.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Add the weights of the individual edges.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td><i>mo</i></td>\n<td><i>op</i></td>\n<td><i>pn</i></td>\n<td><i>nq</i></td>\n<td><i>qm</i></td>\n<td>Sum</td>\n</tr>\n<tr>\n<td>3</td>\n<td>5</td>\n<td>5</td>\n<td>8</td>\n<td>5</td>\n<td>26</td>\n</tr>\n</tbody>\n</table>\n<p>The total weight of the Hamilton cycle is 26.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "26"
    }
   ],
   "community_solutions": []
  }
 ],
