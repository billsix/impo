   "id": 507809,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Solve <span data-math=\"6\\left( {y-2} \\right)-5y = 4\\left( {y + 3} \\right)-4\\left( {y - 1} \\right)\">6\\left( {y-2} \\right)-5y = 4\\left( {y + 3} \\right)-4\\left( {y - 1} \\right)</span>.",
   "answers": [],
