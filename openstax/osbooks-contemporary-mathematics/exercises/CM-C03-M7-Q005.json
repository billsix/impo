 "questions": [
  {
   "id": 505475,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You have agreed to text your friend every 3 hours while driving across the country. You began your trip at 8 AM. What time will it be when you text your friend the 15th time?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>You text every three hours for 15 times. You texted for 45 hours.</p>\n<p>You need to find 45 modulo 12.</p>\n<p>45 ÷ 12 = 3 and a remainder. What is that remainder?</p>\n<p><span data-math=\"12 \\times 3 = 36\"></span></p>\n<p>Subtract 36 from 45.</p>\n<p><span data-math=\"45 – 36 = 9\"></span></p>\n<p>The remainder is 9.</p>\n<p>The remainder is the solution to 45 modulo 12.</p>\n<p>45 modulo 12 ≡ 9</p>\n<p>Nine hours after 8 AM is 5 PM.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "5:00"
    }
   ],
   "community_solutions": []
  }
 ],
