 "questions": [
  {
   "id": 509759,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Convert the Mayan number into a Hindu-Arabic number.<br>\n<img src=\"exercises/media/063e15069bbb85f6.png\" alt=\"Mayan numeral 7 is displayed.\"><br>\n<img src=\"exercises/media/2ae3407d12118dda.png\" alt=\"Mayan numeral 16 is displayed.\">\n<br> \n<img src=\"exercises/media/9cbe3771f0bdd3d4.png\" alt=\"Mayan numeral 0 is displayed.\">\n<br>\n<img src=\"exercises/media/aa9192e89d2c67df.png\" alt=\"Mayan numeral 3 is displayed.\">\n<br> <img src=\"exercises/media/3c0af56e0a4893f0.png\" alt=\"Mayan numeral 13 is displayed.\">",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The top symbol represents 7.</p>\n<p>The next symbol represents 16.</p>\n<p>The next symbol represents 0.</p>\n<p>The next symbol represents 3.</p>\n<p>The next symbol represents 13.</p>\n<p>7 × 20<sup>4</sup> + 16 × 20<sup>3</sup> + 0 × 20<sup>2</sup> + 3 × 20 + 13 = 1,248,073</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1,248,073"
    }
   ],
   "community_solutions": []
  }
 ],
