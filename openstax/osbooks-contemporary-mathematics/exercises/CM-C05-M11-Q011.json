 "questions": [
  {
   "id": 511720,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Kellie makes tables and chairs. Kellie profits $20 from a table (<span data-math=\"t\">t</span>), and $10 from a chair (<span data-math=\"c\">c</span>). The objective function for profit in this situation is:\n",
   "answers": [
    {
     "id": 1000702,
     "content_html": "<span data-math=\"{P = 20t - 10c}\">{P = 20t - 10c}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000703,
     "content_html": "<span data-math=\"{P = 20c + 10t}\">{P = 20c + 10t}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000704,
     "content_html": "<span data-math=\"{P = 20t + 10c}\">{P = 20t + 10c}</span>",
     "correctness": "1.0"
    },
    {
     "id": 1000705,
     "content_html": "<span data-math=\"{P = 20c - 10t}\">{P = 20c - 10t}</span>",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Let <i>t</i> = the number of tables sold.</p>\n<p>Let <i>c</i> = the number of chairs sold.</p>\n<p>Let <i>P</i> = the profit.</p>\n<p>The profit on a table is $20 and the profit on a chair is $10.</p>\n<p>Break the words into components.</p> \n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>The total profit</td>\n<td>is</td>\n<td>$20 times the number of tables sold</td>\n<td>plus</td>\n<td>$10 times the number of chairs sold</td>\n</tr>\n<tr>\n<td><i>P</i></td>\n<td>=</td>\n<td>20<i>t</i></td>\n<td>+</td>\n<td>10<i>c</i></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"P = 20t + 10c\"></span></p>\n"
    }
   ],
   "community_solutions": []
  }
 ],
