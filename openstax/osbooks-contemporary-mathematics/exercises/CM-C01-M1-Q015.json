 "questions": [
  {
   "id": 493934,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Set <span data-math=\"A\">A</span> is a set of a dozen distinct donuts, and set <span data-math=\"B\">B</span> is a set of a dozen different types of apples. Is set <span data-math=\"A\">A</span> equal to set <span data-math=\"B\">B</span>, equivalent to set <span data-math=\"B\">B</span>, or neither?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Equal sets have the same elements, without regard to order. Equivalent sets have the same number of elements. These sets are equivalent but not equal because they have the same number of elements, but they have different elements."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "equivalent, but not equal"
    }
   ],
   "community_solutions": []
  }
 ],
