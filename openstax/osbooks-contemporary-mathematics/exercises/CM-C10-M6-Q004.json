   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the area of the parallelogram.\n<figure>\n<img src=\"exercises/media/27cd0682f8dba79a.png\" alt=\"A parallelogram with its base marked 18 inches and height marked 15 inches.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The area of a parallelogram with base <i>b</i> and height <i>h</i> is <span data-math=\"A = bh\"></span>.</p>\n<p><span data-math=\"A = bh = \\left( {{\\rm{15\\ in}}} \\right)\\left( {{\\rm{18\\ in}}} \\right) = 270{\\rm{\\ i}}{{\\rm{n}}^2}\"></span></p>\n<p>The area of the parallelogram is 270 square inches.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"270\\,{\\text{i}}{{\\text{n}}^2}\">270\\,{\\text{i}}{{\\text{n}}^2}</span>"
    }
   ],
