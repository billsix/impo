   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Convert the Roman numeral CCXLVII into a Hindu-Arabic numeral.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Unless a smaller digit precedes a larger digit, add the digit’s values.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>C</td>\n<td>C</td>\n<td>X</td>\n<td>L</td>\n<td>V</td>\n<td>I</td>\n<td>I</td>\n</tr>\n<tr>\n<td>100</td>\n<td>100</td>\n<td>10</td>\n<td>50</td>\n<td>5</td>\n<td>1</td>\n<td>1</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td colspan=\"2\">Subtract 10 from 50.<br>\n50 – 10 = 40</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p>Add the digit values: 100 + 100 + 40 + 5 + 1 + 1 = 247</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "247"
    }
   ],
