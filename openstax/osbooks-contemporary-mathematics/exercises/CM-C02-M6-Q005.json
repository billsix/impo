     "content_html": "<table summary=\".\">\n<thead>\n<tr>\n<th><span data-math=\"p\">p</span></th>\n<th><span data-math=\"q\">q</span></th>\n<th><span data-math=\"{p} \\vee {q}\">{p} \\vee {q}</span></th>\n<th><span data-math=\"\\text{~}\\left( {{p} \\vee {q}} \\right)\">\\text{~}\\left( {{p} \\vee {q}} \\right)</span></th>\n<th><span data-math=\"\\text{~}p\">\\text{~}p</span></th>\n<th><span data-math=\"\\text{~}q\">\\text{~}q</span></th>\n<th><span data-math=\"\\text{~}p \\wedge \\text{~}q\">\\text{~}p \\wedge \\text{~}q</span></th>\n<th><span data-math=\"\\text{~}({p} \\vee {q}) \\leftrightarrow \\left( {\\text{~}p \\wedge \\text{~}q} \\right)\">\\text{~}({p} \\vee {q}) \\leftrightarrow \\left( {\\text{~}p \\wedge \\text{~}q} \\right)</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>T</td>\n<td>T</td>\n<td>T</td>\n<td>F</td>\n<td>F</td>\n<td>F</td>\n<td>F</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>T</td>\n<td>F</td>\n<td>T</td>\n<td>F</td>\n<td>F</td>\n<td>T</td>\n<td>F</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>F</td>\n<td>T</td>\n<td>T</td>\n<td>F</td>\n<td>T</td>\n<td>F</td>\n<td>F</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>F</td>\n<td>F</td>\n<td>F</td>\n<td>T</td>\n<td>T</td>\n<td>T</td>\n<td>T</td>\n<td><b>T</b></td>\n</tr>\n</tbody>\n</table>"
