   "id": 496718,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Construct a truth table to verify De Morgan’s Law for the negation of a disjunction, <span data-math=\"\\text{~}\\left( {p \\vee q} \\right) \\equiv \\text{~}p \\wedge \\text{~}q\">\\text{~}\\left( {p \\vee q} \\right) \\equiv \\text{~}p \\wedge \\text{~}q</span>, is valid.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
