 "questions": [
  {
   "id": 494311,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the set of possible outcomes when you flip a coin, <span data-math=\"S = \\{ {\\text{heads, tails}}\\} \">S = \\{ {\\text{heads, tails}}\\}</span>. List all the possible subsets of set <span data-math=\"S.\">S.</span><p></p>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: Begin with the set itself, as every set is a subset of itself. The original set has two elements, so its cardinality is 2.</p>\n<p><span data-math=\"\\{{\\text{head, tails}}\\}\"></span></p>\n<p>Step 2: Next, list all the proper subsets containing one less element than the original set. That is, list the sets with one element.</p>\n<p><span data-math=\"\\{\\rm heads \\}\"></span></p>\n<p><span data-math=\"\\{\\rm tails \\}\"></span></p>\n<p>Step 3: Continue this process, reducing the number of elements in the subset by one each step. On this step, list the subsets with zero elements, or the empty set.</p>\n<p><span data-math=\"\\{ \\}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\{ {\\text{heads, tails}}\\} ;\">\\{ {\\text{heads, tails}}\\} ;</span><span data-math=\"\\{ {\\text{heads}}\\} ,{\\text{ }}\\{ {\\text{tails}}\\} ;\">\\{ {\\text{heads}}\\} ,{\\text{ }}\\{ {\\text{tails}}\\} ;</span> and <span data-math=\"\\emptyset \">\\emptyset </span>"
    }
   ],
   "community_solutions": []
  }
 ],
