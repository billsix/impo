 "is_vocab": false,
 "stimulus_html": "For each of the following situations, identify whether the sample is a simple random sample, a systematic random sample, a stratified random sample, a cluster random sample, or none of these.",
 "questions": [
  {
   "id": 528319,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The chairperson of the University Chess Club is trying to decide on a time for the club’s regular meetings, so she emails all of the members of the club to find their preferences.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "None of the above (there’s no sample being selected here; the entire population is being surveyed)\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 528320,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The registrar at a small college wants to use a survey to determine if their office could do a better job of serving students. They choose three students at random from each major to take the survey.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A stratified sample is chosen so that particular groups in the population are certain to be represented. This is a stratified random sample since it made sure to sample each major."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Stratified random sample (the strata are the different majors)"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 528321,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A civic club is organizing a raffle as a fundraiser. To determine the three winners, each of the tickets is put into a large drum, then the tickets are thoroughly mixed. A blindfolded club member pulls three tickets out of the drum.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This is a simple random sample. A simple random sample is chosen in a way that every unit in the population has an equal chance of being selected, and the chances of a unit being selected do not depend on the units already chosen."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Simple random sample"
    }
   ],
   "community_solutions": []
  }
 ],
