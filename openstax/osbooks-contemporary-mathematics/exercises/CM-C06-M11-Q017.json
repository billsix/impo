 "stimulus_html": "In the following exercises, find the total cost to purchase the car.",
 "questions": [
  {
   "id": 519478,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Alexia negotiates a purchase price of $17,850 for her new car. The sales tax in her area is 6.5%. Her license, plates, and registration come to $285.00. The dealership charges her a $600 destination fee and a $150 processing fee. How much will she finance in total for the car?",
   "answers": [],
   "hints": [],
