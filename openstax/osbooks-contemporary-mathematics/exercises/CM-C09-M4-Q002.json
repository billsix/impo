 "questions": [
  {
   "id": 526880,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which represents a reasonable value for the weight of a car:<br>\n1,300 g, 130 kg, or 1,300 kg?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The average car weighs about 2 metric tons, or 2,000 kilograms. The best choice is 1,300 kilograms for a lightweight car."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1,300 kg"
    }
   ],
   "community_solutions": []
  }
