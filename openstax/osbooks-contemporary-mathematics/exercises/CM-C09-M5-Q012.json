     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"C = \\frac{5}{9}\\left( {F - 32} \\right)\"></span></p>\n<p><span data-math=\"C = \\frac{5}{9}\\left( {225 - 32} \\right)\"></span></p>\n<p><span data-math=\"C = \\frac{5}{9}\\left( {193} \\right)\"></span></p>\n<p><span data-math=\"107^\\circ {\\rm{C}}\"></span></p>"
