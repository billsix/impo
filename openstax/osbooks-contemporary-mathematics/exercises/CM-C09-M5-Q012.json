   "stem_html": "27 °C = __________ °F",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"F = \\frac{9}{5}C + 32\"></span></p>\n<p><span data-math=\"F = \\frac{9}{5}\\left( {27} \\right) + 32\"></span></p>\n<p><span data-math=\"F = 48.6 + 32\"></span></p>\n<p><span data-math=\"81^\\circ {\\rm{F}}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "81"
    }
   ],
