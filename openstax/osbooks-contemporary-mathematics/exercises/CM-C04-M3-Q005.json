   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>In base 12,</p>\n<p>A represents the digit 10.</p>\n<p>B represents the digit 11.</p>\n<p>The place values are powers of 12 in base 12.</p>\n<p><span data-math=\"{\\rm{5A}}{{\\rm{B}}_{12}} = 5 \\times {12^2} + 10 \\times {12^1} + 11 \\times {12^0}\"></span></p>\n<p><span data-math=\"5 \\times 144 + 10 \\times 12 + 11 \\times 1\"></span></p>\n<p><span data-math=\"720 + 120 + 11\"></span></p>\n<p><span data-math=\"851\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "851"
    }
   ],
