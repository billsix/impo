 "questions": [
  {
   "id": 533527,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the figure shown, is triangle <span data-math=\"ABC\">ABC</span> congruent to triangle <span data-math=\"DEF\">DEF</span>?\n<figure>\n<img src=\"exercises/media/252c797a54304140.png\" alt=\"Two triangles, A B C and D E F. Angles A is congruent to angle D. Angle C is congruent to angle F. The side, A C is congruent to the side, D F. The side, B C is congruent to the side, E F.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The sum of the angle measures of a triangle must be 180°. Since two of the angles in triangle ABC have equal measures to two of the angles in triangle DEF, you know the third pair of angles are also of equal measure. The sides are also equal. These are congruent triangles."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Triangle <span data-math=\"ABC\">ABC</span> is congruent to triangle <span data-math=\"DEF\">DEF</span>."
    }
   ],
   "community_solutions": []
  }
 ],
