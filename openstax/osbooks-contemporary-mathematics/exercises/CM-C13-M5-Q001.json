   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The number of games in a single round-robin tournament with <i>n</i> teams is <span data-math=\"\\frac{{n\\left( {n - 1} \\right)}}{2}\"></span>.</p>\n<p><i>n</i>: 5 teams</p>\n<p><span data-math=\"\\frac{{n\\left( {n - 1} \\right)}}{2} = \\frac{{5\\left( {5 - 1} \\right)}}{2} = \\frac{{5\\left( 4 \\right)}}{2} = \\frac{{20}}{2} = 10\"></span></p>\n<p>There are 10 games.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "10 games"
    }
   ],
