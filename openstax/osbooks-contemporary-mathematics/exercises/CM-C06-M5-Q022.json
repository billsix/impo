  {
   "id": 519219,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Discuss the affordability of changing jobs and moving, based on Fran’s budget.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "She only has budgeted $1,061.83 for other necessities. It is difficult to imagine Fran being able to afford to change jobs and move, unless she reallocates money that she would want to save or use for entertainment or takes on another job. If Fran uses all the money that the 50-30-20 budget sets aside for savings, she then would have $1,790.16 to spend on those other necessities. If she moves away from the 50-30-20 philosophy, she may be able to afford the move. However, that means changing her priorities."
    }
   ],
   "community_solutions": []
  }
