 "questions": [
  {
   "id": 545795,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The 23rd Fibonacci number is 28,657 and the 24th is 46,368. Show that the ratio of the 24th and 23rd Fibonacci numbers is approximately <span data-math=\"\\mathit{ϕ}\">\\mathit{ϕ}</span>. Round your answer to the nearest thousandth.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The ratio of <span data-math=\"\\frac{{46,368}}{{28,657}} \\approx 1.618033988 \\approx 1.618\"></span>.</p>\n<p>This is very similar to <span data-math=\"\\phi \"></span>.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1.618"
    }
   ],
   "community_solutions": []
  }
 ],
