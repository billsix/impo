 "questions": [
  {
   "id": 505471,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If it is 7:00 now, what time was it 34 hours ago?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>First, find 34 mod 12.</p>\n<p>Determine the remainder when 34 is divided by 12.</p>\n<p>34 ÷ 12 = 2 and a remainder. What is that remainder?</p>\n<p><span data-math=\"12 \\times 2 = 24\"></span></p>\n<p>Subtract 24 from 34.</p>\n<p><span data-math=\"34 – 24 = 10\"></span></p>\n<p>The remainder is 10.</p>\n<p>The remainder is the solution to 34 mod 12.</p>\n<p>34 mod 12 ≡ 10</p>\n<p>Now, subtract 10 hours from 7:00.</p>\n<p>The time 10 hours before 7:00 was 9:00.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "9:00"
    }
   ],
   "community_solutions": []
  }
 ],
