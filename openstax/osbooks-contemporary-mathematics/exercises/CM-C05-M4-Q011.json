   "stem_html": "If <span data-math=\"a{:}b = c{:}d\">a{:}b = c{:}d</span>, then <span data-math=\"b{:}a = d{:}c\">b{:}a = d{:}c</span> for all non-zero whole numbers <span data-math=\"a\">a</span>, <span data-math=\"b\">b</span>, <span data-math=\"c\">c</span>, and <span data-math=\"d\">d</span>. ",
