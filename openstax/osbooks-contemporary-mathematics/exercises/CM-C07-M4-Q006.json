     "solution_type": "detailed",
     "content_html": "<table class=\"unnumbered\" summary=\".\">\n<thead>\n<tr>\n<th></th>\n<th>Crinkle Fries</th>\n<th>Curly Fries</th>\n<th>Onion Rings</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><b>8 Nuggets</b></td>\n<td>8 nuggets with crinkle fries </td>\n<td>8 nuggets with curly fries</td>\n<td>8 nuggets with onion rings</td>\n</tr>\n<tr>\n<td><b>12 Nuggets</b></td>\n<td>12 nuggets with crinkle fries </td>\n<td>12 nuggets with curly fries</td>\n<td>12 nuggets with onion rings</td>\n</tr>\n</tbody>\n</table>"
