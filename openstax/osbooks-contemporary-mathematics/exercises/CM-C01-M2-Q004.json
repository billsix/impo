 "questions": [
  {
   "id": 494379,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compute the total number of subsets in the set of the top nine tennis grand slam singles winners, <span data-math=\"T = \\{\\text{Margaret Court, Serena Williams, Steffi Graff, Rafael Nadal, Novak Djokovic, }\">T = \\{\\text{Margaret Court, Serena Williams, Steffi Graff, Roger Federer, Rafael Nadal,</span> <span data-math=\"\\text{Roger Federer, Helen Wills, Martina Navratilova, Chris Everett}\\}\">Martina Navratilova, Chris Everett, Novak Djokovic}\\}</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use the formula for the number of subsets of set <i>A</i> with <i>n</i> elements: <span data-math=\"{2^{n(A)}}\"></span>.</p>\n<p>Set <i>T</i> has nine elements.</p>\n<p><span data-math=\"{2^{n(T)}} = {2^9} = 512\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "512"
    }
   ],
   "community_solutions": []
  }
 ],
