  {
   "id": 329756,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use a graph to determine if it is possible to travel through Imaginaria crossing each the border between each pair of states exactly once, and returning to the state in which you started.\n<br>\n<img src=\"exercises/media/8f64f00ecc7abdde.png\" alt=\"A map of Imaginaria. It has four regions: Fictionville, Illusionham, Mythbury, and Pretendstead.\">\n",
   "answers": [],
