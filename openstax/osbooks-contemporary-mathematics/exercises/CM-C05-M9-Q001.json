   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"\\left\\{ {\\begin{array}{*{20}{c}}\n{x - 3y =  - 8}\\\\\n{ - 3x - y = 4}\n\\end{array}} \\right.\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td>Test (–2, 2).</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><span data-math=\" - 2 - 3\\left( 2 \\right) =  - 8\"></span></td>\n<td>Substitute into the first equation.</td>\n</tr>\n<tr>\n<td><span data-math=\" - 2 - 6 =  - 8\"></span></td>\n<td>This is true.</td>\n</tr>\n<tr>\n<td><span data-math=\" - 3\\left( { - 2} \\right) - \\left( 2 \\right) = 4\"></span></td>\n<td>Substitute into the second equation.</td>\n</tr>\n<tr>\n<td><span data-math=\"6 - 2 = 4\"></span></td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><span data-math=\"4{\\text{ }} = {\\text{ }}4\"></span></td>\n<td>This is true. This ordered pair is a solution to the system.</td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes"
    }
