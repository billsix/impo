 "questions": [
  {
   "id": 504767,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "There are three gym classes. The number of students in the classes is 21, 35, and 28. What is the largest team size that can be formed if teams from every class must have the same number of students?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Find the GCD of 21, 35, and 28.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Number</td>\n<td>Factors</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>21</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>3</td>\n<td>&nbsp;</td>\n<td>7</td>\n</tr>\n<tr>\n<td>35</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td></td>\n<td>5</td>\n<td>7</td>\n</tr>\n<tr>\n<td>28</td>\n<td>2</td>\n<td>2</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>7</td>\n</tr>\n<tr>\n<td>Common</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>7</td>\n</tr>\n</tbody>\n</table>\n<p>Greatest common divisor = 7</p>\n<p>The largest team size is 7 students.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The largest team size that can be formed is 7 students."
    }
   ],
   "community_solutions": []
  }
