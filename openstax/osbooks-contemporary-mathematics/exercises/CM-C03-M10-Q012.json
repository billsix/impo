 "questions": [
  {
   "id": 507023,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A new marketing firm began with 30 people in its survey group. The firm adds 4 people per day. How many people will be in their survey group after 100 days?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>This is an arithmetic sequence with a first term of 30 and a constant difference of 4. The answer to the question is the 100th term.</p>\n<p>You can find any term by using the formula: <span data-math=\"{a_i} = {a_1} + d \\times \\left({i - 1} \\right)\"></span>.</p>\n<p><span data-math=\"{a_{100}} = 30 + 4 \\times \\left({100 - 1} \\right) = 30 + 4(99) = 426\"></span></p>\n<p>There will be 426 people in the group on the 100th day.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "There will be 426 people in their survey group after 100 days."
    }
   ],
   "community_solutions": []
  }
 ],
