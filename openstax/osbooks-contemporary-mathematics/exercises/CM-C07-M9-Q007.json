   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 516743,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you draw 1 tile at random, compute:\n<ol type=\"a\">\n<li><span data-math=\"P({\\text{tile shows a vowel}})\">P({\\text{tile shows a vowel}})</span></li>\n<li><span data-math=\"P\\left({\\text{tile shows a vowel}}\\,|\\,{\\text{tile shows a letter that comes after M alphabetically}}\\right)\">P\\left({\\text{tile shows a vowel}}\\,|\\,{\\text{tile shows a letter that comes after M alphabetically}}\\right)</span></li>\n</ol>",
