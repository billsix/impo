 "questions": [
  {
   "id": 505835,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Mercury is about <span data-math=\"3.114 \\times {10^7}\">3.114 \\times {10^7}</span> miles from the sun. Neptune is about <span data-math=\"2.781 \\times {10^9}\">2.781 \\times {10^9}</span> miles from the sun. How many times further is Neptune from the sun than Mercury?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"2.781 \\times {10^9}/3.114 \\times {10^7}\"></span></p>\n<p>Step 1: Divide the number parts.</p>\n<p><span data-math=\"2.781{\\rm{ }} \\div 3.114 \\approx 0.8930635\"></span></p>\n<p>Step 2: Subtract the exponents of the 10s.</p>\n<p><span data-math=\"9 - 7 = 2\"></span></p>\n<p>Step 3: The result is the answer from Step 1 times 10 raised to the answer from Step 2.</p>\n<p><span data-math=\"0.89306 \\times {10^2}\"></span></p>\n<p>Step 4: If the answer is not in scientific notation, adjust it.</p>\n<p><span data-math=\"8.9306 \\times {10^1}\"></span></p>\n<p>Neptune is approximately <span data-math=\"8.9306 \\times {10^1}\"></span>, or 89.3, times farther from the sun than Mercury.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Neptune is <span data-math=\"8.930 \\times {10^1}\">8.930 \\times {10^1}</span>, or 89.3, times further from the sun that Mercury."
    }
   ],
   "community_solutions": []
  }
 ],
