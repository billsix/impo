 "questions": [
  {
   "id": 533539,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Is triangle <span data-math=\"EFG\">EFG</span> similar to triangle <span data-math=\"JKL\">JKL</span> in the figure shown?\n<figure>\n<img src=\"exercises/media/6dd1ca54e3f8f5e0.png\" alt=\"Two right triangles, E F G and J K L. In the first triangle E F G, the legs G E and E F measure 3.7 and 3.4. The hypotenuse G F measures 5. In the second triangle J K L, the legs L J and J K measure 4.9 and 4.5. The hypotenuse L K measures 6.6. The angles, G and L are congruent.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: You know the corresponding angles have equal measures from the drawings. That is enough to determine similarity.</p>\n<p>Step 2: Set up proportions between the triangles to see if they have the same scaling factor. If they are the same, the triangles are similar.</p>\n<p><span data-math=\"\\frac{{3.7}}{{4.9}} \\approx 0.76\"></span></p>\n<p><span data-math=\"\\frac{5}{{6.6}} \\approx 0.76\"></span></p>\n<p><span data-math=\"\\frac{{3.4}}{{4.5}} \\approx 0.76\"></span></p>\n<p>The scale factor is approximately the same. The triangles are similar.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The triangles are similar."
    }
   ],
   "community_solutions": []
  }
 ],
