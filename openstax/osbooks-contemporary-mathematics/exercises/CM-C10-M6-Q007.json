 "questions": [
  {
   "id": 532536,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A rhombus has an area of <span data-math=\"40{\\text{ in}^2}\">40{\\text{ in}^2}</span>, the measure of <span data-math=\"{d_1} = 8\">{d_1} = 8</span>. Find the measure of <span data-math=\"{d_2}\">{d_2}</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The area of a rhombus with diagonals <span data-math=\"{d_1}\"></span> and <span data-math=\"{d_2}\"></span> is <span data-math=\"A = \\frac{{{d_1}{d_2}}}{2}\"></span>.</p> \n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"40 = \\frac{{8{d_2}}}{2}\"></span></td>\n<td>Simplify the right side.</td>\n</tr>\n<tr>\n<td><span data-math=\"40 = 4{d_2}\"></span></td>\n<td>Divide both sides.</td>\n</tr>\n<tr>\n<td><span data-math=\"10 = {d_2}\"></span></td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p>The measure of <span data-math=\"{d_2}\"></span> is 10 inches.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"{d_2} =10\">{d_2} =10</span>"
    }
   ],
   "community_solutions": []
  }
 ],
