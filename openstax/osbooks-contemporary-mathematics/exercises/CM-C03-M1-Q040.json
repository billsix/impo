  },
  {
   "id": 505057,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Isabella is creating a collage for a project and wants a horizontal cut in the collage. The cut will be made by using purple strips of cloth that are 28 mm long, and yellow strips of paper that are 36 mm long. What is the minimum length of the cut can she make using strips with those lengths?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 505058,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Asteroids are objects that orbit the sun. The smallest distance that an asteroid gets to the sun during its orbit is called the perihelion. Asteroids also have orbital periods, or the time it takes to go around the sun exactly one time. The asteroid Ceres has an orbital period (number of days to circle the sun) of 1,680 days. The asteroid Hygiea has an orbital period of 2,031 days. Suppose they are at their perihelion on the same day. How many days will it be before Ceres and Hygiea are at their perihelion on the same day again?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  }
