  {
   "id": 505056,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A lunar month is 30 days (rounding off). A new lunar month begins on a Saturday. How many days is it until a lunar month begins on a Saturday again?",
   "answers": [],
