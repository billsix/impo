 "is_vocab": false,
 "stimulus_html": "Name which keys are one whole step up and one whole step down from the following:",
 "questions": [
  {
   "id": 545542,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "D<sup>♭</sup>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>One whole step up or down is two keys up or down. Black and white keys count the same.</p>\n<p>Two keys up from D♭ is E♭. (Alternative answer to up: D#)</p>\n<p>Two keys down from D♭ is B.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "up E<sup>♭</sup>, down B"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545543,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "C<sup>#</sup>",
