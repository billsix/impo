   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>One whole step up or down is two keys up or down. Black and white keys count the same.</p>\n<p>Two keys up from C# is D#. (Alternative answer to up: E♭)</p>\n<p>Two keys down from C# is B.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "up D<sup>#</sup>, down B"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545544,
   "is_answer_order_important": false,
