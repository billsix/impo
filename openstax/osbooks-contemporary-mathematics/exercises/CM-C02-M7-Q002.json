 "is_vocab": false,
 "stimulus_html": "Each pair of statements represents the premises in a logical argument. Based on these premises, apply the law of denying the consequent to determine a valid conclusion.",
 "questions": [
  {
   "id": 497349,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If my classmate likes history, then some people like history. Nobody likes history.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The negation of a “Some…” statement is a “No…” statement.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td colspan=\"3\">The Law of Denying the Consequent</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"p \\to q\"></span></td>\n<td>If my classmate likes history, then some people like history.</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"\\text{~}q\"></span></td>\n<td>Nobody likes history.</td>\n</tr>\n<tr>\n<td>Conclusion:</td>\n<td><span data-math=\"\\therefore \\text{~}p\"></span></td>\n<td>My classmate does not like history.</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "My classmate does not like history."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 497350,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If Homer does not like to read, then some people do not like reading. All people like reading.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The negation of an “All…” statement is a “Some….not…” statement.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td colspan=\"3\">The Law of Denying the Consequent</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"p \\to q\"></span></td>\n<td>If Homer does not like to read, then some people do not like reading.</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"\\text{~}q\"></span></td>\n<td>All people like reading.</td>\n</tr>\n<tr>\n<td>Conclusion:</td>\n<td><span data-math=\"\\therefore \\text{~}p\"></span></td>\n<td>Homer does like to read.</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Homer likes to read."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 497351,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the polygon has five sides, then it is not an octagon. The polygon is an octagon.",
