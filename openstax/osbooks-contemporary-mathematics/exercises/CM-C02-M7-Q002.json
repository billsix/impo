   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td colspan=\"3\">The Law of Denying the Consequent</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"p \\to q\"></span></td>\n<td>If the polygon has five sides, then it is not an octagon.</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"\\text{~}q\"></span></td>\n<td>The polygon is an octagon.</td>\n</tr>\n<tr>\n<td>Conclusion:</td>\n<td><span data-math=\"\\therefore \\text{~}p\"></span></td>\n<td>The polygon does not have five sides.</td>\n</tr>\n</tbody>\n</table>"
