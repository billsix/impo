 "questions": [
  {
   "id": 519471,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the cost of a car is $30,000, and the residual value of the car after 3 years is $18,000, what is the monthly depreciation for the car?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>There are 36 months in 3 years.</p>\n<p>The monthly depreciation for a car, MD, is <span data-math=\"{\\rm{MD}} = \\frac{{P - R}}{n}\"></span>, where <i>P</i> is the price paid for the car, <i>R</i> is the residual value of the car, and <i>n</i> is the number of months of the lease.</p>\n<p><span data-math=\"{\\rm{MD}} = \\frac{{30,000 - 18,000}}{{36}} = \\$333.34\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$333.34"
    }
   ],
   "community_solutions": []
  }
 ],
