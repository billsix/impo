 "questions": [
  {
   "id": 516629,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Marisol needed to buy a new microwave. She got a 26% discount. The sale price Marisol paid was $43.66. What was the original price of the microwave?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>100% – 26% = 74%</p>\n<p>If the percent discount was 26%, the sale price is 76% of the original price.</p>\n<p>sale price = original price × (1 – percent discount)</p>\n<p><span data-math=\"43.66 = {\\rm{original\\ price}} \\times \\left( {1 - 0.26} \\right)\"></span></p>\n<p><span data-math=\"43.66 = {\\rm{original\\ price}} \\times \\left( {0.74} \\right)\"></span></p>\n<p><span data-math=\"\\frac{{43.66}}{{0.74}} = {\\rm{original\\ price}}\"></span></p>\n<p>The original price was $59.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$59.00"
    }
   ],
   "community_solutions": []
  }
 ],
