 "questions": [
  {
   "id": 528773,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In Your Turn 8.46, you created a scatter plot for points (PTS) vs. wins (W) using the dataset <a href=\"https://openstax.org/r/Chapter8_Data-Sets\" rel=\"nofollow\" target=\"_blank\">“NHL19”</a>. Recreate the scatter plot in Google Sheets, and use it to find the equation of the regression line.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>In Google Sheets, highlight the data including the headers.</p>\n<p>Open a copy of the file in Google Sheets. You cannot edit the original file.</p>\n<p>Look for the NHL19 tab.</p>\n<p>It will be easier for Google to suggest what you want if your columns are adjacent. Copy the Points column to the left of the Wins column.</p>\n<p>Highlight the columns for PTS (Points) and W (Wins) (including the headers).</p>\n<p>Choose Insert, then choose Chart.</p>\n<p>It may suggest a line chart in “Chart type.”</p>\n<p>In the Chart type drop down box, choose a scatter plot.</p>\n<p>Make sure that the “Series” selected are PTS vs W.</p>\n<p>Once you have the scatter plot, Google Sheets can generate the regression line by clicking the three dots at the top right of the plot.</p>\n<p>Then select “Edit chart.”</p>\n<p>Then click on “Customize” and “Series.”</p>\n<p>Then add the regression line by checking the box next to “Trendline.”</p>\n<p>Show the equation by selection “Use Equation” in the drop-down menu under “Label.”</p>\n<p>The equation appears on the graph: 1.8*<i>x</i> + 16.9</p>\n<p>The “<i>y</i> = ” is implied.</p>\n<p><span data-math=\"y{\\text{ }} = 1.8x\\; + {\\text{ }}16.9\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<p><span data-math=\"y = 1.8x + 16.9\">y = 1.8x + 16.9</span></p>"
    }
   ],
   "community_solutions": []
  }
 ],
