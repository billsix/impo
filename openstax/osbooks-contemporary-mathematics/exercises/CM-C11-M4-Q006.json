 "is_vocab": false,
 "stimulus_html": "Suppose the population of a state is 12 and the standard divisor is 0.225.",
 "questions": [
  {
   "id": 544869,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the state’s standard quota.\n\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<span data-math=\"{\\text{Standard Quota = }}\\frac{{{\\text{State Population}}}}{{{\\text{Standard Divisor}}}}{\\text{ = }}\\frac{{{\\text{12}}}}{{{\\text{0}}{\\text{.225}}}}{\\text{ = 53}}{\\text{.33 seats}}\"></span>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "53.33"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544870,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Decrease the standard divisor by 0.200 units and use the modified divisor to determine the modified quota for the state.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Decrease 0.225 by 0.2:</p>\n<p>0.225 – 0.2 = 0.025, the new standard divisor</p>\n<p><span data-math=\"{\\text{Standard Quota = }}\\frac{{{\\text{State Population}}}}{{{\\text{Standard Divisor}}}}{\\text{ = }}\\frac{{{\\text{12}}}}{{{\\text{0}}{\\text{.025}}}}{\\text{ = 480 seats}}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "480"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544871,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Increase the modified divisor from part 2 by 0.100 units and use the new modified divisor to determine the modified quota for the state.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Increase 0.025 by 0.10.</p>\n<p>0.025 + 0.10 = 0.125, the new standard divisor</p>\n<p><span data-math=\"{\\text{Standard Quota = }}\\frac{{{\\text{State Population}}}}{{{\\text{Standard Divisor}}}}{\\text{ = }}\\frac{{{\\text{12}}}}{{{\\text{0}}{\\text{.125}}}}{\\text{ = 96 seats}}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "96"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544872,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Choose any value of divisor between the value of the modified divisor from part 2 and the value of the modified divisor from part 3 and use it to determine the modified quota for the state.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Answers may vary. With a modified divisor of 0.100, the modified quota is 120."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544873,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which modified quota was the smallest, the modified quota from part 2, from part 3, or from part 4? Explain why.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The modified quota from part 3 was the smallest, because the divisor was the largest of the three. Dividing the same number by a larger value gives a smaller result."
    }
   ],
   "community_solutions": []
  }
 ],
