 "questions": [
  {
   "id": 532822,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose you have a similar property to the one in Figure 10.53, but the angle that corresponds to the garden corner is <span data-math=\"{50^ \\circ }\">{50^ \\circ }</span>. What is the measure between the two cross streets? ",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The two angles form a straight angle. To find the supplementary angle, subtract it from 180.</p>\n<p><span data-math=\"180 - 50 = 130\"></span></p>\n<p>The angle measures 130°.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"{130^ \\circ }\">{130^ \\circ }</span>"
    }
   ],
   "community_solutions": []
  }
 ],
