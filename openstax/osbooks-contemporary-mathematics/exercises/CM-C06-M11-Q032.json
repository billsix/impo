 "questions": [
  {
   "id": 519465,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If your car payment is $410.86 per month and your car insurance is $2,190 per year, what is the cost of the car per month when accounting for the insurance?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Divide the $2,190 cost per year by 12 to get $182.50.</p>\n<p>Add that to the monthly car payment of $410.86 to get the total monthly cost of $593.36.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$593.36"
    }
   ],
   "community_solutions": []
  }
 ],
