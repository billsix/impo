 "stimulus_html": "Find the sales tax rate for the indicated purchase price and total price. Round using the guideline for sales tax percentages.",
 "questions": [
  {
   "id": 517138,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Purchase price = $83.90; total price = $88.30",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>total price = purchase price + sales tax</p>\n<p>88.30 = 83.90 + sales tax</p>\n<p>$4.40 = sales tax</p>\n<p>sales tax = purchase price × tax rate</p>\n<p>4.40 = 83.90 × tax rate</p>\n<p><span data-math=\"\\frac{{4.40}}{{83.90}} = \"></span> tax rate</p>\n<p>0.052443… ≈ tax rate</p>\n<p>The tax rate is approximately 5.24%.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sales tax rate = 5.25%"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 517139,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Purchase price = $477.00; total price = $509.20",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>total price = purchase price + sales tax</p>\n<p>509.20 = 477 + sales tax</p>\n<p>$32.20 = sales tax</p>\n<p>sales tax = purchase price × tax rate</p>\n<p>32.20 = 477 × tax rate</p>\n<p><span data-math=\"\\frac{{32.20}}{{477}} = \"></span> tax rate</p>\n<p>0.0675 ≈ tax rate</p>\n<p>The tax rate is approximately 6.75%.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sales tax rate = 6.75%"
    }
