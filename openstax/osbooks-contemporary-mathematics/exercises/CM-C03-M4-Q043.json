 "questions": [
  {
   "id": 506001,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Lina  decides to save <span data-math=\"\\frac{1}{8}\">\\frac{1}{8}</span> of her take-home pay every paycheck. Her most recent paycheck was for $882. How much will she save from that paycheck?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Find one-eighth of $882.</p>\n<p><span data-math=\"\\frac{1}{8} \\times 882 = 110.25\"></span></p>\n<p>Divide 882 by 8.</p>\n<p>Lina will save $110.25.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$110.25"
    }
   ],
   "community_solutions": []
  }
