 "stimulus_html": "For the following exercises, use the following table of data on the top 15 receivers (by number of receptions) in the NFL during the 2020 season:\n<table class=\"unnumbered\">\n<caption>(<a href=\"http://www.pro-football-reference.com\" rel=\"nofollow\" target=\"_blank\">source</a>)</caption>\n<thead>\n<tr>\n<th>Player</th>\n<th>Team</th>\n<th>Age</th>\n<th>Receptions</th>\n<th>Yards</th>\n<th>Yds/Rec</th>\n<th>TD</th>\n<th>Long</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Stefon Diggs</td>\n<td>BUF</td>\n<td>27</td>\n<td>127</td>\n<td>1535</td>\n<td>12.1</td>\n<td>8</td>\n<td>55</td>\n</tr>\n<tr>\n<td>Davante Adams</td>\n<td>GNB</td>\n<td>28</td>\n<td>115</td>\n<td>1374</td>\n<td>11.9</td>\n<td>18</td>\n<td>56</td>\n</tr>\n<tr>\n<td>DeAndre Hopkins</td>\n<td>ARI</td>\n<td>28</td>\n<td>115</td>\n<td>1407</td>\n<td>12.2</td>\n<td>6</td>\n<td>60</td>\n</tr>\n<tr>\n<td>Darren Waller</td>\n<td>LVR</td>\n<td>28</td>\n<td>107</td>\n<td>1196</td>\n<td>11.2</td>\n<td>9</td>\n<td>38</td>\n</tr>\n<tr>\n<td>Travis Kelce</td>\n<td>KAN</td>\n<td>31</td>\n<td>105</td>\n<td>1416</td>\n<td>13.5</td>\n<td>11</td>\n<td>45</td>\n</tr>\n<tr>\n<td>Allen Robinson</td>\n<td>CHI</td>\n<td>27</td>\n<td>102</td>\n<td>1250</td>\n<td>12.3</td>\n<td>6</td>\n<td>42</td>\n</tr>\n<tr>\n<td>Keenan Allen </td>\n<td>LAC</td>\n<td>28</td>\n<td>100</td>\n<td>992</td>\n<td>9.9</td>\n<td>8</td>\n<td>28</td>\n</tr>\n<tr>\n<td>Tyler Lockett</td>\n<td>SEA</td>\n<td>28</td>\n<td>100</td>\n<td>1054</td>\n<td>10.5</td>\n<td>10</td>\n<td>47</td>\n</tr>\n<tr>\n<td>JuJu Smith-Schuster</td>\n<td>PIT</td>\n<td>24</td>\n<td>97</td>\n<td>831</td>\n<td>8.6</td>\n<td>9</td>\n<td>31</td>\n</tr>\n<tr>\n<td>Robby Anderson</td>\n<td>CAR</td>\n<td>27</td>\n<td>95</td>\n<td>1096</td>\n<td>11.5</td>\n<td>3</td>\n<td>75</td>\n</tr>\n<tr>\n<td>Amari Cooper</td>\n<td>DAL</td>\n<td>26</td>\n<td>92</td>\n<td>1114</td>\n<td>12.1</td>\n<td>5</td>\n<td>69</td>\n</tr>\n<tr>\n<td>Cooper Kupp</td>\n<td>LAR</td>\n<td>27</td>\n<td>92</td>\n<td>974</td>\n<td>10.6</td>\n<td>3</td>\n<td>55</td>\n</tr>\n<tr>\n<td>Calvin Ridley</td>\n<td>ATL</td>\n<td>26</td>\n<td>90</td>\n<td>1374</td>\n<td>15.3</td>\n<td>9</td>\n<td>63</td>\n</tr>\n<tr>\n<td>Robert Woods</td>\n<td>LAR</td>\n<td>28</td>\n<td>90</td>\n<td>936</td>\n<td>10.4</td>\n<td>6</td>\n<td>56</td>\n</tr>\n<tr>\n<td>Justin Jefferson</td>\n<td>MIN</td>\n<td>21</td>\n<td>88</td>\n<td>1400</td>\n<td>15.9</td>\n<td>7</td>\n<td>71</td>\n</tr>\n</tbody>\n</table>",
