   "id": 528792,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compute the mean of the numbers 5, 8, 11, 12, 12, 12, 15, 18, and 20. Round your answer to three decimal places.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The mean is the sum of the values, divided by the number of values.</p>\n<p><span data-math=\"\\frac{{5 + 8 + 11 + 12 + 12 + 12 + 15 + 18 + 20}}{9} \\approx 15.556\"></span></p>\n<p>The mean is 15.556.</p>"
    },
