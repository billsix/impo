   "id": 545157,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use traditional rounding to determine the number of laptops assigned to each classroom.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The total population of students: <span data-math=\"{\\text{30  +  25  +  28  +  32  +  24  +  27  =  166}}\"></span> students. <span data-math=\"{\\text{Standard Divisor = }}\\frac{{{\\text{Total Population}}}}{{{\\text{House Size}}}} = \\frac{{{\\text{166 students}}}}{{{\\text{34 laptops}}}} \\approx 4.88{\\text{ students per laptop}}\"></span></p>\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>Room</th>\n<th><span data-math=\"{\\text{Standard Quota = }}\\frac{{{\\text{State Population}}}}{{{\\text{Standard Divisor}}}}{\\text{ }}\"></span></th>\n<th>Rounded Laptops</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>A</td>\n<td><span data-math=\"\\frac{{{\\text{30 students}}}}{{4.88{\\text{ students per laptop}}}}{\\text{ = 6}}{\\text{.15 laptops}}\"></span></td>\n<td>6</td>\n</tr>\n<tr>\n<td>B</td>\n<td><span data-math=\"\\frac{{{\\text{25 students}}}}{{4.88{\\text{ students per laptop}}}}{\\text{ = 5}}{\\text{.13 laptops}}\"></span></td>\n<td>5</td>\n</tr>\n<tr>\n<td>C</td>\n<td><span data-math=\"\\frac{{{\\text{28 students}}}}{{4.88{\\text{ students per laptop}}}}{\\text{ = 5}}{\\text{.74 laptops}}\"></span></td>\n<td>6</td>\n</tr>\n<tr>\n<td>D</td>\n<td><span data-math=\"\\frac{{{\\text{32 students}}}}{{4.88{\\text{ students per laptop}}}}{\\text{ = 6}}{\\text{.56 laptops}}\"></span></td>\n<td>7</td>\n</tr>\n<tr>\n<td>E</td>\n<td><span data-math=\"\\frac{{{\\text{24 students}}}}{{4.88{\\text{ students per laptop}}}}{\\text{ = 4}}{\\text{.92 laptops}}\"></span></td>\n<td>5</td>\n</tr>\n<tr>\n<td>F</td>\n<td><span data-math=\"\\frac{{{\\text{27 students}}}}{{4.88{\\text{ students per laptop}}}}{\\text{ = 5}}{\\text{.53 laptops}}\"></span></td>\n<td>6</td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "6, 5, 6, 7, 5, 6"
    }
   ],
