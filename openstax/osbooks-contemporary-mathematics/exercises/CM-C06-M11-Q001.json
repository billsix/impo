 "questions": [
  {
   "id": 519445,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Luther negotiates for the price of his car, reaching agreement at $28,975. He needs to pay 8% in sales tax, 2.1% in ownership tax, a $950 destination fee, processing fees totaling $370, and registration fee of $617. What is the total cost for Luther’s purchase?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Add 8% and 2.1% for a total percentage of 10.1%.</p>\n<p>Find 10.1% of $28,975.</p>\n<p><span data-math=\"0.101{\\text{ }} \\times {\\text{ }}28,975{\\text{ }} = {\\text{ }}\\$2,926.48\"></span></p>\n<p>Add this to the cost and fees.</p>\n<p><span data-math=\"28,975{\\text{ }} + {\\text{ }}2,926.48{\\text{ }} + {\\text{ }}950{\\text{ }} + {\\text{ }}370{\\text{ }} + {\\text{ }}617{\\text{ }} = {\\text{ }}\\$33,838.48\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$33,838.48"
    }
   ],
   "community_solutions": []
  }
 ],
