 "questions": [
  {
   "id": 518729,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Oksana deposits $5,000 in a CD that earned 3% compounded annually and was worth $5,627.54 after 4 years. Had Oksana invested in a CD with simple interest, how much would the CD have been worth after 4 years? How much more did Oksana earn using compound interest?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>From the previous exercise, you know she earned $5,627.54 when compounded annually.</p>\n<p>Find the amount if earning simple interest:</p>\n<p><span data-math=\"I = P \\times r \\times t\"></span></p>\n<p><span data-math=\"I = 5,000 \\times 0.03 \\times 4 = \\$ 600\"></span></p>\n<p><span data-math=\"T = P + I = 5,000 + 600 = \\$ 5,600\"></span></p>\n<p>You earned $27.54 more when compounding interest.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "CD would have been worth $5,600. Oksana earned $27.54 more with compound interest."
    }
   ],
   "community_solutions": []
  }
 ],
