 "questions": [
  {
   "id": 527486,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A hot dog was cooked in a microwave oven. The hot dog was 4 °C when it was put in the microwave and the temperature increased by 59 °C when it was taken out. What was the temperature of the cooked hot dog?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>An increase in the temperature means it is higher. Add 59° to 4°C.</p>\n<p><span data-math=\"4 + 59 = 63^{\\circ}{\\rm C}\"></span></p>\n<p>The temperature of the cooked hot dog was 63°C.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "63 °C"
    }
   ],
   "community_solutions": []
  }
 ],
