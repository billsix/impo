 "questions": [
  {
   "id": 510730,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Convert 9,275 to base 12.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: Divide the number by 12.</p>\n<p><span data-math=\"9,275 \\div 12 = 772\"></span> with a remainder. What is it?</p>\n<p><span data-math=\"12 \\times 772 = 9,264\"></span></p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"9,275-9,264 = -11\"></span></td>\n<td><span data-math=\"772{\\rm{R}}11\\;\\left({{\\rm{B}}\\;{\\rm{in}}\\;{\\rm{base}}\\;12} \\right)\"></span></td>\n</tr>\n<tr>\n<td>Step 2: Divide the quotient by 2.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"772 \\div 12 = 64\"></span> with a remainder. What is it?</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"12 \\times 64 = 768\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"772-768 = 4\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td>The remainder is 4.</td>\n<td><span data-math=\"64{\\rm{R}}4\"></span></td>\n</tr>\n<tr>\n<td>Step 3: Divide the quotient by 12.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"64 \\div 12 = 5\"></span> with a remainder. What is it?</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"12 \\times 5 = 60\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"64-60 = 4\"></span></td>\n<td><span data-math=\"5{\\rm{R}}4\"></span></td>\n</tr>\n<tr>\n<td>Step 4: Divide the quotient by 12.</td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"5 \\div 12 = 0\"></span> with remainder 5.</td>\n<td><span data-math=\"0{\\rm{R}}5\"></span></td>\n</tr>\n</tbody>\n</table>\n<p>The base 12 number has digits equal to the remainders in reverse order: <span data-math=\"544{{\\rm{B}}_{12}}\"></span>.</p>"
    },
    {
