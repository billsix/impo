 "questions": [
  {
   "id": 510533,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When counting in base 9, what number would follow 38<sub>9</sub>?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "There is no 9 digit in base 9, so you increase from 38<sub>9</sub> by moving over to the 9s place and increasing 3 to 4. The number after 38 (base 9) is 40 (base 9)."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "40<sub>9</sub>"
    }
   ],
   "community_solutions": []
  }
 ],
