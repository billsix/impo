 "is_vocab": false,
 "stimulus_html": "For the following exercises, determine the most reasonable value for each volume.",
 "questions": [
  {
   "id": 526679,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Terrarium: 50,000 km<sup>3</sup>, 50,000 m<sup>3</sup>, 50,000 cm<sup>3</sup>, or 50,000 mm<sup>3</sup>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A 50,000 cubic centimeter terrarium is roughly equivalent to a rectangular prism that is 37 centimeters on each side. This is a reasonable value."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "50,000 cm<sup>3</sup>"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 526680,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Milk carton: 236,000 L, 236 L, 236,000 mL, or 236 mL",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A 236-milliliter carton of milk is close to a half-pint carton of milk. This is a reasonable value."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "236 mL"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 526681,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Box of crackers: 1,500 km<sup>3</sup>, 1,500 m<sup>3</sup>, 1,500 cm<sup>3</sup>, or 1,500 mm<sup>3</sup>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A 1,500-cubic centimeter box of crackers, if it were a rectangular prism, would be approximately 11.4 cm on each side. This is a reasonable value."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1,500 cm<sup>3</sup>"
    }
   ],
   "community_solutions": []
  }
 ],
