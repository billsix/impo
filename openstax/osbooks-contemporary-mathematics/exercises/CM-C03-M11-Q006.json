 "questions": [
  {
   "id": 506187,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You have a square 1 meter on each side. You begin by coloring one half of the square blue. Then you color half the remaining area blue. Then you color half the remaining area blue once more. At each step, you color half the remaining area. What is the total area you have colored blue after performing this process 15 times?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>First term: 0.5 of square is blue, 0.5 is not blue.</p>\n<p>Second term: You’ve colored half of the remaining area, so 0.75 is blue. 0.25 is not blue.</p>\n<p>Third term: You’ve colored half of the remaining area. 0.875 is blue; 0.125 is not blue.</p>\n<p>Fourth term: You’ve colored half of the remaining area. 0.9375 is blue; 0.0625 is not blue.</p>\n<p>The common ratio for what is not blue is 0.5.</p>\n<p>The blue numbers are not a geometric sequence, but the not blue numbers are. You can find the 15th term of the not blue numbers and subtract that from 1.</p>\n<p><span data-math=\"1 - {a_{15}} = 1 - {a_1}{r^{n - 1}} = 1 - 0.5{\\left( {0.5} \\right)^{14}} \\approx 0.9999694824\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "0. 99996948242188"
    }
   ],
   "community_solutions": []
  }
 ],
