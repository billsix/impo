 "questions": [
  {
   "id": 220048,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Explain what distinguishes a proper subset of a set from a subset of a set.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<p>To be a subset of a set, every member of the subset must also be a member of the set. To be a proper subset, there must be at least one member of the set that is not also in the subset. </p>"
    }
   ],
