 "questions": [
  {
   "id": 544853,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The reading coach at an elementary school has 13 gift cards to distribute to their three students as a reward for time spent reading. When they calculated the standard quota for each student based on the number of minutes they student had read, the results were: 4.49 gift cards, 4.03 gift cards, and 4.48 gift cards. How does this demonstrate the apportionment problem?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>You cannot give out fractional gift cards. Round the gift card amounts using traditional rounding and add the results.</p>\n<p><span data-math=\"{\\text{4  +  4  +  4  =  12}}\"></span></p>\n<p>There are 13 cards. This leaves out one gift card.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "It is not possible to give a fractional part of a gift card. Also, traditional rounding to the nearest integer results in 4 gift cards for each student, which leaves one extra gift card."
    }
   ],
   "community_solutions": []
  }
 ],
