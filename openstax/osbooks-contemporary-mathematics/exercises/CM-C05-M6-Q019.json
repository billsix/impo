 "questions": [
  {
   "id": 508848,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Graph and list the solutions to the quadratic equation <span data-math=\"{x^2} - 5x - 14=0\">{x^2} - 5x - 14=0</span>.\n\n<img src=\"exercises/media/9915c3d954323535.jpg\" alt=\"A parabola is plotted on an x y coordinate plane. The x and y axes range from negative 10 to 10, in increments of 1. The parabola opens up and it passes through the following points, (negative 2, 0) and (7, 0). The parabola is partially visible.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 508849,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Graph and list the solutions to the quadratic equation <span data-math=\"{x^2} + 10x + 24=0\">{x^2} + 10x + 24=0</span>.\n\n<img src=\"exercises/media/81f53ced864c206e.jpg\" alt=\"A parabola is plotted on an x y coordinate plane. The x and y axes range from negative 10 to 10, in increments of 1. The parabola opens up and it passes through the following points, (negative 6, 0), (negative 5, negative 1), and (negative 4, 0).\">",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 508850,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Graph and list the solutions to the quadratic equation <span data-math=\"{x^2} - 25=0\">{x^2} - 25=0</span>.\n\n<img src=\"exercises/media/fc8b6ff4351984bc.jpg\" alt=\"A parabola is plotted on an x y coordinate plane. The x and y axes range from negative 10 to 10, in increments of 1. The parabola opens up and it passes through the following points, (negative 5, 0) and (5, 0). The parabola is partially visible.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 508851,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the solutions of <span data-math=\"y = {x^2} + 2x - 15\">y = {x^2} + 2x - 15</span> from its graph.\n<img src=\"exercises/media/8477e2a6051b2227.jpg\" alt=\"A parabola is plotted on an x y coordinate plane. The x and y axes range from negative 10 to 10, in increments of 1. The parabola opens up and it passes through the following points, (negative 5, 0) and (3, 0). The parabola is partially visible.\">",
   "answers": [],
