   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the volume of the cylinder where the radius of the base is <span data-math=\"10\\,\\text{cm}\">10\\,\\tet{cm}</span>, and the height is <span data-math=\"5\\,\\text{cm}\">5\\,\\text{cm}</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The volume of a right cylinder with radius <i>r</i> and height <i>h</i> is <span data-math=\"V = \\pi {r^2}h\"></span>.</p>\n<p><span data-math=\"V = \\pi {r^2}h = \\pi {\\left( {{\\text{10 cm}}} \\right)^2}\\left( {{\\text{5 cm}}} \\right) \\approx 1,571{\\text{ c}}{{\\text{m}}^3}\"></span></p>\n<p>The volume is approximately 1,571 cubic centimeters.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"1,570\\,\\text{cm}{^3}\">1,570\\,\\text{cm}{^3}</span>"
    }
   ],
   "community_solutions": []
  }
