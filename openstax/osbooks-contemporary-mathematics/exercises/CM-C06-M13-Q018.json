 "questions": [
  {
   "id": 517599,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Arianne earned $3,200 over a 2-week pay period. How much FICA tax does she pay, and how much of that is for SSI?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>FICA stands for Federal Insurance Contributions Act of 1935. FICA taxes fund Social Security and Medicare and are automatically withdrawn from your pay. You pay 7.65 percent of your gross pay and your employer matches your amount. Of the 7.65 percent, 6.2 percent goes to Social Security (SSI) and 1.45 percent goes to Medicare. The Social Security (SSI) part only applies to the first $147,000 of your earnings, but the Medicare tax applies to all your gross earnings.</p>\n<p>$3,200 per two-week pay period</p>\n<p>3,200(26) = $83,200</p>\n<p>This is under $147,000, so it is all taxable by both components of FICA.</p>\n<p>Find 7.65% of $3,200 to find the FICA contribution.</p>\n<p>0.0765(3,200) = $244.80 goes to FICA</p>\n<p>Find 6.2% of $3,200 to find the SSI part:</p>\n<p>0.062(3,200) = $198.40 to SSI</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "FICA is $244.80, SSI is $198.40"
    }
   ],
   "community_solutions": []
  }
 ],
