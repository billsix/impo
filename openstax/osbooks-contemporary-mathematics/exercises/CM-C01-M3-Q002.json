 "questions": [
  {
   "id": 494477,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p>Describe the relationship between the sets in the following Venn diagram.</p>\n<figure>\n<figcaption></figcaption>\n<img src=\"exercises/media/7e74b063f4edaeb8.png\" alt=\"A two-set Venn diagram not intersecting one another is given. Outside the Venn diagram, 'U equals Birds' is labeled. The first set is labeled E equals Eagles while the second set is labeled C equals the Canaries.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Sets are disjoint if they have no members in common. No member of the set of Eagles is a member of the set of Canaries. No member of the set of Canaries is a member of the set of Eagles. These sets are disjoint."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The set of eagles and the set of canaries are two disjoint subsets of the universal set of all birds. No eagle is a canary, and no canary is an eagle."
    }
   ],
   "community_solutions": []
  }
 ],
