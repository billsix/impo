 "questions": [
  {
   "id": 505537,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Calene calls her mother every fourth day. She calls on a Monday. What day of the week will it be on Calene's eighth time calling after that?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>If Calene calls every fourth day and she calls eight times, then 32 days have passed.</p>\n<p>Find 32 mod 7.</p>\n<p>To find what day it is, you need to find 32 modulo 7.</p>\n<p>32 ÷ 7 = 4 and a remainder. What is that remainder?</p>\n<p><span data-math=\"7 \\times 4 = 28\"></span></p>\n<p>Subtract 28 from 32.</p>\n<p><span data-math=\"32 – 28 = 4\"></span></p>\n<p>The remainder is 4.</p>\n<p>The remainder is the solution to 32 modulo 7.</p>\n<p>32 modulo 7 ≡ 4</p>\n<p>Four days after Monday is Friday.</p>\n<p>It will be Friday when Calene calls her mother again.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Friday"
    }
   ],
   "community_solutions": []
  }
 ],
