 "questions": [
  {
   "id": 507543,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Juliette is 2 inches taller than her friend Vivian. Which algebraic equations represent their height? Use <span data-math=\"J\">J</span> for Juliette’s height and <span data-math=\"V\">V</span> for Vivian’s height.<br>\n<span data-math=\"J = V + 2\">J = V + 2</span>\n<br>\n<span data-math=\"V = J-2\">V = J-2</span>\n<br>\n<span data-math=\"J + 2 = V\">J + 2 = V</span>\n<br>\n<span data-math=\"J = V-2\"> J = V-2</span>\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Juliette is 2 inches taller than Vivian.</p>\n<p>You can test these with sample numbers. If Vivian is 50 inches tall, then Juliette is 52 inches tall.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"J = V + 2\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"52 = 50 + 2\"></span></td>\n<td>This works, so <span data-math=\"J = V + 2\"></span> works.</td>\n</tr>\n<tr>\n<td><span data-math=\"V = J - 2\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"50 = 52 - 2\"></span></td>\n<td>This works, so <span data-math=\"V = J - 2\"></span> works.</td>\n</tr>\n<tr>\n<td><span data-math=\"J + 2 = V\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"52 + 2 = 50\"></span></td>\n<td>This is false, so this does not work.</td>\n</tr>\n<tr>\n<td><span data-math=\"J = V - 2\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"52 = 50 - 2\"></span></td>\n<td>This is false, so this does not work.</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"J = V + 2\">J = V + 2</span>, <span data-math=\"V = J - 2\">J = V + 2</span>"
    }
   ],
   "community_solutions": []
  }
 ],
