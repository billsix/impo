 "questions": [
  {
   "id": 505817,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Correctly  apply the rules for the order of operations to accurately compute <span data-math=\"{\\left( {\\frac{3}{{16}} + \\frac{7}{{16}}} \\right)^2} + \\frac{1}{5} \\div \\frac{3}{{10}}\">{\\left( {\\frac{3}{{16}} + \\frac{7}{{16}}} \\right)^2} + \\frac{1}{5} \\div \\frac{3}{{10}}</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"{\\left({\\frac{3}{{16}} + \\frac{7}{{16}}} \\right)^2} + \\frac{1}{5} \\div \\frac{3}{{10}}\"></span></p>\n<p>Use PEMDAS.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>Add the fractions inside the parentheses.</td>\n<td><span data-math=\"{\\left({\\frac{{10}}{{16}}} \\right)^2} + \\frac{1}{5} \\div \\frac{3}{{10}}\"></span></td>\n</tr>\n<tr>\n<td>Simplify.</td>\n<td><span data-math=\"{\\left({\\frac{5}{8}} \\right)^2} + \\frac{1}{5} \\div \\frac{3}{{10}}\"></span></td>\n</tr>\n<tr>\n<td>Evaluate the exponent.</td>\n<td><span data-math=\"\\frac{{25}}{{64}} + \\frac{1}{5} \\div \\frac{3}{{10}}\"></span></td>\n</tr>\n<tr>\n<td>Divide. Multiply by the reciprocal.</td>\n<td><span data-math=\"\\frac{{25}}{{64}} + \\frac{1}{5} \\times \\frac{{10}}{3}\"></span></td>\n</tr>\n<tr>\n<td></td>\n<td><span data-math=\"\\frac{{25}}{{64}} + \\frac{{10}}{{15}}\"></span></td>\n</tr>\n<tr>\n<td></td>\n<td><span data-math=\"\\frac{{25}}{{64}} + \\frac{2}{3}\"></span></td>\n</tr>\n<tr>\n<td>Add. The LCM is 192.</td>\n<td><span data-math=\"\\frac{{25 \\times 3}}{{64 \\times 3}} + \\frac{{2 \\times 64}}{{3 \\times 64}}\"></span></td>\n</tr>\n<tr>\n<td></td>\n<td><span data-math=\"\\frac{{75}}{{192}} + \\frac{{128}}{{192}}\"></span></td>\n</tr>\n<tr>\n<td></td>\n<td><span data-math=\"\\frac{{203}}{{192}}\"></span></td>\n</tr>\n<tr>\n<td>Alternate correct answer:</td>\n<td><span data-math=\"1\\frac{{11}}{{192}}\"></span></td>\n</tr>\n</tbody>\n</table>"
    },
