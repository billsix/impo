   ],
   "combo_choices": []
  },
  {
   "id": 323310,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the slope of the regression line that we would use to predict the 75th percentile SAT math score from the 75th percentile ACT English score at public schools, and write a sentence to interpret that slope.",
