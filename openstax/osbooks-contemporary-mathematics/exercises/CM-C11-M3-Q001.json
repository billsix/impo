 "is_vocab": false,
 "stimulus_html": "<p>The SAT is to be administered at a high school. In preparation, pencils have been distributed to each of the classrooms based on the room capacity. Use the information in the following table to answer each question.</p>\n<table class=\"unnumbered\">\n<tbody><tr><th>\n</th></tr><tr>\n<td><b>Room Number</b></td>\n<td>B</td>\n<td>C</td>\n<td>D</td>\n<td>E</td>\n</tr>\n<tr>\n<td><b>Room Capacity (number of student desks)</b></td>\n<td>24</td>\n<td>18</td>\n<td>32</td>\n<td>22</td>\n</tr>\n<tr>\n<td><b>Number of Pencils</b></td>\n<td>36</td>\n<td>27</td>\n<td>48</td>\n<td>33</td>\n</tr>\n</tbody></table>",
 "questions": [
  {
   "id": 545069,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the part to part ratio of desks to pencils for each room. Represent it as both a reduced fraction and a decimal rounded to the nearest hundredth as needed.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Divide the first quantity by the second quantity.</p>\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>&nbsp;</th>\n<th>B</th>\n<th>C</th>\n<th>D</th>\n<th>E</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Desks to Pencils</td>\n<td><span data-math=\"\\frac{{24}}{{36}} = \\frac{2}{3} \\approx 0.67\"></span></td>\n<td><span data-math=\"\\frac{{18}}{{27}} = \\frac{2}{3} \\approx 0.67\"></span></td>\n<td><span data-math=\"\\frac{{32}}{{48}} = \\frac{2}{3} \\approx 0.67\"></span></td>\n<td><span data-math=\"\\frac{{22}}{{33}} = \\frac{2}{3} \\approx 0.67\"></span></td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "B <span data-math=\"\\frac{2}{3}\">\\frac{2}{3}</span>; 0.67, C <span data-math=\"\\frac{2}{3}\">\\frac{2}{3}</span>; 0.67, D <span data-math=\"\\frac{2}{3}\">\\frac{2}{3}</span>; 0.67, and E <span data-math=\"\\frac{2}{3}\">\\frac{2}{3}</span>; 0.67"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545070,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the part to part ratio of pencils to desks for each room. Represent it as both a reduced fraction and a decimal rounded to the nearest hundredth as needed.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>&nbsp;</th>\n<th>B</th>\n<th>C</th>\n<th>D</th>\n<th>E</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Pencils to Desks</td>\n<td><span data-math=\"\\frac{{36}}{{24}} = \\frac{3}{2} = 1.5\"></span></td>\n<td><span data-math=\"\\frac{{27}}{{18}} = \\frac{3}{2} = 1.5\"></span></td>\n<td><span data-math=\"\\frac{{48}}{{32}} = \\frac{3}{2} = 1.5\"></span></td>\n<td><span data-math=\"\\frac{{33}}{{22}} = \\frac{3}{2} = 1.5\"></span></td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "B <span data-math=\"\\frac{3}{2}\">\\frac{3}{2}</span>; 1.5, C <span data-math=\"\\frac{3}{2}\">\\frac{3}{2}</span>; 1.5, D <span data-math=\"\\frac{3}{2}\">\\frac{3}{2}</span>; 1.5, and E <span data-math=\"\\frac{3}{2}\">\\frac{3}{2}</span>; 1.5"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 545071,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Have the pencils been distributed proportionally? If so, what is the constant ratio of pencils to desks? Give the units.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes, the constant ratio is <span data-math=\"\\frac{3}{2}\">\\frac{3}{2}</span> pencils per desk."
    }
   ],
   "community_solutions": []
  }
