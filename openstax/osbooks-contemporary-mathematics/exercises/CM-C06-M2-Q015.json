 "stimulus_html": "Find the purchase price for the indicated sales tax rate and total price.",
 "questions": [
  {
   "id": 517194,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sales tax rate = 8.25%; total price = $157.81",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>total price = purchase price × (1 + tax rate)</p>\n<p>157.81 = purchase price × (1 + 0.0825)</p>\n<p>157.81 = purchase price × (1.0825)</p>\n<p><span data-math=\"\\frac{{157.81}}{{1.0825}}\"></span> = purchase price</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>$145.78 ≈ purchase price</td>\n<td>(rounded to the nearest cent)</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$145.78"
    }
   ],
   "community_solutions": []
  },
  {
