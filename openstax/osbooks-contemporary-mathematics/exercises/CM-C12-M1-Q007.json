   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Think of a graph that represents a map where the districts are vertices and edges represent shared borders. Suppose a district was an entire island. The island would have no shared borders. It would be an isolated vertex in the graph to represent a map. It would have degree 0 since no edges would be shared with another vertex."
    },
