 "questions": [
  {
   "id": 533271,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use the Pythagorean Theorem to find the missing side of the right triangle shown.<br>\n<figure>\n<img src=\"exercises/media/83fdb8954f702a7c.png\" alt=\"A right triangle with its legs marked 12 and a. The hypotenuse is marked 13.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The Pythagorean Theorem states <span data-math=\"{a^2} + {b^2} = {c^2}\"></span> where <i>a</i> and <i>b</i> are two sides (legs) of a right triangle and <i>c</i> is the hypotenuse.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"{a^2} + {12^2} = {13^2}\"></span></td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><span data-math=\"{a^2} + 144 = 169\"></span></td>\n<td>Simplify.</td>\n</tr>\n<tr>\n<td><span data-math=\"{a^2} = 25\"></span></td>\n<td>Subtract.</td>\n</tr>\n<tr>\n<td><span data-math=\"a = \\pm \\sqrt {25} \"></span></td>\n<td>Use the Square Root Property.</td>\n</tr>\n<tr>\n<td><span data-math=\"a = 5\"></span></td>\n<td>Simplify. Lengths cannot be negative.</td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"a = 5\">a = 5</span>"
    }
   ],
   "community_solutions": []
  }
 ],
