 "is_vocab": false,
 "stimulus_html": "For the following problems, decide whether randomization is being used in the selection of these samples.  If it is, identify the type of random sample (simple, systematic, cluster, or stratified).",
 "questions": [
  {
   "id": 528331,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "High school guidance counselors want to know the proportion of the school’s seniors who intend to apply for college. They choose four senior homerooms at random, then visit each one and ask every student in those homerooms whether they intend to apply.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This is a cluster sample since seniors are selected a homeroom at a time. A cluster sample is a sample where clusters of units are chosen at random, instead of choosing individual units."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Randomization is being used; cluster random sample."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 528332,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A quality control technician wants to ensure that the sandals being made in his factory are up to specifications, so they check the first five pairs they see coming off the line.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "No randomization is being used."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 528333,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A college athletic department wants to check up on the mental wellness of its student-athletes. The department wants to ensure every varsity sport is represented, so they survey three randomly selected members of each team.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A stratified sample is chosen so that particular groups in the population are certain to be represented. This is a stratified random sample since they sampled within each sport."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Randomization is being used; stratified random sample."
    }
   ],
   "community_solutions": []
  }
 ],
