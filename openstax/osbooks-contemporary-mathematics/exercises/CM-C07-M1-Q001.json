   "id": 515416,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Joe’s Pizza Shack offers pizzas with 4 different types of crust and a choice of 15 toppings. How many different one-topping pizzas can be made at Joe’s?",
   "answers": [],
   "hints": [],
