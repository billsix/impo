   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The Multiplication Rule of Counting says that if there are <i>n</i> ways to accomplish one task and <i>m</i> ways to accomplish a second task, then there are <span data-math=\"n{\\text{ }} \\times {\\text{ }}m\"></span> ways to accomplish both tasks. You can tack on additional tasks by multiplying the number of ways to accomplish those tasks to your previous product.</p>\n<p><span data-math=\"4{\\text{ }} \\times {\\text{ }}15{\\text{ }} = {\\text{ }}60\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"4 \\times 15 = 60\">4 \\times 15 = 60</span>"
    }
   ],
   "community_solutions": []
  }
 ],
