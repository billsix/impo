 "questions": [
  {
   "id": 504907,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Place these integers in increasing order: 4, −2, −7, 10, −13.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Consider a number line marked with tick marks to represent every integer. The farther a number is to the left, the less its value.</p>\n<p>The negative numbers are on the left of zero.</p>\n<p>The number farthest to the left is –13, then –7, then –2.</p>\n<p>The positive numbers are to the right of zero.</p>\n<p>Of the positive numbers, 4 is left of 10.</p>\n<p>In increasing order: –13, –7, –2, 4, 10</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "−13, −7, −2, 4, 10"
    }
   ],
   "community_solutions": []
  }
 ],
