 "questions": [
  {
   "id": 288351,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An artist creates a glass paperweight. They decide they want to box and ship the paperweight, so they measure and determine that the volume of the cubic box is 125,000 mm<sup>3</sup>. Does their calculation make sense? Explain your answer.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes. The unit of value, mm<sup>3</sup>, may be appropriate given the size of the paperweight. The volume of 125,000 mm<sup>3</sup> is equivalent to a volume of 125 cm<sup>3</sup>, which would represent a cubic box with dimensions of\n<span data-math=\"5\\,{\\text{cm}}\\times 5\\,{\\text{cm}} \\times 5\\,{\\text{cm}}\">5\\,{\\text{cm}}\\times 5\\,{\\text{cm}}\\, \\times 5\\,{\\text{cm}}</span>."
    }
   ],
   "community_solutions": []
  }
 ],
