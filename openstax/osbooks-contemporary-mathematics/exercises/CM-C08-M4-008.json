 "is_vocab": false,
 "stimulus_html": "<p>The following are data on the admission rates of the different branch campuses in the University of California system, along with the out-of-state tuition and fee cost.</p>\n<table class=\"unnumbered\"><caption>(source: https://data.ed.gov)</caption>\n<thead>\n<tr>\n<th>Campus</th>\n<th>Admission Rate</th>\n<th>Cost ($)</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Berkeley</td>\n<td>0.1484</td>\n<td>43,176</td>\n</tr>\n<tr>\n<td>Davis</td>\n<td>0.4107</td>\n<td>43,394</td>\n</tr>\n<tr>\n<td>Irvine</td>\n<td>0.2876</td>\n<td>42,692</td>\n</tr>\n<tr>\n<td>Los Angeles</td>\n<td>0.1404</td>\n<td>42,218</td>\n</tr>\n<tr>\n<td>Merced</td>\n<td>0.6617</td>\n<td>42,530</td>\n</tr>\n<tr>\n<td>Riverside</td>\n<td>0.5057</td>\n<td>42,819</td>\n</tr>\n<tr>\n<td>San Diego</td>\n<td>0.3006</td>\n<td>43,159</td>\n</tr>\n<tr>\n<td>Santa Barbara</td>\n<td>0.322</td>\n<td>43,383</td>\n</tr>\n<tr>\n<td>Santa Cruz</td>\n<td>0.4737</td>\n<td>42,952</td>\n</tr>\n</tbody>\n</table>",
 "questions": [
  {
   "id": 529119,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compute the range of the admission rate.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Enter the Admission values into a Google Sheet so you can use technology to help you.</p>\n<p>In a blank cell, enter “=MAX” and click on the letter at the top of the column where you entered your data values. You will see the maximum is 0.6617.</p>\n<p>In a blank cell, enter “=MIN” and click on the letter at the top of the column where you entered your data values. You will see the minimum is 0.1404.</p>\n<p>The range is the difference: <span data-math=\"0.6617 - 0.1404 = 0.5213\"></span>.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Range: <span data-math=\"0.6617 - 0.1404 = 0.5213\">0.6617 - 0.1404 = 0.5213</span>\n"
    }
   ],
