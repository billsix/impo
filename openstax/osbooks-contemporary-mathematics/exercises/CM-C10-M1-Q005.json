 "is_vocab": false,
 "stimulus_html": "For the following exercises, refer to the given figure.<br>\n<figure>\n<img src=\"exercises/media/53774b810124970a.png\" alt=\"A line, a ray, and a line segment are graphed on an x y coordinate plane. The x and y axes range from negative 7 to 7, in increments of 1. The line segment, C D begins at C (3, negative 6) and D (5, negative 2). The ray, EF passes through the points, E (3, 2) and F (5, 5). The line, A B passes through the points, A (negative 5, negative 2) and B (negative 3, 4).\">\n</figure>",
 "questions": [
  {
   "id": 306430,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify the location of points <span data-math=\"A\">A</span>, <span data-math=\"B\">B</span>, <span data-math=\"C\">C</span>, <span data-math=\"D\">D</span>, <span data-math=\"E\">E</span>, and <span data-math=\"F\">F</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Point <span data-math=\"A\">A</span> is located at <span data-math=\"( - 5, - 2)\">( - 5, - 2)</span>; Point <span data-math=\"B\">B</span> is located at <span data-math=\"(- 3,4)\">(- 3,4)</span>; Point <span data-math=\"C\">C</span> is located at <span data-math=\"(3, - 6)\">(3, - 6)</span>;  Point <span data-math=\"D\">D</span> is located at <span data-math=\"(5, - 2)\">(5, - 2)</span>; Point <span data-math=\"E\">E</span> is located at <span data-math=\"(3,2)\">(3,2)</span>; Point <span data-math=\"F\">F</span> is located at <span data-math=\"(5,5)\">(5,5)</span>."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 306431,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Describe the line that includes point <span data-math=\"A\">A</span> and point <span data-math=\"B\">B</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Points <span data-math=\"A\">A</span> and <span data-math=\"B\">B</span> are on the straight line <span data-math=\"\\overleftrightarrow {AB}\">\\overleftrightarrow {AB}</span>."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 306432,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Describe the line from <span data-math=\"E\">E</span> to point <span data-math=\"F\">F</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The line that begins at point <span data-math=\"E\">E</span> in the direction of point <span data-math=\"F\">F</span> is a ray, <span data-math=\"\\overrightarrow {EF}\">\\overrightarrow {EF}</span>."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 306433,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Describe the line from <span data-math=\"C\">C</span> to point <span data-math=\"D\">D</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The line from point <span data-math=\"C\">C</span> to point <span data-math=\"D\">D</span> is a line segment <span data-math=\"\\overline {CD} \">\\overline {CD} </span>."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 306434,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Does this figure represent a plane?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes, this represents a plane. One reason is that the figure contains four points that are not on the line <span data-math=\"\\overleftrightarrow {AB}\">\\overleftrightarrow {AB}</span>."
    }
   ],
   "community_solutions": []
  }
