 "is_vocab": false,
 "stimulus_html": "Use the figure to determine if each sequence of vertices represents an Euler trail or not. If not, explain why.\n<figure>\n<figcaption>Graph <i>I</i></figcaption>\n<img src=\"exercises/media/d220e6c355e73aee.png\" alt=\"Graph I has 8 vertices labeled a to h. The edges connect a b, b f, a d, f e, e d, d c, c g, g h, and e h.\">\n</figure>",
 "questions": [
  {
   "id": 543833,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<i>e</i> → <i>f</i> → <i>b</i> → <i>a</i> → <i>d</i> → <i>c</i> → <i>g</i> → <i>h</i> → <i>e</i> → <i>d</i>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Draw the graph lightly. Then draw the sequence of edges in another color. Since you have covered all the edges exactly once, this is an Euler circuit."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 543834,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<i>d</i> → <i>a</i> → <i>b</i> → <i>f</i> → <i>e</i> → <i>h</i> → <i>g</i> → <i>c</i>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Draw the graph lightly. Then draw the sequence of edges in another color. Since you have not covered all the edges exactly once, this is not an Euler circuit. You missed <i>cd</i> and <i>de</i>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "No. It doesn’t cover every edge."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 543835,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<i>d</i> → <i>a</i> → <i>b</i> → <i>e</i> → <i>f</i> → <i>b</i> → <i>e</i> → <i>d</i> → <i>c</i> → <i>g</i> → <i>h</i> → <i>e</i>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Draw the graph lightly. Then draw the sequence of edges in another color. Since you have not covered all the edges exactly once, this is not an Euler circuit. In this case, it is not even possible to follow the sequences since <i>b</i> and <i>e</i> are not adjacent."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "No. It is not a walk, because the vertices <i>b</i> and <i>e</i> are not adjacent."
    }
   ],
   "community_solutions": []
  }
 ],
