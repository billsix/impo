 "is_vocab": false,
 "stimulus_html": "<p>The following table displays the effect of increasing the size of the divisor. Observe the effect this has on the modified quotas of smaller states versus larger states and use the table  to answer each question.</p>\n<table class=\"unnumbered\" summary=\".\">\n<thead>\n<tr>\n<th></th>\n<th></th>\n<th colspan=\"3\">Modified Quotas</th>\n</tr>\n<tr>\n<th>State</th>\n<th>Population</th>\n<th>Divisor: 11,500</th>\n<th>Divisor: 12,000</th>\n<th>Divisor: 12,500</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>A</td>\n<td>10,000</td>\n<td>0.87</td>\n<td>0.83</td>\n<td>0.8</td>\n</tr>\n<tr>\n<td>B</td>\n<td>100,000</td>\n<td>8.7</td>\n<td>8.33</td>\n<td>8</td>\n</tr>\n<tr>\n<td>C</td>\n<td>1,000,000</td>\n<td>86.96</td>\n<td>83.33</td>\n<td>80</td>\n</tr>\n</tbody>\n</table>",
 "questions": [
  {
   "id": 545233,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When the divisor increases from 11,500 to 12,000, how many representatives are lost by each state based on the upper quota?\n\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>&nbsp;</th>\n<th>Modified Quota<br>(Divisor: 11,500)</th>\n<th>Upper Quota</th>\n<th>Modified Quota<br>(Divisor: 12,000)</th>\n<th>Upper Quota</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>A</td>\n<td>0.87</td>\n<td>1</td>\n<td>0.83</td>\n<td>1</td>\n</tr>\n<tr>\n<td>B</td>\n<td>8.7</td>\n<td>9</td>\n<td>8.33</td>\n<td>9</td>\n</tr>\n<tr>\n<td>C</td>\n<td>86.96</td>\n<td>87</td>\n<td>83.33</td>\n<td>84</td>\n</tr>\n</tbody>\n</table>\n<p>States A and B had no change.</p>\n<p>State C lost 3.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "State A loses 0, seats State B loses 0, and State C loses 3."
    }
   ],
   "community_solutions": []
