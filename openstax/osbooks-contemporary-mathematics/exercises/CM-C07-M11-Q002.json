 "questions": [
  {
   "id": 516204,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Interpret the expected value of the number showing when you roll a special 6-sided die with faces {1, 1, 2, 3, 5, 8}.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "From the previous exercise, you know the expected value is <span data-math=\"\\frac{{10}}{3}\"></span>, which is approximately 3.33. If you roll the die repeatedly, you expect the mean of the numbers showing would be around 3.33."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "If you roll the special die many times, the mean of the numbers showing will be around 3.33."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 516205,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Interpret the expected value of the number of heads showing if you flip a coin 3 times.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "From the previous exercise, you know the expected value is <span data-math=\"\\frac{3}{2}\"></span>, or 1.5. If you repeatedly flip a coin three times, you can expect the average number of heads to be 1.5 heads."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "If you repeat the coin-flipping experiment many times, the mean of the number of heads you get will be around 1.5."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 516206,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You are about to play a game where you flip a coin 3 times. If all 3 flips result in heads, you win $20. If you get 2 heads, you win $10. If you flip 1 or 0 heads, you win nothing. Interpret the expected value of your winnings.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
