   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Convert <span data-math=\"\\frac{{47}}{{12}}\">\\frac{{47}}{{12}}</span> into a mixed number.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"47 \\div 12\"></span> is 3 with a remainder. What is that remainder?</p>\n<p><span data-math=\"12 \\times 3 = 36\"></span></p>\n<p><span data-math=\"47-36 = 11\"></span></p>\n<p>The remainder is 11.</p>\n<p>So, <span data-math=\"\\frac{{47}}{{36}}\"></span> as a mixed number is <span data-math=\"3\\frac{{11}}{{12}}\"></span>.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"3\\frac{{11}}{{12}}\">3\\frac{{11}}{{12}}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
