     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"\\frac{{wolves}}{{rabbits}} = \\frac{3}{5}\"></span></p>\n<p><span data-math=\"\\frac{{rabbits}}{{wolves + rabbits}} = \\frac{5}{{3 + 5}} = \\frac{5}{8}\"></span></p>"
