   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the ratio of wolves to rabbits in a national park is <span data-math=\"3{:}5\">3{:}5</span>, then the ratio of rabbits to (wolves and rabbits) is <span data-math=\"5{:}8\">5{:}8</span>.",
   "answers": [
    {
     "id": 996518,
     "content_html": "True",
     "correctness": "1.0"
    },
