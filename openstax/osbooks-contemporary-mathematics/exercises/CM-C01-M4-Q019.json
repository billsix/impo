   "id": 494737,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If set <span data-math=\"A\">A</span> and set <span data-math=\"B\">B</span> are disjoint sets, then <span data-math=\"A\">A</span> intersection <span data-math=\"B\">B</span> is the ___________ set.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Disjoint sets have no elements in common. The intersection of two sets includes the elements they have in common. Because set <i>A</i> and set <i>B</i> are disjoint, their intersection is the empty set."
    },
