     "solution_type": "summary",
     "content_html": "<p>A factorial for any positive whole number <i>n</i> (denoted <i>n</i>!) is the product of every whole number less than or equal to <i>n</i>. We define 0! to be equal to one.</p>\n<p><span data-math=\"6!{\\text{ }} = {\\text{ }}6{\\text{ }} \\times {\\text{ }}5{\\text{ }} \\times {\\text{ }}4{\\text{ }} \\times {\\text{ }}3{\\text{ }} \\times {\\text{ }}2{\\text{ }} \\times {\\text{ }}1{\\text{ }} = {\\text{ }}720\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "720"
    }
   ],
   "community_solutions": []
