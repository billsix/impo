 "questions": [
  {
   "id": 531530,
   "is_answer_order_important": false,
   "stimulus_html": "Refer again to the frequency distribution of the number of people who shared a residence with people in a sample:\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>Number of People in the Residence</th>\n<th>Frequency</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>12</td>\n</tr>\n<tr>\n<td>2</td>\n<td>13</td>\n</tr>\n<tr>\n<td>3</td>\n<td>8</td>\n</tr>\n</tbody>\n</table>",
   "stem_html": "What’s the mean of the number of people in these residences?\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>You can use the table to help do your math.</p>\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>Number of People in Residence</th>\n<th>Frequency</th>\n<th>People Times Frequency</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>12</td>\n<td>12</td>\n</tr>\n<tr>\n<td>2</td>\n<td>13</td>\n<td>26</td>\n</tr>\n<tr>\n<td>3</td>\n<td>8</td>\n<td>24</td>\n</tr>\n<tr>\n<td>SUMS:</td>\n<td>33</td>\n<td>62</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>Mean<br>\n(Divide Sums)</td>\n<td>62 ÷ 33 ≈ 1.879</td>\n</tr>\n</tbody>\n</table>\n<p>The mean is approximately 1.879.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\frac{{62}}{{33}} = 1.879\">\\frac{{62}}{{33}} = 1.879</span>"
    }
   ],
   "community_solutions": []
  }
