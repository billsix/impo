 "questions": [
  {
   "id": 544587,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the results of the 2018 U.S. Senate primary for Maryland. Determine which candidate won the primary for the Republicans (R). Did the candidate win a majority or a plurality of Republican votes?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "When no candidate has a majority of the votes, the one with the most votes is said to have a plurality. In the Maryland race, the candidate with the most votes (Tony Campbell) only secured 29.22 percent of the votes. To win by a majority of votes is winning by more than 50 percent. Tony Campbell only won by a plurality."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Tony Cambell won a plurality of votes in the Republican primary."
    }
   ],
   "community_solutions": []
  }
 ],
