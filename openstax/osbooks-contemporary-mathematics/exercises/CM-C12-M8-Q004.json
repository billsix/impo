 "stimulus_html": "Use Figure 12.185 to determine if the given sequence of vertices is a Hamilton path, an Euler trail, both, or neither.",
 "questions": [
  {
   "id": 544525,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Graph <i>A</i>, <i>a</i> → <i>b</i> → <i>e</i> → <i>d</i> → <i>c</i>",
   "answers": [],
