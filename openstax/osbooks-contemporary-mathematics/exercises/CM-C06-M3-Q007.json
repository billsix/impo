 "questions": [
  {
   "id": 518474,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A simple interest loan for $50,000 is taken out at 5.15% annual percentage rate. A partial payment is made 120 days into the loan period. How much of the partial payment will be for interest?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"I = P \\times r \\times t = 50,000 \\times 0.0515 \\times \\frac{{120}}{{365}} \\approx \\$ 846.58\"></span></td>\n<td>(rounded to the nearest cent)</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$846.58"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 518475,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A simple interest loan for $8,500 is taken out at 9.9% annual interest rate. A partial payment is to be made after 75 days. How much of the partial payment will be for interest?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"I = P \\times r \\times t = 8,500 \\times 0.099 \\times \\frac{{75}}{{365}} \\approx \\$ 172.91\"></span></td>\n<td>(rounded to the nearest cent)</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$172.91"
    }
   ],
   "community_solutions": []
  }
 ],
