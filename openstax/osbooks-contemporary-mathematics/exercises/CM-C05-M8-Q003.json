 "questions": [
  {
   "id": 511121,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the slope of the line shown in the graph.\n<figure>\n<img src=\"exercises/media/d9d1227f14665df6.jpg\" alt=\"A line is plotted on an x y coordinate plane. The x-axis ranges from negative 4 to 4, in increments of 1. The y-axis ranges from negative 6 to 1, in increments of 1. The line passes through the following points, (negative 1.5, 0), (0, negative 2), and (3, negative 6). Note: all values are approximate.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Locate two points on the graph whose coordinates are integers. This solution uses (0, –2) and (3, –6).</p>\n<p>Sketch a right triangle on the graph to help you count the rise over run.</p>\n<p>Start at (0, –2).</p>\n<p>Count the rise. Since the rise goes down, it is negative. The rise is –4.</p>\n<p>Count the run. The run goes to the right, so it is positive. The run is 3.</p>\n<p>Use the slope formula. <span data-math=\"m = \\frac{{rise}}{{run}} = \\frac{{ - 4}}{3} = - \\frac{4}{3}\"></span></p>\n<p>The slope of the line is <span data-math=\" - \\frac{4}{3}\"></span>.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"m = \\frac{{ - 4}}{3}\">m = \\frac{{ - 4}}{3}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
