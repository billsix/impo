 "questions": [
  {
   "id": 517199,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Daryl decides to buy a new scooter in St. Louis, Missouri, where the sales tax is 9.68%. The scooter he chooses has a purchase price of $1,149. How much will Daryl pay in sales tax and what is the total price he spends on the scooter?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>sales tax = purchase price × tax rate</p>\n<p>sales tax = 1,149 × 0.0968</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>sales tax = $111.22</td>\n<td>(rounded to the nearest cent)</td>\n</tr>\n</tbody>\n</table>\n<p>total price = purchase price + sales tax = 1,149 + 111.22 = $1,260.22</p>\n<p>Daryl’s sales tax is $111.22. The total price is $1,260.22.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sales tax is $111.22. The total price Daryl pays is $1,260.22."
    }
   ],
   "community_solutions": []
  }
 ],
