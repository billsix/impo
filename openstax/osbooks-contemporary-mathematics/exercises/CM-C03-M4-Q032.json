 "questions": [
  {
   "id": 505879,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A  small town has 450 registered voters. In the primaries, 54 voted. What percentage of registered voters in that town voted in the primaries?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"n\"></span> percent, denoted <span data-math=\"n\\% \"></span>, is the fraction <span data-math=\"\\frac{n}{{100}}.\"></span></p>\n<p>54 is what percentage of 450?</p>\n<p>Rewrite “is” as equals and “percentage of” as <span data-math=\"\\frac{n}{{100}} \\times 500.\"></span></p>\n<p><span data-math=\"54 = \\frac{n}{{100}} \\times 450\"></span></p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"54 = 4.5n\"></span></td>\n<td>Divide by 4.5.</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"12 = n\"></span></p>\n<p>The answer is 12% of registered voters voted in the primaries.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "12% of registered voters in the small town voted in the primaries."
    }
   ],
   "community_solutions": []
  }
 ],
