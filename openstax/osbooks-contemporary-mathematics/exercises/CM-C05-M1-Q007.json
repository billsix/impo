     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"{x^2} - 6x + 3 = {3^2} - 6\\left( 3 \\right) + 3\"></span></td>\n<td>Substitute.</td>\n</tr>\n<tr>\n<td><span data-math=\"9 - 18 + 3\"></span></td>\n<td>Simplify.</td>\n</tr>\n</tbody>\n</table>\n<p>–6</p>"
