 "questions": [
  {
   "id": 518869,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An installment loan is paid monthly. The remaining principal is $5,498. If the interest rate is 12.9%, how much interest is paid that month?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The amount of interest, <i>I</i>, to be paid for one period of a loan with remaining principal, <i>P</i>, is <span data-math=\"I = P \\times r \\times t\"></span>, where <i>r</i> is the interest rate in decimal form, <i>n</i> is the number of payments in a year, and <i>t</i> is the time in years.</p>\n<p><span data-math=\"I = \\left( {5,498} \\right)\\left( {0.129} \\right)\\left( {\\frac{1}{{12}}} \\right) \\approx \\$59.11\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$59.11"
    }
   ],
   "community_solutions": []
  }
 ],
