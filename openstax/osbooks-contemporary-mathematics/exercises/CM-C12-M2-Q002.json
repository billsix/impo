 "is_vocab": false,
 "stimulus_html": "Suppose that the sum of the degrees of a graph is six.",
 "questions": [
  {
   "id": 544645,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the number of edges.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The number of edges is half the number of the sum of degrees. If the sum of degrees is 6, then there are 3 edges.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "3"
    }
   ],
   "community_solutions": []
  },
