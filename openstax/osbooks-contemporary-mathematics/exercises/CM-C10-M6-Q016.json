 "questions": [
  {
   "id": 532568,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the area of the triangle with base equal to 3 cm and height equal to 5 cm.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The area of a triangle is <span data-math=\"A = \\frac{1}{2}bh\"></span>, where <i>b</i> represents the base and <i>h</i> represents the height.</p>\n<p><span data-math=\"A = \\frac{1}{2}bh = \\frac{1}{2}\\left( {{\\text{3 cm}}} \\right)\\left( {{\\text{5 cm}}} \\right) = {\\text{ 7}}{\\text{.5 c}}{{\\text{m}}^2}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "7.5 cm<sup>2</sup>"
    }
   ],
   "community_solutions": []
  }
 ],
