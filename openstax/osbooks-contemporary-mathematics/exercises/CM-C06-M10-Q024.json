 "is_vocab": false,
 "stimulus_html": "Compute the interest charged for the credit card based on the given average daily balance (ABD), annual interest rate, and number of days in the billing cycle.",
 "questions": [
  {
   "id": 519253,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "ADB = $2,135.00, annual interest rate 12.9%, billing cycle of 30 days",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The interest charge, <i>I</i>, for a credit card during a billing cycle is <span data-math=\"I = \\frac{{{\\rm{ADB}} \\times r \\times d}}{{365}}\"></span>, where ADB is the average daily balance, <i>r</i> is the annual percentage rate as a decimal, and <i>d</i> is the number of days in the billing cycle. As before, interest is rounded up to the next penny.</p>\n<p><span data-math=\"I = \\frac{{\\left( {2,135} \\right)\\left( {0.129} \\right)\\left( {30} \\right)}}{{365}} = \\$22.64\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$22.64"
    }
   ],
   "community_solutions": []
  },
