 "questions": [
  {
   "id": 533555,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the measures of each angle in the triangle shown.\n<figure>\n<img src=\"exercises/media/3b37befdf8eff344.png\" alt=\"A triangle with its angles marked x degrees, (x plus 1) degrees, and (x minus 19) degrees.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"m\\measuredangle x = {66^ \\circ }\">m\\measuredangle x = {66^ \\circ }</span>, <span data-math=\"m\\measuredangle (x + 1) = {67^ \\circ }\">m\\measuredangle (x + 1) = {67^ \\circ }</span>, <span data-math=\"m\\measuredangle (x - 19) = {47^ \\circ }\">m\\measuredangle (x - 19) = {47^ \\circ }</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The sum of the angle measures of a triangle must be 180°.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"x - 19 + x + 1 + x = 180\"></span></td>\n<td>Combine like terms.</td>\n</tr>\n<tr>\n<td><span data-math=\"3x - 18 = 180\"></span></td>\n<td>Subtract.</td>\n</tr>\n<tr>\n<td><span data-math=\"3x = 198\"></span></td>\n<td>Divide.</td>\n</tr>\n<tr>\n<td><span data-math=\"x = 66\"></span></td>\n<td>Evaluate the expressions for the angles.</td>\n</tr>\n<tr>\n<td><span data-math=\"x - 19 = 66 - 19 = 47\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"x + 1 = 66 + 1 = 67\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"x = 66\"></span></td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>The angles measure 47°, 67°, and 66°.</p>"
    }
   ],
   "community_solutions": []
  }
 ],
