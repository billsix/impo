 "questions": [
  {
   "id": 511215,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The number of unread emails in Bryan’s account is 100. This number grows by 15 unread emails a day. The function <span data-math=\"N\\left( t \\right) = 100 + 15t\">N\\left( t \\right) = 100 + 15t</span> represents the relation between the number of emails, <span data-math=\"N\">N</span>, and the time, <span data-math=\"t\">t</span>, measured in days. Find <span data-math=\"N\">N</span>(7). Explain what the result means.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"N\\left( t \\right) = 100 + 15t\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"N\\left( 5 \\right) = 100 + 15\\left( 7 \\right)\"></span></td>\n<td>Substitute 7 for <i>t</i>.</td>\n</tr>\n<tr>\n<td><span data-math=\"N\\left( 5 \\right) = 100 + 105\"></span></td>\n<td>Simplify.</td>\n</tr>\n<tr>\n<td><span data-math=\"N\\left( 5 \\right) = 205\"></span></td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>Bryan had 205 unread emails after seven days.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "There 205 unread emails after 7 days."
    }
   ],
   "community_solutions": []
  }
 ],
