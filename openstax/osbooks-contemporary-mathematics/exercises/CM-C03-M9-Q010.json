   "id": 505792,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"(2.29 \\times {10^3}) \\times (3 \\times {10^4})\">(2.29 \\times {10^3}) \\times (3 \\times {10^4})</span>",
   "answers": [],
