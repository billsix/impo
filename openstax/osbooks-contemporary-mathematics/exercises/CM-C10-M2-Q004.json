 "questions": [
  {
   "id": 532818,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the two intersecting lines in the figure shown and <span data-math=\"m\\measuredangle 2 = {67^ \\circ },\">m\\measuredangle 2 = {67^ \\circ },</span> find the measure of the remaining angles.\n<figure>\n<img src=\"exercises/media/86f4290349293bbb.png\" alt=\"Two lines intersect each other. One set of opposite angles is labeled 1 and 3. The other set of opposite angles is labeled 4 and 67 degrees.\">\n</figure>\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Vertical angles have equal measures. The measure of angle 4 is 67°.</p>\n<p>Angles 3 and 4 are supplementary, so sum of the measures is180°.</p>\n<p>The measure of angle 3 = 180° – 67° = 113°</p>\n<p>Since vertical angles have equal measures, angles 3 and 1 have the same measure.</p>\n<p>m∡3 = m∡1 = 113°</p>\n<p>m∡4 = 67°</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"m\\measuredangle 4 = {67^ \\circ }\">m\\measuredangle 4 = {67^ \\circ }</span>, <span data-math=\"m\\measuredangle 1 = {113^ \\circ }\">m\\measuredangle 1 = {113^ \\circ }</span>, <span data-math=\"m\\measuredangle 3 = {113^ \\circ }\">m\\measuredangle 3 = {113^ \\circ }</span>"
    }
   ],
