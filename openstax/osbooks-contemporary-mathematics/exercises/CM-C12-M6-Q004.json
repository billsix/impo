 "questions": [
  {
   "id": 543855,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find an Euler circuit or trail through the graph using Fleury’s algorithm.\n<figure>\n<figcaption>Graph <i>T</i></figcaption>\n<img src=\"exercises/media/1276e7163a118231.png\" alt=\"Graph T has six vertices.The vertices are u, z, x, v, y, and w. The edges connect u x, x w, u w, w v, w y, u x, and z y.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: If there are two odd vertices, begin at one odd vertex and end at the other.</p>\n<p>Vertices <i>u</i> and <i>v</i> are odd, so you must begin at one and end at the other. It doesn’t matter which you choose as the beginning as which you choose as the end.</p>\n<p>Step 2: Remove an edge between the vertex and any adjacent vertex that is not a bridge, unless there is no other choice, making a note of the edge you removed. Repeat this step until all the edges are removed.</p>\n<p>Step 3: Write out the Euler trail using the sequence of vertices and edges you found.</p>\n<p><i>v → w → x → u → z → y → w → u</i></p>\n<p>Other variations are possible.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The graph has Euler trails. They must begin and end at vertices <i>u</i> and <i>v</i>. An example is<br>\n<i>v</i> → <i>w</i> → <i>x</i> → <i>u</i> → <i>z</i> → <i>y</i> → <i>w</i> → <i>u</i>"
    }
   ],
   "community_solutions": []
  }
 ],
