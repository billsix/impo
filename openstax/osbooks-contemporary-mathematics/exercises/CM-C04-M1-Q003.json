   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"6 \\times {10^2} + 2 \\times {10^1} + 1 \\times {10^0}\">6 \\times {10^2} + 2 \\times {10^1} + 1 \\times {10^0}</span>",
   "answers": [],
