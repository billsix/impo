   "id": 507152,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Christian is owed $180 from his friend Chanel, but owes his friend Jeff $91. What is Christian’s net worth?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$89"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Chanel owes Chrisian money, so represent $180 as a positive number. Christian owes Jeff money, so subtract 91 from 180.</p>\n<p><span data-math=\"{\\rm{180 }} - 91 = 89\"></span></p>\n<p>Christian’s net worth is $89.</p>"
    }
   ],
