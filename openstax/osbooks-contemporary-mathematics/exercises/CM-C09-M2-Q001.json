 "questions": [
  {
   "id": 526531,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which unit of measure is most reasonable to describe the area of a forest: km<sup>2</sup>, cm<sup>2</sup>, or mm<sup>2</sup>?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Both a centimeter and a millimeter are less than an inch, so square centimeters and square millimeters are not practical for measuring forests. Your best choice is the square kilometer."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "km<sup>2</sup>"
    }
   ],
   "community_solutions": []
  }
 ],
