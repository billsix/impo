 "questions": [
  {
   "id": 545442,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A patient is prescribed 1.4 mg/kg of a drug to be delivered intramuscularly, divided into 2 doses per day. If the patient weighs 60 kg, how many milliliters of the drug should be given per dose?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Find the total amount of medicine needed per day.</p>\n<p><span data-math=\"60{\\rm{ }}\\cancel{{{\\rm{kg}}}}\\left( {\\frac{{1.4{\\rm{\\ mg}}}}{{1\\cancel{{{\\rm{kg}}}}}}} \\right) = 84{\\rm{\\ mg\\ of\\ medicine}}\"></span></p>\n<p>Divide this amount into 2 doses.</p>\n<p><span data-math=\"\\frac{{84{\\rm{\\ mg}}}}{2} = 42{\\rm{\\ mg}}\"></span></p>\n<p>The patient needs 42 mg per dose.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "42 mg"
    }
   ],
   "community_solutions": []
  }
 ],
