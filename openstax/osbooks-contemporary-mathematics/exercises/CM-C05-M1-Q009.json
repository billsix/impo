   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Subtract <span data-math=\"\\left( {{x^2} - 4x + 8} \\right) - \\left( {{x^2} + 5x + 12} \\right)\">\\left( {{x^2} - 4x + 8} \\right) - \\left( {{x^2} + 5x + 12} \\right)</span>.",
