 "questions": [
  {
   "id": 219706,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the same group of volleyball players from above: {Angie, Brenda, Colleen, Estella, Maya, Maria, Penny, Shantelle}. The team needs to select a captain and an assistant captain from their members. List two possible equivalent subsets that they could select.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<p>There are multiple possible solutions. Each set must contain two players, but both players cannot be the same, otherwise the two sets would be equal, not equivalent. For example, {Maria, Shantelle} and {Angie, Maria}.</p>"
    }
   ],
   "community_solutions": []
  }
