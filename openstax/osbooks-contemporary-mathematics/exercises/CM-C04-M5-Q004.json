     "solution_type": "summary",
     "content_html": "<p>First step: You can use the base 12 multiplication table created as an example.</p>\n<p>3 × 7 = 19</p>\n<p>B × 7 = 65</p>\n<p>3 × 4 = 10</p>\n<p>B × 4 = 38</p>\n<p>Remember to pad the entries by the appropriate number of zeros.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>B</td>\n<td>3</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>×</td>\n<td>4</td>\n<td>7</td>\n</tr>\n<tr>\n<td>Carry:</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>9</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>6</td>\n<td>5</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>3</td>\n<td>8</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>Product:</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>9</td>\n</tr>\n</tbody>\n</table>\n<p>Next step: In the rightmost column:</p>\n<p>In base 10: 9 + 0 + 0 + 0 = 9</p>\n<p>In base 12: 9</p>\n<p>Write 9 in the rightmost column.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>B</td>\n<td>3</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>×</td>\n<td>4</td>\n<td>7</td>\n</tr>\n<tr>\n<td>Carry:</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>9</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>6</td>\n<td>5</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>3</td>\n<td>8</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>Product:</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>9</td>\n</tr>\n</tbody>\n</table>\n<p>Next step: In the next column over:</p>\n<p>In base 10: 1 + 5 + 0 + 0 = 6</p>\n<p>In base 12: 6</p>\n<p>Write 6 in this column.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>B</td>\n<td>3</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>×</td>\n<td>4</td>\n<td>7</td>\n</tr>\n<tr>\n<td>Carry:</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>9</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>6</td>\n<td>5</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>3</td>\n<td>8</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>Product:</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>6</td>\n<td>9</td>\n</tr>\n</tbody>\n</table>\n<p>Next step: In the next column:</p>\n<p>In base 10: 6 + 1 + 8 = 15 = 12 + 3</p>\n<p>In base 12: 3</p>\n<p>Carry: 1</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>B</td>\n<td>3</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>×</td>\n<td>4</td>\n<td>7</td>\n</tr>\n<tr>\n<td>Carry:</td>\n<td>1</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>9</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>6</td>\n<td>5</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>3</td>\n<td>8</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>Product:</td>\n<td>&nbsp;</td>\n<td>3</td>\n<td>6</td>\n<td>9</td>\n</tr>\n</tbody>\n</table>\n<p>Next step: In the next column:</p>\n<p>In base 10: 1 + 3 = 4</p>\n<p>In base 12: 4</p>\n<p>Carry: No need</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>B</td>\n<td>3</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>×</td>\n<td>4</td>\n<td>7</td>\n</tr>\n<tr>\n<td>Carry:</td>\n<td>1</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>9</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>6</td>\n<td>5</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>1</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>3</td>\n<td>8</td>\n<td>0</td>\n<td>0</td>\n</tr>\n<tr>\n<td>Product:</td>\n<td>4</td>\n<td>3</td>\n<td>6</td>\n<td>9</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"{4369_{12}}\"></span></p>"
