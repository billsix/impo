     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use a number line marked with tick marks to represent every integer.</p>\n<p>4: Place a solid dot four tick marks to the right of zero.</p>\n<p>–2: Place a solid dot two tick marks to the left of zero.</p>\n<p>7: Place a solid dot seven tick marks to the right of zero.</p>"
    },
    {
     "images": [],
