 "questions": [
  {
   "id": 529099,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The file <a href=\"https://openstax.org/r/Chapter8_Data-Sets\" rel=\"nofollow\" target=\"_blank\">“InState”</a> contains in-state tuition costs (in dollars) for every institution of higher learning in the US for which data is available. What is the range of these costs?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Open a copy of the database in Google Sheets. You cannot edit the original.</p>\n<p>Look for the InState tab.</p>\n<p>In an empty cell, enter “=MAX(“ and then click on the letter at the top of the Tuition column.</p>\n<p>You should see $74,514.</p>\n<p>In another cell, repeat the process but with “=MIN(“ to find the minimum.</p>\n<p>You should see $480.</p>\n<p>The range is the difference between the two, $74,034.</p>\n<p>Note: It is a good idea to write labels besides the cells to help you remember what numbers are in which cells.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\$ 74,514 - \\$ 480 = \\$ 74,034\">\\$ 74,514 - \\$ 480 = \\$ 74,034</span>"
    }
   ],
   "community_solutions": []
  }
 ],
