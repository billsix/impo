 "is_vocab": false,
 "stimulus_html": "A kindergarten class votes on their favorite colors using a ranked ballot. Use the results in the following table to answer the questions.\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th><b>Number of Ballots</b></th>\n<th><b>4</b></th>\n<th><b>6</b></th>\n<th><b>4</b></th>\n<th><b>7</b></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Red</td>\n<td>2</td>\n<td>6</td>\n<td>2</td>\n<td>5</td>\n</tr>\n<tr>\n<td>Blue</td>\n<td>1</td>\n<td>2</td>\n<td>1</td>\n<td>4</td>\n</tr>\n<tr>\n<td>Green</td>\n<td>6</td>\n<td>5</td>\n<td>5</td>\n<td>2</td>\n</tr>\n<tr>\n<td>Yellow</td>\n<td>5</td>\n<td>4</td>\n<td>6</td>\n<td>3</td>\n</tr>\n<tr>\n<td>Purple</td>\n<td>4</td>\n<td>3</td>\n<td>4</td>\n<td>1</td>\n</tr>\n<tr>\n<td>Pink</td>\n<td>3</td>\n<td>1</td>\n<td>3</td>\n<td>6</td>\n</tr>\n</tbody>\n</table>",
 "questions": [
  {
   "id": 544597,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many students voted in total?\n\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The numbers in the top row tell you the number of ballots.</p>\n<p>4 + 6 + 4 + 7 = 21</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"4 + 6 + 4 + 7 = 21\">4 + 6 + 4 + 7 = 21</span>"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544598,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many students voted for yellow as their favorite color?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Look at the Yellow row. There are no 1s in the Yellow row. A 1 would indicate that someone chose yellow as their favorite color, so the answer is “none.”"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "None"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544599,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many students in the class indicated that blue was their favorite color while green was their least favorite color?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "There are six colors. The rank of 1 indicates a favorite color. The rank of 6 indicates a least favorite color. Look at the Blue row and the Green row. There is only one column where there is a 1 in the Blue row (indicating a favorite color) and a 6 in the Green row (indicating a least favorite color). The number at the top of that column is 4. That means that there are four ballots with those choices."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "4"
    }
   ],
   "community_solutions": []
  }
 ],
