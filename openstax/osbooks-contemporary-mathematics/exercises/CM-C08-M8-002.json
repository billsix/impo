 "questions": [
  {
   "id": 528749,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Create a scatter plot to visualize the following data, showing the top five NFL receivers by number of receptions for the 2019 season. Treat <i>Yards</i> as the response:<br>\n<table><caption>(source: https://www.pro-football-reference.com/years/2019/)</caption>\n<thead>\n<tr>\n<th>Player</th>\n<th>Receptions</th>\n<th>Yards</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Stefon Diggs</td>\n<td>127</td>\n<td>1535</td>\n</tr>\n<tr>\n<td>Davante Adams</td>\n<td>115</td>\n<td>1374</td>\n</tr>\n<tr>\n<td>DeAndre Hopkins</td>\n<td>115</td>\n<td>1407</td>\n</tr>\n<tr>\n<td>Darren Waller</td>\n<td>107</td>\n<td>1196</td>\n</tr>\n<tr>\n<td>Travis Kelce</td>\n<td>105</td>\n<td>1416</td>\n</tr>\n</tbody>\n</table>\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A scatter plot is a visualization of the relationship between two sets of data. You turn the dataset into ordered pairs. The first coordinate is from the explanatory dataset and the second coordinate contains the corresponding value from the response dataset. Plot these points in the <i>xy</i>-plane.</p>\n<p>Use the receptions as the <i>x</i>-coordinates and the yards as the <i>y</i>-coordinates.</p>\n<p>(127, 1535), (115, 1374), (115, 1407), (114, 1407), (105, 1416)</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<img src=\"https://exercises.openstax.org/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBBa3NHIiwiZXhwIjpudWxsLCJwdXIiOiJibG9iX2lkIn19--4204de8e99794d43d326b2cb1db762f3d4627747/CS_Figure_08_08_107.jpg\" alt=\"A scatter plot shows five points. The horizontal axis representing receptions ranges from 105 to 130, in increments of 5. The vertical axis representing yards ranges from 1100 to 1600, in increments of 100. The points are at the following coordinates: (105, 1420), (107, 1200), (115, 1380), (115, 1410), and (127, 1540). Note: all values are approximate.\">"
    }
   ],
   "community_solutions": []
  }
 ],
