 "questions": [
  {
   "id": 518471,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Mia deposits $4,900 in a CD bearing 3.95%. The CD term is 7 years. When she redeems the CD, how much will Mia receive?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"{\\rm Future\\ Value} = FV = P + I\"></span></p>\n<p><span data-math=\"I = P \\times r \\times t = 4,900 \\times 0.0395 \\times 7 = \\$ 1,354.85\"></span></p>\n<p><span data-math=\"FV = P + I = 4,900 + 1,354.85 = \\$6,254.85\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Mia will receive $6,254.85."
    }
   ],
   "community_solutions": []
  }
 ],
