   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Simplify  the irrational number <span data-math=\"\\sqrt {733}\">\\sqrt {733}</span>  and express in lowest terms. Identify the rational and irrational parts.",
   "answers": [],
