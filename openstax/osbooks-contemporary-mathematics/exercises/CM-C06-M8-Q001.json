 "is_vocab": false,
 "stimulus_html": "Find the interest to be paid for the period on loans with the following remaining principal and given annual interest rate. Each period is a month.",
 "questions": [
  {
   "id": 518838,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Remaining principal is $56,945, interest rate is 7.5%",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The amount of interest, <i>I</i>, to be paid for one period of a loan with remaining principal, <i>P</i>, is <span data-math=\"I = P \\times \\frac{r}{n}\"></span>, where <i>r</i> is the interest rate in decimal form and <i>n</i> is the number of payments in a year. Because <i>r</i> is the interest rate in a year, <i>t</i> is 1 and does not impact the calculation. Note, interest paid to lenders is always rounded up to the nearest penny.</p>\n<p><span data-math=\"I = 56,945 \\times \\frac{{0.075}}{{12}} = \\$355.91\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$355.91"
    }
   ],
   "community_solutions": []
  },
  {
