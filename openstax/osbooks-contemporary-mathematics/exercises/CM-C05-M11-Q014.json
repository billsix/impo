 "questions": [
  {
   "id": 511726,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Kellie makes tables and chairs. Kellie profits $20 from a table (<span data-math=\"t\">t</span>), and $10 from a chair (<span data-math=\"c\">c</span>). A table requires 15 board feet of wood, while a chair requires 4 board feet of wood. Kellie has 70 board feet available. What is the constraint inequality in this situation?\n",
   "answers": [
    {
     "id": 1000726,
     "content_html": "<span data-math=\"{20t + 10c \\leq 70}\">{20t + 10c \\leq 70}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000727,
     "content_html": "<span data-math=\"{ t + c \\leq 70}\">{ t + c \\leq 70}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000728,
     "content_html": "<span data-math=\"{ 15t + 4c \\geq 70}\">{ 15t + 4c \\geq 70}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000729,
     "content_html": "<span data-math=\"{ 15t + 4c \\leq 70}\">{ 15t + 4c \\leq 70}</span>",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Let <i>t</i> = the number of tables sold.</p>\n<p>Let <i>c</i> = the number of chairs sold.</p>\n<p>Let <i>P</i> = the profit.</p>\n<p>The profit on a table is $20 and the profit on a chair is $10.</p>\n<p>A table requires 15 board feet of wood.</p>\n<p>A chair requires 4 board feet of wood.</p>\n<p>Kellie has 70 board feet available.</p>\n<p>Constraint:</p>\n<p>Break the words into components.</p> \n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>15 board feet times the number of tables</td>\n<td>plus</td>\n<td>4 board feet times the number of chairs</td>\n<td>must be no more than</td>\n<td>70 board feet</td>\n</tr>\n<tr>\n<td>15<i>t</i></td>\n<td>+</td>\n<td>4<i>c</i></td>\n<td>≤</td>\n<td>70</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"15t + 4c \\le 70\"></span></p>\n"
    }
   ],
   "community_solutions": []
  }
 ],
