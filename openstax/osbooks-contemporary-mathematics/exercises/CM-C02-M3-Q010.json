   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A truth table for two statements has four rows of truth values.</p>\n<p>The general rule is that for <i>n</i> statements there are <span data-math=\"{2^n}\"></span> rows in the truth table.</p>\n<p><span data-math=\"{2^2}=4\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<p>four</p>"
    }
   ],
   "community_solutions": []
  }
 ],
