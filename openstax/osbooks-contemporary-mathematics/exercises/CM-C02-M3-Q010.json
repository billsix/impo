   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The truth table for the conjunction, <span data-math=\"p \\wedge q\">p \\wedge q</span>, has _____ rows of truth values.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
