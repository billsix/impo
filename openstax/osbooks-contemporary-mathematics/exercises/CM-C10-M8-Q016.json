 "questions": [
  {
   "id": 532958,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The sun casts a shadow over the roof of a house that ends 105 ft from the front door as shown in the figure. How high is the house to the tip of the roof?<br>\n\n<img src=\"exercises/media/9b6d35bd0810d167.png\" alt=\"An illustration shows a right triangle. The vertical leg represents the height of a house. The sun is above the house. The horizontal leg measures 105 feet. The angle formed by the hypotenuse and the horizontal leg measures 13 degrees.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The tangent of an angle is the opposite divided by the adjacent side: <span data-math=\"\\tan \\alpha = \\frac{{{\\text{opp}}}}{{{\\text{adj}}}}\"></span>.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"\\tan 13^\\circ = \\frac{y}{{105}}\"></span></td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><span data-math=\"y = 105\\tan 13^\\circ \"></span></td>\n<td>Remember to use the inverse function and parentheses.</td>\n</tr>\n<tr>\n<td><span data-math=\"y \\approx 24.2{\\text{ ft}}\"></span></td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p>The height to the tip of the roof is approximately 24.2 feet.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "24.2 ft"
    }
   ],
   "community_solutions": []
  }
 ],
