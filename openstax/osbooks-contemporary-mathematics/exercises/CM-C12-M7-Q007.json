  {
   "id": 544442,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The total weight of a trail _______ the sum of the weights of the edges visited by the trail.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "To find the weight of a trail, add the weights of each edge visited along the way."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "is"
    }
   ],
