  {
   "id": 544443,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A weighted graph _______ always a complete graph.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A weighted graph can be any kind of graph, complete or not complete. A weighted graph just means that numbers are assigned to each edge, usually associated with a real-world application."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "is not"
