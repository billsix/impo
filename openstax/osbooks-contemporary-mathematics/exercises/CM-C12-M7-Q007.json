 "stimulus_html": "For the following exercises, fill in the blank with <b>is</b> or <b>is not</b> to make the statement true.",
 "questions": [
  {
   "id": 544438,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A Hamilton cycle ________ a circuit.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A circuit is a trail that begins and ends at the same vertex. A trail does not repeat an edge. A Hamilton cycle is a circuit because it begins and ends on the same vertex and does not repeat an edge."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "is"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544439,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A Hamilton cycle that visits every edge ________ an Euler circuit.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "An Euler circuit visits every edge exactly once. A Hamilton cycle visits every vertex exactly once. A Hamilton cycle that visits every edge is also an Euler circuit. Some Hamilton cycles are Euler circuits, but not all. Some Euler circuits are Hamilton cycles, but not all."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "is"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544440,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A Hamilton cycle ________ different from a Hamilton circuit.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A cycle begins and ends at the same vertex. A circuit begins and ends at the same vertex but has no repeated edges. Since adding the name “Hamilton” means no repeated vertices, Hamilton cycles and Hamilton circuits are equivalent."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "is not"
    }
   ],
   "community_solutions": []
  },
