   "id": 532576,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the area of circle with a diameter of 16 in.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The area of a circle with radius <i>r</i> is <span data-math=\"A = \\pi {r^2}\"></span>.</p>\n<p>If the diameter is 16 inches, the radius is 8 inches.</p>\n<p><span data-math=\"A = \\pi {r^2} = \\pi {\\left( {8{\\text{ in}}} \\right)^2} = 64\\pi {\\text{ in}} \\approx 201.1{\\text{ i}}{{\\text{n}}^2}\"></span></p>\n<p>The area of the circle is approximately 201.1 square inches.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "201.1 in<sup>2</sup>"
    }
   ],
   "community_solutions": []
  }
 ],
