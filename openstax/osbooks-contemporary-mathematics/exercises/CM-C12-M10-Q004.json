 "is_vocab": false,
 "stimulus_html": "Use the given figure for the following exercises.\n<figure>\n<img src=\"exercises/media/090eff1694a78dab.png\" alt=\"Five graphs. Graph H has five vertices: n, q, r, s, and t. The edges are p q, p r, q r, q t, r t, r s, and s t. Graph N 1 has four vertices: p, q, s, and t. The edges are p t, q s, and s t. Graph N 2 has five vertices: p, q, r, s, and t. The edges are p r, q r, r s, r t, and s t. Graph N 3 has five vertices: p, q, r, s, and t. The edges are p q, q r, r s, and qt. Graph N 4 has five vertices: p, q, r, s, and t. The edges are p q, r s, and s t.\">\n</figure>",
 "questions": [
  {
   "id": 543344,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Since <i>sq</i> is not an edge in Graph <i>H</i>, Graph <i>N</i><sub>1</sub> cannot be a spanning tree of <i>H</i>.",
   "answers": [
    {
     "id": 1068667,
     "content_html": "True",
     "correctness": "1.0"
    },
    {
     "id": 1068668,
     "content_html": "False",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "To be a spanning tree of another graph, N<sub>1</sub> must be a subgraph of the Graph H. It cannot be a subgraph if the edge <i>sq</i> is not in Graph H."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "True"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 543345,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Graph <i>N</i><sub>2</sub> is a spanning tree of Graph <i>H</i>.",
   "answers": [
    {
     "id": 1068669,
     "content_html": "True",
     "correctness": "0.0"
    },
    {
     "id": 1068670,
     "content_html": "False",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A spanning tree cannot contain a cycle. This graph contains a triangular cycle (<i>r, s, t</i>)."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "False"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 543346,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Graph <i>N</i><sub>3</sub> is a spanning tree of Graph <i>H</i>.",
   "answers": [
    {
     "id": 1068671,
     "content_html": "True",
     "correctness": "1.0"
    },
    {
     "id": 1068672,
     "content_html": "False",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "All the vertices are included, the graph is connected, and there are no cycles. Also, no vertices are adjacent that were not adjacent in Graph H."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "True"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 543347,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Since there is no path between <i>p</i> and <i>t</i> in Graph <i>N</i><sub>4</sub>, it cannot be a spanning tree of any graph.",
   "answers": [
    {
