   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Name the tessellation in the figure shown.<br>\n\n<img src=\"exercises/media/4d4493f39236ca0e.png\" alt=\"A hexagon is made of six triangles. 3 triangles are shaded dark and 3 triangles are shaded light. A circle is drawn at the center of the hexagon where the triangles meet.\">\n",
   "answers": [],
   "hints": [],
