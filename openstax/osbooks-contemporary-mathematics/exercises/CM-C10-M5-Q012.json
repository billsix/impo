    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: Choose a vertex. This does NOT change while you are counting.</p>\n<p>Use the middle vertex that has a circle around it.</p>\n<p>Step 2: Count the number of sides in the shapes that touch the vertex. Separate your counts by periods. There are six shapes that touch the chosen vertex. They are all triangles with three sides.</p>\n<p>3.3.3.3.3.3</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "3.3.3.3.3.3"
    }
   ],
   "community_solutions": []
  }
