 "is_vocab": false,
 "stimulus_html": "Referring to the statement above, answer the following:",
 "questions": [
  {
   "id": 519245,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the statement period?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Look at the upper-right corner of the statement for the label “Statement Period.” Underneath the label, you will see the start date of the period after “From” and the end date of the period after “To.”</p>\n<p>From April 01, 2015</p>\n<p>To April 30, 2015</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "April 01 2015 to April 30 2015"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 519246,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the credit limit?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Almost halfway down in the left column is a bold label, “Your New Balance.” Just below that label is a smaller label, “Credit Limit.” Beside that label, you see $9000.00."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$9,000.00"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 519247,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How much in fees were charged?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Just above the “Your New Balance” label is the label “Subtotal.”</p>\n<p>Above the “Subtotal” label is the label “Fees.” The fees are $5.99.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$5.99"
    }
   ],
   "community_solutions": []
  }
 ],
