 "is_vocab": false,
 "stimulus_html": "Calculate the discount for the given original price and discount percentage. Then calculate the sale price.",
 "questions": [
  {
   "id": 516613,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Original price = $1,550.00; percent discount is 32%",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>discount = percent discount × original price</p>\n<p><span data-math=\"{\\rm{discount}} = 0.32 \\times 1,550 = \\$ 496.00\"></span></p>\n<p>sale price = original price – discount</p>\n<p>sale price = 1,550 – 496 = $1,054</p>\n<p>The discount is $496 and the sale price is $1,054.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Discount is $496; sale price is $1,054.00"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 516614,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Original price = $27.50; percent discount is 10%",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>discount = percent discount × original price</p>\n<p><span data-math=\"{\\rm{discount}} = 0.10 \\times 27.50 = \\$ 2.75\"></span></p>\n<p>sale price = original price – discount</p>\n<p>sale price = 27.50 – 2.75 = $24.75</p>\n<p>The discount is $2.75 and the sale price is $24.75.</p>"
    },
    {
