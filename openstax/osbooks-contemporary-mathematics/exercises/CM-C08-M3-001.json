 "questions": [
  {
   "id": 528783,
   "is_answer_order_important": false,
   "stimulus_html": "In Example 8.10, we constructed a stem-and-leaf plot for the number of times in one minute that different crickets chirped:\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td data-align=\"left\">8</td>\n<td data-align=\"left\">2 2 4 5 9 9 9</td>\n</tr>\n<tr>\n<td data-align=\"left\">9</td>\n<td data-align=\"left\">1 1 2 3 7 9</td>\n</tr>\n<tr>\n<td data-align=\"left\">10</td>\n<td data-align=\"left\">0 1 2 3 3 4 4 4 5 6 6 7 9 9</td>\n</tr>\n<tr>\n<td data-align=\"left\">11</td>\n<td data-align=\"left\">5 6</td>\n</tr>\n<tr>\n<td data-align=\"left\">12</td>\n<td data-align=\"left\">0</td>\n</tr>\n</tbody>\n</table>",
   "stem_html": "What is the mode of the number of chirps in a minute?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The mode is the number that occurs most often. There is a tie for there are two numbers that appear three times: 89 and 104. You can have more than one mode."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "There are two modes: 89 and 104, each of which appears three times."
    }
   ],
   "community_solutions": []
  }
 ],
