 "is_vocab": false,
 "stimulus_html": "<p>The student government bylaws of a particular college require that a new president is elected annually by plurality voting. In the event of a tie, the bylaws require the candidate(s) with the fewest votes to be removed from the ballot and a runoff election to be held with the remaining candidates. This process is repeated until a single candidate receives a plurality and wins the election. The results of two voting rounds are given in the table below.</p>\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>Candidate</th>\n<th>Votes in First Round</th>\n<th>Votes in Second Round</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Ferguson</td>\n<td>158</td>\n<td>168</td>\n</tr>\n<tr>\n<td>Garcia</td>\n<td>103</td>\n<td>104</td>\n</tr>\n<tr>\n<td>Hearn</td>\n<td>157</td>\n<td>180</td>\n</tr>\n<tr>\n<td>Isaac</td>\n<td>123</td>\n<td>123</td>\n</tr>\n<tr>\n<td>Jackman</td>\n<td>58</td>\n<td>Eliminated</td>\n</tr>\n<tr>\n<td>Kelly</td>\n<td>72</td>\n<td>74</td>\n</tr>\n<tr>\n<td>Lim</td>\n<td>158</td>\n<td>180</td>\n</tr>\n</tbody>\n</table>",
 "questions": [
  {
   "id": 544590,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which two candidates tied in the second round? Does this mean there will be a third election? ",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Hearn and Lim tied. Yes, there must be a third election."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544591,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If there was a winner, who won? If there should be a runoff, who must be removed from the ballot? ",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "There was no winner because there was a tie. Kelly must be removed because Kelly had the least number of votes and there will be a third election."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Kelly must be removed in the runoff."
    }
   ],
   "community_solutions": []
  }
 ],
