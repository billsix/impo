 "questions": [
  {
   "id": 542936,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose that you lost the combination to a combination lock that consisted of three digits, and each was selected from the digits 0, 1, 2, 3, 4, 5, 6, 7, 8, or 9. You desperately need to open the lock without breaking it. You decide to check all possible combinations methodically, 000, then 001, then 002, and so on until you find the right combination. Is this an example of a brute force algorithm or a greedy algorithm?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A brute force algorithm lists every possible solution and then compares them to find the best possible solution. This scenario is an example of the brute force algorithm.</p>\n<p>The greedy algorithm chooses the best choice at every branch of the path, continuing to make the best choice at each stage and finally linking those choices together into an overall solution. The greedy algorithm can miss the best choice, but sometimes does find it.</p>\n<p>Since you used the brute force algorithm, you are sure to find the best solution, but it does take a long time.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "brute force algorithm"
    }
   ],
   "community_solutions": []
  }
 ],
