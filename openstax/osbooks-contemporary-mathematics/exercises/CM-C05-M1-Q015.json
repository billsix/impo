 "questions": [
  {
   "id": 507653,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using the expression <span data-math=\"3{x^2} - 7x + 2\">3{x^2} - 7x + 2</span> , when a certain number is put in for <span data-math=\"x\">x</span>, the result is 50. What is the value of <span data-math=\"x\">x</span>?<br>\n<span data-math=\"- 2\">- 2</span>\n<br>\n<span data-math=\"- 3\">- 3</span>\n<br>\n<span data-math=\"2\">2</span>\n<br>\n<span data-math=\"3\">2</span>\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"3{x^2} - 7x + 2\"></span></td>\n<td>Try each of the given numbers to see which results in 50.</td>\n</tr>\n<tr>\n<td><span data-math=\"3{\\left( { - 2} \\right)^2} - 7\\left( { - 2} \\right) + 2\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"3\\left( 4 \\right) + 14 + 2 = 12 + 14 + 2 = 28\"></span></td>\n<td>That is not 50. Try again.</td>\n</tr>\n<tr>\n<td><span data-math=\"3{\\left( { - 3} \\right)^2} - 7\\left( { - 3} \\right) + 2\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"3\\left( 9 \\right) + 21 + 2 = 27 + 23 = 50\"></span></td>\n<td>This worked.</td>\n</tr>\n</tbody>\n</table>\n<p>The value of <i>x</i> that makes the result 50 is –3.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\" - 3\"> - 3</span>"
    }
   ],
   "community_solutions": []
  }
 ],
