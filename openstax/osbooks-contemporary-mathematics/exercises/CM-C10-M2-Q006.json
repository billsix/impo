 "questions": [
  {
   "id": 532824,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the given figure if <span data-math=\"m\\measuredangle 1 = {120^ \\circ }\">m\\measuredangle 1 = {120^ \\circ }</span>, find the <span data-math=\"m\\measuredangle 5\">m\\measuredangle 5</span>, <span data-math=\"m\\measuredangle 4\">m\\measuredangle 4</span>, and <span data-math=\"m\\measuredangle 8\">m\\measuredangle 8</span>.\n<br>\n<figure>\n<img src=\"exercises/media/92dd9a3a14bc5ca3.png\" alt=\"Two parallel lines, l subscript 1 and l subscript 2 are intersected by a transversal. The transversal makes four angles numbered 1, 2, 3, and 4 with the line, l subscript 1. The transversal makes four angles numbered 5, 6, 7, and 8 with the line, l subscript 2. 1, 2, 7, and 8 are exterior angles. 3, 4, 5, and 6 are interior angles. The corresponding angles, 1 and 5 are highlighted.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Angle 1 and angle 5 are corresponding. Corresponding angles have equal measures.</p>\n<p>m∡5 = 120°</p>\n<p>Angle 1 and angle 4 are vertical angles. Vertical angles have equal measures.</p>\n<p>m∡4 = 120°</p>\n<p>Angle 5 and angle 8 are vertical angles. Vertical angles have equal measures.</p>\n<p>m∡8 = 120°</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"m\\measuredangle 5 = {120^ \\circ}\">m\\measuredangle 5 = {120^ \\circ}</span>, <span data-math=\"m\\measuredangle 4 = {120^ \\circ}\">m\\measuredangle 4 = {120^ \\circ}</span>, <span data-math=\"m\\measuredangle 8 = {120^ \\circ}\">m\\measuredangle 8 = {120^ \\circ}</span>"
    }
