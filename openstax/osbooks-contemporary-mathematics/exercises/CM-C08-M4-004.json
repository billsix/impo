   "id": 529107,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The file <a href=\"https://openstax.org/r/Chapter8_Data-Sets\" rel=\"nofollow\" target=\"_blank\">“InState”</a> contains in-state tuition costs (in dollars) for every institution of higher learning in the US for which data is available. What is the standard deviation of these costs?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>If you have not already done so, copy the original Google sheet. You cannot edit the linked Google Sheet.</p>\n<p>Look for the InState tab in the Google Sheet. In a blank cell, enter “=STDEV(“ and click on the letter at the top of the Tuition column.</p>\n<p>The standard deviation is $13,333.77.</p>\n<p>If you do not see 77 cents, it is because Google Sheets likes to round to dollars. You can change that. Click on the menu item that looks like an arrow under two zeros while the focus is in that cell.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$13,333.77."
    }
   ],
   "community_solutions": []
  }
 ],
