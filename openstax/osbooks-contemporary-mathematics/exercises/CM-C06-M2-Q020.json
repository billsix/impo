 "questions": [
  {
   "id": 517205,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An item has a retail price of $45.00. What is the sale price after a 32% discount?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>discount = percent discount × original price</p>\n<p>discount = 0.32 × 45 = $14.40</p>\n<p>sale price = original price – discount</p>\n<p>sale price = 45 – 14.40 = $30.60</p>\n<p>The price after the discount is $30.60.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$30.60"
    }
   ],
   "community_solutions": []
  }
 ],
