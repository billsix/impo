   "id": 494387,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the cardinality of set <span data-math=\"A\">A</span> is <span data-math=\"n\\left( A \\right) = 10\">n\\left( A \\right) = 10</span>,  then set <span data-math=\"A\">A</span> has a total of ___________ subsets.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use the formula for the number of subsets of set <i>A</i> with <i>n</i> elements: <span data-math=\"{2^{n(A)}}\"></span>.</p>\n<p>Set <i>A</i> has ten elements.</p>\n<p><span data-math=\"{2^{n(A)}} = {2^{10}} = 1024\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"{2^{10}} = 1024\">{2^{10}} = 1024</span>"
    }
   ],
   "community_solutions": []
  }
