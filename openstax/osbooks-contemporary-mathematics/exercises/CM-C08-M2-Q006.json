   "id": 528605,
   "is_answer_order_important": false,
   "stimulus_html": "This table gives the records of the Major League Baseball teams at the end of the 2019 season:\n<table>\n<caption>(source: http://www.mlb.com)</caption>\n<thead>\n<tr>\n<th>Team</th>\n<th>Wins</th>\n<th>Losses</th>\n<th>Team</th>\n<th>Wins</th>\n<th>Losses</th></tr>\n</thead>\n<tbody>\n<tr><td>HOU</td>\n<td>107</td>\n<td>55</td>\n<td>PHI</td>\n<td>81</td>\n<td>81</td></tr>\n<tr><td>LAD</td>\n<td>106</td>\n<td>56</td>\n<td>TEX</td>\n<td>78</td>\n<td>84</td></tr>\n<tr><td>NYY</td>\n<td>103</td>\n<td>59</td>\n<td>SFG</td>\n<td>77</td>\n<td>85</td></tr>\n<tr><td>MIN</td>\n<td>101</td>\n<td>61</td>\n<td>CIN</td>\n<td>75</td>\n<td>87</td></tr>\n<tr><td>ATL</td>\n<td>97</td>\n<td>65</td>\n<td>CHW</td>\n<td>72</td>\n<td>89</td></tr>\n<tr><td>OAK</td>\n<td>97</td>\n<td>65</td>\n<td>LAA</td>\n<td>72</td>\n<td>90</td></tr>\n<tr><td>TBR</td>\n<td>96</td>\n<td>66</td>\n<td>COL </td>\n<td>71</td>\n<td>91</td></tr>\n<tr><td>CLE</td>\n<td>93</td>\n<td>69</td>\n<td>SDP</td>\n<td>70</td>\n<td>92</td></tr>\n<tr><td>WSN</td>\n<td>93</td>\n<td>69</td>\n<td>PIT </td>\n<td>69</td>\n<td>93</td></tr>\n<tr><td>STL</td>\n<td>91</td>\n<td>71</td>\n<td>SEA</td>\n<td>68</td>\n<td>94</td></tr>\n<tr><td>MIL</td>\n<td>89</td>\n<td>73</td>\n<td>TOR</td>\n<td>67</td>\n<td>95</td></tr>\n<tr><td>NYM</td>\n<td>86</td>\n<td>76</td>\n<td>KCR</td>\n<td>59</td>\n<td>103</td></tr>\n<tr><td>ARI</td>\n<td>85</td>\n<td>77</td>\n<td>MIA</td>\n<td>57</td>\n<td>105</td></tr>\n<tr><td>BOS</td>\n<td>84</td>\n<td>78</td>\n<td>BAL</td>\n<td>54</td>\n<td>108</td></tr>\n<tr><td>CHC</td>\n<td>84</td>\n<td>78</td>\n<td>DET</td>\n<td>47</td>\n<td>114</td></tr>\n</tbody>\n</table>\n",
   "stem_html": "Create a stem-and-leaf plot for the number of wins.\n",
