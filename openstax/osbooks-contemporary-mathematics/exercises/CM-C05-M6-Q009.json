   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"{x^2} = 25\"></span></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"x = \\pm \\sqrt {25} \"></span></td>\n<td></td>\n<td>Use the Square Root Property.</td>\n</tr>\n<tr>\n<td><span data-math=\"x = \\pm 5\"></span></td>\n<td></td>\n<td>Simplify.</td>\n</tr>\n<tr>\n<td><span data-math=\"x = 5\"></span></td>\n<td><span data-math=\"x = - 5\"></span></td>\n<td>Rewrite the two solutions.</td>\n</tr>\n</tbody>\n</table>\n<p>Checking is left to you.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"x = 5\">x = 5</span>, <span data-math=\"x = -5\">x = -5</span>"
    }
   ],
