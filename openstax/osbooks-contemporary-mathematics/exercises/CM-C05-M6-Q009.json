   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Solve using the Square Root Property: <span data-math=\"{x^2} = 25\">{x^2} = 25</span>.",
   "answers": [],
   "hints": [],
   "formats": [
