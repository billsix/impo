 "questions": [
  {
   "id": 545766,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A tiny home uses approximately 12 kW of electricity per day. What size solar system would be needed to fuel 80% of a home’s needs for a month (30 days)?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use 30 days in a month as a conversion factor. Convert the percentage to a decimal.</p>\n<p><span data-math=\"\\frac{{{\\rm{12\\ kW}}}}{{\\cancel{{{\\rm{day}}}}}}\\left( {\\frac{{30\\cancel{{{\\rm{days}}}}}}{{{\\rm{month}}}}} \\right)\\left( {0.80} \\right) = 288\\frac{{{\\rm{kW}}}}{{{\\rm{month}}}}\"></span></p>\n<p>You will need a 288-kW solar system.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "288 kW"
    }
   ],
   "community_solutions": []
  }
 ],
