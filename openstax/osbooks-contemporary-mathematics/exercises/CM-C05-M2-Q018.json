   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using the information from exercise 18 and exercise 19, which conversion formula would you use to find degrees Kelvin when given degrees Fahrenheit?",
   "answers": [
    {
     "id": 995304,
     "content_html": "<span data-math=\"K = \\frac{5}{9}\\left( {F-32} \\right) + 273\">K = \\frac{5}{9}\\left( {F-32} \\right) + 273</span>",
     "correctness": "1.0"
    },
    {
