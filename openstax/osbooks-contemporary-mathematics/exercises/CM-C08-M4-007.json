 "is_vocab": false,
 "stimulus_html": "<p>Employees at a college help desk track the number of people who request assistance each week, as listed below:</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>142</td>\n<td>153</td>\n<td>158</td>\n<td>156</td>\n<td>141</td>\n<td>143</td>\n</tr>\n<tr>\n<td>139</td>\n<td>158</td>\n<td>156</td>\n<td>146</td>\n<td>137</td>\n<td>153</td>\n</tr>\n<tr>\n<td>136</td>\n<td>127</td>\n<td>157</td>\n<td>148</td>\n<td>132</td>\n<td>139</td>\n</tr>\n<tr>\n<td>155</td>\n<td>167</td>\n<td>143</td>\n<td>168</td>\n<td>133</td>\n<td>157</td>\n</tr>\n<tr>\n<td>138</td>\n<td>156</td>\n<td>164</td>\n<td>130</td>\n<td>148</td>\n<td>136</td>\n</tr>\n</tbody>\n</table>",
 "questions": [
  {
   "id": 529115,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compute the range.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The range is the difference between the maximum and the minimum values.</p>\n<p>The maximum is 168.</p>\n<p>The minimum is 127.</p>\n<p>The range is 168 − 127 = 41 requests.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"168 - 127 = 41\">168 - 127 = 41</span>"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 529116,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compute the standard deviation.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Enter the values into a Google Sheet so you can use technology to help you.</p>\n<p>In a blank cell, enter “=STDEV(“ and click on the letter at the top of the column where you entered your data values.</p>\n<p>You should see approximately 11.306 requests.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "11.306"
    }
   ],
   "community_solutions": []
  }
