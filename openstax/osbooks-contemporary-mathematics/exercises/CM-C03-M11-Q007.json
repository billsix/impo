 "questions": [
  {
   "id": 506189,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Is the following a geometric sequence? Explain.<br>\n {3, 6, 12, 24, 48, 96, 192}",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Try 2.</p>\n<p><span data-math=\"3 \\times 2 = 6\"></span></p>\n<p><span data-math=\"6 \\times 2 = 12\"></span></p>\n<p><span data-math=\"12 \\times 2 = 24\"></span></p>\n<p>The pattern continues for each term. Each term is 2 times the previous term. This is a geometric sequence.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes, each term is the previous term multiplied by 2."
    }
   ],
   "community_solutions": []
  }
 ],
