 "questions": [
  {
   "id": 504846,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use your calculator to calculate 19 + (−36). Explain how the answer agrees with what was expected.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use your calculator to find that 19 + (–36) is –17.</p>\n<p>Because you are adding numbers with opposite signs, the sign of the answer matches the sign of the integer with the larger absolute value. Because |–36| &gt; |19|, the sign of the answer matches the sign of –36.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "−17. Since |19| &lt; |−36|, the sign of the answer matches the sign of −36, which is negative."
    }
   ],
   "community_solutions": []
  }
 ],
