   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Break your words into components.</p>\n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>A temperature in Kelvin</td>\n<td>is</td>\n<td>the Celsius temperature</td>\n<td>plus</td>\n<td>273 degrees</td>\n</tr>\n<tr>\n<td><i>K</i></td>\n<td>=</td>\n<td><i>C</i></td>\n<td>+</td>\n<td>273</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"K = C + 273\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"K = C + 273\">K = C + 273</span>, although d <span data-math=\"C = K – 273\">C = K – 273</span>  is an equivalent formula."
    }
   ],
