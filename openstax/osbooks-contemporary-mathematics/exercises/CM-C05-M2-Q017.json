   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To find a temperature on the Kelvin temperature scale, add 273 degrees to the temperature in Celsius. Which formula illustrates this?\n",
   "answers": [
    {
     "id": 995280,
     "content_html": "<span data-math=\" C = K + 273\"> C = K + 273</span>",
     "correctness": "0.0"
    },
    {
     "id": 995281,
     "content_html": "<span data-math=\" K = C + 273\"> K = C + 273</span>",
     "correctness": "1.0"
    },
    {
