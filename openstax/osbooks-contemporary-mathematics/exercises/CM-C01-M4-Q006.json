 "questions": [
  {
   "id": 494603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Set <span data-math=\"A = \\{a, b, c,\\ldots, z\\}\">A = \\{a, b, c,\\ldots,z\\}</span> and set <span data-math=\"B = \\{a, e, i, o, u\\}\">B = \\{a, e, i, o, u\\}</span>. Find <span data-math=\"A \\cup B\">A \\cup B</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The union of two sets includes all the members of the first set and all the members of the second set. Do not list duplicates twice. The vowels in set <i>B</i> are a subset of set <i>A</i>, so the union is equal to set <i>A</i>.</p>\n<p><span data-math=\"A \\cup B = \\left\\{ {a,b,c,d,...,z} \\right\\}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"A \\cup B = \\{a, b, c,\\ldots,z\\} = A\">A \\cup B = \\{a, b, c,\\ldots,z\\} }} = A</span>."
    }
   ],
   "community_solutions": []
  }
 ],
