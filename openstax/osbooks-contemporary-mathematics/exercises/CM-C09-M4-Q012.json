   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Prefix</td>\n<td>kilo-</td>\n<td>hecto-</td>\n<td>deca-</td>\n<td>base</td>\n<td>deci-</td>\n<td>centi-</td>\n<td>milli-</td>\n</tr>\n<tr>\n<td>Abbreviation</td>\n<td>k</td>\n<td>h</td>\n<td>da</td>\n<td>&nbsp;</td>\n<td>d</td>\n<td>c</td>\n<td>m</td>\n</tr>\n<tr>\n<td>Magnitude</td>\n<td>10<sup>3</sup></td>\n<td>10<sup>2</sup></td>\n<td>10<sup>1</sup></td>\n<td>1</td>\n<td>10<sup>−1</sup></td>\n<td>10<sup>−2</sup></td>\n<td>10<sup>−3</sup></td>\n</tr>\n</tbody>\n</table>\n<p>Step 1: Convert the grams to kilograms.</p>\n<p><span data-math=\"48{\\text{ }}\\cancel{{{\\text{grams}}}}\\left( {\\frac{{1{\\text{ kilogram}}}}{{1,000{\\text{ }}\\cancel{{{\\text{grams}}}}}}} \\right) = {\\text{ 0}}{\\text{.048 kilograms}}\"></span></p>\n<p>Step 2: Multiply by 3.</p>\n<p><span data-math=\"{\\text{3(0}}{\\text{.048 kg)  =  0}}{\\text{.144 kg}}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "0.144"
    }
   ],
   "community_solutions": []
