 "stimulus_html": "You’re drawing 2 cards in order from a deck containing only the cards <span data-math=\"{\\text{A}}♡\">{\\text{A}}♡</span>, <span data-math=\"{\\text{A}}♣\">{\\text{A}}♣</span>, <span data-math=\"{\\text{K}}♠\">{\\text{K}}♠</span>, <span data-math=\"10♡\">10♡</span>, <span data-math=\"9♡\">9♡</span>, <span data-math=\"9♠\">9♠</span>, <span data-math=\"9\\diamondsuit\">9\\diamondsuit</span>, and <span data-math=\"6♣\">6♣</span>. Compute the following:",
 "questions": [
  {
   "id": 516687,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"P({\\text{draw}}\\,{\\text{a}}\\,{\\text{♡}}\\,{\\text{first}}\\,{\\text{and a}}\\,{\\text{♠}}\\,{\\text{second}})\">P({\\text{draw}}\\,{\\text{a}}\\,{\\text{heart}}\\,{\\text{first}}\\,{\\text{and a}}\\,{\\text{spade}}\\,{\\text{second}})</span>",
   "answers": [],
