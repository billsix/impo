   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A set is a proper subset of <i>L</i> if every member of the subset is a member of <i>L</i> and the subset does <i>not</i> contain an element that is in <i>L</i>. The only proper subset of <i>L</i> with no members is the empty set, represented by <span data-math=\"\\{\\}\"></span> or <span data-math=\"\\emptyset \"></span>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The empty set is represented as <span data-math=\"\\{ {\\text{ }}\\} \">\\{ {\\text{ }}\\}</span> or <span data-math=\"\\emptyset \">\\emptyset </span>.\n"
    }
   ],
   "community_solutions": []
