   "id": 509685,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Express as a Hindu-Arabic number: <span data-math=\"6 \\times {10^5} + 0 \\times {10^4} + 1 \\times {10^3} + 9 \\times {10^2} + 4 \\times {10^1} + 7 \\times {10^0}\">6 \\times {10^5} + 0 \\times {10^4} + 1 \\times {10^3} + 9 \\times {10^2} + 4 \\times {10^1} + 7 \\times {10^0}</span>.",
   "answers": [],
