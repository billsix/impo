 "is_vocab": false,
 "stimulus_html": "For the following situations, decide which measure(s) of centrality would be best:",
 "questions": [
  {
   "id": 528800,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The data come from a survey question where the responses range from 1 (“not interested”) to 10 (“very interested”).",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Mode or median would be best, since you might be worried that you will get a lot of “not interested” answers that would skew your average."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Mode or median"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 528801,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The data are fuel efficiency measures (in miles per gallon) for various vehicles. The data are right-skewed.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Fuel efficiency lends itself well to the use of a mean or median. It is very likely that no number will occur twice, making the mode a useless measure."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Median or mean"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 528802,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The data are scores on an exam, and they are left-skewed.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "You might want to know both the mean and the median. The mean will be pulled to the left by the skew."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Median or mean"
    }
   ],
   "community_solutions": []
  }
 ],
