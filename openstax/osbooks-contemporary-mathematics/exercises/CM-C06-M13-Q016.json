 "questions": [
  {
   "id": 517591,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Antonio’s taxes owed based on his income are $3,950. However, he qualifies for the earned income tax credit of $1,925 and a child tax credit of $2,000. How much does Antonio owe after applying the tax credits?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Add the tax credits.</p>\n<p>1,925 + 2,000 = 3,925</p>\n<p>Tax credits are subtracted from the tax you owe.</p>\n<p>3,950 – 3,925 = $25</p>\n<p>The amount of taxes owed after applying tax credits is $25.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$25"
    }
   ],
   "community_solutions": []
  }
 ],
