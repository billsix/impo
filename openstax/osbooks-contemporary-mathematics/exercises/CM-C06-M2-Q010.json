 "questions": [
  {
   "id": 516667,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A furniture outlet spends $360.00 to buy a bed. The store marks up the bed by 250%. What is the retail price of the bed?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>markup = percent markup × cost</p>\n<p>markup = 2.50 × 360</p>\n<p>markup = 900</p>\n<p>retail price = cost + markup</p>\n<p>retail price = 360 + 900 = $1,260</p>\n<p>The retail price is $1,260.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The retail price of the bed is $1,260.00."
    }
   ],
   "community_solutions": []
  }
 ],
