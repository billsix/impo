   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The formula relating the total (base), the percent in decimal form, and the part (amount) is</p>\n<p><span data-math=\"part = percent \\times total\"></span> or <span data-math=\"amount = percent \\times base\"></span>.</p>\n<p>26% of 1,300</p>\n<p><span data-math=\"part = percent \\times total\"></span></p>\n<p><span data-math=\"part = 0.26\\left( {1,300} \\right)\"></span></p>\n<p><span data-math=\"part = 338\"></span></p>"
    },
    {
