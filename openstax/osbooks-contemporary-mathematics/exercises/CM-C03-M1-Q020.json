   "id": 504771,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use lists to find the LCM of 12 and 15.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Multiples of 12: 12, 24, 36, 48, 60</p>\n<p>Multiples of 15: 15, 30, 45, 60</p>\n<p>The first number common to both lists is 60.</p>\n<p>The LCM is 60.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "60"
    }
   ],
