 "questions": [
  {
   "id": 505883,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify  which of the following are rational numbers.<br>\n<span data-math=\"- 41,{\\mkern 1mu} \\,\\sqrt {13,} {\\mkern 1mu} \\,\\frac{4}{3},\\,\\,2.75,\\,{\\mkern 1mu} 0.2\\overline {13}\">- 41,{\\mkern 1mu} \\,\\sqrt {13,} {\\mkern 1mu} \\,\\frac{4}{3},\\,\\,2.75,\\,{\\mkern 1mu} 0.2\\overline {13}</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"-41\"></span> is a rational number as it is an integer. You can write an integer as a fraction over 1.</p>\n<p><span data-math=\"\\frac{4}{3}\"></span> is a rational number as it is a ratio of two integers.</p>\n<p>2.75 is a rational number as it equals a ratio of two integers. For instance, you can see it is equal to 275 divided by 100.</p>\n<p><span data-math=\"0.2\\overline {13} \"></span> is a rational number because repeating decimals are rational numbers.</p>\n<p>The square root of 13 is not a rational number because it approximates to a decimal that does not repeat.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"- 41,{\\mkern 1mu} \\,\\frac{4}{3},\\,\\,2.75,\\,{\\mkern 1mu} 0.2\\overline {13}\">- 41,{\\mkern 1mu} \\,\\frac{4}{3},\\,\\,2.75,\\,{\\mkern 1mu} 0.2\\overline {13} </span> are rational; <span data-math=\"\\sqrt {13}\">\\sqrt {13}</span>   is not."
    }
   ],
   "community_solutions": []
  }
 ],
