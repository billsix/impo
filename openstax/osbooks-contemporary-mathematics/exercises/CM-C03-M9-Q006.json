   "stem_html": "<span data-math=\"3.03 \\times {10^{ - 6}} - 1.5 \\times {10^{ - 6}}\">3.03 \\times {10^{ - 6}} - 1.5 \\times {10^{ - 6}}</span>",
   "answers": [],
