    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Open a copy of the file in Google Sheets. You cannot edit the original file.</p>\n<p>Look for the InState tab.</p>\n<p>Look for the Tuition column.</p>\n<p>In a blank cell, enter the function: = PERCENTRANK(</p>\n<p>Click on the letter at the top of the Tuition column.</p>\n<p>Then enter a comma, 53922, and close the parentheses: ,53922)</p>\n<p>The complete function probably looks like this: =PERCENTRANK(C:C,53922).</p>\n<p>You see the decimal value 0.985.</p>\n<p>Convert this to a percentage to say that this is the 98.5<sup>th</sup> percentile.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "98.5th"
    }
   ],
