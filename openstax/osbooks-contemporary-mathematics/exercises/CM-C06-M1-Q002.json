   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The decimal form of <i>n</i>% is found by calculating the decimal value of <i>n</i> ÷ 100.</p>\n<p>9% is 9 divided by 100.</p>\n<p>This moves the decimal point two places to the left, resulting in 0.09.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "0.09"
    }
