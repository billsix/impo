   ],
   "combo_choices": []
  },
  {
   "id": 516117,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the probability that the dealer is dealt an initial hand worth 21 points, with an ace showing?\n",
   "answers": [],
