 "questions": [
  {
   "id": 528796,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The dataset <a href=\"https://openstax.org/r/Chapter8_Data-Sets\" rel=\"nofollow\" target=\"_blank\">\"MLB2019\"</a> gives the number of wins for every Major League Baseball team in the 2019 season. Use Google Sheets to find the mode(s), median, and mean.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>You will have to download the file to be able to work with it. You can upload it to Google Sheets (or open it in Excel if you prefer). These directions assume you use Google Sheets.</p>\n<p>After you open the Google Spreadsheet, open the MLB 2019 tab.</p>\n<p>MODE: At the bottom of the column for “Wins,” enter “=MODE.MULT(“ and then click and drag through all the numbers in the Wins column.</p>\n<p>The modes are the answers you see: 72, 84, 93, and 97.</p>\n<p>Hint: If you just used “=MODE(“ you would only see one mode, the final one in the list.</p>\n<p>MEDIAN: Use the same process, but enter “=MEDIAN(“</p>\n<p>The median is 82.5.</p>\n<p>MEAN: Use the same process, but enter “=AVERAGE(“</p>\n<p>The mean is approximately 80.967.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Modes: 72, 84, 93, 97<br>\nMedian: 82.5<br>\nMean: 80.967 (rounded to three decimal places)\n"
    }
   ],
   "community_solutions": []
  }
 ],
