   "id": 493932,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The United States is the only country to have landed people on the moon as of March 21, 2021. What is the cardinality of the set of all people who have walked on the moon prior to this date?",
   "answers": [],
