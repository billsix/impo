 "questions": [
  {
   "id": 528822,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the data in <a href=\"https://openstax.org/r/Chapter8_Data-Sets\" rel=\"nofollow\" target=\"_blank\">“InState,”</a>, which shows in-state tuition and fees for most institutions of higher learning in the United States. Compute the mode, median, and mean.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>If you have not already done so, you will need to copy the data from the InState tab into your own Google Sheet.</p>\n<p>In an empty cell, enter “=MODE.MULT(“ and click on the Tuition column header.</p>\n<p>Your mode is $13,380.</p>\n<p>In another cell enter “=MEDIAN(“ and click on the Tuition column header.</p>\n<p>The median is $11,207.</p>\n<p>In another cell enter “=AVERAGE(“ and click on the Tuition column header.</p>\n<p>The mean is approximately $15,476.79.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Mode: $13,380 <br>\nMedian: $11,207 <br>\nMean: $15,476.79\n"
    }
   ],
