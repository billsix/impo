 "stimulus_html": "In the following geometric sequences, determine the indicated term of the geometric sequence with a given first term and common ratio.",
 "questions": [
  {
   "id": 506150,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Determine the <span data-math=\"12\\text{th}\">12\\text{th}</span> term of the geometric sequence with <span data-math=\"{a_1} = 3072\">{a_1} = 3072</span> and <span data-math=\"r = \\frac{1}{2}\">r = \\frac{1}{2}</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The <i>n</i>th term of a geometric sequence, <span data-math=\"{a_n}\"></span>, with first term <span data-math=\"{a_1}\"></span> and common ratio <i>r</i>, is <span data-math=\"{a_n} = {a_1}{r^{n - 1}}\"></span>.</p>\n<p><span data-math=\"{a_{12}} = 3072{\\left( {\\frac{1}{2}} \\right)^{11}} = \\frac{3}{2}\"></span></p>\n<p>Alternate answer option: 1.5</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\frac{3}{2}\">\\frac{3}{2}</span>"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 506151,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Determine the <span data-math=\"5\\text{th}\">5\\text{th}</span> term of the geometric sequence with <span data-math=\"{a_1} = 0.5\">{a_1} = 0.5</span> and <span data-math=\"r = 8\">r = 8</span>.",
   "answers": [],
