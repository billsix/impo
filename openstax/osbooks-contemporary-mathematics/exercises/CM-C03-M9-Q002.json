    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>1</p>\n<p>Case 1: The number is a single-digit integer.</p>\n<p>In this case, the scientific notation form of the number is <span data-math=\"digit \\times {10^0}\"></span>.</p>\n<p><span data-math=\"1 \\times {10^0}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"1 \\times {10^0}\">1 \\times {10^0}</span>"
    }
   ],
   "community_solutions": []
