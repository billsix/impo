 "stimulus_html": "Looking again at the <a href=\"https://openstax.org/r/Chapter8_Data-Sets\" rel=\"nofollow\" target=\"_blank\">“AvgSAT”</a> dataset:",
 "questions": [
  {
   "id": 529184,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What score is at the 15th percentile?\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>You want the score at the 15<sup>th</sup> percentile.</p>\n<p>Open a copy of the file in Google Sheets. You cannot edit the original file.</p>\n<p>Look for the AvgSAT tab.</p>\n<p>Look for the Average SAT Score column.</p>\n<p>In a blank cell, enter the function: =PERCENTILE(</p>\n<p>Click on the letter at the top of the Average SAT Score column.</p>\n<p>Then enter a comma, the percentile as a decimal and close the parentheses: ,0.15)</p>\n<p>The complete function probably looks like this: =PERCENTILE(C:C,0.15)</p>\n<p>The score you see is 1026.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1026\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 529185,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What score is at the 90th percentile?",
   "answers": [],
