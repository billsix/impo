 "stimulus_html": "Write the negation of each conditional statement.",
 "questions": [
  {
   "id": 496617,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If some people like ice cream, then ice cream makers will make a profit.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"p \\to q:\"></span> If some people like ice cream, then ice cream makers will make a profit.</p>\n<p><span data-math=\"p:\"></span> Some people like ice cream.</p>\n<p><span data-math=\"q:\"></span> Ice cream makers will make a profit.</p>\n<p>Negation:</p>\n<p><span data-math=\"\\text{~}q:\"></span> Ice cream makers will not make a profit.</p>\n<p>The negation of a conditional is the conjunction of <span data-math=\"p\"></span> and not <span data-math=\"q\"></span>.</p>\n<p><span data-math=\"\\text{~}(p \\to q){\\rm{ }} \\equiv \\;p \\wedge \\text{~}q\"></span></p>\n<p>Some people like ice cream, and ice cream makers will not make a profit.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Some people like ice cream, but ice cream makers will not make a profit."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 496618,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If Raquel cannot play video games, then nobody will play video games.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"p \\to q:\"></span> If Racquel cannot play video games, then nobody will play video games.</p>\n<p><span data-math=\"p:\"></span> Racquel cannot play video games.</p>\n<p><span data-math=\"q:\"></span> Nobody will play video games.</p>\n<p>Negation:</p>\n<p>The negation of a “No…” statement is a “Some…” statement.</p>\n<p><span data-math=\"\\text{~}q:\"></span> Somebody will play video games.</p>\n<p>The negation of a conditional is the conjunction of <span data-math=\"p\"></span> and not <span data-math=\"q\"></span>.</p>\n<p><span data-math=\"\\text{~}(p \\to q){\\rm{ }} \\equiv \\;p \\wedge \\text{~}q\"></span></p>\n<p>Racquel cannot play video games, but somebody will play video games.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Raquel cannot play video games, but somebody will play video games.\n"
    }
   ],
   "community_solutions": []
  }
