 "questions": [
  {
   "id": 511724,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An antique music store sells two types of vinyl records; 45 rpm records (<span data-math=\"f\">f</span>) and 33 rpm records (<span data-math=\"t\">t</span>). It makes a profit of $2.50 for each 45 rpm record and $6.75 for each 33 rpm record. The objective function for profit in this situation is:\n",
   "answers": [
    {
     "id": 1000718,
     "content_html": "<span data-math=\"{P = 2.50f + 6.75c}\">{P = 2.50f + 6.75c}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000719,
     "content_html": "<span data-math=\"{P = 2.50f + 6.75t}\">{P = 2.50f + 6.75t}</span>",
     "correctness": "1.0"
    },
    {
     "id": 1000720,
     "content_html": "<span data-math=\"{P = 2.50t + 6.75f}\">{P = 2.50t + 6.75f}</span>",
     "correctness": "0.0"
    },
    {
     "id": 1000721,
     "content_html": "None of these",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Let <i>f</i> = the number of 45 rpm records.</p>\n<p>Let <i>t</i> = the number of 33 rpm records.</p>\n<p>Let <i>P</i> = the profit.</p>\n<p>The profit on a 45-rpm record is $2.50.</p>\n<p>The profit on a 33-rpm record is $6.75.</p>\n<p>Break the words into components.</p> \n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>The total profit</td>\n<td>is</td>\n<td>$2.50 times the number of 45-rpm records sold</td>\n<td>plus</td>\n<td>$6.75 times the number of 33-rpm records sold</td>\n</tr>\n<tr>\n<td><i>P</i></td>\n<td>=</td>\n<td>2.50<i>f</i></td>\n<td>+</td>\n<td>6.75<i>t</i></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"P = 2.50f + 6.75t\"></span></p>\n"
    }
   ],
   "community_solutions": []
  }
 ],
