 "questions": [
  {
   "id": 508633,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "There are 16 math majors and 12 non-math majors in Ms. Kraft’s class. What shows the ratio of math majors to all the students in Ms. Kraft’s class?<br><br>\n<table class=\"unnumbered\" summary=\".\">\n<tbody>\n<tr>\n<td><span data-math=\"16:12\">16:12</span></td>\n<td><span data-math=\"12:16\">12:16</span></td>\n<td><span data-math=\"16:28\">16:28</span></td>\n<td><span data-math=\"28:12\">28:12</span></td>\n<td>None of these</td>\n</tr>\n</tbody>\n</table>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>There are 16 math majors and 12 non-math majors.</p>\n<p>There are 12 + 16 = 28 total students.</p>\n<p>The ratio of math majors to all students is 16 to 28 or 16:28.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"16{:}28\">16{:}28</span>"
    }
   ],
   "community_solutions": []
  }
 ],
