 "questions": [
  {
   "id": 519091,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The poverty guideline for two-person household in Hawaii is $21,060. If Jamie lives in a two-person household and has a gross income of $36,900, what is his discretionary income?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>150 percent of the poverty guideline is: <span data-math=\"1.50\\left( {21,060} \\right){\\text{ }} = {\\text{ }}\\$31,590\"></span>.</p>\n<p>Discretionary income is the amount Jamie earns over $31,590.</p>\n<p>Subtract $31,590 from Jamie’s income of $36,900 to find her discretionary income.</p>\n<p><span data-math=\"36,900{\\text{ }}-{\\text{ }}31,590{\\text{ }} = {\\text{ }}\\$5,310\"></span></p>\n<p>Jamie’s discretionary income is $5,310.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$5,310"
    }
   ],
   "community_solutions": []
  }
 ],
