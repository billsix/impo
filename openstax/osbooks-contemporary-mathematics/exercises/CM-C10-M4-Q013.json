 "questions": [
  {
   "id": 534337,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the sum of the interior angles of a regular hexagon.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A hexagon has six sides, so <span data-math=\"n = 6\"></span>.</p>\n<p>The sum of the interior angles of a polygon with <i>n</i> sides is <span data-math=\"S = \\left( {n - 2} \\right)180^\\circ \"></span>.</p>\n<p><span data-math=\"S = \\left( {n - 2} \\right)180^\\circ = \\left( {6 - 2} \\right)180^\\circ = \\left( 4 \\right)180^\\circ = 720^\\circ \"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"S = \\left( {6 - 2} \\right){180^ \\circ } = {720^ \\circ }\">S = \\left( {6 - 2} \\right){180^ \\circ } = {720^ \\circ }</span>"
    }
   ],
   "community_solutions": []
  }
 ],
