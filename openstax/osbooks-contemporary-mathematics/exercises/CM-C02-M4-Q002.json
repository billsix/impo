     "content_html": "Not valid\n<table>\n<thead>\n<tr>\n<th><span data-math=\"p\">p</span></th>\n<th><span data-math=\"q\">q</span></th>\n<th><span data-math=\"\\text{~}{p}\">\\text{~}{p}</span></th>\n<th><span data-math=\"{q} \\wedge {p}\">{q} \\wedge {p}</span></th>\n<th><span data-math=\"\\text{~}{p} \\to \\left( {{q} \\wedge {p}} \\right)\">\\text{~}{p} \\to \\left( {{q} \\wedge {p}} \\right)</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>T</td>\n<td>T</td>\n<td>F</td>\n<td>T</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>T</td>\n<td>F</td>\n<td>F</td>\n<td>F</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>F</td>\n<td>T</td>\n<td>T</td>\n<td>F</td>\n<td><b>F</b></td>\n</tr>\n<tr>\n<td>F</td>\n<td>F</td>\n<td>T</td>\n<td>F</td>\n<td><b>F</b></td>\n</tr>\n</tbody>\n</table>"
