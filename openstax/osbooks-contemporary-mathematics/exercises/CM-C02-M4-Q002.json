     "solution_type": "detailed",
     "content_html": "Valid\n<table>\n<thead>\n<tr>\n<th><span data-math=\"p\">p</span></th>\n<th><span data-math=\"q\">q</span></th>\n<th><span data-math=\"\\text{~}{p}\">\\text{~}{p}</span></th>\n<th><span data-math=\"\\text{~}{p} \\vee {q}\">\\text{~}{p} \\vee {q}</span></th>\n<th><span data-math=\"{q} \\to \\left( {\\text{~}{p} \\vee {q}} \\right)\">{q} \\to \\left( {\\text{~}{p} \\vee {q}} \\right)</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>T</td>\n<td>T</td>\n<td>F</td>\n<td>T</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>T</td>\n<td>F</td>\n<td>F</td>\n<td>F</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>F</td>\n<td>T</td>\n<td>T</td>\n<td>T</td>\n<td><b>T</b></td>\n</tr>\n<tr>\n<td>F</td>\n<td>F</td>\n<td>T</td>\n<td>T</td>\n<td><b>T</b></td>\n</tr>\n</tbody>\n</table>"
    },
