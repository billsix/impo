  {
   "id": 294517,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Do you think the result of part 3 is true for Borda count and the monotonicity criterion in general? Why or why not?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Increasing the ranking for a winner of a Borda count election on a ballot will increase that candidate’s Borda score while decreasing another candidate’s Borda score, but leaving the remaining candidates’ Borda score unchanged. So, a Borda count election will never violate the monotonicity criterion."
    }
   ],
   "community_solutions": []
  }
