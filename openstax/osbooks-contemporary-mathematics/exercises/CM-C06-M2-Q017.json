 "questions": [
  {
   "id": 517201,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Elizabeth decides to buy new running shoes in her hometown of Springfield, Illinois, where the sales tax rate is 6.25%. If her total bill comes to $153, how much of the total price is sales tax?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>total price = purchase price × (1 + tax rate)</p>\n<p>153 = purchase price × (1 + 0.0625)</p>\n<p>153 = purchase price × (1.0625)</p>\n<p><span data-math=\"\\frac{{153}}{{1.0625}}\"></span> = purchase price</p>\n<p>$144 = purchase price</p>\n<p>total price = purchase price + sales tax</p>\n<p>153 = 144 + sales tax</p>\n<p>$9 = sales tax</p>\n<p>The sales tax is $9.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The sales tax is $9."
    }
   ],
   "community_solutions": []
  }
 ],
