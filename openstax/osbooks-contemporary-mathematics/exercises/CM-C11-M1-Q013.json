 "questions": [
  {
   "id": 544825,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would be the outcome of the election if every member of the Chionilis family approved their top three choices from the table below?\n      <table class=\"unnumbered\" summary=\".\">\n      <thead>\n      <tr>\n      <th>Options</th>\n      <th>A</th>\n      <th>R</th>\n      <th>S</th>\n      <th>T</th>\n      <th>G</th>\n      </tr>\n      </thead>\n      <tbody>\n      <tr>\n      <td>Rainbow China</td>\n      <td>1</td>\n      <td>3</td>\n      <td>3</td>\n      <td>1</td>\n      <td>3</td>\n      </tr>\n      <tr>\n      <td>Dough Boys Pizza</td>\n      <td>2</td>\n      <td>2</td>\n      <td>1</td>\n      <td>2</td>\n      <td>1</td>\n      </tr>\n      <tr>\n      <td>Taco City</td>\n      <td>3</td>\n      <td>4</td>\n      <td>2</td>\n      <td>4</td>\n      <td>2</td>\n      </tr>\n      <tr>\n      <td>Caribbean Flavor</td>\n      <td>4</td>\n      <td>1</td>\n      <td>4</td>\n      <td>3</td>\n      <td>4</td>\n      </tr>\n      </tbody>\n      </table>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Count the number of Yes votes earned by each option. Anything with a score of 1, 2, or 3 counts as a Yes.</p>\n<p>Rainbow China: 5</p>\n<p>Dough Boys Pizza: 5</p>\n<p>Taco City: 3</p>\n<p>Caribbean Flavor: 2</p>\n<p>The option with the most Yes votes wins.</p>\n<p>Rainbow China and Dough Boys Pizza have a tie this time.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "There is a tie between Rainbow China and Dough Boys Pizza."
    }
   ],
   "community_solutions": []
  }
 ],
