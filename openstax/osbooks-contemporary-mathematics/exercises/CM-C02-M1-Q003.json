 "questions": [
  {
   "id": 496156,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ted Cruz was not born in Texas.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The negation of a logical statement has the opposite truth value of the original statement.</p>\n<p>Original statement: Ted Cruz was not born in Texas.</p>\n<p>Remove “not.”</p>\n<p>Negation: Ted Cruz was born in Texas.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Ted Cruz was born in Texas."
    }
   ],
   "community_solutions": []
  },
  {
