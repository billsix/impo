 "questions": [
  {
   "id": 534299,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the circumference of a circle with a radius of 2.25 cm.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The circumference of a circle is <span data-math=\"C = 2\\pi r\"></span> where <i>r</i> is the radius.</p>\n<p><span data-math=\"C = 2\\pi r = 2\\pi \\left( {2.25{\\rm{\\ cm}}} \\right) = 4.5{\\rm{\\ cm}} \\approx 14.14{\\rm{\\ cm}}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"C = 2(2.25)\\pi  = 14.14\\text{ cm}\">C = 2(2.25)\\pi  = 14.14\\text{ cm}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
