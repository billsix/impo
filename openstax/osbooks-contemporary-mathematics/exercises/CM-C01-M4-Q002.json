    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The members that two sets have in common are included in the intersection of the sets. The sets have no elements in common, so their intersection is the empty set. You can represent the empty set by either the zero with a slash or empty curly braces.</p>\n<p><span data-math=\"A \\cap B = \\emptyset \"></span> or <span data-math=\"A \\cap B = \\{ \\} \"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"A \\cap B = \\{\\,\\,\\}\">A \\cap B = \\{ \\,\\,\\}</span>"
    }
   ],
   "community_solutions": []
  }
