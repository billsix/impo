   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Set <span data-math=\"A = \\{ {\\text{red, yellow, blue}}\\}\">A = \\{ {\\text{red, yellow, blue}}\\}</span> and set <span data-math=\"B = \\{ {\\text{orange, green, purple}}\\}\">B = \\{ {\\text{orange, green, purple}}\\}</span>. Find <span data-math=\"A \\cap B\">A \\cap B</span>.",
   "answers": [],
