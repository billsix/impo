 "questions": [
  {
   "id": 493906,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use an ellipsis to write the set of single digit numbers greater than or equal to zero and label it with a capital <span data-math=\"D\">D</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Be sure to include zero because the requirements include “greater than or equal to zero.” You stop before 10 because 10 is not a single-digit number.</p>\n<span data-math=\"D = {\\rm{ }}\\left\\{ {0,{\\rm{ }}\\ 1,{\\rm{ }}\\ 2,{\\rm{ }}\\ 3,{\\rm{ }}\\ 4,{\\rm{ }}\\ 5,{\\rm{ }}\\ 6,{\\rm{ }}\\ 7,{\\rm{ }}\\ 8,{\\rm{ }}\\ 9} \\right\\}\"></span>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"D = \\{ 0,1,2, \\ldots ,9\\} \">D = \\{ 0,1,2, \\ldots ,9\\} </span>"
    }
   ],
   "community_solutions": []
  }
 ],
