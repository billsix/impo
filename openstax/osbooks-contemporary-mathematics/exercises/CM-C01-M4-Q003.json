    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The members that two sets have in common are included in the intersection of the sets. The two sets have the vowels in common.</p>\n<p><span data-math=\"A \\cap B = \\left\\{ {a,e,i,o,u} \\right\\}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"A \\cap B = B = \\{a,e,i,o,u\\}\">A \\cap B = B = \\{a,e,i,o,u\\}</span>"
    }
   ],
