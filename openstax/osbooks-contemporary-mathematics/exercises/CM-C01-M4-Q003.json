   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Set <span data-math=\"A = \\{a,b,c,\\ldots,z\\}\">A = \\{a,b,c,\\ldots,z\\}</span> and set <span data-math=\"B = \\{a,e,i,o,u\\}\">B = \\{a,e,i,o,u\\}</span>. Find <span data-math=\"A \\cap B\">A \\cap B</span>.",
   "answers": [],
