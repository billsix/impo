 "questions": [
  {
   "id": 526882,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Etruscan shrew is one of the world’s smallest mammals. It has a huge appetite, eating almost twice its weight in food each day. Its heart beats at a rate of 25 beats per second! Which of the following is a reasonable value for the weight of an Etruscan shrew: 2 g, 2 kg, or 2 mt? Explain your answer.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A gram is about the weight of a paper clip. A shrew that tiny can weigh the same as two paper clips, so 2 grams is reasonable."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A reasonable value for the weight of an Etruscan shrew is 2 g. A 2 L bottle of water weighs 2 kg, and since it is one of the smallest mammals, the shrew must weigh less than that, so 2 g seems reasonable."
    }
   ],
   "community_solutions": []
  }
 ],
