 "questions": [
  {
   "id": 505823,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ashley wants to study for 10 hours over the weekend. She plans to spend half the time studying math, a quarter of the time studying history, an eighth of the time studying writing, and the remaining eighth of the time studying physics. How much time will Ashley spend on each of those subjects?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Math: half the <span data-math=\"{\\rm{time}} = \\frac{1}{2} \\times 10 = 5\\;{\\rm{hours}}\"></span> on math</p>\n<p>History: a quarter of the <span data-math=\"{\\rm{time}} = \\frac{1}{4} \\times 10 = 2.5\\;{\\rm{hours}}\"></span> on history</p>\n<p>Writing: an eighth of the <span data-math=\"{\\rm{time}} = \\frac{1}{8} \\times 10 = 1.25\\;{\\rm{hours}}\"></span> on writing</p>\n<p>Physics: an eighth of the <span data-math=\"{\\rm{time}} = \\frac{1}{8} \\times 10 = 1.25\\;{\\rm{hours}}\"></span> on physics</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<br>\nStudying math: 5 hours\n<br>\nStudying history: 2.5 hours\n<br>\nStudying writing: 1.25 hours\n<br>\nStudying physics: 1.25 hours"
    }
   ],
   "community_solutions": []
  }
 ],
