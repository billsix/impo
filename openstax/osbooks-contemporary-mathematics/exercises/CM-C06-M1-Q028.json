   "id": 516552,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Convert 38.7% to decimal form.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The decimal form of <i>n</i>% is found by calculating the decimal value of <i>n</i> ÷ 100.</p>\n<p>38.7% is 38.7 divided by 100.</p>\n<p>This moves the decimal point two places to the left, resulting in 0.387.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "0.387"
    }
   ],
   "community_solutions": []
  }
 ],
