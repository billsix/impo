 "questions": [
  {
   "id": 533577,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the measure of the missing angle in the given figure. \n<br>\n<img src=\"exercises/media/3a40aafb4ac943d8.png\" alt=\"A triangle with its interior angles marked x, 26 degrees, and 65 degrees.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The sum of the angle measures must be 180°.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"26 + 65 + x = 180\"></span> </td>\n<td>Add.</td>\n</tr>\n<tr>\n<td><span data-math=\"x + 91 = 180\"></span></td>\n<td>Subtract.</td>\n</tr>\n<tr>\n<td><span data-math=\"x = 89\"></span></td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>The angle measures 89°.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"x = {89^ \\circ }\">x = {89^ \\circ }</span>"
    }
   ],
   "community_solutions": []
  }
 ],
