 "questions": [
  {
   "id": 526673,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An ice cream maker boxes frozen yogurt mix in boxes that measure 25 cm long, 8 cm wide and 35 cm tall. They produce 42,000 liters of frozen yogurt mix each day. How many boxes of frozen yogurt mix are produced each day?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: Find the volume of a box.</p>\n<p><span data-math=\"V{\\text{ }} = {\\text{ }}L{\\text{ }} \\times {\\text{ }}W \\times H{\\text{ }} = {\\text{ }}\\left( {{\\text{25 cm}}} \\right)\\left( {{\\text{8 cm}}} \\right)\\left( {{\\text{35 cm}}} \\right){\\text{ }} = 7,000{\\text{ c}}{{\\text{m}}^3}\"></span></p>\n<p>Step 2: Convert the volume of a box into liters.</p>\n<p><span data-math=\"7,000\\cancel{{{\\text{cubic centimeters}}}}\\left( {\\frac{{{\\text{ 1 liter}}}}{{{\\text{ 1,000}}\\cancel{{{\\text{cubic centimeters}}}}}}} \\right) = 7{\\text{ liters}}\"></span></p>\n<p>Step 3: Convert the factory production into boxes.</p>\n<p><span data-math=\"{\\text{42,000 liters }}\\left( {\\frac{{{\\text{1 box}}}}{{{\\text{7 }}\\cancel{{{\\text{liters}}}}{\\text{ }}}}} \\right) = 6,000{\\text{ boxes}}\"></span></p>\n<p>They produce 6,000 boxes per day.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "6,000 boxes"
    }
   ],
   "community_solutions": []
  }
 ],
