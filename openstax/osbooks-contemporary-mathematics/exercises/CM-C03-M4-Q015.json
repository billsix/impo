     "solution_type": "summary",
     "content_html": "<p>There are five decimal places, so raise 10 to the fifth power.</p>\n<p><span data-math=\"{10^5} = 100,000\"></span></p>\n<p><span data-math=\"\\frac{{17.03347 \\times 100,000}}{{1 \\times 100,000}} = \\frac{{1,703,347}}{{100,000}}\"></span></p>"
