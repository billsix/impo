 "questions": [
  {
   "id": 505173,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p>Correctly apply the rules for the order of operations to accurately compute the following:</p>\n<p><span data-math=\"12/(-4)+8\\times9/12\\times{2^3}-24\\times25/10\">12/(-4)+8\\times9/12\\times{2^3}-24\\times25/10</span>.</p>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"12/\\left({-4} \\right) + 8 \\times 9/12 \\times {2^3}-24 \\times 25/10\"></span></p>\n<p>Use PEMDAS.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>Calculate the exponent.</td>\n<td><span data-math=\"12/\\left({-4} \\right) + 8 \\times 9/12 \\times 8-24 \\times 25/10\"></span></td>\n</tr>\n<tr>\n<td>Divide by –4.</td>\n<td><span data-math=\"-3 + 8 \\times 9/12 \\times 8-24 \\times 25/10\"></span></td>\n</tr>\n<tr>\n<td>Multiply by 9.</td>\n<td><span data-math=\"-3 + 72/12 \\times 8-24 \\times 25/10\"></span></td>\n</tr>\n<tr>\n<td>Divide by 12.</td>\n<td><span data-math=\"-3 + 6 \\times 8-24 \\times 25/10\"></span></td>\n</tr>\n<tr>\n<td>Multiply by 8.</td>\n<td><span data-math=\"-3 + 48-24 \\times 25/10\"></span></td>\n</tr>\n<tr>\n<td>Multiply by 25.</td>\n<td><span data-math=\"-3 + 48-600/10\"></span></td>\n</tr>\n<tr>\n<td>Divide by 10.</td>\n<td><span data-math=\"-3 + 48-60\"></span></td>\n</tr>\n<tr>\n<td>Add.</td>\n<td><span data-math=\"45-60\"></span></td>\n</tr>\n<tr>\n<td>Subtract.</td>\n<td><span data-math=\"-15\"></span></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "−15"
    }
   ],
   "community_solutions": []
  }
 ],
