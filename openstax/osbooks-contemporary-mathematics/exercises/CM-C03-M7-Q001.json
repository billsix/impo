   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Determine the remainder when 93 is divided by 12.</p>\n<p>93 ÷ 12 = 7 and a remainder. What is that remainder?</p>\n<p><span data-math=\"12 \\times 7 = 84\"></span></p>\n<p>Subtract 84 from 93.</p>\n<p><span data-math=\"93 – 84 = 9\"></span></p>\n<p>The remainder is 9.</p>\n<p>The remainder is the solution to 93 mod 12.</p>\n<p>93 mod 12 ≡ 9</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "93 = 9 (mod 12)"
    }
   ],
   "community_solutions": []
  },
