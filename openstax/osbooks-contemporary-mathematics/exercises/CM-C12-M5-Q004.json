 "is_vocab": false,
 "stimulus_html": "Use Graphs <i>X</i> and <i>Y</i> to answer each question.\n<figure>\n<img src=\"exercises/media/75369b2968605700.png\" alt=\"Two graphs are labeled graph X and graph Y. Graph X has six vertices: a, b, c, d, e, and f. The vertices a, b, and e are connected by three edges and it resembles a triangle. The vertices, c, d, and f are connected by three edges and it resembles a triangle. These two triangles overlap and the point where they overlap has no vertex. Graph Y is the same as that of graph X. The point where they overlap has a vertex, g.\">\n</figure>",
 "questions": [
  {
   "id": 543320,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which graph does not have an Euler circuit? Explain how you know.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "In an Euler circuit, you can start at a vertex, visit all the other vertices exactly once, and return to the original circuit. This is impossible in Graph X because it is disconnected."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Graph <i>X</i> does not have an Euler circuit because it is disconnected."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 543321,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find an Euler circuit in the other graph.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "In an Euler circuit, you can start at a vertex, visit all the other vertices exactly once, and return to the original circuit. The Euler circuit in Graph Y is <i>a</i> → <i>b</i> → <i>g</i> → <i>d</i> → <i>f</i> → <i>c</i> → <i>g</i> → <i>e</i> → <i>a</i>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<i>a</i> → <i>b</i> → <i>g</i> → <i>d</i> → <i>f</i> → <i>c</i> → <i>g</i> → <i>e</i> → <i>a</i>"
    }
   ],
   "community_solutions": []
  }
 ],
