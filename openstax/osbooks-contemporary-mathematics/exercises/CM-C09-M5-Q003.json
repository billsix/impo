 "questions": [
  {
   "id": 527326,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In July, the average temperature in Madrid is 16.7 °C. The average temperature in Toronto in July is 57.4 °F. Which city has the higher temperature, and by how many degrees Celsius?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Step 1: Convert Toronto’s Fahrenheit temperature to Celsius.</p>\n<p><span data-math=\"C = \\frac{5}{9}\\left( {F - 32} \\right)\"></span></p>\n<p><span data-math=\"C = \\frac{5}{9}\\left( {57.4 - 32} \\right)\"></span></p>\n<p><span data-math=\"C = \\frac{5}{9}\\left( {25.4} \\right)\"></span></p>\n<p>Approximately <span data-math=\"14.1^\\circ {\\rm{C}}\"></span></p>\n<p>Step 2: Subtract the two temperatures.</p>\n<p><span data-math=\"16.7 - 14.1 = 2.6^{\\circ}{\\rm C}\"></span></p>\n<p>Madrid has the higher temperature by approximately <span data-math=\"2.6^{\\circ}{\\rm C}\"></span>.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Since Toronto has a temperature of 14.1 °C, Madrid has the higher temperature by 2.6 °C."
    }
   ],
   "community_solutions": []
  }
 ],
