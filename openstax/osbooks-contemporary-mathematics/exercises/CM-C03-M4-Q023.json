 "questions": [
  {
   "id": 505829,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Danny, a nutritionist, is designing a diet for her client, Callum. Danny determines that Callum’s diet should be 30% protein. If Callum consumes 2,400 calories per day, how many calories of protein should Danny tell Callum to consume?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>30% of 2,400 calories</p>\n<p><span data-math=\"\\frac{{30}}{{100}} \\times 2,400 = 720\"></span></p>\n<p>Callum should consume 720 calories of protein.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "720 calories of protein"
    }
   ],
   "community_solutions": []
  }
 ],
