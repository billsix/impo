 "questions": [
  {
   "id": 532510,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the area of the triangle with a base equal to 4 cm and the height equal to 4 cm.\n<figure>\n<img src=\"exercises/media/51f3d36d15c6766c.png\" alt=\"A triangle with its base marked 4 centimeters and height marked 4 centimeters.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"8\\,\\text{cm}^2\">8\\,\\text{cm}^2</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The area of a triangle is <span data-math=\"A = \\frac{1}{2}bh\"></span>, where <i>b</i> represents the base and <i>h</i> represents the height.</p>\n<p><span data-math=\"A = \\frac{1}{2}bh = \\frac{1}{2}\\left( {{\\rm{4\\ cm}}} \\right)\\left( {{\\rm{4 \\ cm}}} \\right) = {\\rm{ 8\\ c}}{{\\rm{m}}^2}\"></span></p>\n<p>The area is 8 square centimeters.</p>\n"
    }
   ],
   "community_solutions": []
  }
 ],
