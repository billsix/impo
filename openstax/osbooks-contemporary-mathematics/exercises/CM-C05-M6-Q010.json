   "id": 508737,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Solve using the Square Root Property: <span data-math=\"25{p^2} = 49\">25{p^2} = 49</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"25{p^2} = 49\"></span></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"{p^2} = \\frac{{49}}{{25}}\"></span></td>\n<td></td>\n<td>Divide.</td>\n</tr>\n<tr>\n<td><span data-math=\"p = \\pm \\sqrt {\\frac{{49}}{{25}}} \"></span></td>\n<td></td>\n<td>Use the Square Root Property.</td>\n</tr>\n<tr>\n<td><span data-math=\"p = \\pm \\frac{7}{5}\"></span></td>\n<td></td>\n<td>Simplify.</td>\n</tr>\n<tr>\n<td><span data-math=\"p = \\frac{7}{5}\"></span></td>\n<td><span data-math=\"p = - \\frac{7}{5}\"></span></td>\n<td>Rewrite the two solutions.</td>\n</tr>\n</tbody>\n</table>\n<p>Checking is left to you.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"p = \\frac{7}{5}\">p = \\frac{7}{5}</span>, <span data-math=\"p = - \\frac{7}{5}\">p = - \\frac{7}{5}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
