 "questions": [
  {
   "id": 511679,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "For a fundraiser at school, the Robotics Club is selling bags of apples and bunches of bananas during lunch. They will make a profit of $4 per bag of apples and $6 per bunch of bananas. Write an objective function that describes the profit the Robotics Club will make.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Let <i>a</i> = the number of bags of apples.</p>\n<p>Let <i>b</i> = the number of bunches of bananas.</p>\n<p>The profit on apples is $4 per bag and the profit on bananas is $6 per bunch.</p>\n<p>Break the words into components.</p> \n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>The total profit</td>\n<td>is</td>\n<td>$4 times the number of bags of apples</td>\n<td>plus</td>\n<td>$6 times the number of bunches of bananas.</td>\n</tr>\n<tr>\n<td><i>P</i></td>\n<td>=</td>\n<td>4<i>a</i></td>\n<td>+</td>\n<td>6<i>b</i></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"P = 4a + 6b\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "With <span data-math=\"a =\">a = </span> the number of bags of apples sold, and <span data-math=\"b =\">b =</span> the number of bunches of bananas sold, the objective function is <span data-math=\"P = 4a + 6b\">P = 4a + 6b</span>."
    }
   ],
   "community_solutions": []
  }
 ],
