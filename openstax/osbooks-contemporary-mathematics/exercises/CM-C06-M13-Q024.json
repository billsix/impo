 "questions": [
  {
   "id": 517623,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the gross income is $50,000 and there are three deductions of $2,000, $3,000, and $8,000, what is the adjusted gross income?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Add the deductions: 2,000 + 3,000 + 8,000 = 13,000.</p>\n<p>Subtract the legal deductions from the gross income to find the adjustable gross income (AGI).</p>\n<p>50,000 – 13,000 = $37,000</p>\n<p>The AGI is $37,000.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$37,000"
    }
   ],
   "community_solutions": []
  }
 ],
