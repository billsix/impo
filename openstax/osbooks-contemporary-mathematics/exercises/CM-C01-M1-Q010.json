   "stem_html": "Set <span data-math=\"B = \\left\\{ {b,{\\rm{ }}a,{\\rm{ }}k,{\\rm{ }}e} \\right\\}\">B = \\left\\{ {b,{\\rm{ }}a,{\\rm{ }}k,{\\rm{ }}e} \\right\\}</span> and set <span data-math=\"F = \\left\\{ {f,{\\rm{ }}l,{\\rm{ }}a,{\\rm{ }}k,{\\rm{ }}e} \\right\\}\">F = \\left\\{ {f,{\\rm{ }}l,{\\rm{ }}a,{\\rm{ }}k,{\\rm{ }}e} \\right\\}</span>",
   "answers": [],
