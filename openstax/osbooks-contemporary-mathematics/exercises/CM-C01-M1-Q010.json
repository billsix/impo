   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Equal sets have the same elements, without regard to order. Equivalent sets have the same number of elements. These sets are equivalent but not equal because they have the same number of elements (four), but not the same elements. One has a <i>b</i>, while the other has a <i>c</i>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Set <span data-math=\"B\">B</span> is equivalent to set <span data-math=\"C\">C</span>, <span data-math=\"B \\sim C\">B \\sim C</span>"
    }
   ],
