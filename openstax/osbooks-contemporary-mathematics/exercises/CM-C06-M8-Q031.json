 "questions": [
  {
   "id": 518923,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The total interest paid on a loan is $38,519.50. The origination fee was $300 while the processing fee was $250. An additional fee was charged to the borrowers, amounting to another $475. How much was the cost of financing for this loan?\n<br>\n<img src=\"exercises/media/d103ebe19ab671ec.png\" alt=\"A spreadsheet labeled as amortization schedule calculator. The sheet calculates the repayment for the loan amount of $45,000.00 for an interest rate of 13.90 percent annually and the monthly payment is $696.00 over 10 years. The factors include calculations such as month, payment, principal, interest, total, and interest and balance.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The cost of finance is the sum of all interest and any fees paid for the loan. Add that to the interest.</p>\n<p><span data-math=\"{\\text{38,519}}{\\text{.50  +  300  +  250  +  475  =  \\$39,544}}{\\text{.50}}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$39,544.50"
    }
   ],
   "community_solutions": []
  }
 ],
