   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The number of games in a single-elimination tournament with <i>n</i> teams is <i>n</i> – 1.</p>\n<p><i>n</i>: 5 teams</p>\n<p>Number of games: <i>n</i> – 1 = 5 – 1 = 4</p>\n<p>There are 4 games.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "4 games"
    }
