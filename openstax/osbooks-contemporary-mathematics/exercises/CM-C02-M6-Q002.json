    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"p \\to q:\"></span> If Edna Mode makes a new superhero costume, then it will not include a Cape.</p>\n<p><span data-math=\"p:\"></span> Edna Mode makes a new superhero costume.</p>\n<p><span data-math=\"q:\"></span> The costume does not include a cape.</p>\n<p>Negation:</p>\n<p><span data-math=\"\\text{~}q:\"></span> The costume does include a cape.</p>\n<p>The negation of a conditional is the conjunction of <span data-math=\"p\"></span> and not <span data-math=\"q\"></span>.</p>\n<p><span data-math=\"\\text{~}(p \\to q){\\rm{ }} \\equiv \\;p \\wedge \\text{~}q\"></span></p>\n<p>Edna Mode makes a new superhero costume, and the costume does include a cape.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Edna Mode made a new superhero costume, and it includes a cape."
    }
   ],
