 "questions": [
  {
   "id": 545444,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A patient is prescribed 2.5 mg/kg of a drug to be delivered intramuscularly, divided into 2 doses per day. If the drug is available in 5 mg/mL and the patient weighs 52 kg, how many milligrams of the drug should be given per dose?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Find the total amount of medicine needed per day.</p>\n<p><span data-math=\"52{\\rm{\\ }}\\cancel{{{\\rm{kg}}}}\\left( {\\frac{{{\\rm{2}}{\\rm{.5\\ mg}}}}{{1\\cancel{{{\\rm{kg}}}}}}} \\right) = 130{\\rm{\\ mg\\ of\\ medicine\\ per\\ day}}\"></span></p>\n<p>Divide this amount into 2 doses.</p>\n<p><span data-math=\"\\frac{{{\\rm{130\\ mg}}}}{2} = 65{\\rm{\\ mg\\ of\\ medicine\\ per\\ dose}}\"></span></p>\n<p>Find how many milliliters of the drug to administer.</p>\n<p><span data-math=\"65{\\rm{ }}\\cancel{{{\\rm{mg}}}}\\left( {\\frac{{{\\rm{1\\ mL}}}}{{5\\cancel{{{\\rm{mg}}}}}}} \\right) = 13{\\rm{\\ mL }}\"></span></p>\n<p>Administer 13 mL of the medicine per dose.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "13 mL"
    }
   ],
   "community_solutions": []
  }
 ],
