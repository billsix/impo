 "questions": [
  {
   "id": 545386,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The country of Elbonia has three states: Mudston with a population of 866,000; WallaWalla with a population of 626,000; and Dilberta with a population of 256,000. There are 38 seats in the Congress of Elbonia. The apportionment of the seats is determined by Hamilton’s method to be: 19 for Mudston, 14 for WallaWalla, and 5 for Dilberta. A census reveals that the population has grown and the seats must be reapportioned. If Mudston now has 921,000 residents, WallaWalla now has 640,000 residents, and Dilberta now has 260,000 residents, how many seats will each state receive upon reapportionment? How is this an example of the population paradox?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
