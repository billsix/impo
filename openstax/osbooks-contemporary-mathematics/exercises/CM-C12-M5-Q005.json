  {
   "id": 543323,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Create an eulerization  using the fewest duplicate edges possible for Graph <i>Z</i>.\n<figure>\n<figcaption>Graph <i>Z</i></figcaption>\n<img src=\"exercises/media/6798911349eb8bf3.png\" alt=\"Graph Z has four vertices: a, b, c, and d. The edges connect a b, b d, d c, c a, and a d.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "You want to add the fewest possible edges, and you can only duplicate existing edges. The most efficient way to eulerize the graph is to duplicate <i>a-d</i>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<br>\n<img src=\"https://exercises.openstax.org/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBBbmtMIiwiZXhwIjpudWxsLCJwdXIiOiJibG9iX2lkIn19--6f83394ea4f952a51c50af6692a842bc60c99208/CS_Figure_12_05_161b.png\" alt=\"Graph Z has four vertices: a, b, c, and d. The edges connect a b, b d, d c, and c a. A double edge connects a to d.\">\n"
    }
