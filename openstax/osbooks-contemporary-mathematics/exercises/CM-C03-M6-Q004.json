     "solution_type": "summary",
     "content_html": "<p>When using the distributive property, multiplication distributes across addition.</p>\n<p><span data-math=\"a \\times \\left( {b + c} \\right) = \\left( {a \\times b} \\right) + \\left( {a \\times c} \\right)\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "dstributive property"
    }
   ],
   "community_solutions": []
