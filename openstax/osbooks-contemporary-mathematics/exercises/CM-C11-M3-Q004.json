 "questions": [
  {
   "id": 544686,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "By the end of the first U.S. Congress in 1791, there were 13 states, 65 representative seats, and approximately 3,929,214 citizens. Find the standard divisor rounded to the nearest tenth.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The standard divisor is the total population divided by the house size. Divide the population by the 65 representative seats.</p>\n<p><span data-math=\"\\frac{{3,929,214}}{{65}} \\approx 60,449.4\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "60,449.4"
    }
   ],
   "community_solutions": []
  }
 ],
