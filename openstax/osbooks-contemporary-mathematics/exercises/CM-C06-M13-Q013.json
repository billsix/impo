   "id": 517577,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Chloe prepares for her taxes by collecting her W-2 and her 1099-MISC documents. The wages from her regular job were $41,780. She did some freelance work and earned $5,500 from that job. What is Chloe’s gross income?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Add the amounts to find the gross income.</p>\n<p>41,780 + 5,500 = $47,280</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$47,280"
    }
   ],
