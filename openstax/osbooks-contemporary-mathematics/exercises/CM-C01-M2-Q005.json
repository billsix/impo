   "id": 494381,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using natural numbers, multiples of 5 are given by the sequence <span data-math=\"\\{ {\\text{5, 10, 15, }} \\ldots \\} \">\\{ {\\text{5, 10, 15, }} \\ldots \\}</span>. Write this set using set builder notation by associating each multiple of 5 in terms of a natural number, <span data-math=\"n\">n</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Set builder notation uses a letter to represent a sample member of the set, a vertical bar, and then a description of a sample member.</p>\n<p><span data-math=\"\\{m|m = 5n{\\text{ where }}n \\in \\mathbb{N}\\}\"></span></p>"
    },
