 "questions": [
  {
   "id": 533579,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the measure of the missing angle in the given figure.\n<br>\n<img src=\"exercises/media/79c1c40d0cfdda3c.png\" alt=\"A right triangle with its interior angles marked x, 90 degrees, and 23 degrees.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The sum of the angle measures must be 180°. A right angle measures 90°.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"x + 23 + 90 = 180\"></span></td>\n<td>Add.</td>\n</tr>\n<tr>\n<td><span data-math=\"x + 113 = 180\"></span></td>\n<td>Subtract.</td>\n</tr>\n<tr>\n<td><span data-math=\"x = 67\"></span><p></p>\n</td><td></td>\n</tr>\n</tbody>\n</table>\n<p>The angle measures 67°.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"x = {67^ \\circ }\">x = {67^ \\circ }</span>"
    }
   ],
   "community_solutions": []
  }
 ],
