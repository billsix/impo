 "questions": [
  {
   "id": 507545,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which options represent algebraic expressions?\n<br>\n<span data-math=\"2{x^2} + 3x-1 = 0\">2{x^2} + 3x-1 = 0</span><br>\n<span data-math=\"5x + 8\">5x + 8</span>\n<br>\n<span data-math=\"2n + 3m\">2n + 3m </span>\n<br>\n<span data-math=\"5x-7 = 3x + 1\">5x-7 = 3x + 1</span>\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Expressions relate numbers and variables to each other <i>without</i> involving an equal sign. Equations tell you that two quantities are equal. Look for the equal sign to tell you the difference. These are expressions:</p>\n<p><span data-math=\"5x + 8\"></span></p>\n<p><span data-math=\"2n + 3m\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"5x+8\">5x+8</span>, <span data-math=\"2n+3m\">2n+3m</span>"
    }
   ],
   "community_solutions": []
  }
 ],
