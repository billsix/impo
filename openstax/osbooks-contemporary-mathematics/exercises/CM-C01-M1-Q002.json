 "stimulus_html": "<p>For each of the following collections, determine if it represents a well-defined set.</p>",
 "questions": [
  {
   "id": 493901,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A collection of medium-sized potatoes.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A well-defined set clearly communicates whether the element is a member of the set or not. “A collection of medium-sized potatoes” is not well defined. What makes a potato medium-sized?"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "This is not a well-defined set."
    }
   ],
   "community_solutions": []
  },
