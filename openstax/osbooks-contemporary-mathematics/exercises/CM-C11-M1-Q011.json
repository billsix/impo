 "is_vocab": false,
 "stimulus_html": "Suppose there is an election with 26 candidates, A through Z, and that Candidate C is a Condorcet candidate.",
 "questions": [
  {
   "id": 544819,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many points did Candidate C win?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A Condorcet candidate wins every pairwise matchup. Candidate C had to win 25 pairwise matchups with the other letters to be the Condorcet candidate. Thus, Candidate C has 25 points."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Candidate C won 25 points."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544820,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the greatest number of points that any one of the other candidates could win?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The greatest number of points another candidate can earn is 24 points. Another candidate could win 24 matchups with everyone but C."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The greatest number of points another candidate could win is 24 points."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 544821,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Is it possible for Candidate C to lose or tie?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "To meet the qualification to be a Condorcet candidate, you must win every pairing. That excludes the possibility of a tie or a loss."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "No, Candidate C cannot lose or tie."
    }
   ],
   "community_solutions": []
  }
 ],
