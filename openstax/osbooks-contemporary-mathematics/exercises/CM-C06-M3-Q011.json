  {
   "id": 518489,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"FV\">FV</span> = $90,000, <span data-math=\"t\">t</span> = 270 months, annual simple interest rate of 3.75%",
