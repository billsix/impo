  },
  {
   "id": 544521,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<i>o</i> to <i>q</i>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "You cannot find a Hamilton path that starts at <i>o</i> and ends at <i>q</i> since this sequence ends at one end of the bridge <i>nq</i>. The Hamilton path would have to go around the four-cycle subgraph on the left, cross the bridge (<i>nq</i>), and then go round the four-cycle subgraph on the right. Hamilton paths cannot start or end on the vertices that form the bridge. They start on a vertex adjacent to the bridge on one side and end on a vertex adjacent to the bridge on the other side."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "none"
    }
   ],
   "community_solutions": []
  }
