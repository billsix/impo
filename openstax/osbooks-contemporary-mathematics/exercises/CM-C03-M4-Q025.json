     "content_html": "<span data-math=\"25{\\rm{\\; quarts}}\\left({\\frac{{{\\rm{3}}{\\rm{.785\\; liters}}}}{{{\\rm{4\\; quarts}}}}} \\right) \\approx 23.656{\\rm{\\; liters}}\"></span>"
