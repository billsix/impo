   "id": 505837,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "It is known that 4 quarts equals 3.785 liters. If you have 25 quarts, how many liters do you have? Round off to three decimal places.",
   "answers": [],
   "hints": [],
   "formats": [
