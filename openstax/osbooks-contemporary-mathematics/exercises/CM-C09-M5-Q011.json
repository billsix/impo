     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"C = \\frac{{F - 30}}{2}\"></span></p>\n<p><span data-math=\"C = \\frac{{450 - 30}}{2}\"></span></p>\n<p><span data-math=\"C = \\frac{{420}}{2}\"></span></p>\n<p><span data-math=\"210^\\circ {\\rm{C}}\"></span></p>"
    },
