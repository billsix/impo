 "questions": [
  {
   "id": 527482,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At 6 PM, the temperature was 4 °C. By 6 AM the temperature had fallen by 6 °C. What was the temperature at 6 AM?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A fall in the temperature means it is lower. Subtract 6° from 4°C.</p>\n<p><span data-math=\"4 - 6 = -2^{\\circ}{\\rm C}\"></span></p>\n<p>The temperature at 6 AM was −2°C.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "–2 °C"
    }
   ],
   "community_solutions": []
  }
 ],
