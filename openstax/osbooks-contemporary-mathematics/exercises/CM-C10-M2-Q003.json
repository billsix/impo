 "questions": [
  {
   "id": 532814,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the measure of each angle in the illustration.<br>\n<figure>\n<img src=\"exercises/media/8ac898561ad336b2.png\" alt=\"Two lines intersect each other forming a right angle. A ray makes an acute angle, 7 x plus 2 with the horizontal line. Another ray originating from the intersection point of the lines makes an acute angle, 6 x with the vertical line. An acute angle of 9 x is formed by these two rays.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Right angles measure exactly 90°.</p>\n<p><span data-math=\"6x + 9x + 7x + 2 = 90\"></span></p>\n<p><span data-math=\"22x = 88\"></span></p>\n<p><span data-math=\"x = 4\"></span></p>\n<p><span data-math=\"6x = 6\\left( 4 \\right) = 24^\\circ \"></span></p>\n<p><span data-math=\"9x = \\left( 4 \\right) = 36^\\circ \"></span></p>\n<p><span data-math=\"7x + 2 = 7\\left( 4 \\right) + 2 = 28 + 2 = 30^\\circ \"></span></p>\n<p>The angles measure 24°, 36°, and 30°.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"m\\measuredangle (6x) = {24^ \\circ}\">m\\measuredangle (6x) = {24^ \\circ}</span>, <span data-math=\"m\\measuredangle (9x) = {36^ \\circ}\">m\\measuredangle (9x) = {36^ \\circ}</span>, <span data-math=\"m\\measuredangle (7x + 2) = {30^ \\circ}\">m\\measuredangle (7x + 2) = {30^ \\circ}</span>"
    }
   ],
   "community_solutions": []
  }
 ],
