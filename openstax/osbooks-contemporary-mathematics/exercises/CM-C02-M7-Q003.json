 "is_vocab": false,
 "stimulus_html": "<p>Each pair of statements represent true premises in a logical argument. Based on these premises, apply the chain rule for conditional arguments to determine a valid and sound conclusion.</p>",
 "questions": [
  {
   "id": 497355,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If my roommate does not go to work, then my roommate will not get paid. If my roommate does not get paid, then they will not be able to pay their bills.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td colspan=\"3\">The Chain Rule for Conditional Arguments</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"p \\to q\"></span></td>\n<td>If my roommate does not go to work, then my roommate will not get paid.</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"q \\to r\"></span></td>\n<td>If my roommate does not get paid, then they will not be able to pay their bills.</td>\n</tr>\n<tr>\n<td>Conclusion:</td>\n<td><span data-math=\"\\therefore p \\to r\"></span></td>\n<td>If my roommate does not go to work, then they will not be able to pay their bills.</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "If my roommate does not go to work, then they will not be able to pay their bills."
    }
   ],
   "community_solutions": []
