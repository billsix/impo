   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A gasoline storage tank has a volume of 37.854 m<sup>3</sup>. What is the volume of the storage tank in cubic centimeters?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
