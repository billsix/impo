     "images": [],
     "solution_type": "summary",
     "content_html": "<span data-math=\"37.854{\\cancel{{{\\text{meters}}}}^3}{\\left( {\\frac{{100{\\text{ centimeters}}}}{{{\\text{1 }}\\cancel{{{\\text{meter}}}}}}} \\right)^3} = 37.854 \\times 1,000,000{\\text{ c}}{{\\text{m}}^3}\\,{\\text{ = }}\\,37,854,000{\\text{ c}}{{\\text{m}}^3}\"></span>"
