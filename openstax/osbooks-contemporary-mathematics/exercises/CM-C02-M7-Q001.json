 "is_vocab": false,
 "stimulus_html": "<p>Each pair of statements represents the premises in a logical argument. Based on these premises, apply the law of detachment to determine a valid conclusion.</p>",
 "questions": [
  {
   "id": 497343,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If my classmate likes history, then some people like history. My classmate likes history.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td colspan=\"3\">The Law of Detachment</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"p \\to q\"></span></td>\n<td>If my classmates like history, then some people like history.</td>\n</tr>\n<tr>\n<td>Premise:</td>\n<td><span data-math=\"p\"></span></td>\n<td>My classmates like history.</td>\n</tr>\n<tr>\n<td>Conclusion:</td>\n<td><span data-math=\"\\therefore q\"></span></td>\n<td>Some people like history.</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Some people like history."
    }
   ],
   "community_solutions": []
  },
