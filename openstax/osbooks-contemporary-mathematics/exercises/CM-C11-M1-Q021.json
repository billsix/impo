 "questions": [
  {
   "id": 228181,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Explain the differences between two-round voting and ranked-choice voting.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "In two-round voting, only the top two candidates from Round 1 move on to Round 2, and there are only two rounds. In ranked-choice voting, all candidates except those in last place move on to the next round, and there can be many rounds of voting."
    }
   ],
