  {
   "id": 494733,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If set <span data-math=\"A\">A</span> is a subset of set <span data-math=\"B\">B</span>, then <span data-math=\"A\">A</span> intersection <span data-math=\"B\">B</span> is equal to set ___________.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The intersection of two sets includes the elements they have in common. Because <i>A</i> is a subset of <i>B</i>, all the elements of <i>A</i> are also in <i>B</i>. There can be no other elements in <i>B</i> that are in <i>A</i>. Thus, <span data-math=\"A \\cap B = A\"></span>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"A\">A</span>"
    }
   ],
   "community_solutions": []
  }
 ],
