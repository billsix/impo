   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The last two vertices, <i>p</i> and <i>q,</i> are not adjacent. All the vertices in a walk must be adjacent. This is not a walk. If it is not a walk, it can be neither a trail nor a path."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "none of these"
    }
   ],
