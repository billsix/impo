   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>If <i>p</i> percent of the values in a dataset are less than a number <i>n</i>, then we say that <i>n</i> is at the <i>p</i>th percentile.</p>\n<p>First, put the data in increasing order: 1, 2, 4, 5, 6, 8, 8, 12, 15, 16</p>\n<p>There are 10 data values.</p>\n<p>Seven out of the 10 numbers, or 70%, are less than the 8<sup>th</sup> number, 12.</p>\n<p>The value 12 is at the 70<sup>th</sup> percentile.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "70th percentile"
    }
   ],
   "community_solutions": []
  }
