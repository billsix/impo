 "is_vocab": false,
 "stimulus_html": "The CLH credit card company has the following minimum payment policy. For balances over $1,000, the minimum payment is 1% of the balance due plus interest and fees. For balances between $25.00 and $999.99, the minimum payment is $25.00 plus any fees. For balances under $25.00, the minimum payment is the balance due plus any fees.<br>\nIn the following, calculate the minimum payment due given the credit card minimum payment policy, the balance due and fees charged.",
 "questions": [
  {
   "id": 519275,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Balance due is $2,308.00, billing cycle interest is $24.39, no fees",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>For this amount, use 1 percent plus interest plus fees. There are no fees.</p>\n<p><span data-math=\"{\\text{0}}{\\text{.01(2,308)  =  23}}{\\text{.08}}\"></span></p>\n<p>One percent plus interest is: <span data-math=\"{\\text{23}}{\\text{.08  +  24}}{\\text{.39  =  \\$47}}{\\text{.47}}\"></span>.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$47.47"
    }
   ],
   "community_solutions": []
  },
  {
