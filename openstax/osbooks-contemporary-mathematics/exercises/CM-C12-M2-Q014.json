 "questions": [
  {
   "id": 291066,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A student found that the sum of the degrees of the vertices in a graph was 13. Why is that impossible?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The sum of the degrees is always double the number of edges, which means it has to be an even number, but 13 is odd."
    }
   ],
   "community_solutions": []
  }
