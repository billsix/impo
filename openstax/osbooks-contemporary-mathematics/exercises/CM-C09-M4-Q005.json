     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Prefix</td>\n<td>kilo-</td>\n<td>hecto-</td>\n<td>deca-</td>\n<td>base</td>\n<td>deci-</td>\n<td>centi-</td>\n<td>milli-</td>\n</tr>\n<tr>\n<td>Abbreviation</td>\n<td>k</td>\n<td>h</td>\n<td>da</td>\n<td>&nbsp;</td>\n<td>d</td>\n<td>c</td>\n<td>m</td>\n</tr>\n<tr>\n<td>Magnitude</td>\n<td>10<sup>3</sup></td>\n<td>10<sup>2</sup></td>\n<td>10<sup>1</sup></td>\n<td>1</td>\n<td>10<sup>−1</sup></td>\n<td>10<sup>−2</sup></td>\n<td>10<sup>−3</sup></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"4.869\\cancel{{{\\text{kilograms}}}}\\left( {\\frac{{{\\text{1,000 grams}}}}{{{\\text{ 1}}\\cancel{{{\\text{kilogram}}}}}}} \\right) = 4,869{\\text{ grams}}\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "4,869 g"
    }
   ],
