 "questions": [
  {
   "id": 534141,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What polygons make up the figure shown?<br>\n<figure>\n<img src=\"exercises/media/9f644eced4e73927.png\" alt=\"A rectangle is made up of 7 polygons. Polygons 1, 2, 4, and 6 are triangles. Polygon 3 is a pentagon. Polygon 5 is a parallelogram. Polygon 7 is a rectangle.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Shapes 1, 2, 4, and 6 are triangles since they have three sides.</p>\n<p>Shape 3 is a pentagon since it has five sides.</p>\n<p>Shape 5 is a parallelogram. A parallelogram is a quadrilateral with two sets of parallel sides.</p>\n<p>Shape 7 is a rectangle. A rectangle is a parallelogram with four right angles and two sets of parallel sides.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Shapes 1, 2, 4, and 6 are triangles; shape 3 is a pentagon; shape 5 is a parallelogram; and shape 7 is a rectangle. "
    }
   ],
   "community_solutions": []
  }
 ],
