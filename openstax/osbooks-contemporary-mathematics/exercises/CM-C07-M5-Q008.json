     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Nickel</td>\n<td>Quarter</td>\n</tr>\n<tr>\n<td>H</td>\n<td>H</td>\n</tr>\n<tr>\n<td>H</td>\n<td>T</td>\n</tr>\n<tr>\n<td>T</td>\n<td>H</td>\n</tr>\n<tr>\n<td>T</td>\n<td>T</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"P{\\rm{(quarter\\; heads)}} =  P\\left( {{\\rm{HH\\; or\\; HT}}} \\right) = \\frac{2}{4} = \\frac{1}{2}\"></span></p>\n"
