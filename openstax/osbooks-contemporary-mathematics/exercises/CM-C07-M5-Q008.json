     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Nickel</td>\n<td>Quarter</td>\n</tr>\n<tr>\n<td>H</td>\n<td>H</td>\n</tr>\n<tr>\n<td>H</td>\n<td>T</td>\n</tr>\n<tr>\n<td>T</td>\n<td>H</td>\n</tr>\n<tr>\n<td>T</td>\n<td>T</td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"P{\\rm{(both\\; heads)}} =  P\\left( {{\\rm{HH}}} \\right) = \\frac{1}{4}\"></span></p>\n"
    },
    {
