 "questions": [
  {
   "id": 507912,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The conversion formula between the Fahrenheit temperature scale and the Celsius temperature scale is given by this formula: <span data-math=\"C = \\frac{5}{9}\\left( {F-32} \\right)\">C = \\frac{5}{9}\\left( {F-32} \\right)</span>, where <span data-math=\"C\">C</span> is the temperature in degrees Celsius and <span data-math=\"F\">F</span> is the temperature in degrees Fahrenheit. What is the correct formula when solved for <span data-math=\"F\">F</span>?",
   "answers": [
    {
     "id": 995256,
     "content_html": "<span data-math=\"F = \\frac{5}{9}C-32\">F = \\frac{5}{9}C-32</span>",
     "correctness": "0.0"
    },
    {
     "id": 995257,
     "content_html": "<span data-math=\"F = \\frac{9}{5}C-32\">F = \\frac{9}{5}C-32</span>",
     "correctness": "0.0"
    },
    {
     "id": 995258,
     "content_html": "<span data-math=\"F = \\frac{5}{9}C + 32\">F = \\frac{5}{9}C + 32</span>",
     "correctness": "0.0"
    },
    {
     "id": 995259,
     "content_html": "<span data-math=\"F = \\frac{9}{5}C + 32\">F = \\frac{9}{5}C + 32</span>",
     "correctness": "1.0",
     "feedback_html": ""
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"F = \\frac{9}{5}C + 32\">F = \\frac{9}{5}C + 32</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"C = \\frac{5}{9}\\left( {F - 32} \\right)\"></span></td>\n<td>Treat <i>F</i> as the variable and everything else as “constants.”</td>\n</tr>\n<tr>\n<td><span data-math=\"\\left( {\\frac{9}{5}} \\right)C = \\left( {\\frac{9}{5}} \\right)\\frac{5}{9}\\left( {F - 32} \\right)\"></span></td>\n<td>Multiply both sides by <span data-math=\"\\left( {\\frac{9}{5}} \\right)\"></span>.</td>\n</tr>\n<tr>\n<td><span data-math=\"\\left( {\\frac{9}{5}} \\right)C = F - 32\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"\\left( {\\frac{9}{5}} \\right)C + 32 = F - 32 + 32\"></span></td>\n<td>Add 32 to both sides.</td>\n</tr>\n<tr>\n<td><span data-math=\"\\frac{9}{5}C + 32 = F\"></span></td>\n<td>Switch sides to make it look like the answer options.</td>\n</tr>\n<tr>\n<td><span data-math=\"F = \\frac{9}{5}C + 32\"></span></td>\n<td>This is option (d).</td>\n</tr>\n</tbody>\n</table>"
    }
   ],
   "community_solutions": []
  }
 ],
