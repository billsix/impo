 "questions": [
  {
   "id": 528785,
   "is_answer_order_important": false,
   "stimulus_html": "In Your Turn  8.3, you found a frequency distribution for the number of people who shared a residence with people in a sample.\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th>Number of People in the Residence</th>\n<th>Frequency</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>12</td>\n</tr>\n<tr>\n<td>2</td>\n<td>13</td>\n</tr>\n<tr>\n<td>3</td>\n<td>8</td>\n</tr>\n<tr>\n<td>4</td>\n<td>6</td>\n</tr>\n<tr>\n<td>5</td>\n<td>1</td>\n</tr>\n</tbody>\n</table>",
   "stem_html": "What’s the mode of the number of people in these residences?\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The mode is the number that occurs most often. The most frequent number of people is 2, which occurs 13 times. The mode is 2."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<p>2</p>"
    }
   ],
