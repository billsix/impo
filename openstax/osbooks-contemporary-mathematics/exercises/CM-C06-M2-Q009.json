 "stimulus_html": "Determine the cost based on the percent markup and retail price.",
 "questions": [
  {
   "id": 516664,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Percent markup 15%; retail price = $40.25",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>retail price = cost × (1 + percent markup)</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>40.25 = cost × (1 + 0.15)</td>\n<td></td>\n</tr>\n<tr>\n<td>40.25 = cost × (1.15)</td>\n<td>Divide by 1.15.</td>\n</tr>\n<tr>\n<td>$35 = cost</td>\n<td></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$35.00"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 516665,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Percent markup 300%; retail price = $35.96",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>retail price = cost × (1 + percent markup)</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td>35.96 = cost × (1 + 3.00)</td>\n<td></td>\n</tr>\n<tr>\n<td>35.96 = cost × (4)</td>\n<td>Divide by 4.</td>\n</tr>\n<tr>\n<td>$8.99 = cost</td>\n<td></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "$8.99"
    }
