 "is_vocab": false,
 "stimulus_html": "The University Combinatorics Club has 18 members. Four of them will be selected to form a committee.",
 "questions": [
  {
   "id": 515715,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many different committees of 4 are possible, assuming all of the duties are shared equally?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 515716,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Instead of sharing responsibility equally, one person will be chosen to be the committee chair. How many different committees are possible? Count these by selecting a chair first, then selecting the remaining 3 members of the committee from the remaining club members and use the Multiplication Rule for Counting. Show your work.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 515717,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Let’s count the number of committees with chairs a different way: First, choose 4 people for the committee (as in the first question), then choose 1 of the 4 to be chair. Show your work. Do you get the same number?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  }
 ],
