   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Convert 479 into a Roman numeral.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The maximum number of symbols in a row is three.</p>\n<p>Special combinations: IV = 4, IX = 9, XL = 40, XC = 90, CD = 400, CM = 900</p>\n<p>Write the larger symbols first.</p>\n<p>Write 479 as a sum where there is an equivalent Roman numeral or special combination.</p>\n<p>479 = 400 + 50 + 10 + 10 + 9</p>\n<p>Translate to Roman numerals: CDLXXIX</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "CDLXXIX"
    }
   ],
   "community_solutions": []
  }
 ],
