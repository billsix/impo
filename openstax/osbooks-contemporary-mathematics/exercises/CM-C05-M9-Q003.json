 "questions": [
  {
   "id": 511444,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Solve this system of linear equations by graphing.\n<br>\n<span data-math=\"\\left\\{ \\begin{array}{l}\n  x - 3y =  - 3  \\\\\n  {\\,\\,\\,}x + y = 5  \\\\ \n\\end{array}  \\right.\">\\left\\{ \\begin{array}{rcl}\n  x - 3y =  - 3  \\\\\n  x + y = 5  \\\\ \n\\end{array}  \\right.</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Graph the first line by using intercepts: <span data-math=\"\\left( { - 3,0} \\right)\"></span>and <span data-math=\"\\left( {0,1} \\right)\"></span>.</p>\n<p>Graph the second line by using intercepts <span data-math=\"\\left( {5,0} \\right)\"></span> and <span data-math=\"\\left( {0,5} \\right)\"></span>.</p>\n<p>The two lines cross at <span data-math=\"\\left( {3,2} \\right)\"></span>.</p>\n<p>Checking is left to you.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<img src=\"https://exercises.openstax.org/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBBaDBOIiwiZXhwIjpudWxsLCJwdXIiOiJibG9iX2lkIn19--4f0d7ddf1f56e439938add8d594f931d20a1fb22/CS_Figure_05_09_006.png\" alt=\"Two lines are plotted on an x y coordinate plane. The x and y axes range from negative 10 to 10, in increments of 1. The first line passes through the points, (negative 9, negative 2), (negative 3, 0), (0, 1), and (9, 4). The second line passes through the points, (negative 4, 9), (0, 5), (5, 0), and (9, negative 4). The two lines intersect at (3, 2).\">"
    }
   ],
   "community_solutions": []
  }
