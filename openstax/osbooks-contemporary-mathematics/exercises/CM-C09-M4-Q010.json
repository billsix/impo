 "is_vocab": false,
 "stimulus_html": "For the following exercises, determine the most reasonable value for each weight.",
 "questions": [
  {
   "id": 526898,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Candy bar:<br>\n50 kg, 50 g, or 50 mg\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A gram is about the weight of a paper clip. A candy bar weighs about the same as 50 paper clips, so 50 grams is reasonable."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "50 g"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 526899,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Lion:<br>\n180 kg, 180 g, or 180 mg",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A liter of water weighs about the same as one kilogram, so 180 kilograms is reasonable for the lion."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "180 kg"
    }
   ],
   "community_solutions": []
  },
