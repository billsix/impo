 "questions": [
  {
   "id": 527479,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which represents a reasonable temperature for cooking chili:<br>\n<ul>\n<li>240 °C,</li>\n<li>60 °C, or</li>\n<li>6 °C?</li>\n</ul>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The temperature of boiling water is 100°C. While chili is not likely to be that hot, a temperature of 60°C is reasonable for cooking chili."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "60 °C"
    }
   ],
   "community_solutions": []
  }
 ],
