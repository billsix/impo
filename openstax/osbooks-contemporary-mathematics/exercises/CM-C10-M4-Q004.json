   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A regular heptagon has seven sides of equal length. Therefore, the perimeter of a regular heptagon with a side length of 3.2 inches is:</p>\n<p><span data-math=\"P = 7(3.2{\\rm{\\ in) = 22}}{\\rm{.4\\ inches}}\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "22.4 in"
    }
   ],
   "community_solutions": []
  }
