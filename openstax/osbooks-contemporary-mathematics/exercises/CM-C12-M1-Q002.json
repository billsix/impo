 "questions": [
  {
   "id": 542161,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Name all the pairs of vertices of graph <i>A</i> in Your Turn 12.1 that are <i>not</i> adjacent.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Adjacent vertices share a common edge. Vertices that are not adjacent do not share a common edge. Vertices <i>p</i> and <i>s</i> do not share a common edge, and so are not adjacent. Likewise, vertices <i>r</i> and <i>t</i> do not share a common edge and thus are not adjacent."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The pairs that are not adjacent are <i>p</i> and <i>s</i>, and <i>r</i> and <i>t</i>."
    }
   ],
   "community_solutions": []
  }
 ],
