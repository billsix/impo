 "questions": [
  {
   "id": 518457,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Beth is the owner of a small retail store in downtown St. Louis. The windows in the storefront need replacing, so she needs to take out a $9,500 loan to get the repairs done. The rate she secures is 9.25% and the term of the loan is one year. How much interest will she pay and how much total will she repay on the loan?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p><span data-math=\"I = P \\times r \\times t\"></span></p>\n<p><span data-math=\"I = 9,500 \\times 0.0925 \\times 1\"></span></p>\n<p>The interest is $878.75.</p>\n<p>The loan payoff is the sum of the principal and the interest.</p>\n<p><span data-math=\"T = P + I = 9,500 + 878.75 = \\$10,378.75\"></span></p>\n<p>The total repayment is $10,378.75.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "She will pay $878.75 in interest, total repayment is $10,378.75."
    }
   ],
   "community_solutions": []
  }
 ],
