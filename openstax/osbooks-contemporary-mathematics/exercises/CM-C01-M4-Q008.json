   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If <span data-math=\"A \\cap B = \\emptyset ,n(A) = 35,\">A \\cap B = \\emptyset ,n(A) = 35,</span> and <span data-math=\"n(B) = 78,\">n(B) = 78,</span> then find <span data-math=\"n(A \\cup B)\">n(A \\cup B)</span>.",
   "answers": [],
   "hints": [],
