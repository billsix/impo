   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"\\left\\{ {\\begin{array}{*{20}{c}}\n{x - 5y > 10}\\\\\n{2x + 3y >  - 2}\n\\end{array}} \\right.\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"x - 5y > 10\"></span></td>\n<td>Substitute in the first inequality.</td>\n</tr>\n<tr>\n<td><span data-math=\"3 - 5\\left( { - 1} \\right) > 10\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><span data-math=\"3 + 6 > 10\"></span></td>\n<td>Simplify.</td>\n</tr>\n<tr>\n<td><span data-math=\"9 > 10\"></span></td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>This is not true. This is not a solution to the system.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "not a solution"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 513205,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"(6, −3)\">(6, −3)</span>",
   "answers": [],
