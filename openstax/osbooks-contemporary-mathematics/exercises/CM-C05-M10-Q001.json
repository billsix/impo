 "stimulus_html": "Determine whether the ordered pair is a solution to the system:\n<br>\n<span data-math=\"\\left\\{ \\begin{gathered}\n  x - 5y > 10 \\hfill \\\\\n  2x + 3y > - 2 \\hfill \\\\ \n\\end{gathered} \\right.\">\\left\\{ \\begin{gathered}\n  x - 5y &gt; 10 \\hfill \\\\\n  2x + 3y &gt;  - 2 \\hfill \\\\ \n\\end{gathered}  \\right.</span>",
 "questions": [
  {
   "id": 513204,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"(3, −1)\">(3, −1)</span>",
   "answers": [],
