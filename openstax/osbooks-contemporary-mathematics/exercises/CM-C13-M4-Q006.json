   "id": 545550,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the difference between frequency and pitch of a note?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Frequency is a measurable, static quantity. Pitch is subjective. They are related. The higher the frequency, the higher the perceived pitch."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Frequency is a static measured value, whereas pitch is subjective."
    }
   ],
   "community_solutions": []
  }
