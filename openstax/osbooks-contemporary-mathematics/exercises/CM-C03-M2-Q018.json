 "questions": [
  {
   "id": 504875,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify which of the following numbers are integers:\n<p>−4, 15.2, <span data-math=\"\\sqrt 2\">\\sqrt 2</span>, <span data-math=\"\\frac{3}{{20}}\">\\frac{3}{{20}}</span>, 430</p>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>–4 is an integer because it is the negative of a counting number.</p>\n<p>15.2 is not an integer as it has a decimal part. It is between two integers, 15 and 16.</p>\n<p>The square root of 2 is not an integer. It is approximately 1.414, which is between two integers, 1 and 2.</p>\n<p>The fraction 3 divided by 20 is not an integer. It is equal to 0.15, which is between two integers, 1 and 2.</p>\n<p>430 is an integer. It is a counting number.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "−4, 430"
    }
   ],
   "community_solutions": []
  }
 ],
