 "questions": [
  {
   "id": 532538,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You have a kite that measures <span data-math=\"500\\,{\\text{i}}{{\\text{n}}^2}.\">500\\,{\\text{i}}{{\\text{n}}^2}</span> If one of the diagonals measures 25 in, what is the length of the other diagonal?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>A kite is a rhombus. The area of a rhombus with diagonals <span data-math=\"{d_1}\"></span> and <span data-math=\"{d_2}\"></span> is <span data-math=\"A = \\frac{{{d_1}{d_2}}}{2}\"></span>.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"500 = \\frac{{25{d_2}}}{2}\"></span></td>\n<td>Simplify the right side.</td>\n</tr>\n<tr>\n<td><span data-math=\"500 = 12.5{d_2}\"></span></td>\n<td>Divide both sides.</td>\n</tr>\n<tr>\n<td><span data-math=\"40 = {d_2}\"></span></td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p>The measure of <span data-math=\"{d_2}\"></span> is 40 inches.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "40 in"
    }
   ],
   "community_solutions": []
  }
 ],
