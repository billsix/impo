   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Calculate <span data-math=\"(7.4 \\times {10^4}) \\times (4.8 \\times {10^3})\">(7.4 \\times {10^4}) \\times (4.8 \\times {10^3})</span>.",
   "answers": [],
