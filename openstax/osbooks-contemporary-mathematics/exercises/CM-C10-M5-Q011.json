   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Starting with a triangle with a darker face and a lighter back, describe how this pattern came about.<br>\n\n<img src=\"exercises/media/10c1c1c4c035675a.png\" alt=\"A figure made up of six triangles. The first two and last two triangles are red. The remaining two triangles are lavender. The triangles are arranged in two rows. The triangles in the top row are inverted.\">\n",
   "answers": [],
