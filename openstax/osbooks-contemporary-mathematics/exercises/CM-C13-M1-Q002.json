 "questions": [
  {
   "id": 545793,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If a circular row on a pinecone contains 21 scales and models the Fibonacci sequence, approximately how many scales would be found on the next circular row?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>In the Fibonacci sequence, each number is the sum of the two previous numbers.</p>\n<p>1, 1, 2, 3, 5, 8, 13, 21, …</p>\n<p>The next number in the sequence is 13 + 21 = 34 scales.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "34 scales"
    }
   ],
   "community_solutions": []
  }
 ],
