 "is_vocab": false,
 "stimulus_html": "For the following exercises, use this line.<br>\n<figure>\n<img src=\"exercises/media/b408b72b7fdfdcda.png\" alt=\"A line with four points, A, B, C, and D marked on it.\">\n</figure>",
 "questions": [
  {
   "id": 532709,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Define <span data-math=\"\\overrightarrow {BD}\">\\overrightarrow {BD}</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The letters BD, with an arrow pointing from B towards D, represent a ray that starts at B and extends infinitely in the direction of point D."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\overrightarrow {BD}\">\\overrightarrow {BD}</span> is the ray that starts at point <span data-math=\"B\">B</span> and extends infinitely in the direction of point <span data-math=\"D\">D</span>.\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 532710,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Define <span data-math=\"\\overline {AB}\">\\overline {AB}</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The letters AB, with a straight line above, represent a line segment that starts at point A and ends at point B."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\overline {AB}\">\\overline {AB}</span> represents the line segment that starts at point <span data-math=\"A\">A</span> and ends at point <span data-math=\"B\">B</span>."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 532711,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"\\overleftarrow {BA}\">\\overleftarrow {BA}</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The letters BA, with an arrow pointing from A towards B, represent a ray that starts at A and extends infinitely in the direction of point B."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\overleftarrow {BA}\">\\overleftarrow {BA}</span> represents the ray that starts at point <span data-math=\"A\">A</span> and extends infinitely in the direction of point <span data-math=\"B\">B</span>."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 532712,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span data-math=\"\\overleftrightarrow {AD}\">\\overleftrightarrow {AD}</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The letters AD, with a double arrow above, represent a line that contains the points A and D. The line extends infinitely in both directions."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\overleftrightarrow {AD}\">\\overleftrightarrow {AD}</span> represents a line that contains the points <span data-math=\"A\">A</span> and <span data-math=\"D\">D</span>. Notice the arrowheads on both ends of the line above <span data-math=\"\\mathit{AD}\">AD</span>, which means that the line continues infinitely in both directions."
    }
   ],
   "community_solutions": []
  }
 ],
