   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In base 18, what would the place value of the 4 be in the number 348<sub>18</sub> be?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Since the 4 is the second digit, its place value is 18<sup>1</sup> times 4, or 72."
    }
   ],
