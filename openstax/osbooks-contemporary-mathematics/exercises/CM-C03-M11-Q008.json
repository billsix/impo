   "id": 506191,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the common ratio of the geometric sequence {3, −30, 300, −3,000, …}.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>To find the common ratio, divide a term by the previous term.</p>\n<p><span data-math=\"\\frac{{ - 30}}{3} =  - 10\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The common ratio is −10."
    }
   ],
   "community_solutions": []
  }
