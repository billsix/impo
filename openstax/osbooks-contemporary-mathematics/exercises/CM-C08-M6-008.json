 "questions": [
  {
   "id": 529863,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose you have a normally distributed dataset with mean 2 and standard deviation 20. Convert these standardized scores to data values: –2.3, 1.4, and 0.2.\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>If <i>x</i> is a member of a normally distributed dataset with mean µ and standard deviation σ, then you know a <i>z</i>-score, <span data-math=\"x = \\mu + z \\times \\sigma \"></span>.</p>\n<p><span data-math=\"x = \\mu + z \\times \\sigma = 2 + \\left( { - 2.3} \\right)\\left( {20} \\right) = 2 - 46 = - 44\"></span></p>\n<p><span data-math=\"x = \\mu + z \\times \\sigma = 2 + \\left( {1.4} \\right)\\left( {20} \\right) = 2 + 28 = 30\"></span></p>\n<p><span data-math=\"x = \\mu + z \\times \\sigma = 2 + \\left( {0.2} \\right)\\left( {20} \\right) = 2 + 4 = 6\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "–44<br>\n30<br>\n6"
    }
   ],
   "community_solutions": []
  }
 ],
