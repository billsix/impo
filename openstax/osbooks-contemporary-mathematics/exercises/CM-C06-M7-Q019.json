 "questions": [
  {
   "id": 518603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How much in earnings does a 10-year bond with issue price $5,000 that pays 4% interest annually is generated?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Use your knowledge of percents. Remember to convert the percentage to a decimal.</p>\n<p><span data-math=\"part = percent \\times total\"></span></p>\n<p><span data-math=\"part = \\left( {0.04} \\right)\\left( {5,000} \\right){\\text{  =  \\$200}}\"></span></p>\n<p>Each year, they receive $200 for 10 years.</p>\n<p>Over the 10 years, they receive <span data-math=\"{\\text{10(200)  =  \\$2,000}}\"></span> in total.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Each year, the holder of the bond receives $200. For 10 years, that’s $2,000 total earned with the bond."
    }
   ],
   "community_solutions": []
  }
 ],
