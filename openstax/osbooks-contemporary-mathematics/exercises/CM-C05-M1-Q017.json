 "questions": [
  {
   "id": 507659,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the expression <span data-math=\"9{x^3} + 3{x^2}-6x\">9{x^3} + 3{x^2}-6x</span>, the Distributive Property allows it to be rewritten as:<br>\n<span data-math=\"3x\\left( {3{x^2} + x-2} \\right)\"> 3x\\left( {3{x^2} + x-2} \\right)</span>\n<br>\n<span data-math=\"{3{x^2} + x-2}\">{3{x^2} + x-2}</span>\n<br>\n<span data-math=\"{27{x^5}-54{x^4}}\">{27{x^5}-54{x^4}}</span>\n<br>\n<span data-math=\"{27{x^6}-54{x^3}}\">{27{x^6}-54{x^3}}</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"3x\\left( {3{x^2} + x-2} \\right)\">3x\\left( {3{x^2} + x-2} \\right)</span>"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Using the distributive property “in reverse” you can factor out 3<i>x.</i></p><i>\n</i><p><i></i><span data-math=\"9{x^3} + 3{x^2} - 6x = 3x\\left( {3{x^2} + x - 2} \\right)\"></span></p>"
    }
   ],
   "community_solutions": []
  }
 ],
