   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the area of this parallelogram.\n<br>\n<img src=\"exercises/media/3cf5005edbdeafcb.png\" alt=\"A parallelogram with its base marked 14 centimeters and height marked 12 centimeters.\">\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The area of a parallelogram with base <i>b</i> and height <i>h</i> is <span data-math=\"A = bh\"></span>.</p>\n<p><span data-math=\"A = bh = \\left( {{\\text{14 cm}}} \\right)\\left( {{\\text{12 cm}}} \\right) = 168{\\text{ c}}{{\\text{m}}^2}\"></span></p>\n<p>The area of the parallelogram is 168 square centimeters.</p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"168\\,{\\text{c}}{\\text{m}^2}\">168\\,{\\text{c}}{\\text{m}^2}</span>"
    }
   ],
