   "id": 507007,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In an arithmetic sequence, the first term is 10 and the constant difference is 4.5. What is the 135th term?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>You can find any term by using the formula: <span data-math=\"{a_i} = {a_1} + d \\times \\left({i - 1} \\right)\"></span>.</p>\n<p><span data-math=\"{a_{135}} = 10 + 4.5 \\times \\left({135 - 1} \\right) = 10 + 4.5(134) = 10 + 603 = 613\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "613"
    }
   ],
   "community_solutions": []
  }
 ],
