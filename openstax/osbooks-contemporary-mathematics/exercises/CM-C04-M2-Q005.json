   "stimulus_html": "",
   "stem_html": "Convert the Mayan number into a Hindu-Arabic number.<br>\n<img src=\"exercises/media/d83dbfd4c41789e3.png\" alt=\"Mayan numeral 15 is displayed.\"><br> <img src=\"exercises/media/4a4a0aa8741e80e6.png\" alt=\"Mayan numeral 2 is displayed.\"><br> <img src=\"exercises/media/aec9a3bb8cb0d5ba.png\" alt=\"Mayan numeral 14 is displayed.\"> ",
