     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The top symbol represents 15.</p>\n<p>The next symbol represents 2.</p>\n<p>The next symbol represents 14.</p>\n<p>15 × 20<sup>2</sup> + 2 × 20 + 14 = 6,054</p>"
    },
    {
