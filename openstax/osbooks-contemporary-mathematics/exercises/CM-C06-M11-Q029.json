 "stimulus_html": "Calculate the lease payments for car with the following price, residual price, length of lease, and money factor or APR.",
 "questions": [
  {
   "id": 519462,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Price is $38,750, residual price is $18,140.16, 36-month lease, money factor is 0.000035.",
   "answers": [],
   "hints": [],
