   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using prime factorization, determine the greatest common divisor of 120 and 200.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>Number</td>\n<td colspan=\"6\">Factors</td>\n</tr>\n<tr>\n<td>120</td>\n<td>2</td>\n<td>2</td>\n<td>2</td>\n<td>3</td>\n<td>5</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>200</td>\n<td>2</td>\n<td>2</td>\n<td>2</td>\n<td></td>\n<td>5</td>\n<td>5</td>\n</tr>\n<tr>\n<td>Common</td>\n<td>2</td>\n<td>2</td>\n<td>2</td>\n<td>&nbsp;</td>\n<td>5</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>\nGreatest common divisor is the product of the common factors: <span data-math=\"2 \\times 2 \\times 2 \\times 5 = 40\"></span>"
