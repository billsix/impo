 "questions": [
  {
   "id": 511698,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose William has a second factory that can make widgets in 20 minutes and wadgets in 28 minutes. Write an objective function that describes the time it takes to make the products.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Let <i>x</i> = the number of widgets.</p>\n<p>Let <i>y</i> = the number of wadgets</p>\n<p>It takes 20 minutes to make a widget and 28 minutes to make a wadget.</p>\n<p>Break the words into components.</p> \n<table class=\"unnumbered\">\n<tbody>\n<tr>\n<td>The total time</td>\n<td>is</td>\n<td>the time to make widgets</td>\n<td>plus</td>\n<td>the time to make wadgets</td>\n</tr>\n<tr>\n<td><i>T</i></td>\n<td>=</td>\n<td>20<i>x</i></td>\n<td>+</td>\n<td>28<i>y</i></td>\n</tr>\n</tbody>\n</table>\n<p><span data-math=\"T = 20x + 28y\"></span></p>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"T = 20x + 28y\">T = 20x + 28y</span>"
    }
   ],
   "community_solutions": []
  }
 ],
