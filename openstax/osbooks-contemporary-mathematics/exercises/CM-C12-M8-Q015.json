   "id": 544543,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If an edge <i>ab</i> is a bridge with at least three components on each side, then there is no Hamilton path between vertex <i>a</i> and any vertex on the other side of edge <i>ab</i>.",
   "answers": [
    {
     "id": 1069979,
     "content_html": "True",
     "correctness": "1.0"
    },
    {
     "id": 1069980,
