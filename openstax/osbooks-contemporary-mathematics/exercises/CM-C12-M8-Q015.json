   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A Hamilton path could be done, but not one beginning and ending at the ends of the bridge. If a bridge exists, it must be avoided until it is the last choice."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "True"
    }
