   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The number of distinct Hamilton cycles in a complete graph with <i>n</i> vertices is (<i>n</i> – 1)!.</p>\n<p>This graph has six vertices, so it has (6 – 1)! distinct Hamilton cycles.</p>\n<p><span data-math=\"\\left( {6 - 1} \\right)! = 5! = 5 \\cdot 4 \\cdot 3 \\cdot 2 \\cdot 1 = 120\"></span></p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "120"
    }
   ],
   "community_solutions": []
  }
 ],
