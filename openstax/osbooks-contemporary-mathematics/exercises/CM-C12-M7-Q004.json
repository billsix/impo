   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many Hamilton cycles are in the graph?\n<figure>\n<figcaption>Complete Graph <i>R</i></figcaption>\n<img src=\"exercises/media/d40a6172f89c3878.png\" alt=\"Graph R has six vertices: s, t, x, u, w, and v. All vertices are interconnected.\">\n</figure>",
   "answers": [],
