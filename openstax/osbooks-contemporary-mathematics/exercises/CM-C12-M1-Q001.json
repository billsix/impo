 "questions": [
  {
   "id": 370853,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Name all the vertices and edges of Graph <i>A</i>.\n<figure>\n<figcaption>Graph <i>A</i></figcaption>\n<img src=\"exercises/media/b5c633bc22542217.png\" alt=\"A graph labeled graph A. The graph has five vertices, p, q, r, s, and t. Edges connect p with q, r, and t. Edges connect r with q and s. Edges connect s with q and t. An edge connects q with t.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "On a graph the objects are represented with dots and their connects are represented with lines. The dots are the vertices. The vertices are <i>p</i>, <i>q</i>, <i>r</i>, <i>s</i>, and <i>t</i>. The line segments joining the vertices are called edges. The edges are <i>pq</i>, <i>pr</i>, <i>pt</i>, <i>qr</i>, <i>qs</i>, <i>qt</i>, <i>rs</i>, and <i>st</i>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The vertices are <i>p</i>, <i>q</i>, <i>r</i>, <i>s</i>, and <i>t</i>. The edges are <i>pq</i>, <i>pr</i>, <i>pt</i>, <i>qr</i>, <i>qs</i>, <i>qt</i>, <i>rs</i>, and <i>st</i>."
    }
