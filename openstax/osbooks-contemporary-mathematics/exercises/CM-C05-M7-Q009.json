     "solution_type": "detailed",
     "content_html": "The domain is the set of all <span data-math=\"x\">x</span>-values of the relation: <span data-math=\"\\left\\{ {-3,-2,-1,0,2,4} \\right\\}\">\\left\\{ {-3,-2,-1,0,2,4} \\right\\}</span>."
    }
   ],
   "community_solutions": []
