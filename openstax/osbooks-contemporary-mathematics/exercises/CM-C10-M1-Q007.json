 "is_vocab": false,
 "stimulus_html": "Use the graph for the following exercises.\n<br>\n<img src=\"exercises/media/d251cf1fa8d3c8ce.png\" alt=\"A line, a ray, and a line segment are graphed on an x y coordinate plane. The x and y axes range from negative 6 to 6, in increments of 1. The line segment, A D begins at A (3, 5) and D (negative 4, 2). The ray, EF passes through the points, E (0.5, negative 5) and F (4, negative 4). The line, C B passes through the points, C (negative 2, negative 2) and B (3, negative 2).\">\n\n\n",
 "questions": [
  {
   "id": 532734,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify the type of line containing point <span data-math=\"D\">D</span> and point <span data-math=\"A\">A</span>. ",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The line containing point <span data-math=\"D\">D</span> and point <span data-math=\"A\">A</span> is a line segment from point <span data-math=\"D\">D</span> to point <span data-math=\"A\">A</span>, <span data-math=\"\\overline{DA} \">\\overline {DA} </span>, or from point <span data-math=\"A\">A</span> to point <span data-math=\"D\">D</span>, <span data-math=\"\\overline {AD} \">\\overline {AD} </span>."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 532735,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify the type of line containing points <span data-math=\"C\">C</span> and <span data-math=\"B\">B</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The line containing points C and B is <span data-math=\"\\overleftrightarrow {CB}\"></span>, or you could label it <span data-math=\"\\overleftrightarrow {BC}\"></span>."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The line containing points <span data-math=\"C\">C</span> and <span data-math=\"B\">B</span> is a straight line that extends infinitely in both directions and contains points <span data-math=\"C\">C</span> and <span data-math=\"B\">B</span>."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 532736,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify the type of line that references point <span data-math=\"E\">E</span> and contains point <span data-math=\"F\">F</span>.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "This is a ray that begins at point <span data-math=\"E\">E</span>, although it does not contain point <span data-math=\"E\">E</span>, and extends in the direction of point <span data-math=\"F\">F</span>."
    }
   ],
   "community_solutions": []
  }
