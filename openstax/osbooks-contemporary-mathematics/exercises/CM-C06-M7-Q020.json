   "id": 518607,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If an individual makes $115,000 annually, is the person eligible for a Roth IRA?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Yes. The limit changes each year. In 2022, a single person’s modified adjusted gross income must be below $129,000 to be eligible for a Roth IRA to be able to make a maximum contribution. This person’s income is below that limit."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes"
    }
   ],
   "community_solutions": []
  }
 ],
