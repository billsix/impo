 "questions": [
  {
   "id": 542181,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If vertex <i>a</i> is adjacent to vertex <i>b</i>, and vertex <i>b</i> is adjacent to vertex <i>c</i>, then vertex <i>a</i> must be adjacent to vertex <i>c</i>.\n",
   "answers": [
    {
     "id": 1066929,
     "content_html": "True",
     "correctness": "0.0"
    },
    {
     "id": 1066930,
     "content_html": "False",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "It could be adjacent, but it does not have to be. Picture the numbers 1, 2, and 3 on a ruler as being vertices. Draw an edge between 1 and 2. Draw another edge between 2 and 3. The numbers 1 and 2 are adjacent. The numbers 2 and 3 are adjacent. But the numbers 1 and 3 are not adjacent."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "False"
    }
   ],
   "community_solutions": []
  }
