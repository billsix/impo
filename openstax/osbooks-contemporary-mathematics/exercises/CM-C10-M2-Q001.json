 "questions": [
  {
   "id": 532798,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Determine which angles are acute, obtuse, right, and straight in the graph.\n<br>\n<figure>\n<img src=\"exercises/media/0cf980c58766a3ac.png\" alt=\"Seven rays are graphed on a squared grid. All the rays originate from the same point, O. The rays, O F and O A are horizontal. The ray, O D is vertical. The ray, O E makes an acute angle with O F. The ray, O E makes an acute angle with O D. The ray, O C makes an acute angle with O D. The ray, O B makes an acute angle with O C. The rays, O B, and O A make an acute angle. The seventh ray is perpendicular to O F and O A.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>Acute angles have a measure between 0° and 90°, not including 90°.</p>\n<p>Acute angles: ∠AOB, ∠AOC, ∠BOC, ∠BOD, ∠COD, ∠DOE, ∠FOE</p>\n<p>Obtuse angles have a measure between 90° and 180°, not inclusively.</p>\n<p>Obtuse angles: ∠AOE, ∠BOF, ∠COF</p>\n<p>Right angles measure exactly 90°.</p>\n<p>Right angles: ∠AOD, ∠BOE, ∠DOF</p>\n<p>Straight angles measure exactly 180°.</p>\n<p>Straight angles: ∠AOF</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<table class=\"unnumbered\" summary=\".\">\n<thead>\n<tr>\n<th>Acute Angles</th>\n<th>Obtuse Angles</th>\n<th>Right Angles</th>\n<th>Straight Angles</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span data-math=\"\\angle AOB\">\\angle AOB</span><br>\n<span data-math=\"\\angle AOC\">\\angle AOC</span><br>\n<span data-math=\"\\angle BOC\">\\angle BOC</span><br>\n<span data-math=\"\\angle BOD\">\\angle BOD</span><br>\n<span data-math=\"\\angle COD\">\\angle COD</span><br>\n<span data-math=\"\\angle DOE\">\\angle DOE</span><br>\n<span data-math=\"\\angle FOE\">\\angle FOE</span></td>\n<td><span data-math=\"\\angle AOE\">\\angle AOE</span><br>\n<span data-math=\"\\angle BOF\">\\angle BOF</span><br>\n<span data-math=\"\\angle COF \">\\angle COF </span>\n</td>\n<td><span data-math=\"\\angle AOD\">\\angle AOD</span><br>\n<span data-math=\"\\angle BOE\">\\angle BOE</span><br>\n<span data-math=\"\\angle DOF \">\\angle DOF </span>\n</td>\n<td><span data-math=\"\\angle AOF\">\\angle AOF</span></td>\n</tr>\n</tbody>\n</table>"
    }
   ],
