   "id": 534307,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the radius of a circle with a circumference of  <span data-math=\"15.71\\,\\text{cm.}\">15.71\\,\\text{cm.}</span>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>The circumference of a circle is <span data-math=\"C = 2\\pi r\"></span> where <i>r</i> is the radius.</p>\n<table class=\"unnumbered unstyled\">\n<tbody>\n<tr>\n<td><span data-math=\"15.71{\\rm{\\ cm}} = 2\\pi r\"></span></td>\n<td>Divide to find the radius.</td>\n</tr>\n<tr>\n<td><span data-math=\"\\frac{{15.71{\\rm{\\ cm}}}}{{2\\pi }} = r\"></span></td>\n<td></td>\n</tr>\n<tr>\n<td><i>r</i> ≈ 2.5 cm</td>\n<td></td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"r = 2.5\\,\\text{cm}\">r = 2.5\\,\\text{cm}</span>"
    }
   ],
   "community_solutions": []
  }
