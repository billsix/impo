 "stimulus_html": "An ice-cream parlor sells 26 different flavors of ice cream. A basic sundae has one scoop of any flavor of ice cream, your choice of one of 3 sauces, and any one of 8 different toppings. ",
 "questions": [
  {
   "id": 515444,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many different basic sundaes are possible?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 515445,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The ice-cream parlor also sells a medium sundae. The options are the same except it starts with 2 scoops of ice cream, which can be the same flavor or different flavors. How many different medium sundaes are there?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 515446,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The ice-cream parlor also sells a large sundae. The choice of a large sundae allows you to choose any 3 scoops of ice cream, any 2 sauces (they can be the same, or you can choose 2 different ones), and any 3 toppings (that might be 3 servings of the same topping, or 2 servings of one topping and a single serving of another, or 3 different toppings). How many different large sundaes are possible?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  }
 ],
