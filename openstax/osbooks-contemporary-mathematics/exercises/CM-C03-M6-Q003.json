 "questions": [
  {
   "id": 505073,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Place the following numbers correctly into the Venn diagram.<br>\n<span data-math=\"\\quad  -4 \\quad  13.863\\quad 15\\quad 871\\quad 5\\sqrt{7}\\quad \\text{−3}\\pi\">\\quad  - 4\\sqrt 2 \\quad  - 10\\quad \\frac{{37}}{{150}}\\quad 41\\quad \\frac{1}{{20}}\\quad 4\\pi</span>\n<figure>\n<img src=\"exercises/media/674363424102a1f8.png\" alt=\"A Venn diagram shows four concentric ovals. The ovals are labeled from inner to outer as follows: N, Z, Q, and R.\">\n</figure>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "<p>–4 belongs in the <i>Z</i> area as it is an integer.</p>\n<p>13.863 belongs in the <i>Q</i> area as it is a rational number. Terminating decimals can be written as the ratio of two integers.</p>\n<p>15 and 871 belong in the <i>N</i> area as they are natural numbers.</p>\n<p><span data-math=\" - 3\\pi \"></span> and <span data-math=\"5\\sqrt 2 \"></span> belong in the <i>R</i> area as they are real numbers. They are irrational and belong in none of the other areas.</p>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<figure><figcaption>Venn diagram showing ‒4, 13.863, 15, 871, <span data-math=\"5\\sqrt 2\"> 5\\sqrt 2</span>, and  <span data-math=\"-3\\pi\">-3\\pi</span></figcaption><p></p>\n<img src=\"https://exercises.openstax.org/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBBdmtJIiwiZXhwIjpudWxsLCJwdXIiOiJibG9iX2lkIn19--820616e210d9c92e6829b21d880f1cd889b94a14/CS_Figure_03_06_009.jpg\" alt=\"A Venn diagram shows four concentric ovals. The ovals are labeled from inner to outer as follows: N, Z, Q, and R. The oval, N reads, 15 and 871. The oval, Z reads, negative 4. The oval, Q reads, 13.863. The oval, R reads, 5 times square root of 2 and negative 3 pi.\"></figure>"
    }
   ],
   "community_solutions": []
  }
