 "stimulus_html": "<p>For questions 1 – 2, use the following scenario:</p>\n<blockquote>\n  <p>A runner is training for a marathon. She runs more than 4 days each week. Each day,&nbsp;she runs between 12 and 15 miles. The marathon is 3 months away at the most.</p>\n</blockquote>",
 "questions": [
  {
   "id": 646206,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li>What does the inequality <span data-math=\"d > 4\">d &gt; 4</span> represent?</li>\n</ol>",
   "answers": [
    {
     "id": 1271938,
     "content_html": "the number of days the runner runs each week"
    },
    {
     "id": 1271939,
     "content_html": "the number of months away the marathon is"
    },
    {
     "id": 1271940,
     "content_html": "the number of miles the runner runs each day"
    },
    {
     "id": 1271941,
     "content_html": "the number of miles in a marathon"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
