 "questions": [
  {
   "id": 631763,
   "is_answer_order_important": false,
   "stem_html": "<p>The graph below shows the number of customers, <span data-math=\"C\">C</span>, in a restaurant <span data-math=\"x\">x</span> hours after 8 a.m.</p>\n<p>What does <span data-math=\"C(14)\">C(14)</span> equal, and what does it mean?</p>\n<p><img alt=\"A GRAPHED FUNCTION, WHERE NUMBER OF CUSTOMERS IS A FUNCTION OF THE NUMBER OF HOURS AFTER 8 AM. THE GRAPH INCREASES, DECREASES, INCREASES, AND THEN DECREASES AGAIN.\" src=\"exercises/media/2d7eba0b2bf8fd1f.jpg\" width=\"300\"></p>",
   "answers": [
    {
     "id": 1222660,
     "content_html": "<span data-math=\"C(14)=0\">C(14)=0</span> means there have not been any customers over 14 hours."
    },
    {
     "id": 1222661,
     "content_html": "<span data-math=\"C(14)=0\">C(14)=0</span> and means there are 14 customers at 8 a.m."
    },
    {
     "id": 1222663,
     "content_html": "<span data-math=\"C(14)=0\">C(14)=0</span> and is when the restaurant closes and has no more customers around 10 p.m."
    },
    {
     "id": 1222662,
     "content_html": "<span data-math=\"C(14)=0.5\">C(14)=0.5</span> and means there are 14 customers around 8:30."
    }
   ],
