 "questions": [
  {
   "id": 631701,
   "is_answer_order_important": false,
   "stem_html": "<p><span lang=\"EN\">Which of the following is true of the following system of equations?</span></p>\n<p><span data-math=\"\\begin{array}{rcl}&amp;&amp;\\left\\{\\begin{array}{l}7x\\;+\\;6y\\;=\\;2\\\\–28x\\;–\\;24y\\;=\\;–8\\end{array}\\right.\\end{array}\">\\begin{array}{rcl}&amp;&amp;\\left\\{\\begin{array}{l}7x\\;+\\;6y\\;=\\;2\\\\–28x\\;–\\;24y\\;=\\;–8\\end{array}\\right.\\end{array}</span><br></p>",
   "answers": [
    {
     "id": 1222415,
     "content_html": "<span lang=\"EN\">If you write both equations in slope-intercept form, they have the same slope.</span>"
    },
    {
     "id": 1222412,
     "content_html": "<span lang=\"EN\">equations in slope-intercept form, they have different <span data-math=\"y\">y</span>-intercepts.</span>"
    },
    {
     "id": 1222413,
     "content_html": "<span lang=\"EN\">The system of equations has exactly one solution.</span>"
    },
    {
     "id": 1222414,
     "content_html": "<span lang=\"EN\">The system of equations has no solutions.</span>"
    }
   ],
