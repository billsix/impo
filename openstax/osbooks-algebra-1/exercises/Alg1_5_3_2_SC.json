 "questions": [
  {
   "id": 631781,
   "is_answer_order_important": false,
   "stem_html": "<p>Olivia has two different job offers for babysitting next Saturday.&nbsp;</p>\n<ul>\n  <li>Job 1: She will receive $5 for accepting the job, then $10 for every hour she works.&nbsp;</li>\n  <li>Job 2: She will receive $1.50 for accepting the job, $3 after the first hour, $6 after the second hour, and for each additional hour her pay per hour will double.</li>\n</ul>\n<p>Olivia can only work 3 hours. How much would she make at each job?</p>",
   "answers": [
    {
     "id": 1222734,
     "content_html": "Olivia would make <span data-math=\"\\$30\">\\$30</span> at Job 1 and <span data-math=\"\\$21\">\\$21</span> at Job 2."
    },
    {
     "id": 1222733,
     "content_html": "Olivia would make <span data-math=\"\\$25\">\\$25</span> at Job 1 and <span data-math=\"\\$10.50\">\\$10.50</span> at Job 2."
    },
    {
     "id": 1222735,
     "content_html": "Olivia would make <span data-math=\"\\$35\">\\$35</span> at Job 1 and <span data-math=\"\\$22.50\">\\$22.50</span> at Job 2."
    },
    {
     "id": 1222732,
     "content_html": "Olivia would make <span data-math=\"\\$35\">\\$35</span> at Job 1 and <span data-math=\"\\$12\">\\$12</span> at Job 2."
    }
