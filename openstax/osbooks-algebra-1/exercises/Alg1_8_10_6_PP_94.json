   "is_answer_order_important": false,
   "stem_html": "<p>For questions 1 – 4, find the factored form of the quadratic expression.</p>\n<ol class=\"os-raise-noindent\">\n  <li><span data-math=\"3x^2+ 16x + 5\">3x^2+ 16x + 5</span></li>\n</ol>",
   "answers": [
    {
     "id": 1225798,
     "content_html": "<span data-math=\"(3x + 1)(x + 5)\">(3x + 1)(x + 5)</span>"
    },
    {
     "id": 1225797,
     "content_html": "<span data-math=\"(3x − 1)(x − 5)\">(3x − 1)(x − 5)</span>"
    },
    {
     "id": 1225796,
     "content_html": "<span data-math=\"(3x + 1)(x - 5)\">(3x + 1)(x - 5)</span>"
    },
    {
     "id": 1225795,
     "content_html": "<span data-math=\"(3x − 5)(x − 1)\">(3x − 5)(x − 1)</span>"
    }
   ],
