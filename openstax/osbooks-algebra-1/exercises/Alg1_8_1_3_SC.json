 "questions": [
  {
   "id": 631868,
   "is_answer_order_important": false,
   "stem_html": "<p>Suppose a different picture is 5 inches by 5 inches. The frame is created from 11 square inches of framing material. The frame will be uniform in width, and all of the framing material is used. Which equation would you need to solve to determine the value of <span data-math=\"x\">x</span>, the width of the frame?</p>\n<p><img alt=\"A square picture has side lengths measuring 5 inches. It is surrounded by a square frame that is uniformly x inches in width.\" height=\"231\" src=\"exercises/media/ee3bc6d38e60dbd6.jpg\" width=\"296\"></p>",
   "answers": [
    {
     "id": 1223080,
     "content_html": "<span data-math=\"4x^2 + 20x = 36\">4x^2 + 20x = 36</span>"
    },
    {
     "id": 1223081,
     "content_html": "<span data-math=\"x^2 + 25 = 11\">x^2 + 25 = 11</span>"
    },
    {
     "id": 1223082,
     "content_html": "<span data-math=\"x^2 + 10x + 25 = 36\">x^2 + 10x + 25 = 36</span>"
    },
    {
     "id": 1223083,
     "content_html": "<span data-math=\"4x^2 + 20x + 25 = 36\">4x^2 + 20x + 25 = 36</span>"
    }
   ],
