     "id": 1224110,
     "content_html": "<span data-math=\"h\">h</span> represents the number of scooters rented."
    },
    {
     "id": 1224109,
     "content_html": "Company A costs the same as Company B."
    },
    {
     "id": 1224108,
     "content_html": "Company A costs less than Company B."
    },
    {
     "id": 1224111,
     "content_html": "Company A costs more than Company B."
    }
   ],
