 "questions": [
  {
   "id": 632088,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"13\">\n    <li>The boundary line on the graph represents the equation <span data-math=\"5x + 2y = 6\">5x + 2y = 6</span>. Write an inequality that is represented by the graph.</li>\n  </ol>\n<img alt=\"graph with boundary line that represents the equation 5x + 2y = 6\" class=\"img-fluid atto_image_button_text-bottom\" height=\"262\" src=\"exercises/media/8c0b9b1a23a97acb.svg\" width=\"262\">",
   "answers": [
    {
     "id": 1223707,
     "content_html": "<span data-math=\"5x + 2y < 6\">5x + 2y &lt; 6</span>"
    },
    {
     "id": 1223706,
     "content_html": "<span data-math=\"5x + 2y < 2\">5x + 2y &lt; 2</span>"
    },
    {
     "id": 1223705,
     "content_html": "<span data-math=\"-5x - 2y < 6\">-5x - 2y &lt; 6</span>"
    },
    {
     "id": 1223704,
     "content_html": "<span data-math=\"5x + 2y < -6\">5x + 2y &lt; -6</span>"
    }
   ],
