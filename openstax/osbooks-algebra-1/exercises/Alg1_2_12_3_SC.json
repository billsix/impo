 "questions": [
  {
   "id": 631711,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">An artist is designing a sculpture to be displayed hanging in the lobby of a museum. She is using <span data-math=\"x\">x</span> wooden rods and <span data-math=\"y\">y</span> metal pipes.</p>\n<ul>\n  <li>Each wooden rod, <span data-math=\"x\">x</span>, weighs 4 pounds.</li>\n  <li>Each metal pipe, <span data-math=\"y\">y</span>, weighs 7 pounds.&nbsp;</li>\n  <li>The total weight of these materials cannot be more than 510 pounds.&nbsp;</li>\n</ul>\n<p dir=\"ltr\">Which of these ordered pairs represents an amount of materials that meets the artist’s constraints?</p>",
   "answers": [
    {
     "id": 1222455,
     "content_html": "<span data-math=\"(70, 20)\">(70, 20)</span>"
    },
    {
     "id": 1222452,
     "content_html": "<span data-math=\"(50, 60)\">(50, 60)</span>"
    },
    {
     "id": 1222453,
     "content_html": "<span data-math=\"(20, 70)\">(20, 70)</span>"
    },
    {
     "id": 1222454,
     "content_html": "<span data-math=\"(60, 50)\">(60, 50)</span>"
    }
   ],
