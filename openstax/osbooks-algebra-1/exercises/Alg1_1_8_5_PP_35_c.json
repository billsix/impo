   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>Choose the best answer to solve the formula <span data-math=\"A=P+Prt\">A=P+Prt</span> for <span data-math=\"t\">t</span>.</li>\n</ol>",
