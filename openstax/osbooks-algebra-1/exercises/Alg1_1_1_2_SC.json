 "questions": [
  {
   "id": 631657,
   "is_answer_order_important": false,
   "stem_html": "A ninth-grade class is ordering pizza for lunch. There are&nbsp;<span data-math=\"n\">n</span> students in the class. Each slice of pizza costs $3 and the delivery fee is $8. Which expression represents the total cost if each student gets 2 slices of pizza?",
   "answers": [
    {
     "id": 1222238,
     "content_html": "<span data-math=\"3n + 8\">3n + 8</span>"
    },
    {
     "id": 1222239,
     "content_html": "<span data-math=\"(2)3n + 8\">(2)3n + 8</span>"
    },
    {
     "id": 1222237,
     "content_html": "<span data-math=\"(2)3n\">(2)3n</span>"
    },
    {
     "id": 1222236,
     "content_html": "<span data-math=\"3n\">3n</span>"
    }
   ],
