 "questions": [
  {
   "id": 573375,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">Which statement best describes the situation shown in the graph?&nbsp;<br></p>\n<p dir=\"ltr\"><img alt=\"horizontal axis, time in seconds. vertical axis, distance from home in meters.\" src=\"exercises/media/ecf34b927132b4f0.svg\"><br></p>",
   "answers": [
    {
     "id": 1119530,
     "content_html": "Mai begins at a neighbor's house and runs away from home, and then walks for a while."
    },
    {
     "id": 1119531,
     "content_html": "Mai begins at a neighbor's house and walks away from home at a constant rate."
    },
    {
     "id": 1119529,
     "content_html": "Mai begins at home and walks away from her home at a constant rate."
    },
    {
     "id": 1119528,
     "content_html": "Mai begins her walk at school and walks home at a constant rate."
    }
   ],
