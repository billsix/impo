  {
   "id": 632403,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n  <li>Function <span data-math=\"R\">R</span> gives the number of inches, <span data-math=\"T\">T</span>, of rain after <span data-math=\"h\">h</span>, hours. Choose which function notation represents this situation.</li>\n</ol>",
   "answers": [
    {
     "id": 1224574,
     "content_html": "<span data-math=\"T=R(h)\">T=R(h)</span>"
    },
    {
     "id": 1224573,
     "content_html": "<span data-math=\"h=T(R)\">h=T(R)</span>"
    },
    {
     "id": 1224572,
     "content_html": "<span data-math=\"h=R(T)\">h=R(T)</span>"
    },
    {
     "id": 1224571,
     "content_html": "<span data-math=\"R=T(h)\">R=T(h)</span>"
    }
