   "id": 648428,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>An expression in standard form is shown. The diagram below shows it is equivalent to which expression in factored form?</li>\n</ol>\n<table class=\"unnumbered\" border=\"1\">\n  <tbody><tr>\n    <td></td>\n    <td style=\"text-align: center;\"><span data-math=\"x\">x</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"-5\">-5</span></td>\n  </tr>\n  <tr>\n    <td style=\"text-align: center;\"><span data-math=\"x\">x</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"x²\">x²</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"-5x\">-5x</span></td>\n  </tr>\n  <tr>\n    <td style=\"text-align: center;\"><span data-math=\"-7\">-7</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"-7x\">-7x</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"35\">35</span></td>\n  </tr>\n</tbody></table>\n<p><span data-math=\"x^2− 12x + 35\">x^2− 12x + 35</span></p>",
   "answers": [
    {
     "id": 1278715,
     "content_html": "<span data-math=\"(x + 5)(x + 7)\">(x + 5)(x + 7)</span>"
    },
    {
     "id": 1278716,
     "content_html": "<span data-math=\"x(x − 35)\">x(x − 35)</span>"
    },
    {
     "id": 1278717,
     "content_html": "<span data-math=\"(x − 5)(x + 7)\">(x − 5)(x + 7)</span>"
    },
    {
     "id": 1278718,
     "content_html": "<span data-math=\"(x − 5)(x − 7)\">(x − 5)(x − 7)</span>"
    }
   ],
