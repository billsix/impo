   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"1\">\n  <li><strong>Select three</strong> possible input-output pairs for the function <span data-math=\"y=x^3\">y=x^3</span>.</li>\n</ol>\n<ol start=\"1\" type=\"a\">\n  <li><span data-math=\"(-1,-1)\">(-1,-1)</span></li>\n  <li><span data-math=\"(-2,8)\">(-2,8)</span></li>\n  <li><span data-math=\"(3,9)\">(3,9)</span></li>\n  <li><span data-math=\"\\left(\\frac12,\\frac18\\right)\">\\left(\\frac12,\\frac18\\right)</span></li>\n  <li><span data-math=\"(4,64)\">(4,64)</span></li>\n  <li><span data-math=\"(1,-1)\">(1,-1)</span></li>\n</ol>",
