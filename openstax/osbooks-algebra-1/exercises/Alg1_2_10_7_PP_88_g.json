 "questions": [
  {
   "id": 632069,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"8\">\n<li>Look at the inequality <span data-math=\"5m + 6 < 14 − 2m\">5m + 6 &lt; 14 − 2m</span>. Which of the following is NOT true?</li>\n</ol>",
   "answers": [
    {
     "id": 1223651,
     "content_html": "If <span data-math=\"m\">m</span> is a negative number, then <span data-math=\"14 − 2m\">14 − 2m</span> will always be negative."
    },
    {
     "id": 1223650,
     "content_html": "If <span data-math=\"m\">m</span> is a positive number, then <span data-math=\"5m + 6\">5m + 6</span> will always be positive."
    },
    {
     "id": 1223649,
     "content_html": "If <span data-math=\"m\">m</span> is a negative number, then <span data-math=\"14 − 2m\">14 − 2m</span> will always be positive."
    },
    {
     "id": 1223648,
     "content_html": "If <span data-math=\"m\">m</span> is a negative number, then <span data-math=\"5m + 6\">5m + 6</span> could be a positive or negative number."
    }
   ],
