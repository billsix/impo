 "questions": [
  {
   "id": 631712,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">Use graphing technology to solve the following problem.</p>\n<p dir=\"ltr\">Jacob charges $20 to mow a lawn in his neighborhood and $100 to paint a room.&nbsp;&nbsp;</p>\n<p dir=\"ltr\">Which combination of jobs earns Jacob more than $1,000?</p>",
   "answers": [
    {
     "id": 1222458,
     "content_html": "Jacob mows 5 lawns and paints 9 rooms."
    },
    {
     "id": 1222457,
     "content_html": "Jacob mows 35 lawns and paints 1 room."
    },
    {
     "id": 1222459,
     "content_html": "Jacob mows 8 lawns and paints 10 rooms."
    },
    {
     "id": 1222456,
     "content_html": "Jacob mows 10 lawns and paints 8 rooms."
    }
   ],
