 "questions": [
  {
   "id": 631889,
   "is_answer_order_important": false,
   "stem_html": "Write the quadratic function, <span data-math=\"z(x)\">z(x)</span>, in standard form, that has the zeros –1 and 8 and passes through the point <span data-math=\"(0, 16)\">(0, 16)</span>.",
   "answers": [
    {
     "id": 1223164,
     "content_html": "<span data-math=\"z(x) = x^2 + 7x + 8\">z(x) = x^2 + 7x + 8</span>"
    },
    {
     "id": 1223165,
     "content_html": "<span data-math=\"z(x) = 2x^2 - 14x - 16\">z(x) = 2x^2 - 14x - 16</span>"
    },
    {
     "id": 1223166,
     "content_html": "<span data-math=\"z(x) = 3x^2 - 21x - 24\">z(x) = 3x^2 - 21x - 24</span>"
    },
    {
     "id": 1223167,
     "content_html": "<span data-math=\"z(x) = -2x^2 + 14x + 16\">z(x) = -2x^2 + 14x + 16</span>"
    }
   ],
