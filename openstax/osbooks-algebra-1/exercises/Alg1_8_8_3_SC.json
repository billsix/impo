  {
   "id": 631882,
   "is_answer_order_important": false,
   "stem_html": "Find the factored form of the expression <span data-math=\"16p^2 − 49\">16p^2 − 49</span>.",
   "answers": [
    {
     "id": 1223136,
     "content_html": "<span data-math=\"p(16p - 49)\">p(16p - 49)</span>"
    },
    {
     "id": 1223137,
     "content_html": "<span data-math=\"(4p - 7)(4p - 7)\">(4p - 7)(4p - 7)</span>"
    },
    {
     "id": 1223138,
     "content_html": "<span data-math=\"(4p + 7)(4p + 7)\">(4p + 7)(4p + 7)</span>"
    },
    {
     "id": 1223139,
     "content_html": "<span data-math=\"(4p + 7)(4p - 7)\">(4p + 7)(4p - 7)</span>"
    }
