  {
   "id": 669259,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"a\">\n  <li>Which equation represents the relationship between the step number, <span data-math=\"n\">n</span>, and the number of small squares, <span data-math=\"y\">y</span>, in each step?</li>\n  </ol>",
   "answers": [
    {
     "id": 1334139,
     "content_html": "<span data-math=\"y=n^2-n\">y=n^2-n</span>"
    },
    {
     "id": 1334140,
     "content_html": "<span data-math=\"y=n^2-1\">y=n^2-1</span>"
    },
    {
     "id": 1334141,
     "content_html": "<span data-math=\"y=n^2+1\">y=n^2+1</span>"
    },
    {
     "id": 1334142,
     "content_html": "<span data-math=\"y=n^2\">y=n^2</span>"
    }
   ],
