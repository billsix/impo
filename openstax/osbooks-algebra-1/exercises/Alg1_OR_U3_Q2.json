   "id": 619980,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p dir=\"ltr\">The scatter plot shows data on weight in pounds (<span data-math=\"x\">x</span>) and fuel efficiency in miles per gallon (<span data-math=\"y\">y</span>) for 13 cars.&nbsp;<br></p>\n<p dir=\"ltr\"><strong><img alt=\"points (2500, 28), (3259,23), (3500,25), (3559,22), (3550,18), (3700,20), (4000,20), (4000,18), (4400,16), (4500,16), (4750, 14), (5250, 12), (5700,15)\" class=\"img-fluid atto_image_button_text-bottom\" height=\"265\" src=\"exercises/media/0d563c39f528de1e.jpg\" width=\"300\"></strong><br></p>\n<p dir=\"ltr\"><span><span>Which statement best describes the data?</span><br></span></p>",
   "answers": [
    {
     "id": 1182066,
     "content_html": "There appears to be a positive relationship between fuel efficiency and weight. The cars with greater weight tend to have greater efficiency."
    },
    {
     "id": 1182067,
     "content_html": "There appears to be a positive relationship between fuel efficiency and weight. The cars with greater weight tend to have lesser efficiency."
    },
    {
     "id": 1182068,
     "content_html": "There appears to be a negative relationship between fuel efficiency and weight. The cars with greater weight tend to have greater efficiency."
    },
    {
     "id": 1182069,
     "content_html": "There appears to be a negative relationship between fuel efficiency and weight. The cars with greater weight tend to have lesser efficiency."
    }
   ],
