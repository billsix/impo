 "questions": [
  {
   "id": 631721,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">Tell which line is the best fit for the data and give an explanation why it is the best fit.</p>\n<p dir=\"ltr\"><img alt=\"TWO SCATTER PLOTS WITH X-AXIS LABEL OF INDEPENDENT VARIABLE AND Y-AXIS LABEL OF RESPONSE VARIABLE. SCATTER PLOT ON THE LEFT SHOWS FIVE PLOTTED POINTS AND THE LINE Y EQUALS NEGATIVE NINE-TENTHS X PLUS FORTY-FIVE. SCATTER PLOT ON THE RIGHT SHOWS THE SAME PLOTTED POINTS AND THE LINE Y EQUALS NEGATIVE SEVEN-TENTHS X PLUS FORTY.\n\" height=\"259\" src=\"exercises/media/0e09dd5af484143e.jpg\" width=\"549\"></p>",
   "answers": [
    {
     "id": 1222494,
     "content_html": "Line 1 is the best fit because it has a steeper slope."
    },
    {
     "id": 1222495,
     "content_html": "Line 2 is the best fit because it goes through the middle of the data with about the same number of data points above and below the line."
    },
    {
     "id": 1222493,
     "content_html": "Line 2 is the best fit because it touches the last point on the right of the scatter plot."
    },
    {
     "id": 1222492,
     "content_html": "Line 1 is the best fit because it touches the first point on the left of the scatter plot."
    }
   ],
