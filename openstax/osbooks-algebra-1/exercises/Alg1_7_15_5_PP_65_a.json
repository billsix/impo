  {
   "id": 632807,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\">\n  <li>Recall <span data-math=\"m(x)=x(x+6)\">m(x)=x(x+6)</span> and <span data-math=\"p(x)=(x+3)^2−9\">p(x)=(x+3)^2−9</span>. What are the <span data-math=\"x\">x</span>-intercepts of the graph of <span data-math=\"p\">p</span>?&nbsp;</li>\n</ol>",
   "answers": [
    {
     "id": 1225571,
     "content_html": "<span data-math=\"(0,0)\">(0,0)</span> and <span data-math=\"(0,6)\">(0,6)</span>"
    },
    {
     "id": 1225570,
     "content_html": "<span data-math=\"(0,0)\">(0,0)</span> and <span data-math=\"(0,-6)\">(0,-6)</span>"
    },
    {
     "id": 1225569,
     "content_html": "<span data-math=\"(0,0)\">(0,0)</span> and <span data-math=\"(6,0)\">(6,0)</span>"
    },
    {
     "id": 1225572,
     "content_html": "<span data-math=\"(0,0)\">(0,0)</span> and <span data-math=\"(-6,0)\">(-6,0)</span>"
    }
