 "stimulus_html": "<p>Examine the following two equations and use them to answer questions 2 – 5. One defines function <span data-math=\"m\">m</span> and the other defines function <span data-math=\"p\">p</span>.</p>\n<ul class=\"os-raise-noindent\">\n  <li><span data-math=\"m(x)=x(x+6)\">m(x)=x(x+6)</span></li>\n  <li><span data-math=\"p(x)=(x+3)^2−9\">p(x)=(x+3)^2−9</span></li>\n</ul>",
 "questions": [
  {
   "id": 632804,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\">\n  <li>How do you know that the expressions defining <span data-math=\"m\">m</span> and <span data-math=\"p\">p</span> are equivalent?</li>\n</ol>",
   "answers": [
    {
     "id": 1225567,
     "content_html": "Both expressions are equal to <span data-math=\"x^2-3\">x^2-3</span>."
    },
    {
     "id": 1225566,
     "content_html": "Both expressions are equal to <span data-math=\"2x+6\">2x+6</span>."
    },
    {
     "id": 1225565,
     "content_html": "Both expressions are equal to <span data-math=\"x^2-6x\">x^2-6x</span>."
    },
    {
     "id": 1225568,
     "content_html": "Both expressions are equal to <span data-math=\"x^2+6x\">x^2+6x</span>."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 632805,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>Recall <span data-math=\"m(x)=x(x+6)\">m(x)=x(x+6)</span> and <span data-math=\"p(x)=(x+3)^2−9\">p(x)=(x+3)^2−9</span>. What is the <span data-math=\"x\">x</span>-coordinate of the vertex of the graph of <span data-math=\"m\">m</span>?&nbsp;</li>\n</ol>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 632806,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>Recall <span data-math=\"m(x)=x(x+6)\">m(x)=x(x+6)</span> and <span data-math=\"p(x)=(x+3)^2−9\">p(x)=(x+3)^2−9</span>. What is the <span data-math=\"y\">y</span>-coordinate of the vertex of the graph of <span data-math=\"m\">m</span>?&nbsp;</li>\n</ol>",
   "answers": [],
   "hints": [],
   "formats": [
