    },
    {
     "id": 1272435,
     "content_html": "<img alt=\"A graph is shown of a line crossing the \\(y\\)-axis at 50 and the \\(x\\)-axis at 20. The region above the line is shaded.\" class=\"img-fluid atto_image_button_text-bottom\" height=\"308\" src=\"exercises/media/30f8752deae2e45d.jpg\" width=\"300\">"
    },
    {
     "id": 1272436,
     "content_html": "<img alt=\"A graph is shown of a line crossing the \\(y\\)-axis at 50 and the \\(x\\)-axis at about 33. The region above the line is shaded.\" class=\"img-fluid atto_image_button_text-bottom\" height=\"305\" src=\"exercises/media/cc93faba11b71016.jpg\" width=\"300\">"
    },
    {
     "id": 1272437,
     "content_html": "<img alt=\"A graph is shown of a line crossing the \\(y\\)-axis at about 33 and the \\(x\\)-axis at 50. The region above the line is shaded.\" class=\"img-fluid atto_image_button_text-bottom\" height=\"306\" src=\"exercises/media/f7fecce39bd597b9.jpg\" width=\"300\">"
