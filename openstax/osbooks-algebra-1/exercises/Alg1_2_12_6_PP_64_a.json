 "is_vocab": false,
 "stimulus_html": "<p>For questions 5 – 8, use the following passage:</p>\n<blockquote>\nThe doctor tells Maya she needs to exercise enough to burn 500 calories each day. She likes to run which burns 15 calories per minute or bike which burns 10 calories per minute.</blockquote>\n <br>",
 "questions": [
  {
   "id": 646349,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"5\">\n<li>If <span data-math=\"x\">x</span> is the number of minutes that Maya runs and <span data-math=\"y\">y</span> is the number of minutes she bikes, find the inequality that models the situation.</li>\n</ol>",
   "answers": [
    {
     "id": 1272430,
     "content_html": "<span data-math=\"15x + 10y ≤ 500\">15x + 10y ≤ 500</span>"
    },
    {
     "id": 1272431,
     "content_html": "<span data-math=\"15x + 10y > 500\">15x + 10y &gt; 500</span>"
    },
    {
     "id": 1272432,
     "content_html": "<span data-math=\"15x + 10y ≥ 500\">15x + 10y ≥ 500</span>"
    },
    {
     "id": 1272433,
     "content_html": "<span data-math=\"15x + 10y < 500\">15x + 10y &lt; 500</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646350,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<ol start=\"6\">\n<li>Which graph correctly represents the inequality from the previous question?</li>\n</ol>",
   "answers": [
