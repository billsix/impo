   "combo_choices": []
  },
  {
   "id": 646352,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"8\">\n<li>Which of the following is true about the solution you found in the previous question?</li>\n</ol>",
   "answers": [
    {
     "id": 1272442,
     "content_html": "The solution represents a workout which allows Maya to burn at least 500 calories."
    },
    {
     "id": 1272443,
     "content_html": "The <span data-math=\"y\">y</span>-coordinate represents the number of minutes that Maya runs."
    },
    {
     "id": 1272444,
     "content_html": "The <span data-math=\"x\">x</span>-coordinate represents the number of minutes that Maya bikes."
    }
   ],
