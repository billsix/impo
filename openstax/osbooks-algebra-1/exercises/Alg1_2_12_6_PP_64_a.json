  {
   "id": 646351,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"7\">\n<li>Which of the following ordered pairs is a solution to the inequality?</li>\n</ol>",
   "answers": [
    {
     "id": 1272438,
     "content_html": "<span data-math=\"(25, 10)\">(25, 10)</span>"
    },
    {
     "id": 1272439,
     "content_html": "<span data-math=\"(20, 15)\">(20, 15)</span>"
    },
    {
     "id": 1272440,
     "content_html": "<span data-math=\"(15, 30)\">(15, 30)</span>"
    },
    {
     "id": 1272441,
     "content_html": "<span data-math=\"(5, 40)\">(5, 40)</span>"
    }
   ],
