   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a correct next step to create an equation equivalent to <span data-math=\"x - 0.2x - 4.2 =13.4\">x - 0.2x - 4.2 =13.4</span>?<br>",
   "answers": [
    {
     "id": 1222286,
     "content_html": "<span data-math=\"2(x - 0.2x) = 17.6\">2(x - 0.2x) = 17.6</span>"
    },
    {
     "id": 1222285,
     "content_html": "<span data-math=\"x - 0.2x = 9.2\">x - 0.2x = 9.2</span>"
    },
    {
     "id": 1222284,
     "content_html": "<span data-math=\"10(x - 0.2x-4.2) = 13.4\">10(x - 0.2x-4.2) = 13.4</span>"
    },
    {
     "id": 1222287,
