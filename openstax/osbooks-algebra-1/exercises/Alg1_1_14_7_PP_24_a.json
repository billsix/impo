  {
   "id": 645986,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>Which line is perpendicular to <span data-math=\"y = \\frac{3}{4}x - 2\">y = \\frac{3}{4}x - 2</span> and contains the point <span data-math=\"(-3, 4)\">(-3, 4)</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1271246,
     "content_html": "<span data-math=\"y=\\frac34x+\\frac{17}4\">y=\\frac34x+\\frac{17}4</span>"
    },
    {
     "id": 1271247,
     "content_html": "<span data-math=\"y=\\frac34x+4\">y=\\frac34x+4</span>"
    },
    {
     "id": 1271248,
     "content_html": "<span data-math=\"y=-\\frac43x+4\">y=-\\frac43x+4</span>"
    },
    {
     "id": 1271249,
     "content_html": "<span data-math=\"y=-\\frac43x\">y=-\\frac43x</span>"
    }
   ],
