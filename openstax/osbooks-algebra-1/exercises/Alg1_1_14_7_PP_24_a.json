 "stimulus_html": "In questions 6 – 10, find an equation of a line that is perpendicular to the given line and contains the given point. The choices are in slope-intercept form.\n",
 "questions": [
  {
   "id": 645984,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n  <li>Which line is perpendicular to <span data-math=\"y = -2x +3\">y = -2x +3</span> and contains the point <span data-math=\"(2, 2)\">(2, 2)</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1271238,
     "content_html": "<span data-math=\"y=\\frac12x+1\">y=\\frac12x+1</span>"
    },
    {
     "id": 1271239,
     "content_html": "<span data-math=\"y=\\frac12x+3\">y=\\frac12x+3</span>"
    },
    {
     "id": 1271240,
     "content_html": "<span data-math=\"y=-\\frac12x+3\">y=-\\frac12x+3</span>"
    },
    {
     "id": 1271241,
     "content_html": "<span data-math=\"y=-2x+6\">y=-2x+6</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 645985,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n  <li>Which line is perpendicular to <span data-math=\"y = -x +5\">y = -x +5</span> and contains the point<span data-math=\"(3, 3)\">(3, 3)</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1271242,
     "content_html": "<span data-math=\"y=-x+3\">y=-x+3</span>"
    },
    {
     "id": 1271243,
     "content_html": "<span data-math=\"y=x+5\">y=x+5</span>"
    },
    {
     "id": 1271244,
     "content_html": "<span data-math=\"y=x\">y=x</span>"
    },
    {
     "id": 1271245,
     "content_html": "<span data-math=\"y=-x+6\">y=-x+6</span>"
    }
   ],
   "hints": [],
   "formats": [
