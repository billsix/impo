   "id": 631880,
   "is_answer_order_important": false,
   "stem_html": "<p>Consider the expression <span data-math=\"x^2 + bx − 48\">x^2 + bx − 48</span>.</p>\n<p>Identify all the pairs of factors of –48 that would result in positive values of <span data-math=\"b\">b</span>.</p>",
   "answers": [
    {
     "id": 1223131,
     "content_html": "-1 and 48,<br>-2 and 24,<br>-3 and 16,<br>-4 and 12,<br>-6 and 8"
