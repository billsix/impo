 "is_vocab": false,
 "stimulus_html": "<p>Use the following scenario to answer questions 6 – 8.</p>\n<blockquote>\nSuppose you want to frame a different picture that measures 9 inches by 8 inches. The frame is created from 38 square inches of framing material. The frame must be uniform in width, and all of the framing material must be used. Let <span data-math=\"x\">x</span> represent the thickness of the frame.</blockquote>",
 "questions": [
  {
   "id": 632938,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n  <li>What is the total area of the framed picture?</li>\n</ol>",
   "answers": [
    {
     "id": 1225777,
     "content_html": "134 square inches"
    },
    {
     "id": 1225778,
     "content_html": "110 square inches"
    },
    {
     "id": 1225776,
     "content_html": "72 square inches"
    },
    {
     "id": 1225775,
     "content_html": "34 square inches"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "stimulus_html": ""
  },
  {
   "id": 632939,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n  <li>Write an equation to represent the relationship between the measurements of the picture and of the frame and the area of the framed picture.</li>\n</ol>",
   "answers": [
    {
     "id": 1225782,
     "content_html": "<span data-math=\"4x^2 + 34x + 72 = 110\">4x^2 + 34x + 72 = 110</span>"
    },
    {
     "id": 1225781,
     "content_html": "<span data-math=\"x^2 + 34x + 72 = 110\">x^2 + 34x + 72 = 110</span>"
    },
    {
     "id": 1225780,
     "content_html": "<span data-math=\"4x^2 + 34x = 72\">4x^2 + 34x = 72</span>"
    },
    {
     "id": 1225779,
     "content_html": "<span data-math=\"x^2 + 34x = 38\">x^2 + 34x = 38</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "stimulus_html": ""
  },
  {
   "id": 632940,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>What does the solution to the equation in the previous question represent in this situation?</li>\n</ol>",
   "answers": [
    {
     "id": 1225785,
     "content_html": "The solution represents the total area of the framed picture."
    },
    {
     "id": 1225784,
     "content_html": "The solution represents the perimeter of the frame when all of the framing material is used."
    },
    {
     "id": 1225786,
     "content_html": "The solution represents the thickness of the frame when all of the framing material is used."
    },
    {
     "id": 1225783,
     "content_html": "The solution represents the area of the framing material that should be used."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
