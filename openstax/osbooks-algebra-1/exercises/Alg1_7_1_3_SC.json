 "questions": [
  {
   "id": 667837,
   "is_answer_order_important": false,
   "stem_html": "<p>The graph below shows a rectangle’s side length and its area. What is true about the point <span data-math=\"(3, 21)\">(3, 21)</span>?</p>\n<p><img alt=\"A scatter plot displays five data points showing a relationship between length (meters) on the x-axis and area (square meters) on the y-axis.\" class=\"img-fluid atto_image_button_text-bottom\" height=\"146\" src=\"exercises/media/df08d7090629efc1.jpg\" width=\"318\"></p>",
   "answers": [
    {
     "id": 1332281,
     "content_html": "The area of the rectangle is 3 square meters."
    },
    {
     "id": 1332282,
     "content_html": "It is not possible to find the width of the rectangle when the length is 3 meters."
    },
    {
     "id": 1332283,
     "content_html": "The length of the rectangle is 3 meters, and the area is 21 square meters."
    },
    {
     "id": 1332284,
     "content_html": "The width of the rectangle is 3 meters, and the area is 21 square meters."
    }
   ],
