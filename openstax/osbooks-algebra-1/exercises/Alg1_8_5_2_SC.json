 "questions": [
  {
   "id": 631875,
   "is_answer_order_important": false,
   "stem_html": "Use graphing technology to determine the number of solutions for the equation <span data-math=\"(x+3)(x−6)=−22\">(x+3)(x−6)=−22</span>. Then find any solutions.",
   "answers": [
    {
     "id": 1223111,
     "content_html": "The equation has no solutions."
    },
    {
     "id": 1223108,
     "content_html": "There are two solutions. <span data-math=\"x=-3\">x=-3</span> or <span data-math=\"x=6\">x=6</span>"
    },
    {
     "id": 1223109,
     "content_html": "There are two solutions. <span data-math=\"x=-6\">x=-6</span> or <span data-math=\"x=3\">x=3</span>"
    },
    {
     "id": 1223110,
     "content_html": "There is one solution. <span data-math=\"x=5.5\">x=5.5</span>"
    }
   ],
