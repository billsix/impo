  {
   "id": 632886,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>A small ball is dropped from a 100-foot-tall building. Which equation could represent the ball’s height, <span data-math=\"h(t)\">h(t)</span>, in feet, relative to the ground, as a function of time, <span data-math=\"t\">t</span>, in seconds?</li>\n</ol>",
   "answers": [
    {
     "id": 1225685,
     "content_html": "<span data-math=\"h(t)=100-\\frac{16}t\">h(t)=100-\\frac{16}t</span>"
    },
    {
     "id": 1225684,
     "content_html": "<span data-math=\"h(t)=100+16t^2\">h(t)=100+16t^2</span>"
    },
    {
     "id": 1225686,
     "content_html": "<span data-math=\"h(t)=100-16t^2\">h(t)=100-16t^2</span>"
    },
    {
     "id": 1225683,
     "content_html": "<span data-math=\"h(t)=100-16t\">h(t)=100-16t</span>"
    }
   ],
   "hints": [],
