   "id": 648491,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"11\">\n  <li>Which equation is most appropriate for modeling this data?</li>\n</ol>\n<table class=\"os-raise-horizontaltable unnumbered\">\n<thead></thead>\n<tbody>\n<tr>\n<th scope=\"row\"><span data-math=\"x\">x</span></th>\n<td>1</td>\n<td>2</td>\n<td>3</td>\n<td>4</td>\n<td>5</td>\n<td>6</td>\n</tr>\n<tr>\n<th scope=\"row\"><span data-math=\"y\">y</span></th>\n<td>50</td>\n<td>100</td>\n<td>200</td>\n<td>400</td>\n<td>800</td>\n<td>1600</td>\n</tr>\n</tbody>\n</table>",
   "answers": [
    {
     "id": 1278939,
     "content_html": "<span data-math=\"y=50 \\cdot 2^{\\frac 1x}\">y=50 \\cdot 2^{\\frac 1x}</span>"
    },
    {
     "id": 1278940,
     "content_html": "<span data-math=\"y=25 \\cdot x^2\">y=25 \\cdot x^2</span>"
    },
    {
     "id": 1278941,
     "content_html": "<span data-math=\"y=25 \\cdot 2^x\">y=25 \\cdot 2^x</span>"
    },
    {
     "id": 1278942,
     "content_html": "<span data-math=\"y=25 \\cdot (2x)^2\">y=25 \\cdot (2x)^2</span>"
    }
   ],
