 "questions": [
  {
   "id": 631659,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">The sum of the measures of the angles of a triangle is <span data-math=\"180°\">180°</span>. The right triangle shown has angle measures <span data-math=\"a&nbsp;\">a&nbsp;</span>, <span data-math=\"b&nbsp;\">b&nbsp;</span>, and <span data-math=\"90°\">90°</span>. Which equation could model this relationship?</p>\n<p dir=\"ltr\"><img alt=\"A right triangle with angle measures a, b, and ninety degrees.\" class=\"img-fluid atto_image_button_text-bottom\" height=\"245\" src=\"exercises/media/00d175e8c9a0dd3d.png\" width=\"330\"><br></p>",
   "answers": [
    {
     "id": 1222244,
     "content_html": "<span data-math=\"90ab=180\">90ab=180</span>"
    },
    {
     "id": 1222247,
     "content_html": "<span data-math=\"a + b + 90 = 180\">a + b + 90 = 180</span>"
    },
    {
     "id": 1222245,
     "content_html": "<span data-math=\"a + b - 90 =180\">a + b - 90 =180</span>"
    },
    {
     "id": 1222246,
     "content_html": "<span data-math=\"ab + 90 = 180\">ab + 90 = 180</span>"
    }
   ],
