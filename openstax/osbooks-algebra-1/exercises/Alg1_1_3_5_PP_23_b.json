   "stem_html": "<ol start=\"5\">\n<li>Choose the equation that represents the number of teaspoons, <span data-math=\"t\">t</span>, contained in a cup, <span data-math=\"C\">C</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1270800,
     "content_html": "<span data-math=\"c=\\frac t3\">c=\\frac t3</span>"
    },
    {
     "id": 1270801,
     "content_html": "<span data-math=\"c = t-48\">c = t-48</span>"
    },
    {
     "id": 1270802,
     "content_html": "<span data-math=\"c=\\frac t{48}\">c=\\frac t{48}</span>"
    },
    {
     "id": 1270803,
     "content_html": "<span data-math=\"c = 48t\">c = 48t</span>"
