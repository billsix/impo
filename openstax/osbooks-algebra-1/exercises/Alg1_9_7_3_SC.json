 "questions": [
  {
   "id": 631905,
   "is_answer_order_important": false,
   "stem_html": "The equation <span data-math=\"g(t) = 2 + 23.7t - 4.9t^2\">g(t) = 2 + 23.7t - 4.9t^2</span> models the height, in meters, of a pumpkin <span data-math=\"t\">t</span> seconds after it has been launched from a catapult. Which of the following substitutions into the quadratic formula is correct to find the value of <span data-math=\"t\">t</span> where the pumpkin hit the ground?",
   "answers": [
    {
     "id": 1223228,
     "content_html": "<span data-math=\"t=\\frac{-23.7 \\pm \\sqrt{600.89}}{4}\">t=\\frac{-23.7 \\pm \\sqrt{600.89}}{4}</span>"
    },
    {
     "id": 1223229,
     "content_html": "<span data-math=\"t=\\frac{-23.7 \\pm \\sqrt{600.89}}{-4.9}\">t=\\frac{-23.7 \\pm \\sqrt{600.89}}{-4.9}</span>"
    },
    {
     "id": 1223231,
     "content_html": "<span data-math=\"t=\\frac{-23.7 \\pm \\sqrt{600.89}}{-9.8}\">t=\\frac{-23.7 \\pm \\sqrt{600.89}}{-9.8}</span>"
    },
    {
     "id": 1223230,
     "content_html": "<span data-math=\"t=\\frac{23.7 \\pm \\sqrt{600.89}}{-9.8}\">t=\\frac{23.7 \\pm \\sqrt{600.89}}{-9.8}</span>"
    }
