 "questions": [
  {
   "id": 633182,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>What is the difference between <span data-math=\"\\sqrt{9}\">\\sqrt{9}</span> and the solutions to <span data-math=\"x^2=9\">x^2=9</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1226475,
     "content_html": "There is no difference; they are equal."
    },
    {
     "id": 1226476,
     "content_html": "<span data-math=\"\\sqrt{9}\">\\sqrt{9}</span> is equal to 3, while there are two numbers that make <span data-math=\"x^2=9\">x^2=9</span> true: 3 and -3."
    },
    {
     "id": 1226474,
     "content_html": "<span data-math=\"\\sqrt{9}\">\\sqrt{9}</span> is equal to -3, while there are two numbers that make <span data-math=\"x^2=9\">x^2=9</span> true: 3 and -3."
    },
    {
     "id": 1226473,
     "content_html": "<span data-math=\"\\sqrt{9}\">\\sqrt{9}</span> is equal to 3, while <span data-math=\"x^2=9\">x^2=9</span> is equal to -3."
    }
   ],
