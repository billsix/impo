  {
   "id": 631685,
   "is_answer_order_important": false,
   "stem_html": "Which equation represents an equation of a line parallel to the line&nbsp;<span data-math=\"y = \\frac{1}{2} x - 3\">y = \\frac{1}{2} x - 3</span> that contains the point <span data-math=\"(6, 4)\">(6, 4)</span>?",
   "answers": [
    {
     "id": 1222350,
     "content_html": "<span data-math=\"y = \\frac{1}{2}x - 2\">y = \\frac{1}{2}x - 2</span>"
    },
    {
     "id": 1222349,
     "content_html": "<span data-math=\"y = \\frac{1}{2}x - 7\">y = \\frac{1}{2}x - 7</span>"
    },
    {
     "id": 1222348,
     "content_html": "<span data-math=\"y = \\frac{1}{2}x + 4\">y = \\frac{1}{2}x + 4</span>"
    },
    {
     "id": 1222351,
     "content_html": "<span data-math=\"y = \\frac{1}{2}x + 1\">y = \\frac{1}{2}x + 1</span>"
    }
