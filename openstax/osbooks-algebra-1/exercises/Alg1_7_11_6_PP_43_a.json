   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\">\n  <li><strong>Select two</strong> equations whose graphs have a vertex with <span data-math=\"x\">x</span>-coordinate 2.</li>\n</ol>\n<ol type=\"a\">\n  <li><span data-math=\"y=(x-2)(x-4)\">y=(x-2)(x-4)</span></li>\n  <li><span data-math=\"y=(x-2)(x+2)\">y=(x-2)(x+2)</span></li>\n  <li><span data-math=\"y=(x-1)(x-3)\">y=(x-1)(x-3)</span></li>\n  <li><span data-math=\"y=x(x+4)\">y=x(x+4)</span></li>\n  <li><span data-math=\"y=x(x-4)\">y=x(x-4)</span></li>\n</ol>",
