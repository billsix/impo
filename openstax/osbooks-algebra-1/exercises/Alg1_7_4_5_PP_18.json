   "id": 669287,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n  <li>Choose the best statement that describes how the values of the exponential expression <span data-math=\"2^x\">2^x</span> and the quadratic expression <span data-math=\"10x^2\">10x^2x</span> change as <span data-math=\"x\">x</span> becomes greater and greater.</li>\n</ol>",
   "answers": [
    {
     "id": 1334183,
     "content_html": "There is no change in the values of the expressions when <span data-math=\"x\">x</span> increases."
    },
    {
     "id": 1334184,
     "content_html": "They both grow at the same rate."
    },
    {
     "id": 1334185,
     "content_html": "The value of the quadratic expression grows much more quickly as <span data-math=\"x\">x</span> increases."
    },
    {
     "id": 1334186,
     "content_html": "The value of the exponential expression grows much more quickly as <span data-math=\"x\">x</span> increases."
    }
