 "is_vocab": false,
 "stimulus_html": "<p>Use the following to answer questions 1 – 7.</p>\n<p>The table shows values of the expressions <span data-math=\"10x^2\">10x^2</span> and <span data-math=\"2^x\">2^x</span>.</p>\n<table class=\"unnumbered\">\n  <thead>\n    <tr>\n      <th scope=\"col\"><span data-math=\"x\">x</span></th>\n      <th scope=\"col\"><span data-math=\"10x^2\">10x^2</span></th>\n      <th scope=\"col\"><span data-math=\"2^x\">2^x</span></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td><span data-math=\"1\">1</span></td>\n      <td><span data-math=\"10\">10</span></td>\n      <td><span data-math=\"2\">2</span></td>\n    </tr>\n    <tr>\n      <td><span data-math=\"2\">2</span></td>\n      <td><span data-math=\"40\">40</span></td>\n      <td><span data-math=\"4\">4</span></td>\n    </tr>\n    <tr>\n      <td><span data-math=\"3\">3</span></td>\n      <td><span data-math=\"90\">90</span></td>\n      <td><span data-math=\"8\">8</span></td>\n    </tr>\n    <tr>\n      <td><span data-math=\"4\">4</span></td>\n      <td><span data-math=\"160\">160</span></td>\n      <td><span data-math=\"16\">16</span></td>\n    </tr>\n    <tr>\n      <td><span data-math=\"8\">8</span></td>\n      <td>&nbsp;</td>\n      <td>&nbsp;</td>\n    </tr>\n    <tr>\n      <td><span data-math=\"10\">10</span></td>\n      <td>&nbsp;</td>\n      <td>&nbsp;</td>\n    </tr>\n    <tr>\n      <td><span data-math=\"12\">12</span></td>\n      <td>&nbsp;</td>\n      <td>&nbsp;</td>\n    </tr>\n  </tbody>\n</table>",
 "questions": [
  {
   "id": 669276,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" type=\"1\">\n<li>Complete the statement.</li>\n  </ol><ol class=\"os-raise-noindent\" start=\"1\" type=\"a\">\n    <li>When the value of <span data-math=\"x\">x</span> increases by <span data-math=\"1\">1</span>, the expression <span data-math=\"10x^2\">10x^2</span>:</li>\n  </ol>",
   "answers": [
    {
     "id": 1334169,
     "content_html": "Changes logarithmically. It has decreased by one-half."
    },
    {
     "id": 1334170,
     "content_html": "Grows by decreasing amounts but by increasing growth factors."
    },
    {
     "id": 1334171,
     "content_html": "Changes exponentially. It doubles."
    },
    {
     "id": 1334172,
     "content_html": "Grows by increasing amounts but by decreasing growth factors."
    }
   ],
