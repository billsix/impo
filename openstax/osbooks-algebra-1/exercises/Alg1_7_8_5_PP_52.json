 "questions": [
  {
   "id": 667995,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\">\n    <li>Choose the expression that best describes the diagram.<br> <br> <img alt=\"An area model visualizes the multiplication of two binomials, (x+3) and (2x+5). The grid cells show the individual products: 2x^2, 5x, 6x, and 15.\" height=\"124\" src=\"exercises/media/8fdba9ebbfb15722.jpg\" width=\"254\"></li>\n  </ol>",
   "answers": [
    {
     "id": 1332433,
     "content_html": "<span data-math=\"(2x +5)(x +3)\">(2x +5)(x +3)</span> is equivalent to <span data-math=\"30x^2\">30x^2</span>."
    },
    {
     "id": 1332434,
     "content_html": "<span data-math=\"(2x+5)(x+3)\">(2x+5)(x+3)</span> is equivalent to <span data-math=\"2x^2+11x+15\">2x^2+11x+15</span>."
    },
    {
     "id": 1332435,
     "content_html": "<span data-math=\"(2x +5)(x +3)\">(2x +5)(x +3)</span> is equivalent to <span data-math=\"2x^2+14x + 23\">2x^2+14x + 23</span>."
    },
    {
     "id": 1332436,
     "content_html": "<span data-math=\"(2x+5)(x+3)\">(2x+5)(x+3)</span> is equivalent to <span data-math=\"2x^2+5x+8\">2x^2+5x+8</span>."
    }
   ],
