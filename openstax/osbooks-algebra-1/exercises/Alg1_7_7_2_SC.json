 "questions": [
  {
   "id": 631843,
   "is_answer_order_important": false,
   "stem_html": "<p>A company that sells music downloads is deciding how much to charge customers to download an album. Based on previous sales, the company predicts that if they charge <span data-math=\"x\">x</span> dollars for each download, then the number of downloads, in thousands, is <span data-math=\"13-x\">13-x</span>.</p>\n<p>Which of the following represents the revenue for downloads?</p>",
   "answers": [
    {
     "id": 1222982,
     "content_html": "<span data-math=\"13-x^2\">13-x^2</span>"
    },
    {
     "id": 1222983,
     "content_html": "<span data-math=\"13x-x^2\">13x-x^2</span>"
    },
    {
     "id": 1222981,
     "content_html": "<span data-math=\"\\frac {13-x}{x}\">\\frac {13-x}{x}</span>"
    },
    {
     "id": 1222980,
     "content_html": "<span data-math=\"13-x\">13-x</span>"
    }
   ],
