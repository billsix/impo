   "stimulus_html": "",
   "stem_html": "<p dir=\"ltr\">Which statement best describes the scatter plot?&nbsp;<br></p>\n<p dir=\"ltr\"><strong><img alt=\"scatter plot with x from -1 to 11 and y from 0 to 8 plot points: (0.25,6), (1, 5),(1,6),(1, 7.5)(1.75, 4.5), (2,4), (2.5,3.5), (2.75,5.75), (3.5,3.5)(4,2.75), (4.5,2.5)(5,3.5), (5.5,2.5),(6.3.5)(6.25, 2.75), (6.75,4.75)(7,4)(7.5,5.75),(8.5,5.25), (9,7.25),(9.5,6.26)\" class=\"img-fluid atto_image_button_text-bottom\" height=\"284\" src=\"exercises/media/875090dd7730b3f9.jpg\" width=\"300\"></strong><br></p>",
   "answers": [
    {
     "id": 1105397,
     "content_html": "There is an increasing linear pattern."
    },
    {
     "id": 1105398,
     "content_html": "There is a decreasing linear pattern."
    },
    {
     "id": 1105399,
     "content_html": "There is no pattern."
    },
    {
     "id": 1105400,
     "content_html": "There is a nonlinear pattern."
    }
