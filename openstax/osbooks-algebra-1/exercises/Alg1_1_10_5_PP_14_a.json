  {
   "id": 645921,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"6\">\n<li>What does the slope tell us about this situation?</li>\n</ol>",
   "answers": [
    {
     "id": 1271008,
     "content_html": "Only the elevation (feet)."
    },
    {
     "id": 1271009,
     "content_html": "Only the distance along the trail (miles)."
    },
    {
     "id": 1271010,
     "content_html": "The change in miles as the elevation increases."
    },
    {
     "id": 1271011,
     "content_html": "The change in elevation as the hikers hike more miles."
    }
   ],
