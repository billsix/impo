   "id": 631677,
   "is_answer_order_important": false,
   "stem_html": "A coin jar contains 75 cents and only contains quarters and nickels. Write an equation that relates the number of quarters, <span data-math=\"q\">q</span>, the number of nickels, <span data-math=\"n\">n</span>, and the amount of money, in cents, in the coin jar.",
   "answers": [
    {
     "id": 1222316,
     "content_html": "<span data-math=\"0.05n - 0.25q =0.75\">0.05n - 0.25q =0.75</span>"
    },
    {
     "id": 1222317,
     "content_html": "<span data-math=\"25q - 5n =75\">25q - 5n =75</span>"
    },
    {
     "id": 1222318,
     "content_html": "<span data-math=\"25q + 5n =0.75\">25q + 5n =0.75</span>"
    },
