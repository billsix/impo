   "id": 633033,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li>Which of the following is equivalent to <span data-math=\"10^2−12^2\">10^2−12^2</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1226154,
     "content_html": "<span data-math=\"(10 + 12)(10 − 12)\">(10 + 12)(10 − 12)</span>"
    },
    {
     "id": 1226151,
     "content_html": "<span data-math=\"(10 −12)^2\">(10 −12)^2</span>"
    },
    {
     "id": 1226152,
     "content_html": "<span data-math=\"(10 − 12)(10 − 12)\">(10 − 12)(10 − 12)</span>"
    },
    {
     "id": 1226153,
