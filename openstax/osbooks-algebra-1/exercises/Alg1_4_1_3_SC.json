 "questions": [
  {
   "id": 631732,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">Consider the two relations below. Which statement is true about both relations?</p>\n<ol class=\"os-raise-noindent\" type=\"A\">\n  <li>{<span data-math=\"(−3,−6),(−2,−4),(−1,−2),(0,0),(1,2),(2,4),(3,6)\">(−3,−6),(−2,−4),(−1,−2),(0,0),(1,2),(2,4),(3,6)</span>}</li>\n  <li>{<span data-math=\"(8,−4),(4,−2),(2,−1),(0,0),(2,1),(4,2),(8,4)\">(8,−4),(4,−2),(2,−1),(0,0),(2,1),(4,2),(8,4)</span>}</li>\n</ol>",
   "answers": [
    {
     "id": 1222536,
     "content_html": "Neither relation is a function."
    },
    {
     "id": 1222537,
     "content_html": "Relation b is a function, but relation a is not a function."
    },
    {
     "id": 1222539,
     "content_html": "Relation a is a function, but relation b is not a function."
    },
    {
     "id": 1222538,
     "content_html": "Both relations are functions."
    }
   ],
