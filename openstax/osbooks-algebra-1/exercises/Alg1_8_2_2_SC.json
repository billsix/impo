 "questions": [
  {
   "id": 631869,
   "is_answer_order_important": false,
   "stem_html": "<p>After a flashlight is turned on, it gets brighter as it warms up, and then it grows dimmer as the battery dies. The equation modeling the brightness it emits, in lumens, <span data-math=\"h\">h</span> hours after being turned on is shown here.</p>\n<p><span data-math=\"f(h) = -8h^2 + 30h + 50\">f(h) = -8h^2 + 30h + 50</span></p>\n<p>Which equation would you solve to determine when the flashlight dies and stops emitting lumens?</p>",
   "answers": [
    {
     "id": 1223087,
     "content_html": "<span data-math=\"-8h^2 + 30h + 50 = 0\">-8h^2 + 30h + 50 = 0</span>"
    },
    {
     "id": 1223086,
     "content_html": "<span data-math=\"-8h^2 + 30h = 50\">-8h^2 + 30h = 50</span>"
    },
    {
     "id": 1223085,
     "content_html": "<span data-math=\"8h^2 + 30h + 50 = 0\">8h^2 + 30h + 50 = 0</span>"
    },
    {
     "id": 1223084,
     "content_html": "<span data-math=\"-8h^2 + 30h - 50 = 0\">-8h^2 + 30h - 50 = 0</span>"
    }
   ],
