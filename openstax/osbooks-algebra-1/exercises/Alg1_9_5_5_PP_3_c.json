   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"a\">\n  <li>Are the solutions and the graph for the equation <span data-math=\"x^2+10x+8=0\">x^2+10x+8=0</span> similar?&nbsp;</li>\n</ol>",
   "answers": [
    {
     "id": 1332477,
     "content_html": "They are similar because the square root of a number is always positive."
    },
    {
     "id": 1332478,
     "content_html": "They are not similar because the square root of a number is always positive."
    },
    {
     "id": 1332479,
     "content_html": "They are similar because the solutions are close."
    },
    {
     "id": 1332480,
     "content_html": "They are not similar."
    }
