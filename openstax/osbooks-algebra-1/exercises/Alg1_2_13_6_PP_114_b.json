 "is_vocab": false,
 "stimulus_html": "<p>For questions 3 – 4, use the scenario below to answer the questions:</p>\n<blockquote>\n  <p>A farmer is creating a budget for planting soybeans and wheat. Planting soybeans costs $200 per acre and planting wheat costs $500 per acre. He wants to spend no more than $100,000 planting soybeans and wheat.</p>\n</blockquote>",
 "questions": [
  {
   "id": 646372,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>Let <span data-math=\"s\">s</span> represent the number of acres of soybeans and <span data-math=\"w\">w</span> represent the number of acres of wheat. Write an inequality to describe the situation.</li>\n</ol>",
   "answers": [
    {
     "id": 1272517,
     "content_html": "<span data-math=\"200s + 500w > 100,000\">200s + 500w &gt; 100,000</span>"
    },
    {
     "id": 1272518,
     "content_html": "<span data-math=\"200s + 500w ≤ 100,000\">200s + 500w ≤ 100,000</span>"
    },
    {
     "id": 1272519,
     "content_html": "<span data-math=\"500s + 200w ≤ 100,000\">500s + 200w ≤ 100,000</span>"
    },
    {
     "id": 1272520,
     "content_html": "<span data-math=\"500s + 200w < 100,000\">500s + 200w &lt; 100,000</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646373,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>Name one solution to the inequality and explain what it represents in that situation.</li>\n</ol>",
   "answers": [
    {
     "id": 1272521,
     "content_html": "<span data-math=\"(300, 90)\">(300, 90)</span>"
    },
    {
     "id": 1272522,
     "content_html": "<span data-math=\"(170, 140)\">(170, 140)</span>"
    },
    {
     "id": 1272523,
     "content_html": "<span data-math=\"(250, 100)\">(250, 100)</span>"
    },
    {
     "id": 1272524,
     "content_html": "<span data-math=\"(200, 130)\">(200, 130)</span>"
    }
   ],
   "hints": [],
