 "questions": [
  {
   "id": 632394,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"1\">\n<li>The height of water in a bathtub, <span data-math=\"w\">w</span>, is a function of time, <span data-math=\"t\">t</span>. Let <span data-math=\"P\">P</span> represent this function. Height is measured in inches and time in minutes.<br><br>\nWhat does each equation mean in this situation?</li>\n</ol>\n<ol class=\"os-raise-noindent\" start=\"1\" type=\"a\">\n  <li><span data-math=\"P(0) = 0\">P(0) = 0</span></li>\n</ol>",
   "answers": [
    {
     "id": 1224536,
     "content_html": "The height of the water is 10 inches after 4 minutes."
    },
    {
     "id": 1224535,
     "content_html": "After 10 minutes, the height of the water is 4 inches."
    },
    {
     "id": 1224537,
     "content_html": "The bathtub starts out with no water."
    },
    {
     "id": 1224534,
     "content_html": "After 20 minutes, the bathtub is empty."
    }
   ],
