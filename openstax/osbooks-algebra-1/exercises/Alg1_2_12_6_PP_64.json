 "is_vocab": false,
 "stimulus_html": "<p>For questions 1 – 4, use the following scenario:</p>\n<blockquote>\n  <p>Harrison works two part time jobs. One at a gas station that pays $11 an hour and the other is IT troubleshooting for $16.50 an hour. Between the two jobs, Harrison wants to earn at least $330 a week. How many hours does Harrison need to work at each job to earn at least $330?</p>\n</blockquote>",
 "questions": [
  {
   "id": 646341,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"1\">\n<li>Let <span data-math=\"x\">x</span> be the number of hours he works at the gas station and let <span data-math=\"y\">y</span> be the number of hours he works troubleshooting. Which inequality correctly models this situation?</li>\n</ol>",
   "answers": [
    {
     "id": 1272400,
     "content_html": "<span data-math=\"16.5y + 11x > 330\">16.5y + 11x &gt; 330</span>"
    },
    {
     "id": 1272401,
     "content_html": "<span data-math=\"11x + 16.5y ≤ 330\">11x + 16.5y ≤ 330</span>"
    },
    {
     "id": 1272402,
     "content_html": "<span data-math=\"16.5x + 11y ≥ 330\">16.5x + 11y ≥ 330</span>"
    },
    {
     "id": 1272403,
     "content_html": "<span data-math=\"11x + 16.5y ≥ 330\">11x + 16.5y ≥ 330</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
