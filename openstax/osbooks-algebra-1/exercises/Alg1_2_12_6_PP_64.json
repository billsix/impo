   "stimulus_html": "",
   "stem_html": "<ol start=\"4\">\n<li>Which of the following is true about the solution you found in the previous question?</li>\n</ol>",
   "answers": [
    {
     "id": 1272412,
     "content_html": "The solution represents a work schedule that earns him more than $330 per week."
    },
