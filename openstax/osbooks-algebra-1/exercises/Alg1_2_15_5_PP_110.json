 "questions": [
  {
   "id": 646409,
   "is_answer_order_important": false,
   "stimulus_html": "For questions 1 – 4, use this scenario:\nJada has <span data-math=\"p\">p</span> pennies and <span data-math=\"n\">n</span> nickels that add up to more than 40 cents. She has fewer than 20 coins altogether.",
   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li>Which two inequalities could make up a system of inequalities that represents how many pennies and nickels that Jada could have? Select <strong>two</strong> inequalities.</li>\n</ol>\n<ol type=\"a\">\n  <li><span data-math=\"p+n<20\">p+n&lt;20</span></li>\n  <li><span data-math=\"p+n>20\">p+n&gt;20</span></li>\n  <li><span data-math=\"0.01p + 0.05n <0.40\">0.01p + 0.05n &lt;0.40</span></li>\n  <li><span data-math=\"0.01p + 0.05n >0.40\">0.01p + 0.05n &gt;0.40</span></li>\n</ol>",
