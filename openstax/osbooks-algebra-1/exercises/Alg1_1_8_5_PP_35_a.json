   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n  <li>Choose the equation that would make it easy to find the rate at which the car was traveling in miles per hour <span data-math=\"r\">r</span>, if it traveled for <span data-math=\"t\">t</span> hours.</li>\n</ol>",
   "answers": [
    {
     "id": 1270952,
     "content_html": "<span data-math=\"r-180-t\">r-180-t</span>"
    },
    {
     "id": 1270953,
     "content_html": "<span data-math=\"r=180t\">r=180t</span>"
    },
    {
     "id": 1270954,
     "content_html": "<span data-math=\"r=\\frac{180}t\">r=\\frac{180}t</span>"
    },
    {
