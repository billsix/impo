 "questions": [
  {
   "id": 631658,
   "is_answer_order_important": false,
   "stem_html": "Marcus works&nbsp;<span data-math=\"s\">s</span> hours per week stocking shelves. He works&nbsp;<span data-math=\"m\">m</span> hours per week mowing lawns. Marcus works at least 8 hours per week stocking shelves. He works at most a total of 20 hours per week. Which of the following represent constraints for this situation?",
   "answers": [
    {
     "id": 1222240,
     "content_html": "<span data-math=\"s + m \\le 20; s \\le 8\">s + m \\le 20; s \\le 8</span>"
    },
    {
     "id": 1222241,
     "content_html": "<span data-math=\"s + m \\ge 20; s \\le 8\">s + m \\ge 20; s \\le 8</span>"
    },
    {
     "id": 1222243,
     "content_html": "<span data-math=\"s + m \\le 20; s \\ge 8\">s + m \\le 20; s \\ge 8</span>"
    },
    {
     "id": 1222242,
     "content_html": "<span data-math=\"s + m \\ge 20; s \\ge 8\">s + m \\ge 20; s \\ge 8</span>"
