   "id": 632461,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>The squirrel runs up the tree very fast. The average rate of change is -</li>\n</ol>",
   "answers": [
