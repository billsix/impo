   "id": 631759,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p>Which function represents <span data-math=\"g(x)\">g(x)</span>, a function transformed from <span data-math=\"f(x)\">f(x)</span> by a horizontal compression?</p>",
   "answers": [
    {
     "id": 1222646,
     "content_html": "<span data-math=\"g(x) = f(x + 5)\">g(x) = f(x + 5)</span>"
    },
    {
     "id": 1222645,
     "content_html": "<span data-math=\"g(x) = f(x) + 5\">g(x) = f(x) + 5</span>"
    },
    {
     "id": 1222647,
     "content_html": "<span data-math=\"g(x) = f(5x)\">g(x) = f(5x)</span>"
    },
    {
     "id": 1222644,
     "content_html": "<span data-math=\"g(x) = 5f(x)\">g(x) = 5f(x)</span>"
    }
