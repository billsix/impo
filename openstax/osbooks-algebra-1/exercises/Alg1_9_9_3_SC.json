  {
   "id": 631909,
   "is_answer_order_important": false,
   "stem_html": "Which of the following is the quadratic equation of the quadratic with a vertex of <span data-math=\"(4, -2)\">(4, -2)</span> that also goes through the point <span data-math=\"(6, 5)\">(6, 5)</span>?",
   "answers": [
    {
     "id": 1223244,
     "content_html": "<span data-math=\"y=\\frac{4}{7}(x-6)^2-5\">y=\\frac{4}{7}(x-6)^2-5</span>"
    },
    {
     "id": 1223245,
     "content_html": "<span data-math=\"y=\\frac{7}{4}(x-6)^2-5\">y=\\frac{7}{4}(x-6)^2-5</span>"
    },
