   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li><strong>Select three</strong> quadratic expressions written in vertex form.</li>\n</ol>\n<ol type=\"a\">\n  <li><span data-math=\"y=(x-2)^2 + 1\">y=(x-2)^2 + 1</span></li>\n  <li><span data-math=\"y=x^2 - 4\">y=x^2 - 4</span></li>\n  <li><span data-math=\"y=x(x+1)\">y=x(x+1)</span></li>\n  <li><span data-math=\"y=(x+3)(x+3)\">y=(x+3)(x+3)</span></li>\n  <li><span data-math=\"y=(x-4)^2 + 6\">y=(x-4)^2 + 6</span></li>\n</ol>",
