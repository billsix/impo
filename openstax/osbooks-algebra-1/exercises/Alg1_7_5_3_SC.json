 "questions": [
  {
   "id": 631840,
   "is_answer_order_important": false,
   "stem_html": "A small ball is dropped from a 350-foot-tall building. Which equation could represent the ball’s height, <span data-math=\"h(t)\">h(t)</span>, in feet, relative to the ground, as a function of time, <span data-math=\"t\">t</span>, in seconds?",
   "answers": [
    {
     "id": 1222968,
     "content_html": "<span data-math=\"h(t)=\\frac{350}{16t^2}\">h(t)=\\frac{350}{16t^2}</span>"
    },
    {
     "id": 1222969,
     "content_html": "<span data-math=\"h(t)=350+16t^2\">h(t)=350+16t^2</span>"
    },
    {
     "id": 1222971,
     "content_html": "<span data-math=\"h(t)=350-16t^2\">h(t)=350-16t^2</span>"
    },
    {
     "id": 1222970,
     "content_html": "<span data-math=\"h(t)=350-16t\">h(t)=350-16t</span>"
    }
   ],
