   "id": 645870,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"1\">\n<li>Which equation is equivalent to <span data-math=\"3x + 6 = 4x + 7\">3x + 6 = 4x + 7</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1270869,
     "content_html": "<span data-math=\"3x=4x+7\">3x=4x+7</span>"
    },
    {
     "id": 1270870,
     "content_html": "<span data-math=\"3x-1=4x\">3x-1=4x</span>"
    },
    {
     "id": 1270871,
     "content_html": "<span data-math=\"9x=4x+7\">9x=4x+7</span>"
    },
    {
     "id": 1270872,
     "content_html": "<span data-math=\"3x+18=4x+7\">3x+18=4x+7</span>"
    },
    {
     "id": 1270873,
     "content_html": "<span data-math=\"7x=1\">7x=1</span>"
    }
