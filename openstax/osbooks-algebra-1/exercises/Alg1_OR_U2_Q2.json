   "id": 573373,
   "is_answer_order_important": false,
   "stem_html": "What is the slope and <span data-math=\"y\">y</span>-intercepts of the line&nbsp;<span data-math=\"3x - y= 12\">3x - y= 12</span>?",
   "answers": [
    {
     "id": 1119522,
     "content_html": "<span><span data-math=\"m=\\frac{3}{12}\">m=\\frac{3}{12}</span></span>; y-intercept <span data-math=\"= (3, - 12)\">= (3, - 12)</span>"
    },
    {
     "id": 1119521,
     "content_html": "<span><span data-math=\"m=\\frac{12}{3}\">m=\\frac{12}{3}</span></span>; y-intercept <span data-math=\"= (3, - 1)\">= (3, - 1)</span>"
    },
    {
     "id": 1119520,
     "content_html": "<span><span data-math=\"m=\\frac13\">m=\\frac13</span></span>; y-intercept <span data-math=\"= (- 12, 0)\">= (- 12, 0)</span>"
    },
    {
     "id": 1119523,
     "content_html": "<span><span data-math=\"m=\\frac31\">m=\\frac31</span></span>; y-intercept <span data-math=\"= (0, - 12)\">= (0, - 12)</span>"
    }
