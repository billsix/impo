   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"1\">\n  <li><strong>Select three </strong>expressions that are equivalent to <span data-math=\"3^8\">3^8</span>.</li>\n</ol>\n<ol start=\"1\" type=\"a\">\n  <li><span data-math=\"8^3\">8^3</span></li>\n  <li><span data-math=\"\\frac{3^{10}}{3^2}\">\\frac{3^{10}}{3^2}</span></li>\n  <li><span data-math=\"3\\cdot 8\">3\\cdot 8</span></li>\n  <li><span data-math=\"\\left(3^4\\right)^2\">\\left(3^4\\right)^2</span></li>\n  <li><span data-math=\"\\left(3\\cdot3\\right)^4\">\\left(3\\cdot3\\right)^4</span></li>\n  <li><span data-math=\"\\frac1{3^8}\">\\frac1{3^8}</span></li>\n</ol>",
