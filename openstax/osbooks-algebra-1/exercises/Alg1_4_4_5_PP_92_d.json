   "id": 632420,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\" type=\"1\">\n  <li>Write a function <span data-math=\"g(x)\">g(x)</span> for the following statement: to get the output, subtract 4 from the input, then multiply the result by 2.</li>\n</ol>",
   "answers": [
    {
     "id": 1224626,
     "content_html": "<span data-math=\"g(x)=2(x-4)\">g(x)=2(x-4)</span>"
    },
    {
     "id": 1224625,
     "content_html": "<span data-math=\"g(x)=x -8\">g(x)=x -8</span>"
    },
    {
     "id": 1224624,
     "content_html": "<span data-math=\"g(x)=-4-2x\">g(x)=-4-2x</span>"
    },
    {
     "id": 1224623,
     "content_html": "<span data-math=\"g(x)=2x-4\">g(x)=2x-4</span>"
    }
   ],
