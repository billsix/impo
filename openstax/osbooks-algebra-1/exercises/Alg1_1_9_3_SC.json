 "questions": [
  {
   "id": 631675,
   "is_answer_order_important": false,
   "stem_html": "A farmer makes money selling pumpkins and apples in the fall. His revenue, M, is made from selling pumpkins, p, for $4.00 and apples, a, for $0.75. Which equation is solved to help him find out how many pumpkins he sold?",
   "answers": [
    {
     "id": 1222308,
     "content_html": "<span data-math=\"p= \\frac{m}{4.00}\">p= \\frac{m}{4.00}</span>"
    },
    {
     "id": 1222309,
     "content_html": "<span data-math=\"a= \\frac{M-4.00p}{1.75}\">a= \\frac{M-4.00p}{1.75}</span>"
    },
    {
     "id": 1222310,
     "content_html": "<span data-math=\"M=4.00p+0.75a\">M=4.00p+0.75a</span>"
    },
    {
     "id": 1222311,
     "content_html": "<span data-math=\"p= \\frac{M-0.75a}{4.00}\">p= \\frac{M-0.75a}{4.00}</span>"
    }
   ],
