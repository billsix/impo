  {
   "id": 669020,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"a\">\n  <li>Is the rate of change between weeks 1 and 2 greater than or less than the rate of change between weeks 3 and 4?</li>\n  </ol>",
