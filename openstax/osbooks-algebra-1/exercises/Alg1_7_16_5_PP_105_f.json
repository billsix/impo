   "id": 668094,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n    <li>Choose the equation that matches the graph of parabola D .</li>\n  </ol>\n  <p><img height=\"219\" src=\"exercises/media/dba761697787851a.svg\" width=\"268\" alt=\"A 2D line graph shows four functions x(t), y(t), z(t), and f(t). A black line represents x(t), a blue line y(t), a green line z(t), and a red line f(t). All lines generally increase across the graph.\"></p>",
   "answers": [
    {
     "id": 1332611,
     "content_html": "<span data-math=\"y=-\\frac {1}{3}(x−6)^2−5\">y=-\\frac {1}{3}(x−6)^2−5</span>"
    },
    {
     "id": 1332612,
     "content_html": "<span data-math=\"y=6(x−6)^2−5\">y=6(x−6)^2−5</span>"
    },
    {
     "id": 1332613,
     "content_html": "<span data-math=\"y=(x−6)^2−5\">y=(x−6)^2−5</span>"
    },
    {
     "id": 1332614,
     "content_html": "<span data-math=\"y=-2(x−6)^2−5\">y=-2(x−6)^2−5</span>"
    }
   ],
