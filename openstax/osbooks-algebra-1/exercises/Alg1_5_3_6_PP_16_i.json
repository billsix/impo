 "questions": [
  {
   "id": 645968,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"10\" type=\"1\">\n  <li>Bank account C starts with $10 and doubles each week. Bank account D starts with $1,000 and grows by $500 each week. When will account C contain more money than account D?\n  </li>\n</ol>",
   "answers": [
    {
     "id": 1271174,
     "content_html": "Account C will contain more money than account D after 10 weeks."
    },
    {
     "id": 1271175,
     "content_html": "Account C will contain more money than account D after 7 weeks."
    },
    {
     "id": 1271176,
     "content_html": "Account C will never contain more money than account D."
    },
    {
     "id": 1271177,
     "content_html": "Account C will contain more money than account D after 2 weeks."
    }
   ],
