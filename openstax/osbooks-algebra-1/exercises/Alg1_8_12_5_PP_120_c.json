 "questions": [
  {
   "id": 648553,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p>For questions 5 – 9, use the following information.</p>\n<blockquote>\nThe path of a toy rocket after launch is modeled by the following data set. The height of the rocket, in feet, <span data-math=\"y\">y</span>, corresponds to the number of seconds passed, <span data-math=\"x\">x</span>.\n<table class=\"unnumbered\">\n      <thead>\n        <tr>\n          <th scope=\"col\"><span data-math=\"x_1\">x_1</span></th>\n          <th scope=\"col\"><span data-math=\"y_1\">y_1</span></th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>0.4</td>\n          <td>20</td>\n        </tr>\n        <tr>\n          <td>1</td>\n          <td>41</td>\n        </tr>\n        <tr>\n          <td>1.5</td>\n          <td>52</td>\n        </tr>\n        <tr>\n          <td>2.3</td>\n          <td>60</td>\n        </tr>\n        <tr>\n          <td>3.5</td>\n          <td>52</td>\n        </tr>\n      </tbody>\n    </table>\n</blockquote>\n<br><ol class=\"os-raise-noindent\" start=\"5\">\n  <li>What is the equation for the curve of best fit that models the flight of the toy rocket?</li>\n</ol>",
   "answers": [
    {
     "id": 1279023,
     "content_html": "<span data-math=\"y = -9.2x^2+ 46x + 3.51\">y = -9.2x^2+ 46x + 3.51</span>"
    },
    {
     "id": 1279024,
     "content_html": "<span data-math=\"y = -4.2x^2 + 34x + 6.34\">y = -4.2x^2 + 34x + 6.34</span>"
    },
    {
     "id": 1279025,
     "content_html": "<span data-math=\"y = -11.9x^2+ 30.2x + 3.64\">y = -11.9x^2+ 30.2x + 3.64</span>"
    },
    {
     "id": 1279026,
     "content_html": "<span data-math=\"y = -6.1x^2+ 31x + 1.24\">y = -6.1x^2+ 31x + 1.24</span>"
    }
   ],
