   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li>The expression <span data-math=\"9t + 7.25\">9t + 7.25</span> represents the cost to purchase tickets for a concert, where <span data-math=\"t\">t</span> is the number of tickets. A group of friends paid $79.25 for tickets. How many tickets were bought?</li>\n</ol>",
   "answers": [
    {
     "id": 1225915,
     "content_html": "12 tickets"
    },
    {
     "id": 1225916,
     "content_html": "10 tickets"
    },
    {
