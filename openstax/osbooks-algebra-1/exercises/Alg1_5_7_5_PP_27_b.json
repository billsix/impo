   "id": 648487,
   "is_answer_order_important": false,
   "stimulus_html": "For questions 3 – 5, use the following scenario:\n<blockquote>\nA medicine is applied to a burn on a patient’s arm. The area of the burn in square centimeters decreases exponentially and is shown in the graph. <br><br>       <p><img alt=\"Graph of a function on grid.\" src=\"exercises/media/347a4b96c9fe6927.svg\"></p>\n</blockquote>",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"1\">\n<li>What fraction of the burn area remains each week?</li>\n  </ol>",
   "answers": [
    {
     "id": 1278927,
     "content_html": "<span data-math=\"\\frac23\">\\frac23</span> or <span data-math=\"0.66\">0.66</span>"
    },
    {
     "id": 1278928,
     "content_html": "<span data-math=\"\\frac14\">\\frac14</span> or <span data-math=\"0.25\">0.25</span>"
    },
    {
     "id": 1278929,
     "content_html": "<span data-math=\"\\frac34\">\\frac34</span> or <span data-math=\"0.75\">0.75</span>"
    },
    {
     "id": 1278930,
     "content_html": "<span data-math=\"\\frac12\">\\frac12</span> or <span data-math=\"0.5\">0.5</span>"
    }
