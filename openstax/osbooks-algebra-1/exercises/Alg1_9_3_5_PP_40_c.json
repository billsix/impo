 "stimulus_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n  <li>Noah is solving the equation <span data-math=\"x^2+8x+15=3\">x^2+8x+15=3</span>. He begins by rewriting the expression on the left in factored form and writes <span data-math=\"(x+3)(x+5)=3\">(x+3)(x+5)=3</span>. He does not know what to do next.&nbsp;</li>\n</ol>",
 "questions": [
  {
   "id": 646426,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" type=\"a\">\n  <li>Do you think using the factored form is the best way for Noah to solve this equation?</li>\n</ol>",
   "answers": [
    {
     "id": 1272622,
     "content_html": "No"
    },
    {
     "id": 1272623,
     "content_html": "Yes"
    }
   ],
