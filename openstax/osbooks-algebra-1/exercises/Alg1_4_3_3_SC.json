 "questions": [
  {
   "id": 631737,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">The function <span data-math=\"C\">C</span> gives the temperature, in degrees Fahrenheit, of a pot of coffee <span data-math=\"x\">x</span> minutes after it is made.</p>\n<p>What does the statement <span data-math=\"C(10)<C(5)\">C(10)&lt;C(5)</span> mean in the context of the problem?  \n</p>",
   "answers": [
    {
     "id": 1222556,
     "content_html": "The temperature of coffee after 10 hours was cooler than after 5 hours."
    },
    {
     "id": 1222557,
     "content_html": "The temperature of the coffee after 10 minutes was warmer than after 5 minutes."
    },
    {
     "id": 1222559,
     "content_html": "The temperature of the coffee after 10 minutes was cooler than after 5 minutes."
    },
    {
     "id": 1222558,
     "content_html": "The coffee pot has less coffee in it after 10 minutes than after 5 minutes."
    }
   ],
