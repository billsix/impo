   "id": 645945,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li>slope 3 and <span data-math=\"y\">y</span>-intercept <span data-math=\"( 0,5)\">( 0,5)</span></li>\n</ol>",
