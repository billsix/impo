    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646690,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"1\">\n  <li>Tell the transformations from <span data-math=\"f(x)=2x+3\">f(x)=2x+3</span> to <span data-math=\"h(x)=-2x+2\">h(x)=-2x+2</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1273313,
     "content_html": "Vertical stretch, left 1"
    },
    {
     "id": 1273314,
     "content_html": "Vertical stretch, right 1"
    },
    {
     "id": 1273315,
     "content_html": "Vertical reflection, down 1"
    },
    {
     "id": 1273316,
     "content_html": "Vertical reflection, up 1"
    }
   ],
