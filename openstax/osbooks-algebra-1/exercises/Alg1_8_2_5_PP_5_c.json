 "is_vocab": false,
 "stimulus_html": "<p>Use the following scenario to answer questions 9 – 10.</p>\n<blockquote>\n  <p>A bowling alley models the revenue from sales in one day as a function of the cost to rent a lane per hour, <span data-math=\"c\">c</span>. Here are two expressions defining the same revenue function.</p>\n  <p><span data-math=\"c(160 − 10c)\">c(160 − 10c)</span></p>\n  <p><span data-math=\"160c − 10c^2\">160c − 10c^2</span></p>\n</blockquote>",
 "questions": [
  {
   "id": 648407,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\">\n  <li>According to this model, how high would the cost to rent a lane have to be for the bowling alley to make $0 in revenue?</li>\n</ol>",
   "answers": [
    {
     "id": 1278631,
     "content_html": "16.0"
    },
    {
     "id": 1278632,
     "content_html": "14.0"
    },
    {
     "id": 1278633,
     "content_html": "10.0"
    },
    {
     "id": 1278634,
     "content_html": "8.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 648408,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"10\">\n  <li>What equation can you write to determine the lane cost that would allow the bowling alley to make $640 in revenue?</li>\n</ol>",
   "answers": [
    {
     "id": 1278635,
     "content_html": "<span data-math=\"160c − 10c^2 = 0\">160c − 10c^2 = 0</span>"
    },
    {
     "id": 1278636,
     "content_html": "<span data-math=\"160c − 10c^2 + 640 = 0\">160c − 10c^2 + 640 = 0</span>"
    },
    {
     "id": 1278637,
     "content_html": "<span data-math=\"c(160 − 10c) = 640\">c(160 − 10c) = 640</span>"
    },
    {
     "id": 1278638,
     "content_html": "<span data-math=\"c(160 − 10c) = 0\">c(160 − 10c) = 0</span>"
    }
   ],
