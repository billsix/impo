 "questions": [
  {
   "id": 632618,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\" type=\"1\">\n  <li>Given a formula for an exponential function, is it possible to determine whether the function grows or decays exponentially just by looking at the formula? Explain.</li>\n</ol>",
   "answers": [
    {
     "id": 1225094,
     "content_html": "No, it is not possible to determine growth and decay from the formula."
    },
    {
     "id": 1225095,
     "content_html": "Yes, if the growth rate is greater than one it’s growth; if the growth rate is, less than zero it’s decay."
    },
    {
     "id": 1225097,
     "content_html": "Yes, if the growth rate is between zero and one it’s decay; if the growth rate is greater than one it is growth."
    },
    {
     "id": 1225096,
     "content_html": "Yes, if the initial value is greater than one it’s growth; if the initial value is less than one it’s decay."
    }
   ],
