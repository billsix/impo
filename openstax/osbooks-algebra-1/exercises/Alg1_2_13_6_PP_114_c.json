 "is_vocab": false,
 "stimulus_html": "<p>For questions 5 – 7, use the passage below to answer the questions:</p>\n<blockquote>\n  <p>Amira is ordering dried chili peppers and corn husks for her cooking class. Chili peppers cost $16.95 per pound and corn husks cost $6.49 per pound.</p>\n  <p>Amira spends less than $50 on <span data-math=\"d\">d</span> pounds of dried chili peppers and <span data-math=\"h\">h</span> pounds of corn husks.</p>\n  <p>Here is a graph that represents this situation.</p>\n <img alt=\"Inequality on grid.\" src=\"exercises/media/a9e66391709c90cf.svg\"></blockquote>",
 "questions": [
  {
   "id": 646377,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\">\n  <li>Write an inequality that represents this situation.</li>\n</ol>",
   "answers": [
    {
     "id": 1272533,
     "content_html": "<span data-math=\"16.95d + 6.49h > 50\">16.95d + 6.49h &gt; 50</span>"
    },
    {
     "id": 1272534,
     "content_html": "<span data-math=\"16.95d + 6.49h < 50\">16.95d + 6.49h &lt; 50</span>"
    },
    {
     "id": 1272535,
     "content_html": "<span data-math=\"16.95d - 6.49h < 50\">16.95d - 6.49h &lt; 50</span>"
    },
    {
     "id": 1272536,
     "content_html": "<span data-math=\"16.95d + 6.49h ≥ 50\">16.95d + 6.49h ≥ 50</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646378,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n  <li>Can Amira purchase 2 pounds of dried chili peppers and 4 pounds of corn husks and spend less than $50? Be prepared to show your reasoning.</li>\n</ol>",
   "answers": [
    {
     "id": 1272537,
     "content_html": "Yes"
    },
    {
     "id": 1272538,
     "content_html": "No"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646379,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n  <li>Can Amira purchase 1.5 pounds of dried chili peppers and 3 pounds of corn husks and spend less than $50? Be prepared to show your reasoning.</li>\n</ol>",
