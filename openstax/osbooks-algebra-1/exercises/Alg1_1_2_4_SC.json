 "questions": [
  {
   "id": 631661,
   "is_answer_order_important": false,
   "stem_html": "Sweet’s Candy Store charges $5.00 to fill a bag of candy. There is also a sales tax of 7% per purchase. Mrs. Smith buys 4 bags of candy for her children for Christmas. What is an equation that can represent the cost of the candy that Mrs. Smith buys?",
   "answers": [
    {
     "id": 1222252,
     "content_html": "<span data-math=\"C=0.07+4(5)\">C=0.07+4(5)</span>"
    },
    {
     "id": 1222253,
     "content_html": "<span data-math=\"C=4(5)\">C=4(5)</span>"
    },
    {
     "id": 1222254,
     "content_html": "<span data-math=\"C=0.07(4(5))\">C=0.07(4(5))</span>"
    },
    {
     "id": 1222255,
     "content_html": "<span data-math=\"C=0.07(4(5))+4(5)\">C=0.07(4(5))+4(5)</span>"
    }
