  {
   "id": 648629,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"1\">\n  <li>Here are 4 equations defining 4 different functions, <span data-math=\"a, b, c\">a, b, c</span>, and <span data-math=\"d\">d</span>. List them in order of increasing rate of change. That is, start with the one that grows the slowest and end with the one that grows the quickest.<br>     <ul>\n      <li><span data-math=\"a(x)=5x+3\">a(x)=5x+3</span></li>\n      <li><span data-math=\"b(x)=3x+5\">b(x)=3x+5</span></li>\n      <li><span data-math=\"c(x)=x+4\">c(x)=x+4</span></li>\n      <li><span data-math=\"d(x)=1+4x\">d(x)=1+4x</span></li>\n    </ul>\n</li>\n</ol>",
   "answers": [
    {
     "id": 1279241,
     "content_html": "Option 1: <span data-math=\"a(x)\">a(x)</span>, <span data-math=\"b(x)\">b(x)</span>, <span data-math=\"c(x)\">c(x)</span>, <span data-math=\"d(x)\">d(x)</span>"
    },
    {
     "id": 1279242,
     "content_html": "Option 2: <span data-math=\"d(x)\">d(x)</span>, <span data-math=\"c(x)\">c(x)</span>, <span data-math=\"b(x)\">b(x)</span>, <span data-math=\"a(x)\">a(x)</span>"
    },
    {
     "id": 1279243,
     "content_html": "Option 3: <span data-math=\"a(x)\">a(x)</span>,<span data-math=\"d(x)\">d(x)</span>, <span data-math=\"b(x)\">b(x)</span>, <span data-math=\"a(x)\">a(x)</span>"
    },
    {
     "id": 1279244,
     "content_html": "Option 4: <span data-math=\"c(x)\">c(x)</span>, <span data-math=\"b(x)\">b(x)</span>, <span data-math=\"d(x)\">d(x)</span>, <span data-math=\"a(x)\">a(x)</span>"
    }
   ],
