 "questions": [
  {
   "id": 631858,
   "is_answer_order_important": false,
   "stem_html": "<p>Which equation describes the graph below?</p>\n<p><img alt=\"GRAPH OF A PARABOLA THAT OPENS UPWARD WITH A \\(y\\)-intercepts OF NEGATIVE 12 AND \\(x\\)-intercepts OF NEGATIVE 4 AND 3.\" height=\"302\" src=\"exercises/media/917e28044022b6e3.png\" width=\"300\"></p>",
   "answers": [
    {
     "id": 1223040,
     "content_html": "<span data-math=\"f(x) = x(x + 3)\">f(x) = x(x + 3)</span>"
    },
    {
     "id": 1223041,
     "content_html": "<span data-math=\"f(x) = x + 12\">f(x) = x + 12</span>"
    },
    {
     "id": 1223043,
     "content_html": "<span data-math=\"f(x) = (x - 3)(x + 4)\">f(x) = (x - 3)(x + 4)</span>"
    },
    {
     "id": 1223042,
     "content_html": "<span data-math=\"f(x) = (x + 3)(x - 4)\">f(x) = (x + 3)(x - 4)</span>"
    }
   ],
