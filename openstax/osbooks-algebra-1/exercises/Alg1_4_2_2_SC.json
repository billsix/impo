   "stimulus_html": "",
   "stem_html": "<p dir=\"ltr\">A function <span data-math=\"f(y) = N\">f(y) = N</span> gives the number of police officers, <span data-math=\"N\">N</span>, in a town in year <span data-math=\"y\">y</span>. What does <span data-math=\"f(2005)=300\">f(2005)=300</span> represent?</p>",
   "answers": [
    {
     "id": 1222546,
     "content_html": "In the year 2005, there were 300 more police officers than in 2004."
    },
    {
     "id": 1222547,
     "content_html": "In the year 2005, there were 300 police officers."
    },
    {
     "id": 1222545,
     "content_html": "At year 300, there were 2005 police officers."
    },
    {
     "id": 1222544,
     "content_html": "After 2005 years, there were 300 police officers."
    }
