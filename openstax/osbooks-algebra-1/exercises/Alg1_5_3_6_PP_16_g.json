   "id": 632564,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\" type=\"1\">\n  <li>A swimming pool contains 500 gallons of water. A hose is turned on, and it fills the pool at a rate of 24 gallons per minute. Which expression represents the amount of water in the pool, in gallons, after 8 minutes?</li>\n</ol>",
   "answers": [
    {
     "id": 1224948,
     "content_html": "<span data-math=\"500\\cdot 248\">500\\cdot 248</span>"
    },
    {
     "id": 1224951,
     "content_html": "<span data-math=\"500+24 \\cdot 8\">500+24 \\cdot 8</span>"
    },
