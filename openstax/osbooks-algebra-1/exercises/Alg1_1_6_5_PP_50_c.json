   "stimulus_html": "",
   "stem_html": "<ol start=\"4\">\n<li><strong>Select two </strong>of the following that are equivalent to <span data-math=\"3x -6 =12.\">3x -6 =12.</span></li>\n</ol><ol start=\"1\" type=\"a\">\n  <li><span data-math=\"3x = 6\">3x = 6</span></li>\n  <li><span data-math=\"3(x-2) = 12\">3(x-2) = 12</span></li>\n  <li><span data-math=\"x - 2 =4\">x - 2 =4</span></li>\n  <li><span data-math=\"x - 2 = 12\">x - 2 = 12</span></li>\n  <li><span data-math=\"x -6 = 4\">x -6 = 4</span></li>\n</ol>",
