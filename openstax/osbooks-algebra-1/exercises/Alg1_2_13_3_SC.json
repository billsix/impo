 "questions": [
  {
   "id": 631713,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p dir=\"ltr\">Veronica works two part time jobs in order to earn enough money to meet her obligations of at least $280 a week. Her job at the day spa pays $10 an hour and her administrative assistant job on campus pays $17.50 an hour.&nbsp;</p>\n<p dir=\"ltr\">Which of the following is a solution that allows Veronica to earn enough money?</p>",
   "answers": [
    {
     "id": 1222463,
     "content_html": "5 hours at the day spa and 15 hours as an administrative assistant"
    },
    {
     "id": 1222462,
     "content_html": "15 hours at the day spa and 5 hours as an administrative assistant"
    },
    {
     "id": 1222461,
     "content_html": "<span>10 hours at the day spa and 10 hours as an administrative assistant</span>"
    },
    {
     "id": 1222460,
     "content_html": "<p dir=\"ltr\">5 hours at the day spa and 10 hours as an administrative assistant</p>\n<p dir=\"ltr\"><br></p>"
    }
   ],
