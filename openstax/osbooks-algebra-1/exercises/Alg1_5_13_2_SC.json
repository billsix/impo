 "questions": [
  {
   "id": 631806,
   "is_answer_order_important": false,
   "stem_html": "<p>Which of the following is the function for the curve graphed below?</p>\n<p><img alt=\"GRAPH OF AN EXPONENTIAL GROWTH FUNCTION. THE GRAPH PASSES THROUGH THE POINTS 0 COMMA 100, 1 COMMA THREE HUNDRED, AND 2 COMMA 900.\" src=\"exercises/media/d866b2729b77b9ec.jpg\" width=\"300\"></p>",
   "answers": [
    {
     "id": 1222834,
     "content_html": "<span data-math=\"f(x)=(100^3)^x\">f(x)=(100^3)^x</span>"
    },
    {
     "id": 1222835,
     "content_html": "<span data-math=\"f(x)=100 \\cdot 3^x\">f(x)=100 \\cdot 3^x</span>"
    },
    {
     "id": 1222833,
     "content_html": "<span data-math=\"f(x)=3 \\cdot 100^x\">f(x)=3 \\cdot 100^x</span>"
    },
    {
     "id": 1222832,
     "content_html": "<span data-math=\"f(x)=100+3^x\">f(x)=100+3^x</span>"
    }
   ],
