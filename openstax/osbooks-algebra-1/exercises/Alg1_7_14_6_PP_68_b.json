 "is_vocab": false,
 "stimulus_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>The height in feet of a thrown football is modeled by the equation <span data-math=\"f(t)=6+30t−16t^2\">f(t)=6+30t−16t^2</span>, where time <span data-math=\"t\">t</span> is measured in seconds.</li>\n</ol>",
 "questions": [
  {
   "id": 669180,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" type=\"a\">\n  <li>Which term in the equation describes how many feet above the ground the football was thrown?</li>\n  </ol>",
   "answers": [
    {
     "id": 1334051,
     "content_html": "The squared term <span data-math=\"16t^2\">16t^2</span>"
    },
    {
     "id": 1334052,
     "content_html": "The squared term <span data-math=\"-16t^2\">-16t^2</span>"
    },
    {
     "id": 1334053,
     "content_html": "The linear term <span data-math=\"30t\">30t</span>"
    },
    {
     "id": 1334054,
     "content_html": "The constant term 6"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "stimulus_html": ""
  },
  {
   "id": 669181,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"a\">\n  <li>Which term in the equation describes the initial upward velocity of the football in feet per second?</li>\n  </ol>",
   "answers": [
    {
     "id": 1334055,
     "content_html": "The squared term <span data-math=\"16t^2\">16t^2</span>"
    },
    {
     "id": 1334056,
     "content_html": "The squared term <span data-math=\"-16t^2\">-16t^2</span>"
    },
    {
     "id": 1334057,
     "content_html": "The linear term <span data-math=\"30t\">30t</span>"
    },
    {
     "id": 1334058,
     "content_html": "The constant term 6"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "stimulus_html": ""
  },
  {
   "id": 669182,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"a\">\n  <li>How does the squared term <span data-math=\"-16t^2\">-16t^2</span> affect the value of the function <span data-math=\"f\">f</span>?</li>\n  </ol>",
   "answers": [
    {
     "id": 1334059,
     "content_html": "The value of the function is zero when <span data-math=\"−16t^2\">−16t^2</span> is zero."
    },
    {
     "id": 1334060,
     "content_html": "The squared term has no effect on the value of the function."
    },
    {
     "id": 1334061,
     "content_html": "The squared term increases the value of the function."
    },
    {
     "id": 1334062,
     "content_html": "The squared term decreases the value of the function."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "stimulus_html": ""
  },
  {
   "id": 669183,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\" type=\"a\">\n  <li>What does this term <span data-math=\"−16t^2\">−16t^2</span> reveal about the situation?</li>\n  </ol>",
   "answers": [
    {
     "id": 1334063,
     "content_html": "How long the ball is in the air before it hits the ground."
    },
    {
     "id": 1334064,
     "content_html": "How far the football was thrown above the ground."
    },
    {
     "id": 1334065,
     "content_html": "The initial upward velocity of the football."
    },
    {
     "id": 1334066,
     "content_html": "The influence of gravity pulling the ball down to the ground."
    }
   ],
