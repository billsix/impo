   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>Looking at the graph below, what does the point <span data-math=\"(1980, 83)\">(1980, 83)</span> mean?</li>\n</ol>\n<img src=\"exercises/media/7ade1e89adbcf375.jpg\" alt=\"GRAPH TITLED &quot;WORLD POPULATION INCREASE&quot; WITH X-AXIS LABEL OF YEAR AND Y-AXIS LABEL OF MILLIONS OF PEOPLE\" width=\"400\">",
   "answers": [
    {
     "id": 1224566,
     "content_html": "There were 83 million more people in 1980 than 1979."
    },
    {
     "id": 1224567,
     "content_html": "In 1980, the world population increased by 83 million people."
    }
   ],
