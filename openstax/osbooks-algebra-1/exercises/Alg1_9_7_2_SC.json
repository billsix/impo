 "questions": [
  {
   "id": 631904,
   "is_answer_order_important": false,
   "stem_html": "<p>When solving <span data-math=\"x^2−30x+26=0\">x^2−30x+26=0</span> using the quadratic formula, Sloane's work showed the formula as this:</p>\n<p><span data-math=\"x=\\frac{-30 \\pm \\sqrt {900-104}}{2}\">x=\\frac{-30 \\pm \\sqrt {900-104}}{2}</span>.</p>\n<p>Which of the following describes the error in her work?</p>",
   "answers": [
    {
     "id": 1223224,
     "content_html": "The discriminant should be <span data-math=\"-900 - 104\">-900 - 104</span>, not <span data-math=\"900 - 104\">900 - 104</span>; <span data-math=\"x=\\frac {-30 \\pm \\sqrt{900-104}}{2}\">x=\\frac {-30 \\pm \\sqrt{900-104}}{2}</span>."
    },
    {
     "id": 1223227,
     "content_html": "The first term in the numerator should be 30, not -30; <span data-math=\"x=\\frac {30 \\pm \\sqrt{900-104}}{2}\">x=\\frac {30 \\pm \\sqrt{900-104}}{2}</span>."
    },
    {
     "id": 1223225,
     "content_html": "The discriminant should be <span data-math=\"900 + 104\">900 + 104</span>, not <span data-math=\"900 - 104\">900 - 104</span>; <span data-math=\"x=\\frac {-30 \\pm \\sqrt{900+104}}{2}\">x=\\frac {-30 \\pm \\sqrt{900+104}}{2}</span>."
    },
    {
     "id": 1223226,
     "content_html": "The denominator should be 4, not 2; <span data-math=\"x=\\frac {-30 \\pm \\sqrt{900-104}}{4}\">x=\\frac {-30 \\pm \\sqrt{900-104}}{4}</span>."
    }
   ],
