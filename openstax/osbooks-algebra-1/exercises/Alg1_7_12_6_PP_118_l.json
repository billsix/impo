   "id": 667751,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"14\">\n  <li>Which function most closely represents the equation for graph c?</li>\n</ol>",
   "answers": [
    {
     "id": 1332059,
     "content_html": "<span data-math=\"f(x) = (\\frac14x)^2\">f(x) = (\\frac14x)^2</span>"
    },
    {
     "id": 1332060,
     "content_html": "<span data-math=\"f(x) = (x + 2.5)^2\">f(x) = (x + 2.5)^2</span>"
    },
    {
     "id": 1332061,
     "content_html": "<span data-math=\"f(x) = (4x)^2\">f(x) = (4x)^2</span>"
    },
    {
     "id": 1332062,
     "content_html": "<span data-math=\"f(x) = (x - 2.5)^2\">f(x) = (x - 2.5)^2</span>"
    }
