 "questions": [
  {
   "id": 632446,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>Write the equation of the line in slope-intercept form that goes through <span data-math=\"(0,3)\">(0,3)</span> and has a slope of <span data-math=\"\\frac14\">\\frac14</span> .</li>\n</ol>",
   "answers": [
    {
     "id": 1224671,
     "content_html": "<span data-math=\"4x - y = -3\">4x - y = -3</span>"
    },
    {
     "id": 1224672,
     "content_html": "<span data-math=\"y = 3x + \\frac{1}{4}\">y = 3x + \\frac{1}{4}</span>"
    },
    {
     "id": 1224674,
     "content_html": "<span data-math=\"y = \\frac{1}{4}x + 3\">y = \\frac{1}{4}x + 3</span>"
    },
    {
     "id": 1224673,
     "content_html": "<span data-math=\"y = -\\frac{1}{4}x + 3\">y = -\\frac{1}{4}x + 3</span>"
    }
   ],
