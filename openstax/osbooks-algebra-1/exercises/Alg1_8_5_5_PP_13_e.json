   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"10\">\n  <li>Which statement is true of the equation <span data-math=\"x^2+9x=0\">x^2+9x=0</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1278699,
     "content_html": "The solutions are <span data-math=\"x=9\">x=9</span> and <span data-math=\"x=-9\">x=-9</span>."
    },
    {
     "id": 1278700,
     "content_html": "The solutions are <span data-math=\"x=0\">x=0</span> and <span data-math=\"x=-9\">x=-9</span>."
    },
    {
     "id": 1278701,
     "content_html": "The solution is <span data-math=\"x=-9\">x=-9</span>."
    },
    {
     "id": 1278702,
     "content_html": "The equation has no solutions."
    }
