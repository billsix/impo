   "id": 648475,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"10\">\n  <li>Write the specific quadratic function, <span data-math=\"w(x)\">w(x)</span>, in standard form, that has the zeros <span data-math=\"6\">6</span> and <span data-math=\"-7\">-7</span> and passes through the point <span data-math=\"(5, 12)\">(5, 12)</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1278879,
     "content_html": "<span data-math=\"w(x) = −x^2 − x + 42\">w(x) = −x^2 − x + 42</span>"
    },
    {
     "id": 1278880,
     "content_html": "<span data-math=\"w(x) = −2x^2 − 2x + 84\">w(x) = −2x^2 − 2x + 84</span>"
    },
    {
     "id": 1278881,
     "content_html": "<span data-math=\"w(x) = 2x^2 + 2x − 48\">w(x) = 2x^2 + 2x − 48</span>"
    },
    {
     "id": 1278882,
     "content_html": "<span data-math=\"w(x) = x^2 + x − 42\">w(x) = x^2 + x − 42</span>"
    }
   ],
