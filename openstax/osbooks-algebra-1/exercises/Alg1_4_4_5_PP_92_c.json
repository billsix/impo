   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\" type=\"1\">\n  <li>Which function rule describes the table below:</li>\n</ol>\n<table class=\"os-raise-horizontaltable unnumbered\">\n<thead></thead>\n<tbody>\n<tr>\n<th scope=\"row\">              <span data-math=\"x\">x</span></th>\n<td>\n              2\n            </td>\n<td>\n              3\n            </td>\n<td>\n              4\n            </td>\n<td>\n              5\n            </td>\n<td>\n              6\n            </td>\n</tr>\n<tr>\n<th scope=\"row\">              <span data-math=\"y\">y</span></th>\n<td>\n              3\n            </td>\n<td>\n              5\n            </td>\n<td>\n              7\n            </td>\n<td>\n              9\n            </td>\n<td>\n              11\n            </td>\n</tr>\n</tbody>\n</table>",
