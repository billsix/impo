 "questions": [
  {
   "id": 631761,
   "is_answer_order_important": false,
   "stem_html": "<p>Looking at the graph below, which statement about the values graphed is true?</p>\n<p><img alt=\"SCATTER PLOT WITH POINTS AT (2, 7), (3, 9), (4, 11), (5, 13), (6, 15), (7, 17), AND (8, 19).\" src=\"exercises/media/4f33baef35c53878.jpg\" width=\"300\"></p>",
   "answers": [
    {
     "id": 1222652,
     "content_html": "All odd numbers are outputs."
    },
    {
     "id": 1222653,
     "content_html": "The largest input value is 19."
    },
    {
     "id": 1222655,
     "content_html": "The largest output value is 19."
    },
    {
     "id": 1222654,
     "content_html": "The largest output value is 8."
    }
   ],
