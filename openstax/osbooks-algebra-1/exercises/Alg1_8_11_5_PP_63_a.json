 "questions": [
  {
   "id": 632959,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n  <li>Write the specific quadratic function, <span data-math=\"p(x)\">p(x)</span>, in standard form, that has the zeros –8 and 3 and passes through the point <span data-math=\"(2, -20)\">(2, -20)</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1225861,
     "content_html": "<span data-math=\"p(x) = −x^2 − 5x − 6\">p(x) = −x^2 − 5x − 6</span>"
    },
    {
     "id": 1225860,
     "content_html": "<span data-math=\"p(x) = −x^2 − 5x − 24\">p(x) = −x^2 − 5x − 24</span>"
    },
    {
     "id": 1225859,
     "content_html": "<span data-math=\"p(x) = 3x^2 + 15x − 72\">p(x) = 3x^2 + 15x − 72</span>"
    },
    {
     "id": 1225862,
     "content_html": "<span data-math=\"p(x) = 2x^2 + 10x − 48\">p(x) = 2x^2 + 10x − 48</span>"
    }
   ],
