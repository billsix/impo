   "id": 631990,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"3\">\n<li>If a carpenter sawed a 10-ft board into two sections and one section was <span data-math=\"n\">n</span> ft long, how long would the other section, <span data-math=\"S\">S</span>, be in terms of <span data-math=\"n\">n</span>?</li></ol>",
   "answers": [
    {
     "id": 1223474,
     "content_html": "<span data-math=\"S=\\frac{10}2n\">S=\\frac{10}2n</span>"
    },
    {
     "id": 1223473,
     "content_html": "<span data-math=\"S=10-2n\">S=10-2n</span>"
    },
    {
     "id": 1223475,
     "content_html": "<span data-math=\"S=10-n\">S=10-n</span>"
    },
    {
     "id": 1223472,
     "content_html": "<span data-math=\"S=\\frac{10}n\">S=\\frac{10}n</span>"
    }
   ],
