 "is_vocab": false,
 "stimulus_html": "<p>Use the following scenario to answer questions 4 – 6.</p>\n<p>A desert pond is slowly drying up. The average volume of the pond is shown in the table. The first year it was measured, the average volume was determined to be 40,000 liters.</p>\n\n<table class=\"os-raise-midsizetable unnumbered\">\n  <thead>\n    <tr>\n      <th scope=\"col\"><span data-math=\"y\">y</span>, years</th>\n      <th scope=\"col\"><span data-math=\"v\">v</span>, volume (liters)</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>–4</td>\n      <td>&nbsp;</td>\n    </tr>\n    <tr>\n      <td>–2</td>\n      <td>&nbsp;</td>\n    </tr>\n    <tr>\n      <td>0</td>\n      <td>40,000</td>\n    </tr>\n    <tr>\n      <td>1</td>\n      <td>20,000</td>\n    </tr>\n    <tr>\n      <td>3</td>\n      <td>5,000</td>\n    </tr>\n  </tbody>\n</table>",
 "questions": [
  {
   "id": 632602,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\" type=\"1\">\n  <li>Which equation represents the pond’s water loss?</li>\n</ol>",
   "answers": [
    {
     "id": 1225036,
     "content_html": "<span data-math=\"v=\\frac12\\cdot\\left(40,000\\right)^y\">v=\\frac12\\cdot\\left(40,000\\right)^y</span>"
    },
    {
     "id": 1225035,
     "content_html": "<span data-math=\"v=20,000\\cdot\\left(\\frac14\\right)^y\">v=20,000\\cdot\\left(\\frac14\\right)^y</span>"
    },
    {
     "id": 1225037,
     "content_html": "<span data-math=\"v=40,000\\cdot\\left(\\frac12\\right)^y\">v=40,000\\cdot\\left(\\frac12\\right)^y</span>"
    },
    {
     "id": 1225034,
     "content_html": "<span data-math=\"y=40,000\\cdot\\left(\\frac12\\right)^v\">y=40,000\\cdot\\left(\\frac12\\right)^v</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 632603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\" type=\"1\">\n  <li>What does <span data-math=\"y=-2\">y=-2</span> represent in this context?</li>\n</ol>",
   "answers": [
    {
     "id": 1225041,
     "content_html": "the time 2 years before the first time the volume was measured"
    },
    {
     "id": 1225040,
     "content_html": "the time 2 years after the first time the volume was measured"
    },
    {
     "id": 1225039,
     "content_html": "the first time the volume was measured"
    },
    {
     "id": 1225038,
     "content_html": "the time it took for the pond to shrink by a factor of 2"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 632604,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\" type=\"1\">\n  <li>What was the average volume of the pond 4 years before the first time the volume was measured?</li>\n</ol>",
   "answers": [
    {
     "id": 1225045,
     "content_html": "640,000 liters"
    },
    {
     "id": 1225044,
     "content_html": "80,000 liters"
    },
    {
     "id": 1225043,
     "content_html": "160,000 liters"
    },
    {
     "id": 1225042,
     "content_html": "320,000 liters"
    }
   ],
