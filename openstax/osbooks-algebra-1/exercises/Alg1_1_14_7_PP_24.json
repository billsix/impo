 "stimulus_html": "In questions 1 – 5, choose an equation of a line parallel to the given line and contains the given point. The choices are in slope-intercept form.",
 "questions": [
  {
   "id": 645974,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li>Which line is parallel to <span data-math=\"y = 4x + 2\">y = 4x + 2</span> and contains the point <span data-math=\"(1, 2)\">(1, 2)</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1271198,
     "content_html": "<span data-math=\"y=-\\frac14x+2\">y=-\\frac14x+2</span>"
    },
    {
     "id": 1271199,
     "content_html": "<span data-math=\"y=-\\frac14x-2\">y=-\\frac14x-2</span>"
    },
    {
     "id": 1271200,
     "content_html": "<span data-math=\"y=4x-2\">y=4x-2</span>"
    },
    {
     "id": 1271201,
     "content_html": "<span data-math=\"y=4x+2\">y=4x+2</span>"
    }
   ],
