     "content_html": "<span data-math=\"y=x^2+8\">y=x^2+8</span>"
    },
    {
     "id": 1278191,
     "content_html": "<span data-math=\"y=2x^2+8\">y=2x^2+8</span>"
    },
    {
     "id": 1278192,
