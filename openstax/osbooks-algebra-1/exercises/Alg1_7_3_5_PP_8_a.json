 "stimulus_html": "<ol class=\"os-raise-noindent\" start=\"2\">\n  <li>Each figure is composed of large squares and small squares. The side length of the large square is <span data-math=\"x\">x</span>. Choose the correct expression that represents the area, <span data-math=\"y\">y</span>, of the shaded part of each figure.</li>\n</ol>",
 "questions": [
  {
   "id": 648163,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<b>Figure A</b> <br> <br> <img alt=\"Large square with 1 by 1 small squares removed from each corner.\" src=\"exercises/media/bf8b30333458803b.svg\">",
   "answers": [
    {
     "id": 1278185,
     "content_html": "<span data-math=\"y=x^2-8\">y=x^2-8</span>"
    },
    {
     "id": 1278186,
     "content_html": "<span data-math=\"y=x^2-4\">y=x^2-4</span>"
    },
    {
     "id": 1278187,
     "content_html": "<span data-math=\"y=x^2-1\">y=x^2-1</span>"
    },
    {
     "id": 1278188,
     "content_html": "<span data-math=\"y=x^2\">y=x^2</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 648164,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<b>Figure B</b><br> <br> <img alt=\"2 large squares side by side. On the side of the right square, there are 2 small squares stacked vertically, each with dimensions 2 by 2.\" src=\"exercises/media/e888a89340da0d7e.svg\">",
   "answers": [
    {
     "id": 1278189,
     "content_html": "<span data-math=\"y=2x^2\">y=2x^2</span>"
