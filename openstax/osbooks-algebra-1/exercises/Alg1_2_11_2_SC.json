   "is_answer_order_important": false,
   "stem_html": "<p>Which ordered pair is a solution to the inequality graphed here?</p>\n <img alt=\"A Cartesian coordinate plane displays a linear inequality. The region representing y > x - 2 is shaded in orange, above a dashed line that passes through (2, 0) and (0, -2).\" class=\"img-fluid atto_image_button_text-bottom\" height=\"303\" src=\"https://s3.us-east-1.amazonaws.com/exercises-upload/prodtutor/392a75ea9806f81de6a3eb307724c9467c3f1faa9c85a58c0836acb2aabd4066\" width=\"300\"> <br> <p><span data-math=\"y\\;>\\;\\;\\frac45x\\;–\\;\\frac85\">y\\;&gt;\\;\\;\\frac45x\\;–\\;\\frac85</span><br></p>",
   "answers": [
    {
     "id": 1331391,
     "content_html": "<span lang=\"EN\">(2, -2)</span>"
    },
    {
     "id": 1331392,
     "content_html": "<span lang=\"EN\">(-4, 0)</span>"
    },
    {
     "id": 1331393,
     "content_html": "<span lang=\"EN\">(4, 0)</span>"
    },
    {
     "id": 1331394,
     "content_html": "<span lang=\"EN\">(0, -4)</span>"
    }
