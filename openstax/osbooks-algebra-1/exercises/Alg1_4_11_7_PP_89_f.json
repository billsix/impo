 "questions": [
  {
   "id": 632302,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\" type=\"1\">\n  <li>Which two transformations can be used to obtain the graph of <span data-math=\"g(x) = -(x-c)\">g(x) = -(x-c)</span> from the graph of <span data-math=\"g(x) = x\">g(x) = x</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1224407,
     "content_html": "A translation to the left <span data-math=\"c\">c</span> units followed by a reflection across the <span data-math=\"y\">y</span>-axis"
    },
    {
     "id": 1224406,
     "content_html": "A translation to the right <span data-math=\"c\">c</span> units followed by a reflection across the <span data-math=\"y\">y</span>-axis"
    },
    {
     "id": 1224405,
     "content_html": "A translation to the left <span data-math=\"c\">c</span> units followed by a reflection across the <span data-math=\"x\">x</span>-axis"
    },
    {
     "id": 1224408,
     "content_html": "A translation to the right <span data-math=\"c\">c</span> units followed by a reflection across the <span data-math=\"x\">x</span>-axis"
    }
