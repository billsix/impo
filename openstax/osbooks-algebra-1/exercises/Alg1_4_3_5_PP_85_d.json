   "id": 632411,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\" type=\"1\">\n  <li>The function, <span data-math=\"T\">T</span>, gives the temperature of a house, in degrees Fahrenheit, <span data-math=\"h\">h</span> hours after midnight. Choose which function notation represents the temperature at 6 a.m. was 70 degrees.</li>\n</ol>",
   "answers": [
    {
     "id": 1224593,
     "content_html": "<span data-math=\"70(T)=6\">70(T)=6</span>"
    },
    {
     "id": 1224592,
     "content_html": "<span data-math=\"6(T)=70\">6(T)=70</span>"
    },
    {
     "id": 1224594,
     "content_html": "<span data-math=\"T(6)=70\">T(6)=70</span>"
    },
