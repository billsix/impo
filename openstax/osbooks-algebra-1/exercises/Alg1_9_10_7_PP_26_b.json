  {
   "id": 646833,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"a\">\n  <li>In Step 1, why was <span data-math=\"(-\\frac{7}{2})^2\">(-\\frac{7}{2})^2</span> added and then subtracted?</li>\n</ol>",
   "answers": [
    {
     "id": 1273445,
     "content_html": "It is subtracted to complete the square. It is added to change the value of the expression."
    },
    {
     "id": 1273446,
     "content_html": "It is added to complete the square. It is subtracted to change the value of the expression."
    },
    {
     "id": 1273447,
     "content_html": "It is subtracted to complete the square. It is added to keep the value of the expression unchanged."
    },
    {
     "id": 1273448,
     "content_html": "It is added to complete the square. It is subtracted to keep the value of the expression unchanged."
    }
   ],
