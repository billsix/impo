  {
   "id": 646836,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\" type=\"a\">\n  <li>What does the last expression tell us about the vertex of the graph of a function defined by this expression?</li>\n</ol>",
   "answers": [
    {
     "id": 1273457,
     "content_html": "The vertex of the graph is at <span data-math=\"(\\frac{5}{2}, -6)\">(\\frac{5}{2}, -6)</span>."
    },
    {
     "id": 1273458,
     "content_html": "The vertex of the graph is at <span data-math=\"(\\frac{7}{2}, -6\\frac{1}{4})\">(\\frac{7}{2}, -6\\frac{1}{4})</span>."
    },
    {
     "id": 1273459,
     "content_html": "The vertex of the graph is at <span data-math=\"(\\frac{5}{2}, -\\frac{5}{2})\">(\\frac{5}{2}, -\\frac{5}{2})</span>."
    },
    {
     "id": 1273460,
     "content_html": "The vertex of the graph is at <span data-math=\"(-6\\frac{1}{4}, \\frac{7}{2})\">(-6\\frac{1}{4}, \\frac{7}{2})</span>."
    }
   ],
