  {
   "id": 646835,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\" type=\"a\">\n  <li>What happened in Step 3?</li>\n</ol>",
   "answers": [
    {
     "id": 1273453,
     "content_html": "The constant term is written as a fraction so that it has a common denominator, which makes it easier to subtract."
    },
    {
