  {
   "id": 646834,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"a\">\n  <li>What happened in Step 2?</li>\n</ol>",
   "answers": [
    {
     "id": 1273449,
     "content_html": "The expression is added to keep the value of the expression unchanged."
    },
    {
     "id": 1273450,
     "content_html": "The expression, which is not a perfect square, is written as a squared expression."
    },
    {
     "id": 1273451,
     "content_html": "The expression, which is a perfect square, is written as a squared expression."
    },
    {
     "id": 1273452,
     "content_html": "The expression is subtracted to keep the value of the expression unchanged."
    }
