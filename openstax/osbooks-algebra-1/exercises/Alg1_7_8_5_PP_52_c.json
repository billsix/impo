 "is_vocab": false,
 "stimulus_html": "Tyler drew a diagram to expand <span data-math=\"(x+5)(2x+3)\">(x+5)(2x+3)</span>.<br><br>\n<p><img alt=\"Rectangle partitioned into 4 smaller rectangles. The top is labeled 2 x and 3. The side is labeled x and 5. Inside, the top row contains 2 x squared and 3 x. The bottom row contains 7 x and 8.\" height=\"168\" src=\"exercises/media/c6f3fb2eab36113a.svg\" width=\"254\"></p>",
 "questions": [
  {
   "id": 646491,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span class=\"custom-numbering\">4a.</span> Tyler’s diagram is incorrect. Choose the sentence that describes Tyler’s mistake.\n  \n",
   "answers": [
    {
     "id": 1272749,
     "content_html": "Tyler should have labeled the top <span data-math=\"x\">x</span> and 3 and the side <span data-math=\"2x\">2x</span> and 5."
    },
    {
     "id": 1272750,
     "content_html": "Tyler should have labeled the top <span data-math=\"2x\">2x</span> and 5 and the side <span data-math=\"x\">x</span> and 3."
    },
    {
     "id": 1272751,
     "content_html": "Tyler multiplied 5 and 2 and 5 and 3 instead of adding them."
    },
    {
     "id": 1272752,
     "content_html": "Tyler added 5 and 2 and 5 and 3 instead of multiplying them."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646492,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<span class=\"custom-numbering\">4b.</span> What is the correct expanded form of <span data-math=\"(x+5)(2x+3)\">(x+5)(2x+3)</span>?",
   "answers": [
    {
     "id": 1272753,
     "content_html": "<span data-math=\"2x^2+13x+15\">2x^2+13x+15</span>"
    },
    {
     "id": 1272754,
     "content_html": "<span data-math=\"2x^2+10x+8\">2x^2+10x+8</span>"
    },
    {
     "id": 1272755,
     "content_html": "<span data-math=\"30x^2\">30x^2</span>"
    },
    {
     "id": 1272756,
     "content_html": "<span data-math=\"3x+8\">3x+8</span>"
    }
   ],
