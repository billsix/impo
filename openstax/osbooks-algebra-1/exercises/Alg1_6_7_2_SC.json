 "questions": [
  {
   "id": 631829,
   "is_answer_order_important": false,
   "stem_html": "Which strategy would you use to factor <span data-math=\"40x^2y + 44xy − 24y\">40x^2y + 44xy − 24y</span>? What is the factored result?",
   "answers": [
    {
     "id": 1222926,
     "content_html": "<p>Factor out the GCF. Use the perfect square trinomial strategy.</p>\n<p><span data-math=\"4y(5x + 2)(2x - 3)\">4y(5x + 2)(2x - 3)</span></p>"
    },
    {
     "id": 1222927,
     "content_html": "<p>Factor out the GCF. Use the \"<span data-math=\"ac\">ac</span>\" method.</p>\n<p><span data-math=\"4y(5x - 2)(2x + 3)\">4y(5x - 2)(2x + 3)</span></p>"
    },
    {
     "id": 1222925,
     "content_html": "<p>Factor out the GCF. Use the difference of squares.</p>\n<p><span data-math=\"4y(5x - 2)(5x + 2)\">4y(5x - 2)(5x + 2)</span></p>"
    },
    {
     "id": 1222924,
     "content_html": "<p>Factor out the GCF. Use the undo FOIL method.</p>\n<p><span data-math=\"4y(5x + 2)(2x - 3)\">4y(5x + 2)(2x - 3)</span></p>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
