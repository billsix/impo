 "questions": [
  {
   "id": 573371,
   "is_answer_order_important": false,
   "stem_html": "Which of the following correctly classifies the equation and the solution?<br><span data-math=\"6(2n - 1) + 3 = 2n - 8 + 5(2n + 1)\">6(2n - 1) + 3 = 2n - 8 + 5(2n + 1)</span>",
   "answers": [
    {
     "id": 1119514,
     "content_html": "contradiction; no solution"
    },
    {
     "id": 1119513,
     "content_html": "conditional equation; <span data-math=\"1n = - \\frac{1}{4}\">1n = - \\frac{1}{4}</span>"
    },
    {
     "id": 1119512,
     "content_html": "conditional equation; <span data-math=\"n = 0\">n = 0</span>"
    },
    {
     "id": 1119515,
     "content_html": "identity; all real numbers"
    }
   ],
