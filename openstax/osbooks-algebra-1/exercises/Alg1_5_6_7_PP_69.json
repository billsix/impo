 "is_vocab": false,
 "stimulus_html": "<p>Use the following scenario to answer questions 1 – 3.</p>\n<ul type=\"none\"><li>In a newly formed swamp, it is estimated that there are 500 mosquitoes. The population is estimated to double each day.</li></ul>",
 "questions": [
  {
   "id": 648479,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"1\" type=\"1\">\n  <li>Let <span data-math=\"m\">m</span> represent the total population of mosquitoes and <span data-math=\"d\">d</span> represent the number of days that have passed since the first estimate. What is the equation that represents the growth of the mosquito population?</li>\n</ol>",
   "answers": [
    {
     "id": 1278895,
     "content_html": "<span data-math=\"m=500\\cdot d^2\">m=500\\cdot d^2</span>"
    },
    {
     "id": 1278896,
     "content_html": "<span data-math=\"m=500\\cdot 2^d\">m=500\\cdot 2^d</span>"
    },
    {
     "id": 1278897,
     "content_html": "<span data-math=\"m=2\\cdot 500^d\">m=2\\cdot 500^d</span>"
    },
    {
     "id": 1278898,
     "content_html": "<span data-math=\"m=d\\cdot 500^2\">m=d\\cdot 500^2</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 648480,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"1\">\n  <li>What does <span data-math=\"d=-2\">d=-2</span> represent in this context?</li>\n</ol>",
   "answers": [
    {
     "id": 1278899,
     "content_html": "This represents 2 days after the first estimate was taken."
    },
    {
     "id": 1278900,
     "content_html": "This represents the day the first estimate was taken."
    },
    {
     "id": 1278901,
     "content_html": "This represents the day before the first estimate was taken."
    },
    {
     "id": 1278902,
     "content_html": "This represents 2 days before the first estimate was taken."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 648481,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"1\">\n  <li>What is the estimated number of mosquitoes that were in the new swamp 1 day before the estimate was taken?</li>\n</ol>",
   "answers": [
    {
     "id": 1278903,
     "content_html": "125"
    },
    {
     "id": 1278904,
     "content_html": "1000"
    },
    {
     "id": 1278905,
     "content_html": "250"
    },
    {
     "id": 1278906,
     "content_html": "500"
    }
   ],
   "hints": [],
