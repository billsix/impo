   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\">\n    <li>Which inequality is represented by the graph?</li>\n  </ol>\n  <p dir=\"ltr\"><img alt=\"Inequality graphed on a coordinate plane, origin O. Each axis from negative 8 to 8, by 2’s. Dashed line goes through negative 2 comma negative 10, 0 comma negative 6, and 4 comma 2. The region below the dashed line is shaded.\" class=\"img-fluid atto_image_button_text-bottom\" height=\"262\" src=\"exercises/media/22fc98cb6e6fd849.svg\" width=\"262\"></p>",
   "answers": [
    {
     "id": 1223759,
     "content_html": "<span data-math=\"4x + 2y < 12\">4x + 2y &lt; 12</span>"
    },
    {
     "id": 1223758,
     "content_html": "<span data-math=\"4x + 2y > 12\">4x + 2y &gt; 12</span>"
    },
    {
     "id": 1223760,
     "content_html": "<span data-math=\"4x − 2y < 12\">4x − 2y &lt; 12</span>"
    },
    {
     "id": 1223757,
     "content_html": "<span data-math=\"4x − 2y > 12\">4x − 2y &gt; 12</span>"
    }
