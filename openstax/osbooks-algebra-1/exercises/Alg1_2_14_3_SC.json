 "questions": [
  {
   "id": 631715,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p dir=\"ltr\"></p>\n<p dir=\"ltr\"><span>A music store is shipping guitars and snare drums.&nbsp;</span></p>\n<span>   <ul>\n    <li><span><span>Each guitar weighs 6 pounds.</span></span></li>\n    <li><span><span>Each snare drum weighs 14 pounds.&nbsp;</span></span></li>\n    <li><span><span>The maximum weight of guitars and snare drums cannot be more than 120 pounds.</span></span></li>\n    <li><span><span>The store needs to ship more than 10 total instruments.</span></span></li>\n  </ul>\n   <p dir=\"ltr\">Which of the following systems of inequalities describes the situation if <span data-math=\"x\">x</span> is the number of guitars and <span data-math=\"y\">y</span> is the number of snare drums?</p>\n </span>",
   "answers": [
    {
     "id": 1222471,
     "content_html": "<span data-math=\"6x+14y\\leq120\">6x+14y\\leq120</span><br> <span data-math=\"x+y>10\">x+y&gt;10</span>"
    },
    {
     "id": 1222470,
     "content_html": "<span data-math=\"14x+6y\\geq120\">14x+6y\\geq120</span><br> <span data-math=\"x+y<10\">x+y&lt;10</span>"
    },
    {
     "id": 1222469,
     "content_html": "<span data-math=\"14x+6y\\leq120\">14x+6y\\leq120</span><br><span data-math=\"x+y>10\">x+y&gt;10</span>"
    },
    {
     "id": 1222468,
     "content_html": "<span data-math=\"6x+14y\\geq120\">6x+14y\\geq120</span><br> <span data-math=\"x+y>10\">x+y&gt;10</span>"
    }
   ],
