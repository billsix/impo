   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li><strong>Select three</strong> expressions that are perfect squares.</li>\n</ol>\n<ol class=\"os-raise-noindent\" type=\"a\">\n  <li><span data-math=\"(x+5)(x+5)\">(x+5)(x+5)</span></li>\n  <li><span data-math=\"(-9+c)(c-9)\">(-9+c)(c-9)</span></li>\n  <li><span data-math=\"(y-10)(10-y)\">(y-10)(10-y)</span></li>\n  <li><span data-math=\"(2x-1)(2x+1)\">(2x-1)(2x+1)</span></li>\n  <li><span data-math=\"(4-3x)(3-4x)\">(4-3x)(3-4x)</span></li>\n  <li><span data-math=\"(a+b)(b+a)\">(a+b)(b+a)</span></li>\n</ol>",
