 "questions": [
  {
   "id": 631688,
   "is_answer_order_important": false,
   "stem_html": "The price, <span data-math=\"P\">P</span>, that Eric pays for gas varies directly with the number of gallons, <span data-math=\"&nbsp;g&nbsp;\">&nbsp;g&nbsp;</span>, he buys. It costs him $65 to buy 25 gallons of gas. Which equation expresses the price of any amount of gas, <span data-math=\"&nbsp;P&nbsp;\">&nbsp;P&nbsp;</span>, in terms of the number of gallons, <span data-math=\"&nbsp;g&nbsp;\">&nbsp;g&nbsp;</span>?",
   "answers": [
    {
     "id": 1222362,
     "content_html": "<span data-math=\"P=\\frac{5}{13}g\">P=\\frac{5}{13}g</span>"
    },
    {
     "id": 1222361,
     "content_html": "<span data-math=\"P=\\frac{65}{g}\">P=\\frac{65}{g}</span>"
    },
    {
     "id": 1222360,
     "content_html": "<span data-math=\"P=25g\">P=25g</span>"
    },
    {
     "id": 1222363,
     "content_html": "<span data-math=\"P=\\frac{13}{5}g\">P=\\frac{13}{5}g</span>"
    }
   ],
