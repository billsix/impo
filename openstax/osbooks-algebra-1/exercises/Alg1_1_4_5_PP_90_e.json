 "stimulus_html": "For questions 6 and 7, use the following scenario: T-shirts are on sale for $12.50. Isla has a coupon for $10.00 off.",
 "questions": [
  {
   "id": 645837,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n  <li>Choose the equation that represents the total cost, <span data-math=\"c\">c</span>, if she buys <span data-math=\"n\">n</span> T-shirts.</li>\n</ol>",
   "answers": [
    {
     "id": 1270832,
     "content_html": "<span data-math=\"c = 12.5(10n)\">c = 12.5(10n)</span>"
    },
    {
     "id": 1270833,
     "content_html": "<span data-math=\"c = 12.5(n-10)\">c = 12.5(n-10)</span>"
    },
    {
     "id": 1270834,
     "content_html": "<span data-math=\"c = 10n-12.5\">c = 10n-12.5</span>"
    },
    {
     "id": 1270835,
     "content_html": "<span data-math=\"c = 12.5n-10\">c = 12.5n-10</span>"
    }
   ],
