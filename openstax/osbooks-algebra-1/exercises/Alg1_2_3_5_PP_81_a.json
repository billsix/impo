 "questions": [
  {
   "id": 646077,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"2\">\n<li>Which of the following is true of Lin’s solution?</li>\n</ol>",
   "answers": [
    {
     "id": 1271558,
     "content_html": "Lin’s solution of <span data-math=\"(-36, 58)\">(-36, 58)</span> is correct."
    },
    {
     "id": 1271559,
     "content_html": "Lin made an addition error. The correct answer is <span data-math=\"x = 0\">x = 0</span> and <span data-math=\"y = 4\">y = 4</span>, or <span data-math=\"(0,4)\">(0,4)</span>."
    },
    {
     "id": 1271560,
     "content_html": "Lin made a multiplication error. The correct answer is <span data-math=\"x = 9\">x = 9</span> and <span data-math=\"y = 4\">y = 4</span>, or <span data-math=\"(9,4)\">(9,4)</span>."
    },
    {
     "id": 1271561,
     "content_html": "Lin made a multiplication error. The correct answer is <span data-math=\"x = 4\">x = 4</span> and <span data-math=\"y = -2\">y = -2</span>, or <span data-math=\"(4,-2).\">(4,-2).</span>"
    }
   ],
