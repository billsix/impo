   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"1\" type=\"1\">\n  <li>Whenever the input of a function <span data-math=\"f\">f</span> increases by 1, the output increases by 5. Which of these equations could define <span data-math=\"f\">f</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1279393,
     "content_html": "<span data-math=\"f(x)=x^5\">f(x)=x^5</span>"
    },
    {
     "id": 1279394,
     "content_html": "<span data-math=\"f(x)=5^x\">f(x)=5^x</span>"
    },
    {
     "id": 1279395,
     "content_html": "<span data-math=\"f(x)=5x+3\">f(x)=5x+3</span>"
    },
    {
     "id": 1279396,
     "content_html": "<span data-math=\"f(x)=3x+5\">f(x)=3x+5</span>"
    }
   ],
