 "questions": [
  {
   "id": 632591,
   "is_answer_order_important": false,
   "stimulus_html": "For questions 6 – 7, use the following information:\n<blockquote>\nThe area of another piece of paper in square inches, after <span data-math=\"n\">n</span> folds, is given by <span data-math=\"A=100 \\cdot\n          (\\frac{1}{2})^n\">A=100 \\cdot\n          (\\frac{1}{2})^n</span>.\n</blockquote>",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\" type=\"1\">\n  <li>What does the number 100\n mean in this situation?</li>\n</ol>",
   "answers": [
    {
     "id": 1225004,
     "content_html": "The area after the paper is folded"
    },
    {
     "id": 1225005,
     "content_html": "The area before the paper is folded"
    },
    {
     "id": 1225003,
     "content_html": "The number of folds to have an area of 0"
    },
    {
     "id": 1225002,
     "content_html": "The growth factor of the situation"
    }
   ],
