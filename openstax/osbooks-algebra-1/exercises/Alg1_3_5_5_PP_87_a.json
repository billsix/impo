 "questions": [
  {
   "id": 632265,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"2\">\n<li>The number of minutes on the phone and the customer satisfaction rating have a weak negative relationship.<br><br>\nExplain what it means to have a weak negative relationship in this context.</li>\n</ol>",
   "answers": [
    {
     "id": 1224305,
     "content_html": "As the number of minutes the customer waits on the phone increases, the customer satisfaction rating increases."
    },
    {
     "id": 1224304,
     "content_html": "As the number of minutes the customer waits on the phone decreases, the customer satisfaction rating decreases."
    },
    {
     "id": 1224303,
     "content_html": "As the number of minutes the customer waits on the phone decreases, the customer satisfaction rating remains unchanged."
    },
    {
     "id": 1224306,
     "content_html": "As the number of minutes the customer waits on the phone increases, the customer satisfaction rating decreases."
    }
