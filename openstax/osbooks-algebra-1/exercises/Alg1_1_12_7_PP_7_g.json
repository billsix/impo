   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"10\">\n  <li>Write the equation of a line that contains the point <span data-math=\"(2, -3)\">(2, -3)</span> with a slope of <span data-math=\"8\">8</span>. Write the equation in standard form.</li>\n</ol>",
   "answers": [
    {
     "id": 1271142,
     "content_html": "<span data-math=\"19x + y = 8\">19x + y = 8</span>"
    },
    {
     "id": 1271143,
     "content_html": "<span data-math=\"8x-y=19\">8x-y=19</span>"
    },
    {
     "id": 1271144,
     "content_html": "<span data-math=\"8x + y = 19\">8x + y = 19</span>"
    },
    {
     "id": 1271145,
     "content_html": "<span data-math=\"8x - y = -19\">8x - y = -19</span>"
    }
