   "id": 632029,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"6\">\n<li>Which of the following sets of equations are equivalent to each other?</li>\n</ol>",
   "answers": [
    {
     "id": 1223546,
     "content_html": "<span data-math=\"6x-4=11\">6x-4=11</span> and <span data-math=\"6x =7\">6x =7</span>"
    },
    {
     "id": 1223545,
     "content_html": "<span data-math=\"5x - 2 = 7x +4\">5x - 2 = 7x +4</span> and <span data-math=\"12x -2 =4\">12x -2 =4</span>"
    },
    {
     "id": 1223544,
     "content_html": "<span data-math=\"7(x+2)=21\">7(x+2)=21</span> and <span data-math=\"7x +2=21\">7x +2=21</span>"
    },
    {
     "id": 1223547,
     "content_html": "<span data-math=\"10(x+9) = 50\">10(x+9) = 50</span> and <span data-math=\"2(x+9)=10\">2(x+9)=10</span>"
    }
   ],
