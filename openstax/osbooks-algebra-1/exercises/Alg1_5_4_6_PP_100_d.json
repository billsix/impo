   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>Choose an equation that relates <span data-math=\"V\">V</span>, the value of the bond, to <span data-math=\"d\">d</span>, the number of decades since the bond was bought.</li>\n</ol>",
   "answers": [
    {
     "id": 1224983,
     "content_html": "<span data-math=\"V = 250\\cdot 2^d\">V = 250\\cdot 2^d</span>"
    },
    {
     "id": 1224982,
     "content_html": "<span data-math=\"V = 250\\cdot 2\\cdot d\">V = 250\\cdot 2\\cdot d</span>"
    },
    {
     "id": 1224981,
     "content_html": "<span data-math=\"V = 500^d\">V = 500^d</span>"
    },
    {
     "id": 1224980,
     "content_html": "<span data-math=\"V = 250\\cdot d^2\">V = 250\\cdot d^2</span>"
    }
