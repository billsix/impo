   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"11\">\n  <li>A bakery charges $2 per croissant and $4 per muffin. One day, they charge $42 in total and sell 15 baked goods. How many croissants and muffins did they sell?</li>\n</ol>",
   "answers": [
    {
     "id": 1223642,
     "content_html": "8 croissants and 7 muffins"
    },
    {
     "id": 1223641,
     "content_html": "10 croissants and 5 muffins"
    },
    {
     "id": 1223643,
     "content_html": "9 croissants and 6 muffins"
    },
    {
     "id": 1223640,
     "content_html": "5 croissants and 10 muffins"
    }
