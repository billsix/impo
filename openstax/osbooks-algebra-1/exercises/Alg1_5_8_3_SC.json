  {
   "id": 631797,
   "is_answer_order_important": false,
   "stem_html": "A new computer is purchased for $2,500. Each year after its purchase, it loses <span data-math=\"\\frac15\">\\frac15</span> of its value. Which equation represents this situation?",
   "answers": [
    {
     "id": 1222798,
     "content_html": "<span data-math=\"f(t)=\\frac{4}{5} \\cdot (2500)^t\">f(t)=\\frac{4}{5} \\cdot (2500)^t</span>"
    },
    {
     "id": 1222799,
     "content_html": "<span data-math=\"f(t)=2500 \\cdot (\\frac{4}{5})^t\">f(t)=2500 \\cdot (\\frac{4}{5})^t</span>"
    },
    {
     "id": 1222797,
     "content_html": "<span data-math=\"f(t)=2500 \\cdot (\\frac{4}{5})t\">f(t)=2500 \\cdot (\\frac{4}{5})t</span>"
    },
    {
     "id": 1222796,
     "content_html": "<span data-math=\"f(t)=2500+(\\frac{4}{5})^t\">f(t)=2500+(\\frac{4}{5})^t</span>"
    }
   ],
