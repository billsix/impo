   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "\n<br><ol class=\"os-raise-noindent\" start=\"5\">\n  <li>There are no less than 7 markers, <span data-math=\"m\">m</span>, in the drawer.</li>\n</ol>",
