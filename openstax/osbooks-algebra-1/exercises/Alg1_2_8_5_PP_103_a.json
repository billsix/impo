  {
   "id": 646217,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n  <li>The basket has between 12 and 19 eggs, <span data-math=\"e\">e</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1271982,
     "content_html": "<span data-math=\"12\\;≤\\;e\\;≤\\;19\\;\">12\\;≤\\;e\\;≤\\;19\\;</span>"
    },
    {
     "id": 1271983,
     "content_html": "<span data-math=\"e\\;\\leq\\;19\\;\">e\\;\\leq\\;19\\;</span>"
    },
    {
     "id": 1271984,
     "content_html": "<span data-math=\"12\\;\\geq\\;e\\;\">12\\;\\geq\\;e\\;</span>and<span data-math=\"\\;e\\;\\geq\\;19\\;\">\\;e\\;\\geq\\;19\\;</span>"
    },
    {
     "id": 1271985,
     "content_html": "<span data-math=\"12 > e\">12 &gt; e</span> and <span data-math=\"\\;e\\;\\;>\\;19\\;\">\\;e\\;\\;&gt;\\;19\\;</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646218,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n    <li>The total sales of tickets to a show is more than $68. An adult ticket, <em>a</em>, costs $8 and a children’s ticket, <span data-math=\"c\">c</span>, is $3.</li>\n  </ol>",
   "answers": [
    {
     "id": 1271986,
     "content_html": "<span data-math=\"8a + 3c > 68\">8a + 3c &gt; 68</span>"
    },
    {
     "id": 1271987,
     "content_html": "<span data-math=\"8a + 3c < 68\">8a + 3c &lt; 68</span>"
    },
    {
     "id": 1271988,
     "content_html": "<span data-math=\"8a\\;+\\;3c\\;\\geq\\;68\\;\">8a\\;+\\;3c\\;\\geq\\;68\\;</span>"
    },
    {
     "id": 1271989,
     "content_html": "<span data-math=\"8a\\;+\\;3c\\;\\leq\\;68\\;\">8a\\;+\\;3c\\;\\leq\\;68\\;</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646219,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>There needs to be at least 1 pound of clay, <span data-math=\"c\">c</span>, for every 4 students, <span data-math=\"s\">s</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1271990,
     "content_html": "<span data-math=\"c\\;\\leq\\;\\frac s4\\;\">c\\;\\leq\\;\\frac s4\\;</span>"
