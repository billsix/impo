 "questions": [
  {
   "id": 632610,
   "is_answer_order_important": false,
   "stimulus_html": "For questions 1 – 2, use the following scenario:\n<blockquote>\nThe two graphs show models characterized by exponential decay representing the area covered by two different algae blooms, in square yards, <span data-math=\"w\">w</span> weeks after different chemicals were applied.<br><br>\n<p><img alt=\"Graph of two functions on grid.\" src=\"exercises/media/adf54dc8f90e1336.svg\"></p>\n</blockquote>",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"1\" type=\"1\">\n    <li>Which algae bloom covered a larger area when the chemicals were applied?</li>\n  </ol>",
   "answers": [
    {
     "id": 1225068,
     "content_html": "The algae bloom represented by the circles because the curve is always below the other one on the graph."
    },
    {
     "id": 1225067,
     "content_html": "Both algae blooms covered the same area after 5 weeks."
    },
    {
     "id": 1225066,
     "content_html": "The algae bloom represented by the circles because the curve has a lower <span data-math=\"y\">y</span>-intercept."
    },
    {
     "id": 1225069,
     "content_html": "The algae bloom represented by the triangles because the curve has a higher <span data-math=\"y\">y</span>-intercept."
    }
   ],
   "hints": [],
