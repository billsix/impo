 "questions": [
  {
   "id": 631683,
   "is_answer_order_important": false,
   "stem_html": "<p>Which of the following equations could be represented by this table of values?</p>\n<table class=\"unnumbered\">\n  <thead></thead>\n  <tbody>\n    <tr>\n      <th scope=\"row\"><span data-math=\"x\">x</span></th>\n      <td>0</td>\n      <td>1</td>\n      <td>2</td>\n      <td>3</td>\n    </tr>\n    <tr>\n      <th scope=\"row\"><span data-math=\"y\">y</span></th>\n      <td>20</td>\n      <td>23</td>\n      <td>26</td>\n      <td>29</td>\n    </tr>\n  </tbody>\n</table>",
   "answers": [
    {
     "id": 1222340,
     "content_html": "<span data-math=\"y = 20x + 3\">y = 20x + 3</span>"
    },
    {
     "id": 1222341,
     "content_html": "<span data-math=\"y = 20x\">y = 20x</span>"
    },
    {
     "id": 1222342,
     "content_html": "<span data-math=\"y = \\frac{1}{3}x + 20\">y = \\frac{1}{3}x + 20</span>"
    },
    {
     "id": 1222343,
     "content_html": "<span data-math=\"y = 3x +20\">y = 3x +20</span>"
    }
