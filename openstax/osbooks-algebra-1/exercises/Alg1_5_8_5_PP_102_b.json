 "questions": [
  {
   "id": 632621,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"1\">\n  <li>The area, <span data-math=\"a\">a</span>, covered by a city is 20 square miles. The area grows by a factor of 1.1 each year, <span data-math=\"t\">t</span>, since it was 20 square miles. Which equation expresses <span data-math=\"a\">a</span> in terms of <span data-math=\"t\">t</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1225108,
     "content_html": "<span data-math=\"a=20-1.1^t\">a=20-1.1^t</span>"
    },
    {
     "id": 1225109,
     "content_html": "<span data-math=\"a=20 \\cdot 1.1^t\">a=20 \\cdot 1.1^t</span>"
    },
    {
     "id": 1225107,
     "content_html": "<span data-math=\"a=20 \\cdot 1.1t\">a=20 \\cdot 1.1t</span>"
    },
    {
     "id": 1225106,
     "content_html": "<span data-math=\"a=20+1.1^t\">a=20+1.1^t</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
