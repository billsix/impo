 "questions": [
  {
   "id": 667388,
   "is_answer_order_important": false,
   "stem_html": "Which of the following is a representation of <span data-math=\"y = 30x\">y = 30x</span>?",
   "answers": [
    {
     "id": 1331359,
     "content_html": "<img src=\"exercises/media/01a55cef2a542d7b.png\" width=\"300\" alt=\"A graph showing a red straight line in a Cartesian coordinate system. The line passes through the points (-30, 0) and (0, 30), indicating a positive slope.\">"
    },
    {
     "id": 1331360,
     "content_html": "<table class=\"unnumbered\">\n<thead></thead>\n<tbody>\n<tr>\n<th scope=\"row\"><span data-math=\"x\">x</span></th>\n<td>0</td>\n<td>1</td>\n<td>2</td>\n<td>3</td>\n</tr>\n<tr>\n<th scope=\"row\"><span data-math=\"y\">y</span></th>\n<td>30</td>\n<td>35</td>\n<td>40</td>\n<td>45</td>\n</tr>\n</tbody>\n</table>"
    },
    {
     "id": 1331361,
     "content_html": "<p dir=\"ltr\"><span style=\"font-size: 14.9244px;\">Eric was paid $30 to cut grass in July plus $5 each time he came to cut the grass.</span></p>\n<p dir=\"ltr\"><br></p>"
    },
    {
     "id": 1331362,
     "content_html": "<p><span style=\"font-size: 14.9244px;\">Josie paid $30 per pair of jeans.</span></p>\n<p><br></p>"
    }
