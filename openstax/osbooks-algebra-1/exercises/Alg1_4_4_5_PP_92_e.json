   "id": 632421,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\" type=\"1\">\n  <li>Write a function <span data-math=\"h(x)\">h(x)</span> for the following statement: to get the output, multiply the input by 5 and then add 2.</li>\n</ol>",
   "answers": [
    {
     "id": 1224629,
     "content_html": "<span data-math=\"h(x)=x+2\">h(x)=x+2</span>"
    },
    {
     "id": 1224628,
     "content_html": "<span data-math=\"h(x)=x +2(5)\">h(x)=x +2(5)</span>"
    },
    {
     "id": 1224630,
     "content_html": "<span data-math=\"h(x)=5x+2\">h(x)=5x+2</span>"
    },
    {
     "id": 1224627,
     "content_html": "<span data-math=\"h(x)=5(x+2)\">h(x)=5(x+2)</span>"
    }
