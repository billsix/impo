    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 648549,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"1\">\n  <li>Could <span data-math=\"h(n)\">h(n)</span> be 150?</li>\n</ol>",
   "answers": [
    {
