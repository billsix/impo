 "stimulus_html": "<ol class=\"os-raise-noindent\" start=\"5\">\n  <li>Answer questions a–c about the function <span data-math=\"y=(x-2)(x-4)\">y=(x-2)(x-4)</span>.</li>\n</ol>",
 "questions": [
  {
   "id": 669114,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"1\" type=\"a\">\n  <li>What are the <span data-math=\"x\">x</span>-intercepts of the vertex of the graph <span data-math=\"y=(x-2)(x-4)\">y=(x-2)(x-4)</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1333889,
     "content_html": "<span data-math=\"(0,-2)\">(0,-2)</span> and <span data-math=\"(0,-4)\">(0,-4)</span>"
    },
    {
     "id": 1333890,
     "content_html": "<span data-math=\"(-2,0)\">(-2,0)</span> and <span data-math=\"(-4,0)\">(-4,0)</span>"
    },
    {
     "id": 1333891,
     "content_html": "<span data-math=\"(0,2)\">(0,2)</span> and <span data-math=\"(0,4)\">(0,4)</span>"
    },
    {
     "id": 1333892,
     "content_html": "<span data-math=\"(2,0)\">(2,0)</span> and <span data-math=\"(4,0)\">(4,0)</span>"
    }
   ],
