   "id": 632402,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\" type=\"1\">\n  <li>Function <span data-math=\"R\">R</span>&nbsp;gives the number of inches of rain after <span data-math=\"h\">h</span>&nbsp;hours. What does the statement <span data-math=\"R(6)=5\">R(6)=5</span> mean?</li>\n</ol>",
   "answers": [
    {
     "id": 1224570,
     "content_html": "After 6 hours, there was 5 inches of rain."
    },
    {
     "id": 1224569,
     "content_html": "After 5 hours, there was 6 inches of rain."
    },
    {
     "id": 1224568,
     "content_html": "At 6 hours, the rate is 5 inches per hour of rain."
    }
