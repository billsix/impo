   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\"><span>Which of the following equations can be found by adding the equations in the system of equations shown?</span></p>\n<p dir=\"ltr\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span><span data-math=\"\\left\\{\\begin{array}{l}3x\\;+\\;5y\\;=\\;–9\\\\–3x\\;–\\;7y\\;=\\;–21\\end{array}\\right.\">\\left\\{\\begin{array}{l}3x\\;+\\;5y\\;=\\;–9\\\\–3x\\;–\\;7y\\;=\\;–21\\end{array}\\right.</span></span></p>",
   "answers": [
