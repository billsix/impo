 "questions": [
  {
   "id": 632386,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"1\">\n  <li>A sequence is defined recursively by <span data-math=\"f_1=-6, f_n=f_{n-1}-2\">f_1=-6, f_n=f_{n-1}-2</span>, for <span data-math=\"n≥2\">n≥2</span>. Which of the following gives the <span data-math=\"n^{th}\">n^{th}</span> term for <span data-math=\"n≥0\">n≥0</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1224504,
     "content_html": "<span data-math=\"a_{n}=-6+(n)(-2)\">a_{n}=-6+(n)(-2)</span>"
    },
    {
     "id": 1224503,
     "content_html": "<span data-math=\"a_{n}=-6+(n-1)+(-2)\">a_{n}=-6+(n-1)+(-2)</span>"
    },
    {
     "id": 1224505,
     "content_html": "<span data-math=\"a_{n}=-6+(n-1)(-2)\">a_{n}=-6+(n-1)(-2)</span>"
    },
    {
     "id": 1224502,
     "content_html": "<span data-math=\"a_{n}=-2+(n-1)(-6)\">a_{n}=-2+(n-1)(-6)</span>"
    }
   ],
