 "questions": [
  {
   "id": 631682,
   "is_answer_order_important": false,
   "stem_html": "Which equation represents the slope-intercept form of the equation of a line containing the points&nbsp;<span data-math=\"(-2, -4)\">(-2, -4)</span> and <span data-math=\"(1, -3)\">(1, -3)</span>?",
   "answers": [
    {
     "id": 1222338,
     "content_html": "<span data-math=\"y = 3x - 6\">y = 3x - 6</span>"
    },
    {
     "id": 1222337,
     "content_html": "<span data-math=\"y = 7x + 10\">y = 7x + 10</span>"
    },
    {
     "id": 1222336,
     "content_html": "<span data-math=\"y = \\frac{1}{3}x - \\frac{7}{3}\">y = \\frac{1}{3}x - \\frac{7}{3}</span>"
    },
    {
     "id": 1222339,
     "content_html": "<span data-math=\"y = \\frac{1}{3}x - \\frac{10}{3}\">y = \\frac{1}{3}x - \\frac{10}{3}</span>"
    }
