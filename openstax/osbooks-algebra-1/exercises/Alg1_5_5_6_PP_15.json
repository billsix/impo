   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"1\" type=\"1\">\n  <li>A new bicycle sells for $300. It is on sale for <span data-math=\"\\frac14\">\\frac14</span> off the regular price. <strong>Select three</strong> expressions that represent the sale price of the bicycle in dollars.</li>\n</ol>\n<ol type=\"a\">\n  <li><span data-math=\"300 \\cdot \\frac14\">300 \\cdot \\frac14</span></li>\n  <li><span data-math=\"300 \\cdot \\frac34\">300 \\cdot \\frac34</span></li>\n  <li><span data-math=\"300 \\cdot (1-\\frac{1}{4})\">300 \\cdot (1-\\frac{1}{4})</span></li>\n  <li><span data-math=\"300 -\\frac14\">300 -\\frac14</span></li>\n  <li><span data-math=\"300-\\frac{1}{4} \\cdot 300\">300-\\frac{1}{4} \\cdot 300</span></li>\n</ol>",
