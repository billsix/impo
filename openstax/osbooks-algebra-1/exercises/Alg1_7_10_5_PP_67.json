   "id": 669091,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li>A quadratic function <span data-math=\"f\">f</span> is defined by <span data-math=\"f(x)=(x-7)(x+3)\">f(x)=(x-7)(x+3)</span>.</li>\n</ol>\n<ol class=\"os-raise-noindent\" type=\"a\">\n  <li>Without graphing, identify the <span data-math=\"x\">x</span>-intercepts of the graph of <span data-math=\"f\">f</span>.</li>\n  </ol>",
   "answers": [
    {
     "id": 1333845,
     "content_html": "<span data-math=\"(0,-7),(0,3)\">(0,-7),(0,3)</span>"
    },
    {
     "id": 1333846,
     "content_html": "<span data-math=\"(0,7),(0,-3)\">(0,7),(0,-3)</span>"
    },
    {
     "id": 1333847,
     "content_html": "<span data-math=\"(-7,0),(3,0)\">(-7,0),(3,0)</span>"
    },
    {
     "id": 1333848,
     "content_html": "<span data-math=\"(7,0),(-3,0)\">(7,0),(-3,0)</span>"
    }
