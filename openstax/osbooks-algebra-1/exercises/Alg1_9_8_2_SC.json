 "questions": [
  {
   "id": 631907,
   "is_answer_order_important": false,
   "stem_html": "<p>Looking at the steps of deriving the quadratic formula, which step should follow the one below?</p>\n<p><span data-math=\"(x+\\frac{b}{2a})^2=\\frac{b^2-4ac}{4a^2}\">(x+\\frac{b}{2a})^2=\\frac{b^2-4ac}{4a^2}</span></p>",
   "answers": [
    {
     "id": 1223236,
     "content_html": "Subtract <span data-math=\"\\frac{b}{2a}\">\\frac{b}{2a}</span> from both sides."
    },
    {
     "id": 1223237,
     "content_html": "Multiply both sides by <span data-math=\"4a^2\">4a^2</span>."
    },
    {
     "id": 1223239,
     "content_html": "Take the square root of both sides."
    },
    {
     "id": 1223238,
     "content_html": "Complete the square."
    }
   ],
