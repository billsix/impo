 "is_vocab": false,
 "stimulus_html": "\n <br><p>For questions 5 – 7, use the following information:</p>\n<blockquote>\n  <p>Cycle Rentals offers 20 membership points for each day that a customer rents a bike. Bikes Unlimited offers 5 membership points for each day that a customer rents a bike plus 60 points for joining the membership club.</p>\n</blockquote>",
 "questions": [
  {
   "id": 646252,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"5\">\n <li>The equation <span data-math=\"20x= 5x+60\">20x= 5x+60</span> represents a possible constraint about the situation. Solve for <span data-math=\"x\">x</span>. <span data-math=\"x\">x</span> = ____.</li>\n</ol>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 646253,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"6\">\n <li>Which shop offers more membership points if you rent a bike for longer than the constraint you found in the previous question?</li>\n</ol>",
   "answers": [
    {
     "id": 1272104,
     "content_html": "Cycle Rentals"
    },
    {
     "id": 1272105,
     "content_html": "Bikes Unlimited"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
