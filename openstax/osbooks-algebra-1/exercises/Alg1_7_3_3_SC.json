 "questions": [
  {
   "id": 668112,
   "is_answer_order_important": false,
   "stem_html": "<p><img height=\"146\" src=\"exercises/media/7e3aad51e33bfd3c.svg\" width=\"312\" alt=\"Three tables are shown horizontally. The first has 1 column and 2 rows, labeled 'Table 1'. The second has 2 columns and 4 rows, labeled 'Table 2'. The third has 3 columns and 5 rows, labeled 'Table 3'.\"></p>\n<p>Which equation represents the relationship between the step number <span data-math=\"n\">n</span> and the number of squares <span data-math=\"y\">y</span>?</p>",
   "answers": [
    {
     "id": 1332679,
     "content_html": "<span data-math=\"y = 2n\">y = 2n</span>"
    },
    {
     "id": 1332680,
     "content_html": "<span data-math=\"y=n^2+1\">y=n^2+1</span>"
    },
    {
     "id": 1332681,
     "content_html": "<span data-math=\"y=n^2+n\">y=n^2+n</span>"
    },
    {
     "id": 1332682,
     "content_html": "<span data-math=\"y = n + 1\">y = n + 1</span>"
    }
   ],
