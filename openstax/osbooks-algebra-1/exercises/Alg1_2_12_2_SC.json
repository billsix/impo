 "questions": [
  {
   "id": 631710,
   "is_answer_order_important": false,
   "stem_html": "A builder is using a mix of different tiles to remodel a kitchen. The marble tiles cost, <span data-math=\"x\">x</span>, $15 per square and the ceramic tiles, <span data-math=\"y\">y</span>, cost $7 per square. The total amount allowed for tiles is at most $900. Which inequality represents this situation?",
   "answers": [
    {
     "id": 1222448,
     "content_html": "<span data-math=\"22(x\\;+\\;y)\\;\\leq\\;900\">22(x\\;+\\;y)\\;\\leq\\;900</span>"
    },
    {
     "id": 1222449,
     "content_html": "<span data-math=\"15x - 7y < 900\">15x - 7y &lt; 900</span>"
    },
    {
     "id": 1222450,
     "content_html": "<span data-math=\"15x + 7y < 900\">15x + 7y &lt; 900</span>"
    },
    {
     "id": 1222451,
     "content_html": "<span data-math=\"15x\\;+\\;7y\\;\\leq\\;900\">15x\\;+\\;7y\\;\\leq\\;900</span>"
