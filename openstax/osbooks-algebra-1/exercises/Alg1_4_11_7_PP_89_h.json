   "id": 632304,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"11\" type=\"1\">\n  <li>Which type of transformation can be used to obtain the graph of <span data-math=\"g(x) = 4(2 + x)\">g(x) = 4(2 + x)</span> from the graph of <span data-math=\"f(x) = 2+x\">f(x) = 2+x</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1224416,
     "content_html": "Vertical stretch"
    },
    {
     "id": 1224415,
     "content_html": "Vertical shift up"
    },
    {
     "id": 1224414,
     "content_html": "Vertical shift down"
    },
    {
     "id": 1224413,
     "content_html": "Vertical shrink or compression"
    }
   ],
