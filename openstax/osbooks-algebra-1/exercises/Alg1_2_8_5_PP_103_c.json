 "is_vocab": false,
 "stimulus_html": "<p>For questions 12 – 14, use the following scenario:</p>\n<blockquote>\n  <p>Arnav wants to build a dog house. He makes a list of the materials needed:</p>\n  <ul>\n    <li>At least 60 square feet of plywood for the surfaces</li>\n    <li>At least 36 feet of wood planks for the frame of the dog house</li>\n    <li>Between 1 and 2 quarts of paint</li>\n  </ul>\n  <p>Arnav's budget is $65. Plywood costs $0.70 per square foot, planks of wood cost $0.10 per foot, and paint costs $8 per quart.</p>\n</blockquote>\n <br>",
 "questions": [
  {
   "id": 646244,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"12\">\n  <li>Which inequality represents the square feet of plywood needed?</li>\n</ol>",
   "answers": [
    {
     "id": 1272081,
     "content_html": "<span data-math=\"1\\;\\leq\\;p\\;\\leq\\;2\">1\\;\\leq\\;p\\;\\leq\\;2</span>"
    },
    {
     "id": 1272082,
     "content_html": "<span data-math=\"p\\;\\geq\\;36\">p\\;\\geq\\;36</span>"
    },
    {
