 "questions": [
  {
   "id": 632447,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>Write the equation of the line that passes through <span data-math=\"(2,-1)\">(2,-1)</span> and has a slope of <span data-math=\"-\\frac{1}{2}\">-\\frac{1}{2}</span> in point-slope form.</li>\n</ol>",
   "answers": [
    {
     "id": 1224675,
     "content_html": "<span data-math=\"2x + y = 0\">2x + y = 0</span>"
    },
    {
     "id": 1224676,
     "content_html": "<span data-math=\"y = -\\frac{1}{2}x\">y = -\\frac{1}{2}x</span>"
    },
    {
     "id": 1224678,
     "content_html": "<span data-math=\"y+1 = - \\frac{1}{2}(x - 2)\">y+1 = - \\frac{1}{2}(x - 2)</span>"
    },
    {
     "id": 1224677,
     "content_html": "<span data-math=\"y = -\\frac{1}{2}x -1\">y = -\\frac{1}{2}x -1</span>"
    }
   ],
