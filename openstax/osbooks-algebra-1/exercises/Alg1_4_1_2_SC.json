  {
   "id": 667569,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p>The graph below shows a person’s elevation for a period of 10 minutes. Which statement below is true based on the graph?</p>\n<p><strong><img alt=\"A line graph titled 'Elevation Versus Time' shows elevation in feet over 10 minutes. It depicts an increase from 0 to 10 feet, a plateau, another rise to 15 feet, a second plateau, a sharp drop, a brief low plateau, and a return to 0 feet.\" class=\"img-fluid atto_image_button_text-bottom\" height=\"287\" src=\"exercises/media/73f174de71d00785.jpg\" width=\"300\"></strong><br></p>",
   "answers": [
    {
     "id": 1331633,
     "content_html": "The person never stopped climbing."
    },
    {
     "id": 1331634,
     "content_html": "During the first 3 minutes, the person was hiking up a hill."
    },
    {
     "id": 1331635,
     "content_html": "The person slowed down for the second half of the hike."
    },
    {
     "id": 1331636,
     "content_html": "The person sped up in the first 3 minutes."
    }
   ],
