   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p dir=\"ltr\">Determine the correlation coefficient of the data in the table below to 3 decimal places and interpret the value.</p>\n<table class=\"unnumbered\">\n  <thead></thead>\n  <tbody>\n    <tr>\n      <th scope=\"row\"><span data-math=\"x\">x</span></th>\n      <td>8</td>\n      <td>15</td>\n      <td>26</td>\n      <td>31</td>\n      <td>56</td>\n    </tr>\n    <tr>\n      <th scope=\"row\"><span data-math=\"y\">y</span></th>\n      <td>23</td>\n      <td>41</td>\n      <td>53</td>\n      <td>72</td>\n      <td>103</td>\n    </tr>\n  </tbody>\n</table>",
   "answers": [
    {
     "id": 1222518,
     "content_html": "<p><span lang=\"EN\"><span data-math=\"r=-0.987\">r=-0.987</span>; there is a strong negative relationship.</span></p>"
