 "is_vocab": false,
 "stimulus_html": "<p>For questions 8 – 10, use the scenario below to answer the questions:</p>\n<blockquote>\n  <p>A beach store rents surfboards for $15 per hour and beach umbrellas for $10 per hour. The store wants to make at least $200 per day on renting beach equipment. Let <span data-math=\"s\">s</span> be the number of hours that a surfboard is rented and <span data-math=\"u\">u</span> be the number of hours an umbrella is rented.</p>\n</blockquote>",
 "questions": [
  {
   "id": 646383,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>Which inequality represents this situation?</li>\n</ol>",
   "answers": [
    {
     "id": 1272549,
     "content_html": "<span data-math=\"15s + 10u < 200\">15s + 10u &lt; 200</span>"
    },
    {
     "id": 1272550,
     "content_html": "<span data-math=\"15s + 10u ≥ 200\">15s + 10u ≥ 200</span>"
    },
    {
     "id": 1272551,
     "content_html": "<span data-math=\"15s + 10u ≤ 200\">15s + 10u ≤ 200</span>"
    },
    {
     "id": 1272552,
     "content_html": "<span data-math=\"15s - 10u ≥ 200\">15s - 10u ≥ 200</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646384,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\">\n  <li>Can the beach store rent surfboards for 7 total hours and rent umbrellas for 9 total hours and reach their goal of making $200? Be prepared to show your reasoning.</li>\n</ol>",
   "answers": [
    {
     "id": 1272553,
     "content_html": "Yes"
    },
    {
     "id": 1272554,
     "content_html": "No"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 646385,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"10\">\n  <li>Can the beach store rent surfboards for 10 total hours and rent umbrellas for 4 total hours and reach their goal of making $200? Be prepared to show your reasoning.</li>\n</ol>",
   "answers": [
    {
     "id": 1272555,
     "content_html": "Yes"
    },
