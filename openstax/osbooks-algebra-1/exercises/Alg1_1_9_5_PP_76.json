  {
   "id": 645912,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>Choose the equation that represents the relationship between the distance the car has traveled in miles, <span data-math=\"d\">d</span>, and the amount of gas left in the tank in gallons, <span data-math=\"x\">x</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1270996,
     "content_html": "<span data-math=\"x=\\frac{30}{d-480}\">x=\\frac{30}{d-480}</span>"
    },
    {
     "id": 1270997,
     "content_html": "<span data-math=\"d=30(16-x)\">d=30(16-x)</span>"
    },
    {
     "id": 1270998,
     "content_html": "<span data-math=\"x=\\frac{d-480}{-30}\">x=\\frac{d-480}{-30}</span>"
    },
    {
     "id": 1270999,
     "content_html": "<span data-math=\"d=16(30-x)\">d=16(30-x)</span>"
    }
