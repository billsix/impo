   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>Which function represents the graph of <span data-math=\"f(x)=x^2\">f(x)=x^2</span> shifted 5 units to the right?</li>\n</ol>",
   "answers": [
    {
     "id": 1225453,
     "content_html": "<span data-math=\"f(x)=(x-5)^2\">f(x)=(x-5)^2</span>"
    },
    {
     "id": 1225450,
     "content_html": "<span data-math=\"f(x)=(x+5)^2\">f(x)=(x+5)^2</span>"
    },
    {
     "id": 1225451,
     "content_html": "<span data-math=\"f(x)=x^2-5\">f(x)=x^2-5</span>"
    },
    {
