   "stimulus_html": "",
   "stem_html": "<ol start=\"7\">\n<li>Using the distributive property, choose which equation would be an equivalent equation to <span data-math=\"3(x-2) =7\">3(x-2) =7</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1223550,
     "content_html": "<span data-math=\"3x=9\">3x=9</span>"
    },
    {
     "id": 1223549,
     "content_html": "<span data-math=\"x-2=4\">x-2=4</span>"
    },
    {
     "id": 1223551,
     "content_html": "<span data-math=\"3x-6=7\">3x-6=7</span>"
    },
    {
     "id": 1223548,
     "content_html": "<span data-math=\"3x-2=7\">3x-2=7</span>"
    }
