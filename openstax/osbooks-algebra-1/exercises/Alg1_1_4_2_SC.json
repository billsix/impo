 "questions": [
  {
   "id": 631664,
   "is_answer_order_important": false,
   "stem_html": "Jada found a third job option and was offered a position working at a camp for $10.50 per hour. The total bus fare to and from the camp is $8.40. Write an equation that represents how much she will make in a day, <span data-math=\"d\">d</span>, after working&nbsp;<span data-math=\"h\">h</span> hours.",
   "answers": [
    {
     "id": 1222264,
     "content_html": "<span data-math=\"d=8.40h +10.50\">d=8.40h +10.50</span>"
    },
    {
     "id": 1222265,
     "content_html": "<span data-math=\"d=\\frac{10.50h}{8.40}\">d=\\frac{10.50h}{8.40}</span>"
    },
    {
     "id": 1222266,
     "content_html": "<span data-math=\"d = 10.50h + 8.40\">d = 10.50h + 8.40</span>"
    },
    {
     "id": 1222267,
     "content_html": "<span data-math=\"d = 10.50h - 8.40\">d = 10.50h - 8.40</span>"
    }
   ],
