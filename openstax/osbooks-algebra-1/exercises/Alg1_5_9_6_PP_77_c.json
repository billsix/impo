  {
   "id": 669087,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" type=\"1\" start=\"4\">\n  <li>Function <span data-math=\"g\">g</span> gives the amount of a chemical in a person’s body, in milligrams, <span data-math=\"t\">t</span> hours since the patient took the drug. The equation <span data-math=\"g(t)=600\\cdot (\\frac35)^t\">g(t)=600\\cdot (\\frac35)^t</span> defines this function.<br><br></li>\n  </ol><ol class=\"os-raise-noindent\" start=\"1\" type=\"a\">\n    <li>Which is the best choice for the domain of <span data-math=\"g\">g</span>?</li>\n  </ol>",
   "answers": [
    {
     "id": 1333833,
     "content_html": "<span data-math=\"0\\leq t\\leq600\">0\\leq t\\leq600</span>"
    },
    {
     "id": 1333834,
     "content_html": "<span data-math=\"t\\leq600\">t\\leq600</span>"
    },
    {
     "id": 1333835,
     "content_html": "<span data-math=\"t\\geq600\">t\\geq600</span>"
    },
    {
     "id": 1333836,
     "content_html": "<span data-math=\"t\\geq0\">t\\geq0</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 669088,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"a\">\n  <li>Which is the best choice for the range of <span data-math=\"g\">g</span>?</li>\n  </ol>",
   "answers": [
    {
     "id": 1333837,
     "content_html": "<span data-math=\"0 < g \\leq 600\">0 &lt; g \\leq 600</span>"
    },
    {
     "id": 1333838,
     "content_html": "<span data-math=\"g \\leq 600\">g \\leq 600</span>"
    },
    {
     "id": 1333839,
     "content_html": "<span data-math=\"g\\geq 600\">g\\geq 600</span>"
    },
    {
     "id": 1333840,
     "content_html": "<span data-math=\"g > 0\">g &gt; 0</span>"
    }
   ],
