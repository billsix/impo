 "questions": [
  {
   "id": 632961,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\">\n  <li>Write the specific quadratic function, <span data-math=\"h(x)\">h(x)</span>, in standard form, that has the zeros 3 and 5 and passes through the point <span data-math=\"(2, 12)\">(2, 12)</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1225869,
     "content_html": "<span data-math=\"h(x) = 3x^2 − 24x + 48\">h(x) = 3x^2 − 24x + 48</span>"
    },
    {
     "id": 1225868,
     "content_html": "<span data-math=\"h(x) = −x^2 + 8x − 15\">h(x) = −x^2 + 8x − 15</span>"
    },
    {
     "id": 1225870,
     "content_html": "<span data-math=\"h(x) = 4x^2 − 32x + 60\">h(x) = 4x^2 − 32x + 60</span>"
    },
    {
     "id": 1225867,
     "content_html": "<span data-math=\"h(x) = x^2 − 8x + 15\">h(x) = x^2 − 8x + 15</span>"
    }
   ],
