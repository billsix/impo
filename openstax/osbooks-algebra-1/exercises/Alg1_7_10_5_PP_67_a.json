  {
   "id": 669096,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"a\">\n  <li>An equivalent way to write this equation is <span data-math=\"y=(x-4)(x-1)\">y=(x-4)(x-1)</span>. What are the <span data-math=\"x\">x</span>-intercepts of this equation’s graph?</li>\n  </ol>",
   "answers": [
    {
     "id": 1333853,
     "content_html": "<span data-math=\"(0,-1),(0,-4)\">(0,-1),(0,-4)</span>"
    },
    {
     "id": 1333854,
     "content_html": "<span data-math=\"(0,1),(0,4)\">(0,1),(0,4)</span>"
    },
    {
     "id": 1333855,
     "content_html": "<span data-math=\"(-1,0),(-4,0)\">(-1,0),(-4,0)</span>"
    },
    {
