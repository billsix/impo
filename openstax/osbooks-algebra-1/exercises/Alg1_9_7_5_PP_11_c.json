    "free-response"
   ],
   "combo_choices": []
  },
  {
   "id": 646782,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"a\">\n  <li>What do the solutions tell us about the jumping frog? <strong>Select two</strong> that apply.</li>\n</ol>\n<ol type=\"a\">\n  <li>The frog landed 1 seconds after it jumped and was on the ground again.</li>\n  <li>The frog landed <span data-math=\"\\frac{4}{5}\">\\frac{4}{5}</span> seconds after it jumped and was on the ground again.</li>\n  <li>The height of the frog was 5 inches before it jumped.</li>\n  <li>The negative solution shows how far down the frog was before it jumped.</li>\n  <li>The height of the frog was 0 inches before it jumped.</li>\n</ol>",
   "answers": [],
