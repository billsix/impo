 "stimulus_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>A frog jumps in the air. The height, in inches, of the frog is modeled by the function <span data-math=\"h(t)=60t−75t^2\">h(t)=60t−75t^2</span>, where <span data-math=\"t\">t</span> is the time after it jumped, measured in seconds.</li>\n</ol>\n<ol class=\"os-raise-noindent\" type=\"a\">\n  <li><strong>Select two</strong> solutions to the equation <span data-math=\"60t−75t^2=0\">60t−75t^2=0</span>.</li>\n</ol>",
 "questions": [
  {
   "id": 646781,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol type=\"a\">\n  <li><span data-math=\"0\">0</span></li>\n  <li><span data-math=\"\\frac{4}{5}\">\\frac{4}{5}</span></li>\n  <li><span data-math=\"5\">5</span></li>\n  <li><span data-math=\"1\">1</span></li>\n  <li><span data-math=\"-\\frac{1}{5}\">-\\frac{1}{5}</span></li>\n</ol>",
   "answers": [],
   "hints": [],
