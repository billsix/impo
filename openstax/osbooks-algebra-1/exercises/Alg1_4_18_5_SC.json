 "questions": [
  {
   "id": 631775,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p dir=\"ltr\">Write the n<sup>th</sup> term formula of the geometric sequence represented by <span data-math=\"g_1=-3\">g_1=-3</span> and <span data-math=\"g_n=g_{n-1} \\cdot 6\">g_n=g_{n-1} \\cdot 6</span>, <span data-math=\"n\\geq2\">n\\geq2</span>.<br></p>",
   "answers": [
    {
     "id": 1222710,
     "content_html": "<span data-math=\"g_n=6(n-1)-3\">g_n=6(n-1)-3</span>"
    },
    {
     "id": 1222711,
     "content_html": "<span data-math=\"g_n=-3 \\cdot 6^{n-1}\">g_n=-3 \\cdot 6^{n-1}</span>"
    },
    {
     "id": 1222709,
     "content_html": "<span data-math=\"g_n=-3 \\cdot 6^n\">g_n=-3 \\cdot 6^n</span>"
    },
    {
     "id": 1222708,
     "content_html": "<span data-math=\"g_n=6n+-3\">g_n=6n+-3</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
