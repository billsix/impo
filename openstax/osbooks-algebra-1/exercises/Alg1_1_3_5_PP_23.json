 "questions": [
  {
   "id": 645813,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p>For questions 1 – 2, use the following scenario to identify the equation described.</p>\n<blockquote>\n Two different telephone carriers offer the following plans that a person is considering. Company A has a monthly fee of $20 and charges $0.05/minute for calls. Company B has a monthly fee of $5 and charges $0.10/minute for calls.\n</blockquote>\n\n<ol start=\"1\">\n<li>Find the model for the entire&nbsp; cost, <span data-math=\"c\">c</span>,&nbsp; when Company A’s plan is used for <span data-math=\"m\">m</span> minutes.</li></ol>",
   "answers": [
    {
     "id": 1270748,
     "content_html": "<span data-math=\"c=5+ 0.05m\">c=5+ 0.05m</span>"
    },
    {
     "id": 1270749,
     "content_html": "<span data-math=\"c= 20 + 0.10m\">c= 20 + 0.10m</span>"
    },
    {
     "id": 1270750,
     "content_html": "<span data-math=\"c= 5 + 0.10m\">c= 5 + 0.10m</span>"
    },
    {
     "id": 1270751,
     "content_html": "<span data-math=\"c=20 + 0.05m\">c=20 + 0.05m</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 645814,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"2\">\n<li>Find the model for the entire cost, <span data-math=\"c\">c</span>, when&nbsp; Company B’s plan is used for <span data-math=\"m\">m</span> minutes.</li></ol>",
   "answers": [
