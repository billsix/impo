 "questions": [
  {
   "id": 632387,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\" type=\"1\">\n  <li>A sequence is defined recursively by <span data-math=\"f_1=-20, f_n=f_{(n-1)}+5\">f_1=-20, f_n=f_{(n-1)}+5</span> for <span data-math=\"n≥2\">n≥2</span>. Which of the following is the <span data-math=\"n^{th}\">n^{th}</span> term?</li>\n</ol>",
   "answers": [
    {
     "id": 1224508,
     "content_html": "<span data-math=\"a_{n}=5+(n-1)(-20)\">a_{n}=5+(n-1)(-20)</span>"
    },
    {
     "id": 1224509,
     "content_html": "<span data-math=\"a_{n}=-20+(n-1)(5)\">a_{n}=-20+(n-1)(5)</span>"
    },
    {
     "id": 1224507,
     "content_html": "<span data-math=\"a_{n}=-20+(n-1)(-2)\">a_{n}=-20+(n-1)(-2)</span>"
    },
    {
     "id": 1224506,
     "content_html": "<span data-math=\"a_{n}=-20+(n-1)+5\">a_{n}=-20+(n-1)+5</span>"
    }
   ],
