 "questions": [
  {
   "id": 667408,
   "is_answer_order_important": false,
   "stem_html": "<p>Which of the following systems of equations is graphed:</p>\n <img src=\"exercises/media/059c82507d83a37e.jpg\" width=\"300\" alt=\"Two lines on a grid, one orange and solid, the other green and dashed, intersecting at the point (2, -2).\">",
   "answers": [
    {
     "id": 1331399,
     "content_html": "<p><span data-math=\"y=3x+4\">y=3x+4</span> <br></p>\n<p><span data-math=\"y=3x+8\">y=3x+8</span></p>"
    },
    {
     "id": 1331400,
     "content_html": "<p><span data-math=\"y=4x-4\">y=4x-4</span> <br></p>\n<p><span data-math=\"y=8x+3\">y=8x+3</span></p>"
    },
    {
     "id": 1331401,
     "content_html": "<p><span data-math=\"y=3x+4\">y=3x+4</span><br></p>\n<p><span data-math=\"y=-3x+8\">y=-3x+8</span></p>"
    },
    {
     "id": 1331402,
     "content_html": "<p><span data-math=\"y=-3x+4\">y=-3x+4</span> <br></p>\n<p><span data-math=\"y=3x+8\">y=3x+8</span></p>"
    }
   ],
