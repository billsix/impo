   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p dir=\"ltr\">A school group bought 12 tickets to visit a history museum. <br></p>\n<ul>\n  <li>Adult tickets are $5 each.</li>\n  <li>Student tickets are $8 each.<br></li>\n</ul>\n<p dir=\"ltr\">The school paid a total of $90. How many adult tickets, <span data-math=\"x\">x</span>, and student tickets, <span data-math=\"y\">y</span>, did the school buy?<br></p>",
   "answers": [
    {
     "id": 1222368,
     "content_html": "<span>11 student tickets and 1 adult ticket</span>"
    },
    {
     "id": 1222371,
     "content_html": "<span>10 student tickets and 2 adult tickets</span>"
    },
    {
     "id": 1222369,
     "content_html": "<span>9 student tickets and 3 adult tickets</span>"
    },
    {
     "id": 1222370,
     "content_html": "5 student tickets and 10 adult tickets"
    }
   ],
