 "questions": [
  {
   "id": 632388,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\" type=\"1\">\n  <li>A sequence is defined recursively by <span data-math=\"f_1=3\">f_1=3</span>, <span data-math=\"f_n=2 \\cdot f_{n-1}\">f_n=2 \\cdot f_{n-1}</span>, <span data-math=\"n\\geq2\">n\\geq2</span>. Which of the following gives the <span data-math=\"n^{th}\">n^{th}</span> term for <span data-math=\"n\\geq0\">n\\geq0</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1224512,
     "content_html": "<span data-math=\"f_n=3+2^n\">f_n=3+2^n</span>"
    },
    {
     "id": 1224511,
     "content_html": "<span data-math=\"f_n=3+2n\">f_n=3+2n</span>"
    },
    {
     "id": 1224510,
     "content_html": "<span data-math=\"f_n=3^n\">f_n=3^n</span>"
    },
    {
     "id": 1224513,
     "content_html": "<span data-math=\"f_n=3 \\cdot 2^{n-1}\">f_n=3 \\cdot 2^{n-1}</span>"
    }
   ],
   "hints": [],
