 "questions": [
  {
   "id": 631820,
   "is_answer_order_important": false,
   "stem_html": "<p>For functions <span data-math=\"f(x)=x^3+2x^2-19x+12\">f(x)=x^3+2x^2-19x+12</span> and <span data-math=\"g(x)=x-3\">g(x)=x-3</span>:</p>\n<p>Find <span data-math=\"(\\frac{f}{g})(x)\">(\\frac{f}{g})(x)</span> and <span data-math=\"(\\frac{f}{g})(0)\">(\\frac{f}{g})(0)</span>.</p>",
   "answers": [
    {
     "id": 1222890,
     "content_html": "<p><span data-math=\"(\\frac{f}{g})(x)=x^2-5x+4\">(\\frac{f}{g})(x)=x^2-5x+4</span></p>\n<br> <p><span data-math=\"(\\frac{f}{g})(0)=-4\">(\\frac{f}{g})(0)=-4</span></p>"
    },
    {
     "id": 1222889,
     "content_html": "<p><span data-math=\"(\\frac{f}{g})(x)=x^2+5x+4\">(\\frac{f}{g})(x)=x^2+5x+4</span></p>\n<br> <p><span data-math=\"(\\frac{f}{g})(0)=4\">(\\frac{f}{g})(0)=4</span></p>"
    },
    {
     "id": 1222888,
     "content_html": "<p><span data-math=\"(\\frac{f}{g})(x)=x^2+5x-4\">(\\frac{f}{g})(x)=x^2+5x-4</span></p>\n <br> <p><span data-math=\"(\\frac{f}{g})(0)=12\">(\\frac{f}{g})(0)=12</span></p>"
    },
    {
     "id": 1222891,
     "content_html": "<p><span data-math=\"(\\frac{f}{g})(x)=x^2+5x-4\">(\\frac{f}{g})(x)=x^2+5x-4</span></p>\n<br> <p><span data-math=\"(\\frac{f}{g})(0)=-4\">(\\frac{f}{g})(0)=-4</span></p>"
    }
   ],
