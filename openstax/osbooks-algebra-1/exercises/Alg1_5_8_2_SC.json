 "questions": [
  {
   "id": 631796,
   "is_answer_order_important": false,
   "stem_html": "<p>Which of the following equations represents the values in the table?</p>\n<table class=\"unnumbered\">\n  <thead></thead>\n  <tbody>\n    <tr>\n      <th scope=\"row\"><span data-math=\"x\">x</span></th>\n      <td>\n        0\n      </td>\n      <td>\n        1\n      </td>\n      <td>\n       2\n      </td>\n      <td>\n        3\n      </td>\n    </tr>\n    <tr>\n        <th scope=\"row\"><span data-math=\"y\">y</span></th>\n      <td>\n       1\n      </td>\n      <td>\n        3\n      </td>\n      <td>\n        9\n      </td>\n      <td>\n        27\n      </td>\n    </tr>\n  </tbody>\n</table>",
   "answers": [
    {
     "id": 1222792,
     "content_html": "<span data-math=\"y=3x+1\">y=3x+1</span>"
    },
    {
     "id": 1222795,
     "content_html": "<span data-math=\"y=1 \\cdot 3^x\">y=1 \\cdot 3^x</span>"
    },
    {
     "id": 1222793,
     "content_html": "<span data-math=\"y=3 \\cdot 1^x\">y=3 \\cdot 1^x</span>"
    },
    {
     "id": 1222794,
     "content_html": "<span data-math=\"y=3x\">y=3x</span>"
    }
   ],
