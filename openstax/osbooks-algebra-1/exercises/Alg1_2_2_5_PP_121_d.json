 "stimulus_html": "<p>For questions 5 – 8, use the following scenario and matching table.</p>\n<blockquote>\n  <p>A streaming service has two different membership plans. Option A charges $10 per month plus $5 for each movie. Option B charges $20 a month then $2 a movie.</p>\n</blockquote>\n<table class=\"unnumbered\">\n<thead>\n<tr>\n<th scope=\"col\">\n<p>Number of movies in a month, <span data-math=\"x\">x</span></p>\n</th>\n<th scope=\"col\">\n<p>0</p>\n</th>\n<th scope=\"col\">\n<p>1</p>\n</th>\n<th scope=\"col\">\n<p>2</p>\n</th>\n<th scope=\"col\">\n<p>3</p>\n</th>\n<th scope=\"col\">\n<p>4</p>\n</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<th scope=\"row\">\n<p>Option A</p>\n</th>\n<td>\n<p>10</p>\n</td>\n<td>\n<p>15</p>\n</td>\n<td>\n<p>20</p>\n</td>\n<td>\n<p>25</p>\n</td>\n<td>\n<p>30</p>\n</td>\n</tr>\n<tr>\n<th scope=\"row\">\n<p>Option B</p>\n</th>\n<td>\n<p>20</p>\n</td>\n<td>\n<p>22</p>\n</td>\n<td>\n<p>24</p>\n</td>\n<td>\n<p>26</p>\n</td>\n<td>\n<p>28</p>\n</td>\n</tr>\n</tbody>\n</table>\n <br>",
 "questions": [
