  {
   "id": 669171,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"a\">\n  <li>What do the zeros tell us in this situation?</li>\n  </ol>",
   "answers": [
    {
     "id": 1334029,
     "content_html": "The negative zero represents the time, in seconds, when the basketball is on the ground or hits the ground."
    },
    {
     "id": 1334030,
     "content_html": "The positive zero represents the time, in seconds, when the basketball reaches the maximum height."
    },
    {
     "id": 1334031,
     "content_html": "The negative zero represents the height, in feet, when the time is zero."
    },
    {
     "id": 1334032,
     "content_html": "The positive zero means the time, in seconds, when the basketball is on the ground or hits the ground."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
