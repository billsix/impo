 "questions": [
  {
   "id": 631897,
   "is_answer_order_important": false,
   "stem_html": "<p>Examine the work shown. Which of the following is the error that took place when the equation was solved by completing the square?</p>\n<p><span data-math=\"x^2-6x-7=0\">x^2-6x-7=0</span></p>\n<p><span data-math=\"x^2-6x=7\">x^2-6x=7</span></p>\n<p><span data-math=\"x^2-6x+9=16\">x^2-6x+9=16</span></p>\n<p><span data-math=\"(x-3)^2=16\">(x-3)^2=16</span></p>\n<p><span data-math=\"x-3=4\">x-3=4</span></p>\n<p><span data-math=\"x=7\">x=7</span></p>",
   "answers": [
    {
     "id": 1223198,
     "content_html": "This equation cannot be solved by completing the square."
    },
    {
     "id": 1223197,
     "content_html": "When completing the square, the wrong number was found for <span data-math=\"(\\frac{b}{2})^2\">(\\frac{b}{2})^2</span>."
    },
    {
     "id": 1223199,
     "content_html": "When taking the square root, only the positive solution was included."
    },
    {
     "id": 1223196,
     "content_html": "The 7 should have been subtracted from each side."
    }
   ],
   "hints": [],
