   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"11\">\n  <li>Write the equation of a line that contains the points <span data-math=\"(3, 1)\">(3, 1)</span> and <span data-math=\"(-1, 5)\">(-1, 5)</span>. Write the equation in standard form.</li>\n</ol>",
   "answers": [
    {
     "id": 1271150,
     "content_html": "<span data-math=\"x + y = -4\">x + y = -4</span>"
    },
    {
     "id": 1271151,
     "content_html": "<span data-math=\"-x+y = 4\">-x+y = 4</span>"
    },
    {
     "id": 1271152,
     "content_html": "<span data-math=\"x+y=4\">x+y=4</span>"
    },
    {
     "id": 1271153,
     "content_html": "<span data-math=\"x - y = 4\">x - y = 4</span>"
    }
