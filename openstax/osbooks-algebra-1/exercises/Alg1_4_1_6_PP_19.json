   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>Correctly describe the function with a sentence of the form “___ is a function of ___ .”<br></li>\n</ol>",
   "answers": [
    {
