   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\" type=\"1\">\n  <li>The population of a city is 100,000. It doubles each decade for 5 decades. <strong>Select the two</strong> expressions that represent the population of the city after 5 decades.</li>\n</ol>\n<ol type=\"a\">\n  <li>32,000</li>\n  <li>320,000</li>\n  <li><span data-math=\"100,000 \\cdot 2 \\cdot 2 \\cdot 2 \\cdot 2 \\cdot 2\">100,000 \\cdot 2 \\cdot 2 \\cdot 2 \\cdot 2 \\cdot 2</span></li>\n  <li><span data-math=\"100,000 \\cdot 5^2\">100,000 \\cdot 5^2</span></li>\n  <li><span data-math=\"100,000 \\cdot 2^5\">100,000 \\cdot 2^5</span></li>\n</ol>",
