 "questions": [
  {
   "id": 631742,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">The function <span data-math=\"D\">D</span> is defined by the equation <span data-math=\"D(x)=2.5x&nbsp;+12\">D(x)=2.5x&nbsp;+12</span>.</p>\n<p dir=\"ltr\"><span>Which describes the window that can be used to find the value of <span data-math=\"x\">x</span> when <span data-math=\"D(x)=23.25\">D(x)=23.25</span> using graphing technology and gives the correct value of <span data-math=\"x\">x</span>?</span><br></p>",
   "answers": [
    {
     "id": 1222576,
     "content_html": "Graph <span data-math=\"y=2.5x+12\">y=2.5x+12</span>, <span data-math=\"y=23.25\">y=23.25</span>; window: <span data-math=\"x\">x</span> from 20 to 25, <span data-math=\"y\">y</span> from 0 to 10; <span data-math=\"x=4.5\">x=4.5</span>"
    },
    {
     "id": 1222577,
     "content_html": "<span>Graph <span data-math=\"y=2.5x\">y=2.5x</span>, <span data-math=\"y=23.25\">y=23.25</span>; window: <span data-math=\"x\">x</span> from 0 to 10, <span data-math=\"y\">y</span> from 20 to 25; <span data-math=\"x=9.3\">x=9.3</span></span>"
    },
    {
     "id": 1222579,
     "content_html": "Graph <span data-math=\"y=2.5x+12\">y=2.5x+12</span>, <span data-math=\"y=23.25\">y=23.25</span>; window: <span data-math=\"x\">x</span> from 0 to 10, <span data-math=\"y\">y</span> from 20 to 25; <span data-math=\"x=4.5\">x=4.5</span>"
    },
    {
     "id": 1222578,
     "content_html": "Graph <span data-math=\"y=2.5x+12\">y=2.5x+12</span>, <span data-math=\"x=23.25\">x=23.25</span>; window: <span data-math=\"x\">x</span> from 0 to 30, <span data-math=\"y\">y</span> from 0 to 100; <span data-math=\"x=70.125\">x=70.125</span>"
    }
   ],
