   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li><strong>Select three </strong>expressions that are equivalent to <span data-math=\"x^2+4x\">x^2+4x</span>.</li>\n</ol>\n<ol type=\"a\">\n  <li><span data-math=\"x(x+4)\">x(x+4)</span></li>\n  <li><span data-math=\"(x+2)^2\">(x+2)^2</span></li>\n  <li><span data-math=\"(x+x)(x+4)\">(x+x)(x+4)</span></li>\n  <li><span data-math=\"(x+2)^2-4\">(x+2)^2-4</span></li>\n  <li><span data-math=\"(x+4)x\">(x+4)x</span></li>\n</ol>",
