   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li><strong>Select the three</strong> equations with a graph whose vertex has both a positive <span data-math=\"x\">x</span> and a positive <span data-math=\"y\">y</span>.</li>\n</ol>\n<ol type=\"a\">\n  <li><span data-math=\"f(x)=x^2\">f(x)=x^2</span></li>\n  <li><span data-math=\"f(x)=(x−1)^2\">f(x)=(x−1)^2</span></li>\n  <li><span data-math=\"f(x)=(x−3)^2+2\">f(x)=(x−3)^2+2</span></li>\n  <li><span data-math=\"f(x)=2(x−4)^2−5\">f(x)=2(x−4)^2−5</span></li>\n  <li><span data-math=\"f(x)=0.5(x+2)^2+6\">f(x)=0.5(x+2)^2+6</span></li>\n  <li><span data-math=\"f(x)=-(x−4)^2+3\">f(x)=-(x−4)^2+3</span></li>\n  <li><span data-math=\"f(x)=-2(x−3)^2+1\">f(x)=-2(x−3)^2+1</span></li>\n</ol>",
