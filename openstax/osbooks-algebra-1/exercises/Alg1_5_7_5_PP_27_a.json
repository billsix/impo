 "questions": [
  {
   "id": 632611,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"1\">\n    <li>Which algae population is decreasing more rapidly? Explain how you know.</li>\n  </ol>",
   "answers": [
    {
     "id": 1225073,
     "content_html": "The algae bloom represented by the triangles because its graph is steeper."
    },
    {
     "id": 1225072,
     "content_html": "The algae bloom represented by the circles because the curve is always below the other one on the graph."
    },
    {
     "id": 1225071,
     "content_html": "Both algae blooms are decreasing at the same rate."
    },
    {
     "id": 1225070,
     "content_html": "The algae bloom represented by the triangles because the curve has a higher <span data-math=\"y\">y</span>-intercept."
    }
   ],
