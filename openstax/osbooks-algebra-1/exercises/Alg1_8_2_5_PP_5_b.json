 "is_vocab": false,
 "stimulus_html": "<p>Use the following scenario to answer questions 5 – 8.</p>\n<blockquote>\nThe expressions <span data-math=\"t(90 − 3t)\">t(90 − 3t)</span> and <span data-math=\"-3t^2 + 90t\">-3t^2 + 90t</span> define the same function. The function models the number of lumens emitted by a spotlight in an art exhibit over the course of <span data-math=\"t\">t</span> seconds.</blockquote>",
 "questions": [
  {
   "id": 632977,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\">\n  <li>Which equation represents the time when the spotlight is not emitting any light?</li>\n</ol>",
   "answers": [
    {
     "id": 1225931,
     "content_html": "<span data-math=\"-3t^2 + 90t = 30\">-3t^2 + 90t = 30</span>"
    },
    {
     "id": 1225934,
     "content_html": "<span data-math=\"-3t^2 + 90t = 0\">-3t^2 + 90t = 0</span>"
    },
    {
     "id": 1225932,
     "content_html": "<span data-math=\"-3t^2 + 90t = 675\">-3t^2 + 90t = 675</span>"
    },
    {
     "id": 1225933,
     "content_html": "<span data-math=\"t(90 − 3t) = -3t^2 + 90t\">t(90 − 3t) = -3t^2 + 90t</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "stimulus_html": ""
  },
  {
   "id": 632978,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n  <li>At what time(s) does the spotlight not emit any light?</li>\n</ol>",
   "answers": [
    {
     "id": 1225935,
     "content_html": "15 seconds"
    },
    {
     "id": 1225936,
     "content_html": "Only 0 seconds"
    },
    {
     "id": 1225937,
     "content_html": "10 and 25 seconds"
    },
    {
     "id": 1225938,
     "content_html": "0 and 30 seconds"
    }
   ],
   "hints": [],
