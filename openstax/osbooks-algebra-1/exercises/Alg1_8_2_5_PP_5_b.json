  {
   "id": 632979,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n  <li>The artist planned for the spotlight to emit 600 lumens at 10 seconds from the start. At what other time will the spotlight emit 600 lumens of light?</li>\n</ol>",
   "answers": [
    {
     "id": 1225939,
     "content_html": "30 seconds"
    },
    {
     "id": 1225940,
     "content_html": "25 seconds"
    },
    {
     "id": 1225942,
     "content_html": "20 seconds"
    },
    {
     "id": 1225941,
     "content_html": "0 seconds"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "stimulus_html": ""
  },
  {
   "id": 632980,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>At 5 seconds, the spotlight will emit 375 lumens. Find another time that the spotlight emits 375 lumens.</li>\n</ol>",
