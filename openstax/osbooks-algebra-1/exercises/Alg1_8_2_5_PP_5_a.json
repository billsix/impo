 "is_vocab": false,
 "stimulus_html": "<p>Use the following scenario to answer questions 2 – 4.</p>\n<blockquote>\n<p>A model rocket is launched from a launchpad. The function modeling the height of the rocket, in feet, <span data-math=\"t\">t</span> seconds after being launched is shown.</p>\n</blockquote>\n<p><span data-math=\"f(t) = -15t^2 + 58t + 8\">f(t) = -15t^2 + 58t + 8</span></p>",
 "questions": [
  {
   "id": 648402,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\">\n  <li>Which equation would you solve to find the time at which the rocket hits the ground?</li>\n</ol>",
   "answers": [
    {
     "id": 1278611,
     "content_html": "<span data-math=\"15t^2 + 58t + 8 = 0\">15t^2 + 58t + 8 = 0</span>"
    },
    {
     "id": 1278612,
     "content_html": "<span data-math=\"-15t^2 + 58t = 0\">-15t^2 + 58t = 0</span>"
    },
    {
     "id": 1278613,
     "content_html": "<span data-math=\"-15t^2 + 58t = 8\">-15t^2 + 58t = 8</span>"
    },
    {
     "id": 1278614,
     "content_html": "<span data-math=\"-15t^2 + 58t + 8 = 0\">-15t^2 + 58t + 8 = 0</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 648403,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>Use a non-graphing method to find the solution to the previous equation to determine the time that has passed when the rocket hits the ground.</li>\n</ol>",
   "answers": [
    {
     "id": 1278615,
     "content_html": "5 seconds"
    },
    {
     "id": 1278616,
     "content_html": "4 seconds"
    },
    {
     "id": 1278617,
     "content_html": "3 seconds"
    },
    {
     "id": 1278618,
     "content_html": "2 seconds"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 648404,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>How high off the ground is the launchpad from which the rocket lifts off?</li>\n</ol>",
   "answers": [
    {
     "id": 1278619,
     "content_html": "15 feet"
    },
    {
     "id": 1278620,
     "content_html": "8 feet"
    },
    {
     "id": 1278621,
     "content_html": "2 feet"
    },
    {
     "id": 1278622,
     "content_html": "0 feet"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
