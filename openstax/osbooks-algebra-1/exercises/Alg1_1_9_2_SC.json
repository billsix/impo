 "questions": [
  {
   "id": 631674,
   "is_answer_order_important": false,
   "stem_html": "The total revenue a high school makes from a play is T dollars. The revenue is made from selling tickets at $3.25 per child ticket, c,&nbsp; and $7.50 for each adult ticket, a. Which equation is best to find the number of child tickets sold?",
   "answers": [
    {
     "id": 1222306,
     "content_html": "<span data-math=\"c= \\frac{T}{3.25}\">c= \\frac{T}{3.25}</span>"
    },
    {
     "id": 1222305,
     "content_html": "<span data-math=\"a= \\frac{T-3.25c}{7.50}\">a= \\frac{T-3.25c}{7.50}</span>"
    },
    {
     "id": 1222304,
     "content_html": "<span data-math=\"T=3.25c+7.50a\">T=3.25c+7.50a</span>"
    },
    {
     "id": 1222307,
     "content_html": "<span id=\"MathJax-Span-2\"><span id=\"MathJax-Span-3\"></span><span data-math=\"C= \\frac{T-7.50a}{3.25}\">C= \\frac{T-7.50a}{3.25}</span><span id=\"MathJax-Span-5\"><span id=\"MathJax-Span-11\"></span></span></span>"
    }
