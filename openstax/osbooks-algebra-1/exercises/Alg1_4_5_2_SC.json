   "is_answer_order_important": false,
   "stem_html": "<span lang=\"EN\">Which of the following graphs is the graph of a function?</span>",
   "answers": [
    {
     "id": 1222568,
     "content_html": "<img alt=\"The figure has a sideways absolute value function graphed on the x y-coordinate plane. The x-axis runs from negative 6 to 6. The y-axis runs from negative 6 to 6. The line bends at the point (0, 2) and goes to the right. The line goes through the points (1, 3), (2, 4), (1, 1), and (2, 0).\" height=\"235\" src=\"exercises/media/c6dca33bdda20173.jpg\" width=\"229\">"
    },
    {
