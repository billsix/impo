 "questions": [
  {
   "id": 632101,
   "is_answer_order_important": false,
   "stem_html": "<blockquote>\n  <p>This year, students in the 9th grade are collecting dimes and quarters for a school fundraiser. They are trying to collect more money than the students who were in the 9th grade last year. The students in 9th grade last year collected $143.88.</p>\n</blockquote>\n<ol class=\"os-raise-noindent\">\n  <li>Using <span data-math=\"d\">d</span> to represent the number of dimes collected and <span data-math=\"q\">q</span> to represent the number of quarters, which statement best represents this situation?</li>\n</ol>",
   "answers": [
    {
     "id": 1223756,
     "content_html": "<span data-math=\"0.25q + 0.1d > 143.88\">0.25q + 0.1d &gt; 143.88</span>"
    },
    {
     "id": 1223755,
     "content_html": "<span data-math=\"0.25d + 0.1q > 143.88\">0.25d + 0.1q &gt; 143.88</span>"
    },
    {
     "id": 1223754,
     "content_html": "<span data-math=\"0.25q + 0.1d < 143.88\">0.25q + 0.1d &lt; 143.88</span>"
    },
    {
     "id": 1223753,
     "content_html": "<span data-math=\"0.25d + 0.1q ≥ 143.88\">0.25d + 0.1q ≥ 143.88</span>"
    }
   ],
