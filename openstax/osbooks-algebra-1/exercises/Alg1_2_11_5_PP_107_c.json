   "id": 632087,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"12\">\n  <li>Consider the linear equation <span data-math=\"2y − 3x = 5\">2y − 3x = 5</span>. The pair <span data-math=\"(-1,1)\">(-1,1)</span> is a solution to the equation. Which of the following is also a solution to the equation?</li>\n</ol>",
   "answers": [
    {
     "id": 1223702,
     "content_html": "<span data-math=\"(-3, -1)\">(-3, -1)</span>"
    },
    {
     "id": 1223701,
     "content_html": "<span data-math=\"(5, 11)\">(5, 11)</span>"
    },
    {
     "id": 1223703,
     "content_html": "<span data-math=\"(3, 7)\">(3, 7)</span>"
    },
    {
     "id": 1223700,
     "content_html": "<span data-math=\"(1, 5)\">(1, 5)</span>"
    }
   ],
