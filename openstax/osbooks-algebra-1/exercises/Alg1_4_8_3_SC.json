   "id": 631749,
   "is_answer_order_important": false,
   "stem_html": "<p dir=\"ltr\">Brooke was racing bikes with a friend on the way to the park. A table of her distance traveled over time is shown.</p>\n<table class=\"unnumbered\">\n  <caption>Brooke</caption>\n  <thead>\n    <tr>\n      <th scope=\"col\">Time (minutes)</th>\n      <th scope=\"col\">Distance (miles)</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>\n        0\n      </td>\n      <td>\n        0\n      </td>\n    </tr>\n    <tr>\n      <td>\n        5\n      </td>\n      <td>\n        1.2\n      </td>\n    </tr>\n    <tr>\n      <td>\n        10\n      </td>\n      <td>\n        2.4\n      </td>\n    </tr>\n    <tr>\n      <td>\n        15\n      </td>\n      <td>\n        3.6\n      </td>\n    </tr>\n    <tr>\n      <td>\n        20\n      </td>\n      <td>\n        4.8\n      </td>\n    </tr>\n    <tr>\n      <td>\n        25\n      </td>\n      <td>\n        6.0\n      </td>\n    </tr>\n  </tbody>\n</table>\n <br> <p>What was Brooke’s average rate of change between 5 minutes and 20 minutes?</p>",
   "answers": [
    {
     "id": 1222606,
     "content_html": "The average rate of change is 4.17 minutes per mile."
    },
    {
     "id": 1222607,
     "content_html": "The average rate of change is 0.24 mile per minute."
    },
    {
     "id": 1222605,
     "content_html": "The average rate of change is 15 minutes per mile."
    },
    {
     "id": 1222604,
     "content_html": "The average rate of change is 3.6 miles per minute."
    }
