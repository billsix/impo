 "questions": [
  {
   "id": 631877,
   "is_answer_order_important": false,
   "stem_html": "<p>An expression in standard form is shown. The diagram below is equivalent to which expression in factored form?</p>\n<p><span data-math=\"x^2−13x + 42\">x^2−13x + 42</span></p>\n<table class=\"unnumbered\">\n  <thead>\n   \n    <tr>\n      <th scope=\"col\"></th>\n      <th scope=\"col\">\n        <p><span data-math=\"x\">x</span></p>\n      </th>\n      <th scope=\"col\">\n        <p>-6</p>\n      </th>\n    </tr> \n    </thead>\n  <tbody>\n    <tr>\n      <th scope=\"row\">\n        <p><span data-math=\"x\">x</span></p>\n      </th>\n      <td>\n        <p><span data-math=\"x^2\">x^2</span></p>\n      </td>\n      <td>\n        <p><span data-math=\"-6x\">-6x</span></p>\n      </td>\n    </tr>\n    <tr>\n      <th scope=\"row\">\n        <p>-7</p>\n      </th>\n      <td>\n        <p><span data-math=\"-7x\">-7x</span></p>\n      </td>\n      <td>\n        <p>42</p>\n      </td>\n    </tr>\n  </tbody>\n</table>",
   "answers": [
    {
     "id": 1223119,
     "content_html": "<span data-math=\"(x - 6)(x - 7)\">(x - 6)(x - 7)</span>"
    },
    {
     "id": 1223116,
     "content_html": "<span data-math=\"(x - 6)(x + 7)\">(x - 6)(x + 7)</span>"
    },
    {
     "id": 1223117,
     "content_html": "<span data-math=\"(x + 6)(x + 7)\">(x + 6)(x + 7)</span>"
    },
    {
     "id": 1223118,
     "content_html": "<span data-math=\"(x - 13)(x + 42)\">(x - 13)(x + 42)</span>"
    }
   ],
