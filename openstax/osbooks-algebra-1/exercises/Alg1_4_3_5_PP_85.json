 "questions": [
  {
   "id": 632405,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"1\">\n<li>Function <span data-math=\"f\">f</span> gives the temperature, in degrees Celsius, <span data-math=\"t\">t</span><em>&nbsp;</em>hours after midnight.<br><br>\nChoose which equation or expression represents the statement in function notation.</li>\n</ol>\n<ol class=\"os-raise-noindent\" start=\"1\" type=\"a\">\n  <li>The temperature was the same at 9 a.m. and at 4 p.m.</li>\n</ol>",
   "answers": [
    {
     "id": 1224580,
     "content_html": "<span data-math=\"f(9)=f(16)\">f(9)=f(16)</span>"
    },
    {
     "id": 1224579,
     "content_html": "<span data-math=\"f(9)=f(4)\">f(9)=f(4)</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 632406,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"a\">\n  <li>It was warmer at 9 a.m. than at 6 a.m.</li>\n</ol>",
   "answers": [
    {
     "id": 1224581,
     "content_html": "<span data-math=\"f(9)\">f(9)</span>&lt;<span data-math=\"f(6)\">f(6)</span>"
    },
    {
     "id": 1224582,
     "content_html": "<span data-math=\"f(9)\">f(9)</span>&nbsp;&gt;&nbsp;<span data-math=\"f(6)\">f(6)</span>"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 632407,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\" type=\"a\">\n  <li>Some time after midnight, the temperature was 24 degrees Celsius.</li>\n</ol>",
   "answers": [
    {
     "id": 1224585,
     "content_html": "<span data-math=\"f(12)=24\">f(12)=24</span>"
    },
    {
     "id": 1224586,
     "content_html": "<span data-math=\"f(t)=24\">f(t)=24</span>"
    },
    {
     "id": 1224584,
     "content_html": "<span data-math=\"f(0)<24\">f(0)&lt;24</span>"
    },
    {
     "id": 1224583,
     "content_html": "<span data-math=\"f(24)=t\">f(24)=t</span>"
    }
   ],
   "hints": [],
