   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"7\">\n  <li>Translate to an equation: Geneva treated her parents to dinner at their favorite restaurant. The bill was $74.25. Geneva wants to leave 16% of the total bill as a tip. How much should the tip be?</li>\n</ol>",
   "answers": [
    {
     "id": 1223458,
     "content_html": "<span data-math=\"t =16+(74.25)\">t =16+(74.25)</span>"
    },
    {
