 "questions": [
  {
   "id": 645826,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"6\">\n<li>The volume of dry goods, like apples or peaches, can be measured using bushels, pecks, and quarts. A bushel contains 4 pecks, and a peck contains 8 quarts.<br> What is the relationship between the number of bushels, <span data-math=\"b\">b</span>, and the number of quarts, <span data-math=\"q\">q</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1270808,
     "content_html": "<span data-math=\"b=32q\">b=32q</span>"
    },
    {
     "id": 1270809,
     "content_html": "<span data-math=\"b=\\frac q{64}\">b=\\frac q{64}</span>"
    },
    {
     "id": 1270810,
     "content_html": "<span data-math=\"b=\\frac q{12}\">b=\\frac q{12}</span>"
    },
    {
     "id": 1270811,
     "content_html": "<span data-math=\"b=\\frac q{32}\">b=\\frac q{32}</span>"
    }
   ],
