 "questions": [
  {
   "id": 631691,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p>A streaming service offers two options for subscription plans. Option A charges $10.99 a month plus $2 per movie. Option B charges $5.99 a month plus $3 per movie. The table below describes this. Which of the following systems of equations represents the two options for one month?</p>\n<table class=\"unnumbered\">\n  <thead>\n    <tr>\n      <th scope=\"col\"><span data-math=\"x\">x</span> (Number of movies</th>\n      <th scope=\"col\">0</th>\n      <th scope=\"col\">1</th>\n      <th scope=\"col\">2</th>\n      <th scope=\"col\">3</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th scope=\"row\">Option A</th>\n      <td>10.99</td>\n      <td>12.99</td>\n      <td>14.99</td>\n      <td>16.99</td>\n    </tr>\n    <tr>\n      <th scope=\"row\">Option B</th>\n      <td>5.99</td>\n      <td>8.99</td>\n      <td>11.99</td>\n      <td>14.99</td>\n    </tr>\n  </tbody>\n</table>",
   "answers": [
    {
     "id": 1222375,
     "content_html": "<p dir=\"ltr\"></p>\n<p dir=\"ltr\"><span><span data-math=\"y=2x +10.99\">y=2x +10.99</span></span></p>\n <p dir=\"ltr\"><span><span data-math=\"y=3x+5.99\">y=3x+5.99</span></span></p>\n<br> <p></p>"
    },
    {
     "id": 1222374,
     "content_html": "<p></p>\n<p dir=\"ltr\"><span><span data-math=\"y=3x +10.99\">y=3x +10.99</span></span></p>\n<p dir=\"ltr\"><span><span data-math=\"y=2x+5.99\">y=2x+5.99</span></span></p>\n<br> <p></p>"
    },
    {
     "id": 1222373,
     "content_html": "<p dir=\"ltr\"><strong></strong></p>\n<p dir=\"ltr\"><span><span data-math=\"y=2x -10.99\">y=2x -10.99</span></span></p>\n<p dir=\"ltr\"><span><span data-math=\"y=3x-5.99\">y=3x-5.99</span></span></p>\n<br> <p></p>"
    },
    {
     "id": 1222372,
     "content_html": "<p><span data-math=\"y=10.99x+2\">y=10.99x+2</span></p>\n<p><span data-math=\"y=5.99x +3\">y=5.99x +3</span></p>"
    }
   ],
