 "questions": [
  {
   "id": 631736,
   "is_answer_order_important": false,
   "stem_html": "The function <span data-math=\"Q\">Q</span> gives the number of people, in millions, who owned a smart watch after 2015. What does the equation <span data-math=\"Q(6)=7.25\">Q(6)=7.25</span> mean?",
   "answers": [
    {
     "id": 1222552,
     "content_html": "In 2021, 7.25 million more people owned smart watches than in 2015."
    },
    {
     "id": 1222555,
     "content_html": "In 2021, 7.25 million people owned smart watches."
    },
    {
     "id": 1222553,
     "content_html": "In the beginning of 2023, 6 million people owned smart watches."
    },
    {
     "id": 1222554,
     "content_html": "In 2006, 7.25 million people owned smart watches."
    }
   ],
