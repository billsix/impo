   "id": 648435,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\">\n  <li>Consider the expression <span data-math=\"x^2+ bx - 80\">x^2+ bx - 80</span>, where the leading coefficient equals 1. Identify all the pairs of factors of <span data-math=\"-80\">-80</span> that would result in negative values of <span data-math=\"b\">b</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1278743,
     "content_html": "<span data-math=\"80\">80</span> and <span data-math=\"-1\">-1</span>, <span data-math=\"40\">40</span> and <span data-math=\"-2\">-2</span>, <span data-math=\"20\">20</span> and <span data-math=\"-4\">-4</span>, <span data-math=\"16\">16</span> and <span data-math=\"-5\">-5</span>, <span data-math=\"10\">10</span> and <span data-math=\"-8\">-8</span>"
    },
    {
     "id": 1278744,
     "content_html": "<span data-math=\"-80\">-80</span> and <span data-math=\"-1\">-1</span>, <span data-math=\"-40\">-40</span> and <span data-math=\"-2\">-2</span>, <span data-math=\"-20\">-20</span> and <span data-math=\"-4\">-4</span>, <span data-math=\"-16\">-16</span> and <span data-math=\"-5\">-5</span>, <span data-math=\"-10\">-10</span> and <span data-math=\"-8\">-8</span>"
    },
    {
     "id": 1278745,
     "content_html": "<span data-math=\"-80\">-80</span> and <span data-math=\"1\">1</span>, <span data-math=\"-40\">-40</span> and <span data-math=\"2\">2</span>, <span data-math=\"-20\">-20</span> and <span data-math=\"4\">4</span>, <span data-math=\"-16\">-16</span> and <span data-math=\"5\">5</span>, <span data-math=\"-10\">-10</span> and <span data-math=\"8\">8</span>"
    },
    {
     "id": 1278746,
     "content_html": "<span data-math=\"80\">80</span> and <span data-math=\"1\">1</span>, <span data-math=\"40\">40</span> and <span data-math=\"2\">2</span>, <span data-math=\"20\">20</span> and <span data-math=\"4\">4</span>, <span data-math=\"16\">16</span> and <span data-math=\"5\">5</span>, <span data-math=\"10\">10</span> and <span data-math=\"8\">8</span>"
