  {
   "id": 631680,
   "is_answer_order_important": false,
   "stem_html": "Write the equation of a line in slope-intercept form with a slope of&nbsp;<span data-math=\"- \\frac{3}{4}\">- \\frac{3}{4}</span> and a <span data-math=\"y\">y</span>-intercept of <span data-math=\"&nbsp;-2&nbsp;\">&nbsp;-2&nbsp;</span>.",
   "answers": [
    {
     "id": 1222328,
     "content_html": "<span data-math=\"y = \\frac{3}{4} x -2\">y = \\frac{3}{4} x -2</span>"
    },
    {
     "id": 1222329,
     "content_html": "<span data-math=\"3x + 4y =-8\">3x + 4y =-8</span>"
    },
    {
     "id": 1222330,
     "content_html": "<span data-math=\"y = -\\frac{3}{4} x + 2\">y = -\\frac{3}{4} x + 2</span>"
    },
    {
     "id": 1222331,
     "content_html": "<span data-math=\"y = - \\frac{3}{4} x - 2\">y = - \\frac{3}{4} x - 2</span>"
    }
