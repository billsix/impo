   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"6\">\n    <li>Mike owns a grass cutting business. The table below shows how many yards, <span data-math=\"y\">y</span>, he can cut in <span data-math=\"x\">x</span> days.</li>\n  </ol>\n<table class=\"os-raise-horizontaltable unnumbered\">\n<thead>\n</thead>\n<tbody>\n<tr>\n<th scope=\"row\">Number of days, <span data-math=\"x\">x</span></th>\n<td>1</td>\n<td>2</td>\n<td>3</td>\n<td>4</td>\n</tr>\n<tr>\n<th scope=\"row\">Number of yards cut, <span data-math=\"y\">y</span></th>\n<td>6</td>\n<td>12</td>\n<td>18</td>\n<td>24</td>\n</tr>\n</tbody>\n</table>",
   "answers": [
