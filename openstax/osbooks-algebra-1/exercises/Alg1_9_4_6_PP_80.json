   "stem_html": "<ol class=\"os-raise-noindent\">\n  <li><strong>Select three </strong>expressions that are perfect squares.</li>\n</ol>\n<ol type=\"a\">\n  <li><span data-math=\"9x^2+24x+16\">9x^2+24x+16</span></li>\n  <li><span data-math=\"2x^2+20x+100\">2x^2+20x+100</span></li>\n  <li><span data-math=\"(7-3x)^2\">(7-3x)^2</span></li>\n  <li><span data-math=\"(5x+4)(5x-4)\">(5x+4)(5x-4)</span></li>\n  <li><span data-math=\"(1-2x)(-2x+1)\">(1-2x)(-2x+1)</span></li>\n  <li><span data-math=\"4x^2+6x+94\">4x^2+6x+94</span></li>\n</ol>",
