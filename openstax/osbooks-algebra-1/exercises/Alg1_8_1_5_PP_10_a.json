 "is_vocab": false,
 "stimulus_html": "<p>Use the following scenario to answer questions 4 – 5.</p>\n<blockquote>\nSuppose you want to frame a different picture that measures 12 inches by 9 inches. The frame is created from 46 square inches of framing material. The frame must be uniform in width, and all of the framing material must be used.</blockquote>",
 "questions": [
  {
   "id": 632936,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"4\">\n  <li>Which of the following is true about the situation described?</li>\n</ol>",
   "answers": [
    {
     "id": 1225770,
     "content_html": "The perimeter of the framed picture is greater than 42 inches."
    },
    {
     "id": 1225769,
     "content_html": "The area of the framed picture is 148 square inches."
    },
    {
     "id": 1225768,
     "content_html": "The perimeter of the framed picture is 42 inches."
    },
    {
     "id": 1225767,
     "content_html": "The perimeter of the picture is 40 inches."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "stimulus_html": ""
  },
  {
   "id": 632937,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"5\">\n  <li>What is the total area of the framed picture?</li>\n</ol>",
   "answers": [
    {
     "id": 1225773,
     "content_html": "176 square inches"
    },
    {
     "id": 1225774,
     "content_html": "154 square inches"
    },
    {
     "id": 1225772,
     "content_html": "108 square inches"
    },
    {
     "id": 1225771,
     "content_html": "46 square inches"
    }
   ],
