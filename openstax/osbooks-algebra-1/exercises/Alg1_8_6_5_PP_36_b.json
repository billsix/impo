   "id": 648426,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"3\">\n  <li>An expression in standard form is shown. The diagram below shows it is equivalent to which expression in factored form?</li>\n</ol>\n\n<table class=\"unnumbered\" border=\"1\">\n  <tbody><tr>\n    <td></td>\n    <td style=\"text-align: center;\"><span data-math=\"x\">x</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"2\">2</span></td>\n  </tr>\n  <tr>\n    <td style=\"text-align: center;\"><span data-math=\"x\">x</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"x²\">x²</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"2x\">2x</span></td>\n  </tr>\n  <tr>\n    <td style=\"text-align: center;\"><span data-math=\"9\">9</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"9x\">9x</span></td>\n    <td style=\"text-align: center;\"><span data-math=\"18\">18</span></td>\n  </tr>\n</tbody></table>\n<p><span data-math=\"x^2+11x +18\">x^2+11x +18</span></p>",
   "answers": [
    {
     "id": 1278707,
     "content_html": "<span data-math=\"x(x + 18)\">x(x + 18)</span>"
    },
    {
     "id": 1278708,
     "content_html": "<span data-math=\"(x + 2)(x − 9)\">(x + 2)(x − 9)</span>"
    },
    {
     "id": 1278709,
     "content_html": "<span data-math=\"(x + 2)(x + 9)\">(x + 2)(x + 9)</span>"
    },
    {
     "id": 1278710,
     "content_html": "<span data-math=\"(x − 2)(x − 9)\">(x − 2)(x − 9)</span>"
    }
   ],
