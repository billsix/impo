 "questions": [
  {
   "id": 631949,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\">\n  <li>Write the equation of a line that contains the points <span data-math=\"(–3,–1)\">(–3,–1)</span> and <span data-math=\"(2,–2)\">(2,–2)</span>. Write the equation in point-slope form.</li>\n</ol>",
   "answers": [
    {
     "id": 1223368,
     "content_html": "<span data-math=\"y-4=3(x-2)\">y-4=3(x-2)</span>"
    },
    {
     "id": 1223369,
     "content_html": "<span data-math=\"y+2=\\frac13(x-4)\">y+2=\\frac13(x-4)</span>"
    },
    {
     "id": 1223370,
     "content_html": "<span data-math=\"y-4=-3(x+2)\">y-4=-3(x+2)</span>"
    },
    {
     "id": 1223371,
     "content_html": "<span data-math=\"y-2=3(x-4)\">y-2=3(x-4)</span>"
    }
   ],
