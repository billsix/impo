 "is_vocab": false,
 "stimulus_html": "<p>Use the following scenario to answer questions 9 – 10.</p>\n<blockquote>\nA framed picture has a total area <span data-math=\"y\">y</span>, in square inches. The thickness of the frame is represented by <span data-math=\"x\">x</span>, in inches. The equation <span data-math=\"y = (2x + 5)(2x + 7)\">y = (2x + 5)(2x + 7)</span> relates these two variables.</blockquote>",
 "questions": [
  {
   "id": 648397,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\">\n  <li>What are the width and length of the picture without the frame?</li>\n</ol>",
   "answers": [
    {
     "id": 1278591,
     "content_html": "5 inches and 7 inches"
    },
    {
     "id": 1278592,
     "content_html": "2 inches and 7 inches"
    },
    {
     "id": 1278593,
     "content_html": "2 inches and 5 inches"
    },
    {
     "id": 1278594,
     "content_html": "2 inches and 2 inches"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 648398,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"10\">\n  <li>Which of the following represents the area of the frame?</li>\n</ol>",
   "answers": [
    {
     "id": 1278595,
     "content_html": "<span data-math=\"35\">35</span>"
    },
    {
     "id": 1278596,
     "content_html": "<span data-math=\"x + 35\">x + 35</span>"
    },
    {
     "id": 1278597,
     "content_html": "<span data-math=\"x + y\">x + y</span>"
    },
    {
     "id": 1278598,
     "content_html": "<span data-math=\"y − 35\">y − 35</span>"
    }
   ],
   "hints": [],
