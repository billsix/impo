 "stimulus_html": "<ol class=\"os-raise-noindent\" start=\"2\">\n  <li>The equation <span data-math=\"h(t)=-16t^2+80t+64\">h(t)=-16t^2+80t+64</span> represents the height, in feet, of a potato <span data-math=\"t\">t</span> seconds after it was launched from a mechanical device.</li>\n</ol>",
 "questions": [
  {
   "id": 646723,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" type=\"a\">\n  <li>Choose the equation that would allow us to find the time the potato hits the ground.</li>\n</ol>",
   "answers": [
    {
     "id": 1273341,
     "content_html": "<span data-math=\"0= t^2-5t-4\">0= t^2-5t-4</span>"
    },
    {
