  {
   "id": 646368,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"12\">\n<li>Which of the following is true about the solution you found in the previous question?</li>\n</ol>",
   "answers": [
    {
     "id": 1272502,
     "content_html": "The solution represents a workout which allows Armando to burn at least 500 calories."
    },
    {
