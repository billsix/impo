  {
   "id": 646367,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol start=\"11\">\n<li>Which of the following ordered pairs is a solution to the inequality?</li>\n</ol>",
   "answers": [
    {
     "id": 1272498,
     "content_html": "<span data-math=\"(40, 20)\">(40, 20)</span>"
