   "is_answer_order_important": false,
   "stem_html": "<p>For the expressions in questions 1 – 4, choose which number would make the expression a perfect square. Then, choose an equivalent expression in factored form.</p>\n<ol class=\"os-raise-noindent\">\n  <li><span data-math=\"x^2+3x\">x^2+3x</span></li>\n</ol>\n<ol class=\"os-raise-noindent\" type=\"a\">\n  <li>What number can be added to make <span data-math=\"x^2+3x\">x^2+3x</span> a perfect square?</li>\n</ol>",
   "answers": [
    {
     "id": 1226338,
     "content_html": "<span data-math=\"-\\frac23\">-\\frac23</span>"
    },
    {
     "id": 1226341,
