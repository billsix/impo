   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"2\" type=\"a\">\n  <li>Which expression is equivalent to <span data-math=\"x^2+3x\">x^2+3x</span>?</li>\n</ol>",
   "answers": [
    {
     "id": 1226342,
     "content_html": "<span data-math=\"3(x + 1)\">3(x + 1)</span>"
    },
    {
     "id": 1226343,
     "content_html": "<span data-math=\"(x + 3)(x + 3)\">(x + 3)(x + 3)</span>"
    },
    {
     "id": 1226344,
     "content_html": "<span data-math=\"x(3x)\">x(3x)</span>"
    },
    {
     "id": 1226345,
     "content_html": "<span data-math=\"x(x + 3)\">x(x + 3)</span>"
    }
