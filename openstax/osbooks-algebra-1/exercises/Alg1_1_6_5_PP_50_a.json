   "stimulus_html": "",
   "stem_html": "<ol start=\"2\">\n<li><strong>Select three</strong> equations that have the same solution as <span data-math=\"2x-5=15\">2x-5=15</span>.</li>\n</ol><ol start=\"1\" type=\"a\">\n  <li><span data-math=\"2x=10\">2x=10</span></li>\n  <li><span data-math=\"2x=20\">2x=20</span></li>\n  <li><span data-math=\"2(x-5)=15\">2(x-5)=15</span></li>\n  <li><span data-math=\"2x-20=0\">2x-20=0</span></li>\n  <li><span data-math=\"4x-10=30\">4x-10=30</span></li>\n  <li><span data-math=\"15=5-2x\">15=5-2x</span></li>\n</ol>",
