 "questions": [
  {
   "id": 667827,
   "is_answer_order_important": false,
   "stem_html": "<p>Which of the following equations matches the graph below?</p>\n<p><img height=\"306\" src=\"exercises/media/a5a280f47f81d580.jpg\" width=\"300\" alt=\"A graph displays an orange parabolic curve opening downwards, crossing the x-axis around 1 and 5, and peaking near (3, 2) on a grid with labeled x and y axes.\"></p>",
   "answers": [
    {
     "id": 1332241,
     "content_html": "<span data-math=\"y=(x+3)^2+2\">y=(x+3)^2+2</span>"
    },
    {
     "id": 1332242,
     "content_html": "<span data-math=\"y=-(x+3)^2+2\">y=-(x+3)^2+2</span>"
    },
    {
     "id": 1332243,
     "content_html": "<span data-math=\"y=-(x-3)^2+2\">y=-(x-3)^2+2</span>"
    },
    {
     "id": 1332244,
     "content_html": "<span data-math=\"y=(x-3)^2+2\">y=(x-3)^2+2</span>"
    }
   ],
