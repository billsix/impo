     "content_html": "<span data-math=\"(3x + 7)(3x - 5)\">(3x + 7)(3x - 5)</span>"
    },
    {
     "id": 1223157,
     "content_html": "<span data-math=\"(x + 7)(x - 5)\">(x + 7)(x - 5)</span>"
    },
    {
     "id": 1223159,
     "content_html": "<span data-math=\"(3x - 7)(3x + 5)\">(3x - 7)(3x + 5)</span>"
    },
    {
