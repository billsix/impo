 "questions": [
  {
   "id": 631747,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Write the equation of the line in point-slope form that has a slope of 7 and goes through <span data-math=\"(-1,2)\">(-1,2)</span>.",
   "answers": [
    {
     "id": 1222596,
     "content_html": "<span><span data-math=\"2-y=7(-1-x)\">2-y=7(-1-x)</span></span>"
    },
    {
     "id": 1222597,
     "content_html": "<span><span data-math=\"y-2=7(x-1)\">y-2=7(x-1)</span></span>"
    },
    {
     "id": 1222599,
     "content_html": "<span data-math=\"y-2=7(x+1)\">y-2=7(x+1)</span>"
    },
    {
     "id": 1222598,
     "content_html": "<span data-math=\"y = 7x + 9\">y = 7x + 9</span>"
    }
   ],
