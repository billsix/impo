 "questions": [
  {
   "id": 632960,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>Write the specific quadratic function, <span data-math=\"g(x)\">g(x)</span>, in standard form, that has the zero 2 and passes through the point <span data-math=\"(3, -3)\">(3, -3)</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1225866,
     "content_html": "<span data-math=\"g(x) = −3x^2 + 12x − 12\">g(x) = −3x^2 + 12x − 12</span>"
    },
    {
     "id": 1225865,
     "content_html": "<span data-math=\"g(x) = −2x^2 + 8x − 8\">g(x) = −2x^2 + 8x − 8</span>"
    },
    {
     "id": 1225864,
     "content_html": "<span data-math=\"g(x) = 2x^2 − 8x + 3\">g(x) = 2x^2 − 8x + 3</span>"
    },
    {
     "id": 1225863,
     "content_html": "<span data-math=\"g(x) = x^2 − 4x + 4\">g(x) = x^2 − 4x + 4</span>"
    }
   ],
   "hints": [],
