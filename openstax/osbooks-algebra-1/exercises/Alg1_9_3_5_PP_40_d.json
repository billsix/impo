 "stimulus_html": "<ol class=\"os-raise-noindent\" start=\"8\">\n  <li>An equation and its solutions are given. Solve the equation by completing the square, then choose whether you agree or disagree with the given solutions.</li>\n</ol>",
 "questions": [
  {
   "id": 646431,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" type=\"a\">\n  <li><span data-math=\"x^2+20x+50=14\">x^2+20x+50=14</span>. The solutions are <span data-math=\"x=-18\">x=-18</span> and <span data-math=\"x=-2\">x=-2</span>.</li>\n</ol>",
   "answers": [
    {
     "id": 1272630,
     "content_html": "Agree"
    },
    {
     "id": 1272631,
     "content_html": "Disagree"
    }
   ],
