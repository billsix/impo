 "questions": [
  {
   "id": 631814,
   "is_answer_order_important": false,
   "stem_html": "<p>For functions <span data-math=\"f(x)=5x^2-4x-1\">f(x)=5x^2-4x-1</span> and <span data-math=\"g(x)=x^2+3x+8\">g(x)=x^2+3x+8</span>, find:</p>\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span data-math=\"(f+g)(x) =\">(f+g)(x) =</span> _______&nbsp;</p>\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span data-math=\"(f+g)(5) =\">(f+g)(5) =</span> _______</p>",
   "answers": [
    {
     "id": 1222864,
     "content_html": "<p><span data-math=\"(f+g)(x) = 6x^2-x+7\">(f+g)(x) = 6x^2-x+7</span></p>\n<p><span data-math=\"(f+g)(5) = 32\">(f+g)(5) = 32</span></p>"
    },
    {
     "id": 1222865,
     "content_html": "<p><span data-math=\"(f+g)(x) = 4x^2-7x-9\">(f+g)(x) = 4x^2-7x-9</span></p>\n<p><span data-math=\"(f+g)(5) = 56\">(f+g)(5) = 56</span></p>"
    },
    {
     "id": 1222867,
     "content_html": "<p><span data-math=\"(f+g)(x) = 6x^2-x+7\">(f+g)(x) = 6x^2-x+7</span></p>\n<p><span data-math=\"(f+g)(5) = 152\">(f+g)(5) = 152</span></p>"
    },
    {
     "id": 1222866,
     "content_html": "<p><span data-math=\"(f+g)(x) = 4x^2-x+7\">(f+g)(x) = 4x^2-x+7</span></p>\n<p><span data-math=\"(f+g)(5) = 102\">(f+g)(5) = 102</span></p>"
    }
   ],
