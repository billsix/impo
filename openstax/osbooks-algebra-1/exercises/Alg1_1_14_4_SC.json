 "questions": [
  {
   "id": 631686,
   "is_answer_order_important": false,
   "stem_html": "Which equation represents an equation of a line perpendicular to the line&nbsp;<span data-math=\"y = \\frac{1}{2} x - 3\">y = \\frac{1}{2} x - 3</span> that contains the point <span data-math=\"(6, 4)\">(6, 4)</span>?",
   "answers": [
    {
     "id": 1222352,
     "content_html": "<span data-math=\"y = -2x - 2\">y = -2x - 2</span>"
    },
    {
     "id": 1222353,
     "content_html": "<span data-math=\"y = 2x - 8\">y = 2x - 8</span>"
    },
    {
     "id": 1222354,
     "content_html": "<span data-math=\"y = -2x + 14\">y = -2x + 14</span>"
    },
    {
     "id": 1222355,
     "content_html": "<span data-math=\"y = -2x + 16\">y = -2x + 16</span>"
    }
   ],
