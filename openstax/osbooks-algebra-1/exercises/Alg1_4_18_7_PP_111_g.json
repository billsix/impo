  {
   "id": 646778,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"8\" type=\"1\">\n  <li>A sequence is given by the set of numbers <span data-math=\"5, 1, –3, –7\"></span> … What is the equation that can be used to find the <span data-math=\"n^{th}\">n^{th}</span> term of the sequence?</li>\n</ol>",
   "answers": [
    {
     "id": 1273381,
     "content_html": "<span data-math=\"a_n = 5 - (n-1)(-4)\">a_n = 5 - (n-1)(-4)</span>"
    },
    {
     "id": 1273382,
     "content_html": "<span data-math=\"a_n = 5(4)^{n-1}\">a_n = 5(4)^{n-1}</span>"
    },
    {
     "id": 1273383,
     "content_html": "<span data-math=\"a_n = 5(-4)^{n-1}\">a_n = 5(-4)^{n-1}</span>"
    },
    {
     "id": 1273384,
     "content_html": "<span data-math=\"a_n = 5 + (n-1)(-4)\">a_n = 5 + (n-1)(-4)</span>"
    }
   ],
   "hints": [],
