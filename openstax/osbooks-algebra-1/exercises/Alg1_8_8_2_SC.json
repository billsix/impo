  {
   "id": 631881,
   "is_answer_order_important": false,
   "stem_html": "Which of the following is equivalent to <span data-math=\"9^2 − 6^2\">9^2 − 6^2</span>?",
   "answers": [
    {
     "id": 1223135,
     "content_html": "<span data-math=\"(9 + 6)(9 - 6)\">(9 + 6)(9 - 6)</span>"
    },
    {
     "id": 1223132,
     "content_html": "<span data-math=\"(9 + 6)(9 + 6)\">(9 + 6)(9 + 6)</span>"
    },
    {
     "id": 1223133,
     "content_html": "<span data-math=\"(9 - 6)(9 - 6)\">(9 - 6)(9 - 6)</span>"
    },
    {
     "id": 1223134,
     "content_html": "<span data-math=\"(9 - 6)^2\">(9 - 6)^2</span>"
    }
