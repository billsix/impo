 "questions": [
  {
   "id": 631906,
   "is_answer_order_important": false,
   "stem_html": "<p>After completing the square, Odem used the following steps when deriving the quadratic formula.</p>\n<p><span data-math=\"x^2+8x+16= -11+16\">x^2+8x+16= -11+16</span><br> <span data-math=\"x^2+8x+16=5\">x^2+8x+16=5</span></p>\n<p>What should he do next?</p>",
   "answers": [
    {
     "id": 1223232,
     "content_html": "Complete the square again."
    },
    {
     "id": 1223235,
     "content_html": "Factor the perfect square trinomial."
    },
    {
     "id": 1223233,
     "content_html": "Take the square root of both sides."
    },
    {
     "id": 1223234,
     "content_html": "Subtract 16 from both sides."
    }
   ],
