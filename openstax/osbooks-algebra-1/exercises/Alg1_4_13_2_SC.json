 "questions": [
  {
   "id": 631762,
   "is_answer_order_important": false,
   "stem_html": "<p>Which of the following is true about the range of the graph below?</p>\n<p><img alt=\"A graph.&nbsp;\" src=\"exercises/media/06d99838ef4d2ad7.svg\"></p>",
   "answers": [
    {
     "id": 1222658,
     "content_html": "The range of this function only includes 10 and 75."
    },
    {
     "id": 1222659,
     "content_html": "The range of this function includes all values that are at least 10 and at most 75."
    },
    {
     "id": 1222657,
     "content_html": "The range of this function includes all values that are at least 0 and no more than 90."
    },
    {
     "id": 1222656,
     "content_html": "The range of this function includes all values that are at least 0 and no more than 70."
    }
   ],
