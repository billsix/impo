 "questions": [
  {
   "id": 667557,
   "is_answer_order_important": false,
   "stem_html": "<ol class=\"os-raise-noindent\" start=\"9\">\n    <li>An arithmetic sequence <span data-math=\"k\">k</span> starts 12, 6, . . . and is represented by the graph below.</li>\n  </ol>\n  <p><img src=\"exercises/media/83f01724c5ad2ee0.jpg\" width=\"300\" alt=\"A graph with five discrete data points forming a linear sequence. The points are (1, 12), (2, 6), (3, 0), (4, -6), and (5, -12), demonstrating a downward trend with increasing 'n' and an x-intercept at n=3.\"></p>\n  <p>Which of the following is a recursive definition for sequence <span data-math=\"k\">k</span> when <span data-math=\"n\\geq2\">n\\geq2</span>?</p>",
   "answers": [
    {
     "id": 1331625,
     "content_html": "<span data-math=\"k(1)=12, 6⋅k(n)=k(n-1)\">k(1)=12, 6⋅k(n)=k(n-1)</span>"
    },
    {
     "id": 1331626,
     "content_html": "<span data-math=\"k(1)=12, k(n)=k(n-1)+6\">k(1)=12, k(n)=k(n-1)+6</span>"
    },
    {
     "id": 1331627,
     "content_html": "<span data-math=\"k(1)=12, k(n)=k(n-1)-6\">k(1)=12, k(n)=k(n-1)-6</span>"
    },
    {
     "id": 1331628,
     "content_html": "<span data-math=\"k(1)=12, k(n)=k(n)-6\">k(1)=12, k(n)=k(n)-6</span>"
    }
   ],
