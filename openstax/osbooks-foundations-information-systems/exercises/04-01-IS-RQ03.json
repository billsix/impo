 "questions": [
  {
   "id": 552719,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a statement that best characterizes the Agile software development process?",
   "answers": [
    {
     "id": 1083960,
     "content_html": "It is a linear approach to software development and proceeds sequentially from one stage to the next.",
     "correctness": "0.0"
    },
    {
     "id": 1083961,
     "content_html": "There are no considerations for environmental changes.",
     "correctness": "0.0"
    },
    {
     "id": 1083962,
     "content_html": "The final work product is delivered in one package at the end of the process.",
     "correctness": "0.0"
    },
    {
     "id": 1083963,
     "content_html": "It values individuals and interactions over processes and tools.",
     "correctness": "1.0"
    }
   ],
