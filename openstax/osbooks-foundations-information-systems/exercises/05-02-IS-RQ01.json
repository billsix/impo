 "questions": [
  {
   "id": 550780,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the purpose of role-based access control (RBAC) in network security?",
   "answers": [
    {
     "id": 1082736,
     "content_html": "to monitor and filter outgoing internet traffic",
     "correctness": "0.0"
    },
    {
     "id": 1082737,
     "content_html": "to prevent data loss through email and web applications",
     "correctness": "0.0"
    },
    {
     "id": 1082738,
     "content_html": "to ensure users have access only to the resources necessary for their roles",
     "correctness": "1.0"
    },
    {
     "id": 1082739,
     "content_html": "to encrypt data transmissions over the network",
     "correctness": "0.0"
    }
   ],
