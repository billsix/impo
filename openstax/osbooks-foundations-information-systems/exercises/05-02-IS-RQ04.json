 "questions": [
  {
   "id": 550783,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How does ethical hacking differ from malicious hacking?",
   "answers": [
    {
     "id": 1082748,
     "content_html": "Ethical hacking is performed without the permission of the target entity."
    },
    {
     "id": 1082749,
     "content_html": "Ethical hacking is intended to strengthen systems, not to harm them."
    },
    {
     "id": 1082750,
     "content_html": "Ethical hacking does not require a deep understanding of IT systems."
    },
    {
     "id": 1082751,
     "content_html": "There is no real difference; all hacking is considered unethical."
    }
   ],
