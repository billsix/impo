   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the main principle of utilitarianism?",
   "answers": [
    {
     "id": 1083056,
     "content_html": "create the greatest good for the greatest number"
    },
    {
     "id": 1083057,
     "content_html": "only take actions that you would want others to take"
    },
    {
     "id": 1083058,
     "content_html": "develop virtues to become an ideal human being"
    },
    {
     "id": 1083059,
     "content_html": "focus on the consequences of actions"
    }
