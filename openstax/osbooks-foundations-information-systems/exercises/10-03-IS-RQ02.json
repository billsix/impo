  {
   "id": 552345,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is solar power considered an emerging technology?",
   "answers": [
    {
     "id": 1083324,
     "content_html": "It has seen widespread adoption, helping consumers to lower their electricity bills."
    },
    {
     "id": 1083325,
     "content_html": "Laws have been passed to prevent companies from marketing these products to consumers."
    },
    {
     "id": 1083326,
     "content_html": "Economies have been negatively impacted by its widespread use."
    },
    {
     "id": 1083327,
     "content_html": "It has decreased dependency on fossil fuels."
    }
   ],
