   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the purpose of research as it relates to technology?",
   "answers": [
    {
     "id": 1083336,
     "content_html": "It is the precursor to innovation.",
     "correctness": "1.0"
    },
    {
     "id": 1083337,
     "content_html": "It is a secondary component within the design process.",
     "correctness": "0.0"
    },
    {
     "id": 1083338,
     "content_html": "Research provides the full picture of how the technology is supposed to function.",
     "correctness": "0.0"
    },
    {
     "id": 1083339,
     "content_html": "Research prevents innovation from being adopted by consumers.",
     "correctness": "0.0"
    }
