 "questions": [
  {
   "id": 552709,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a description of Privacy by Design?",
   "answers": [
    {
     "id": 1083920,
     "content_html": "a principle advocating for privacy to be intentionally embedded into the design and architecture of IT systems and business practices",
     "correctness": "1.0"
    },
    {
     "id": 1083921,
     "content_html": "a principle focusing on the technical aspects of implementing data protection controls, such as encryption and anonymization",
     "correctness": "0.0"
    },
    {
     "id": 1083922,
     "content_html": "a principle focusing only on data storage and management by third-party providers",
     "correctness": "0.0"
    },
    {
     "id": 1083923,
     "content_html": "a principle that is reactive to data protection and is only considered after a data breach has occurred",
     "correctness": "0.0"
    }
   ],
