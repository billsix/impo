 "questions": [
  {
   "id": 552337,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Frontiers of information systems present several opportunities, challenges, and risks for use. Which of the following is an opportunity?",
   "answers": [
    {
     "id": 1083316,
     "content_html": "It can increase compatibility between networked systems."
    },
    {
     "id": 1083317,
     "content_html": "It will lead to a reduction in hardware and software costs, increasing the overall costs of processing data."
    },
    {
     "id": 1083318,
     "content_html": "Data breaches become of increasing concern."
    },
    {
     "id": 1083319,
     "content_html": "Adherence challenges to regulatory compliance requirements may be at risk."
    }
   ],
