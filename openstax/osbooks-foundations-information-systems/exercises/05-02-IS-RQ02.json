 "questions": [
  {
   "id": 550781,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why are regular penetration tests important for maintaining organizational security?",
   "answers": [
    {
     "id": 1082740,
     "content_html": "They help in training IT staff on how to respond to media inquiries."
    },
    {
     "id": 1082741,
     "content_html": "They allow for constant updating of the company website’s content."
    },
    {
     "id": 1082742,
     "content_html": "They enable the identification and remediation of early vulnerabilities."
    },
    {
     "id": 1082743,
     "content_html": "They are a regulatory requirement for all businesses."
    }
   ],
