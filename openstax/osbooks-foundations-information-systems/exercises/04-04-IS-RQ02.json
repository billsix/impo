 "questions": [
  {
   "id": 546309,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is it important to conduct research before designing a mobile application?",
   "answers": [
    {
     "id": 1070531,
     "content_html": "Research helps create an app with the least amount of time and cost.",
     "correctness": "0.0"
    },
    {
     "id": 1070532,
     "content_html": "Research tells you how to design the product.",
     "correctness": "0.0"
    },
    {
     "id": 1070533,
     "content_html": "Research prevents costly mistakes and major changes later in the design process.",
     "correctness": "1.0"
    },
    {
     "id": 1070534,
     "content_html": "Research provides new revelations about user needs.",
     "correctness": "0.0"
    }
   ],
