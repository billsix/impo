    {
     "id": 1083572,
     "content_html": "avoid delays in project deadlines"
    },
    {
     "id": 1083573,
     "content_html": "ensure data are used for marketing purposes"
    },
    {
     "id": 1083574,
     "content_html": "minimize potential threats to data and systems"
    },
    {
     "id": 1083575,
     "content_html": "simplify the process of sharing data"
    }
