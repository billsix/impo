  {
   "id": 550839,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the context of cybersecurity, what does the term “digital trust” primarily refer to?",
   "answers": [
    {
     "id": 1082948,
     "content_html": "the encryption standards used in digital communications",
     "correctness": "0.0"
    },
    {
     "id": 1082949,
     "content_html": "the confidence stakeholders place in an organization’s ability to secure data and systems",
     "correctness": "1.0"
    },
    {
     "id": 1082950,
     "content_html": "the digital certificates used for website authentication",
     "correctness": "0.0"
    },
    {
     "id": 1082951,
     "content_html": "the trustworthiness of digital signatures",
     "correctness": "0.0"
    }
