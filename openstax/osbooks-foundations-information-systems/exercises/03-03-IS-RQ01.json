 "questions": [
  {
   "id": 552766,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why are cloud databases important for mobile app development?",
   "answers": [
    {
     "id": 1084044,
     "content_html": "They offer lower maintenance costs and real-time data access.",
     "correctness": "1.0"
    },
    {
     "id": 1084045,
     "content_html": "They increase the complexity of app development.",
     "correctness": "0.0"
    },
    {
     "id": 1084046,
     "content_html": "They require local servers for data storage.",
     "correctness": "0.0"
    },
    {
     "id": 1084047,
     "content_html": "They eliminate the need for user experience design.",
     "correctness": "0.0"
    }
   ],
