 "questions": [
  {
   "id": 546331,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What differentiates logical designs from physical designs?",
   "answers": [
    {
     "id": 1070579,
     "content_html": "Logical designs include the specific hardware that will be used in the system.",
     "correctness": "0.0"
    },
    {
     "id": 1070580,
     "content_html": "Physical designs incorporate business processes to visually represent the flow of data and the relationships between them.",
     "correctness": "0.0"
    },
    {
     "id": 1070581,
     "content_html": "Logical designs provide a high-level representation of the system.",
     "correctness": "1.0"
    },
    {
     "id": 1070582,
     "content_html": "Physical designs are used to build out the logical design.",
     "correctness": "0.0"
    }
   ],
