     "content_html": "It enables organizations to create new opportunities for innovation and growth.",
     "correctness": "1.0"
    },
    {
     "id": 1083314,
     "content_html": "Blockchain combined with augmented reality and virtual reality can lead to profit losses for organizations.",
     "correctness": "0.0"
    },
