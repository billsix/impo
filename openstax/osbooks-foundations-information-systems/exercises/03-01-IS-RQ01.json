 "questions": [
  {
   "id": 552531,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the two main types of data and their focus areas in business operations?",
   "answers": [
    {
     "id": 1083740,
     "content_html": "Line of business data focus on customer interactions and feedback, while customer behavior data include daily operations and financial records.",
     "correctness": "0.0"
    },
    {
     "id": 1083741,
     "content_html": "Line of business data involve daily operations like financial records and supply chain details, while customer behavior data focuses on customers’ interactions with a company’s offerings, such as purchase history and social media interactions.",
     "correctness": "1.0"
    },
    {
     "id": 1083742,
     "content_html": "Line of business data include social media interactions and purchase history, while customer behavior data involve inventory processes and supply chain details.",
     "correctness": "0.0"
    },
    {
     "id": 1083743,
     "content_html": "Both line of business data and customer behavior data focus primarily on the financial records and day-to-day operations of a business.",
     "correctness": "0.0"
    }
   ],
