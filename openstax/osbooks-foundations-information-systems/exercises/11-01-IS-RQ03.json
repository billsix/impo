   "id": 552665,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which aspect of a global information system makes it instrumental in emergency response and disaster management?",
   "answers": [
    {
     "id": 1083856,
     "content_html": "provides historical data on hazards and vulnerabilities",
     "correctness": "0.0"
    },
    {
     "id": 1083857,
     "content_html": "eliminates the need for real-time information",
     "correctness": "0.0"
    },
    {
     "id": 1083858,
     "content_html": "enables efficient coordination of emergency efforts",
     "correctness": "1.0"
    },
    {
     "id": 1083859,
     "content_html": "substitutes for communication channels among responders",
     "correctness": "0.0"
    }
