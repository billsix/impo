 "questions": [
  {
   "id": 550782,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the cyber safety significance of applying regular software updates and patches?",
   "answers": [
    {
     "id": 1082744,
     "content_html": "They maintain the software’s compatibility with new hardware.",
     "correctness": "0.0"
    },
    {
     "id": 1082745,
     "content_html": "They often add new features to the software.",
     "correctness": "0.0"
    },
    {
     "id": 1082746,
     "content_html": "They address identified security vulnerabilities to prevent exploits.",
     "correctness": "1.0"
    },
    {
     "id": 1082747,
     "content_html": "They are mainly for aesthetic improvements to the user interface.",
     "correctness": "0.0"
    }
