   "id": 552401,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In decision tree analysis, what is the purpose of the nodes in the tree structure?",
   "answers": [
    {
     "id": 1083432,
     "content_html": "to represent the outcome or target variable"
    },
    {
     "id": 1083433,
     "content_html": "to split the data based on the predictor variables"
    },
    {
     "id": 1083434,
     "content_html": "to display the probability of each outcome"
    },
    {
     "id": 1083435,
     "content_html": "to calculate the information gain"
    }
