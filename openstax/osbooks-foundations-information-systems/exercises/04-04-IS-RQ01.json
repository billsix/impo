 "questions": [
  {
   "id": 546307,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a key goal of using a user-centered design approach?",
   "answers": [
    {
     "id": 1070523,
     "content_html": "providing the cheapest solution to the user in the quickest time frame"
    },
    {
     "id": 1070524,
     "content_html": "integrating customer feedback once during the development process"
    },
    {
     "id": 1070525,
     "content_html": "developing detailed documentation reports of the system functionality"
    },
    {
     "id": 1070526,
     "content_html": "utilizing user input throughout the process to provide the best solution to meet the needs of the users"
    }
   ],
