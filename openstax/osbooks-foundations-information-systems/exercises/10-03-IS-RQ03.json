   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do data analytics support health-care efforts?",
   "answers": [
    {
     "id": 1084068,
     "content_html": "It helps to identify different strands of the flu and its prevalence in communities.",
     "correctness": "0.0"
    },
    {
     "id": 1084069,
     "content_html": "The data collected reduce efficiencies in health care–related supply chains and logistics.",
     "correctness": "1.0"
    },
    {
     "id": 1084070,
     "content_html": "It provides information on health-care resourcing to help organizations identify staffing and financial needs.",
     "correctness": "0.0"
    },
    {
     "id": 1084071,
     "content_html": "It helps to initiate targeted marketing campaigns aimed at increasing awareness and disease prevention.",
     "correctness": "0.0"
    }
