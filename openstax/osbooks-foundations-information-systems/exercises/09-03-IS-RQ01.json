 "questions": [
  {
   "id": 552199,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do career opportunities in project management change depending on the field you go into?",
   "answers": [
    {
     "id": 1083156,
     "content_html": "Some positions require a degree in project management."
    },
    {
     "id": 1083157,
     "content_html": "Some positions only require a certification or training in project management."
    },
    {
     "id": 1083158,
     "content_html": "Some positions require a background in the specific industry or field of study (such as health care)."
    },
    {
     "id": 1083159,
     "content_html": "Some positions remain the same regardless of the industry in which you have experience or background."
    }
   ],
