   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a true statement about the process of innovation?",
   "answers": [
    {
     "id": 1083340,
     "content_html": "It follows the systematic steps: conception, implementation, marketing, and communication."
    },
    {
     "id": 1083341,
     "content_html": "Analyzing and recording information is the first step in identifying and selecting resources."
    },
    {
     "id": 1083342,
     "content_html": "The scientific research process and associated skills are at the core of the research process."
    },
    {
     "id": 1083343,
     "content_html": "Information must be recorded and communicated immediately."
    }
