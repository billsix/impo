   "id": 551674,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does the World Intellectual Property Organization (WIPO) primarily do?",
   "answers": [
    {
     "id": 1083088,
     "content_html": "protects individual copyrights globally"
    },
    {
     "id": 1083089,
     "content_html": "prosecutes international patent infringements"
    },
    {
     "id": 1083090,
     "content_html": "promotes the protection of IP rights worldwide"
    },
    {
     "id": 1083091,
     "content_html": "assigns internet domain names"
    }
