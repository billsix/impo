   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of these statements is most true about the STL file format?",
   "answers": [
    {
     "id": 1069953,
     "content_html": "It can only describe the surface geometry of a 3 dimensional object"
    },
    {
     "id": 1069954,
     "content_html": "It is in metric units"
    },
    {
     "id": 1069955,
     "content_html": "It is used by the designer to designate features like color and material"
    },
    {
     "id": 1069956,
     "content_html": "It is interchangeable with CAD"
    }
