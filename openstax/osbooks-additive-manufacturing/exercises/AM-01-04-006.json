   "id": 544658,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Materials Engineers are important team players in AM because they can contribute to which of the following?",
   "answers": [
    {
     "id": 1070125,
     "content_html": "Assessing the impact of property anisotropy, or if printed parts will exhibit different properties in the build or vertical direction"
    },
    {
     "id": 1070126,
     "content_html": "Applying materials science as to whether a polymer material can be used in Material Extrusion"
    },
    {
     "id": 1070127,
     "content_html": "Assessing the necessity of post build processing to meet requirements"
    },
    {
     "id": 1070128,
     "content_html": "All of the above"
    }
   ],
