   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A powder particle size distribution denoted by D90=100 means what?\n",
   "answers": [
    {
     "id": 1070467,
     "content_html": "All the powder particles are less than 90 microns"
    },
    {
     "id": 1070468,
     "content_html": "90% of powder particles are less than 100 microns"
    },
    {
     "id": 1070469,
     "content_html": "90% of powder particles are equal to 100 microns"
    },
    {
     "id": 1070470,
     "content_html": "100% of powder particles are less than 90 microns"
