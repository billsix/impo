   "stem_html": "What differentiates Material Extrusion from the other AM processes?",
   "answers": [
    {
     "id": 1070141,
     "content_html": "Can be plastic or metallic"
    },
    {
     "id": 1070142,
     "content_html": "The material is deposited through layers in the X and Y direction"
    },
    {
     "id": 1070143,
     "content_html": "The material is extruded through a nozzle, die, or orifice"
    },
    {
     "id": 1070144,
     "content_html": "All of the above"
