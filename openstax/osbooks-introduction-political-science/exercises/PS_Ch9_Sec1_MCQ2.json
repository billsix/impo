   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What occurs most commonly when no party wins a majority of seats in a legislature? ",
   "answers": [
    {
     "id": 1289583,
     "content_html": "New elections are called."
    },
    {
     "id": 1289582,
     "content_html": "The legislature is disbanded."
    },
    {
     "id": 1289581,
     "content_html": "The largest party is given control."
    },
    {
     "id": 1289584,
     "content_html": "Parties form a coalition."
    }
