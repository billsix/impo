   "stimulus_html": "",
   "stem_html": "Nullification is __________.",
   "answers": [
    {
     "id": 695859,
     "content_html": "when people or other branches of government disregard a court decision or statute because they disagree with it"
    },
    {
     "id": 695860,
     "content_html": "a protected right of the people"
    },
    {
     "id": 695861,
     "content_html": "a protected right of the executive and legislative branches"
    },
    {
     "id": 695862,
     "content_html": "All of the above"
    }
