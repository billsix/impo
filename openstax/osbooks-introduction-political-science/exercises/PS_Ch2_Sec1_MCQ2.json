   "id": 654451,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A common element in the differing conceptions of social justice is that ________.",
   "answers": [
    {
     "id": 1289212,
     "content_html": "each society should define social justice in its own way"
    },
    {
     "id": 1289213,
     "content_html": "opportunities, resources, and rights should be distributed equitably "
    },
    {
     "id": 1289211,
     "content_html": "those in power should produce it"
    },
    {
     "id": 1289210,
     "content_html": "rights should be allocated according to group membership"
    }
   ],
