   "id": 654491,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is due process?",
   "answers": [
    {
     "id": 1289373,
     "content_html": "A legal requirement that the government respect the rights of the people"
    },
    {
     "id": 1289372,
     "content_html": "A standard that gives precedence to government power over individual rights"
    },
    {
     "id": 1289371,
     "content_html": "A standard that subjugates government power to individual rights "
    },
    {
     "id": 1289370,
     "content_html": "A legal requirement that a rule-by-law government cannot violate the law"
    }
   ],
