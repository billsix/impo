   "id": 191793,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the definition of an interest group?",
   "answers": [
    {
     "id": 688766,
     "content_html": "A group of people who work to get a candidate elected from a certain party"
    },
    {
     "id": 688767,
     "content_html": "A group of people who work to influence policy and support candidates regardless of party"
    },
    {
     "id": 688768,
     "content_html": "A group of bipartisan voters"
    },
    {
     "id": 688769,
     "content_html": "None of the above"
    }
   ],
