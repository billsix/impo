 "questions": [
  {
   "id": 205592,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between civil liberties and civil rights?",
   "answers": [
    {
     "id": 696063,
     "content_html": "Civil liberties apply to everyone, while civil rights apply only to certain groups. "
    },
    {
     "id": 696064,
     "content_html": "Civil liberties are guarantees of freedom from government interference, while civil rights are government guarantees of equal treatment."
    },
    {
     "id": 696065,
     "content_html": "The two terms are interchangeable."
    },
    {
     "id": 696066,
     "content_html": "Both A and B are correct."
    }
   ],
