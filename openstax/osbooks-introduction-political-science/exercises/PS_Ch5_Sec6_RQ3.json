   "id": 654520,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Public opinion is important in global politics because:",
   "answers": [
    {
     "id": 1289487,
     "content_html": "It is easy to poll people from several countries at once"
    },
    {
     "id": 1289488,
     "content_html": "It allows us to understand how to cooperate globally"
    },
    {
     "id": 1289486,
     "content_html": "It reinforces the status of global powers"
    },
    {
     "id": 1289485,
     "content_html": "Global polling is more cost effective than domestic polling"
    }
   ],
