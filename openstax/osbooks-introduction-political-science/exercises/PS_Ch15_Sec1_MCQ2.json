 "questions": [
  {
   "id": 654659,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the tragedy of the commons impede the attainment of collective goods?",
   "answers": [
    {
     "id": 1290033,
     "content_html": " Individual states have incentives to provide for their own short-term interests over long-term community interests."
    },
    {
     "id": 1290032,
     "content_html": "When common goods are concentrated in one area, states without ready access to that area may be unable to attain the goods before those goods spoil."
    },
    {
     "id": 1290031,
     "content_html": "States with similar interests tend to form alliances to prevent other states from attaining collective goods."
    },
    {
     "id": 1290030,
     "content_html": "The tragedy of the commons means that common markets are doomed to fail."
    }
   ],
