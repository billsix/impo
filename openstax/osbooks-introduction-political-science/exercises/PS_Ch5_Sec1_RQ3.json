   "stimulus_html": "",
   "stem_html": "Voting is an important type of political participation because:",
   "answers": [
    {
     "id": 1289424,
     "content_html": "Voting is compulsory in the United States"
    },
    {
     "id": 1289423,
     "content_html": "Everyone votes"
    },
    {
     "id": 1289422,
     "content_html": "Voting and political participation are the same thing"
    },
    {
     "id": 1289425,
     "content_html": "It is the primary way that people express their will"
    }
