 "questions": [
  {
   "id": 654582,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is considered an advantage in parliamentarianism?",
   "answers": [
    {
     "id": 1289730,
     "content_html": "Coalition governments are possible, which means fewer elections due to more representation of groups in parliament."
    },
    {
     "id": 1289729,
     "content_html": "During a time of crisis, prime ministers can act much more quickly than presidents can."
    },
    {
     "id": 1289728,
     "content_html": "Prime ministers always enjoy majority support of the parliament."
    },
    {
     "id": 1289731,
     "content_html": "Frequently, minority parties are represented in the parliament."
    }
   ],
