   "id": 654625,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A governing regime is defined as ________.",
   "answers": [
    {
     "id": 1289894,
     "content_html": "a set of organizations with little power but constant legitimacy"
    },
    {
     "id": 1289893,
     "content_html": "an organization whose power is consistent over time"
    },
    {
     "id": 1289895,
     "content_html": "a set of organizations, with their associated rules and procedures, that has the authority to exercise the widest scope of power over a defined area"
    },
    {
     "id": 1289892,
     "content_html": "a set of organizations committed to revolutionary social change"
    }
   ],
