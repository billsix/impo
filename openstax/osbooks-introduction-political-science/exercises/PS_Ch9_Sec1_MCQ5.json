 "questions": [
  {
   "id": 654547,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is not a reason that committees are formed in legislatures?",
   "answers": [
    {
     "id": 1289595,
     "content_html": "They allow legislators to specialize in certain policy areas."
    },
    {
     "id": 1289594,
     "content_html": "They allow legislators to delegate decision-making to others who are more knowledgeable."
    },
    {
     "id": 1289596,
     "content_html": "They give legislators more authority in that policy area than the executive."
    },
    {
     "id": 1289593,
     "content_html": "They give legislators an opportunity to take on leadership roles."
    }
   ],
