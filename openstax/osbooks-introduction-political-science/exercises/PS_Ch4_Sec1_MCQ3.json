   "stimulus_html": "",
   "stem_html": "What are community responsibilities? ",
   "answers": [
    {
     "id": 1289348,
     "content_html": "The government’s responsibility not to interfere with any group"
    },
    {
     "id": 1289347,
     "content_html": "Community members’ responsibility to help each other in times of crisis"
    },
    {
     "id": 1289349,
     "content_html": "An individual’s responsibility to the community in order to remain a member of that community"
    },
    {
     "id": 1289346,
     "content_html": "An individual’s responsibility to form a community "
    }
