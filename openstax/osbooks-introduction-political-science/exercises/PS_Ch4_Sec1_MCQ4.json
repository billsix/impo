 "questions": [
  {
   "id": 654486,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How are community responsibilities carried out?",
   "answers": [
    {
     "id": 1289353,
     "content_html": "Actors, including governments, cooperate with and respect others and participate in the community."
    },
    {
     "id": 1289352,
     "content_html": "Individuals act as they want and do not consider the impact of their actions on others. "
    },
    {
     "id": 1289351,
     "content_html": "In each nation-state, everyone votes on all rules and restrictions on conduct."
    },
    {
     "id": 1289350,
     "content_html": "In each nation-state, an elite group decides what rules to create and enforce on everyone else. "
    }
   ],
