   "stimulus_html": "",
   "stem_html": "States of emergency ________.",
   "answers": [
    {
     "id": 1289904,
     "content_html": "are unknown in contemporary global politics"
    },
    {
     "id": 1289903,
     "content_html": "are periods where the ordinary operations of the legal system are suspended"
    },
    {
     "id": 1289902,
     "content_html": "are sometimes broadly supported and periodically and legitimately reauthorized"
    },
    {
     "id": 1289901,
     "content_html": "have the potential to erode the legitimacy of a regime if the people see them as abusive"
    },
    {
     "id": 1289905,
     "content_html": "b, c, and d"
    },
    {
     "id": 1289900,
     "content_html": "all of the above"
    }
