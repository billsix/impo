   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a political party?",
   "answers": [
    {
     "id": 689570,
     "content_html": "A group that forms based on a political ideology"
    },
    {
     "id": 689571,
     "content_html": "A group that forms to make sure as many members of their own party get elected as possible"
    },
    {
     "id": 689572,
     "content_html": "A group that forms to influence policy outcomes in government"
    },
    {
     "id": 689573,
     "content_html": "All of the above"
    }
