   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The term <em>echo chambers</em> refers to:",
   "answers": [
    {
     "id": 696029,
     "content_html": "The phenomenon in which social media allows people to be surrounded by opinions that mirror their own"
    },
    {
     "id": 696030,
     "content_html": "The way in which the media echoes elite opinions"
    },
    {
     "id": 696031,
     "content_html": "The idea that people echo their own voices on social media"
    },
    {
     "id": 696032,
     "content_html": "None of the above"
    }
