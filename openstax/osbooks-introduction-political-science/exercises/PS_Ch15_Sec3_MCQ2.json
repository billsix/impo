   "stimulus_html": "",
   "stem_html": "When and why was the United Nations created?",
   "answers": [
    {
     "id": 1290072,
     "content_html": "After World War I, to punish Germany"
    },
    {
     "id": 1290073,
     "content_html": "After World War II, to promote international peace"
    },
    {
     "id": 1290071,
     "content_html": "During the Cold War, to deter the Soviet Union"
    },
    {
     "id": 1290070,
     "content_html": "In the 1980s, to prevent nuclear war"
    }
