 "questions": [
  {
   "id": 654612,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How do civil laws differ from criminal laws?",
   "answers": [
    {
     "id": 1289842,
     "content_html": "Criminal laws apply to disputes between individuals or groups, while civil laws apply to offenses against the state."
    },
    {
     "id": 1289843,
     "content_html": "Criminal laws are intended to protect society, while civil laws are intended to settle disputes and reimburse individuals for damages."
    },
    {
     "id": 1289841,
     "content_html": "Criminal laws are enforced by the executive, while civil laws are enforced by the courts."
    },
    {
     "id": 1289840,
     "content_html": "Criminal laws are not subject to appeal, while civil laws may be."
    }
   ],
