   "stimulus_html": "",
   "stem_html": "Collective action problems are less severe in small groups than large groups because __________.",
   "answers": [
    {
     "id": 1289531,
     "content_html": "individuals are less able to free ride"
    },
    {
     "id": 1289530,
     "content_html": "it is easier to monitor individual behavior"
    },
    {
     "id": 1289529,
     "content_html": "peer pressure is stronger"
    },
    {
     "id": 1289532,
     "content_html": "All of the above"
