  {
   "id": 654503,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Political participation is related to self-government because:",
   "answers": [
    {
     "id": 1289420,
     "content_html": "They are both in the Constitution"
    },
    {
     "id": 1289421,
     "content_html": "Without self-government, there can be no meaningful political participation"
    },
    {
     "id": 1289419,
     "content_html": "Self-government and political participation are the same thing"
    },
    {
     "id": 1289418,
     "content_html": "Both are essential for state sovereignty"
    }
   ],
