   "stimulus_html": "",
   "stem_html": "The writ of habeas corpus is __________.",
   "answers": [
    {
     "id": 1289404,
     "content_html": "recognized throughout the world"
    },
    {
     "id": 1289403,
     "content_html": "freedom from warrantless search"
    },
    {
     "id": 1289405,
     "content_html": "a prisoner’s right to be informed of why they are being held"
    },
    {
     "id": 1289402,
     "content_html": "the right of the accused to be warned that anything they say may be used against them in court"
    }
