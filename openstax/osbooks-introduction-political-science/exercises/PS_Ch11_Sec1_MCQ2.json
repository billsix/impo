 "questions": [
  {
   "id": 204959,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The difference between rule <i>of</i> law and rule <i>by</i> law is that __________.",
   "answers": [
    {
     "id": 695851,
     "content_html": "rule of law means that no one is above the law, while rule by law means that those in power manipulate the system to increase their power"
    },
    {
     "id": 695852,
     "content_html": "in rule of law, unlike in rule by law, the laws are clear, publicized, stable, and applied evenly, and they protect fundamental rights such as the security of persons and property and certain core human rights"
    },
    {
     "id": 695853,
     "content_html": "rule-of-law countries punish citizens for crimes, while rule-by-law countries do not"
    },
    {
     "id": 695854,
     "content_html": "Both A and B"
    }
   ],
