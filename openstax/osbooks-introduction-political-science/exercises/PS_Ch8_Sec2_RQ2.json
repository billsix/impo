 "questions": [
  {
   "id": 191844,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of these is a disadvantage of interest groups?",
   "answers": [
    {
     "id": 688970,
     "content_html": "Interest groups represent multiple viewpoints about how people want government to act."
    },
    {
     "id": 688971,
     "content_html": "Interest groups raise money for candidates so that their policies can be implemented."
    },
    {
     "id": 688972,
     "content_html": "Interest group activity can lead to a minority rather than a majority being heard in government."
    },
    {
     "id": 688973,
     "content_html": "Interest groups play no role in government."
    }
   ],
