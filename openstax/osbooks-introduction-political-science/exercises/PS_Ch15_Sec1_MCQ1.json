   "stimulus_html": "",
   "stem_html": "What is global governance?",
   "answers": [
    {
     "id": 1290028,
     "content_html": "The world government run by the United Nations"
    },
    {
     "id": 1290029,
     "content_html": "The process by which sovereign states accrue rights and duties in the international community"
    },
    {
     "id": 1290027,
     "content_html": "The process by which more powerful states control the actions of weaker states"
    },
    {
     "id": 1290026,
     "content_html": "The ability of the United States to convince other states to act in accordance with its policies"
    }
   ],
