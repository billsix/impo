 "questions": [
  {
   "id": 654539,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about the civil rights movement of the 1950s and 1960s and Black Lives Matter is correct?",
   "answers": [
    {
     "id": 1289563,
     "content_html": "Police brutality is the primary focus of both movements."
    },
    {
     "id": 1289564,
     "content_html": "Black Lives Matter has primarily been organized via social media."
    },
    {
     "id": 1289562,
     "content_html": "Equal access to public accommodation, employment, and educational opportunities was not a priority in the 1960s."
    },
    {
     "id": 1289561,
     "content_html": "Both movements originated in African American churches."
    }
   ],
