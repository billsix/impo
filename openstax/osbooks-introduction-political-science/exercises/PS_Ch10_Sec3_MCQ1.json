 "questions": [
  {
   "id": 654575,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In a parliamentary regime, the prime minister is chosen by the legislature. Before being selected, what institution are prime ministers a member of?",
   "answers": [
    {
     "id": 1289703,
     "content_html": "If the country has a monarchy, they are part of the royal family."
    },
    {
     "id": 1289702,
     "content_html": "When the citizens voted, they directly elected their prime minister."
    },
    {
     "id": 1289701,
     "content_html": "Before becoming prime minister, they served in the judiciary to learn the laws of the country."
    },
    {
     "id": 1289704,
     "content_html": "The prime minister is a member of parliament."
    }
   ],
