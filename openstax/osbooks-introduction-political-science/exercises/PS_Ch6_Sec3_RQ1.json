 "questions": [
  {
   "id": 654525,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which is not a cause of a collective dilemma?",
   "answers": [
    {
     "id": 1289507,
     "content_html": "Participants agree on a goal but not on how to obtain it."
    },
    {
     "id": 1289506,
     "content_html": "Participants have motivations contrary to the group’s goals."
    },
    {
     "id": 1289508,
     "content_html": "Participants share a common political culture."
    },
    {
     "id": 1289505,
     "content_html": "Participants disagree on what the goals should be."
    }
