 "questions": [
  {
   "id": 654532,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A key difference between small groups and large groups regarding collective action problems is __________.",
   "answers": [
    {
     "id": 1289536,
     "content_html": "monitoring and enforcement are easier in small groups"
    },
    {
     "id": 1289535,
     "content_html": "individuals have different incentives in large and small groups"
    },
    {
     "id": 1289534,
     "content_html": "small groups are more prone to prisoner’s dilemmas"
    },
    {
     "id": 1289533,
     "content_html": "large groups can rely more on social trust"
    }
   ],
