  {
   "id": 654607,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Standing in a court case is __________.",
   "answers": [
    {
     "id": 1289821,
     "content_html": "rising as a show of respect when the judge enters the courtroom"
    },
    {
     "id": 1289822,
     "content_html": "when a person has a direct injury from the effect of a law, so they can complain about in court"
    },
    {
     "id": 1289820,
     "content_html": "the right of anyone who does not like a law to complain about it in court on principle"
    },
    {
     "id": 1289819,
     "content_html": "complaining about a law to the legislature"
    }
   ],
