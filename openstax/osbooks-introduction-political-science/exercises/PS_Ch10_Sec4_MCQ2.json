 "questions": [
  {
   "id": 654581,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is considered an advantage in presidentialism?",
   "answers": [
    {
     "id": 1289726,
     "content_html": "Lack of accountability means the president can never be blamed."
    },
    {
     "id": 1289725,
     "content_html": "The legislature and the presidency are assured to be held by the same party."
    },
    {
     "id": 1289727,
     "content_html": "Separation of powers may provide minority groups protection of their rights."
    },
    {
     "id": 1289724,
     "content_html": "Political parties and party discipline are very strong."
    }
   ],
