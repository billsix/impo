   "stimulus_html": "",
   "stem_html": "Which of these is an advantage of interest groups?",
   "answers": [
    {
     "id": 688962,
     "content_html": "They argue against substantive policy change."
    },
    {
     "id": 688963,
     "content_html": "They allow people with strong opinions on relevant issues to try to affect policy."
    },
    {
     "id": 688964,
     "content_html": "They increase the amount of dark money in politics."
    },
    {
     "id": 688965,
     "content_html": "None of the above"
