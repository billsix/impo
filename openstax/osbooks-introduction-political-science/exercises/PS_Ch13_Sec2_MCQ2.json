   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Morocco has an elected legislature, and although recent reforms have given the legislature and the judiciary expanded powers, the king still has the ultimate power to override any legislative or judicial decision. These characteristics make the Moroccan government ________.",
   "answers": [
    {
     "id": 1289916,
     "content_html": "a form of hard authoritarianism"
    },
    {
     "id": 1289917,
     "content_html": "a form of soft authoritarianism"
    },
    {
     "id": 1289915,
     "content_html": "a form of representative democracy"
    },
    {
     "id": 1289914,
     "content_html": "a socialist state"
    }
