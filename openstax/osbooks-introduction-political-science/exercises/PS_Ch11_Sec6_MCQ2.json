 "questions": [
  {
   "id": 654616,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In an executive sovereignty system, __________.",
   "answers": [
    {
     "id": 1289859,
     "content_html": "the courts cannot review the actions of the legislature or the executive for their constitutionality"
    },
    {
     "id": 1289858,
     "content_html": "the executive branch can disregard all court decisions at will"
    },
    {
     "id": 1289857,
     "content_html": "the legislative branch can disregard all court decisions at will"
    },
    {
     "id": 1289856,
     "content_html": "the executive serves on the judiciary"
    }
   ],
