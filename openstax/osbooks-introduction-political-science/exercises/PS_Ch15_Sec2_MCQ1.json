   "stem_html": "What is international law?",
   "answers": [
    {
     "id": 1290048,
     "content_html": "The laws established by the world government"
    },
    {
     "id": 1290047,
     "content_html": "The law that determines punishments for sovereign states"
    },
    {
     "id": 1290049,
     "content_html": "A set of formal and informal rules that loosely govern the international system"
    },
    {
     "id": 1290046,
     "content_html": "Domestic laws that relate to international relations"
    }
