   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the mission of the European Union today differ from its original purpose?",
   "answers": [
    {
     "id": 1290096,
     "content_html": "It has evolved to focus on trade policy."
    },
    {
     "id": 1290095,
     "content_html": "It has evolved to focus on Eastern Europe."
    },
    {
     "id": 1290097,
     "content_html": "It has evolved to coordinate state policies in a wide variety of areas."
    },
    {
     "id": 1290094,
     "content_html": "It has evolved to focus on military security."
    }
