 "questions": [
  {
   "id": 204967,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An appeal is __________.",
   "answers": [
    {
     "id": 695886,
     "content_html": "a higher court’s review of a lower court’s decision"
    },
    {
     "id": 695887,
     "content_html": "a review in which a higher court checks to see if an error by a lower court caused the trial to render an improper verdict"
    },
    {
     "id": 695888,
     "content_html": "a defendant’s attempt to persuade the jury throughout the duration of a trial, irrespective of the evidence"
    },
    {
     "id": 695889,
     "content_html": "Both A and B"
    },
    {
     "id": 695890,
     "content_html": "None of the above"
    }
   ],
