  {
   "id": 654632,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Democratic representative systems with a congress, president, and independent judiciary ________.",
   "answers": [
    {
     "id": 1289924,
     "content_html": "seek to have broad legitimacy by limiting government to a few core functions, such as maintaining domestic peace and stability"
    },
    {
     "id": 1289923,
     "content_html": "cannot be unitary regimes"
    },
    {
     "id": 1289922,
     "content_html": "cannot become corrupt"
    },
    {
     "id": 1289925,
     "content_html": "elect the president independently of the legislature"
    }
   ],
