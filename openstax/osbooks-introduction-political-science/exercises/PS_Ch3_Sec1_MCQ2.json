   "stem_html": "How does Aristotle describe democracy?",
   "answers": [
    {
     "id": 1289268,
     "content_html": "As a system of government directed toward the benefit of the rich"
    },
    {
     "id": 1289267,
     "content_html": "As a system of government that necessarily benefits all "
    },
    {
     "id": 1289266,
     "content_html": "As the ideal political system"
    },
    {
     "id": 1289269,
     "content_html": "As a defective system that works for the interests of the many at the expense of the rest"
    }
