  {
   "id": 654569,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is typically seen as an element of populism?",
   "answers": [
    {
     "id": 1289681,
     "content_html": "It uses rational arguments that appeal to elites."
    },
    {
     "id": 1289680,
     "content_html": "It supports established institutions and embraces mainstream politics."
    },
    {
     "id": 1289682,
     "content_html": "It uses emotional appeals directed at the masses."
    },
    {
     "id": 1289679,
     "content_html": "It was most relevant in the late 1800s and is rarely seen in the 21st century."
    }
   ],
