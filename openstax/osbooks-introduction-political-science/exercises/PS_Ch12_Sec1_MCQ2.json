   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The gatekeeping role of the media refers to:",
   "answers": [
    {
     "id": 1289867,
     "content_html": "The fact that the media determines what topics the public sees"
    },
    {
     "id": 1289866,
     "content_html": "The media’s strict standards for who becomes a journalist"
    },
    {
     "id": 1289865,
     "content_html": "The fact that journalists don’t have the power to decide what is in the news"
    },
    {
     "id": 1289864,
     "content_html": "The way the media keeps out certain audiences"
    }
   ],
