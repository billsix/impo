   "id": 654533,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<i>Civil rights</i> is defined as ________.",
   "answers": [
    {
     "id": 1289539,
     "content_html": "limits on the government’s ability to restrict individuals"
    },
    {
     "id": 1289540,
     "content_html": "government guarantees of equal protection under the law to guarantee a group’s rights are not violated or denied"
    },
    {
     "id": 1289538,
     "content_html": "the right to sue"
    },
    {
     "id": 1289537,
     "content_html": "another name for the first 10 amendments to the Constitution"
    }
