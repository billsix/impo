 "questions": [
  {
   "id": 654580,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is considered an advantage of presidentialism?",
   "answers": [
    {
     "id": 1289722,
     "content_html": "The government is unified, and policy is enacted quickly."
    },
    {
     "id": 1289723,
     "content_html": "The president can claim a mandate."
    },
    {
     "id": 1289721,
     "content_html": "There exists a clear line of policy making."
    },
    {
     "id": 1289720,
     "content_html": "Both the head of state and the head of government are the same person, increasing efficiency."
    }
   ],
