     "id": 1289886,
     "content_html": "It is timely"
    },
    {
     "id": 1289885,
     "content_html": "It is not in touch with the public"
    },
    {
     "id": 1289887,
     "content_html": "It can be shared without constraints of time or space"
    },
    {
     "id": 1289884,
     "content_html": "It is information that is biased"
    }
