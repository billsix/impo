  {
   "id": 191864,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What do adverse selection, moral hazard, and voter suppression have in common when it comes to elections?",
   "answers": [
    {
     "id": 689050,
     "content_html": "They show how important elections are to parties."
    },
    {
     "id": 689051,
     "content_html": "They explain the weaknesses of ballot initiatives."
    },
    {
     "id": 689052,
     "content_html": "They illustrate some problems of elections in general."
    },
    {
     "id": 689053,
     "content_html": "They speak to the growing concerns around fundraising in elections."
    }
   ],
