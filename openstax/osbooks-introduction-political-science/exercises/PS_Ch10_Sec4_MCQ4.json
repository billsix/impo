 "questions": [
  {
   "id": 654583,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is considered an advantage in parliamentarianism?",
   "answers": [
    {
     "id": 1289735,
     "content_html": "Political parties and party discipline are very strong."
    },
    {
     "id": 1289734,
     "content_html": "Separation of powers is strong and includes an independent judiciary."
    },
    {
     "id": 1289733,
     "content_html": "Prime ministers can claim a mandate."
    },
    {
     "id": 1289732,
     "content_html": "Parliamentary regimes allow for far-reaching policy change from one government to the next."
    }
   ],
