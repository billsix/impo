 "questions": [
  {
   "id": 654606,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How are judicial decisions implemented?",
   "answers": [
    {
     "id": 1289818,
     "content_html": "Courts rely on the other branches of government to implement their decisions."
    },
    {
     "id": 1289817,
     "content_html": "The people accept the court’s decisions and comply."
    },
    {
     "id": 1289816,
     "content_html": "Private lawyers interpret the court’s decisions and write new laws."
    },
    {
     "id": 1289815,
     "content_html": "The military and police ensure adherence to judicial decisions."
    }
   ],
