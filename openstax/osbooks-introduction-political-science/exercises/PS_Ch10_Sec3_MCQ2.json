   "id": 654576,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the following parties and the percent each party won in an election. In a parliamentary regime, which party would the prime minister be from?",
   "answers": [
    {
     "id": 1289708,
     "content_html": "Conservative Party—25 percent"
    },
    {
     "id": 1289709,
     "content_html": "Liberal Party—55 percent"
    },
    {
     "id": 1289707,
     "content_html": "New Democratic Party—15 percent"
    },
    {
     "id": 1289706,
     "content_html": "Green Party—5 percent"
    },
    {
     "id": 1289705,
     "content_html": "From the information provided, it cannot be determined which party the prime minister would come from. The prime minister could come from any of the above parties or a party not listed."
    }
