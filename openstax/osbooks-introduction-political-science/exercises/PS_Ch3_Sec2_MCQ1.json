   "stimulus_html": "",
   "stem_html": "What is the state of nature?",
   "answers": [
    {
     "id": 1289273,
     "content_html": "The condition in which government exists and serves the public interest"
    },
    {
     "id": 1289272,
     "content_html": "The condition before a government exists"
    },
    {
     "id": 1289271,
     "content_html": "A key concept in the political thought of Hobbes, Locke, and Rousseau"
    },
    {
     "id": 1289270,
     "content_html": "The condition in which government exists and abuses the rich"
    },
    {
     "id": 1289274,
     "content_html": "Both B and C"
    }
   ],
