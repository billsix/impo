   "stem_html": "Framing theory is:",
   "answers": [
    {
     "id": 1289870,
     "content_html": "A theory about why the way pictures are framed in the media changes people’s perception of the news"
    },
    {
     "id": 1289869,
     "content_html": "The same as agenda-setting theory"
    },
    {
     "id": 1289868,
     "content_html": "A theory about how people frame news stories in their minds"
    },
    {
     "id": 1289871,
     "content_html": "The theory that the way the media frames stories alters how people think about policies or elected officials and candidates"
    }
