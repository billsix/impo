   "stem_html": "Due process means that __________.",
   "answers": [
    {
     "id": 695876,
     "content_html": "a court has the authority to hear a case"
    },
    {
     "id": 695877,
     "content_html": "the government must respect the rights of the accused"
    },
    {
     "id": 695878,
     "content_html": "procedural processes must be fair"
    },
    {
     "id": 695879,
     "content_html": "Both B and C"
    },
    {
     "id": 695880,
     "content_html": "All of the above"
