   "stimulus_html": "",
   "stem_html": "Why are elections important for a democracy?",
   "answers": [
    {
     "id": 689042,
     "content_html": "They allow members of society to express opinions and preferences to elected officials."
    },
    {
     "id": 689043,
     "content_html": "They allow candidates to raise and spend money to get elected."
    },
    {
     "id": 689044,
     "content_html": "They are important for the media to report on."
    },
    {
     "id": 689045,
     "content_html": "None of the above are correct."
    }
