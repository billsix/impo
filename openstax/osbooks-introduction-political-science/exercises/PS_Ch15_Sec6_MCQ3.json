 "questions": [
  {
   "id": 654683,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of these is not a source of power for non-state actors?",
   "answers": [
    {
     "id": 1290128,
     "content_html": "They can attract members from many different states. "
    },
    {
     "id": 1290127,
     "content_html": "They often have access to large amounts of money."
    },
    {
     "id": 1290126,
     "content_html": "They may operate in places without strong regulations or police."
    },
    {
     "id": 1290129,
     "content_html": "They are formally recognized by powerful IGOs."
    }
   ],
