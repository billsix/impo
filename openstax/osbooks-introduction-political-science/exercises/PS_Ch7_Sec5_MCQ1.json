 "questions": [
  {
   "id": 654541,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Define <i>institutional racism</i>.",
   "answers": [
    {
     "id": 1289571,
     "content_html": "The motivation to have the president and Congressional leadership be from different political parties"
    },
    {
     "id": 1289570,
     "content_html": "A specific system of redrawing congressional districts every 10 years following the Census"
    },
    {
     "id": 1289569,
     "content_html": "A provision of the 1964 Civil Rights Act to allow certain minorities to receive preference when it comes to hiring"
    },
    {
     "id": 1289572,
     "content_html": "Racism perpetrated by social and political institutions that have the power to affect large groups of people that belong to a racial group"
    }
   ],
