 "questions": [
  {
   "id": 654556,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is a common reason for countries to have a bicameral legislature?",
   "answers": [
    {
     "id": 1289631,
     "content_html": "Bicameral legislatures ensure a better citizen-to-elected-official ratio."
    },
    {
     "id": 1289630,
     "content_html": "Bicameral legislatures produce more thoughtful and durable legislation."
    },
    {
     "id": 1289632,
     "content_html": "Bicameral legislatures help give voice to different segments of society. "
    },
    {
     "id": 1289629,
     "content_html": "Bicameral legislatures help make legislating faster and more efficient."
    }
   ],
