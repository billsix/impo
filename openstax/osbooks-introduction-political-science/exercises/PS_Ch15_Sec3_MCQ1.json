   "stimulus_html": "",
   "stem_html": "What is an IGO?",
   "answers": [
    {
     "id": 1290068,
     "content_html": "An informal group of sovereign states"
    },
    {
     "id": 1290067,
     "content_html": "A union of states that agree to sacrifice their individual interests for the good of the most powerful"
    },
    {
     "id": 1290069,
     "content_html": "A formal organization where states are members"
    },
    {
     "id": 1290066,
     "content_html": "A militant religious organization"
    }
