 "questions": [
  {
   "id": 243455,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare the interference patterns of single-slit diffraction, double-slit diffraction, and a diffraction grating.",
   "answers": [
    {
     "id": 763221,
     "content_html": "All three interference pattern produce identical bands."
    },
    {
     "id": 763222,
     "content_html": "A double slit produces the sharpest and most distinct bands."
    },
    {
     "id": 763223,
     "content_html": "A single slit produces the sharpest and most distinct bands."
    },
    {
     "id": 763224,
     "content_html": "The diffraction grating produces the sharpest and most distinct bands."
    }
   ],
