   "stimulus_html": "<iframe src=\"https://www.youtube.com/embed/zAx61CO5mDw\"></iframe>",
   "stem_html": "For an object traveling in a circular path at a constant angular speed, would the linear speed of the object change if the radius of the path increases?",
   "answers": [
    {
     "id": 1162751,
     "content_html": "Yes, because tangential speed is independent of the radius."
    },
    {
     "id": 1162752,
     "content_html": "Yes, because tangential speed depends on the radius."
    },
    {
     "id": 1162750,
     "content_html": "No, because tangential speed is independent of the radius."
    },
    {
