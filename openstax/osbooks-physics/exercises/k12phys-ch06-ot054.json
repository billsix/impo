   "stem_html": "When is angular acceleration negative?",
   "answers": [
    {
     "id": 1039480,
     "content_html": "Angular acceleration is the rate of change of the displacement and is negative when <span data-math=\"\\omega\">\\omega</span> increases."
    },
    {
     "id": 1039481,
     "content_html": "Angular acceleration is the rate of change of the displacement and is negative when <span data-math=\"\\omega\">\\omega</span> decreases."
    },
    {
     "id": 1039482,
     "content_html": "Angular acceleration is the rate of change of angular velocity and is negative when <span data-math=\"\\omega\">\\omega</span> increases."
    },
    {
     "id": 1039483,
     "content_html": "Angular acceleration is the rate of change of angular velocity and is negative when <span data-math=\"\\omega\">\\omega</span> decreases."
