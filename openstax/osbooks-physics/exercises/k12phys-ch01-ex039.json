 "questions": [
  {
   "id": 501679,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The free-electron model of metals explains some of the important behaviors of metals by assuming the metal’s electrons move freely through the metal without repelling one another. In what sense is the free-electron theory based on a model?",
   "answers": [
    {
     "id": 986025,
     "content_html": "Its use requires constructing replicas of the metal wire in the lab."
    },
    {
     "id": 986026,
     "content_html": "It involves analyzing an imaginary system simpler than the real wire it resembles."
    },
    {
     "id": 986027,
     "content_html": "It examines a model, or ideal, behavior that other metals should imitate."
    },
    {
     "id": 986028,
     "content_html": "It attempts to examine the metal in a very realistic, or model, way."
    }
   ],
