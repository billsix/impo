   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the relation between the amplitude and the frequency of a wave?",
   "answers": [
    {
     "id": 745755,
     "content_html": "The amplitude and the frequency of a wave are independent of each other."
    },
    {
     "id": 745754,
     "content_html": "The amplitude and the frequency of a wave are equal."
    },
    {
     "id": 745753,
     "content_html": "The amplitude decreases with an increase in the frequency of a wave."
    },
    {
     "id": 745752,
     "content_html": "The amplitude increases with an increase in the frequency of a wave."
    }
