 "questions": [
  {
   "id": 613801,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe two ways in which light differs from all other forms of wave energy.",
   "answers": [
    {
     "id": 1163221,
     "content_html": "<ol>\n  <li>Light travels as a longitudinal wave.</li>\n  <li>Light travels through a medium that fills up the empty space in the universe.</li>\n</ol>\n"
    },
    {
     "id": 1163220,
     "content_html": "<ol>\n  <li>Light travels as a transverse wave.</li>\n  <li>Light travels through a medium that fills up the empty space in the universe.</li>\n</ol>\n"
    },
    {
     "id": 1163219,
     "content_html": "<ol>\n  <li>Light travels at the maximum possible speed in the universe.</li>\n  <li>Light travels through a medium that fills up the empty space in the universe.</li>\n</ol>\n"
    },
    {
     "id": 1163222,
     "content_html": "<ol>\n  <li>Light travels at the maximum possible speed in the universe.</li>\n  <li>Light does not require any material medium to travel.</li>\n</ol>\n"
    }
   ],
