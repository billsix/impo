 "questions": [
  {
   "id": 243030,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is decibel (dB) used to describe loudness of sound?",
   "answers": [
    {
     "id": 761559,
     "content_html": "Because, human ears have an inverse response to the amplitude of sound."
    },
    {
     "id": 761558,
     "content_html": "Because, human ears have an inverse response to the intensity of sound."
    },
    {
     "id": 761557,
     "content_html": "Because, the way our ears perceive sound can be more accurately described by the amplitude of a sound rather than the intensity of a sound directly."
    },
    {
     "id": 761560,
     "content_html": "Because, the way our ears perceive sound can be more accurately described by the logarithm of the intensity of a sound rather than the intensity of a sound directly."
    }
   ],
