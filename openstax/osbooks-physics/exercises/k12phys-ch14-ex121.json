   "stimulus_html": "",
   "stem_html": "What is the possible number of nodes and antinodes along one full wavelength of a standing wave?",
   "answers": [
    {
     "id": 762091,
     "content_html": "<span data-math=\"2\">2</span> nodes and <span data-math=\"3\">3</span> antinodes or <span data-math=\"2\">2</span> antinodes and <span data-math=\"3\">3</span> nodes."
