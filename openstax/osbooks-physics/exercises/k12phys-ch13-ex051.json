  {
   "id": 239018,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the relation between a wave’s energy and its amplitude?",
   "answers": [
    {
     "id": 745758,
     "content_html": "There is no relation between the energy and the amplitude of a wave."
    },
    {
     "id": 745757,
     "content_html": "The magnitude of the energy is equal to the magnitude of the amplitude of a wave."
    },
    {
     "id": 745759,
     "content_html": "The energy of a wave increases with an increase in the amplitude of the wave."
    },
    {
     "id": 745756,
     "content_html": "The energy of a wave decreases with an increase in the amplitude of a wave."
    }
   ],
