 "questions": [
  {
   "id": 243788,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What similarities exist between the Standard Model and the periodic table of elements?",
   "answers": [
    {
     "id": 764487,
     "content_html": "During their invention, both the Standard Model and the periodic table organized material by mass."
    },
    {
     "id": 764486,
     "content_html": "At the times of their invention, both the Standard Model and the periodic table organized material by charge."
    },
    {
     "id": 764485,
     "content_html": "At the times of their invention, both the Standard Model and the periodic table organized material by interaction with other available particles."
    },
    {
     "id": 764484,
     "content_html": "At the times of their invention, both the Standard Model and the periodic table organized material by size."
    }
   ],
