 "questions": [
  {
   "id": 238923,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Do all waves require a medium to travel? Explain.",
   "answers": [
    {
     "id": 745417,
     "content_html": "No, electromagnetic waves do not require any medium to propagate."
    },
    {
     "id": 745416,
     "content_html": "No, mechanical waves do not require any medium to propagate."
    },
    {
     "id": 745415,
     "content_html": "Yes, both mechanical and electromagnetic waves require a medium to propagate."
    },
    {
     "id": 745414,
     "content_html": "Yes, all transverse waves require a medium to travel."
    }
   ],
