 "questions": [
  {
   "id": 536960,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why the string, pins, and pencil method works for drawing an ellipse.",
   "answers": [
    {
     "id": 1053993,
     "content_html": "The string, pins, and pencil method works because the length of the two sides of the triangle remains constant as you are drawing the ellipse."
    },
    {
     "id": 1053994,
     "content_html": "The string, pins, and pencil method works because the area of the triangle remains constant as you are drawing the ellipse."
    },
    {
     "id": 1053995,
     "content_html": "The string, pins, and pencil method works because the perimeter of the triangle remains constant as you are drawing the ellipse."
    },
    {
     "id": 1053996,
     "content_html": "The string, pins, and pencil method works because the volume of the triangle remains constant as you are drawing the ellipse."
    }
   ],
