 "questions": [
  {
   "id": 239563,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If you drop a copper tube over a bar magnet with its north pole up, is a current induced in the copper tube? If so, in what direction? Consider when the copper tube is approaching the bar magnet.",
   "answers": [
    {
     "id": 747776,
     "content_html": "Yes, the induced current will be produced in the clockwise direction when viewed from above."
    },
    {
     "id": 747775,
     "content_html": "No, the induced current will not be produced."
    }
   ],
