   "id": 501657,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare and contrast a hypothesis and a scientific theory.",
   "answers": [
    {
     "id": 985945,
     "content_html": "A hypothesis is an explanation of the natural world with experimental support, while a scientific theory is an educated guess about a natural phenomenon."
    },
    {
     "id": 985946,
     "content_html": "A hypothesis is an educated guess about natural phenomenon, while a scientific theory is an explanation of natural world with experimental support."
    },
    {
     "id": 985947,
     "content_html": "A hypothesis is experimental evidence of a natural phenomenon, while a scientific theory is an explanation of the natural world with experimental support."
    },
    {
     "id": 985948,
     "content_html": "A hypothesis is an explanation of the natural world with experimental support, while a scientific theory is experimental evidence of a natural phenomenon."
