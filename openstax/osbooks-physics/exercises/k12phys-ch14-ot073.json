 "questions": [
  {
   "id": 243089,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Does the Doppler effect occur when the source and observer are both moving towards each other? If so, how would this affect the perceived frequency?",
   "answers": [
    {
     "id": 761784,
     "content_html": "Yes, the perceived frequency will be even lower in this case than if only one of the two were moving."
    },
    {
     "id": 761783,
     "content_html": "No, the Doppler effect occurs only when an observer is moving towards a source."
    },
    {
     "id": 761782,
     "content_html": "No, the Doppler effect occurs only when a source is moving towards an observer."
    },
    {
     "id": 761785,
     "content_html": "Yes, the perceived frequency will be even higher in this case than if only one of the two were moving."
    }
   ],
