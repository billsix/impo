 "questions": [
  {
   "id": 243422,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe resolution in terms of minima and maxima of diffraction patterns.",
   "answers": [
    {
     "id": 763089,
     "content_html": "The limit for resolution is when the minimum of the pattern for one of the lines is directly over the first minimum of the pattern for the other line."
    },
    {
     "id": 763092,
     "content_html": "The limit for resolution is when the maximum of the pattern for one of the lines is directly over the first minimum of the pattern for the other line."
    },
    {
     "id": 763090,
     "content_html": "The limit for resolution is when the maximum of the pattern for one of the lines is directly over the second minimum of the pattern for the other line."
    },
    {
     "id": 763091,
     "content_html": "The limit for resolution is when the minimum of the pattern for one of the lines is directly over the second maximum of the pattern for the other line."
    }
   ],
