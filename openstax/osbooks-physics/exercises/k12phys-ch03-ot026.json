 "questions": [
  {
   "id": 511177,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which kinematic equation would you use to find the velocity of a skydiver <span data-math=\"2.0\\,\\text{s}\">2.0\\,\\text{s}</span> after she jumps from a plane and before she opens her parachute? Assume the positive direction is downward.",
   "answers": [
    {
     "id": 1000454,
     "content_html": "<span data-math=\"v = v_0 + at\">v = v_0 + at</span>"
    },
    {
     "id": 1000455,
     "content_html": "<span data-math=\"v = v_0 - at\">v = v_0 - at</span>"
    },
    {
     "id": 1000456,
     "content_html": "<span data-math=\"v^2 = {v_0}^2 + at\">v^2 = {v_0}^2 + at</span>"
    },
    {
     "id": 1000457,
     "content_html": "<span data-math=\"v^2 = {v_0}^2 - at\">v^2 = {v_0}^2 - at</span>"
    }
   ],
