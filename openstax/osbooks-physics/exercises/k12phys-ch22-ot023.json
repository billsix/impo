 "questions": [
  {
   "id": 243685,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do X-rays and gamma rays have equivalent RBE values if they provide different amounts of energy to the body?",
   "answers": [
    {
     "id": 764105,
     "content_html": "The penetration distance, which depends on energy, is short for both X-rays and gamma rays."
    },
    {
     "id": 764106,
     "content_html": "The penetration distance, which depends on energy, is long for both X-rays and gamma rays."
    },
    {
     "id": 764104,
     "content_html": "The penetration distance, as determined by their high mass, is different for both X-rays and gamma rays."
    },
    {
     "id": 764103,
     "content_html": "The penetration distance, as determined by their low mass, is the same for both X-rays and gamma rays."
    }
   ],
