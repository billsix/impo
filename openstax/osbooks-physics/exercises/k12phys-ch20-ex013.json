 "questions": [
  {
   "id": 239495,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is a magnetic field?",
   "answers": [
    {
     "id": 747533,
     "content_html": "The directional lines present inside and outside the magnetic material that indicate the magnitude and direction of the magnetic force."
    },
    {
     "id": 747532,
     "content_html": "The directional lines present inside and outside the magnetic material that indicate the magnitude of the magnetic force."
    },
    {
     "id": 747531,
     "content_html": "The directional lines present inside the magnetic material that indicate the magnitude and the direction of the magnetic force."
    },
    {
     "id": 747530,
     "content_html": "The directional lines present outside the magnetic material that indicate the magnitude and the direction of the magnetic force."
    }
