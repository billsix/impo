 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1169086046529\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\"><span class=\"os-title-label\">PhET Explorations</span></h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"11\" class=\"os-subtitle\"><span class=\"os-subtitle-label\">PhET Explorations: Bending Light</span></h4>\n<p id=\"eip-id1530089\" class=\" \">Explore bending of light between two media with different indices of refraction. See how changing from air to water to glass changes the bending angle. Play with prisms of different shapes and make rainbows.</p>\n<div class=\"os-figure\">\n<figure id=\"fs-id1169085955604\"><div data-type=\"media\" id=\"fs-id1167065851428\" data-alt=\"This simulation allows you to explore bending of light between two media with different indices of refraction\">\n<div data-type=\"alternatives\" class=\"os-has-iframe os-has-link\">\n<a class=\"os-is-link\" target=\"_window\" href=\"https://openstax.org/l/28Bendinglight\">Click to view content</a><iframe width=\"660\" height=\"371.4\" src=\"https://openstax.org/l/28Bendinglight\" class=\"os-is-iframe\"><!-- no-selfclose --></iframe>\n</div>\n</div></figure><div class=\"os-caption-container\">\n<span class=\"os-title-label\">Figure </span><span class=\"os-number\">25.19</span><span class=\"os-divider\"> </span>\n</div>\n</div>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 243291,
   "is_answer_order_important": true,
   "stimulus_html": "PhET Explorations: Bending Light.\n\nExplore bending of light between two media with different indices of refraction. See how changing from air to water to glass changes the bending angle. Play with prisms of different shapes and make rainbows.\n<iframe src=\"https://openstax.org/l/28Bendinglight\"></iframe>",
   "stem_html": "A light ray moving upward strikes a horizontal boundary at an acute angle relative to the perpendicular and enters the medium above the boundary. What must be true for the light to bend away from the perpendicular?",
   "answers": [
    {
     "id": 762572,
     "content_html": "The medium below the boundary must have a greater index of refraction than the medium above."
    },
    {
     "id": 762571,
     "content_html": "The medium below the boundary must have a lower index of refraction than the medium above."
    },
    {
     "id": 762570,
     "content_html": "The medium below the boundary must have an index of refraction of zero."
    },
    {
     "id": 762569,
     "content_html": " The medium above the boundary must have an infinite index of refraction."
    }
   ],
