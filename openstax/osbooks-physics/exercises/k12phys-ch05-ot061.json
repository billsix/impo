 "questions": [
  {
   "id": 522328,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Given static and kinetic friction between two surfaces, which has a greater value? Why?",
   "answers": [
    {
     "id": 1022193,
     "content_html": "The kinetic friction has a greater value because the friction between the two surfaces is more when the two surfaces are in relative motion."
    },
    {
     "id": 1022194,
     "content_html": "The static friction has a greater value because the friction between the two surfaces is more when the two surfaces are in relative motion."
    },
    {
     "id": 1022195,
     "content_html": "The kinetic friction has a greater value because the friction between the two surfaces is less when the two surfaces are in relative motion."
    },
    {
     "id": 1022196,
     "content_html": "The static friction has a greater value because the friction between the two surfaces is less when the two surfaces are in relative motion."
    }
   ],
