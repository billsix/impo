  {
   "id": 243808,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does mass-energy conservation relate to the Higgs field?",
   "answers": [
    {
     "id": 764558,
     "content_html": "The increase in a particle’s energy when traveling through the Higgs field is countered by its increase in mass."
    },
    {
     "id": 764561,
     "content_html": "The decrease in a particle’s kinetic energy when traveling through the Higgs field is countered by its increase in mass."
    },
    {
     "id": 764559,
     "content_html": "The decrease in a particle’s energy when traveling through the Higgs field is countered by its decrease in mass."
    },
    {
     "id": 764560,
     "content_html": "The increase in a particle’s energy when traveling through the Higgs field is countered by its decrease in mass."
    }
   ],
