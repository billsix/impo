 "questions": [
  {
   "id": 614253,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens to the masses of a particle and its antiparticle when the two annihilate at low energies?",
   "answers": [
    {
     "id": 1164993,
     "content_html": "The masses of the particle and antiparticle are transformed into energy in the form of photons."
    },
    {
     "id": 1164991,
     "content_html": "The masses of the particle and antiparticle are converted into kinetic energy of the particle and antiparticle respectively."
    },
    {
     "id": 1164990,
     "content_html": "The mass of the antiparticle is converted into kinetic energy of the particle."
    },
    {
     "id": 1164992,
     "content_html": "The mass of the particle is converted into radiation energy of the antiparticle."
    }
   ],
