 "questions": [
  {
   "id": 243410,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Light passing through double slits creates a diffraction pattern. How would the spacing of the bands in the pattern change if the slits were closer together?",
   "answers": [
    {
     "id": 763043,
     "content_html": "The bands would be closer together."
    },
    {
     "id": 763044,
     "content_html": "The bands would spread farther apart."
    },
    {
     "id": 763042,
     "content_html": "The bands would remain stationary."
    },
    {
     "id": 763041,
     "content_html": "The bands would fade and eventually disappear."
    }
   ],
