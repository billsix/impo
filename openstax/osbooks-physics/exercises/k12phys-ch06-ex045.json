 "questions": [
  {
   "id": 613696,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Suppose you have an object tied to a rope and are rotating it over your head in uniform circular motion. If you increase the length of the rope, would you have to apply more or less force to maintain the same speed?",
   "answers": [
    {
     "id": 1162809,
     "content_html": "More force is required, because the force is inversely proportional to the radius of the circular orbit."
    },
    {
     "id": 1162808,
     "content_html": "More force is required because the force is directly proportional to the radius of the circular orbit."
    },
    {
     "id": 1162810,
     "content_html": "Less force is required because the force is inversely proportional to the radius of the circular orbit."
    },
    {
     "id": 1162807,
     "content_html": "Less force is required because the force is directly proportional to the radius of the circular orbit."
    }
   ],
