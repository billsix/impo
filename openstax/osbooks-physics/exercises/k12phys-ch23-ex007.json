 "questions": [
  {
   "id": 243702,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the expanding radius of the cyclotron provide evidence of particle acceleration?",
   "answers": [
    {
     "id": 764171,
     "content_html": "A constant magnetic force is exerted on particles at all radii. As the radius increases, the velocity of the particle must increase to maintain this constant force."
    },
    {
     "id": 764170,
     "content_html": "A constant centripetal force is exerted on particles at all radii. As the radius increases, the velocity of the particle must decrease to maintain this constant force."
    },
    {
     "id": 764169,
     "content_html": "A constant magnetic force is exerted on particles at all radii. As the radius increases, the velocity of the particle must decrease to maintain this constant force."
    },
    {
