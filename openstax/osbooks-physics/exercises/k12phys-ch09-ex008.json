 "questions": [
  {
   "id": 537215,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Is it possible for the sum of kinetic energy and potential energy of an object to change without work having been done on the object? Explain.",
   "answers": [
    {
     "id": 1054997,
     "content_html": "No, because the work-energy theorem states that work done on an object is equal to the change in kinetic energy, and change in KE requires a change in velocity. It is assumed that mass is constant."
    },
    {
     "id": 1054998,
     "content_html": "No, because the work-energy theorem states that work done on an object is equal to the sum of kinetic energy, and the change in KE requires a change in displacement. It is assumed that mass is constant."
    },
    {
     "id": 1054999,
     "content_html": "Yes, because the work-energy theorem states that work done on an object is equal to the change in kinetic energy, and change in KE requires a change in velocity. It is assumed that mass is constant."
    },
