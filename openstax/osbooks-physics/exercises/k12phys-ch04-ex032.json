 "questions": [
  {
   "id": 511961,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two people apply the same force from the same height to throw two identical balls in the air. Will the balls necessarily travel the same distance? Why or why not?",
   "answers": [
    {
     "id": 1001466,
     "content_html": "No, the balls will not necessarily travel the same distance because the gravitational force acting on them is different."
    },
    {
     "id": 1001467,
     "content_html": "No, the balls will not necessarily travel the same distance because the angle at which they are thrown may differ."
    },
    {
     "id": 1001468,
     "content_html": "Yes, the balls will travel the same distance because the gravitational force acting on them is the same."
    },
    {
     "id": 1001469,
     "content_html": "Yes, the balls will travel the same distance because the angle at which they are thrown may differ."
    }
