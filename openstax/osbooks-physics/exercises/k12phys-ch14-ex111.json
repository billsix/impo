 "questions": [
  {
   "id": 243150,
   "is_answer_order_important": true,
   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/d728dcdb704c46b2.jpg\" alt=\"\">\n</figure>",
   "stem_html": "<p>Brass instruments like the horn have rotary valves. See the first image to see where these valves are on a horn and the second image to see how they function when pressed.</p>\n<p>Make a claim about the effect of these valves.</p>",
   "answers": [
    {
     "id": 762015,
     "content_html": "They increase the frequency of the sound by making the tube longer."
    },
    {
     "id": 762014,
     "content_html": "They increase the frequency of the sound by making the tube shorter."
    },
    {
     "id": 762013,
     "content_html": "They increase the amplitude of the sound by causing it to remain in the tube for a longer period of time."
    },
    {
     "id": 762012,
     "content_html": "They decrease the amplitude of the sound by causing it to remain in the tube for a longer period of time."
    }
   ],
