   "stimulus_html": "",
   "stem_html": "What is a pulse wave?",
   "answers": [
    {
     "id": 745420,
     "content_html": "A pulse wave is a sudden disturbance with only one wave generated."
    },
    {
     "id": 745421,
     "content_html": "A pulse wave is a sudden disturbance with only one or a few waves generated."
    },
    {
     "id": 745419,
     "content_html": "A pulse wave is a gradual disturbance with only one or a few waves generated."
    },
    {
     "id": 745418,
     "content_html": "A pulse wave is a gradual disturbance with only one wave generated."
    }
