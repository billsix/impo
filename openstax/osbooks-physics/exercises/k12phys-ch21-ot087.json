 "questions": [
  {
   "id": 243623,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How would observations of Compton scattering change if ultraviolet light were used in place of X-rays?",
   "answers": [
    {
     "id": 763862,
     "content_html": "Ultraviolet light carries less energy than X-rays. As a result, Compton scattering would be easier to detect."
    },
    {
     "id": 763863,
     "content_html": "Ultraviolet light carries less energy than X-rays. As a result, Compton scattering would be more difficult to detect."
    },
    {
     "id": 763861,
     "content_html": "Ultraviolet light carries more energy than X-rays. As a result, Compton scattering would be easier to detect."
    },
    {
     "id": 763860,
     "content_html": "Ultraviolet light has higher energy than X-rays. As a result, Compton scattering would be more difficult to detect."
    }
   ],
