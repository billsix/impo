  {
   "id": 613564,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A car is moving on a straight road at a constant speed in a single direction. Which of the following statements is true?",
   "answers": [
    {
     "id": 1162292,
     "content_html": "Average velocity is zero."
    },
    {
     "id": 1162293,
     "content_html": "The magnitude of average velocity is equal to the average speed."
    },
    {
     "id": 1162291,
     "content_html": "The magnitude of average velocity is greater than the average speed."
    },
    {
     "id": 1162290,
     "content_html": "The magnitude of average velocity is less than the average speed."
    }
   ],
