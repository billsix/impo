 "questions": [
  {
   "id": 243420,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are diffraction gratings used in spectroscopes rather than just two slits?",
   "answers": [
    {
     "id": 763081,
     "content_html": "The bands produced by diffraction gratings are dimmer but sharper than the bands produced by two slits."
    },
    {
     "id": 763082,
     "content_html": "The bands produced by diffraction gratings are brighter, though less sharp, than the bands produced by two slits."
    },
    {
     "id": 763084,
     "content_html": "The bands produced by diffraction gratings are brighter and sharper than the bands produced by two slits."
    },
    {
     "id": 763083,
     "content_html": "The bands produced by diffraction gratings are dimmer and less sharp, but more widely dispersed, than the bands produced by two slits."
    }
   ],
