 "questions": [
  {
   "id": 243719,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is a stationary target considered inefficient in a particle accelerator?",
   "answers": [
    {
     "id": 764229,
     "content_html": "The stationary target recoils upon particle strike, thereby transferring much of the particle’s energy into its motion. As a result, a greater amount of energy goes into breaking the particle into its constituent components."
    },
    {
     "id": 764228,
     "content_html": "The stationary target contains zero kinetic energy, so it requires more energy to break the particle into its constituent components."
    },
    {
     "id": 764227,
     "content_html": "The stationary target contains zero potential energy, so it requires more energy to break the particle into its constituent components."
    },
    {
     "id": 764230,
     "content_html": "The stationary target recoils upon particle strike, transferring much of the particle’s energy into its motion. As a result, a lesser amount of energy goes into breaking the particle into its constituent components."
    }
   ],
