   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following most closely models how sound is produced by the vocal cords?",
   "answers": [
    {
     "id": 1164528,
     "content_html": "A person plucks a string."
    },
    {
     "id": 1164527,
     "content_html": "A person blows over the mouth of a half-filled glass bottle."
    },
    {
     "id": 1164526,
     "content_html": "A person strikes a hammer against a hard surface."
    },
    {
     "id": 1164529,
     "content_html": "A person blows through a small slit in a wide, stretched rubber band."
    }
