   "id": 613944,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is net transfer of energy by heat?",
   "answers": [
    {
     "id": 1163788,
     "content_html": "It is the sum of all energy transfers by heat into the system."
    },
    {
     "id": 1163787,
     "content_html": "It is the product of all energy transfers by heat into the system."
    },
    {
     "id": 1163789,
     "content_html": "It is the sum of all energy transfers by heat into and out of the system."
    },
    {
     "id": 1163786,
     "content_html": "It is the product of all energy transfers by heat into and out of the system."
    }
