   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can you calculate percentage efficiency?",
   "answers": [
    {
     "id": 1163891,
     "content_html": "percentage efficiency <span data-math=\"= \\left(Eff + 100\\right)\\,\\%\">= \\left(Eff + 100\\right)\\%</span>"
    },
    {
     "id": 1163890,
     "content_html": "percentage efficiency <span data-math=\"= \\frac{Eff}{100}\\%\">= \\frac{Eff}{100}\\%</span>"
    },
    {
     "id": 1163892,
     "content_html": "percentage efficiency  <span data-math=\"= \\left(Eff - 100\\right)\\%\">= \\left(Eff - 100\\right)\\%</span>"
    },
    {
     "id": 1163893,
     "content_html": "percentage efficiency <span data-math=\"= Eff \\times 100\\%\">= Eff \\times 100\\,\\%</span>"
    }
