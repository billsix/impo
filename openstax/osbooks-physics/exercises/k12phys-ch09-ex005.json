 "questions": [
  {
   "id": 537211,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>Identify which of the following actions generates more power. Show your work.</p>\n\n<ul>\n  <li>carrying a <span data-math=\"100\\,\\text{N}\">100\\,\\text{N}</span> TV to the second floor in <span data-math=\"50\\,\\text{s}\">50\\,\\text{s}</span> or</li>\n  <li>carrying a <span data-math=\"24\\,\\text{N}\">24\\,\\text{N}</span> watermelon to the second floor in <span data-math=\"10\\,\\text{s}\">10\\,\\text{s}</span>?</li>\n</ul>\n",
   "answers": [
    {
     "id": 1054981,
     "content_html": "Carrying a <span data-math=\"100\\,\\text{N}\">100\\,\\text{N}</span> TV generates more power than carrying a <span data-math=\"24\\,\\text{N}\">24\\,\\text{N}</span> watermelon to the same height because power is defined as work done times the time interval."
    },
    {
     "id": 1054982,
     "content_html": "Carrying a <span data-math=\"100\\,\\text{N}\">100\\,\\text{N}</span> TV generates more power than carrying a <span data-math=\"24\\,\\text{N}\">24\\,\\text{N}</span> watermelon to the same height because power is defined as the ratio of work done to the time interval."
    },
    {
     "id": 1054983,
     "content_html": "Carrying a <span data-math=\"24\\,\\text{N}\">24\\,\\text{N}</span> watermelon generates more power than carrying a <span data-math=\"100\\,\\text{N}\">100\\,\\text{N}</span> TV to the same height because power is defined as work done times the time interval."
    },
    {
     "id": 1054984,
     "content_html": "Carrying a <span data-math=\"24\\,\\text{N}\">24\\,\\text{N}</span> watermelon generates more power than carrying a <span data-math=\"100\\,\\text{N}\">100\\,\\text{N}</span> TV to the same height because power is defined as the ratio of work done and the time interval."
    }
   ],
