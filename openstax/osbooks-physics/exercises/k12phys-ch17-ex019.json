 "questions": [
  {
   "id": 614206,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Suppose you use a double slit to perform Young’s double-slit experiment in air, and then repeat the experiment with the same double slit in water. Does the color of the light change? Do the angles to the same parts of the interference pattern get larger or smaller? Explain.",
   "answers": [
    {
     "id": 1164809,
     "content_html": "No, the color is determined by frequency. The magnitude of the angle decreases."
    },
    {
     "id": 1164808,
     "content_html": "No, the color is determined by wavelength. The magnitude of the angle decreases."
    },
    {
     "id": 1164807,
     "content_html": "Yes, the color is determined by frequency. The magnitude of the angle increases."
    },
    {
     "id": 1164806,
     "content_html": "Yes, the color is determined by wavelength. The magnitude of the angle increases."
    }
   ],
