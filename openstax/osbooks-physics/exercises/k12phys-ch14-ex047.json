 "questions": [
  {
   "id": 243031,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can humming while shooting a gun reduce ear damage?",
   "answers": [
    {
     "id": 761563,
     "content_html": "Humming can trigger those two muscles in the outer ear that react to intense sound produced while shooting and reduce the force transmitted to the cochlea."
    },
    {
     "id": 761562,
     "content_html": "Humming can trigger those three muscles in the outer ear that react to intense sound produced while shooting and reduce the force transmitted to the cochlea."
    },
    {
     "id": 761564,
     "content_html": "Humming can trigger those two muscles in the middle ear that react to intense sound produced while shooting and reduce the force transmitted to the cochlea."
    },
    {
     "id": 761561,
     "content_html": "Humming can trigger those three muscles in the middle ear that react to intense sound produced while shooting and reduce the force transmitted to the cochlea."
    }
