 "questions": [
  {
   "id": 243072,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the relation between speed of source and value of observed frequency when the source is moving towards the observer?",
   "answers": [
    {
     "id": 761724,
     "content_html": "They are independent of each other."
    },
    {
     "id": 761725,
     "content_html": "The greater the speed, the greater the value of observed frequency."
    },
    {
     "id": 761723,
     "content_html": "The greater the speed, the smaller the value of observed frequency."
    },
    {
     "id": 761722,
     "content_html": "The speed of the sound is directly proportional to the square of the frequency observed."
    }
   ],
