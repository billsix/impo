   "stem_html": "Which of the following best describes torque?",
   "answers": [
    {
     "id": 1038514,
     "content_html": "It is the rotational equivalent of a force."
    },
    {
     "id": 1038515,
     "content_html": "It is the force that affects linear motion."
    },
    {
     "id": 1038516,
     "content_html": "It is the rotational equivalent of acceleration."
    },
    {
     "id": 1038517,
     "content_html": "It is the acceleration that affects linear motion."
