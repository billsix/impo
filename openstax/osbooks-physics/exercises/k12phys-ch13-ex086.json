  {
   "id": 239085,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do water waves sometimes appear like a complex criss-cross pattern?",
   "answers": [
    {
     "id": 745986,
     "content_html": "The crests and the troughs of waves traveling in the same direction combine to form a criss-cross pattern."
    },
    {
     "id": 745987,
     "content_html": "The crests and the troughs of waves traveling in different directions combine to form a criss-cross pattern."
    }
   ],
