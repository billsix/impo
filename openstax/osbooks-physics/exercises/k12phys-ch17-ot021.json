   "id": 323404,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare interference patterns formed by a double slit and by a diffraction grating in terms of brightness and narrowness of bands.",
   "answers": [
    {
     "id": 834837,
     "content_html": "The pattern formed by a diffraction grating has broader and brighter bands."
    },
    {
     "id": 834838,
     "content_html": "The pattern formed by a diffraction grating has broader and duller bands."
    },
    {
     "id": 834839,
     "content_html": "The pattern formed by a diffraction grating has narrower and duller bands."
    },
    {
     "id": 834840,
     "content_html": "The pattern formed by a diffraction grating has narrower and brighter bands."
    }
