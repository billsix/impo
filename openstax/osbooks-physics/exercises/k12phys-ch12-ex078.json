   "stem_html": "What is thermal efficiency?",
   "answers": [
    {
     "id": 745247,
     "content_html": "Thermal efficiency is the ratio of work input to the energy input."
    },
    {
     "id": 745248,
     "content_html": "Thermal efficiency is the ratio of work output to the energy input."
    },
    {
     "id": 745246,
     "content_html": "Thermal efficiency is the ratio of work input to the energy output."
    },
    {
     "id": 745245,
     "content_html": "Thermal efficiency is the ratio of work output to the energy output."
    }
