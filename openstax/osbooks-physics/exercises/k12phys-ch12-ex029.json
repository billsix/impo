 "questions": [
  {
   "id": 238793,
   "is_answer_order_important": true,
   "stimulus_html": "<figure>\n<img src=\"exercises/media/f6ed35e83687b002.jpg\" alt=\"\">\n(credit: modification of work by Environment Canada)\n</figure>",
   "stem_html": "A hydroelectric dam produces electricity by moving water from a reservoir fed by a river above through a turbine below. Consider the system to include the dam and the reservoir. If the turbine jams and stops producing electricity, what effect will this have on the internal energy of the system?",
   "answers": [
    {
     "id": 744899,
     "content_html": "The internal energy would be converted to work."
    },
    {
     "id": 744898,
     "content_html": "The internal energy would remain constant because work is no longer being done."
    },
    {
     "id": 744897,
     "content_html": "The excess internal energy would radiate as heat."
    },
    {
     "id": 744900,
     "content_html": "The internal energy will increase as the reservoir fills up."
    }
   ],
