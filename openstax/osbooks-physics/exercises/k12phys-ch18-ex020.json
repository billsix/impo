   "id": 239132,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Most objects contain incredibly large numbers of charged particles. Why do most objects not exhibit static electric effects?",
   "answers": [
    {
     "id": 746166,
     "content_html": "Most objects are neutral."
    },
    {
     "id": 746165,
     "content_html": "Most objects have positive charge only."
    },
    {
     "id": 746164,
     "content_html": "Most objects have negative charge only."
    },
    {
     "id": 746163,
     "content_html": "Most objects have excess protons."
    }
