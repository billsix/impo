   "id": 243435,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A beam of light always spreads out. Why can a beam not be produced with parallel rays to prevent spreading?",
   "answers": [
    {
     "id": 763143,
     "content_html": "Light is always polarized."
    },
    {
     "id": 763142,
     "content_html": "Light is always reflected."
    },
    {
     "id": 763141,
     "content_html": "Light is always refracted."
    },
    {
     "id": 763144,
     "content_html": "Light is always diffracted."
    }
