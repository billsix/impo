 "questions": [
  {
   "id": 550195,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two children of different weights are riding a seesaw. How do they position themselves with respect to the pivot point (the fulcrum) so that they are balanced?",
   "answers": [
    {
     "id": 1080894,
     "content_html": "The heavier child sits closer to the fulcrum."
    },
    {
     "id": 1080895,
     "content_html": "The heavier child sits farther from the fulcrum."
    },
    {
     "id": 1080896,
     "content_html": "Both children sit at equal distance from the fulcrum."
    },
    {
     "id": 1080897,
     "content_html": "Since both have different weights, they will never be in balance."
    }
   ],
