   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is the output emf of a generator affected if you double the frequency of rotation of its coil?",
   "answers": [
    {
     "id": 747909,
     "content_html": "The output emf will be doubled."
    },
    {
     "id": 747906,
     "content_html": "The output emf will be halved."
    },
    {
     "id": 747907,
     "content_html": "The output emf will be quadrupled."
    },
    {
     "id": 747908,
