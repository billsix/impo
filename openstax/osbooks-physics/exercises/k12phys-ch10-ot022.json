 "questions": [
  {
   "id": 550437,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An astronaut goes on a long space voyage at near the speed of light. When she returns home, how will her age compare to the age of her twin who stayed on Earth?",
   "answers": [
    {
     "id": 1081776,
     "content_html": "Both of them will be the same age."
    },
    {
     "id": 1081777,
     "content_html": "This is a paradox and hence the ages cannot be compared."
    },
    {
     "id": 1081778,
     "content_html": "The age of the twin who traveled will be less than the age of her twin who remained behind."
    },
    {
     "id": 1081779,
     "content_html": "The age of the twin who traveled will be greater than the age of her twin who remained behind."
    }
   ],
