   "stem_html": "What is sound intensity?",
   "answers": [
    {
     "id": 761450,
     "content_html": "Intensity is the energy per unit area carried by a wave."
    },
    {
     "id": 761449,
     "content_html": "Intensity is the energy per unit volume carried by a wave."
    },
    {
     "id": 761451,
     "content_html": "Intensity is the power per unit area carried by a wave."
    },
    {
     "id": 761448,
     "content_html": "Intensity is the power per unit volume carried by a wave."
    }
