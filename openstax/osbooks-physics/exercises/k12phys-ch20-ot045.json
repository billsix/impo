   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are the coils of a transformer wrapped around a loop of ferrous material?",
   "answers": [
    {
     "id": 747847,
     "content_html": "The magnetic field from the source coil is trapped and also increased in strength."
    },
    {
     "id": 747846,
     "content_html": "The magnetic field from the source coil is dispersed and also increased in strength."
    },
    {
     "id": 747845,
     "content_html": "The magnetic field from the source coil is trapped and also decreased in strength."
    },
    {
