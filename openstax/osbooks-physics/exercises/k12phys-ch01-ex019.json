 "questions": [
  {
   "id": 501525,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe what two topics physicists are trying to unify with relativistic quantum mechanics. How will this unification create a greater understanding of our universe?",
   "answers": [
    {
     "id": 985451,
     "content_html": "Relativistic quantum mechanics unifies quantum mechanics with Einstein’s theory of relativity. The unified theory creates a greater understanding of our universe because it can explain objects of all sizes and masses."
    },
    {
     "id": 985452,
     "content_html": "Relativistic quantum mechanics unifies classical mechanics with Einstein’s theory of relativity. The unified theory creates a greater understanding of our universe because it can explain objects of all sizes and masses."
    },
    {
     "id": 985453,
     "content_html": "Relativistic quantum mechanics unifies quantum mechanics with Einstein’s theory of relativity. The unified theory creates a greater understanding of our universe because it is unable to explain objects of all sizes and masses."
    },
    {
     "id": 985454,
     "content_html": "Relativistic quantum mechanics unifies classical mechanics with the Einstein’s theory of relativity. The unified theory creates a greater understanding of our universe because it is unable to explain objects of all sizes and masses."
    }
   ],
