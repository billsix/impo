  {
   "id": 243294,
   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: Snell's Law Example 1.\n\nThis video is a worked example of Snell’s law.\n\n<iframe src=\"https://www.openstaxcollege.org/l/02snellexample\"></iframe>",
   "stem_html": "Which two types of variables are included in Snell’s law?",
   "answers": [
    {
     "id": 762583,
     "content_html": "The two types of variables are density of a material and the angle made by the light ray with the normal."
    },
    {
     "id": 762582,
     "content_html": "The two types of variables are density of a material and the thickness of a material."
    },
    {
     "id": 762581,
     "content_html": "The two types of variables are refractive index and thickness of each material."
    },
    {
     "id": 762584,
     "content_html": "The two types of variables are refractive index of a material and the angle made by a light ray with the normal."
    }
