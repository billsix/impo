 "questions": [
  {
   "id": 614064,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>Through which branch in the circuit below does the most current flow?</p>\n<p><img src=\"exercises/media/769f4b7e2b8590ae.png\" alt=\"Circuit diagram with a $9\\text{-V}$ battery, two resistors $\\left(50\\,\\text{and}\\,50 \\times 10^{50}\\,\\Omega \\right)$, and a switch.\"></p>",
   "answers": [
    {
     "id": 1164253,
     "content_html": "All of the current flows through the left branch due to the open switch."
    },
    {
     "id": 1164254,
     "content_html": "All of the current flows through the right branch due to the open switch in the left branch."
    },
    {
     "id": 1164252,
     "content_html": "All of the current flows through the middle branch due to the open switch in the left branch"
    },
    {
     "id": 1164251,
     "content_html": "There will be no current in any branch of the circuit due to the open switch."
    }
   ],
