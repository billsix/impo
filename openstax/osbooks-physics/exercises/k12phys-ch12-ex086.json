   "id": 613966,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which equation represents the net work done by a system in a cyclic process?",
   "answers": [
    {
     "id": 1163874,
     "content_html": "<span data-math=\"W = \\frac{Q_{\\text{c}}}{Q_{\\text{h}}}\">W = \\frac{Q_{\\text{c}}}{Q_{\\text{h}}}\n</span>"
    },
    {
     "id": 1163875,
     "content_html": "<span data-math=\"W = Q_{\\text{h}} + Q_{\\text{c}}\">W = Q_{\\text{h}} + Q_{\\text{c}}</span>\n"
    },
    {
     "id": 1163876,
     "content_html": "<span data-math=\"W = Eff\\left(Q_{\\text{c}} - Q_{\\text{h}} \\right)\">W = Eff\\left(Q_{\\text{c}} - Q_{\\text{h}} \\right)</span>\n"
    },
    {
     "id": 1163877,
     "content_html": "<span data-math=\"W = Q_{\\text{h}} - Q_{\\text{c}}\">W = Q_{\\text{h}} - Q_{\\text{c}}</span>\n"
    }
