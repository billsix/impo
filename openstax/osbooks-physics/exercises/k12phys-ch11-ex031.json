   "stimulus_html": "",
   "stem_html": "What is radiation?",
   "answers": [
    {
     "id": 1163625,
     "content_html": "The transfer of energy through emission and absorption of the electromagnetic waves is known as radiation."
    },
    {
     "id": 1163624,
     "content_html": "The transfer of energy without any direct physical contact between any two substances."
    },
    {
     "id": 1163623,
     "content_html": "The transfer of energy through direct physical contact between any two substances."
    },
    {
     "id": 1163622,
     "content_html": "The transfer of energy by means of the motion of fluids at different temperatures and with different densities."
    }
