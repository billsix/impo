   "id": 239260,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An electron moves in an electric field. Does it move toward regions of higher potential or lower potential? Explain.",
   "answers": [
    {
     "id": 746634,
     "content_html": "It moves toward regions of higher potential because its charge is negative."
    },
    {
     "id": 746633,
     "content_html": "It moves toward regions of lower potential because its charge is negative."
    },
    {
     "id": 746632,
     "content_html": "It moves toward regions of higher potential because its charge is positive."
    },
    {
     "id": 746631,
     "content_html": "It moves toward regions of lower potential because its charge is positive."
    }
