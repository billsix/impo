 "questions": [
  {
   "id": 537808,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Consider two objects of the same mass. If a force of <span data-math=\"100\\,\\text{N}\">100\\,\\text{N}</span> acts on the first for a duration of <span data-math=\"1\\,\\text{s}\">1\\,\\text{s}</span> and on the other for a duration of <span data-math=\"2\\,\\text{s}\">2\\,\\text{s}</span>, which of the following statements is true?",
   "answers": [
    {
     "id": 1057127,
     "content_html": "The first object will acquire more momentum."
    },
    {
     "id": 1057128,
     "content_html": "The second object will acquire more momentum."
    },
    {
     "id": 1057129,
     "content_html": "Both objects will acquire the same momentum."
    },
    {
     "id": 1057130,
     "content_html": "Neither object will experience a change in momentum."
    }
   ],
