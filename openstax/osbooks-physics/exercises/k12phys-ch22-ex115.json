   "id": 243677,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are large electromagnets necessary in nuclear fusion reactors?",
   "answers": [
    {
     "id": 764071,
     "content_html": "Electromagnets are used to slow down the movement of charge hydrogen plasma."
    },
    {
     "id": 764072,
     "content_html": "Electromagnets are used to decrease the temperature of hydrogen plasma."
    },
    {
     "id": 764074,
     "content_html": "Electromagnets are used to confine the hydrogen plasma."
    },
    {
     "id": 764073,
     "content_html": "Electromagnets are used to stabilize the temperature of the hydrogen plasma."
    }
   ],
