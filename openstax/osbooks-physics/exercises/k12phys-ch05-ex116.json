  {
   "id": 521902,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If a pendulum from earth is taken to the moon, will its frequency increase or decrease? Why?",
   "answers": [
    {
     "id": 1021294,
     "content_html": "It will increase because <span data-math=\"g\">g</span> on the Moon is less than <span data-math=\"g\">g</span> on Earth."
    },
    {
     "id": 1021295,
     "content_html": "It will decrease because <span data-math=\"g\">g</span> on the Moon is less than <span data-math=\"g\">g</span> on Earth."
    },
    {
     "id": 1021296,
     "content_html": "It will increase because <span data-math=\"g\">g</span> on the Moon is greater than <span data-math=\"g\">g</span> on Earth."
    },
    {
     "id": 1021297,
     "content_html": "It will decrease because <span data-math=\"g\">g</span> on the Moon is greater than <span data-math=\"g\">g</span> on Earth."
    }
   ],
