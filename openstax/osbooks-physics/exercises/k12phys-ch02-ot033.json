  {
   "id": 510889,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Is it possible for average velocity to be negative?",
   "answers": [
    {
     "id": 999580,
     "content_html": "Yes, if net displacement is negative."
    },
    {
     "id": 999581,
     "content_html": "Yes, if the object’s direction changes during motion."
    },
    {
     "id": 999582,
     "content_html": "No, because average velocity describes only the magnitude and not the direction of motion."
    },
    {
     "id": 999583,
     "content_html": "No, because average velocity only describes the magnitude in the positive direction of motion."
    }
   ],
