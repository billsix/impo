  {
   "id": 530969,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens to arc length as rotation angle increases?",
   "answers": [
    {
     "id": 1039192,
     "content_html": "Arc length increases linearly with rotation angle."
    },
    {
     "id": 1039193,
     "content_html": "Arc length increases inversely with rotation angle."
    },
    {
     "id": 1039194,
     "content_html": "Arc length increases inversely with rotation angle angle a revolution is completed, then restarts at zero."
    },
    {
     "id": 1039195,
     "content_html": "Arc length increases linearly with rotation angle until a revolution is completed, then restarts at zero."
    }
   ],
