   "id": 243274,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are diverging mirrors often used for rear-view mirrors in vehicles? What is the main disadvantage of using such a mirror compared with a flat one?",
   "answers": [
    {
     "id": 762503,
     "content_html": "It gives a wide range of view. The image appears to be closer than the actual object."
    },
    {
     "id": 762502,
     "content_html": "It gives a narrow range of view. The image appears to be farther than the actual object."
    },
    {
     "id": 762501,
     "content_html": "It gives a narrow range of view. The image appears to be closer than the actual object."
    },
    {
