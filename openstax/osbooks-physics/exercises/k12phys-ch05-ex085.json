 "questions": [
  {
   "id": 521804,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When will an object slide down an inclined plane at constant velocity?",
   "answers": [
    {
     "id": 1020922,
     "content_html": "When the magnitude of the component of the weight along the slope is equal to the magnitude of the frictional force."
    },
    {
     "id": 1020923,
     "content_html": "When the magnitude of the component of the weight along the slope is greater than the magnitude of the frictional force."
    },
    {
     "id": 1020924,
     "content_html": "When the magnitude of the component of the weight perpendicular to the slope is less than the magnitude of the frictional force."
    },
    {
     "id": 1020925,
     "content_html": "When the magnitude of the component of the weight perpendicular to the slope is equal to the magnitude of the frictional force."
    }
   ],
