 "questions": [
  {
   "id": 234985,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why the special theory of relativity caused the law of conservation of energy to be modified.",
   "answers": [
    {
     "id": 729903,
     "content_html": "The law of conservation of energy is not valid in relativistic mechanics."
    },
    {
     "id": 729902,
     "content_html": "The law of conservation of energy has to be modified because of time dilation."
    },
    {
     "id": 729901,
     "content_html": "The law of conservation of energy has to be modified because of length contraction."
    },
    {
     "id": 729904,
     "content_html": "The law of conservation of energy has to be modified because of mass-energy equivalence."
    }
   ],
