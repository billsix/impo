 "questions": [
  {
   "id": 239493,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If two magnets repel each other, what can you conclude about their relative orientation?",
   "answers": [
    {
     "id": 747524,
     "content_html": "Either the south pole of magnet 1 is closer to the north pole of magnet 2 or the north pole of magnet 1 is closer to the south pole of magnet 2."
    },
    {
     "id": 747525,
     "content_html": "Either the south poles of both the magnet 1 and magnet 2 are closer to each other or the north poles of both the magnet 1 and magnet 2 are closer to each other."
    },
    {
     "id": 747523,
     "content_html": "Not enough information is given to draw any conclusion about the orientation of the magnets."
    }
   ],
