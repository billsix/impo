   "stimulus_html": "",
   "stem_html": "You connect a resistor across a battery. In which direction do the electrons flow?",
   "answers": [
    {
     "id": 746986,
     "content_html": "The electrons flow from the negative terminal of the battery to the positive terminal of the battery."
    },
    {
     "id": 746985,
     "content_html": "The electrons flow from the positive terminal of the battery to the negative terminal of the battery."
    }
