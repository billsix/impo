 "questions": [
  {
   "id": 239484,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Imagine a boat that is powered by the force of charged particles moving in a magnetic field. If the magnetic field is downward, in what direction must the current of charged particles flow to obtain a rearward-pointing force?",
   "answers": [
    {
     "id": 747489,
     "content_html": "The current must flow vertically from up to down when viewed from the rear of the boat."
    },
    {
     "id": 747488,
     "content_html": "The current must flow vertically from down to up when viewed from the rear of the boat."
    },
    {
     "id": 747487,
     "content_html": "The current must flow horizontally from left to right when viewed from the rear of the boat."
    },
    {
     "id": 747490,
     "content_html": "The current must flow horizontally from right to left when viewed from the rear of the boat."
    }
   ],
