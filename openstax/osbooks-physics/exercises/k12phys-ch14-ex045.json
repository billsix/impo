 "questions": [
  {
   "id": 243029,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which property of the wave is related to its intensity? How?",
   "answers": [
    {
     "id": 761555,
     "content_html": "The frequency of the wave is related to the intensity of the sound. The larger-frequency oscillations indicate greater pressure maxima and minima, and the pressure is higher in greater-intensity sound."
    },
    {
     "id": 761554,
     "content_html": "The wavelength of the wave is related to the intensity of the sound. The longer-wavelength oscillations indicate greater pressure maxima and minima, and the pressure is higher in greater-intensity sound."
    },
    {
     "id": 761556,
     "content_html": "The amplitude of the wave is related to the intensity of the sound. The larger-amplitude oscillations indicate greater pressure maxima and minima, and the pressure is higher in greater-intensity sound."
    },
    {
     "id": 761553,
     "content_html": "The speed of the wave is related to the intensity of the sound. The higher-speed oscillations indicate greater pressure maxima and minima, and the pressure is higher in greater-intensity sound."
    }
   ],
