   "id": 243652,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What will happen to the interference pattern created by electrons when their velocities are increased?",
   "answers": [
    {
     "id": 763977,
     "content_html": "There will be more zones of constructive interference and fewer zones of destructive interference."
    },
    {
     "id": 763976,
     "content_html": "There will be more zones of destructive interference and fewer zones of constructive interference."
    },
    {
     "id": 763978,
     "content_html": "There will be more zones of constructive and destructive interference."
    },
    {
     "id": 763975,
     "content_html": "There will be fewer zones of constructive and destructive interference."
    }
