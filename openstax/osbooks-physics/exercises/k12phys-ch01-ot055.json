 "questions": [
  {
   "id": 504044,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the definition of uncertainty?",
   "answers": [
    {
     "id": 990833,
     "content_html": "Uncertainty is the number of assumptions made prior to the measurement of a physical quantity."
    },
    {
     "id": 990834,
     "content_html": "Uncertainty is a measure of error in a measurement due to the use of a non-calibrated instrument."
    },
    {
     "id": 990835,
     "content_html": "Uncertainty is a measure of deviation of the measured value from the standard value."
    },
    {
     "id": 990836,
     "content_html": "Uncertainty is a measure of error in measurement due to external factors like air friction and temperature."
    }
   ],
