   "id": 243182,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe electromagnetic force as explained by Maxwell’s equations.",
   "answers": [
    {
     "id": 762133,
     "content_html": "According to Maxwell’s equations, electromagnetic force gives rise to electric force and magnetic force."
    },
    {
     "id": 762136,
     "content_html": "According to Maxwell’s equations, electric force and magnetic force are different manifestations of electromagnetic force."
    },
    {
     "id": 762134,
     "content_html": "According to Maxwell’s equations, electric force is the cause of electromagnetic force."
    },
    {
     "id": 762135,
     "content_html": "According to Maxwell’s equations, magnetic force is the cause of electromagnetic force."
    }
