 "questions": [
  {
   "id": 613917,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "On a summer night, why does a black object seem colder than a white one?",
   "answers": [
    {
     "id": 1163684,
     "content_html": "The black object radiates energy faster than the white one, and hence reaches a lower temperature in less time."
    },
    {
     "id": 1163683,
     "content_html": "The black object radiates energy slower than the white one, and hence reaches a lower temperature in less time."
    },
    {
     "id": 1163682,
     "content_html": "The black object absorbs energy faster than the white one, and hence reaches a lower temperature in less time."
    },
    {
     "id": 1163681,
     "content_html": "The black object absorbs energy slower than the white one, and hence reaches a lower temperature in less time."
    }
   ],
