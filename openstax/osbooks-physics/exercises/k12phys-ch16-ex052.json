 "questions": [
  {
   "id": 243332,
   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: Thin Lens Equation and Problem Solving\n\nThis video gives examples using the thin lens equation.\n\n<iframe src=\"https://www.openstaxcollege.org/l/02thinlens\"></iframe>",
   "stem_html": "If a lens has a magnification of <span data-math=\"–\\frac{1}{2}\">–\\frac{1}{2}</span>, how does the image compare with the object in height and orientation?",
   "answers": [
    {
     "id": 762731,
     "content_html": "The image is erect and is half as tall as the object."
    },
    {
     "id": 762730,
     "content_html": "The image is erect and twice as tall as the object."
    },
    {
     "id": 762732,
     "content_html": "The image is inverted and is half as tall as the object."
    },
    {
     "id": 762729,
     "content_html": "The image is inverted and is twice as tall as the object."
    }
   ],
