  {
   "id": 516082,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Consider <span data-math=\"\\overrightarrow{\\text{A}} - \\overrightarrow{\\text{B}} = \\overrightarrow{\\text{R}}\">\\overrightarrow{\\text{A}} - \\overrightarrow{\\text{B}} = \\overrightarrow{\\text{R}}</span>. What is <span data-math=\"R_x\">R_x</span> in terms of <span data-math=\"A_x\">A_x</span> and <span data-math=\"B_x\">B_x</span>?",
   "answers": [
    {
     "id": 1010836,
     "content_html": "<span data-math=\"R_x = \\frac{A_x}{B_x}\">R_x = \\frac{A_x}{B_x}</span>"
    },
    {
     "id": 1010837,
     "content_html": "<span data-math=\"R_x = \\frac{B_x}{A_x}\">R_x = \\frac{B_x}{A_x}</span>"
    },
    {
     "id": 1010838,
     "content_html": "<span data-math=\"R_x = A_x + B_x\">R_x = A_x + B_x</span>"
    },
    {
     "id": 1010839,
     "content_html": "<span data-math=\"R_x = A_x - B_x\">R_x = A_x - B_x</span>"
    }
   ],
