   "id": 238769,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is internal energy?",
   "answers": [
    {
     "id": 744803,
     "content_html": "It is the sum of the kinetic energies of a system’s atoms and molecules."
    },
    {
     "id": 744802,
     "content_html": "It is the sum of the potential energies of a system’s atoms and molecules."
    },
    {
     "id": 744804,
     "content_html": "It is the sum of the kinetic and potential energies of a system’s atoms and molecules."
    },
    {
     "id": 744801,
     "content_html": "It is the difference between the magnitudes of the kinetic and potential energies of a system’s atoms and molecules."
    }
   ],
