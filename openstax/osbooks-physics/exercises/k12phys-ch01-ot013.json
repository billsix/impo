  {
   "id": 613520,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What does radiation therapy, used to treat cancer patients, have to do with physics?",
   "answers": [
    {
     "id": 1162122,
     "content_html": "Understanding how cells reproduce is mainly about physics."
    },
    {
     "id": 1162121,
     "content_html": "Predictions of the side effects from the radiation therapy are based on physics."
    },
    {
     "id": 1162123,
     "content_html": "The devices used for generating some kinds of radiation are based on principles of physics."
    },
    {
     "id": 1162120,
     "content_html": "Predictions of the life expectancy of patients receiving radiation therapy are based on physics."
    }
   ],
