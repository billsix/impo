   "stimulus_html": "",
   "stem_html": "How are electrostatic force and charge related?",
   "answers": [
    {
     "id": 746319,
     "content_html": "The force is proportional to the product of two charges."
    },
    {
     "id": 746318,
     "content_html": "The force is inversely proportional to the product of two charges."
    },
    {
     "id": 746317,
     "content_html": "The force is proportional to any one of the charges between which the force is acting."
    },
    {
     "id": 746316,
     "content_html": "The force is inversely proportional to any one of the charges between which the force is acting."
    }
