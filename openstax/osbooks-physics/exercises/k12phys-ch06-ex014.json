  {
   "id": 522508,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is tangential velocity?",
   "answers": [
    {
     "id": 1022911,
     "content_html": "Tangential velocity is the average linear velocity of an object in a circular motion."
    },
    {
     "id": 1022912,
     "content_html": "Tangential velocity is the instantaneous linear velocity of an object undergoing rotational motion."
    },
    {
     "id": 1022913,
     "content_html": "Tangential velocity is the average angular velocity of an object in a circular motion."
    },
    {
     "id": 1022914,
     "content_html": "Tangential velocity is the instantaneous angular velocity of an object in a circular motion."
    }
