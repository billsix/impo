   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Ten joules are transferred by heat into a system, followed by another <span data-math=\"20\\,\\text{J}\">20\\,\\text{J}</span>. What is the change in the system’s internal energy? What would be the difference in this change if <span data-math=\"30\\,\\text{J}\">30\\,\\text{J}</span> of energy were added by heat to the system at once?",
   "answers": [
    {
     "id": 744995,
     "content_html": "<span data-math=\"10\\,\\text{J}\">10\\,\\text{J}</span>; the change in internal energy would be same even if the heat added the energy at once"
    },
    {
     "id": 744996,
     "content_html": "<span data-math=\"30\\,\\text{J}\">30\\,\\text{J}</span>; the change in internal energy would be same even if the heat added the energy at once"
    },
