  {
   "id": 243140,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between harmonics and overtones?",
   "answers": [
    {
     "id": 761976,
     "content_html": "Harmonics are all multiples of the fundamental frequency. The first overtone is actually the first harmonic."
    },
    {
     "id": 761977,
     "content_html": "Harmonics are all multiples of the fundamental frequency. The first overtone is actually the second harmonic."
    },
    {
     "id": 761975,
     "content_html": "Harmonics are all multiples of the fundamental frequency. The second overtone is actually the first harmonic."
    },
    {
     "id": 761974,
     "content_html": "Harmonics are all multiples of the fundamental frequency. The third overtone is actually the second harmonic."
    }
   ],
