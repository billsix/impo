  {
   "id": 536497,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two people, who have the same mass, throw two different objects at the same velocity. If the first object is heavier than the second, compare the velocities gained by the two people as a result of recoil.",
   "answers": [
    {
     "id": 1052179,
     "content_html": "The first person will gain more velocity as a result of recoil."
    },
    {
     "id": 1052180,
     "content_html": "The second person will gain more velocity as a result of recoil."
    },
    {
     "id": 1052181,
     "content_html": "Both people will gain the same velocity as a result of recoil."
    },
    {
     "id": 1052182,
     "content_html": "The velocity of both people will be zero as a result of recoil."
    }
   ],
