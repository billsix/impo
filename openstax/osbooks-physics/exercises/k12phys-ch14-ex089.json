 "questions": [
  {
   "id": 614143,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Suppose you are driving at a speed of <span data-math=\"20.0\\,\\text{m/s}\">20.0\\,\\text{m/s}</span> and you hear the sound of a bell at a frequency of <span data-math=\"400.0\\,\\text{Hz}\">400.0\\,\\text{Hz}</span>. What is the actual frequency of the bell if the speed of sound is <span data-math=\"335\\,\\text{m/s}\">335\\,\\text{m/s}</span>?",
   "answers": [
    {
     "id": 1164559,
     "content_html": "<span data-math=\"f_s=401\\,\\text{Hz or}\\,f_s=315\\,\\text{Hz}\">f_s=401\\,\\text{Hz or}\\,f_s=315\\,\\text{Hz}</span>\n"
    },
    {
     "id": 1164558,
     "content_html": "<span data-math=\"f_s=385\\,\\text{Hz or}\\,f_s=419\\,\\text{Hz}\">f_s=385\\,\\text{Hz or}\\,f_s=419\\,\\text{Hz}</span>\n"
    },
    {
     "id": 1164557,
     "content_html": "<span data-math=\"f_s = 415\\,\\text{Hz or}\\,f_s = 366\\,\\text{Hz}\">f_s = 415\\,\\text{Hz or}\\,f_s = 366\\,\\text{Hz}</span>\n"
    },
    {
     "id": 1164560,
     "content_html": "<span data-math=\"f_s=425\\,\\text{Hz}\\; \\text{or}\\,f_s=377\\,\\text{Hz}\">f_s=425\\,\\text{Hz}\\; \\text{or}\\,f_s=377\\,\\text{Hz}</span>\n"
    }
   ],
