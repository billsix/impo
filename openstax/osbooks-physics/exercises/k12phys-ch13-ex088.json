 "questions": [
  {
   "id": 239087,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Occasionally, during earthquakes, areas near the epicenter are not damaged while those farther away are damaged. Why could this occur?",
   "answers": [
    {
     "id": 745993,
     "content_html": "Destructive interference results in waves with greater amplitudes being formed in places farther away from the epicenter."
    },
    {
     "id": 745994,
     "content_html": "Constructive interference results in waves with greater amplitudes being formed in places farther away from the epicenter."
    },
    {
     "id": 745992,
     "content_html": "The standing waves of great amplitudes are formed in places farther away from the epicenter."
    },
    {
     "id": 745991,
     "content_html": "The pulse waves of great amplitude are formed in places farther away from the epicenter."
    }
   ],
