   "id": 239600,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why increasing the frequency of rotation of the coils in an electrical generator increases the output emf.",
   "answers": [
    {
     "id": 747916,
     "content_html": "The induced emf is proportional to the rate of change of magnetic flux with respect to distance."
    },
    {
     "id": 747915,
     "content_html": "The induced emf is inversely proportional to the rate of change of magnetic flux with respect to distance."
    },
    {
     "id": 747914,
     "content_html": "The induced emf is inversely proportional to the rate of change of magnetic flux with respect to time."
    },
    {
     "id": 747917,
     "content_html": "The induced emf is proportional to the rate of change of magnetic flux with respect to time."
