  {
   "id": 516084,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Consider <span data-math=\"\\overrightarrow{\\text{A}} - \\overrightarrow{\\text{B}} = \\overrightarrow{\\text{R}}\">\\overrightarrow{\\text{A}} - \\overrightarrow{\\text{B}} = \\overrightarrow{\\text{R}}</span>. What is <span data-math=\"R_y\">R_y</span> in terms of <span data-math=\"A_y\">A_y</span> and <span data-math=\"B_y\">B_y</span>?",
   "answers": [
    {
     "id": 1010844,
     "content_html": "<span data-math=\"R_y = \\frac{A_y}{B_y}\">R_y = \\frac{A_y}{B_y}</span>"
    },
    {
     "id": 1010845,
     "content_html": "<span data-math=\"R_y = \\frac{B_y}{A_y}\">R_y = \\frac{B_y}{A_y}</span>"
    },
    {
     "id": 1010846,
     "content_html": "<span data-math=\"R_y = A_y + B_y\">R_y = A_y + B_y</span>"
    },
    {
     "id": 1010847,
     "content_html": "<span data-math=\"R_y = A_y - B_y\">R_y = A_y - B_y</span>"
    }
   ],
