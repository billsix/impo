  {
   "id": 242969,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A scientist notices that a sound travels faster through a solid material than through the air. Which of the following can explain this?",
   "answers": [
    {
     "id": 761330,
     "content_html": "Solid materials are denser than air."
    },
    {
     "id": 761329,
     "content_html": "Solid materials are less dense than air."
    },
    {
     "id": 761331,
     "content_html": "A solid is more rigid than air."
    },
    {
     "id": 761328,
     "content_html": "A solid is easier to compress than air."
    }
   ],
