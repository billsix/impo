   "stimulus_html": "",
   "stem_html": "Describe the potential energy of two nuclei as they approach each other.",
   "answers": [
    {
     "id": 764070,
     "content_html": "The potential energy will decrease as the nuclei are brought together and then rapidly increase once a minimum is reached."
    },
    {
     "id": 764069,
     "content_html": "The potential energy will decrease as the nuclei are brought together."
    },
    {
     "id": 764068,
     "content_html": "The potential energy will increase as the nuclei are brought together."
    },
    {
     "id": 764067,
     "content_html": "The potential energy will increase as the nuclei are brought together and then rapidly decrease once a maximum is reached."
    }
