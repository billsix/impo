 "questions": [
  {
   "id": 522504,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the relative orientation of the radius and tangential velocity vectors of an object in uniform circular motion?",
   "answers": [
    {
     "id": 1022895,
     "content_html": "Tangential velocity vector is always parallel to the radius of the circular path along which the object moves."
    },
    {
     "id": 1022896,
     "content_html": "Tangential velocity vector is always perpendicular to the radius of the circular path along which the object moves."
    },
    {
     "id": 1022897,
     "content_html": "Tangential velocity vector is always at an acute angle to the radius of the circular path along which the object moves."
    },
    {
     "id": 1022898,
     "content_html": "Tangential velocity vector is always at an obtuse angle to the radius of the circular path along which the object moves."
    }
   ],
