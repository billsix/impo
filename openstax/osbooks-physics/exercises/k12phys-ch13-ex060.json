   "stem_html": "What is interference of waves?",
   "answers": [
    {
     "id": 745788,
     "content_html": "Interference is a superposition of two waves to form a resultant wave with higher or lower frequency."
    },
    {
     "id": 745791,
     "content_html": "Interference is a superposition of two waves to form a wave of larger or smaller amplitude."
    },
    {
     "id": 745789,
     "content_html": "Interference is a superposition of two waves to form a resultant wave with higher or lower velocity."
    },
    {
     "id": 745790,
     "content_html": "Interference is a superposition of two waves to form a resultant wave with longer or shorter wavelength."
    }
