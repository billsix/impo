  {
   "id": 238736,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is thermal equilibrium?",
   "answers": [
    {
     "id": 744671,
     "content_html": "When two objects in contact with each other are at the same pressure, they are said to be in thermal equilibrium."
    },
    {
     "id": 744670,
     "content_html": "When two objects in contact with each other are at different temperatures, they are said to be in thermal equilibrium."
    },
    {
     "id": 744672,
     "content_html": "When two objects in contact with each other are at the same temperature, they are said to be in thermal equilibrium."
    },
    {
     "id": 744669,
     "content_html": "When two objects not in contact with each other are at the same pressure, they are said to be in thermal equilibrium."
    }
   ],
