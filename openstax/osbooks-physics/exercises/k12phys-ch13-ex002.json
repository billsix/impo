   "id": 613973,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If we lived in a parallel universe where ocean waves were longitudinal, what would a surfer’s motion look like?",
   "answers": [
    {
     "id": 1163902,
     "content_html": "The surfer would move side-to-side/back-and-forth vertically with no horizontal motion."
    },
    {
     "id": 1163903,
     "content_html": "The surfer would forward and backward horizontally with no vertical motion."
    }
