   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are X-rays used in imaging of broken bones, rather than radio waves?",
   "answers": [
    {
     "id": 762176,
     "content_html": "X-rays have higher penetrating energy than radio waves."
    },
    {
     "id": 762175,
     "content_html": "X-rays have lower penetrating energy than radio waves."
    },
    {
     "id": 762174,
     "content_html": "X-rays have a lower frequency range than radio waves."
    },
    {
     "id": 762173,
     "content_html": "X-rays have longer wavelengths than radio waves."
    }
