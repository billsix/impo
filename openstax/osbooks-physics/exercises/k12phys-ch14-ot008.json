 "questions": [
  {
   "id": 242957,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does the amplitude of a sound wave decrease with distance from its source?",
   "answers": [
    {
     "id": 761284,
     "content_html": "The amplitude of a sound wave decreases with distance from its source, because the frequency of the sound wave decreases."
    },
    {
     "id": 761283,
     "content_html": "The amplitude of a sound wave decreases with distance from its source, because the speed of the sound wave decreases."
    },
    {
     "id": 761282,
     "content_html": "The amplitude of a sound wave decreases with distance from its source, because the wavelength of the sound wave increases."
    },
    {
     "id": 761285,
     "content_html": "The amplitude of a sound wave decreases with distance from its source, because the energy of the wave is spread over a larger and larger area."
    }
   ],
