 "questions": [
  {
   "id": 613904,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If the thermal energy of a perfectly black object is increased by conduction, will the object remain black in appearance? Why or why not?",
   "answers": [
    {
     "id": 1163633,
     "content_html": "No, the energy of the radiation increases as the temperature increases, and the radiation becomes visible at certain temperatures."
    },
    {
     "id": 1163630,
     "content_html": "Yes, the energy of the radiation decreases as the temperature increases, and the radiation remains invisible at those energies."
    },
    {
     "id": 1163631,
     "content_html": "No, the energy of the radiation decreases as the temperature increases, until the frequencies of the radiation are the same as those of visible light."
    },
    {
     "id": 1163632,
     "content_html": "Yes, as the temperature increases, and the energy is transferred from the object by other mechanisms besides radiation, so that the energy of the radiation does not increase."
    }
   ],
