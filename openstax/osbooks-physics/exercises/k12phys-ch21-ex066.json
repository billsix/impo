 "questions": [
  {
   "id": 243584,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You and your lab partner increase the intensity of light shining on a metal surface. Predict the effect on the current that you are able to measure and explain your reasoning.\n",
   "answers": [
    {
     "id": 763725,
     "content_html": "The observed current will increase because more electrons are moving through the material."
    },
    {
     "id": 763724,
     "content_html": "The observed current will increase because electrons are moving more quickly through the material."
    },
    {
     "id": 763723,
     "content_html": "The observed current will decrease because fewer electrons are moving through the material. "
    },
    {
     "id": 763722,
     "content_html": "The observed current will decrease because electrons are moving more slowly through the material."
    }
   ],
