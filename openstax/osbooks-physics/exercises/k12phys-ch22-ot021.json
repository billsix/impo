 "questions": [
  {
   "id": 243682,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Sometimes it is necessary to take a PET scan very soon after ingesting a radiopharmaceutical. Why is that the case?",
   "answers": [
    {
     "id": 764094,
     "content_html": "The radiopharmaceutical may have a short half-life."
    },
    {
     "id": 764093,
     "content_html": "The radiopharmaceutical may have a long half-life."
    },
    {
     "id": 764092,
     "content_html": "The radiopharmaceutical quickly passes through the digestive system."
    },
    {
     "id": 764091,
     "content_html": "The radiopharmaceutical can become lodged in the digestive system."
    }
   ],
