   "id": 239420,
   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: Resistors in Parallel.\n\nThis video introduces and explains how resistors work when parallel.\n\n<iframe src=\"https://www.openstaxcollege.org/l/02resistparall\"></iframe>",
   "stem_html": "If a <span data-math=\"5\\text{-V}\">5\\text{-V}</span> drop occurs across <span data-math=\"R_1\">R_1</span>, and <span data-math=\"R_1\">R_1</span> is connected in parallel to <span data-math=\"R_2\">R_2</span>, what is the voltage drop across <span data-math=\"R_2\">R_2</span>?",
   "answers": [
    {
     "id": 747249,
     "content_html": "Voltage drop across  is <span data-math=\"0\\,\\text{V}\">0\\,\\text{V}</span>."
    },
    {
     "id": 747248,
     "content_html": "Voltage drop across  is <span data-math=\"2.5\\,\\text{V}\">2.5\\,\\text{V}</span>."
    },
    {
     "id": 747250,
     "content_html": "Voltage drop across is <span data-math=\"5\\,\\text{V}\">5\\,\\text{V}</span>."
    },
    {
     "id": 747247,
     "content_html": "Voltage drop across  is <span data-math=\"10\\,\\text{V}\">10\\,\\text{V}</span>."
    }
