   "stimulus_html": "",
   "stem_html": "What equation defines angular velocity, ω when r is the radius of curvature, θ is the angle, and t is the time?",
   "answers": [
    {
     "id": 1022879,
     "content_html": "<span data-math=\"\\omega = \\frac{\\Delta\\theta}{\\Delta{t}}\">\\omega = \\frac{\\Delta\\theta}{\\Delta{t}}</span>"
    },
    {
     "id": 1022880,
     "content_html": "<span data-math=\"\\omega = \\frac{\\Delta{t}}{\\Delta\\theta}\">\\omega = \\frac{\\Delta{t}}{\\Delta\\theta}</span>"
    },
    {
     "id": 1022881,
     "content_html": "<span data-math=\"\\omega = \\frac{\\Delta{r}}{\\Delta{t}}\">\\omega = \\frac{\\Delta{r}}{\\Delta{t}}</span>"
