  {
   "id": 239599,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In a hydroelectric dam, what is used to power the electrical generators that provide electric power? Explain.",
   "answers": [
    {
     "id": 747910,
     "content_html": "The electric potential energy of stored water is used to produce emf with the help of a turbine."
    },
    {
     "id": 747911,
     "content_html": "The electric potential energy of stored water is used to produce resistance with the help of a turbine."
    },
    {
     "id": 747912,
     "content_html": "Gravitational potential energy of stored water is used to produce resistance with the help of a turbine."
    },
    {
     "id": 747913,
     "content_html": "Gravitational potential energy of stored water is used to produce emf with the help of a turbine."
