 "questions": [
  {
   "id": 504223,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In 1999 the Mars Climate Orbiter crashed because calculation were performed in English units instead of SI units. At one point the orbiter was just 187,000 feet above the surface, which was too close to stay in orbit. What was the height of the orbiter at this time in kilometers? (Assume 1 meter equals 3.281 feet.)",
   "answers": [
    {
     "id": 991537,
     "content_html": "16 km"
    },
    {
     "id": 991538,
     "content_html": "18 km"
    },
    {
     "id": 991539,
     "content_html": "57 km"
    },
    {
     "id": 991540,
     "content_html": "614 km"
    }
   ],
