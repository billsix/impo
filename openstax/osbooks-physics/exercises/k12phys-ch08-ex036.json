   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If the moment of inertia of an isolated system increases, what happens to its angular velocity?",
   "answers": [
    {
     "id": 1051331,
     "content_html": "It increases."
    },
    {
     "id": 1051332,
     "content_html": "It decreases."
    },
    {
     "id": 1051333,
     "content_html": "It stays constant."
    },
    {
     "id": 1051334,
     "content_html": "It becomes zero."
    }
