   "id": 521898,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How or why does a pendulum oscillate?",
   "answers": [
    {
     "id": 1021278,
     "content_html": "A pendulum oscillates due to applied force."
    },
    {
     "id": 1021279,
     "content_html": "A pendulum oscillates due to the elastic nature of the string."
    },
    {
     "id": 1021280,
     "content_html": "A pendulum oscillates due to restoring force arising from gravity."
    },
    {
     "id": 1021281,
     "content_html": "A pendulum oscillates due to restoring force arising from tension in the string."
    }
   ],
