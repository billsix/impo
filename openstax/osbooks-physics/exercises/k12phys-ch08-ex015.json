   "stimulus_html": "<figure class=\"unnumbered\">\n<img src=\"exercises/media/88a9f2d9c2c7261b.jpg\" alt=\"\">\n<figcaption>(credit: modification of work from Pinterest)</figcaption>\n</figure>",
