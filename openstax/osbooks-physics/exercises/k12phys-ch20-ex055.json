 "questions": [
  {
   "id": 239573,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If the bit wire were looped twice around each core, how would the voltage induced in the bit wire be affected?",
   "answers": [
    {
     "id": 747815,
     "content_html": "If number of loops around the wire is doubled, the emf is halved."
    },
    {
     "id": 747814,
     "content_html": "If number of loops around the wire is doubled, the emf is not affected."
    },
    {
     "id": 747816,
     "content_html": "If number of loops around the wire is doubled, the emf is also doubled."
    },
    {
     "id": 747813,
     "content_html": "If number of loops around the wire is doubled, the emf is four times the initial value."
    }
   ],
