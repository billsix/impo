 "questions": [
  {
   "id": 239100,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does the water curve around the charged object?",
   "answers": [
    {
     "id": 746045,
     "content_html": "The charged object induces uniform positive charge on the water molecules."
    },
    {
     "id": 746044,
     "content_html": "The charged object induces uniform negative charge on the water molecules."
    },
    {
     "id": 746046,
     "content_html": "The charged object attracts the polarized water molecules and ions that are dissolved in the water."
    },
    {
     "id": 746043,
     "content_html": "The charged object depolarizes the water molecules and the ions dissolved in the water."
    }
   ],
