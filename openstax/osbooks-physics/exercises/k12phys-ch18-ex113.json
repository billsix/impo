  {
   "id": 239290,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If you double the area of a parallel-plate capacitor and reduce the distance between the plates by a factor of four, how is the capacitance affected?",
   "answers": [
    {
     "id": 746749,
     "content_html": "It will increase by a factor of two."
    },
    {
     "id": 746748,
     "content_html": "It will increase by a factor of four."
    },
    {
     "id": 746747,
     "content_html": "It will increase by a factor of six."
    },
    {
     "id": 746750,
     "content_html": "It will increase by a factor of eight."
    }
