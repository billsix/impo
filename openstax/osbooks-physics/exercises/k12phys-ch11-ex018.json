 "questions": [
  {
   "id": 613895,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the meaning of absolute zero?",
   "answers": [
    {
     "id": 1163596,
     "content_html": "It is the temperature at which the internal energy of the system is maximum, because the speed of its constituent particles increases to maximum at this point."
    },
    {
     "id": 1163595,
     "content_html": "It is the temperature at which the internal energy of the system is maximum, because the speed of its constituent particles decreases to zero at this point."
    },
    {
     "id": 1163594,
     "content_html": "It is the temperature at which the internal energy of the system approaches zero, because the speed of its constituent particles increases to a maximum at this point."
    },
    {
     "id": 1163597,
     "content_html": "It is that temperature at which the internal energy of the system approaches zero, because the speed of its constituent particles decreases to zero at this point."
    }
   ],
