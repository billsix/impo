 "questions": [
  {
   "id": 613770,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "At the beginning of a roller coaster ride, the roller coaster car has an initial energy mostly in the form of PE. Which statement explains why the fastest speeds of the car will be at the lowest points in the ride?",
   "answers": [
    {
     "id": 1163101,
     "content_html": "At the bottom of the slope kinetic energy is at its maximum value and potential energy is at its minimum value."
    },
    {
     "id": 1163098,
     "content_html": "At the bottom of the slope potential energy is at its maximum value and kinetic energy is at its minimum value."
    },
    {
     "id": 1163099,
     "content_html": "At the bottom of the slope both kinetic and potential energy reach their maximum values"
    },
    {
     "id": 1163100,
     "content_html": "At the bottom of the slope both kinetic and potential energy reach their minimum values."
    }
   ],
