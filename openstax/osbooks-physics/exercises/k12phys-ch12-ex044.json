   "stimulus_html": "",
   "stem_html": "Why does a bridge have expansion joints?",
   "answers": [
    {
     "id": 1163797,
     "content_html": "because the bridge expands and contracts with the change in temperature"
    },
    {
     "id": 1163796,
     "content_html": "because the bridge expands and contracts with the change in motion of objects moving on the bridge"
    },
    {
     "id": 1163795,
     "content_html": "because the bridge expands and contracts with the change in total load on the bridge"
    },
    {
     "id": 1163794,
     "content_html": "because the bridge expands and contracts with the change in magnitude of wind blowing"
    }
