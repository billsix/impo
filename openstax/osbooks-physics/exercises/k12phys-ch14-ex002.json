 "questions": [
  {
   "id": 242940,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Is there a difference in the amount of delay depending on whether you make the frequency higher or lower? Why?",
   "answers": [
    {
     "id": 761221,
     "content_html": "Yes, the speed of propagation depends only on the frequency of the wave."
    },
    {
     "id": 761220,
     "content_html": "Yes, the speed of propagation depends upon the wavelength of the wave, and wavelength changes as the frequency changes."
    },
    {
     "id": 761219,
     "content_html": "No, the speed of propagation depends only on the wavelength of the wave."
    },
    {
     "id": 761222,
     "content_html": "No, the speed of propagation is constant in a given medium; only the wavelength changes as the frequency changes."
    }
   ],
