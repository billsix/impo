 "questions": [
  {
   "id": 522536,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Consider two pits on a CD, one close to the center and one close to the outer edge. Compare their angles of rotation and distance traveled after one full revolution.",
   "answers": [
    {
     "id": 1023019,
     "content_html": "The one close to the center would go through the greater angle of rotation. The one near the outer edge would trace a greater arc length."
    },
    {
     "id": 1023020,
     "content_html": "The one near the edge would go through the greater angle of rotation. The one close to the center would trace a greater arc length."
    },
    {
     "id": 1023021,
     "content_html": "Both would go through the same angle of rotation. The one near the outer edge would trace the greater arc length."
    },
    {
     "id": 1023022,
     "content_html": "Both would go through the same angle of rotation. The arc length traced by both would be zero because they returned to their starting points."
    }
   ],
