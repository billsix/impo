 "questions": [
  {
   "id": 614167,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how X-radiation can be harmful and how it can be a useful diagnostic tool.",
   "answers": [
    {
     "id": 1164652,
     "content_html": "Overexposure to X-rays can cause HIV, though normal levels of X-rays can be used for sterilizing needles."
    },
    {
     "id": 1164655,
     "content_html": "Overexposure to X-rays can cause cancer, though in limited doses X-rays can be used for imaging internal body parts."
    },
    {
     "id": 1164653,
     "content_html": "Overexposure to X-rays causes diabetes, though normal levels of X-rays can be used for imaging internal body parts."
    },
    {
     "id": 1164654,
     "content_html": "Overexposure to X-rays causes cancer, though normal levels of X-rays can be used for reducing cholesterol in the blood."
    }
   ],
