 "questions": [
  {
   "id": 550417,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>Explain what is meant when a physicist states that \"simultaneity is not absolute.\"</p>\n<p>Describe what is meant by the sentence, “Simultaneity is not absolute.”</p>",
   "answers": [
    {
     "id": 1081696,
     "content_html": "Events may appear simultaneous in all frames of reference."
    },
    {
     "id": 1081697,
     "content_html": "Events may not appear simultaneous in all frames of reference."
    },
    {
     "id": 1081698,
     "content_html": "The speed of light is not the same in all frames of reference."
    },
    {
     "id": 1081699,
     "content_html": "The laws of physics may be different in different inertial frames of reference."
    }
   ],
