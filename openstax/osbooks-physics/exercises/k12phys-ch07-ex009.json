   "stimulus_html": "",
   "stem_html": "Are Kepler’s laws purely descriptive, or do they contain causal information?",
   "answers": [
    {
     "id": 1051515,
     "content_html": "Kepler’s laws are purely descriptive."
    },
    {
     "id": 1051516,
     "content_html": "Kepler’s laws are purely causal."
    },
    {
     "id": 1051517,
     "content_html": "Kepler’s laws are descriptive as well as causal."
    },
    {
