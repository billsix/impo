   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Predict the effect on a photon’s wavelength of a collision with an electron.\n",
   "answers": [
    {
     "id": 763933,
     "content_html": "The photon’s wavelength will drop to zero."
    },
    {
     "id": 763932,
     "content_html": "The photon’s wavelength will decrease."
    },
    {
     "id": 763934,
     "content_html": "The photon’s wavelength will increase."
    },
    {
     "id": 763931,
     "content_html": "The photon’s wavelength will be inverted."
    }
