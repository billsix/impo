   "stimulus_html": "",
   "stem_html": "X-rays carry more energy than visible light. Compare the frequencies and wavelengths of these two types of EM radiation.",
   "answers": [
    {
     "id": 762151,
     "content_html": "Visible light has higher frequencies and shorter wavelengths than X-rays."
    },
    {
     "id": 762150,
     "content_html": "Visible light has lower frequencies and shorter wavelengths than X-rays."
    },
    {
     "id": 762149,
     "content_html": "Visible light has higher frequencies and longer wavelengths than X-rays."
    },
    {
     "id": 762152,
     "content_html": "Visible light has lower frequencies and longer wavelengths than X-rays."
