   "id": 239440,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If you remove resistance from a circuit, does the total resistance of the circuit always decrease? Explain.",
   "answers": [
    {
     "id": 747325,
     "content_html": "No, because for a parallel combination of resistors, the resistance through the remaining circuit increases."
    },
    {
     "id": 747324,
     "content_html": "Yes, because for a parallel combination of resistors, the resistance through the remaining circuit increases."
    }
