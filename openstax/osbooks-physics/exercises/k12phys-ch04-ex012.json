   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "By convention, which sign is assigned to an object moving downward?",
   "answers": [
    {
     "id": 1001322,
     "content_html": "A positive sign ( <span data-math=\"+\">+</span> )"
    },
    {
     "id": 1001323,
     "content_html": "A negative sign ( <span data-math=\"-\">-</span> )"
    },
    {
     "id": 1001324,
     "content_html": "Either a positive or negative sign ( <span data-math=\"\\pm\">\\pm</span> )"
    },
    {
     "id": 1001325,
     "content_html": "No sign is assigned"
    }
