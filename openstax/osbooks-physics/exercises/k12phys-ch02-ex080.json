 "questions": [
  {
   "id": 510513,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A car traveling at 10 m/s is traveling at twice the velocity 10 s later. If you made a velocity graph of this motion, what information would be obtained from the area under the graph?",
   "answers": [
    {
     "id": 998628,
     "content_html": "The rate of acceleration of the car."
    },
    {
     "id": 998629,
     "content_html": "The area enclosed by the car’s trip."
    },
    {
     "id": 998630,
     "content_html": "The car’s displacement during the 10 s."
    },
    {
     "id": 998631,
     "content_html": "The velocity of the car at t = 10 s."
    }
   ],
