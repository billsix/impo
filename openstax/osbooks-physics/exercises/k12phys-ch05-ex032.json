 "questions": [
  {
   "id": 516062,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two vectors are equal in magnitude and opposite in direction. What is the magnitude of their resultant vector?",
   "answers": [
    {
     "id": 1010770,
     "content_html": "The magnitude of the resultant vector will be zero."
    },
    {
     "id": 1010771,
     "content_html": "The magnitude of the resultant vector will be twice the magnitude of the original vector."
    },
    {
     "id": 1010772,
     "content_html": "The magnitude of the resultant vector will be same as magnitude of the original vector."
    },
    {
     "id": 1010773,
     "content_html": "The magnitude of the resultant vector will be half the magnitude of the original vector."
    }
   ],
