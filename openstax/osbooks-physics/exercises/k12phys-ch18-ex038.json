 "questions": [
  {
   "id": 239162,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Imagine that the magnitude of the charge on the electron differed very slightly from that of the proton. How would this affect life on Earth and physics in general?",
   "answers": [
    {
     "id": 746271,
     "content_html": "Many macroscopic objects would be charged, so we would experience the enormous force of electricity on a daily basis."
    },
    {
     "id": 746270,
     "content_html": "Many macroscopic objects would be charged, so we would experience the small force of electricity on a daily basis."
    },
    {
     "id": 746269,
     "content_html": "Many macroscopic objects would be charged, but it would not affect life on Earth and physics in general."
    },
    {
     "id": 746268,
     "content_html": "Macroscopic objects would remain neutral, so it would not affect life on Earth and physics in general."
    }
   ],
