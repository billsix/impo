 "questions": [
  {
   "id": 614230,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Alpha particles are positively charged. What influence did their charge have on the gold foil experiment?",
   "answers": [
    {
     "id": 1164902,
     "content_html": "The positively charged alpha particles were attracted by the attractive electrostatic force from the positive nuclei of the gold atoms."
    },
    {
     "id": 1164903,
     "content_html": "The positively charged alpha particles were scattered by the attractive electrostatic force from the positive nuclei of the gold atoms."
    },
    {
     "id": 1164905,
     "content_html": "The positively charged alpha particles were scattered by the repulsive electrostatic force from the positive nuclei of the gold atoms."
    },
    {
     "id": 1164904,
     "content_html": "The positively charged alpha particles were attracted by the repulsive electrostatic force from the positive nuclei of the gold atoms."
    }
   ],
