 "questions": [
  {
   "id": 613929,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the meaning of efficiency in terms of a car engine?",
   "answers": [
    {
     "id": 1163728,
     "content_html": "An engine’s efficiency equals the sum of useful energy (work) and the input energy."
    },
    {
     "id": 1163729,
     "content_html": "An engine’s efficiency equals the proportion of useful energy (work) to the input energy."
    },
    {
     "id": 1163727,
     "content_html": "An engine’s efficiency equals the product of useful energy (work) and the input energy."
    },
    {
     "id": 1163726,
     "content_html": "An engine’s efficiency equals the difference between the useful energy (work) and the input energy."
    }
   ],
