 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1169084578072\" class=\"watch-physics\" data-label=\"\">\n<div data-type=\"title\" id=\"3\">Watch Physics: Virtual Image</div>\n<p id=\"fs-id1169084653395\" class=\" \">This video explains the concept of virtual images.</p>\n<div data-type=\"media\" id=\"fs-id1169083944516\" data-alt=\"This tutorial explains virtual images.\">\n<div data-type=\"alternatives\" class=\"os-has-iframe os-has-link\">\n<a class=\"os-is-link\" target=\"_window\" href=\"https://www.openstaxcollege.org/l/02virtualimg\">Click to view content</a><iframe width=\"660\" height=\"371.4\" src=\"https://www.openstaxcollege.org/l/02virtualimg\" class=\"os-is-iframe\"><!-- no-selfclose --></iframe>\n</div>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 243254,
   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: Virtual Image.\n\nThis video explains the concept of virtual images.\n<iframe src=\"https://www.openstaxcollege.org/l/02virtualimg\"></iframe>",
   "stem_html": "Compare the distance of an object from a mirror to the apparent distance of its virtual image behind the mirror.",
   "answers": [
    {
     "id": 762424,
     "content_html": "The distances of the image and the object from the mirror are the same."
    },
    {
     "id": 762423,
     "content_html": "The distances of the image and the object from the mirror are always different."
    },
    {
     "id": 762422,
     "content_html": "The image is formed at infinity if the object is placed near the mirror."
    },
    {
     "id": 762421,
     "content_html": "The image is formed near the mirror if the object is placed at infinity."
    }
   ],
