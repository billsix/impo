   "id": 640278,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe how modeling is useful in studying the structure of the atom.",
   "answers": [
    {
     "id": 1248612,
     "content_html": "Modeling replaces the real system by something similar but easier to examine."
    },
    {
     "id": 1248609,
     "content_html": "Modeling replaces the real system by something more interesting to examine."
    },
    {
     "id": 1248610,
     "content_html": "Modeling replaces the real system by something with more realistic properties."
    },
    {
     "id": 1248611,
     "content_html": "Modeling includes more details than are present in the real system."
    }
