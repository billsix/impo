 "questions": [
  {
   "id": 510317,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If a person takes 3 steps and ends up in the exact same place as their starting point, what must be true?\n",
   "answers": [
    {
     "id": 998240,
     "content_html": "The three steps must have equal displacement"
    },
    {
     "id": 998241,
     "content_html": "The displacement of the third step is larger than the displacement of the first two."
    },
    {
     "id": 998242,
     "content_html": "The average velocity must add up to zero."
    },
    {
     "id": 998243,
     "content_html": "The distance and average velocity must add up to zero."
    }
   ],
