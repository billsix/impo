 "questions": [
  {
   "id": 613515,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe all of the characteristics that can be determined about a straight line with a slope of <span data-math=\"{-3}\">{-3}</span> and a y-intercept of <span data-math=\"50\">50</span> on a graph.",
   "answers": [
    {
     "id": 1162102,
     "content_html": "Based on the information, the line has a negative slope. Because its y-intercept is 50 and its slope is negative, this line gradually rises on the graph as the x-value increases."
    },
    {
     "id": 1162103,
     "content_html": "Based on the information, the line has a negative slope. Because its y-intercept is 50 and its slope is negative, this line gradually moves downward on the graph as the x-value increases."
    },
    {
     "id": 1162101,
     "content_html": "Based on the information, the line has a positive slope. Because its y-intercept is 50 and its slope is positive, this line gradually rises on the graph as the x-value increases."
    },
    {
     "id": 1162100,
     "content_html": "Based on the information, the line has a positive slope. Because its y-intercept is 50 and its slope is positive, this line gradually moves downward on the graph as the x-value increases."
    }
   ],
