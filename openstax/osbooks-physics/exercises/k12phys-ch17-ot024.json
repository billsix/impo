 "questions": [
  {
   "id": 243437,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A laser pointer emits a coherent beam of parallel light rays. Does the light from such a source spread out at all? Explain.",
   "answers": [
    {
     "id": 763151,
     "content_html": "Yes, every point on a wavefront is not a source of wavelets, which prevent the spreading of light waves."
    },
    {
     "id": 763150,
     "content_html": "No, every point on a wavefront is not a source of wavelets, so that the beam behaves as a bundle of rays that travel in their initial direction."
    },
    {
     "id": 763149,
     "content_html": "No, every point on a wavefront is a source of wavelets, which keep the beam from spreading."
    },
    {
     "id": 763152,
     "content_html": "Yes, every point on a wavefront is a source of wavelets, which cause the beam to spread out steadily as it moves forward."
    }
   ],
