  {
   "id": 243082,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When the speed of the source matches the speed of sound, what happens to the amplitude of the sound wave? Why?",
   "answers": [
    {
     "id": 761758,
     "content_html": "It approaches zero. This is because all wave crests are superimposed on one another through constructive interference."
    },
    {
     "id": 761759,
     "content_html": "It approaches infinity. This is because all wave crests are superimposed on one another through constructive interference."
    },
    {
     "id": 761757,
     "content_html": "It approaches zero, because all wave crests are superimposed on one another through destructive interference."
    },
    {
     "id": 761756,
     "content_html": "It approaches infinity, because all wave crests are superimposed on one another through destructive interference."
    }
