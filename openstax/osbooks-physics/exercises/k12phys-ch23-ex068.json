 "questions": [
  {
   "id": 243817,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In what manner is <span data-math=\"E = mc^{2}\">E = mc^{2}</span> considered a precursor to the Grand Unified Theory?",
   "answers": [
    {
     "id": 764593,
     "content_html": "The grand unified theory seeks to relate the electroweak and strong nuclear forces to one another just as <span data-math=\"E = mc^{2}\">E = mc^{2}</span> related energy and mass."
    },
    {
     "id": 764592,
     "content_html": "The grand unified theory seeks to relate the electroweak force and mass to one another just as <span data-math=\"E = mc^{2}\">E = mc^{2}</span> related energy and mass."
    },
    {
     "id": 764591,
     "content_html": "The grand unified theory seeks to relate the mass and strong nuclear forces to one another just as <span data-math=\"E = mc^{2}\">E = mc^{2}</span> related energy and mass."
    },
    {
     "id": 764590,
     "content_html": "The grand unified theory seeks to relate gravity and strong nuclear force to one another, just as <span data-math=\"E = mc^{2}\">E = mc^{2}</span> related energy and mass."
    }
   ],
