 "questions": [
  {
   "id": 243733,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are synchrotrons constructed to be very large?",
   "answers": [
    {
     "id": 764285,
     "content_html": "By using a large radius, high particle velocities can be achieved using a large centripetal force created by large electromagnets."
    },
    {
     "id": 764286,
     "content_html": "By using a large radius, high particle velocities can be achieved without a large centripetal force created by large electromagnets."
    },
    {
     "id": 764284,
     "content_html": "By using a large radius, the velocities of particles can be reduced without a large centripetal force created by large electromagnets."
    },
    {
     "id": 764283,
     "content_html": "By using a large radius, the acceleration of particles can be decreased without a large centripetal force created by large electromagnets."
    }
   ],
