  {
   "id": 537840,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If both mass and velocity of an object are constant, what can you tell about its impulse?",
   "answers": [
    {
     "id": 1057193,
     "content_html": "Its impulse would be constant."
    },
    {
     "id": 1057194,
     "content_html": "Its impulse would be zero."
    },
    {
     "id": 1057195,
     "content_html": "Its impulse would be increasing."
    },
    {
     "id": 1057196,
     "content_html": "Its impulse would be decreasing."
    }
