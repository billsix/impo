  {
   "id": 521818,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "As the angle of the incline gets larger, what happens to the magnitudes of the perpendicular and parallel components of gravitational force?",
   "answers": [
    {
     "id": 1020962,
     "content_html": "Both the perpendicular and the parallel component will decrease."
    },
    {
     "id": 1020963,
     "content_html": "The perpendicular component will decrease and the parallel component will increase."
    },
    {
     "id": 1020964,
     "content_html": "The perpendicular component will increase and the parallel component will decrease."
    },
    {
     "id": 1020965,
     "content_html": "Both the perpendicular and the parallel component will increase."
    }
