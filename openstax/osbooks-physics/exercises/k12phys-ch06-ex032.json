  {
   "id": 522544,
   "is_answer_order_important": true,
   "stimulus_html": "<iframe src=\"https://www.youtube.com/embed/vZOk8NnjILg\"></iframe>",
   "stem_html": "Imagine that you are swinging a yoyo in a vertical clockwise circle in front of you, perpendicular to the direction you are facing. If the string breaks just as the yoyo reaches its bottommost position, nearest the floor. What will happen to the yoyo after the string breaks?",
   "answers": [
    {
     "id": 1023051,
     "content_html": "The yoyo will fly inward in the direction of the centripetal force."
    },
    {
     "id": 1023052,
     "content_html": "The yoyo will fly outward in the direction of the centripetal force."
    },
    {
     "id": 1023053,
     "content_html": "The yoyo will fly to the left in the direction of the tangential velocity."
    },
    {
     "id": 1023054,
     "content_html": "The yoyo will fly to the right in the direction of the tangential velocity."
    }
   ],
