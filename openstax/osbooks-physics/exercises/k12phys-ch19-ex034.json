 "questions": [
  {
   "id": 614056,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "With the voltage slider, give the battery a positive voltage. Notice that the electrons are spaced farther apart in the left wire than they are in the right wire. How does this reflect the voltage in the two wires?",
   "answers": [
    {
     "id": 1164222,
     "content_html": "The voltage between static charges is directly proportional to the distance between them."
    },
    {
     "id": 1164223,
     "content_html": "The voltage between static charges is directly proportional to square of the distance between them."
    },
    {
     "id": 1164225,
     "content_html": "The voltage between static charges is inversely proportional to the distance between them."
    },
    {
     "id": 1164224,
     "content_html": "The voltage between static charges is inversely proportional to square of the distance between them."
    }
   ],
