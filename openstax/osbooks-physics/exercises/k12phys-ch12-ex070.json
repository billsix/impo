  {
   "id": 613957,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is it not possible to convert all available energy into work?",
   "answers": [
    {
     "id": 1163841,
     "content_html": "Due to the entropy of a system, some energy is always unavailable for work."
    },
    {
     "id": 1163840,
     "content_html": "Due to the entropy of a system, some energy is always available for work."
    },
    {
     "id": 1163839,
     "content_html": "Due to the decrease in internal energy of a system, some energy is always made unavailable for work."
    },
    {
     "id": 1163838,
     "content_html": "Due to the increase in internal energy of a system, some energy is always made unavailable for work."
    }
