 "questions": [
  {
   "id": 243268,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<p>Use the law of reflection to explain why it is not a good idea to polish a mirror with coarse sandpaper.</p>",
   "answers": [
    {
     "id": 762479,
     "content_html": "The surface becomes smooth. A smooth surface produces a sharp image."
    },
    {
     "id": 762478,
     "content_html": "The surface becomes irregular. An irregular surface produces a sharp image."
    },
    {
     "id": 762477,
     "content_html": "The surface becomes smooth. A smooth surface transmits but does not reflect light."
    },
    {
     "id": 762480,
     "content_html": "The surface becomes irregular. An irregular surface produces a blurred image."
    }
   ],
