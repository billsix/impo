 "questions": [
  {
   "id": 243127,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the natural frequency of a system?",
   "answers": [
    {
     "id": 761924,
     "content_html": "The natural frequency is the frequency at which a system oscillates when it undergoes forced vibration."
    },
    {
     "id": 761923,
     "content_html": "The natural frequency is the frequency at which a system oscillates when it undergoes damped oscillation."
    },
    {
     "id": 761925,
     "content_html": "The natural frequency is the frequency at which a system oscillates when it undergoes free vibration without a driving force or damping."
    },
    {
     "id": 761922,
     "content_html": "The natural frequency is the frequency at which a system oscillates when it undergoes forced vibration with damping."
    }
   ],
