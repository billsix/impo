   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Can the validity of a model be limited, or must it be universally valid? How does this compare to the required validity of a theory or a law?",
   "answers": [
    {
     "id": 990769,
     "content_html": "Models, theories and laws must be universally valid."
    },
    {
     "id": 990770,
     "content_html": "Models, theories, and laws have only limited validity."
    },
    {
     "id": 990771,
     "content_html": "Models have limited validity while theories and laws are universally valid."
    },
