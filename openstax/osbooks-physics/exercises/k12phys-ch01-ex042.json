 "questions": [
  {
   "id": 501683,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You notice that it takes more force to get a large box to start sliding across the floor than it takes to get the box sliding faster once it is already moving. Create a testable hypothesis that attempts to explain this observation.",
   "answers": [
    {
     "id": 986041,
     "content_html": "The floor has greater distortions of space-time for moving the sliding box faster than for the box at rest."
    },
    {
     "id": 986042,
     "content_html": "The floor has greater distortions of space-time for the box at rest than for the sliding box."
    },
    {
     "id": 986043,
     "content_html": "The resistance between the floor and the box is less when the box is sliding then when the box is at rest."
    },
    {
     "id": 986044,
     "content_html": "The floor dislikes having objects move across it and therefore holds the box rigidly in place until it cannot resist the force."
    }
   ],
