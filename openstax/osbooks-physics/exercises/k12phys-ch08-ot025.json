  {
   "id": 536869,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "State the law of conservation of momentum.",
   "answers": [
    {
     "id": 1053641,
     "content_html": "Momentum is conserved for an isolated system with any number of objects in it."
    },
    {
     "id": 1053642,
     "content_html": "Momentum is conserved for an isolated system with an even number of objects in it."
    },
    {
     "id": 1053643,
     "content_html": "Momentum is conserved for an interacting system with any number of objects in it."
    },
    {
     "id": 1053644,
     "content_html": "Momentum is conserved for an interacting system with an even number of objects in it."
    }
   ],
