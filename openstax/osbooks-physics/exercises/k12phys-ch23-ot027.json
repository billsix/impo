  {
   "id": 243739,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What similarities exist between the discovery of the quark and the discovery of the neutron?",
   "answers": [
    {
     "id": 764309,
     "content_html": "Both the quark and the neutron were discovered by launching charged particles through an unknown structure and observing the particle recoil."
    },
    {
     "id": 764308,
     "content_html": "Both the quark and the neutron were discovered by launching electrically neutral particles through an unknown structure and observing the particle recoil."
    },
    {
     "id": 764307,
     "content_html": "Both quarks and neutrons were discovered by studying their deflection under an electric field."
    }
   ],
