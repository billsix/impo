 "questions": [
  {
   "id": 510953,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Rhianna and Logan start at the same point and walk in the same direction. If Rhianna’s average velocity is <i>v</i><sub>avg,R</sub> and she walks for half of Logan’s time, what is Logan’s velocity <i>v</i><sub>avg,L</sub> if he walks three times as far?",
   "answers": [
    {
     "id": 999636,
     "content_html": "<span data-math=\"v_{\\text{avg,L}} = \\frac{3}{2} v_{\\text{avg,R}}\">v_{\\text{avg,L}} = \\frac{3}{2} v_{\\text{avg,R}}</span>"
    },
    {
     "id": 999637,
     "content_html": "<span data-math=\"v_{\\text{avg,L}} = \\frac{2}{3} v_{\\text{avg,R}}\">v_{\\text{avg,L}} = \\frac{2}{3} v_{\\text{avg,R}}</span>"
    },
    {
     "id": 999638,
     "content_html": "<span data-math=\"v_{\\text{avg,L}} = \\sqrt{3 v_{\\text{avg,R}}}\">v_{\\text{avg,L}} = \\sqrt{3 v_{\\text{avg,R}}}</span>"
    },
    {
     "id": 999639,
     "content_html": "<span data-math=\"v_{\\text{avg,L}} = 3 v_{\\text{avg,R}}^{2}\">v_{\\text{avg,L}} = 3 v_{\\text{avg,R}}^{2}</span>"
    }
   ],
