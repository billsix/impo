 "questions": [
  {
   "id": 521820,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If the amplitude of the displacement of a spring were larger, how would this affect the graph of displacement over time? What would happen to the graph if the period was longer?",
   "answers": [
    {
     "id": 1020970,
     "content_html": "Larger amplitude would result in taller peaks and troughs and a longer period would result in greater separation in time between peaks."
    },
    {
     "id": 1020971,
     "content_html": "Larger amplitude would result in smaller peaks and troughs and a longer period would result in greater distance between peaks."
    },
    {
     "id": 1020972,
     "content_html": "Larger amplitude would result in taller peaks and troughs and a longer period would result in shorter distance between peaks."
    },
    {
     "id": 1020973,
     "content_html": "Larger amplitude would result in smaller peaks and troughs and a longer period would result in shorter distance between peaks."
    }
   ],
