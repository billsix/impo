 "questions": [
  {
   "id": 550159,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Did you expect the speed at the bottom of the slope to be the same as when the object fell straight down? Which statement best explains why this is not exactly the case in real-life situations?",
   "answers": [
    {
     "id": 1080766,
     "content_html": "The speed was the same in the scenario in the animation because the object was sliding on the ice, where there is large amount of friction. In real life, much of the mechanical energy is lost as heat caused by friction."
    },
    {
     "id": 1080767,
     "content_html": "The speed was the same in the scenario in the animation because the object was sliding on the ice, where there is small amount of friction. In real life, much of the mechanical energy is lost as heat caused by friction."
    },
    {
     "id": 1080768,
     "content_html": "The speed was the same in the scenario in the animation because the object was sliding on the ice, where there is large amount of friction. In real life, no mechanical energy is lost due to conservation of the mechanical energy."
    },
    {
     "id": 1080769,
     "content_html": "The speed was the same in the scenario in the animation because the object was sliding on the ice, where there is small amount of friction. In real life, no mechanical energy is lost due to conservation of the mechanical energy."
    }
   ],
