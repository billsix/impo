 "questions": [
  {
   "id": 614175,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Visible light has wavelengths in the range of about 400 to 800 nm. What does this indicate about the approximate thickness of the wall of a soap bubble? Explain your answer.",
   "answers": [
    {
     "id": 1164684,
     "content_html": "The thickness of the bubble wall is ten times that of the wavelength of light."
    },
    {
     "id": 1164687,
     "content_html": "The thickness of the bubble wall is similar to that of the wavelength of light."
    },
    {
     "id": 1164685,
     "content_html": "The thickness of the bubble wall is half the wavelength of light."
    },
    {
     "id": 1164686,
     "content_html": "The thickness of the bubble wall equals the cube of the wavelength of light."
    }
   ],
