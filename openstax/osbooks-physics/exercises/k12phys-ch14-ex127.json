 "questions": [
  {
   "id": 243176,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In the tuning fork and tube experiment, if resonance is formed for <span data-math=\"L = \\lambda /4\">L = \\lambda /4</span>, where <span data-math=\"L\">L</span> is the length of the tube and <span data-math=\"\\lambda\">\\lambda</span> is the wavelength of the sound wave, can resonance also be formed for a wavelength\n <span data-math=\"\\lambda = 4L/9\">\\lambda = 4L/9</span>? Why?",
   "answers": [
    {
     "id": 762112,
     "content_html": "The frequency formed is a harmonic and first overtone so resonance will occur."
    },
    {
     "id": 762113,
     "content_html": "The frequency formed is a harmonic and second overtone so resonance will occur."
    },
    {
     "id": 762114,
     "content_html": "The frequency formed is a harmonic and third overtone so resonance will occur."
    },
    {
     "id": 762115,
     "content_html": "The frequency formed is a harmonic and fourth overtone so resonance will occur."
    }
   ],
