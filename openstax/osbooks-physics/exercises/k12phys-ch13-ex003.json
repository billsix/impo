   "stimulus_html": "",
   "stem_html": "What is a wave?",
   "answers": [
    {
     "id": 745412,
     "content_html": "A wave is a force that propagates from the place where it was created."
    },
    {
     "id": 745413,
     "content_html": "A wave is a disturbance that propagates from the place where it was created."
    },
    {
     "id": 745411,
     "content_html": "A wave is matter that provides volume to an object."
    },
    {
     "id": 745410,
     "content_html": "A wave is matter that provides mass to an object."
    }
