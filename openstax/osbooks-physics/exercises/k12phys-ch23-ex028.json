 "questions": [
  {
   "id": 243738,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why was the existence of the charm quark speculated, even though no direct evidence of it existed?",
   "answers": [
    {
     "id": 764305,
     "content_html": "The existence of the charm quark was symmetrical with up and down quarks. Additionally, there were two known leptons at the time and only two quarks."
    },
    {
     "id": 764306,
     "content_html": "The strange particle lacked the symmetry that existed with the up and down quarks. Additionally, there were four known leptons at the time and only three quarks."
    },
    {
     "id": 764304,
     "content_html": "The bottom particle lacked the symmetry that existed with the up and down quarks. Additionally, there were two known leptons at the time and only two quarks."
    },
    {
     "id": 764303,
     "content_html": "The existence of charm quarks was symmetrical with up and down quarks. Additionally, there were four known leptons at the time and only three quarks."
    }
   ],
