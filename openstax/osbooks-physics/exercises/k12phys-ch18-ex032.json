 "questions": [
  {
   "id": 239156,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two flat pieces of aluminum foil lay one on top of the other. What happens if you add charge to the top piece of aluminum foil?",
   "answers": [
    {
     "id": 746246,
     "content_html": "The charge will distribute over the top of the top piece."
    },
    {
     "id": 746245,
     "content_html": "The charge will distribute to the bottom of the bottom piece."
    },
    {
     "id": 746244,
     "content_html": "The inner surfaces will have excess charge of the opposite sign."
    },
    {
     "id": 746247,
     "content_html": "The inner surfaces will have excess charge of the same sign."
    }
   ],
