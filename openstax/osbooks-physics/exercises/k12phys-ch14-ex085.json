     "content_html": "The frequency will become lower."
    },
    {
     "id": 761835,
     "content_html": "The frequency will be doubled."
    },
    {
     "id": 761836,
     "content_html": "The frequency will be tripled."
    },
    {
     "id": 761834,
     "content_html": "The frequency will become higher."
