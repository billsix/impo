   "stimulus_html": "",
   "stem_html": "Can all resistor combinations be reduced to series and parallel combinations?",
   "answers": [
    {
     "id": 1164304,
     "content_html": "No, all practical resistor circuits cannot be reduced to series and parallel combinations."
    },
    {
     "id": 1164303,
     "content_html": "Yes, all practical resistor circuits can be reduced to series and parallel combinations."
