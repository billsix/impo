 "questions": [
  {
   "id": 243656,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does the emission spectrum of an isolated gas differ from the emission spectrum created by a white light?",
   "answers": [
    {
     "id": 763991,
     "content_html": "White light and an emission spectrum are different varieties of continuous distribution of frequencies."
    },
    {
     "id": 763992,
     "content_html": "White light and an emission spectrum are different series of discrete frequencies."
    },
    {
     "id": 763994,
     "content_html": "White light is a continuous distribution of frequencies, and an emission spectrum is a series of discrete frequencies."
    },
    {
     "id": 763993,
     "content_html": "White light is a series of discrete frequencies, and an emission spectrum is a continuous distribution of frequencies."
    }
   ],
