 "questions": [
  {
   "id": 242950,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is a rarefaction?",
   "answers": [
    {
     "id": 761257,
     "content_html": "Rarefaction is the high-pressure region created in a medium when a longitudinal wave passes through it."
    },
    {
     "id": 761258,
     "content_html": "Rarefaction is the low-pressure region created in a medium when a longitudinal wave passes through it."
    },
    {
     "id": 761256,
     "content_html": "Rarefaction is the highest point of amplitude of a sound wave."
    },
    {
     "id": 761255,
     "content_html": "Rarefaction is the lowest point of amplitude of a sound wave."
    }
   ],
