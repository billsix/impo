 "questions": [
  {
   "id": 613791,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe time dilation and state under what conditions it becomes significant.",
   "answers": [
    {
     "id": 1163179,
     "content_html": "When the speed of one frame of reference past another reaches the speed of light, a time interval between two events at the same location in one frame appears longer when measured from the second frame."
    },
    {
     "id": 1163182,
     "content_html": "When the speed of one frame of reference past another becomes comparable to the speed of light, a time interval between two events at the same location in one frame appears longer when measured from the second frame."
    },
    {
     "id": 1163180,
     "content_html": "When the speed of one frame of reference past another reaches the speed of light, a time interval between two events at the same location in one frame appears shorter when measured from the second frame."
    },
    {
     "id": 1163181,
     "content_html": "When the speed of one frame of reference past another becomes comparable to the speed of light, a time interval between two events at the same location in one frame appears shorter when measured from the second frame."
    }
