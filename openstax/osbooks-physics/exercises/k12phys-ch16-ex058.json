 "questions": [
  {
   "id": 243346,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A farsighted person buys a pair of glasses to correct her farsightedness. Describe the main symptom of farsightedness and the type of lens that corrects it.",
   "answers": [
    {
     "id": 762787,
     "content_html": "Farsighted people cannot focus on objects that are far away, but they can see nearby objects easily. A convex lens is used to correct this."
    },
    {
     "id": 762786,
     "content_html": "Farsighted people cannot focus on objects that are close up, but they can see far-off objects easily. A concave lens is used to correct this."
    },
    {
     "id": 762788,
     "content_html": "Farsighted people cannot focus on objects that are close up, but they can see distant objects easily. A convex lens is used to correct this."
    },
    {
     "id": 762785,
     "content_html": "Farsighted people cannot focus on objects that are either close up or far away. A concave lens is used to correct this."
    }
   ],
