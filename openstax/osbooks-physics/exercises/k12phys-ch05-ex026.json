 "questions": [
  {
   "id": 613640,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are vectors used so frequently in atmospheric science?",
   "answers": [
    {
     "id": 1162587,
     "content_html": "Vectors have magnitude as well as direction and can be quickly solved through scalar algebraic operations."
    },
    {
     "id": 1162588,
     "content_html": "Vectors have magnitude but no direction, so it becomes easy to express physical quantities involved in the atmospheric science."
    },
    {
     "id": 1162589,
     "content_html": "Vectors can be solved very accurately through geometry, which helps to make better predictions in atmospheric science."
    },
    {
     "id": 1162590,
     "content_html": "Vectors have magnitude as well as direction and are used in equations that describe the three dimensional motion of the atmosphere."
    }
   ],
