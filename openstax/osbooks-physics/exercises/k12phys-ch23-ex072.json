  {
   "id": 243829,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are particles and antiparticles made to collide as shown in this image?\n<img src=\"exercises/media/c085dcb875995209.png\" alt=\"A Tevatron ring synchrotron is shown with both proton and antiproton sources emitting particles and antiparticles that travel around the ring in opposite directions before colliding in a collision detector.\">",
   "answers": [
    {
     "id": 764638,
     "content_html": "Particles and antiparticles have the same mass."
    },
    {
     "id": 764637,
     "content_html": "Particles and antiparticles have different mass."
    },
    {
     "id": 764636,
     "content_html": "Particles and antiparticles have the same charge."
    },
    {
     "id": 764635,
     "content_html": "Particles and antiparticles have opposite charges."
    }
   ],
