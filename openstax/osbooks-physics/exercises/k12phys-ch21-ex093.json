 "questions": [
  {
   "id": 243642,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare the momentums of a proton and an electron with the same energy and explain any difference.\n",
   "answers": [
    {
     "id": 763937,
     "content_html": "Their momentums are the same because they have the same energy."
    },
    {
     "id": 763938,
     "content_html": "The electron has a greater momentum than the photon; photon momentum arises from Planck’s constant which is many orders of magnitude smaller than the mass of an electron."
    },
    {
     "id": 763936,
     "content_html": "The photon has a greater momentum than the electron; photon momentum arises from the speed of light which is much faster than an electron can move."
    },
    {
     "id": 763935,
     "content_html": "The photon must have a momentum of zero because its rest mass is zero."
    }
   ],
