  {
   "id": 614045,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If, instead of a single resistor <span data-math=\"R\">R</span>, two resistors each with resistance <span data-math=\"R\">R</span> are drawn in the circuit diagram shown in the video, what can you say about the current through the circuit?",
   "answers": [
    {
     "id": 1164183,
     "content_html": "The amount of current through the circuit must decrease by half."
    },
    {
     "id": 1164180,
     "content_html": "The amount of current through the circuit must increase by half."
    },
    {
     "id": 1164181,
     "content_html": "The current must remain the same through the circuit."
    },
    {
     "id": 1164182,
     "content_html": "The amount of current through the circuit would be doubled."
    }
   ],
