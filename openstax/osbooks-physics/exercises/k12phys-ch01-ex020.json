 "questions": [
  {
   "id": 501527,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The findings of studies in quantum mechanics have been described as strange or weird compared to those of classical physics. Explain why this would be so.",
   "answers": [
    {
     "id": 985459,
     "content_html": "It is because the phenomena it explains are outside the normal range of human experience which deals with much larger objects."
    },
    {
     "id": 985460,
     "content_html": "It is because the phenomena it explains can be perceived easily, namely, ordinary-sized objects."
    },
    {
     "id": 985461,
     "content_html": "It is because the phenomena it explains are outside the normal range of human experience, namely, the very large and the very fast objects."
    },
    {
     "id": 985462,
     "content_html": "It is because the phenomena it explains can be perceived easily, namely, the very large and the very fast objects."
    }
