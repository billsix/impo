 "questions": [
  {
   "id": 243780,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why it is not possible to find a particle composed of just two quarks.",
   "answers": [
    {
     "id": 764460,
     "content_html": "A particle composed of two quarks will have an integral charge and a white color. Hence, it cannot exist."
    },
    {
     "id": 764459,
     "content_html": "A particle composed of two quarks will have an integral charge and a color that is not white. Hence, it cannot exist."
    },
    {
     "id": 764458,
     "content_html": "A particle composed of two quarks will have a fractional charge and a white color. Hence, it cannot exist."
    },
    {
     "id": 764461,
     "content_html": "A particle composed of two quarks will have a fractional charge and a color that is not white. Hence, it cannot exist."
    }
   ],
