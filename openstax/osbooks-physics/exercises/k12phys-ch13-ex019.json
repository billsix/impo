   "stem_html": "How is sound produced by an electronic speaker?",
   "answers": [
    {
     "id": 745545,
     "content_html": "The cone of a speaker vibrates to create small changes in the temperature of the air."
    },
    {
     "id": 745548,
     "content_html": "The cone of a speaker vibrates to create small changes in the pressure of the air."
    },
    {
     "id": 745546,
     "content_html": "The cone of a speaker vibrates to create small changes in the volume of the air."
    },
    {
     "id": 745547,
     "content_html": "The cone of a speaker vibrates to create small changes in the resistance of the air."
    }
