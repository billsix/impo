 "questions": [
  {
   "id": 243511,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the form of a blackbody radiation curve if all frequencies of light were emitted with equal probability. \n",
   "answers": [
    {
     "id": 763444,
     "content_html": "The curve would appear as a Gaussian probability distribution with a large peak in the middle."
    },
    {
     "id": 763443,
     "content_html": "The curve would appear as a vertical line."
    },
    {
     "id": 763445,
     "content_html": "The curve would appear as a horizontal line."
    },
    {
     "id": 763442,
     "content_html": "The curve would appear as a diagonal line correlating intensity to frequency at a 1:1 ratio."
    }
   ],
