 "questions": [
  {
   "id": 504253,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Maud sends her bowling ball straight down the center of the lane, getting a strike. The ball is brought back to the holder mechanically. What are the ball’s net displacement and distance traveled?",
   "answers": [
    {
     "id": 991657,
     "content_html": "Displacement of the ball is twice the length of the lane, while the distance is zero."
    },
    {
     "id": 991658,
     "content_html": "Displacement of the ball is zero, while the distance is twice the length of the lane."
    },
    {
     "id": 991659,
     "content_html": "Both the displacement and distance for the ball are equal to zero."
    },
    {
     "id": 991660,
     "content_html": "Both the displacement and distance for the ball are twice the length of the lane."
    }
   ],
