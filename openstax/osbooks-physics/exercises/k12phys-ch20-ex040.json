 "questions": [
  {
   "id": 239546,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Given a bar magnet, how can you induce an electric current in a wire loop?",
   "answers": [
    {
     "id": 747713,
     "content_html": "An electric current is induced if a bar magnet is placed near the wire loop."
    },
    {
     "id": 747712,
     "content_html": "An electric current is induced if a wire loop is wound around the bar magnet."
    },
    {
     "id": 747714,
     "content_html": "An electric current is induced if a bar magnet is moved through the wire loop."
    },
    {
     "id": 747711,
     "content_html": "An electric current is induced if a bar magnet is placed in contact with the wire loop."
    }
   ],
