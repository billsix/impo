   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In a coordinate system in which the direction to the right is positive, what are the distance and displacement of a person who walks <span data-math=\"35\\,\\text{meters}\">35\\,\\text{meters}</span> to the left, <span data-math=\"18\\,\\text{meters}\">18\\,\\text{meters}</span> to the right, and then <span data-math=\"26\\,\\text{meters}\">26\\,\\text{meters}</span> to the left?",
   "answers": [
    {
     "id": 1162175,
     "content_html": "Distance is <span data-math=\"79\\,\\text{m}\">79\\,\\text{m}</span> and displacement is <span data-math=\"{-43}\\,\\text{m}\">{-43}\\,\\text{m}</span>."
    },
    {
