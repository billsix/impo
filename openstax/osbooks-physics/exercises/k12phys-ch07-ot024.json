  {
   "id": 537640,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why a star on the other side of the Sun might appear to be in a location that is not its true location.",
   "answers": [
    {
     "id": 1056523,
     "content_html": "It can be explained by using the concept of atmospheric refraction."
    },
    {
     "id": 1056524,
     "content_html": "It can be explained by using the concept of the special theory of relativity."
    },
    {
     "id": 1056525,
     "content_html": "It can be explained by using the concept of the general theory of relativity."
    },
    {
     "id": 1056526,
     "content_html": "It can be explained by using the concept of light scattering in the atmosphere."
    }
