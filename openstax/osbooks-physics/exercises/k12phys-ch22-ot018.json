   "id": 243678,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Aside from energy yield, why are nuclear fusion reactors more desirable than nuclear fission reactors?",
   "answers": [
    {
     "id": 764077,
     "content_html": "Nuclear fusion reactors have a low installation cost."
    },
    {
     "id": 764076,
     "content_html": "Radioactive waste is greater for a fusion reactor."
    },
    {
     "id": 764075,
     "content_html": "Nuclear fusion reactors are easy to design and build."
    },
    {
     "id": 764078,
     "content_html": "A fusion reactor produces less radioactive waste."
    }
   ],
