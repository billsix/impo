 "questions": [
  {
   "id": 531243,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A person tries to lift a stone by using a lever. If the lever arm is constant and the mass of the stone increases, what is true of the torque necessary to lift it?",
   "answers": [
    {
     "id": 1039804,
     "content_html": "It increases, because the torque is directly proportional to the mass of the body."
    },
    {
     "id": 1039805,
     "content_html": "It increases because the torque is inversely proportional to the mass of the body."
    },
    {
     "id": 1039806,
     "content_html": "It decreases because the torque is directly proportional to the mass of the body."
    },
    {
     "id": 1039807,
     "content_html": "It decreases, because the torque is inversely proportional to the mass of the body."
    }
   ],
