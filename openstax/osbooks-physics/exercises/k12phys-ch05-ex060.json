 "questions": [
  {
   "id": 613644,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two identical items, object 1 and object 2, are dropped from the top of a <span data-math=\"50.0\\,\\text{m}\">50.0\\,\\text{m}</span> building. Object 1 is dropped with an initial velocity of <span data-math=\"0\\,\\text{m/s}\">0\\,\\text{m/s}</span>, while object 2 is thrown straight downward with an initial velocity of <span data-math=\"13.0\\,\\text{m/s}\">13.0\\,\\text{m/s}</span>. What is the difference in time, in seconds rounded to the nearest tenth, between when the two objects hit the ground?",
   "answers": [
    {
     "id": 1162605,
     "content_html": "Object 1 will hit the ground <span data-math=\"3.2\\,\\text{s}\">3.2\\,\\text{s}</span> after object 2."
    },
    {
     "id": 1162604,
     "content_html": "Object 1 will hit the ground <span data-math=\"2.1\\,\\text{s}\">2.1\\,\\text{s}</span> after object 2."
    },
    {
     "id": 1162603,
     "content_html": "Object 1 will hit the ground at the same time as object 2."
    },
    {
     "id": 1162606,
     "content_html": "Object 1 will hit the ground <span data-math=\"1.1\\,\\text{s}\">1.1\\,\\text{s}</span> after object 2."
    }
   ],
