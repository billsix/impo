 "questions": [
  {
   "id": 530851,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can you maximize the torque applied to a given lever arm without applying more force?",
   "answers": [
    {
     "id": 1038728,
     "content_html": "The force should be applied perpendicularly to the lever arm as close as possible from the pivot point."
    },
    {
     "id": 1038729,
     "content_html": "The force should be applied perpendicularly to the lever arm as far as possible from the pivot point."
    },
    {
     "id": 1038730,
     "content_html": "The force should be applied parallel to the lever arm as far as possible from the pivot point."
    },
    {
     "id": 1038731,
     "content_html": "The force should be applied parallel to the lever arm as close as possible from the pivot point."
    }
   ],
