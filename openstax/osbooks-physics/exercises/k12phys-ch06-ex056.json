 "questions": [
  {
   "id": 613702,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "As the mass of an object in uniform circular motion increases, what happens to the centripetal force required to keep it moving at the same speed?",
   "answers": [
    {
     "id": 1162833,
     "content_html": "It increases, because the centripetal force is directly proportional to the mass of the rotating body."
    },
    {
     "id": 1162832,
     "content_html": "It increases, because the centripetal force is inversely proportional to the mass of the rotating body."
    },
    {
     "id": 1162831,
     "content_html": "It decreases, because the centripetal force is directly proportional to the mass of the rotating body."
    },
    {
     "id": 1162830,
     "content_html": "It decreases, because the centripetal force is inversely proportional to the mass of the rotating body."
    }
   ],
