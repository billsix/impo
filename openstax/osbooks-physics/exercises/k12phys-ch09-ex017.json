 "questions": [
  {
   "id": 537231,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "You start at the top of a hill on a bicycle and coast to the bottom without applying the brakes. By the time you reach the bottom of the hill, work has been done on you and your bicycle, according to the equation:\n<span data-math=\"W = \\frac{1}{2}m(v_2^{\\,2} - v_1^{\\,2})\">W = \\frac{1}{2}m(v_2^{\\,2} - v_1^{\\,2})</span>\nIf <span data-math=\"m\">m</span> is the mass of you and your bike, what are <span data-math=\"{v_1}\\!\">{v_1}\\!</span> and <span data-math=\"{v_2}\">{v_2}</span>?",
   "answers": [
    {
     "id": 1055057,
     "content_html": "<span data-math=\"{v_1}\">{v_1}</span> is your speed at the top of the hill, and <span data-math=\"{v_2}\">{v_2}</span> is your speed at the bottom."
    },
    {
     "id": 1055058,
     "content_html": "<span data-math=\"{v_1}\">{v_1}</span> is your speed at the bottom of the hill, and <span data-math=\"{v_2}\">{v_2}</span> is your speed at the top."
    },
    {
     "id": 1055059,
     "content_html": "<span data-math=\"{v_1}\">{v_1}</span> is your displacement at the top of the hill, and <span data-math=\"{v_2}\">{v_2}</span> is your displacement at the bottom."
    },
    {
     "id": 1055060,
     "content_html": "<span data-math=\"{v_1}\">{v_1}</span> is your displacement at the bottom of the hill, and <span data-math=\"{v_2}\">{v_2}</span> is your displacement at the top."
    }
   ],
