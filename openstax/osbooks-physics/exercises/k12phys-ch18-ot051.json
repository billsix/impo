  {
   "id": 239192,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A negative lightning strike occurs when a negatively charged cloud discharges its excess electrons to the positively charged ground. If you observe a cloud-to-cloud lightning strike, what can you say about the charge on the area of the cloud struck by lightning?",
   "answers": [
    {
     "id": 746382,
     "content_html": "The area of the cloud that was struck by lightning had a positive charge."
    },
    {
     "id": 746381,
     "content_html": "The area of the cloud that was struck by lightning had a negative charge."
    },
    {
     "id": 746380,
     "content_html": "The area of the cloud that was struck by lightning is neutral."
    },
    {
     "id": 746379,
     "content_html": "The area of the cloud that was struck by lightning had a third type of charge."
    }
   ],
