 "questions": [
  {
   "id": 243055,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do some smaller instruments, such as piccolos, produce higher-pitched sounds than larger instruments, such as tubas?",
   "answers": [
    {
     "id": 761658,
     "content_html": "Smaller instruments produce sounds with shorter wavelengths, and thus higher frequencies."
    },
    {
     "id": 761657,
     "content_html": "Smaller instruments produce longer wavelength, and thus higher amplitude, sounds."
    },
    {
     "id": 761656,
     "content_html": "Smaller instruments produce lower amplitude, and thus longer wavelength sounds."
    },
    {
     "id": 761655,
     "content_html": "Smaller instruments produce higher amplitude, and thus lower frequency, sounds."
    }
   ],
