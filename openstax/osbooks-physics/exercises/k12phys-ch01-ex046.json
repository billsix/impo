  {
   "id": 501812,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A friend tells you that a scientific law cannot be changed. State whether or not your friend is correct and then briefly explain your answer.",
   "answers": [
    {
     "id": 986405,
     "content_html": "Correct, because laws are theories that have been proved true."
    },
    {
     "id": 986406,
     "content_html": "Correct, because theories are laws that have been proved true."
    },
    {
     "id": 986407,
     "content_html": "Incorrect, because a law is changed if new evidence contradicts it."
    },
    {
     "id": 986408,
     "content_html": "Incorrect, because a law is changed when a theory contradicts it."
    }
