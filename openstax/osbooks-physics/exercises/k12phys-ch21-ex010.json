   "id": 243480,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Your pupils dilate when visible light intensity is reduced. Does wearing sunglasses that lack UV blockers increase or decrease the UV hazard to your eyes? Explain.",
   "answers": [
    {
     "id": 763321,
     "content_html": "Increase, because more high-energy UV photons can enter the eye."
    },
    {
     "id": 763320,
     "content_html": "Increase, because less high-energy UV photons can enter the eye."
    },
    {
     "id": 763319,
     "content_html": "Decrease, because more high-energy UV photons can enter the eye."
    },
    {
     "id": 763318,
     "content_html": "Decrease, because less high-energy UV photons can enter the eye."
    }
