 "questions": [
  {
   "id": 501661,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the difference between an observation and a hypothesis.",
   "answers": [
    {
     "id": 985953,
     "content_html": "An observation is seeing what happens; a hypothesis is a testable, educated guess."
    },
    {
     "id": 985954,
     "content_html": "An observation is a hypothesis that has been confirmed."
    },
    {
     "id": 985955,
     "content_html": "Hypotheses and observations are independent of each other."
    },
    {
     "id": 985956,
     "content_html": "Hypotheses are conclusions based on some observations."
    }
   ],
