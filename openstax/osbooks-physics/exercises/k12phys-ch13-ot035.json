   "stem_html": "What is the relation between the amplitude of a wave and its speed?",
   "answers": [
    {
     "id": 745661,
     "content_html": "The amplitude of a wave is independent of its speed."
    },
    {
     "id": 745660,
     "content_html": "The amplitude of a wave is directly proportional to its speed."
    },
    {
     "id": 745659,
     "content_html": "The amplitude of a wave is directly proportional to the square of the inverse of its speed."
    },
