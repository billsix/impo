   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are different radiopharmaceuticals used to image different parts of the body?",
   "answers": [
    {
     "id": 764085,
     "content_html": "The different radiopharmaceuticals travel through different blood vessels."
    },
    {
     "id": 764086,
     "content_html": "The different radiopharmaceuticals travel to different parts of the body."
    },
    {
     "id": 764084,
     "content_html": "The different radiopharmaceuticals are used to treat different diseases of the body."
    },
    {
     "id": 764083,
     "content_html": "The different radiopharmaceuticals produce different amounts of ionizing radiation."
    }
