 "questions": [
  {
   "id": 239045,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is refraction?",
   "answers": [
    {
     "id": 745859,
     "content_html": "Refraction is the phenomenon in which waves change their path of propagation at the interface of two media with different densities."
    },
    {
     "id": 745858,
     "content_html": "Refraction is the phenomenon in which waves change their path of propagation at the interface of two media with the same density."
    },
    {
     "id": 745857,
     "content_html": "Refraction is the phenomenon in which waves become non-periodic at the boundary of two media with different densities."
    },
    {
     "id": 745856,
     "content_html": "Refraction is the phenomenon in which waves become non-periodic at the boundary of two media with the same density."
    }
