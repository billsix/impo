 "questions": [
  {
   "id": 239441,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why the equivalent resistance of a parallel combination of resistors is always less than the smallest of the parallel resistors.",
   "answers": [
    {
     "id": 747328,
     "content_html": "Adding resistors in parallel gives the current a shorter path through which it can flow, hence decreasing the overall resistance."
    },
    {
     "id": 747329,
     "content_html": "Adding resistors in parallel gives the current another path through which it can flow, hence decreasing the overall resistance."
    },
    {
     "id": 747327,
     "content_html": "Adding resistors in parallel reduce the number of paths through which the current can flow, hence decreasing the overall resistance."
    },
    {
     "id": 747326,
     "content_html": "Adding resistors in parallel gives the current a longer path through which it can flow, hence decreasing the overall resistance."
    }
   ],
