 "questions": [
  {
   "id": 504233,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Can one-dimensional motion be described with a zero distance traveled but nonzero displacement. Conversely, can it be described with zero displacement but a nonzero distance traveled?",
   "answers": [
    {
     "id": 991577,
     "content_html": "One-dimensional motion can have zero distance traveled with a nonzero displacement. Displacement has both magnitude and direction; it can also have zero displacement with nonzero distance traveled because distance traveled has only magnitude."
    },
    {
     "id": 991578,
     "content_html": "One-dimensional motion can have zero distance traveled with a nonzero displacement. Displacement has both magnitude and direction, but it cannot have zero displacement with nonzero distance traveled because distance has only magnitude."
    },
    {
     "id": 991579,
     "content_html": "One-dimensional motion cannot have zero distance traveled with a nonzero displacement. Displacement has both magnitude and direction, but it can have zero displacement with nonzero distance traveled because distance has only magnitude and any motion will be the distance it moves."
    },
    {
     "id": 991580,
     "content_html": "One-dimensional motion cannot have zero distance traveled with a nonzero displacement. Displacement has both magnitude and direction; it cannot have zero displacement with nonzero distance traveled because distance has only magnitude."
    }
   ],
