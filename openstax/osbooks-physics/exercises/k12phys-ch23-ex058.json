   "id": 243805,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How are the four fundamental forces incorporated into the Standard Model of the atom?",
   "answers": [
    {
     "id": 764546,
     "content_html": "The four fundamental forces are represented by their carrier particles, the electrons."
    },
    {
     "id": 764549,
     "content_html": "The four fundamental forces are represented by their carrier particles, the gauge bosons."
    },
    {
     "id": 764547,
     "content_html": "The four fundamental forces are represented by their carrier particles, the leptons."
    },
    {
     "id": 764548,
     "content_html": "The four fundamental forces are represented by their carrier particles, the quarks."
    }
