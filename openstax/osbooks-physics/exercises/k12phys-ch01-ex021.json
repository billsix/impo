 "questions": [
  {
   "id": 613511,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How could knowledge of physics help you find a faster way to drive from your house to your school?",
   "answers": [
    {
     "id": 1162086,
     "content_html": "Physics can explain the traffic on a particular street and help us know about the traffic in advance."
    },
    {
     "id": 1162085,
     "content_html": "Physics can explain about the ongoing construction of roads on a particular street and help us know about delays in the traffic in advance."
    },
    {
     "id": 1162087,
     "content_html": "Physics can explain distances, speed limits on a particular street and help us categorize faster routes."
    },
    {
     "id": 1162084,
     "content_html": "Physics can explain the closing of a particular street and help us categorize faster routes."
    }
   ],
