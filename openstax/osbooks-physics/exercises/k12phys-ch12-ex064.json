 "questions": [
  {
   "id": 613953,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the entropy of a system depend on how the system reaches a given state?",
   "answers": [
    {
     "id": 1163824,
     "content_html": "Entropy depends on the change of phase of a system, but not on any other state conditions."
    },
    {
     "id": 1163825,
     "content_html": "Entropy does not depend on how the final state is reached from the initial state."
    },
    {
     "id": 1163823,
     "content_html": "Entropy is least when the path between the initial state and the final state is the shortest."
    },
    {
     "id": 1163822,
     "content_html": "Entropy is least when the path between the initial state and the final state is the longest."
    }
   ],
