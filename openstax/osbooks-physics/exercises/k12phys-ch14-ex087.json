  {
   "id": 243104,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A source of sound is moving towards you. How will what you hear change if the speed of the source increases?",
   "answers": [
    {
     "id": 761842,
     "content_html": "The sound will become more high-pitched."
    },
    {
     "id": 761841,
     "content_html": "The sound will become more low-pitched."
    },
    {
     "id": 761840,
     "content_html": "The pitch of the sound will not change."
    }
   ],
