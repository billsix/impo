 "questions": [
  {
   "id": 243266,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An object is placed in front of a concave mirror at a distance that is greater than the focal length of the mirror. Will the image produced by the mirror be real or virtual? Will it be erect or inverted?",
   "answers": [
    {
     "id": 762471,
     "content_html": "It is real and erect."
    },
    {
     "id": 762472,
     "content_html": "It is real and inverted."
    },
    {
     "id": 762470,
     "content_html": "It is virtual and inverted."
    },
    {
     "id": 762469,
     "content_html": "It is virtual and erect."
    }
   ],
