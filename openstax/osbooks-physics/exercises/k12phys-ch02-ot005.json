 "questions": [
  {
   "id": 510830,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is it important to specify a reference frame when describing motion?",
   "answers": [
    {
     "id": 999344,
     "content_html": "Because Earth is continuously in motion; an object at rest on Earth will be in motion when viewed from outer space."
    },
    {
     "id": 999345,
     "content_html": "Because the position of a moving object can be defined only when there is a fixed reference frame."
    },
    {
     "id": 999346,
     "content_html": "Because motion is a relative term; it appears differently when viewed from different reference frames."
    },
    {
     "id": 999347,
     "content_html": "Because motion is always described in Earth’s frame of reference; if another frame is used, it has to be specified with each situation."
    }
   ],
