   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: Voltage.\n\nThis video explains the difference between electrical potential, or voltage, and electrical potential energy.\n\n<iframe src=\"https://www.openstaxcollege.org/l/02voltage\"></iframe>",
