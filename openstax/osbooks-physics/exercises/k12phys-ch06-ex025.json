 "questions": [
  {
   "id": 522530,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "As the angular velocity of an object increases, what happens to the linear velocity of a point on that object?",
   "answers": [
    {
     "id": 1022995,
     "content_html": "It increases, because linear velocity is directly proportional to angular velocity."
    },
    {
     "id": 1022996,
     "content_html": "It increases, because linear velocity is inversely proportional to angular velocity."
    },
    {
     "id": 1022997,
     "content_html": "It decreases because linear velocity is directly proportional to angular velocity."
    },
    {
     "id": 1022998,
     "content_html": "It decreases because linear velocity is inversely proportional to angular velocity."
    }
   ],
