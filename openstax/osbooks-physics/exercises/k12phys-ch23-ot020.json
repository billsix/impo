 "questions": [
  {
   "id": 614242,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare the total strong nuclear force in a lithium atom to the total strong nuclear force in a lithium ion <span data-math=\"(\\text{Li}^{+1})\">(\\text{Li}^{+1})</span>.",
   "answers": [
    {
     "id": 1164948,
     "content_html": "The total strong nuclear force in a lithium atom is thrice the total strong nuclear force in a lithium ion."
    },
    {
     "id": 1164947,
     "content_html": "The total strong nuclear force in a lithium atom is twice the total strong nuclear force in a lithium ion."
    },
    {
     "id": 1164949,
     "content_html": "The total strong nuclear force in a lithium atom is the same as the total strong nuclear force in a lithium ion."
    },
    {
     "id": 1164946,
     "content_html": "The total strong nuclear force in a lithium atom is half the total strong nuclear force in a lithium ion."
    }
   ],
