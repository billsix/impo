 "questions": [
  {
   "id": 243196,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A dog would have a hard time stalking and catching a red bird hiding in a field of green grass. Explain this in terms of cone cells and color perception.",
   "answers": [
    {
     "id": 762192,
     "content_html": "Dogs are red-green color-blind because they can see only blue and yellow through two kinds of cone cells present in their eyes."
    },
    {
     "id": 762191,
     "content_html": "Dogs are only red color-blind because they can see only blue and yellow through two kinds of cones cells present in their eyes."
    },
    {
     "id": 762190,
     "content_html": "Dogs are only green color-blind because they can see only blue and yellow through two kinds of cones cells present in their eyes."
    },
    {
     "id": 762189,
     "content_html": "Dogs are color-blind because they have only rods and no cone cells present in their eyes."
    }
   ],
