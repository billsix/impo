 "questions": [
  {
   "id": 243305,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why the index of refraction is always greater than or equal to one.",
   "answers": [
    {
     "id": 762627,
     "content_html": "The formula for index of refraction, <span data-math=\"\\text{n}\">\\text{n}</span>, of a material is \n <span data-math=\"n = \\frac{\\text{speed of light in a material}}{\\text{speed of\n light in a vacuum}} = \\frac{v}{c},\">n = \\frac{\\text{speed of light in a material}}{\\text{speed of\n light in a vacuum}} = \\frac{v}{c},</span>\n where <span data-math=\"\\text{v} > \\text{c}\">\\text{v} &gt; \\text{c}</span>, so <span data-math=\"\\text{n}\">\\text{n}</span> is always greater than one."
    },
    {
     "id": 762628,
     "content_html": "The formula for index of refraction, <span data-math=\"\\text{n}\">\\text{n}</span>, of a material is \n <span data-math=\"n = \\frac{\\text{speed of light in a vacuum}}{\\text{speed of light\n in a material}} = \\frac{c}{v},\">n = \\frac{\\text{speed of light in a vacuum}}{\\text{speed of light\n in a material}} = \\frac{c}{v},</span>\n where <span data-math=\"\\text{c} > \\text{v}\">\\text{c} &gt; \\text{v}</span>, so <span data-math=\"\\text{n}\">\\text{n}</span> is always greater than one."
    },
    {
     "id": 762626,
     "content_html": "The formula for index of refraction, <span data-math=\"\\text{n}\">\\text{n}</span>, of a material is \n <span data-math=\"n = \\text{speed of light in a vacuum} \\times \\text{speed of light in a materaial}\">n = \\text{speed of light in a vacuum} \\times \\text{speed of light in a materaial}</span>\n <span data-math=\"= c \\times v,\">= c \\times v,</span>\n where <span data-math=\"\\text{c}\">\\text{c}</span>, <span data-math=\"\\text{v} > 1\">\\text{v} &gt; 1</span>, so <span data-math=\"\\text{n}\">\\text{n}</span> is always greater than one."
    },
    {
     "id": 762625,
     "content_html": "The formula for refractive index, <span data-math=\"\\text{n}\">\\text{n}</span>, of a material is \n <span data-math=\"n = \\frac{1}{\\text{speed of light in a vacuum} \\times \\text{speed\n of light in a material}} = \\frac{1}{c \\times v},\">n = \\frac{1}{\\text{speed of light in a vacuum} \\times \\text{speed\n of light in a material}} = \\frac{1}{c \\times v},</span> where <span data-math=\"% <![CDATA[\n\\text{c} < \\text{v} < 1 %]]>\">% </span>, so <span data-math=\"\\text{n}\">\\text{n}</span> is always greater than one."
    }
   ],
