 "questions": [
  {
   "id": 243812,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When a star erupts in a supernova explosion, huge numbers of electron neutrinos are formed in nuclear reactions. Such neutrinos from the 1987A supernova in the relatively nearby Magellanic Cloud were observed within hours of the initial brightening, indicating that they traveled to earth at approximately the speed of light. Explain how this data can be used to set an upper limit on the mass of the neutrino.",
   "answers": [
    {
     "id": 764576,
     "content_html": "If the velocity of the neutrino is known, then the upper limit on mass of the neutrino can be set."
    },
    {
     "id": 764575,
     "content_html": "If only the kinetic energy of the neutrino is known, then the upper limit on mass of the neutrino can be set."
    },
    {
     "id": 764574,
     "content_html": "If either the velocity or the kinetic energy is known, then the upper limit on the mass of the neutrino can be set."
    },
    {
     "id": 764577,
     "content_html": "If both the kinetic energy and the velocity of the neutrino are known, then the upper limit on the mass of the neutrino can be set."
    }
   ],
