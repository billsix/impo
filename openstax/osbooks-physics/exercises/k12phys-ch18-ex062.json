 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"eip-165\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\"><span class=\"os-title-label\">PhET Explorations</span></h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"8\" class=\"os-subtitle\"><span class=\"os-subtitle-label\">PhET Explorations: Charges and Fields</span></h4>\n<p id=\"eip-id1492218\" class=\" \">Move point charges around on the playing field and then view the electric field, voltages, equipotential lines, and more. It's colorful, it's dynamic, it's free. </p>\n\n<div class=\"os-figure\">\n<figure id=\"fs-id1172487051643\"><div data-type=\"media\" id=\"fs-id1167066831384\" data-alt=\"This simulation allows you to arrange positive and negative charges in space and view the resulting electric field and electrostatic potential.\">\n<div data-type=\"alternatives\" class=\"os-has-iframe os-has-link\">\n<a class=\"os-is-link\" target=\"_window\" href=\"https://openstax.org/l/28charge-field\">Click to view content</a><iframe width=\"660\" height=\"371.4\" src=\"https://openstax.org/l/28charge-field\" class=\"os-is-iframe\"><!-- no-selfclose --></iframe>\n</div>\n</div>\n</figure><div class=\"os-caption-container\">\n<span class=\"os-title-label\">Figure </span><span class=\"os-number\">18.26</span><span class=\"os-divider\"> </span>\n</div>\n</div>\n</div>\n</div>\n",
 "stimulus_html": "",
 "questions": [
  {
   "id": 239202,
   "is_answer_order_important": true,
   "stimulus_html": "PhET Explorations: Charges and Fields.\n\nMove point charges around on the playing field and then view the electric field, voltages, equipotential lines, and more.\n\n<iframe src=\"https://openstax.org/l/28charge-field\"></iframe>",
   "stem_html": "Two positive charges are placed on a screen. Which statement describes the electric field produced by the charges?",
   "answers": [
    {
     "id": 746417,
     "content_html": "It is constant everywhere."
    },
    {
     "id": 746416,
     "content_html": "It is zero near each charge."
    },
    {
     "id": 746418,
     "content_html": "It is zero halfway between the charges."
    },
    {
     "id": 746415,
     "content_html": "It is strongest halfway between the charges."
    }
   ],
