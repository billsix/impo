 "questions": [
  {
   "id": 243711,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens to the rate of voltage oscillation within a synchrotron each time the particle completes a loop?",
   "answers": [
    {
     "id": 764204,
     "content_html": "The rate of voltage oscillation increases as the particle travels faster and faster on each loop."
    },
    {
     "id": 764203,
     "content_html": "The rate of voltage oscillation decreases as the particle travels faster and faster on each loop."
    },
    {
     "id": 764202,
     "content_html": "The rate of voltage oscillation remains the same each time the particle completes a loop."
    },
    {
     "id": 764201,
     "content_html": "The rate of voltage oscillation first increases and then remains constant each time the particle completes a loop."
    }
   ],
