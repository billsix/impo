   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is “timbre” of sound?",
   "answers": [
    {
     "id": 761529,
     "content_html": "Timbre is the quality of the sound that distinguishes it from other sound"
    },
    {
     "id": 761528,
     "content_html": "Timbre is the loudness of the sound that distinguishes it from other sound."
    },
    {
     "id": 761527,
     "content_html": "Timbre is the pitch of the sound that distinguishes it from other sound."
    },
    {
     "id": 761526,
     "content_html": "Timbre is the wavelength of the sound that distinguishes it from other sound."
    }
