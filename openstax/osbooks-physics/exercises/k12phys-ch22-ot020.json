  {
   "id": 243681,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is radioactive iodine used to monitor the thyroid?",
   "answers": [
    {
     "id": 764087,
     "content_html": "Radioactive iodine can be used by the thyroid while absorbing information about the thyroid."
    },
    {
     "id": 764090,
     "content_html": "Radioactive iodine can be used by the thyroid while emitting information about the thyroid."
    },
    {
     "id": 764088,
     "content_html": "Radioactive iodine can be secreted by the thyroid while absorbing information about the thyroid."
    },
    {
     "id": 764089,
     "content_html": "Radioactive iodine can be secreted by the thyroid while emitting information about the thyroid."
    }
