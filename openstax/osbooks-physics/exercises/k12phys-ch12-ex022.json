  {
   "id": 238768,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are the ways to add energy to or remove energy from a system?",
   "answers": [
    {
     "id": 744799,
     "content_html": "Transferring energy by heat is the only way to add energy to or remove energy from a system."
    },
    {
     "id": 744798,
     "content_html": "Doing compression work is the only way to add energy to or remove energy from a system."
    },
    {
     "id": 744797,
     "content_html": "Doing expansion work is the only way to add energy to or remove energy from a system."
    },
    {
     "id": 744800,
     "content_html": "Transferring energy by heat or by doing work are the ways to add energy to or remove energy from a system."
    }
   ],
