 "questions": [
  {
   "id": 243732,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does the discussion of carrier particles relate to the concept of relativity?",
   "answers": [
    {
     "id": 764281,
     "content_html": "Calculations of mass and energy during their transfer are relativistic, because carrier particles travel more slowly than the speed of sound."
    },
    {
     "id": 764282,
     "content_html": "Calculations of mass and energy during their transfer are relativistic, because carrier particles travel at or near the speed of light."
    },
    {
     "id": 764280,
     "content_html": "Calculations of mass and energy during their transfer are relativistic, because carrier particles travel at or near the speed of sound."
    },
    {
     "id": 764279,
     "content_html": "Calculations of mass and energy during their transfer are relativistic, because carrier particles travel faster than the speed of light."
    }
   ],
