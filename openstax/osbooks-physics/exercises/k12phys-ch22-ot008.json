   "stimulus_html": "",
   "stem_html": "Describe the shape of the electron cloud, based on total energy levels, for an atom with electrons in multiple orbital states.",
   "answers": [
    {
     "id": 764024,
     "content_html": "There are multiple regions of high electron probability of various shapes surrounding the nucleus."
    },
    {
     "id": 764023,
     "content_html": "There is a single solid spherical region of high electron probability surrounding the nucleus."
    },
    {
     "id": 764022,
     "content_html": "There are multiple concentric shells of high electron probability surrounding the nucleus."
    },
