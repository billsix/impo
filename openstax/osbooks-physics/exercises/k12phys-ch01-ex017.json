   "stimulus_html": "",
   "stem_html": "Describe the aims of physics.",
   "answers": [
    {
     "id": 1162083,
     "content_html": "Physics aims to explain the fundamental aspects of our universe and how these aspects interact with one another."
    },
    {
     "id": 1162082,
     "content_html": "Physics aims to explain the biological aspects of our universe and how these aspects interact with one another."
    },
    {
     "id": 1162081,
     "content_html": "Physics aims to explain the composition, structure and changes in matter occurring in the universe."
    },
    {
     "id": 1162080,
     "content_html": "Physics aims to explain the social behavior of living beings in the universe."
    }
