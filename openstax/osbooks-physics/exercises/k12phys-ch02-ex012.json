 "questions": [
  {
   "id": 504231,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement correctly describes a race car's distance traveled and magnitude of displacement during a one-lap car race around an oval track?",
   "answers": [
    {
     "id": 991569,
     "content_html": "The perimeter of the race track is the distance; the shortest distance between the start line and the finish line is the magnitude of displacement."
    },
    {
     "id": 991570,
     "content_html": "The perimeter of the race track is the magnitude of displacement; the shortest distance between the start and finish line is the distance."
    },
    {
     "id": 991571,
     "content_html": "The perimeter of the race track is both the distance and magnitude of displacement."
    },
    {
     "id": 991572,
     "content_html": "The shortest distance between the start and the finish line is the magnitude of the displacement vector."
    }
   ],
