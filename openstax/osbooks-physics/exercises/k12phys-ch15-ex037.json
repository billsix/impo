 "questions": [
  {
   "id": 243248,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is it about the nature of light reflected from snow that causes skiers to wear polarized sunglasses?",
   "answers": [
    {
     "id": 762399,
     "content_html": "The reflected light is polarized in the vertical direction."
    },
    {
     "id": 762400,
     "content_html": "The reflected light is polarized in the horizontal direction."
    },
    {
     "id": 762398,
     "content_html": "The reflected light has less intensity than the incident light."
    },
    {
     "id": 762397,
     "content_html": "The reflected light has triple the intensity of the incident light."
    }
   ],
