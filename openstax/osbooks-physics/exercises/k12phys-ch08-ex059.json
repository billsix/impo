   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A driver sees another car approaching him from behind. He fears it is going to collide with his car. Should he speed up or slow down in order to reduce damage?",
   "answers": [
    {
     "id": 1052733,
     "content_html": "He should speed up."
    },
    {
     "id": 1052734,
     "content_html": "He should slow down."
    },
    {
     "id": 1052735,
     "content_html": "He should speed up and then slow down just before the collision."
    },
    {
     "id": 1052736,
     "content_html": "He should slow down and then speed up just before the collision."
    }
