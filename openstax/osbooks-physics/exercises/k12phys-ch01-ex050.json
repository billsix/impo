 "questions": [
  {
   "id": 501894,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would play the most important role in leading to an experiment in the scientific world becoming a scientific law?",
   "answers": [
    {
     "id": 986693,
     "content_html": "Further testing would need to show it is a universally followed rule."
    },
    {
     "id": 986694,
     "content_html": "The observation would have to be described in a published scientific article."
    },
    {
     "id": 986695,
     "content_html": "The experiment would have to be repeated once or twice."
    },
    {
     "id": 986696,
     "content_html": "The observer would need to be a well-known scientist whose authority was accepted."
    }
   ],
