 "questions": [
  {
   "id": 504040,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Briefly describe the target patterns for accuracy and precision and explain the differences between the two.",
   "answers": [
    {
     "id": 990817,
     "content_html": "Precision states how much repeated measurements generate the same or closely similar results, while accuracy states how close a measurement is to the true value of the measurement."
    },
    {
     "id": 990818,
     "content_html": "Precision states how close a measurement is to the true value of the measurement, while accuracy states how much repeated measurements generate the same or closely similar result."
    },
    {
     "id": 990819,
     "content_html": "Precision and accuracy are the same thing. They state how much repeated measurements generate the same or closely similar results."
    },
    {
     "id": 990820,
     "content_html": "Precision and accuracy are the same thing. They state how close a measurement is to the true value of the measurement."
    }
