 "questions": [
  {
   "id": 614096,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "With the north pole to the left and moving the magnet from right to left, a positive voltage is produced as the magnet enters the coil. What sign voltage will be produced if the experiment is repeated with the south pole to the left?",
   "answers": [
    {
     "id": 1164375,
     "content_html": "The sign of voltage will change because the direction of current flow will change by moving south pole of the magnet to the left."
    },
    {
     "id": 1164372,
     "content_html": "The sign of voltage will remain same because the direction of current flow will not change by moving south pole of the magnet to the left."
    },
    {
     "id": 1164373,
     "content_html": "The sign of voltage will change because the magnitude of current flow will change by moving south pole of the magnet to the left."
    },
    {
     "id": 1164374,
     "content_html": "The sign of voltage will remain same because the magnitude of current flow will not change by moving south pole of the magnet to the left."
    }
   ],
