  {
   "id": 504265,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Alan starts from his home and walks 1.3 km east to the library. He walks an additional 0.68 km east to a music store. From there, he walks 1.1 km north to a friend’s house and an additional 0.42 km north to a grocery store before he finally returns home along the same path. What is his final displacement and total distance traveled?",
   "answers": [
    {
     "id": 991705,
     "content_html": "Displacement is 0 km and distance is 7 km."
    },
    {
     "id": 991706,
     "content_html": "Displacement is 0 km and distance is 3.5 km."
    },
    {
     "id": 991707,
     "content_html": "Displacement is 7 km towards west and distance is 7 km."
    },
    {
     "id": 991708,
     "content_html": "Displacement is 3.5 km towards east and distance is 3.5 km."
    }
   ],
