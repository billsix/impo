   "id": 501051,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What aspects of physics would a chemist likely study in trying to discover a new chemical reaction?",
   "answers": [
    {
     "id": 984639,
     "content_html": "Physics is involved in understanding whether the reactants and products dissolve in water."
    },
    {
     "id": 984640,
     "content_html": "Physics is involved in understanding the amount of energy released or required in a chemical reaction."
    },
    {
     "id": 984641,
     "content_html": "Physics is involved in what the products of the reaction will be."
    },
    {
     "id": 984642,
     "content_html": "Physics is involved in understanding the types of ions produced in a chemical reaction."
    }
