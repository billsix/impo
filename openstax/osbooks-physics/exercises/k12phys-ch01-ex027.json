   "id": 501595,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why scientists sometimes use a model rather than trying to analyze the behavior of the real system.",
   "answers": [
    {
     "id": 985731,
     "content_html": "Models are simpler to analyze."
    },
    {
     "id": 985732,
     "content_html": "Models give more accurate results."
    },
    {
     "id": 985733,
     "content_html": "Models provide more reliable predictions."
    },
    {
     "id": 985734,
     "content_html": "Models do not require any computer calculations."
    }
