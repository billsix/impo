   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is the sound from a tire burst louder than that from a finger snap?",
   "answers": [
    {
     "id": 761661,
     "content_html": "The sound from the tire burst has higher pressure amplitudes, hence it can exert smaller force on the eardrum."
    },
    {
     "id": 761660,
     "content_html": "The sound from the tire burst has lower pressure amplitudes, hence it can exert smaller force on the eardrum."
    },
    {
     "id": 761659,
     "content_html": "The sound from the tire burst has lower pressure amplitudes, hence it can exert larger force on the ear drum."
    },
