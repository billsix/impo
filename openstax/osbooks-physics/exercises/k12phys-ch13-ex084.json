 "questions": [
  {
   "id": 614000,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do water waves traveling from the deep end to the shallow end of a swimming pool experience refraction?",
   "answers": [
    {
     "id": 1164005,
     "content_html": "Because the pressure of water at the two ends of the pool is same"
    },
    {
     "id": 1164006,
     "content_html": "Because the pressures of water at the two ends of the pool are different"
    },
    {
     "id": 1164007,
     "content_html": "Because the density of water at the two ends of the pool is same"
    },
    {
     "id": 1164008,
     "content_html": "Because the density of water at the two ends of the pool is different"
    }
