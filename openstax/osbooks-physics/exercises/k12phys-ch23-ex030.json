   "stem_html": "How do the number of fundamental particles differ between hadrons and leptons?",
   "answers": [
    {
     "id": 764328,
     "content_html": "Hadrons are constructed of at least three fundamental quark particles, while leptons are fundamental particles."
    },
    {
     "id": 764327,
     "content_html": "Hadrons are constructed of at least three fundamental quark particles, while leptons are constructed of two fundamental particles."
    },
