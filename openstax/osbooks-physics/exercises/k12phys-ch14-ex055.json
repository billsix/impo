 "questions": [
  {
   "id": 243049,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "For a constant area, what is the relationship between intensity of a sound wave and power?",
   "answers": [
    {
     "id": 761631,
     "content_html": "The intensity is inversely proportional to the power transmitted by the wave, for a constant area."
    },
    {
     "id": 761632,
     "content_html": "The intensity is inversely proportional to the square of the power transmitted by the wave, for a constant area. \n <span data-math=\"I=\\frac{1}{P^2}\">I=\\frac{1}{P^2}</span>"
    },
    {
     "id": 761633,
     "content_html": "The intensity is directly proportional to the square of the power transmitted by the wave, for a constant area. <span data-math=\"I = \\text{P}^2\">I = \\text{P}^2</span>"
    },
    {
     "id": 761634,
     "content_html": "The intensity is directly proportional to the power transmitted by the wave, for a constant area. <span data-math=\"I=\\frac{P}{A}\">I=\\frac{P}{A}</span>"
    }
   ],
