 "questions": [
  {
   "id": 243649,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how Compton scattering may have caused large scale disruptions to communications systems after atomic weapons were tested near Los Alamos?\n",
   "answers": [
    {
     "id": 763965,
     "content_html": "The large numbers of neutrons released may have absorbed the energy of nearby electrons."
    },
    {
     "id": 763966,
     "content_html": "The large numbers of photons released may have dissipated some of their energy to nearby electrons."
    },
    {
     "id": 763964,
     "content_html": "The large numbers of neutrons released at high speeds may have caused nearby electrons to scatter. "
    },
    {
     "id": 763963,
     "content_html": "The large numbers of photons released may have caused those photons and nearby electrons to increase in velocity and change directions."
    }
   ],
