 "questions": [
  {
   "id": 501543,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How could knowledge of physics help you build a sound and energy-efficient house?",
   "answers": [
    {
     "id": 985523,
     "content_html": "An understanding of force, pressure, heat, electricity, etc., which all involve physics, will help me design a sound and energy-efficient house."
    },
    {
     "id": 985524,
     "content_html": "An understanding of the air composition, chemical composition of matter, etc., which all involves physics, will help me design a sound and energy-efficient house."
    },
    {
     "id": 985525,
     "content_html": "An understanding of material cost and economic factors involving physics will help me design a sound and energy-efficient house."
    },
    {
     "id": 985526,
     "content_html": "An understanding of geographical location and social environment which involves physics will help me design a sound and energy-efficient house."
    }
   ],
