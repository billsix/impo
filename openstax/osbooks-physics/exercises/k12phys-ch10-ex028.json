  {
   "id": 550371,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A <span data-math=\"\\beta\">\\beta</span> particle (a free electron) is speeding around the track in a cyclotron, rapidly gaining speed. How will the particle’s momentum change as its speed approaches the speed of light? Explain.",
   "answers": [
    {
     "id": 1081512,
     "content_html": "The particle’s momentum will rapidly decrease."
    },
    {
     "id": 1081513,
     "content_html": "The particle’s momentum will rapidly increase."
    },
    {
     "id": 1081514,
     "content_html": "The particle’s momentum will remain constant."
    },
    {
     "id": 1081515,
     "content_html": "The particle’s momentum will approach zero."
    }
   ],
