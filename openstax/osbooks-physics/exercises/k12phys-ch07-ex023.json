  {
   "id": 536489,
   "is_answer_order_important": true,
   "stimulus_html": "<iframe src=\"https://openstax.org/l/28gravityorbit\"></iframe>",
   "stem_html": "Why doesn’t the Moon travel in a smooth circle around the Sun?",
   "answers": [
    {
     "id": 1052147,
     "content_html": "The Moon is not affected by the gravitational field of the Sun."
    },
    {
     "id": 1052148,
     "content_html": "The Moon is not affected by the gravitational field of the Earth."
    },
    {
     "id": 1052149,
     "content_html": "The Moon is affected by the gravitational fields of both the Earth and the Sun, which are always additive."
    },
    {
     "id": 1052150,
     "content_html": "The moon is affected by the gravitational fields of both the Earth and the Sun, which are sometimes additive and sometimes opposite."
    }
   ],
