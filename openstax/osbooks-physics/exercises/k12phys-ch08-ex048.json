  {
   "id": 536487,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Are perfectly elastic collisions possible?",
   "answers": [
    {
     "id": 1052139,
     "content_html": "Perfectly elastic collisions are not possible."
    },
    {
     "id": 1052140,
     "content_html": "Perfectly elastic collisions are possible only with subatomic particles."
    },
    {
     "id": 1052141,
     "content_html": "Perfectly elastic collisions are possible only when the objects stick together after impact."
    },
    {
     "id": 1052142,
     "content_html": "Perfectly elastic collisions are possible if the objects and surfaces are nearly frictionless."
    }
   ],
