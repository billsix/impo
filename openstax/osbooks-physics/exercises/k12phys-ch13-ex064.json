 "questions": [
  {
   "id": 239031,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the reflection of a wave?",
   "answers": [
    {
     "id": 745802,
     "content_html": "The reflection of a wave is the change in amplitude of a wave when it bounces off a barrier."
    },
    {
     "id": 745801,
     "content_html": "The reflection of a wave is the change in frequency of a wave when it bounces off a barrier."
    },
    {
     "id": 745800,
     "content_html": "The reflection of a wave is the change in velocity of a wave when it bounces off a barrier."
    },
    {
     "id": 745803,
     "content_html": "The reflection of a wave is the change in direction of a wave when it bounces off a barrier."
    }
   ],
