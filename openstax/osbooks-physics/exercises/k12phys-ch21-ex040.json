  {
   "id": 243532,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How did Einstein’s model of photons change the view of a beam of energy leaving a flashlight?",
   "answers": [
    {
     "id": 763526,
     "content_html": "A beam of light energy is now considered a continual stream of wave energy, not photons."
    },
    {
     "id": 763527,
     "content_html": "A beam of light energy is now considered a collection of photons, each carrying its own individual energy."
    }
   ],
