   "stimulus_html": "",
   "stem_html": "In a sound wave, which parameter of the medium varies with every cycle?",
   "answers": [
    {
     "id": 745513,
     "content_html": "The density of the medium varies with every cycle."
    },
    {
     "id": 745512,
     "content_html": "The mass of the medium varies with every cycle."
    },
    {
     "id": 745511,
     "content_html": "The resistivity of the medium varies with every cycle."
    },
    {
     "id": 745510,
     "content_html": "The volume of the medium varies with every cycle."
    }
