 "questions": [
  {
   "id": 243667,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain why an alpha particle can have a greater range in air than a beta particle in lead.",
   "answers": [
    {
     "id": 764033,
     "content_html": "While the alpha particle has a lesser charge than a beta particle, the electron density in lead is much less than that in air."
    },
    {
     "id": 764034,
     "content_html": "While the alpha particle has a greater charge than a beta particle, the electron density in lead is much lower than that in air."
    },
    {
     "id": 764035,
     "content_html": "While the alpha particle has a lesser charge than a beta particle, the electron density in lead is much greater than that in air."
    },
    {
     "id": 764036,
     "content_html": "While the alpha particle has a greater charge than a beta particle, the electron density in lead is much higher than that in air."
    }
   ],
