   "id": 530804,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When you push a door closer to the hinges, why does it open more slowly?",
   "answers": [
    {
     "id": 1038546,
     "content_html": "It opens slowly because the lever arm is shorter so the torque is large."
    },
    {
     "id": 1038547,
     "content_html": "It opens slowly because the lever arm is longer so the torque is large."
    },
    {
     "id": 1038548,
     "content_html": "It opens slowly because the lever arm is shorter so the torque is less."
    },
    {
     "id": 1038549,
     "content_html": "It opens slowly because the lever arm is longer so the torque is less."
    }
