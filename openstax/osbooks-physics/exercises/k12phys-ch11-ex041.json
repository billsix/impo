   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is buoyancy?",
   "answers": [
    {
     "id": 744502,
     "content_html": "Buoyancy is a downward force exerted by a solid that opposes the weight of an object."
    },
    {
     "id": 744500,
     "content_html": "Buoyancy is a downward force exerted by a fluid that opposes the weight of an immersed object."
    },
    {
     "id": 744501,
     "content_html": "Buoyancy is an upward force exerted by a solid that opposes the weight an object."
    },
    {
     "id": 744503,
     "content_html": "Buoyancy is an upward force exerted by a fluid that opposes the weight of an immersed object."
    }
