 "questions": [
  {
   "id": 537842,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When the momentum of an object increases with respect to time, what is true of the net force acting on it?",
   "answers": [
    {
     "id": 1057201,
     "content_html": "It is zero, because the net force is equal to the rate of change of the momentum."
    },
    {
     "id": 1057202,
     "content_html": "It is zero, because the net force is equal to the product of the momentum and the time interval."
    },
    {
     "id": 1057203,
     "content_html": "It is nonzero, because the net force is equal to the rate of change of the momentum."
    },
    {
     "id": 1057204,
     "content_html": "It is nonzero, because the net force is equal to the product of the momentum and the time interval."
    }
   ],
