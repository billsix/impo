 "questions": [
  {
   "id": 239591,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can you maximize the peak emf from a generator?",
   "answers": [
    {
     "id": 747880,
     "content_html": "The peak emf from a generator can be maximized only by maximizing number of turns."
    },
    {
     "id": 747881,
     "content_html": "The peak emf from a generator can be maximized only by maximizing area of the wired loop."
    },
    {
     "id": 747882,
     "content_html": "The peak emf from a generator can be maximized only by maximizing frequency."
    },
    {
     "id": 747883,
     "content_html": "The peak emf from a generator can be maximized by maximizing number of turns, maximizing area of the wired loop or maximizing frequency."
    }
