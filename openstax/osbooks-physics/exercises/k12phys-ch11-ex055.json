 "questions": [
  {
   "id": 238715,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is there no change in temperature during a phase change, even if energy is absorbed by the system?",
   "answers": [
    {
     "id": 744589,
     "content_html": "The energy is used to break bonds between particles and so does not increase the potential energy of the system’s particles."
    },
    {
     "id": 744588,
     "content_html": "The energy is used to break bonds between particles and so increases the potential energy of the system’s particles."
    },
    {
     "id": 744590,
     "content_html": "The energy is used to break bonds between particles and so does not increase the kinetic energy of the system’s particles."
    },
    {
     "id": 744587,
     "content_html": "The energy is used to break bonds between particles and so increases the kinetic energy of the system’s particles."
    }
   ],
