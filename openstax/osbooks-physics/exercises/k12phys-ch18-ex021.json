 "questions": [
  {
   "id": 239133,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Can an insulating material be used to charge a conductor? If so, how? If not, why not?",
   "answers": [
    {
     "id": 746169,
     "content_html": "No, an insulator cannot charge a conductor by induction."
    },
    {
     "id": 746168,
     "content_html": "No, an insulating material cannot charge a conductor."
    },
    {
     "id": 746167,
     "content_html": "Yes, an uncharged insulator can charge a conductor by induction."
    },
    {
     "id": 746170,
     "content_html": "Yes, a charged insulator can charge a conductor upon contact."
    }
   ],
