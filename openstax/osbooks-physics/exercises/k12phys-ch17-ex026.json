 "questions": [
  {
   "id": 243421,
   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: Diffraction Grating.\n\nThis video explains diffraction of light through several holes.\n<iframe src=\"https://www.openstaxcollege.org/l/02diffgraftin\"></iframe>",
   "stem_html": "The equation that gives the points of constructive interference produced by a diffraction grating is <span data-math=\"d\\sin\\theta=m\\lambda\">d\\sin\\theta=m\\lambda</span>. Why does that equation look familiar?",
   "answers": [
    {
     "id": 763087,
     "content_html": "It is the same as the equation for destructive interference for a double-slit diffraction pattern."
    },
    {
     "id": 763088,
     "content_html": "It is the same as the equation for constructive interference for a double-slit diffraction pattern."
    },
    {
     "id": 763086,
     "content_html": "It is the same as the equation for constructive interference for a single-slit diffraction pattern."
    },
    {
     "id": 763085,
     "content_html": "It is the same as the equation for destructive interference for a single-slit diffraction pattern."
    }
   ],
