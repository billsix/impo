 "questions": [
  {
   "id": 243411,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A beam of light passes through a single slit to create a diffraction pattern. How will the spacing of the bands in the pattern change if the width of the slit is increased?",
   "answers": [
    {
     "id": 763047,
     "content_html": "The width of the spaces between the bands will remain the same."
    },
    {
     "id": 763046,
     "content_html": "The width of the spaces between the bands will increase."
    },
    {
     "id": 763048,
     "content_html": "The width of the spaces between the bands will decrease."
    },
    {
     "id": 763045,
     "content_html": "The width of the spaces between the bands will first decrease and then increase."
    }
   ],
