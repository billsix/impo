   "id": 239030,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How are standing waves formed?",
   "answers": [
    {
     "id": 745799,
     "content_html": "Standing waves are formed by the superposition of two or more waves moving in opposite directions."
    },
    {
     "id": 745798,
     "content_html": "Standing waves are formed by the superposition of two or more waves moving in the same direction."
    },
    {
     "id": 745797,
     "content_html": "Standing waves are formed by the superposition of two or more waves moving in perpendicular directions."
    },
    {
     "id": 745796,
     "content_html": "Standing waves are formed by the superposition of two or more waves moving in arbitrary directions."
    }
