   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how a converging lens corrects farsightedness.",
   "answers": [
    {
     "id": 1164794,
     "content_html": "A converging lens disperses the rays so they focus on the retina."
    },
    {
     "id": 1164795,
     "content_html": "A converging lens bends the rays closer together so they do not focus on the retina."
    },
