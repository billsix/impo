  {
   "id": 613988,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is the distance to the epicenter of an earthquake determined?",
   "answers": [
    {
     "id": 1163957,
     "content_html": "The wavelength difference between P-waves and S-waves is used to measure the distance to the epicenter."
    },
    {
     "id": 1163960,
     "content_html": "The time difference between P-waves and S-waves is used to measure the distance to the epicenter."
    },
    {
     "id": 1163958,
     "content_html": "The frequency difference between P-waves and S-waves is used to measure the distance to the epicenter."
    },
    {
     "id": 1163959,
     "content_html": "The phase difference between P-waves and S-waves is used to measure the distance to the epicenter."
    }
   ],
