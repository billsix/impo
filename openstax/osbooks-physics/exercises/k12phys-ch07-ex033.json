   "stimulus_html": "",
   "stem_html": "State the law of universal gravitation in words only.",
   "answers": [
    {
     "id": 1052679,
     "content_html": "Gravitational force between two objects is directly proportional to the sum of the squares of their masses and inversely proportional to the square of the distance between them."
    },
    {
     "id": 1052680,
     "content_html": "Gravitational force between two objects is directly proportional to the product of their masses and inversely proportional to the square of the distance between them."
    },
