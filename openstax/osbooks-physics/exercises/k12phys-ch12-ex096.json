   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Can the value of thermal efficiency be greater than 1? Why or why not?",
   "answers": [
    {
     "id": 1163901,
     "content_html": "No, according to the first law of thermodynamics, energy output can never be more than the energy input."
    },
    {
     "id": 1163900,
     "content_html": "No, according to the second law of thermodynamics, energy output can never be more than the energy input."
    },
    {
     "id": 1163899,
     "content_html": "Yes, according to the first law of thermodynamics, energy output can be more than the energy input."
    },
