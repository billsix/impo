 "questions": [
  {
   "id": 238648,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Soil has an approximate specific heat of 800 J / kg °C. A farmer monitors both the soil temperature of his field and the temperature of a nearby pond as winter sets in. Will the field or the pond reach 0 °C first and why?",
   "answers": [
    {
     "id": 744327,
     "content_html": "The pond will reach 0 °C first because of water’s greater specific heat."
    },
    {
     "id": 744328,
     "content_html": "The field will reach 0 °C  first because of soil’s lower specific heat."
    },
    {
     "id": 744326,
     "content_html": "They will reach 0° C at the same time because they are exposed to the same weather."
    },
    {
     "id": 744325,
     "content_html": "The water will take longer to heat as well as to cool. This tells us that the specific heat of water is greater than that of land."
    }
   ],
