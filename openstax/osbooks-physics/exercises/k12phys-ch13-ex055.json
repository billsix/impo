  {
   "id": 239022,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does a good-quality speaker have a woofer and a tweeter?",
   "answers": [
    {
     "id": 745772,
     "content_html": "In a good-quality speaker, sounds with high frequencies or short wavelengths are reproduced accurately by woofers, while sounds with low frequencies or long wavelengths are reproduced accurately by tweeters."
    },
    {
     "id": 745773,
     "content_html": "Sounds with high frequencies or short wavelengths are reproduced more accurately by tweeters, while sounds with low frequencies or long wavelengths are reproduced more accurately by woofers."
    }
   ],
