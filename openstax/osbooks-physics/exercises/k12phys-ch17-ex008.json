  {
   "id": 243393,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Go outside in the sunlight and observe your shadow. It has fuzzy edges, even if you do not. Is this a diffraction effect? Explain.",
   "answers": [
    {
     "id": 762975,
     "content_html": "This is a diffraction effect. Your whole body acts as the origin for a new wavefront."
    },
    {
     "id": 762976,
     "content_html": "This is a diffraction effect. Every point on the edge of your shadow acts as the origin for a new wavefront."
    },
    {
     "id": 762974,
     "content_html": "This is a refraction effect. Your whole body acts as the origin for a new wavefront."
    },
    {
     "id": 762973,
     "content_html": "This is a refraction effect. Every point on the edge of your shadow acts as the origin for a new wavefront."
    }
