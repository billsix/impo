 "questions": [
  {
   "id": 504235,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two boats are traveling at equal and opposite velocities when they pass each other. How would the captain of each boat describe the motion of the other boat?",
   "answers": [
    {
     "id": 991585,
     "content_html": "Each captain would describe other boat’s motion the same because motion is independent of reference frame."
    },
    {
     "id": 991586,
     "content_html": "Each captain will describe other boat’s motion as moving in the backward direction because they are in their own reference frames."
    },
    {
     "id": 991587,
     "content_html": "Each captain would describe the boats as moving differently because motion is a relative term."
    },
    {
     "id": 991588,
     "content_html": "Each captain would describe the other boat’s motion perpendicularly because they will perceive them as moving opposite to each other."
    }
   ],
