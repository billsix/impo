 "questions": [
  {
   "id": 536250,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A ball is hit by a racket and its momentum changes. Under what conditions is momentum conserved?",
   "answers": [
    {
     "id": 1051235,
     "content_html": "The momentum of the system can never be conserved in this case."
    },
    {
     "id": 1051236,
     "content_html": "The momentum of the system is conserved if the momentum of the racket is not considered."
    },
    {
     "id": 1051237,
     "content_html": "The momentum of the system is conserved if the momentum of the racket is also considered."
    },
    {
     "id": 1051238,
     "content_html": "The momentum of the system is conserved if the momenta of the racket and the player are also considered."
    }
   ],
