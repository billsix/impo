 "questions": [
  {
   "id": 613636,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A river flows in a direction from southwest to northeast at a velocity of <span data-math=\"7.1\\,\\text{m/s}\">7.1\\,\\text{m/s}</span>. A boat captain wants to cross this river to reach a point on the opposite shore due east of the boat’s current position. The boat moves at <span data-math=\"13\\,\\text{m/s}\">13\\,\\text{m/s}</span> relative to the water. Which direction, relative to the water, should the boat head toward? Note that the resultant direction (relative to the shore) is 0°.",
   "answers": [
    {
     "id": 1162573,
     "content_html": "It should head in a direction <span data-math=\"22.6^\\circ\\!\">22.6^\\circ\\!</span> east of south."
    },
    {
     "id": 1162574,
     "content_html": "It should head in a direction <span data-math=\"22.6^\\circ\\!\">22.6^\\circ\\!</span> south of east."
    },
    {
     "id": 1162572,
     "content_html": "It should head in a direction <span data-math=\"45.0^\\circ\\!\">45.0^\\circ\\!</span> east of south."
    },
    {
     "id": 1162571,
     "content_html": "It should head in a direction <span data-math=\"45.0^\\circ\">45.0^\\circ</span> south of east."
    }
   ],
