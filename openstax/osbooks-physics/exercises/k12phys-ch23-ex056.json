 "questions": [
  {
   "id": 614252,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If antimatter exists, why is it so difficult to find?",
   "answers": [
    {
     "id": 1164989,
     "content_html": "There is a smaller amount of antimatter than matter in the universe; antimatter is quickly annihilated by its matter analogue."
    },
    {
     "id": 1164988,
     "content_html": "There is a smaller amount of matter than antimatter in the universe; matter is annihilated by its antimatter analogue."
    },
    {
     "id": 1164987,
     "content_html": "There is a smaller amount of antimatter than matter in universe; antimatter and its matter analogue coexist."
    },
    {
     "id": 1164986,
     "content_html": "There is a smaller amount of matter than antimatter in the universe; matter and its antimatter analogue coexist."
    }
   ],
