 "questions": [
  {
   "id": 243352,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A person timing the moonrise looks at her watch and then at the rising moon. Describe what happened inside her eyes that allowed her to see her watch clearly one second and then see the moon clearly.",
   "answers": [
    {
     "id": 762811,
     "content_html": "The shape of the lens was changed by the sclera, and thus its focal length was also changed, so that each of the images focused on the retina."
    },
    {
     "id": 762810,
     "content_html": "The shape of the lens was changed by the choroid, and thus its focal length was also changed, so that each of the images focused on the retina."
    },
    {
     "id": 762809,
     "content_html": "The shape of the lens was changed by the iris, and thus its focal length was also changed, so that each of the images focused on the retina."
    },
    {
     "id": 762812,
     "content_html": "The shape of the lens was changed by the muscles, and thus its focal length was also changed, so that each of the images focused on the retina."
    }
   ],
