 "questions": [
  {
   "id": 239336,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between direct current and alternating current?",
   "answers": [
    {
     "id": 746929,
     "content_html": "Direct current flows continuously in every direction whereas alternating current flows in one direction."
    },
    {
     "id": 746930,
     "content_html": "Direct current flows continuously in one direction whereas alternating current reverses its direction at regular time intervals."
    },
    {
     "id": 746928,
     "content_html": "Both direct and alternating current flow in one direction; the magnitude of direct current is fixed whereas the magnitude of alternating current changes at regular intervals of time."
    },
    {
     "id": 746927,
     "content_html": "Both direct and alternating current change their direction of flow; the magnitude of direct current is fixed whereas the magnitude of alternating current changes at regular intervals of time."
    }
   ],
