 "questions": [
  {
   "id": 238983,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is meant by the wavelength of a wave?",
   "answers": [
    {
     "id": 745626,
     "content_html": "The wavelength is the distance between adjacent identical parts of a wave, parallel to the direction of propagation."
    },
    {
     "id": 745625,
     "content_html": "The wavelength is the distance between adjacent identical parts of a wave, perpendicular to the direction of propagation."
    },
    {
     "id": 745624,
     "content_html": "The wavelength is the distance between a crest and the adjacent trough of a wave, parallel to the direction of propagation."
    },
    {
     "id": 745623,
     "content_html": "The wavelength is the distance between a crest and the adjacent trough of a wave, perpendicular to the direction of propagation."
    }
   ],
