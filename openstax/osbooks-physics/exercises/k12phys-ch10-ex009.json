 "questions": [
  {
   "id": 613782,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why was it once believed that light must travel through a medium and could not propagate across empty space?",
   "answers": [
    {
     "id": 1163146,
     "content_html": "The longitudinal nature of light waves implies this."
    },
    {
     "id": 1163145,
     "content_html": "Light shows the phenomenon of diffraction."
    },
    {
     "id": 1163144,
     "content_html": "The speed of light is the maximum possible speed."
    },
    {
     "id": 1163147,
     "content_html": "All other wave energy needs a medium to travel."
    }
   ],
