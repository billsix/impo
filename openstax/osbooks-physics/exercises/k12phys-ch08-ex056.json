   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between momentum and impulse?",
   "answers": [
    {
     "id": 1162992,
     "content_html": "Momentum is the sum of mass and velocity. Impulse is the change in momentum."
    },
    {
     "id": 1162993,
     "content_html": "Momentum is the sum of mass and velocity. Impulse is the rate of change in momentum."
    },
    {
     "id": 1162995,
     "content_html": "Momentum is the product of mass and velocity. Impulse is the change in momentum."
    },
    {
     "id": 1162994,
     "content_html": "Momentum is the product of mass and velocity. Impulse is the rate of change in momentum."
    }
