 "questions": [
  {
   "id": 243469,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A hot, black coffee mug is sitting on a kitchen table in a dark room. Because it cannot be seen, one assumes that it is not emitting energy in the form of light. Explain the fallacy in this logic.",
   "answers": [
    {
     "id": 763276,
     "content_html": "Not all heat is in the form of light energy."
    },
    {
     "id": 763277,
     "content_html": "Not all light energy falls in the visible portion of the electromagnetic spectrum."
    },
    {
     "id": 763275,
     "content_html": "All heat is in the form of light energy."
    },
    {
     "id": 763274,
     "content_html": "All light energy falls in the visible portion of the electromagnetic spectrum."
    }
   ],
