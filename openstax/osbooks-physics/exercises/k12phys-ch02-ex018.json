 "questions": [
  {
   "id": 613534,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is true for the displacement of an object?",
   "answers": [
    {
     "id": 1162178,
     "content_html": "It is always equal to the distance the object moved between its initial and final positions."
    },
    {
     "id": 1162179,
     "content_html": "It is both the straight line distance the object moved as well as the direction of its motion."
    },
    {
     "id": 1162177,
     "content_html": "It is the direction the object moved between its initial and final positions."
    },
    {
     "id": 1162176,
     "content_html": "It is the straight line distance the object moved between its initial and final positions."
    }
   ],
