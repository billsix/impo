 "questions": [
  {
   "id": 243050,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What does <span data-math=\"I\">I</span> stand for in the equation \n <span data-math=\"\\beta (\\text{dB}) = 10\\,\\log_{10}\\left( \\frac{I}{I_0} \\right)\">\\beta (\\text{dB}) = 10\\,\\log_{10}\\left( \\frac{I}{I_0} \\right)</span>? What is its unit?",
   "answers": [
    {
     "id": 761637,
     "content_html": "Yes, <span data-math=\"\\text{I}\">\\text{I}</span> is the sound intensity in watts per meter squared in the equation, <span data-math=\"\\beta (\\text{dB}) = 10\\log_{10}\\left(\\frac{I}{I_0}\\right)\">\\beta (\\text{dB}) = 10\\log_{10}\\left(\\frac{I}{I_0}\\right)</span>."
    },
    {
     "id": 761636,
     "content_html": "<span data-math=\"I\">I</span> is the sound illuminance and its <span data-math=\"\\text{SI}\">\\text{SI}</span> unit is lumen per meter squared."
    },
    {
     "id": 761635,
     "content_html": "<span data-math=\"I\">I</span> is the sound intensity and its <span data-math=\"\\text{SI}\">\\text{SI}</span> unit is watts per meter cubed."
    },
    {
     "id": 761638,
     "content_html": "<span data-math=\"I\">I</span> is the sound intensity and its <span data-math=\"\\text{SI}\">\\text{SI}</span> unit is watts per meter squared."
    }
   ],
