   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do colliding beams result in the location of smaller particles?",
   "answers": [
    {
     "id": 1164962,
     "content_html": "Colliding beams create energy, allowing more energy to be used to separate the colliding particles."
    },
    {
     "id": 1164963,
     "content_html": "Colliding beams lower the energy of the system, so it requires less energy to separate the colliding particles."
    },
    {
     "id": 1164964,
     "content_html": "Colliding beams reduce energy loss, so less energy is required to separate colliding particles."
    },
    {
     "id": 1164965,
