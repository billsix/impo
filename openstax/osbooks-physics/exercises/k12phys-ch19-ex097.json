 "questions": [
  {
   "id": 614090,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In a flashlight, the batteries are normally connected in series. Why are they not connected in parallel?",
   "answers": [
    {
     "id": 1164351,
     "content_html": "Batteries are connected in series for higher voltage and power output."
    },
    {
     "id": 1164350,
     "content_html": "Batteries are connected in series for lower voltage and power output."
    },
    {
     "id": 1164349,
     "content_html": "Batteries are connected in series so that power output is a much lower for the same amount of voltage."
    },
    {
     "id": 1164348,
     "content_html": "Batteries are connected in series to reduce the overall loss of energy from the circuit."
    }
   ],
