  {
   "id": 238994,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which characteristic of a transverse wave is measured along the direction of propagation?",
   "answers": [
    {
     "id": 745667,
     "content_html": "The amplitude of a transverse wave is measured along the direction of propagation."
    },
    {
     "id": 745666,
     "content_html": "The amplitude and the wavelength of a transverse wave are measured along the direction of propagation."
    },
    {
     "id": 745668,
     "content_html": "The wavelength of a transverse wave is measured along the direction of propagation."
    },
    {
     "id": 745665,
     "content_html": "The displacement of the particles of the medium in a transverse wave is measured along the direction of propagation."
    }
