   "id": 243807,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can a particle gain mass by traveling through the Higgs field?",
   "answers": [
    {
     "id": 764557,
     "content_html": "The Higgs field slows down passing particles; the decrease in kinetic energy is transferred to the particle’s mass."
    },
    {
     "id": 764554,
     "content_html": "The Higgs field accelerates passing particles; the decrease in kinetic energy is transferred to the particle’s mass."
    },
    {
     "id": 764555,
     "content_html": "The Higgs field slows down passing particles; the increase in kinetic energy is transferred to the particle’s mass."
    },
