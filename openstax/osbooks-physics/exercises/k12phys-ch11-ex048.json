 "questions": [
  {
   "id": 613918,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does the ice bag method work so much faster than the freezer method for making ice cream?",
   "answers": [
    {
     "id": 1163685,
     "content_html": "Ice has a smaller specific heat than the surrounding air in a freezer. Hence, it absorbs more energy from the ice-cream mixture."
    },
    {
     "id": 1163686,
     "content_html": "Ice has a smaller specific heat than the surrounding air in a freezer. Hence, it absorbs less energy from the ice-cream mixture."
    },
    {
     "id": 1163688,
     "content_html": "Ice has a greater specific heat than the surrounding air in a freezer. Hence, it absorbs more energy from the ice-cream mixture."
    },
    {
     "id": 1163687,
     "content_html": "Ice has a greater specific heat than the surrounding air in a freezer. Hence, it absorbs less energy from the ice-cream mixture."
    }
