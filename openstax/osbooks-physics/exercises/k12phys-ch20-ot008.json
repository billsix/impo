 "questions": [
  {
   "id": 239500,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Can magnetic field lines cross each other? Explain why or why not.",
   "answers": [
    {
     "id": 747546,
     "content_html": "Yes. Magnetic field lines can cross each other because the points where lines intersect indicate where the field changes direction."
    },
    {
     "id": 747547,
     "content_html": "No. Magnetic field lines cannot cross each other because the points where lines intersect would indicate that the field has multiple directions."
    }
   ],
