   "id": 238625,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between thermal energy and internal energy?",
   "answers": [
    {
     "id": 744238,
     "content_html": "The thermal energy of the system is the average kinetic energy of the system’s constituent particles due to their motion. The total internal energy of the system is the sum of the kinetic energies and the potential energies of its constituent particles."
    },
    {
     "id": 744237,
