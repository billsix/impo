   "stem_html": "What is angular acceleration?",
   "answers": [
    {
     "id": 1038490,
     "content_html": "Angular acceleration is the rate of change of the angular displacement."
    },
    {
     "id": 1038491,
     "content_html": "Angular acceleration is the rate of change of the angular velocity."
    },
    {
     "id": 1038492,
     "content_html": "Angular acceleration is the rate of change of the linear displacement."
    },
