   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is meant when a physical law is said to be universal?",
   "answers": [
    {
     "id": 875704,
     "content_html": "The law can explain everything in the universe."
    },
    {
     "id": 875705,
     "content_html": "The law is applicable to all physical phenomena."
    },
    {
     "id": 875706,
     "content_html": "The law applies everywhere in the universe."
    },
    {
     "id": 875707,
     "content_html": "The law is the most basic one and all laws are derived from it."
    }
