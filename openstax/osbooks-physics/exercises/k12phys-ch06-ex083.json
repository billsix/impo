 "questions": [
  {
   "id": 530845,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can the same force applied to a lever produce different torques?",
   "answers": [
    {
     "id": 1038704,
     "content_html": "By applying the force at different points of the lever arm along the length of the lever or by changing the angle between the lever arm and the applied force."
    },
    {
     "id": 1038705,
     "content_html": "By applying the force at the same point of the lever arm along the length of the lever or by changing the angle between the lever arm and the applied force."
    },
    {
     "id": 1038706,
     "content_html": "By applying the force at different points of the lever arm along the length of the lever or by maintaining the same angle between the lever arm and the applied force."
    },
    {
     "id": 1038707,
     "content_html": "By applying the force at the same point of the lever arm along the length of the lever or by maintaining the same angle between the lever arm and the applied force."
    }
