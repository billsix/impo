   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In which direction do the magnetic field lines point outside the south pole of a magnet?",
   "answers": [
    {
     "id": 834637,
     "content_html": "Outside the magnet the direction of magnetic field lines is towards the south pole of the magnet."
    },
    {
     "id": 834638,
     "content_html": "Outside the magnet the direction of magnetic field lines is away from the south pole of the magnet."
    }
