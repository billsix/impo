   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is a photon and how is it different from other fundamental particles?",
   "answers": [
    {
     "id": 763530,
     "content_html": "A photon is a quantum packet of energy; it has infinite mass."
    },
    {
     "id": 763531,
     "content_html": "A photon is a quantum packet of energy; it is massless."
    },
    {
     "id": 763529,
     "content_html": "A photon is a fundamental particle of an atom; it has infinite mass."
    },
    {
     "id": 763528,
     "content_html": "A photon is a fundamental particle of an atom; it is massless."
    }
