 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1169085815612\" class=\"watch-physics\" data-label=\"\">\n<div data-type=\"title\" id=\"6\">Watch Physics: First Law of Thermodynamics / Internal Energy</div>\n<p id=\"fs-id1169082693042\" class=\" \">This video introduces and explains the first law of thermodynamics and the concept of internal energy.</p>\n<div data-type=\"media\" id=\"fs-id1169085842831\" data-alt=\"This tutorial is an introduction to the first law of thermodynamics.\">\n<div data-type=\"alternatives\" class=\"os-has-iframe os-has-link\">\n<a class=\"os-is-link\" target=\"_window\" href=\"https://www.openstaxcollege.org/l/02internalnrg\">Click to view content</a><iframe width=\"660\" height=\"371.4\" src=\"https://www.openstaxcollege.org/l/02internalnrg\" class=\"os-is-iframe\"><!-- no-selfclose --></iframe>\n</div>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 238753,
   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: First Law of Thermodynamics / Internal Energy.\n\nThis video introduces and explains the first law of thermodynamics and the concept of internal energy.\n\n<iframe src=\"https://www.openstaxcollege.org/l/02internalnrg\"></iframe>",
   "stem_html": "Consider the example of tossing a ball when there’s air resistance. As air resistance increases, what would you expect to happen to the final velocity and final kinetic energy of the ball? Why?",
   "answers": [
    {
     "id": 744740,
     "content_html": "Both will decrease. Energy is transferred to the air by heat due to air resistance."
    },
    {
     "id": 744739,
     "content_html": "Both will increase. Energy is transferred from the air to the ball due to air resistance."
    },
    {
     "id": 744738,
     "content_html": "Final velocity will increase, but final kinetic energy will decrease. Energy is transferred by heat to the air from the ball through air resistance."
    },
    {
     "id": 744737,
     "content_html": "Final velocity will decrease, but final kinetic energy will increase. Energy is transferred by heat from the air to the ball through air resistance."
    }
   ],
