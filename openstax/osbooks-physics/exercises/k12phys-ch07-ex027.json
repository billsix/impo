 "questions": [
  {
   "id": 536529,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between <i>g</i> and <i>G</i>?",
   "answers": [
    {
     "id": 1052307,
     "content_html": "<i>g</i> and <i>G</i> are both unchanging constants but have different units."
    },
    {
     "id": 1052308,
     "content_html": "<i>G</i> is a universal constant that relates force with a pair of masses at a distance, while <i>g</i> relates force with mass and varies with location."
    },
    {
     "id": 1052309,
     "content_html": "<i>g</i> describes acceleration while <i>G</i> describes gravitational force."
    },
    {
     "id": 1052310,
     "content_html": "<i>g</i> describes gravitational force while <i>G</i> describes acceleration."
    }
   ],
