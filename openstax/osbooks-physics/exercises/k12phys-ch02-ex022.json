   "id": 504259,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A fly buzzes four and a half times around Kit Yan’s head in a circular path. The fly ends up on the opposite side from where it started. If the diameter of his head is <span data-math=\"14\\,\\text{cm}\">14\\,\\text{cm}</span>, what is the total distance the fly travels and its total displacement?",
   "answers": [
    {
     "id": 991681,
     "content_html": "The distance is <span data-math=\"63\\pi\\,\\text{cm}\">63\\pi\\,\\text{cm}</span> with a displacement of zero."
    },
    {
     "id": 991682,
     "content_html": "The distance is <span data-math=\"7\\,\\text{cm}\">7\\,\\text{cm}</span> with a displacement of zero."
    },
    {
     "id": 991683,
     "content_html": "The distance is <span data-math=\"63\\pi\\,\\text{cm}\">63\\pi\\,\\text{cm}</span> with a displacement of <span data-math=\"14\\,\\text{cm}\">14\\,\\text{cm}</span>."
    },
    {
     "id": 991684,
     "content_html": "The distance is <span data-math=\"7\\,\\text{cm}\">7\\,\\text{cm}</span> with a displacement of <span data-math=\"63\\pi\\,\\text{cm}\">63\\pi\\,\\text{cm}</span>."
