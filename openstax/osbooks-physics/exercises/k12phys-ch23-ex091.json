 "questions": [
  {
   "id": 243859,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two pool balls collide head-on and stop. Their original kinetic energy is converted to heat and sound. Given that this is not possible for particles, what happens to their converted energy?",
   "answers": [
    {
     "id": 764748,
     "content_html": "The kinetic energy is converted into relativistic potential energy, governed by the equation <span data-math=\"E = \\lambda mch\">E = \\lambda mch</span>."
    },
    {
     "id": 764747,
     "content_html": "The kinetic energy is converted into relativistic mass, governed by the equation <span data-math=\"E = \\lambda m^{2}c\">E = \\lambda m^{2}c</span>."
    },
    {
     "id": 764746,
     "content_html": "The kinetic energy is converted into relativistic potential energy, governed by the equation <span data-math=\"E = \\lambda mgh\">E = \\lambda mgh</span>."
    },
    {
     "id": 764749,
     "content_html": "Their kinetic energy is converted into relativistic mass, governed by the equation <span data-math=\"E = \\lambda mc^{2}\">E = \\lambda mc^{2}</span>."
    }
   ],
   "hints": [],
