 "questions": [
  {
   "id": 243468,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A black T-shirt is a good model of a blackbody. However, it is not perfect. What prevents a black T-shirt from being considered a perfect blackbody?",
   "answers": [
    {
     "id": 763273,
     "content_html": "The T-shirt reflects some light."
    },
    {
     "id": 763272,
     "content_html": "The T-shirt absorbs all incident light."
    },
    {
     "id": 763271,
     "content_html": "The T-shirt re-emits all the incident light."
    },
    {
     "id": 763270,
     "content_html": "The T-shirt does not reflect light."
    }
   ],
