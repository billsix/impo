 "questions": [
  {
   "id": 243167,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the actual frequency of the wave produced as a result of superposition of two waves?",
   "answers": [
    {
     "id": 762081,
     "content_html": "It is the average of the frequencies of the two original waves that were superimposed."
    },
    {
     "id": 762080,
     "content_html": "It is the difference between the frequencies of the two original waves that were superimposed."
    },
    {
     "id": 762079,
     "content_html": "It is the product of the frequencies of the two original waves that were superimposed."
    },
    {
     "id": 762078,
     "content_html": "It is the sum of the frequencies of the two original waves that were superimposed."
    }
   ],
