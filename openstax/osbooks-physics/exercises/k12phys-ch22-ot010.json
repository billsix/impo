   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What influence does the strong nuclear force have on the electrons in an atom?",
   "answers": [
    {
     "id": 1164928,
     "content_html": "It attracts them toward the nucleus."
    },
    {
     "id": 1164929,
     "content_html": "It repels them away from the nucleus."
    },
    {
     "id": 1164930,
     "content_html": "The strong force makes electrons revolve around the nucleus."
    },
    {
     "id": 1164931,
     "content_html": "It does not have any influence."
    }
