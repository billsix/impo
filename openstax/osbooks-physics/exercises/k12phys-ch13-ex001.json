 "questions": [
  {
   "id": 238920,
   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: Introduction to Waves.\n\nThis video is an introduction to transverse and longitudinal waves.\n\n<iframe src=\"https://www.openstaxcollege.org/l/02introtowaves\"></iframe>",
   "stem_html": "In a longitudinal sound wave, after a compression wave moves through a region, the density of molecules briefly decreases. Why is this?",
   "answers": [
    {
     "id": 745407,
     "content_html": "After a compression wave, some molecules move forward temporarily."
    },
    {
     "id": 745406,
     "content_html": "After a compression wave, some molecules move backward temporarily."
    },
    {
     "id": 745405,
     "content_html": "After a compression wave, some molecules move upward temporarily."
    },
    {
     "id": 745404,
     "content_html": "After a compression wave, some molecules move downward temporarily."
    }
   ],
