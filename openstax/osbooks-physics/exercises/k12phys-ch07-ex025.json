 "questions": [
  {
   "id": 536499,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "According to the general theory of relativity, a gravitational field bends light. What does this have to do with time and space?",
   "answers": [
    {
     "id": 1052187,
     "content_html": "Gravity has no effect on the space-time continuum, and gravity only affects the motion of light."
    },
    {
     "id": 1052188,
     "content_html": "The space-time continuum is distorted by gravity, and gravity has no effect on the motion of light."
    },
    {
     "id": 1052189,
     "content_html": "Gravity has no effect on either the space-time continuum or on the motion of light."
    },
    {
     "id": 1052190,
     "content_html": "The space-time continuum is distorted by gravity, and gravity affects the motion of light."
    }
   ],
