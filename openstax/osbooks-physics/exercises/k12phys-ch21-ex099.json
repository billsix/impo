 "questions": [
  {
   "id": 243648,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do we not observe the wave-like nature of an object such as quickly rolling bowling ball?\n",
   "answers": [
    {
     "id": 763961,
     "content_html": "The length of the wave is the same as the diameter of the ball, so they are indistinguishable."
    },
    {
     "id": 763960,
     "content_html": "The length of the wave is longer than the diameter of the ball, making the wave difficult to observe."
    },
    {
     "id": 763962,
     "content_html": "The length of the wave is much shorter than the diameter of the ball, making the wave difficult to observe."
    },
    {
     "id": 763959,
     "content_html": "The ball is not rolling quickly enough to have wave-like qualities."
    }
   ],
