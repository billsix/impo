  {
   "id": 504295,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Is it possible to determine a car’s instantaneous velocity from just the speedometer reading?",
   "answers": [
    {
     "id": 991825,
     "content_html": "No, it reflects speed but not the direction."
    },
    {
     "id": 991826,
     "content_html": "No, it reflects the average speed of the car."
    },
    {
     "id": 991827,
     "content_html": "Yes, it sometimes reflects instantaneous velocity of the car."
    },
    {
     "id": 991828,
     "content_html": "Yes, it always reflects the instantaneous velocity of the car."
    }
