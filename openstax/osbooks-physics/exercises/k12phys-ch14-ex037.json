  {
   "id": 243003,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is power defined with reference to a sound wave?",
   "answers": [
    {
     "id": 761455,
     "content_html": "Power is the rate at which energy is transferred by a sound wave."
    },
    {
     "id": 761454,
     "content_html": "Power is the rate at which mass is transferred by a sound wave."
    },
    {
     "id": 761453,
     "content_html": "Power is the rate at which amplitude of a sound wave changes."
    },
    {
     "id": 761452,
     "content_html": "Power is the rate at which wavelength of a sound wave changes."
    }
   ],
