   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is correct about the hypothesis?",
   "answers": [
    {
     "id": 985913,
     "content_html": "The hypothesis must be validated by scientific experiments."
    },
    {
     "id": 985914,
     "content_html": "The hypothesis must not include any physical quantity."
    },
    {
     "id": 985915,
     "content_html": "The hypothesis must be a short and concise statement."
    },
    {
     "id": 985916,
     "content_html": "The hypothesis must apply to all the situations in the universe."
    }
