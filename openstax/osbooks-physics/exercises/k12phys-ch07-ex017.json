 "questions": [
  {
   "id": 537923,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how the masses of a satellite and its parent body must compare in order to apply Kepler’s laws of planetary motion.",
   "answers": [
    {
     "id": 1057469,
     "content_html": "The mass of the parent body must be much less than that of the satellite."
    },
    {
     "id": 1057470,
     "content_html": "The mass of the parent body must be much greater than that of the satellite."
    },
    {
     "id": 1057471,
     "content_html": "The mass of the parent body must be equal to the mass of the satellite."
    },
    {
     "id": 1057472,
     "content_html": "There is no specific relationship between the masses for applying Kepler’s laws of planetary motion."
    }
   ],
