   "stimulus_html": "",
   "stem_html": "Why does fission of heavy nuclei result in the release of neutrons?",
   "answers": [
    {
     "id": 764058,
     "content_html": "Heavy nuclei require more neutrons to achieve stability."
    },
    {
     "id": 764055,
     "content_html": "Heavy nuclei require more neutrons to balance charge."
    },
    {
     "id": 764056,
     "content_html": "Light nuclei require more neutrons to achieve stability."
    },
    {
     "id": 764057,
     "content_html": "Light nuclei require more neutrons to balance charge."
    }
