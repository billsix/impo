 "questions": [
  {
   "id": 238720,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A room has a window made from thin glass. The room is colder than the air outside. There is some condensation on the glass window. On which side of the glass would the condensation most likely be found?",
   "answers": [
    {
     "id": 744607,
     "content_html": "Condensation is on the outside of the glass when the cool, dry air outside the room comes in contact with the cold pane of glass."
    },
    {
     "id": 744610,
     "content_html": "Condensation is on the outside of the glass when the warm, moist air outside the room comes in contact with the cold pane of glass."
    },
    {
     "id": 744608,
     "content_html": "Condensation is on the inside of the glass when the cool, dry air inside the room comes in contact with the cold pane of glass."
    },
    {
     "id": 744609,
     "content_html": "Condensation is on the inside of the glass when the warm, moist air inside the room comes in contact with the cold pane of glass."
    }
   ],
