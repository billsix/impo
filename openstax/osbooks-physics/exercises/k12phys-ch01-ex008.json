   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which statement best compares and contrasts the aims and topics of natural philosophy had versus physics?",
   "answers": [
    {
     "id": 875680,
     "content_html": "Natural philosophy included all aspects of nature including physics."
    },
    {
     "id": 875681,
     "content_html": "Natural philosophy included all aspects of nature excluding physics."
    },
    {
     "id": 875682,
     "content_html": "Natural philosophy and physics are different."
    },
    {
     "id": 875683,
     "content_html": "Natural philosophy and physics are essentially the same thing."
    }
