 "questions": [
  {
   "id": 242990,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does sound travel faster in iron than in air even though iron is denser than air?",
   "answers": [
    {
     "id": 761409,
     "content_html": "The density of iron is greater than that of air. However, the rigidity of iron is much greater than that of air. Hence, sound travels faster in it."
    },
    {
     "id": 761408,
     "content_html": "The density of iron is greater than that of air. However, the rigidity of iron is much less than that of air. Hence, sound travels faster in it."
    },
    {
     "id": 761407,
     "content_html": "The density of iron is greater than that of air. However, the rigidity of iron is equal to that of air. Hence, sound travels faster in it."
    },
    {
     "id": 761406,
     "content_html": "The mass of iron is much less than that of air and the rigidity of iron is much greater than that of air. Hence, sound travels faster in it."
    }
   ],
