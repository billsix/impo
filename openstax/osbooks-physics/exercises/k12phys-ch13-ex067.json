  {
   "id": 239050,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is sound from a stereo louder in one part of the room and softer in another?",
   "answers": [
    {
     "id": 745876,
     "content_html": "Sound is louder in parts of the room where the density is greatest. Sound is softer in parts of the room where density is smallest."
    },
    {
     "id": 745875,
     "content_html": "Sound is louder in parts of the room where the density is smallest. Sound is softer in parts of the room where density is greatest."
    },
    {
     "id": 745877,
     "content_html": "Sound is louder in parts of the room where constructive interference occurs and softer in parts where destructive interference occurs."
    },
    {
     "id": 745874,
     "content_html": "Sound is louder in parts of the room where destructive interference occurs and softer in parts where constructive interference occurs."
    }
