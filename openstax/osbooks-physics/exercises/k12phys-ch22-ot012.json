 "questions": [
  {
   "id": 614239,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How did Becquerel’s observations of pitchblende imply the existence of radioactivity?",
   "answers": [
    {
     "id": 1164937,
     "content_html": "A chemical reaction occurred on the photographic plate without any external source of energy."
    },
    {
     "id": 1164934,
     "content_html": "Bright spots appeared on the photographic plate due to an external source of energy."
    },
    {
     "id": 1164935,
     "content_html": "Energy from the Sun was absorbed by the pitchblende and reflected onto the photographic plate."
    },
    {
     "id": 1164936,
     "content_html": "Dark spots appeared on the photographic plate due to an external source of energy."
    }
   ],
