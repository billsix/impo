 "questions": [
  {
   "id": 243374,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare nearsightedness (myopia) and farsightedness (hyperopia) in terms of focal point.",
   "answers": [
    {
     "id": 762899,
     "content_html": "The eyes of a nearsighted person have focal points beyond the retina. A farsighted person has eyes with focal points between the lens and the retina."
    },
    {
     "id": 762900,
     "content_html": "A nearsighted person has eyes with focal points between the lens and the retina. A farsighted person has eyes with focal points beyond the retina."
    },
    {
     "id": 762898,
     "content_html": "A nearsighted person has eyes with focal points between the lens and the choroid. A farsighted person has eyes with focal points beyond the choroid."
    },
    {
     "id": 762897,
     "content_html": "A nearsighted person has eyes with focal points between the lens and the retina. A farsighted person has eyes with focal points on the retina."
    }
   ],
