 "questions": [
  {
   "id": 516056,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can we determine the global angle <span data-math=\"\\theta\">\\theta</span> (measured counter-clockwise from positive <span data-math=\"x\">x</span>) if we know <span data-math=\"A_x\">A_x</span> and <span data-math=\"A_y\">A_y</span>?",
   "answers": [
    {
     "id": 1010746,
     "content_html": "<span data-math=\"\\theta = \\cos^{-1}\\frac{A_y}{A_x}\">\\theta = \\cos^{-1}\\frac{A_y}{A_x}</span>"
    },
    {
     "id": 1010747,
     "content_html": "<span data-math=\"\\theta = \\cot^{-1}\\frac{A_y}{A_x}\">\\theta = \\cot^{-1}\\frac{A_y}{A_x}</span>"
    },
    {
     "id": 1010748,
     "content_html": "<span data-math=\"\\theta = \\sin^{-1}\\frac{A_y}{A_x}\">\\theta = \\sin^{-1}\\frac{A_y}{A_x}</span>"
    },
    {
     "id": 1010749,
     "content_html": "<span data-math=\"\\theta = \\tan^{-1}\\frac{A_y}{A_x}\">\\theta = \\tan^{-1}\\frac{A_y}{A_x}</span>"
    }
   ],
