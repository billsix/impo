   "id": 613705,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An object undergoes uniform circular motion. If the radius of curvature and mass of the object are constant, what is the centripetal force proportional to?",
   "answers": [
    {
     "id": 1162844,
     "content_html": "<span data-math=\"F_c \\propto \\frac{1}{v}\">F_c \\propto \\frac{1}{v}</span>"
    },
    {
     "id": 1162843,
     "content_html": "<span data-math=\"F_c \\propto \\frac{1}{v^2\\!}\">F_c \\propto \\frac{1}{v^2\\!}</span>"
    },
    {
     "id": 1162842,
     "content_html": "<span data-math=\"F_c \\propto v\">F_c \\propto v</span>"
    },
    {
     "id": 1162845,
     "content_html": "<span data-math=\"F_c \\propto v^2\">F_c \\propto v^2</span>"
    }
