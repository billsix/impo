 "questions": [
  {
   "id": 243663,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Compare the standing wavelength of an <span data-math=\"n = 2\">n = 2</span> orbital to the standing wavelength of an <span data-math=\"n = 4\">n = 4</span> orbital.",
   "answers": [
    {
     "id": 764017,
     "content_html": "The standing wavelength of an <span data-math=\"n = 2\">n = 2</span> orbital is greater than the standing wavelength of an <span data-math=\"n = 4\">n = 4</span> orbital."
    },
    {
     "id": 764018,
     "content_html": "The standing wavelength of an <span data-math=\"n = 2\">n = 2</span> orbital is less than the standing wavelength of an <span data-math=\"n = 4\">n = 4</span> orbital."
    },
    {
     "id": 764019,
     "content_html": "There is no relation between the standing wavelength of an <span data-math=\"n = 2\">n = 2</span> orbital and the standing wavelength of an <span data-math=\"n = 4\">n = 4</span> orbital."
    },
    {
     "id": 764020,
     "content_html": "The standing wavelength of an <span data-math=\"n = 2\">n = 2</span> orbital is the same as the standing wavelength of an<span data-math=\"n = 4\">n = 4</span> orbital."
    }
   ],
