   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What happens to the torque provided by an electric motor if you double the number of coils in the motor?",
   "answers": [
    {
     "id": 747824,
     "content_html": "The torque would be doubled."
    },
    {
     "id": 747823,
     "content_html": "The torque would be halved."
    },
    {
     "id": 747822,
     "content_html": "The torque would be quadrupled."
    },
    {
     "id": 747821,
     "content_html": "The torque would be tripled."
    }
