   "stimulus_html": "",
   "stem_html": "What is deformation?",
   "answers": [
    {
     "id": 1245230,
     "content_html": "Deformation is the magnitude of the restoring force."
    },
    {
     "id": 1245233,
     "content_html": "Deformation is the change in shape due to the application of force."
    },
    {
     "id": 1245231,
     "content_html": "Deformation is the maximum force that can be applied on a spring."
    },
    {
     "id": 1245232,
     "content_html": "Deformation is regaining the original shape upon the removal of an external force."
    }
   ],
