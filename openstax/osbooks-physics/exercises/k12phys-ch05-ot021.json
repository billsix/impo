  {
   "id": 522168,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can we express the <i>x</i> and <i>y</i>-components of a vector in terms of its magnitude, <span data-math=\"A\">A</span>, and direction, global angle <span data-math=\"\\theta\">\\theta</span>?",
   "answers": [
    {
     "id": 1021698,
     "content_html": "<span data-math=\"A_x = A \\cos \\theta\">A_x = A \\cos \\theta</span>;\n<span data-math=\"A_y = A \\sin \\theta\">A_y = A \\sin \\theta</span>"
    },
    {
     "id": 1021699,
     "content_html": "<span data-math=\"A_x = A \\cos \\theta\">A_x = A \\cos \\theta</span>;\n<span data-math=\"A_y = A \\cos \\theta\">A_y = A \\cos \\theta</span>"
    },
    {
     "id": 1021700,
     "content_html": "<span data-math=\"A_x = A \\sin \\theta\">A_x = A \\sin \\theta</span>;\n<span data-math=\"A_y = A \\cos \\theta\">A_y = A \\cos \\theta</span>"
    },
    {
     "id": 1021701,
