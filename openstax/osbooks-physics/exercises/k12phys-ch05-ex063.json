 "questions": [
  {
   "id": 516200,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can you express the velocity, <span data-math=\"\\overrightarrow{v}\">v</span>, of a projectile in terms of its initial velocity, <span data-math=\"\\overrightarrow{v_0}\">v_0</span>, acceleration, <span data-math=\"\\overrightarrow{a}\">a</span>, and time, <span data-math=\"t\">t</span>?",
   "answers": [
    {
     "id": 1010994,
     "content_html": "<span data-math=\"\\overrightarrow{v} = \\overrightarrow{a}t\">v = at</span>"
    },
    {
     "id": 1010995,
     "content_html": "<span data-math=\"\\overrightarrow{v} = \\overrightarrow{v_0} + \\overrightarrow{a}t\">v = v_0 + at</span>"
    },
    {
     "id": 1010996,
     "content_html": "<span data-math=\"\\overrightarrow{v} + \\overrightarrow{v_0} = \\overrightarrow{a}t\">v + v_0 = at</span>"
    },
    {
     "id": 1010997,
     "content_html": "<span data-math=\"\\overrightarrow{v_0} + \\overrightarrow{v} + \\overrightarrow{a}t\">v_0 + v + at</span>"
    }
   ],
