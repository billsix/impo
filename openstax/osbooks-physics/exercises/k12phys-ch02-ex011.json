   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the difference between distance and displacement?",
   "answers": [
    {
     "id": 991561,
     "content_html": "Distance has both magnitude and direction, while displacement has magnitude but no direction."
    },
    {
     "id": 991562,
     "content_html": "Distance has magnitude but no direction, while displacement has both magnitude and direction."
    },
    {
     "id": 991563,
     "content_html": "Distance has magnitude but no direction, while displacement has only direction."
    },
    {
     "id": 991564,
     "content_html": "There is no difference. Both distance and displacement have magnitude and direction."
    }
   ],
