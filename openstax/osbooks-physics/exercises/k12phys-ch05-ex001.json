 "questions": [
  {
   "id": 515493,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "There are two vectors <span data-math=\"\\overrightarrow{\\text{a}}\">\\text{a}</span> and <span data-math=\"\\overrightarrow{\\text{b}}\">\\text{b}</span>. The head of vector <span data-math=\"\\overrightarrow{\\text{a}}\">\\text{a}</span> touches the tail of vector <span data-math=\"\\overrightarrow{\\text{b}}\">\\text{b}</span>. The addition of vectors <span data-math=\"\\overrightarrow{\\text{a}}\">\\text{a}</span> and <span data-math=\"\\overrightarrow{\\text{b}}\">\\text{b}</span> gives a resultant vector <span data-math=\"\\overrightarrow{\\text{c}}\">\\text{c}</span>. Can the addition of these two vectors can be represented by the following two equations?\n<span data-math=\"\\overrightarrow{\\text{a}} + \\overrightarrow{\\text{b}} = \\overrightarrow{\\text{c}}\">\\overrightarrow{\\text{a}} + \\overrightarrow{\\text{b}} = \\overrightarrow{\\text{c}}</span> ;\n<span data-math=\"\\overrightarrow{\\text{b}} + \\overrightarrow{\\text{a}} = \\overrightarrow{\\text{c}}\">\\overrightarrow{\\text{b}} + \\overrightarrow{\\text{a}} = \\overrightarrow{\\text{c}}</span>",
   "answers": [
    {
     "id": 1010524,
     "content_html": "Yes, if we add the same two vectors in a different order it will still give the same resultant vector."
    },
    {
     "id": 1010525,
     "content_html": "No, the resultant vector will change if we add the same vectors in a different order."
    }
   ],
