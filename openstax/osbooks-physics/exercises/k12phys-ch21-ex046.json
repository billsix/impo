   "id": 243550,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Light is projected onto a semi-conductive surface. However, no electrons are ejected. What will happen when the light intensity is increased?",
   "answers": [
    {
     "id": 763592,
     "content_html": "An increase in light intensity decreases the number of photons. However, no electrons are ejected."
    },
    {
     "id": 763591,
     "content_html": "An increase in Increase in light intensity increases the number of photons, so electrons with higher kinetic energy are ejected."
    },
    {
     "id": 763590,
     "content_html": "An increase in light intensity increases the number of photons, so electrons will be ejected."
    },
