 "questions": [
  {
   "id": 238967,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why can light travel through outer space while sound cannot?",
   "answers": [
    {
     "id": 745566,
     "content_html": "Sound waves are mechanical waves and require a medium to propagate. Light waves can travel through a vacuum."
    },
    {
     "id": 745565,
     "content_html": "Sound waves are electromagnetic waves and require a medium to propagate. Light waves can travel through a vacuum."
    },
    {
     "id": 745564,
     "content_html": "Light waves are mechanical waves and do not require a medium to propagate; sound waves require a medium to propagate."
    },
    {
     "id": 745563,
     "content_html": "Light waves are longitudinal waves and do not require a medium to propagate; sound waves require a medium to propagate."
    }
   ],
