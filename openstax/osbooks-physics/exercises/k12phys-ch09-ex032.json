 "questions": [
  {
   "id": 550181,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is this expression for kinetic energy incorrect?\n<span data-math=\"\\text{KE} = (m)(v)^2\">\\text{KE} = (m)(v)^2</span>.",
   "answers": [
    {
     "id": 1080846,
     "content_html": "The constant <span data-math=\"g\">g</span> is missing."
    },
    {
     "id": 1080847,
     "content_html": "The term <span data-math=\"v\">v</span> should not be squared."
    },
    {
     "id": 1080848,
     "content_html": "The expression should be divided by <span data-math=\"2\">2</span>."
    },
    {
     "id": 1080849,
     "content_html": "The energy lost to friction has not been subtracted."
    }
   ],
