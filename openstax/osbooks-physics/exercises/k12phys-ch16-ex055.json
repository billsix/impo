 "questions": [
  {
   "id": 243339,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A lens has a magnification that is negative. What is the orientation of the image?",
   "answers": [
    {
     "id": 762757,
     "content_html": "Negative magnification means the image is erect and real."
    },
    {
     "id": 762758,
     "content_html": "Negative magnification means the image is erect and virtual."
    },
    {
     "id": 762759,
     "content_html": "Negative magnification means the image is inverted and virtual."
    },
    {
     "id": 762760,
     "content_html": "Negative magnification means the image is inverted and real."
    }
   ],
