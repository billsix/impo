 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1163996209811\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\"><span class=\"os-title-label\">PhET Explorations</span></h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"10\" class=\"os-subtitle\"><span class=\"os-subtitle-label\">PhET Explorations: Geometric Optics</span></h4>\n<p id=\"eip-id2214479\" class=\" \">How does a lens form an image? See how light rays are refracted by a lens. Watch how the image changes when you adjust the focal length of the lens, move the object, move the lens, or move the screen.</p>\n<div class=\"os-figure\">\n<figure id=\"fs-id1163995187188\"><div data-type=\"media\" id=\"fs-id1167062368653\" data-alt=\"This simulation allows you to see how light rays are refracted by a lens.\">\n<div data-type=\"alternatives\" class=\"os-has-iframe os-has-link\">\n<a class=\"os-is-link\" target=\"_window\" href=\"https://openstax.org/l/28Geometric\">Click to view content</a><iframe width=\"660\" height=\"371.4\" src=\"https://openstax.org/l/28Geometric\" class=\"os-is-iframe\"><!-- no-selfclose --></iframe>\n</div>\n</div>\n</figure><div class=\"os-caption-container\">\n<span class=\"os-title-label\">Figure </span><span class=\"os-number\">25.25</span><span class=\"os-divider\"> </span>\n</div>\n</div>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 243328,
   "is_answer_order_important": true,
   "stimulus_html": "PhET Explorations: Geometric Optics\n\nHow does a lens form an image? See how light rays are refracted by a lens. Watch how the image changes when you adjust the focal length of the lens, move the object, move the lens, or move the screen.\n\n",
   "stem_html": "How does the focal length, <span data-math=\"f\">f</span>, change with an increasing radius of curvature? How does<span data-math=\"f\">f</span> change with an increasing refractive index?",
   "answers": [
    {
     "id": 762717,
     "content_html": "The focal length increases in both cases: when the radius of curvature and the refractive index increase."
    },
    {
     "id": 762716,
     "content_html": "The focal length decreases in both cases: when the radius of curvature and the refractive index increase."
    },
    {
     "id": 762718,
     "content_html": "The focal length increases when the radius of curvature increases; it decreases when the refractive index increases."
    },
    {
     "id": 762715,
     "content_html": "The focal length decreases when the radius of curvature increases; it increases in when the refractive index increases."
    }
   ],
