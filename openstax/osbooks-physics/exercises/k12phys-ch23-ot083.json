  {
   "id": 243842,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "As energy of interacting particles increases toward the theory of everything, the gravitational force between them increases. Why does this occur?",
   "answers": [
    {
     "id": 764686,
     "content_html": "As energy increases, the masses of the interacting particles will increase."
    },
    {
     "id": 764685,
     "content_html": "As energy increases, the masses of the interacting particles will decrease."
    },
    {
     "id": 764684,
     "content_html": "As energy increases, the masses of the interacting particles will remain constant."
    },
    {
     "id": 764683,
     "content_html": "As energy increases, the masses of the interacting particles starts changing (increasing or decreasing). As a result, the gravitational force between the particles will increase."
    }
   ],
