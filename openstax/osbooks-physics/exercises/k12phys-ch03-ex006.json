   "stimulus_html": "",
   "stem_html": "Why is acceleration a vector quantity?",
   "answers": [
    {
     "id": 999700,
     "content_html": "It is a vector quantity because it has magnitude as well as direction."
    },
    {
     "id": 999701,
     "content_html": "It is a vector quantity because it has magnitude but no direction."
    },
    {
     "id": 999702,
     "content_html": "It is a vector quantity because it is calculated from distance and time."
    },
    {
     "id": 999703,
     "content_html": "It is a vector quantity because it is calculated from speed and time."
    }
   ],
