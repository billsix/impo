 "questions": [
  {
   "id": 238881,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the mathematical expression for thermal efficiency?",
   "answers": [
    {
     "id": 745251,
     "content_html": "<span data-math=\"Eff = \\frac{Q_{\\text{h}}}{Q_{\\text{h}} - Q_c}\">Eff = \\frac{Q_{\\text{h}}}{Q_{\\text{h}} - Q_c}</span>\n"
    },
    {
     "id": 745250,
     "content_html": "<span data-math=\"Eff = \\frac{Q_{\\text{h}}}{Q_c}\">Eff = \\frac{Q_{\\text{h}}}{Q_c}</span>\n"
    },
    {
     "id": 745249,
     "content_html": "<span data-math=\"Eff = \\frac{Q_{\\text{c}}}{Q_{\\text{h}}}\">Eff = \\frac{Q_{\\text{c}}}{Q_{\\text{h}}}</span>\n"
    },
    {
     "id": 745252,
     "content_html": "<span data-math=\"Eff = \\frac{Q_{\\text{h}} - Q_{\\text{c}}}{Q_{\\text{h}}}\">Eff = \\frac{Q_{\\text{h}} - Q_{\\text{c}}}{Q_{\\text{h}}}</span>\n"
    }
   ],
