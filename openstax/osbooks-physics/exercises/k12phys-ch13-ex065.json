 "questions": [
  {
   "id": 239032,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is inversion of a wave?",
   "answers": [
    {
     "id": 745807,
     "content_html": "Inversion occurs when a wave reflects off a fixed end and the wave amplitude changes sign."
    },
    {
     "id": 745806,
     "content_html": "Inversion occurs when a wave reflects off a loose end and the wave amplitude changes sign."
    },
    {
     "id": 745805,
     "content_html": "Inversion occurs when a wave reflects off a fixed end without the wave amplitude changing sign."
    },
    {
     "id": 745804,
     "content_html": "Inversion occurs when a wave reflects off a loose end without the wave amplitude changing sign."
    }
