 "questions": [
  {
   "id": 243212,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the electric and magnetic fields that make up an electromagnetic wave in terms of their orientation relative to each other and their phases.",
   "answers": [
    {
     "id": 762253,
     "content_html": "They are perpendicular to and out of phase with each other."
    },
    {
     "id": 762256,
     "content_html": "They are perpendicular to and in phase with each other."
    },
    {
     "id": 762254,
     "content_html": "They are parallel to and out of phase with each other."
    },
    {
     "id": 762255,
     "content_html": "They are parallel to and in phase with each other."
    }
   ],
