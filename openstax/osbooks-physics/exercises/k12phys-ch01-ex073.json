 "questions": [
  {
   "id": 501093,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Explain how the uncertainty of a measurement relates to the accuracy and precision of the measuring device. Include the definitions of accuracy and precision in your answer.",
   "answers": [
    {
     "id": 984807,
     "content_html": "A decrease in the precision of a measurement increases the uncertainty of the measurement, while a decrease in accuracy does not."
    },
    {
     "id": 984808,
     "content_html": "A decrease in either the precision or accuracy of a measurement increases the uncertainty of the measurement."
    },
    {
     "id": 984809,
     "content_html": "An increase in either the precision or accuracy of a measurement will increase the uncertainty of that measurement."
    },
    {
     "id": 984810,
     "content_html": "An increase in the accuracy of a measurement will increase the uncertainty of that measurement, while an increase in precision will not."
    }
   ],
