 "questions": [
  {
   "id": 550435,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe length contraction and state when it occurs.",
   "answers": [
    {
     "id": 1081768,
     "content_html": "When the speed of an object becomes the speed of light, its length appears to shorten when viewed by a stationary observer."
    },
    {
     "id": 1081769,
     "content_html": "When the speed of an object approaches the speed of light, its length appears to shorten when viewed by a stationary observer."
    },
    {
     "id": 1081770,
     "content_html": "When the speed of an object becomes the speed of light, its length appears to increase when viewed by a stationary observer."
    },
    {
     "id": 1081771,
     "content_html": "When the speed of an object approaches the speed of light, its length appears to increase when viewed by a stationary observer."
    }
   ],
