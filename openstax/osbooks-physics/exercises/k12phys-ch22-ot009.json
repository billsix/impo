 "questions": [
  {
   "id": 614236,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What leads scientists to infer that the nuclear strong force exists?",
   "answers": [
    {
     "id": 1164924,
     "content_html": "A strong force must hold all the electrons outside the nucleus of an atom."
    },
    {
     "id": 1164925,
     "content_html": "A strong force must counteract the highly attractive Coulomb force in the nucleus."
    },
    {
     "id": 1164926,
     "content_html": "A strong force must hold all the neutrons together inside the nucleus."
    },
    {
     "id": 1164927,
     "content_html": "A strong force must counteract the highly repulsive Coulomb force between protons in the nucleus."
    }
   ],
