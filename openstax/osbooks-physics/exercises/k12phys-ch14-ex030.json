 "questions": [
  {
   "id": 242992,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Do you think that when you double the volume of a sound wave you are doubling the sound intensity level (in dB) or the sound intensity (in <span data-math=\"\\text{W}/\\text{m}^{2}\">\\text{W}/\\text{m}^{2}</span>)? Why?",
   "answers": [
    {
     "id": 761414,
     "content_html": "The sound intensity in <span data-math=\"\\text{W}/\\text{m}^2\">\\text{W}/\\text{m}^2</span>, because it is a closer measure of how humans perceive sound."
    },
    {
     "id": 761415,
     "content_html": "The sound intensity level in <span data-math=\"\\text{dB}\">\\text{dB}</span> because it is a closer measure of how humans perceive sound."
    },
    {
     "id": 761413,
     "content_html": "The sound intensity in <span data-math=\"\\text{W}/\\text{m}^2\">\\text{W}/\\text{m}^2</span> because it is the only unit to express the intensity of sound."
    },
    {
     "id": 761412,
     "content_html": "The sound intensity level in <span data-math=\"\\text{dB}\">\\text{dB}</span> because it is the only unit to express the intensity of sound."
    }
   ],
