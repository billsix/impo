 "questions": [
  {
   "id": 516074,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The resultant vector of the addition of vectors <span data-math=\"\\overrightarrow{\\text{a}}\">\\overrightarrow{\\text{a}}</span> and <span data-math=\"\\overrightarrow{\\text{b}}\">\\overrightarrow{\\text{b}}</span> is <span data-math=\"\\overrightarrow{\\text{r}}\">\\overrightarrow{\\text{r}}</span>. The magnitudes of <span data-math=\"\\overrightarrow{\\text{a}}\">\\overrightarrow{\\text{a}}</span>, <span data-math=\"\\overrightarrow{\\text{b}}\">\\overrightarrow{\\text{b}}</span>, and <span data-math=\"\\overrightarrow{\\text{r}}\">\\overrightarrow{\\text{r}}</span> are <span data-math=\"A\">A</span>, <span data-math=\"B\">B</span>, and <span data-math=\"R\">R</span>, respectively. Which of the following is true?",
   "answers": [
    {
     "id": 1010814,
     "content_html": "<span data-math=\"R_x + R_y = 0\">R_x + R_y = 0</span>"
    },
    {
     "id": 1010815,
     "content_html": "<span data-math=\"A_x + A_y = \\overrightarrow{\\text{A}}\">A_x + A_y = \\overrightarrow{\\text{A}}</span>"
    },
    {
     "id": 1010816,
     "content_html": "<span data-math=\"A_x + B_y = B_x + A_y\">A_x + B_y = B_x + A_y</span>"
    },
    {
     "id": 1010817,
     "content_html": "<span data-math=\"A_x + B_x = R_x\">A_x + B_x = R_x</span>"
    }
   ],
