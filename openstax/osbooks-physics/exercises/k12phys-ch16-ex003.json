 "questions": [
  {
   "id": 614185,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Using a concave mirror, you look at the reflection of a faraway object. The image size changes if you move the object closer to the mirror. Why does the image disappear entirely when the object is at the mirror's focal point?",
   "answers": [
    {
     "id": 1164724,
     "content_html": "The height of the image became infinite."
    },
    {
     "id": 1164727,
     "content_html": "The height of the object became zero."
    },
    {
     "id": 1164725,
     "content_html": "The intensity of intersecting light rays became zero."
    },
    {
     "id": 1164726,
     "content_html": "The intensity of intersecting light rays increased."
    }
   ],
