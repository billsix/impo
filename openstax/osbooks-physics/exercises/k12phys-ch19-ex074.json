 "questions": [
  {
   "id": 614079,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two identical resistors are connected in parallel across the terminals of a battery. If you increase the resistance of one of the resistors, what happens to the current through and the voltage across the other resistor?",
   "answers": [
    {
     "id": 1164309,
     "content_html": "The current and the voltage remain the same."
    },
    {
     "id": 1164310,
     "content_html": "The current decreases and the voltage remains the same."
    },
    {
     "id": 1164311,
     "content_html": "The current and the voltage increases."
    },
    {
     "id": 1164312,
     "content_html": "The current increases and the voltage remains the same."
    }
   ],
