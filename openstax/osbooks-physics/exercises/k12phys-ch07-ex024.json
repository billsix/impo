 "questions": [
  {
   "id": 536493,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why do some objects fall faster than others near the surface of the Earth if the force of gravity is proportional to the mass?",
   "answers": [
    {
     "id": 1052163,
     "content_html": "Some objects fall faster because of air resistance, which acts in the direction of the motion of the object and exerts more force on objects with less surface area."
    },
    {
     "id": 1052164,
     "content_html": "Some objects fall faster because of air resistance, which acts in the direction opposite the motion of the object and exerts more force on objects with less surface area."
    },
    {
     "id": 1052165,
     "content_html": "Some objects fall faster because of air resistance, which acts in the direction of motion of the object and exerts more force on objects with more surface area."
    },
    {
     "id": 1052166,
     "content_html": "Some objects fall faster because of air resistance, which acts in the direction opposite the motion of the object and exerts more force on objects with more surface area."
    }
   ],
