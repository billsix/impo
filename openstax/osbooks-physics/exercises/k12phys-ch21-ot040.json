  {
   "id": 243537,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are UV, X-rays, and gamma rays considered ionizing radiation?",
   "answers": [
    {
     "id": 763544,
     "content_html": "UV, X-rays, and gamma rays are capable of ejecting photons from a surface."
    },
    {
     "id": 763543,
     "content_html": "UV, X-rays, and gamma rays are capable of ejecting neutrons from a surface."
    },
    {
     "id": 763542,
     "content_html": "UV, X-rays, and gamma rays are capable of ejecting protons from a surface."
    },
    {
     "id": 763545,
     "content_html": "UV, X-rays, and gamma rays are capable of ejecting electrons from a surface."
    }
   ],
