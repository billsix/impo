 "questions": [
  {
   "id": 243286,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Sometimes light may be both reflected and refracted as it meets the surface of a different medium. Identify a material with a surface that when light travels through the air it is both reflected and refracted. Explain how this is possible.",
   "answers": [
    {
     "id": 762552,
     "content_html": "Light passing through air is partially reflected and refracted when it meets a glass surface. It is reflected because glass has a smooth surface; it is refracted while passing into the transparent glass."
    },
    {
     "id": 762549,
     "content_html": "Light passing through air is partially reflected and refracted when it meets a glass surface. It is reflected because glass has a rough surface, and it is refracted while passing into the opaque glass."
    },
    {
     "id": 762550,
     "content_html": "Light passing through air is partially reflected and refracted when it meets a glass surface. It is reflected because glass has a smooth surface; it is refracted while passing into the opaque glass."
    },
    {
     "id": 762551,
     "content_html": "Light passing through air is partially reflected and refracted when it meets a glass surface. It is reflected because glass has a rough surface; it is refracted while passing into the transparent glass."
    }
   ],
