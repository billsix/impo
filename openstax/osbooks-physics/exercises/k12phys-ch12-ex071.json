   "stimulus_html": "",
   "stem_html": "Why does entropy increase when ice melts into water?",
   "answers": [
    {
     "id": 745204,
     "content_html": "Melting converts the highly ordered solid structure into a disorderly liquid, thereby increasing entropy."
    },
    {
     "id": 745203,
     "content_html": "Melting converts the highly ordered liquid into a disorderly solid structure, thereby increasing entropy."
    },
    {
     "id": 745202,
     "content_html": "Melting converts the highly ordered solid structure into a disorderly solid structure, thereby increasing entropy."
    },
    {
     "id": 745201,
     "content_html": "Melting converts the highly ordered liquid into a disorderly liquid, thereby increasing entropy."
    }
