 "questions": [
  {
   "id": 536408,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The orbits of satellites are elliptical. Define an ellipse.",
   "answers": [
    {
     "id": 1051823,
     "content_html": "An ellipse is an open curve wherein the sum of the distance from the foci to any point on the curve is constant."
    },
    {
     "id": 1051824,
     "content_html": "An ellipse is a closed curve wherein the sum of the distance from the foci to any point on the curve is constant."
    },
    {
     "id": 1051825,
     "content_html": "An ellipse is an open curve wherein the distances from the two foci to any point on the curve are equal."
    },
    {
     "id": 1051826,
     "content_html": "An ellipse is a closed curve wherein the distances from the two foci to any point on the curve are equal."
    }
   ],
