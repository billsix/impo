   "id": 239015,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the relation between the amplitude and height of a transverse wave?",
   "answers": [
    {
     "id": 745746,
     "content_html": "The height of a wave is half of its amplitude."
    },
    {
     "id": 745745,
     "content_html": "The height of a wave is equal to its amplitude."
    },
    {
     "id": 745747,
     "content_html": "The height of a wave is twice its amplitude."
    },
    {
     "id": 745744,
     "content_html": "The height of a wave is four times its amplitude."
    }
