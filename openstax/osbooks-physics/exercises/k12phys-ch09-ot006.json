   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Define work for one-dimensional motion.",
   "answers": [
    {
     "id": 1081062,
     "content_html": "Work is defined as the ratio of the force over the distance."
    },
    {
     "id": 1081063,
     "content_html": "Work is defined as the sum of the force and the distance."
    },
    {
     "id": 1081064,
     "content_html": "Work is defined as the square of the force over the distance."
    },
    {
     "id": 1081065,
     "content_html": "Work is defined as the product of the force and the distance."
    }
