 "questions": [
  {
   "id": 239368,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If current were represented by <span data-math=\"C\">C</span>, voltage by <span data-math=\"B\">B</span>, and resistance by <span data-math=\"g\">g</span>, what would the mathematical expression be for Ohm’s law?",
   "answers": [
    {
     "id": 747043,
     "content_html": "<span data-math=\"C = Bg\">C = Bg</span>\n"
    },
    {
     "id": 747042,
     "content_html": "<span data-math=\"g = BC\">g = BC</span>\n"
    },
    {
     "id": 747044,
     "content_html": "<span data-math=\"\\frac{B}{C} = \\frac{C}{g}\">\\frac{B}{C} = \\frac{C}{g}</span>"
    },
    {
     "id": 747045,
     "content_html": "<span data-math=\"B = Cg\">B = Cg</span>\n"
    }
   ],
