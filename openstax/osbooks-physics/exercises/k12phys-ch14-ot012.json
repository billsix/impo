 "questions": [
  {
   "id": 242961,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Does the elasticity of the medium affect the speed of sound? If so, how?",
   "answers": [
    {
     "id": 761298,
     "content_html": "No, there is no relationship that exists between the speed of sound and elasticity of the medium."
    },
    {
     "id": 761299,
     "content_html": "Yes. When particles are more easily compressed in a medium, sound does not travel as quickly through the medium."
    },
    {
     "id": 761297,
     "content_html": "Yes. When the particles in a medium do not compress much, sound does not travel as quickly through the medium."
    },
    {
     "id": 761296,
     "content_html": "No, the elasticity of a medium affects frequency and wavelength, not wave speed."
    }
   ],
