 "questions": [
  {
   "id": 614232,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A star emits light from its core. One observer views the emission unobstructed while a second observer views the emission while obstructed by a cloud of hydrogen gas. Describe the difference between their observations.",
   "answers": [
    {
     "id": 1164912,
     "content_html": "Intensity of the light in the spectrum will increase."
    },
    {
     "id": 1164911,
     "content_html": "Intensity of the light in the spectrum will decrease."
    },
    {
     "id": 1164913,
     "content_html": "Frequencies will be absorbed from the spectrum."
    },
    {
     "id": 1164910,
     "content_html": "Frequencies will be added to the spectrum."
    }
   ],
