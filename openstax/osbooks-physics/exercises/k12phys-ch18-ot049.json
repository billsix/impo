   "stimulus_html": "",
   "stem_html": "How can you quadruple the electrical force between two charged particles?",
   "answers": [
    {
     "id": 746369,
     "content_html": "Increase the distance between the charges by a factor of two."
    },
    {
     "id": 746368,
     "content_html": "Increase the distance between the charges by a factor of four."
    },
    {
     "id": 746367,
     "content_html": "Increase the product of the charges by a factor of two"
    },
    {
     "id": 746370,
     "content_html": "Increase the product of the charges by a factor of four."
    }
