 "questions": [
  {
   "id": 521730,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is friction?",
   "answers": [
    {
     "id": 1020652,
     "content_html": "Friction is an internal force that opposes the relative motion of an object."
    },
    {
     "id": 1020653,
     "content_html": "Friction is an internal force that accelerates an object’s relative motion."
    },
    {
     "id": 1020654,
     "content_html": "Friction is an external force that opposes the relative motion of an object."
    },
    {
     "id": 1020655,
     "content_html": "Friction is an external force that increases the velocity of the relative motion of an object."
    }
   ],
