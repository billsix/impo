  {
   "id": 243376,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Solve the equation <span data-math=\"\\frac{1}{d_\\text{o}} + \\frac{1}{d_\\text{i}} = \\frac{1}{f}\">\\frac{1}{d_\\text{o}} + \\frac{1}{d_\\text{i}} = \\frac{1}{f}</span> for <span data-math=\"f\">f</span> in such a way that it is not expressed as a reciprocal.",
   "answers": [
    {
     "id": 762907,
     "content_html": "<div data-math=\"f = \\frac{d_\\text{o} + d_\\text{i}}{d_\\text{o} d_\\text{i}}\">f = \\frac{d_\\text{o} + d_\\text{i}}{d_\\text{o} d_\\text{i}}</div>\n"
    },
    {
     "id": 762908,
     "content_html": "<div data-math=\"f = \\frac{d_\\text{o} d_\\text{i}}{d_\\text{i} + d_\\text{o}}\">f = \\frac{d_\\text{o} d_\\text{i}}{d_\\text{i} + d_\\text{o}}</div>\n"
    },
    {
     "id": 762905,
     "content_html": "<div data-math=\"f = \\left( d_\\text{i} + d_\\text{o} \\right)\">f = \\left( d_\\text{i} + d_\\text{o} \\right)</div>\n"
    },
    {
     "id": 762906,
     "content_html": "<span data-math=\"\\text{f} = \\text{d}_\\text{o} \\text{d}_\\text{i}\">\\text{f} = \\text{d}_\\text{o} \\text{d}_\\text{i}</span>"
    }
