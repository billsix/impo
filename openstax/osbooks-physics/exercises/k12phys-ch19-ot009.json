  {
   "id": 504453,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In the context of electricity, what is resistivity?",
   "answers": [
    {
     "id": 992393,
     "content_html": "Resistivity is the property of materials to resist the passage of voltage."
    },
    {
     "id": 992394,
     "content_html": "Resistivity is the property of materials to resist the passage of electric current."
    },
    {
     "id": 992395,
     "content_html": "Resistivity is the property of materials to increase the passage of voltage."
    },
    {
     "id": 992396,
     "content_html": "Resistivity is the property of materials to increase the passage of electric current."
    }
