   "stimulus_html": "",
   "stem_html": "What is thermal energy?",
   "answers": [
    {
     "id": 744225,
     "content_html": "The thermal energy is the average potential energy of the particles in a system."
    },
    {
     "id": 744224,
     "content_html": "The thermal energy is the total sum of the potential energies of the particles in a system."
    },
    {
     "id": 744223,
     "content_html": "The thermal energy is the average kinetic energy of the particles due to the interaction among the particles in a system."
    },
    {
     "id": 744226,
     "content_html": "The thermal energy is the average kinetic energy of the particles in a system."
    }
