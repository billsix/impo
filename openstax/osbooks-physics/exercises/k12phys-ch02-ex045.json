 "questions": [
  {
   "id": 613542,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An object has an average speed of 7.4 km/h. Which of the following describes two ways you could increase the average speed of the object to 14.8 km/h?",
   "answers": [
    {
     "id": 1162210,
     "content_html": "Reduce the distance that the object travels by half, keeping the time constant, or keep the distance constant and double the time."
    },
    {
     "id": 1162211,
     "content_html": "Double the distance that the object travels, keeping the time constant, or keep the distance constant and reduce the time by half."
    },
    {
     "id": 1162209,
     "content_html": "Reduce the distance that the object travels to one-fourth, keeping the time constant, or keep the distance constant and increase the time by fourfold."
    },
    {
     "id": 1162208,
     "content_html": "Increase the distance by fourfold, keeping the time constant, or keep the distance constant and reduce the time by one-fourth."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
