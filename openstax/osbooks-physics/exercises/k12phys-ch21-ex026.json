  {
   "id": 243514,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How did Planck’s work come to be regarded as a major dividing line between classical and modern physics?\n",
   "answers": [
    {
     "id": 763456,
     "content_html": "Planck’s constant is smaller than any previous discovered constant."
    },
    {
     "id": 763457,
     "content_html": "Planck hypothesized that energy is quantized rather than continuous."
    },
    {
     "id": 763455,
     "content_html": "Planck’s theories meant that classical physics was no longer useful for any system."
    },
    {
     "id": 763454,
     "content_html": "Plank discovered the blackbody radiation spectrum."
    }
   ],
