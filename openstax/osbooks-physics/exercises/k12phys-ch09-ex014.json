   "id": 537225,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe two ways in which doing work on an object can increase its mechanical energy.",
   "answers": [
    {
     "id": 1055037,
     "content_html": "Raising an object to a higher elevation does work as it increases its PE; increasing the speed of an object does work as it increases its KE."
    },
    {
