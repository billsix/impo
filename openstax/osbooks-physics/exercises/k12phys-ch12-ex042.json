   "id": 613945,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Three hundred ten joules of heat enter a system, after which the system does <span data-math=\"120\\,\\text{J}\">120\\,\\text{J}</span> of work. What is the change in its internal energy? Would this amount change if the energy transferred by heat were added after the work was done instead of before?",
   "answers": [
    {
     "id": 1163792,
     "content_html": "<span data-math=\"{-190}\\,\\text{J}\">{-190}\\,\\text{J}</span> ; this would change if heat added energy after the work was done"
    },
    {
     "id": 1163791,
     "content_html": "<span data-math=\"190\\,\\text{J}\">190\\,\\text{J}</span>; this would change if heat added energy after the work was done"
    },
    {
     "id": 1163790,
     "content_html": "<span data-math=\"{-190}\\,\\text{J}\">{-190}\\,\\text{J}</span>; this would not change even if heat added energy after the work was done"
    },
