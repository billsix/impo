  {
   "id": 243292,
   "is_answer_order_important": true,
   "stimulus_html": "Watch Physics: Dispersion.\n\nThis video introduces and explains how prisms split white light into so many colors through a process called dispersion.\n<iframe src=\"https://www.openstaxcollege.org/l/02dispersion\"></iframe>",
   "stem_html": "Which colors of the rainbow bend most when refracted?",
   "answers": [
    {
     "id": 762575,
     "content_html": "Colors with a longer wavelength and higher frequency bend most when refracted."
    },
    {
     "id": 762576,
     "content_html": "Colors with a shorter wavelength and higher frequency bend most when refracted."
    },
    {
     "id": 762574,
     "content_html": "Colors with a shorter wavelength and lower frequency bend most when refracted."
    },
    {
     "id": 762573,
     "content_html": "Colors with a longer wavelength and a lower frequency bend most when refracted."
    }
