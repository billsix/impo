   "stimulus_html": "",
   "stem_html": "What is the relationship between the mass and range of a carrier particle?",
   "answers": [
    {
     "id": 764150,
     "content_html": "Range of a carrier particle is inversely proportional to its mass."
    },
    {
     "id": 764149,
     "content_html": "Range of a carrier particle is inversely proportional to square of its mass."
    },
    {
     "id": 764148,
     "content_html": "Range of a carrier particle is directly proportional to its mass."
    },
