 "context": "<div data-type=\"note\" data-has-label=\"true\" id=\"fs-id1169083576345\" class=\"interactive\" data-label=\"\">\n<h3 class=\"os-title\" data-type=\"title\"><span class=\"os-title-label\">PhET Explorations</span></h3>\n<div class=\"os-note-body\">\n<h4 data-type=\"title\" id=\"22\" class=\"os-subtitle\"><span class=\"os-subtitle-label\">PhET Explorations: Color Vision</span></h4>\n<p id=\"import-auto-id1169738016042\" class=\" \">Make a whole rainbow by mixing red, green, and blue light. Change the wavelength of a monochromatic beam or filter white light. View the light as a solid beam, or see the individual photons. </p>\n<div class=\"os-figure\">\n<figure id=\"fs-id1169083514184\"><div data-type=\"media\" id=\"fs-id1167064871798\" data-alt=\"This video demonstrates additive color and color filters.\">\n<div data-type=\"alternatives\" class=\"os-has-iframe os-has-link\">\n<a class=\"os-is-link\" target=\"_window\" href=\"https://openstax.org/l/28Colorvision\">Click to view content</a><iframe width=\"660\" height=\"371.4\" src=\"https://openstax.org/l/28Colorvision\" class=\"os-is-iframe\"><!-- no-selfclose --></iframe>\n</div>\n</div></figure><div class=\"os-caption-container\">\n<span class=\"os-title-label\">Figure </span><span class=\"os-number\">24.21</span><span class=\"os-divider\"> </span>\n</div>\n</div>\n</div>\n</div>",
 "stimulus_html": "",
 "questions": [
  {
   "id": 243183,
   "is_answer_order_important": true,
   "stimulus_html": "PhET Explorations: Color Vision. Make a whole rainbow by mixing red, green, and blue light. Change the wavelength of a monochromatic beam or filter white light. View the light as a solid beam, or see the individual photons. \n<iframe src=\"https://openstax.org/l/28Colorvision\"></iframe>",
   "stem_html": "Ordinary white light is a combination of all colors of visible light. How would a blue absorption filter placed in front of a white light source affect the light you observe?\n",
   "answers": [
    {
     "id": 762139,
     "content_html": "A blue filter absorbs blue light, causing the observed light to be a combination of the other colors."
    },
    {
     "id": 762138,
     "content_html": "A blue filter absorbs the opposite color of light—orange, causing the observed light to be blue."
    },
    {
     "id": 762140,
     "content_html": "A blue filter permits only blue light to pass though, absorbing the other colors and leaving blue light for the observer."
    },
    {
     "id": 762137,
     "content_html": "A blue filter permits only the opposite color light—orange—to pass through, leaving orange light for the observer."
    }
   ],
