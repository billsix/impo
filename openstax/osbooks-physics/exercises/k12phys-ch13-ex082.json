   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does a standing wave form on a guitar string?",
   "answers": [
    {
     "id": 745977,
     "content_html": "due to superposition with the reflected waves from the ends of the string"
    },
    {
     "id": 745976,
     "content_html": "due to superposition with the reflected waves from the walls of the room"
    },
    {
     "id": 745975,
     "content_html": "due to superposition with waves generated from the body of the guitar"
    }
