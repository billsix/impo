 "questions": [
  {
   "id": 614051,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How can you verify whether a certain material is ohmic?",
   "answers": [
    {
     "id": 1164207,
     "content_html": "Make a resistor from this material and measure the current going through this resistor for several different voltages. If the current is proportional to the voltage, then the material is ohmic."
    },
    {
     "id": 1164204,
     "content_html": "Make a resistor from this material and measure the current going through this resistor for several different voltages. If the current is inversely proportional to the voltage, then the material is ohmic."
    },
    {
     "id": 1164205,
     "content_html": "Make a resistor from this material and measure the current going through this resistor for several different voltages. If the current is proportional to the square of the voltage, then the material is ohmic."
    },
    {
     "id": 1164206,
     "content_html": "Make a resistor from this material and measure the current going through this resistor for several different voltages. If the current is inversely proportional to the square of the voltage, then the material is ohmic."
    }
   ],
