 "questions": [
  {
   "id": 537644,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A person is in an elevator that suddenly begins to descend. The person knows, intuitively, that the feeling of suddenly becoming lighter is because the elevator is accelerating downward. What other change would produce the same feeling? How does this demonstrate Einstein’s postulate on which he based the theory of general relativity?",
   "answers": [
    {
     "id": 1056535,
     "content_html": "It would feel the same if the force of gravity suddenly became weaker. This illustrates Einstein’s postulates that gravity and acceleration are indistinguishable."
    },
    {
     "id": 1056536,
     "content_html": "It would feel the same if the force of gravity suddenly became stronger. This illustrates Einstein’s postulates that gravity and acceleration are indistinguishable."
    },
    {
     "id": 1056537,
     "content_html": "It would feel the same if the force of gravity suddenly became weaker. This illustrates Einstein’s postulates that gravity and acceleration are distinguishable."
    },
    {
     "id": 1056538,
     "content_html": "It would feel the same if the force of gravity suddenly became stronger. This illustrates Einstein’s postulates that gravity and acceleration are distinguishable."
    }
