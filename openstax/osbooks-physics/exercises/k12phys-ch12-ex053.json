   "stimulus_html": "",
   "stem_html": "What is the statement for the second law of thermodynamics?",
   "answers": [
    {
     "id": 745051,
     "content_html": "All the spontaneous processes result in decreased total entropy of a system."
    },
    {
     "id": 745050,
     "content_html": "All the spontaneous processes result in increased total entropy of a system."
    },
    {
     "id": 745049,
     "content_html": "All the spontaneous processes result in decreased or constant total entropy of a system."
    },
    {
     "id": 745052,
     "content_html": "All the spontaneous processes result in increased or constant total entropy of a system."
    }
