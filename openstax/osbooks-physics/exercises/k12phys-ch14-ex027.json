 "questions": [
  {
   "id": 242989,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is a human able to hear sounds?",
   "answers": [
    {
     "id": 761405,
     "content_html": "Sound waves cause the eardrum to vibrate. A complicated mechanism converts the vibrations to nerve impulses, which are perceived by the person as sound."
    },
    {
     "id": 761404,
     "content_html": "Sound waves cause the ear canal to vibrate. A complicated mechanism converts the vibrations to nerve impulses, which are perceived by the person as sound."
    },
    {
     "id": 761403,
     "content_html": "Sound waves transfer electrical impulses to the eardrum. A complicated mechanism converts the electrical impulses to sound."
    },
    {
     "id": 761402,
     "content_html": "Sound waves transfer mechanical vibrations to the ear canal, and the eardrum converts them to electrical impulses."
    }
   ],
