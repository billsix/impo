   "id": 243686,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are binary star systems used by LIGO to find gravitational waves?",
   "answers": [
    {
     "id": 764107,
     "content_html": "Binary star systems have high temperature."
    },
    {
     "id": 764108,
     "content_html": "Binary star systems have low density."
    },
    {
     "id": 764109,
     "content_html": "Binary star systems contain a large amount of mass, but because they are orbiting each other, the gravitational field between the two is much less."
    },
    {
     "id": 764110,
     "content_html": "Binary star systems contain a large amount of mass. As a result, the gravitational field between the two is great."
    }
   ],
