 "questions": [
  {
   "id": 521856,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why is there a negative sign in the equation for Hooke’s law?",
   "answers": [
    {
     "id": 1021110,
     "content_html": "The negative sign indicates that displacement decreases with increasing force."
    },
    {
     "id": 1021111,
     "content_html": "The negative sign indicates that the direction of the applied force is opposite to that of displacement."
    },
    {
     "id": 1021112,
     "content_html": "The negative sign indicates that the direction of the restoring force is opposite to that of displacement."
    },
    {
     "id": 1021113,
     "content_html": "The negative sign indicates that the force constant must be negative."
    }
   ],
