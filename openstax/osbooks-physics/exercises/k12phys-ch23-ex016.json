   "id": 614244,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What effect does an increase in electric potential have on the accelerating capacity of a Van de Graaff generator?",
   "answers": [
    {
     "id": 1164957,
     "content_html": "It increases accelerating capacity."
    },
    {
     "id": 1164954,
     "content_html": "It decreases accelerating capacity."
    },
    {
     "id": 1164955,
     "content_html": "The accelerating capacity of a Van de Graaff generator is constant regardless of electric potential."
    },
    {
     "id": 1164956,
     "content_html": "Van de Graaff generators do not have the capacity to accelerate particles."
    }
