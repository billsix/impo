 "questions": [
  {
   "id": 521872,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two simple harmonic oscillators are constructed by attaching similar objects to two different springs. The force constant of the spring on the left is <span data-math=\"5\\,\\text{N/m}\">5\\,\\text{N/m}</span> and that of the spring on the right is <span data-math=\"4\\,\\text{N/m}\">4\\,\\text{N/m}</span>. If the same force is applied to both, which of the following statements is true?",
   "answers": [
    {
     "id": 1021174,
     "content_html": "The spring on the left will oscillate faster than spring on the right."
    },
    {
     "id": 1021175,
     "content_html": "The spring on the right will oscillate faster than the spring on the left."
    },
    {
     "id": 1021176,
     "content_html": "Both the springs will oscillate at the same rate."
    },
    {
     "id": 1021177,
     "content_html": "The rate of oscillation is independent of the force constant."
    }
   ],
