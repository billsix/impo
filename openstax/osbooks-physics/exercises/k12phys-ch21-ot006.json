   "id": 243467,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The temperature of a blackbody radiator is increased. What will happen to the most intense wavelength of light emitted as this increase occurs?",
   "answers": [
    {
     "id": 763268,
     "content_html": "The wavelength of the most intense radiation will vary randomly."
    },
    {
     "id": 763267,
     "content_html": "The wavelength of the most intense radiation will increase."
    },
    {
     "id": 763266,
     "content_html": "The wavelength of the most intense radiation will remain unchanged."
    },
    {
     "id": 763269,
     "content_html": "The wavelength of the most intense radiation will decrease."
    }
   ],
