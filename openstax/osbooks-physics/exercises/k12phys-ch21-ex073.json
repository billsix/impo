 "questions": [
  {
   "id": 243595,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Predict the motion of a solar sail released into interplanetary space, considering only the influence of the nearest star.\n",
   "answers": [
    {
     "id": 763766,
     "content_html": "The sail’s speed will increase continuously at constant acceleration proportional only to the rate of photon ejection from the sun and the sail area."
    },
    {
     "id": 763767,
     "content_html": "The sail’s speed will increase continuously at an acceleration proportional to the distance from the sun and the area of the sail."
    },
    {
     "id": 763765,
     "content_html": "The sail’s speed will increase continuously until it cannot overcome friction from the solar wind, which is proportional to the sail area, then move at constant speed from there."
    },
    {
     "id": 763764,
     "content_html": "The sail’s speed will increase continuously until it cannot overcome friction from the solar wind, which is proportional to the sail area, then decrease in speed."
    }
   ],
