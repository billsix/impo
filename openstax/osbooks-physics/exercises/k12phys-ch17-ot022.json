 "questions": [
  {
   "id": 323538,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Describe the slits in a diffraction grating in terms of number and spacing, as compared to a two-slit diffraction setup.",
   "answers": [
    {
     "id": 835333,
     "content_html": "The slits in a diffraction grating are broader, with space between them that is greater than the separation of the two slits in two-slit diffraction."
    },
    {
     "id": 835334,
     "content_html": "The slits in a diffraction grating are broader, with space between them that is the same as the separation of the two slits in two-slit diffraction."
    },
    {
     "id": 835335,
     "content_html": "The slits in a diffraction grating are narrower, with space between them that is the same as the separation of the two slits in two-slit diffraction."
    },
    {
     "id": 835336,
     "content_html": "The slits in a diffraction grating are narrower, with space between them that is greater than the separation of the two slits in two-slit diffraction."
    }
