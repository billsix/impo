 "questions": [
  {
   "id": 613543,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Swimming one lap in a pool is defined as going across a pool and back again. If a swimmer swims 3 laps in 9 minutes, how can his average velocity be zero?",
   "answers": [
    {
     "id": 1162214,
     "content_html": "His average velocity is zero because his total distance is zero."
    },
    {
     "id": 1162215,
     "content_html": "His average velocity is zero because his total displacement is zero."
    },
    {
     "id": 1162213,
     "content_html": "His average velocity is zero because the number of laps completed is an odd number."
    },
    {
     "id": 1162212,
     "content_html": "His average velocity is zero because the velocity of each successive lap is equal and opposite."
    }
   ],
