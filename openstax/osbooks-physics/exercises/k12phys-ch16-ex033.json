   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which law is expressed by the equation <span data-math=\"n_1 \\sin\\vartheta_1=n_2 \\sin\\vartheta_2\">n_1 \\sin\\vartheta_1=n_2 \\sin\\vartheta_2</span>?",
   "answers": [
    {
     "id": 762615,
     "content_html": "This is Ohm’s law."
    },
    {
     "id": 762614,
     "content_html": "This is Wien’s displacement law."
    },
    {
     "id": 762616,
     "content_html": "This is Snell’s law."
    },
    {
     "id": 762613,
     "content_html": "This is Newton’s law."
