 "questions": [
  {
   "id": 239334,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is electric current?",
   "answers": [
    {
     "id": 746921,
     "content_html": "Electric current is the electric charge that is at rest."
    },
    {
     "id": 746922,
     "content_html": "Electric current is the electric charge that is moving."
    },
    {
     "id": 746920,
     "content_html": "Electric current is the electric charge that moves only from the positive terminal of a battery to the negative terminal."
    },
    {
     "id": 746919,
     "content_html": "Electric current is the electric charge that moves only from a region of lower potential to higher potential."
    }
   ],
