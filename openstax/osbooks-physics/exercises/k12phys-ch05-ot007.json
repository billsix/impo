 "questions": [
  {
   "id": 522086,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If you draw two vectors using the head-to-tail method, how can you then draw the resultant vector?",
   "answers": [
    {
     "id": 1021470,
     "content_html": "By joining the head of the first vector to the head of the last"
    },
    {
     "id": 1021471,
     "content_html": "By joining the head of the first vector with the tail of the last"
    },
    {
     "id": 1021472,
     "content_html": "By joining the tail of the first vector to the head of the last"
    },
    {
     "id": 1021473,
     "content_html": "By joining the tail of the first vector with the tail of the last"
    }
   ],
