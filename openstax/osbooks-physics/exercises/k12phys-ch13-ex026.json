 "questions": [
  {
   "id": 238969,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is the propagation of sound in solids different from that in air?",
   "answers": [
    {
     "id": 745571,
     "content_html": "Sound waves in solids are transverse, whereas in air, they are longitudinal."
    },
    {
     "id": 745570,
     "content_html": "Sound waves in solids are longitudinal, whereas in air, they are transverse."
    },
    {
     "id": 745572,
     "content_html": "Sound waves in solids can be both longitudinal and transverse, whereas in air, they are longitudinal."
    },
    {
     "id": 745569,
     "content_html": "Sound waves in solids are longitudinal, whereas in air, they can be both longitudinal and transverse."
    }
   ],
