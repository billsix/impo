   "id": 613683,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When the radius of the circular path of rotational motion increases, what happens to the arc length for a given angle of rotation?",
   "answers": [
    {
     "id": 1162760,
     "content_html": "The arc length is directly proportional to the radius of the circular path, and it increases with the radius."
    },
    {
     "id": 1162759,
     "content_html": "The arc length is inversely proportional to the radius of the circular path, and it decreases with the radius."
    },
