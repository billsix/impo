 "questions": [
  {
   "id": 501629,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is a scientific model and how is it useful?",
   "answers": [
    {
     "id": 985865,
     "content_html": "A scientific model is a representation of something that can be easily studied directly. It is useful for studying things that can be easily analyzed by humans."
    },
    {
     "id": 985866,
     "content_html": "A scientific model is a representation of something that is often too difficult to study directly. It is useful for studying a complex system or systems that humans cannot observe directly."
    },
    {
     "id": 985867,
     "content_html": "A scientific model is a representation of scientific equipment. It is useful for studying working principles of scientific equipment."
    },
    {
     "id": 985868,
     "content_html": "A scientific model is a representation of a laboratory where experiments are performed. It is useful for studying requirements needed inside the laboratory."
    }
   ],
