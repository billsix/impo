   "id": 614046,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If you double the voltage across an ohmic resistor, how does the current through the resistor change?",
   "answers": [
    {
     "id": 1164187,
     "content_html": "The current will double."
    },
    {
     "id": 1164186,
     "content_html": "The current will increase by half."
    },
    {
     "id": 1164185,
     "content_html": "The current will decrease by half."
    },
    {
     "id": 1164184,
     "content_html": "The current will decrease by a factor of two."
    }
   ],
