   "stimulus_html": "",
   "stem_html": "What is uniform circular motion?",
   "answers": [
    {
     "id": 1162797,
     "content_html": "Uniform circular motion is when an object accelerates on a circular path at a constantly increasing velocity."
    },
    {
     "id": 1162796,
     "content_html": "Uniform circular motion is when an object travels on a circular path at a variable acceleration."
    },
    {
     "id": 1162798,
     "content_html": "Uniform circular motion is when an object travels on a circular path at a constant speed."
    },
    {
     "id": 1162795,
     "content_html": "Uniform circular motion is when an object travels on a circular path at a variable speed."
    }
