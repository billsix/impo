  {
   "id": 243492,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is the frequency of a blackbody’s emission influenced by temperature?\n",
   "answers": [
    {
     "id": 763368,
     "content_html": "The frequency is independent of temperature."
    },
    {
     "id": 763367,
     "content_html": "The frequency scales linearly with temperature. "
    },
    {
     "id": 763366,
     "content_html": "The frequency scales with T<sup>2</sup>."
    },
    {
     "id": 763369,
     "content_html": "The frequency scales with T<sup>4</sup>. "
    }
   ],
