   "stem_html": "What is an ohmic material?",
   "answers": [
    {
     "id": 746926,
     "content_html": "An ohmic material is a material that obeys Ohm’s law."
    },
    {
     "id": 746925,
     "content_html": "An ohmic material is a material that does not obey Ohm’s law."
    },
    {
     "id": 746924,
     "content_html": "An ohmic material is a material that has high resistance."
    },
    {
     "id": 746923,
     "content_html": "An ohmic material is a material that has low resistance."
    }
