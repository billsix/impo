   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What would be some ways in which physics was involved in building the features of the room you are in right now?",
   "answers": [
    {
     "id": 985403,
     "content_html": "Physics is involved in structural strength, dimensions, etc., of the room."
    },
    {
     "id": 985404,
     "content_html": "Physics is involved in the air composition inside the room."
    },
    {
     "id": 985405,
     "content_html": "Physics is involved in the desk arrangement inside the room."
    },
    {
     "id": 985406,
     "content_html": "Physics is involved in the behavior of living beings inside the room."
    }
