 "questions": [
  {
   "id": 516156,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Horizontal and vertical motions of a projectile are independent of each other. What is meant by this?",
   "answers": [
    {
     "id": 1010948,
     "content_html": "All objects in projectile motion with the same initial vertical velocity fall at the same rate, regardless of their horizontal velocity."
    },
    {
     "id": 1010949,
     "content_html": "All objects in projectile motion fall at different rates, regardless of their initial horizontal velocities."
    },
    {
     "id": 1010950,
     "content_html": "Any object in projectile motion falls at the same rate as its initial vertical velocity, regardless of its initial horizontal velocity."
    },
    {
     "id": 1010951,
     "content_html": "All objects in projectile motion fall at different rates and the rate of fall of the object is independent of the initial velocity."
    }
   ],
