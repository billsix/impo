  {
   "id": 522459,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How would simple harmonic motion be different in the absence of friction?",
   "answers": [
    {
     "id": 1022715,
     "content_html": "Oscillation will not happen in the absence of friction."
    },
    {
     "id": 1022716,
     "content_html": "Oscillation will continue forever in the absence of friction."
    },
    {
     "id": 1022717,
     "content_html": "Oscillation will have changing amplitude in the absence of friction."
    },
    {
     "id": 1022718,
     "content_html": "Oscillation will cease after a certain amount of time in the absence of friction."
    }
   ],
