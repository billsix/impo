   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why are high-frequency gamma rays more dangerous to humans than visible light?",
   "answers": [
    {
     "id": 762187,
     "content_html": "Gamma rays have a lower frequency range than visible light."
    },
    {
     "id": 762186,
     "content_html": "Gamma rays have a longer wavelength range than visible light."
    },
    {
     "id": 762188,
     "content_html": "Gamma rays have greater energy than visible light for penetrating matter."
    },
    {
     "id": 762185,
     "content_html": "Gamma rays have less energy than visible light for penetrating matter."
    }
