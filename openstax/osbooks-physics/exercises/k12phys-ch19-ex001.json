 "questions": [
  {
   "id": 239315,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Suppose you have a reservoir of peas, each charged to 1 nC. If you pass the peas through a straw at a rate of four peas per second, how would you calculate the electrical current carried by your charged peas?\n",
   "answers": [
    {
     "id": 746845,
     "content_html": "Measure the length of the straw, then divide by the rate of pea flow and multiply by charge per pea."
    },
    {
     "id": 746846,
     "content_html": "Multiply the rate of pea flow by the charge per pea."
    },
    {
     "id": 746844,
     "content_html": "Measure the length of the straw, then multiply by the rate of pea flow and divide by charge per pea."
    },
    {
     "id": 746843,
     "content_html": "Divide the rate of pea flow by the charge per pea."
    }
   ],
