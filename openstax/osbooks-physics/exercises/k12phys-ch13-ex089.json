 "questions": [
  {
   "id": 239088,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Why does an object appear to be distorted when you view it through a glass of water?",
   "answers": [
    {
     "id": 745997,
     "content_html": "The glass and the water reflect the light in different directions. Hence, the object appears to be distorted."
    },
    {
     "id": 745996,
     "content_html": "The glass and the water absorb the light by different amounts. Hence, the object appears to be distorted."
    },
    {
     "id": 745998,
     "content_html": "Water, air, and glass are media with different densities. Light rays refract and bend when they pass from one medium to another. Hence, the object appears to be distorted."
    },
    {
     "id": 745995,
     "content_html": "The glass and the water disperse the light into its components. Hence, the object appears to be distorted."
    }
   ],
