 "questions": [
  {
   "id": 490075,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best exemplifies the interdisciplinary nature of data science in various fields?",
   "answers": [
    {
     "id": 975039,
     "content_html": "A historian traveling to Italy to study ancient manuscripts to uncover historical insights about the Roman Empire",
     "correctness": "0.0"
    },
    {
     "id": 975040,
     "content_html": "A mathematician solving complex equations to model physical phenomena",
     "correctness": "0.0"
    },
    {
     "id": 975041,
     "content_html": "A biologist analyzing a large dataset of genetic sequences to gain insights about the genetic basis of diseases",
     "correctness": "1.0"
    },
    {
     "id": 975042,
     "content_html": "A chemist synthesizing new compounds in a laboratory",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
