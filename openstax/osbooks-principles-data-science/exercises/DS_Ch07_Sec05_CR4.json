 "questions": [
  {
   "id": 488368,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following would be considered an unethical use of AI or NLP technology?",
   "answers": [
    {
     "id": 973926,
     "content_html": "Developing a chatbot that provides customer service and technical support on a 24/7 basis",
     "correctness": "0.0"
    },
    {
     "id": 973927,
     "content_html": "Creating a natural language processing system that assists visually impaired users in reading text aloud",
     "correctness": "0.0"
    },
    {
     "id": 973928,
     "content_html": "Designing a virtual assistant that collects personal data without explicit user consent and sells it to third-party advertisers",
     "correctness": "1.0"
    },
    {
     "id": 973929,
     "content_html": "Implementing an AI-based language model that translates content across different languages for educational purposes",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Option C is the correct answer because it involves using AI or NLP technology in a way that violates users’ privacy and collects personal data without their informed consent. Additionally, selling this data to third-party advertisers raises ethical concerns about data security, user trust, and transparency. The other options describe appropriate uses of AI and NLP technologies, focusing on customer service, accessibility, and educational purposes."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Designing a virtual assistant that collects personal data without explicit user consent and sells it to third-party advertisers"
    }
