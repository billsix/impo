   "id": 464185,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What type of data would be considered an outlier in machine learning models?",
   "answers": [
    {
     "id": 965333,
     "content_html": "Data points that are well-represented in the training set",
     "correctness": "0.0"
    },
    {
     "id": 965334,
     "content_html": "Data points that are rare or abnormal in comparison to the rest of the data",
     "correctness": "1.0"
    },
    {
     "id": 965335,
     "content_html": "Data points that are equally distributed among all classes",
     "correctness": "0.0"
    },
    {
     "id": 965336,
     "content_html": "Data points that are consistently labeled incorrectly",
     "correctness": "0.0"
    }
   ],
