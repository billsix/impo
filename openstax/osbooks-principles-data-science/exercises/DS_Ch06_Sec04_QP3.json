 "stimulus_html": "Compute the information contained in the events.",
 "questions": [
  {
   "id": 485030,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Obtaining a head and a tail on a flip of two fair coins",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Getting one head (H) and one tail (T) can occur in two ways: HT or TH. There are four total possible outcomes for flipping two coins (HH, HT, TH, TT), so the probability of getting HT or TH is <span data-math=\"p=1/2\"></span>.<br>\n<span data-math=\"\\text{Information}=-{\\text{log}}_2\\frac12=-{(-1)}=1\"></span>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "1"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 485031,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Obtaining all heads on the flip of three fair coins",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Getting three heads (HHH) can occur in only one way out of the total of 8 possible outcomes for flipping three coins, so the probability of getting HHH is <span data-math=\"p=1/8\"></span>.<br>\n<span data-math=\"\\text{Information}=-{\\text{log}}_2\\frac18=-{(-3)}=3\"></span>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "3"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 485032,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Rolling 10 fair 6-sided dice and obtaining all 1s",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Obtaining a roll of 1 on a single 6-sixed die has probability 1/6. Since all the rolls are assumed to be independent, getting a 1 on every one of the 10 rolls carries a probability of <span data-math=\"p={(1/6)}^{10}\"></span>.<br>\n<span data-math=\"\\text{Information}=-{\\text{log}}_2{\\lbrack{(\\frac16)}^{10}\\rbrack}=25.85\"></span>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "25.85"
    }
   ],
   "community_solutions": []
  }
 ],
