 "questions": [
  {
   "id": 493256,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A university admissions office would like to use a multiple linear regression model with students’ high school GPA and scores on both the SAT and ACT (standardized tests) as input variables to predict whether the student would eventually graduate university if admitted. Assuming the following statements are all accurate, which statement would be a reason not to use multiple linear regression?",
   "answers": [
    {
     "id": 977651,
     "content_html": "Students' SAT and ACT scores are often highly correlated with one another."
    },
    {
     "id": 977652,
     "content_html": "GPA scores are measured on a different scale than either SAT or ACT scores."
    },
    {
     "id": 977653,
     "content_html": "Scores of 0 are impossible to obtain on the SAT or ACT."
    },
    {
     "id": 977654,
     "content_html": "Students can have high GPA but sometimes not do well on standardized tests like the SAT or ACT."
    }
   ],
