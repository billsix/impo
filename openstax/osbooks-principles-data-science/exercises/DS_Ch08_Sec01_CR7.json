   "id": 464180,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What type of data can be shared in a data science project?",
   "answers": [
    {
     "id": 965314,
     "content_html": "Quantitative and qualitative data only",
     "correctness": "0.0"
    },
    {
     "id": 965315,
     "content_html": "Tabular, text-based, and image-based data only",
     "correctness": "0.0"
    },
    {
     "id": 965316,
     "content_html": "Audio-based data only",
     "correctness": "0.0"
    },
    {
     "id": 965317,
     "content_html": "Quantitative, qualitative, tabular, text-based, and audio-based data",
     "correctness": "1.0"
    }
   ],
