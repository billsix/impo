   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "In a data science project, any type of data that can be collected and processed can be shared as long as it is relevant to the project and can help achieve the desired outcome. This can include quantitative and qualitative data as well as tabular, text-based, image-based, and even audio-based data."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Quantitative, qualitative, tabular, text-based, and audio-based data"
    }
   ],
