   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "To find the probability that a randomly selected cell phone customer has a monthly bill more than $85, find the area under the normal curve to the right of an <span data-math=\"x\"></span>-value of 85, given the mean of 92 and standard deviation of 14.<br><br>  \nUsing Excel: In any empty cell, type in the command: <br>\n=1 - NORM.DIST(85, 92, 14, TRUE)<br><br>\nUsing Python: Type in the command: \n<pre class=\"python\" lang=\"python\">1 - norm.cdf(85,92,14) \n\nThe resulting output will look like this:\n0.691 \n</pre>\n"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "0.691 "
    }
   ],
