 "stimulus_html": "In a certain city, cell phone bills are known to follow a normal distribution with a mean of $92 and standard deviation of $14.",
 "questions": [
  {
   "id": 456642,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the probability that a randomly selected cell phone customer has a monthly bill less than $75.<br>\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "0.112\n"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "To find the probability that a randomly selected cell phone customer has a monthly bill less than $75, find the area under the normal curve to the left of an <span data-math=\"x\"></span>-value of 75, given the mean of 92 and standard deviation of 14.<br><br>  \nUsing Excel: In any empty cell, type in the command:<br>\n=NORM.DIST(75,92,14,TRUE)<br><br>\nUsing Python: Type in the command:\n <pre class=\"python\" lang=\"python\">norm.cdf(75, 92, 14)\n\nThe resulting output will look like this:\n0.112\n</pre>\n\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 456643,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Find the probability that a randomly selected cell phone customer has a monthly bill more than $85.\n",
   "answers": [],
   "hints": [],
   "formats": [
