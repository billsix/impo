 "questions": [
  {
   "id": 485035,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You are working with a dataset containing information about customer purchases at an online retail store. Each data point represents a customer and includes features such as age, gender, location, browsing history, and purchase history. Your task is to segment the customers into distinct groups based on their purchasing behavior in order to personalize marketing strategies. Which of the following machine learning techniques is best suited for this scenario?",
   "answers": [
    {
     "id": 972311,
     "content_html": "linear or multiple linear regression",
     "correctness": "0.0"
    },
    {
     "id": 972312,
     "content_html": "logistic or multiple logistic regression",
     "correctness": "0.0"
    },
    {
     "id": 972313,
     "content_html": "k-means clustering",
     "correctness": "1.0"
    },
    {
     "id": 972314,
     "content_html": "naïve Bayes classification",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "k-means clustering"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This is a clustering problem. K-means clustering is the best choice. Regression techniques cannot be used with non-numerical features in the data (such as gender, browsing history, and purchase history). The data is unlabeled since we do not already know the groups that customers will be classified into, so naïve Bayes classification is not appropriate."
    }
   ],
   "community_solutions": []
  }
 ],
