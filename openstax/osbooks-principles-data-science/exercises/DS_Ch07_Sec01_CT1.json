 "questions": [
  {
   "id": 488643,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider a single perceptron model that is being trained to diagnose the flu in patients based on three simple markers. Suppose the next data point in the training set is <span data-math=\"\\boldsymbol x={(0.68,0.42,0.99)}\"></span>, and suppose that the correct classification for this combination of markers is <span data-math=\"y=1\"></span> (flu diagnosed). With current weights <span data-math=\"\\boldsymbol w=(0.7,0.2,-0.3)\"></span> and bias <span data-math=\"b=-0.3\"></span>, does the perceptron correctly diagnose the patient as having the flu? If not, use the perceptron learning rule with <span data-math=\"h=0.2\"></span> to update the weights and bias. Is there an improvement in classifying this data point?",
   "answers": [],
