   "id": 488731,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Who should be given access to the data in a data science project?",
   "answers": [
    {
     "id": 974104,
     "content_html": "Anyone who is directly involved in the project",
     "correctness": "0.0"
    },
    {
     "id": 974105,
     "content_html": "Shareholders and customers only",
     "correctness": "0.0"
    },
    {
     "id": 974106,
     "content_html": "Anyone who is directly involved in the project and has a legitimate need for the data",
     "correctness": "1.0"
    },
    {
     "id": 974107,
     "content_html": "Anyone with a valid email address",
     "correctness": "0.0"
    }
