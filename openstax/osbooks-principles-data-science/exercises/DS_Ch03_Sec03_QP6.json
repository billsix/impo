     "solution_type": "detailed",
     "content_html": "<span data-math=\"z = 3.48\"></span>\n"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "For this example, the calculation is performed as follows: <br>\n<span data-math=\"z = \\frac{{x\\;-\\;\\mu }}{\\sigma } = \\frac{{17\\;-\\;9}}{{2.3}} = 3.48\"></span>\n"
    }
   ],
