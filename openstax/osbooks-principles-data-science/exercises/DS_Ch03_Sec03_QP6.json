 "is_vocab": false,
 "stimulus_html": "At a website development company, the average number of sick days taken by employees per year is 9 days with a standard deviation of 2.3 days. ",
 "questions": [
  {
   "id": 457841,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A certain employee has taken 2 sick days for the year. Calculate the <span data-math=\"z\"></span>-score for this employee (round your answer to 2 decimal places).",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"z =  - 3.04\"></span>\n"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The formula for a z-score calculation is as follows:<br> <span data-math=\"z = \\frac{{x\\;-\\; \\mu }}{\\sigma }\"></span><br>\nwhere <span data-math=\"x\"></span> is the measurement, <span data-math=\"\\mu\"></span> is the mean, and <span data-math=\"\\sigma\"></span> is the standard deviation.\nFor this example, the calculation is performed as follows:<br> <span data-math=\"z = \\frac{{x\\;-\\;\\mu }}{\\sigma } = \\frac{{2\\;-\\;9}}{{2.3}} =  - 3.04\"></span>\n\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 457842,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does the <span data-math=\"z\"></span>-score communicate about this employee’s number of sick days as compared to other employees in the company?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "See Solution Manual\n"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A <span data-math=\"z\"></span>-score of –3.04 indicates the number of sick days for this employee is more than three standard deviations below the mean, and thus this indicates that 2 sick days is significantly below the mean number of sick days. This employee has a significantly lower number of sick days as compared to other employees.\n"
    }
   ],
   "community_solutions": []
  },
  {
   "id": 457843,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A different employee has taken 17 sick days for the year. Calculate the <span data-math=\"z\"></span>-score for this employee (round your answer to 2 decimal places).",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
