 "questions": [
  {
   "id": 464184,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A new social media platform is looking for ways to improve its content-delivery algorithm so that it appeals to a broader audience. Currently, the platform is being used primarily by college-aged students. Which of these datasets would be the most appropriate data to collect and analyze to improve the algorithm and reduce potential bias in the content-delivery model?",
   "answers": [
    {
     "id": 965330,
     "content_html": "Dataset 1, consisting of all the past browsing data on the platform",
     "correctness": "0.0"
    },
    {
     "id": 965331,
     "content_html": "Dataset 2, the results of an extensive survey of people from various backgrounds and demographic segments who may or may not be familiar with the new social media platform",
     "correctness": "1.0"
    },
    {
     "id": 965332,
     "content_html": "Dataset 3, the results of an internal company questionnaire",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The goal is to broaden the appeal of the platform, so it makes sense to survey a large number of people from various backgrounds and demographic segments. If using only results from those who use the platform or who are familiar with it, then the models would be biased toward existing social media users, potentially missing the opportunity to expand the market to others."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Dataset 2, the results of an extensive survey of people from various backgrounds and demographic segments who may or may not be familiar with the new social media platform"
    }
   ],
   "community_solutions": []
  }
 ],
