 "stimulus_html": "Consider the data set <a href=\"https://openstax.org/r/spreadsheetsd1j\" rel=\"nofollow\" target=\"_blank\">USATemps1961-2023.csv</a>. ",
 "questions": [
  {
   "id": 495649,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use an ACF plot to determine the period of a potential seasonal component. ",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Use Python. The ACF plot shows a spike at lag 3.<br>\n<pre class=\"python\" lang=\"python\"># Import libraries\nimport pandas as pd ## for dataset management\nfrom statsmodels.graphics.tsaplots import plot_acf\n\n# Read the CSV file into a Pandas DataFrame\ndf = pd.read_csv('USATemps1961-2023.csv')\n\n# Plot the ACF\nplot_acf(df['Deviation'], lags=20, title='ACF');\n<figure>\n<img src=\"https://exercises.openstax.org/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBBdklqIiwiZXhwIjpudWxsLCJwdXIiOiJibG9iX2lkIn19--a8d405621277881cd0b0cdbdc97d13ce9741f372/DS_UnFigure_05_04_015.png\" alt=\"ACF plot with 21 lags showing autocorrelation values. X-axis represents lag and Y-axis represents autocorrelation. Y-axis ranges from -1 to 1, x-axis from 0 to 20. Autocorrelation values decrease rapidly, with confidence intervals indicated by shaded areas.\">\n</figure>\n\n</pre>"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\text{Period}=3\"></span> from the ACF plot."
    }
   ],
   "community_solutions": []
  },
  {
   "id": 495650,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use STL to decompose the time series into trend-cycle, seasonal, and noise components.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "See Solution Manual"
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Use Python function <code class=\"python\" lang=\"python\">STL()</code>.\n<pre class=\"python\" lang=\"python\"># Import libraries\nfrom statsmodels.tsa.seasonal import STL\n\n# Perform seasonal decomposition using STL\nstl = STL(df['Deviation'], period=3)\nresult = stl.fit()\nresult.plot();\n<figure>\n<img src=\"https://exercises.openstax.org/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBBdk1qIiwiZXhwIjpudWxsLCJwdXIiOiJibG9iX2lkIn19--4d41978ab9da58090c2840bb6d3a9ea98fce1067/DS_UnFigure_05_04_016.png\" alt=\"A time series decomposition plot labeled “Deviation” with four subplots: deviation (0 to 2), trend (0 to 1), seasonality (-0.25 to 0.25), and residuals (-0.5 to 0.5). X-axis for all plots ranges from 0 to 60.\">\n</figure></pre>"
    }
   ],
   "community_solutions": []
  }
