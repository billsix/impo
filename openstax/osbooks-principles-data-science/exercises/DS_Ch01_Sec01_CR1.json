 "questions": [
  {
   "id": 490073,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Select the incorrect step and goal pair of the data science cycle.",
   "answers": [
    {
     "id": 975031,
     "content_html": "Data collection: collect the data so that you have something for analysis.",
     "correctness": "0.0"
    },
    {
     "id": 975032,
     "content_html": "Data preparation: have the collected data stored in a server as is so that you can start the analysis.",
     "correctness": "1.0"
    },
    {
     "id": 975033,
     "content_html": "Data analysis: analyze the prepared data to retrieve some meaningful insights.",
     "correctness": "0.0"
    },
    {
     "id": 975034,
     "content_html": "Data reporting: present the data in an effective way so that you can highlight the insights found from the analysis.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Rarely is collected data already in good shape for analysis. Most of the time, collected data needs to be processed to be suitable for the analysis of interest. An example of preparation can be dealing with missing data—removing them or filling them."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Data preparation: have the collected data stored in a server as is so that you can start the analysis."
    }
   ],
