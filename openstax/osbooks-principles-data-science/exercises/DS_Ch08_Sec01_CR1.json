   "id": 464287,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which option best explains the significance of informed consent during the data collection phase?",
   "answers": [
    {
     "id": 965473,
     "content_html": "To ensure individuals are aware of the potential risks and benefits of the research",
     "correctness": "1.0"
    },
    {
     "id": 965474,
     "content_html": "To bypass legal regulations and guidelines",
     "correctness": "0.0"
    },
    {
     "id": 965475,
     "content_html": "To collect data without the knowledge of individuals",
     "correctness": "0.0"
    },
    {
     "id": 965476,
     "content_html": "To speed up the data collection process",
     "correctness": "0.0"
    }
   ],
