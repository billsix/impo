 "questions": [
  {
   "id": 493749,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a convolutional neural network (CNN), and in which scenarios might it perform better than standard neural networks?",
   "answers": [
    {
     "id": 977735,
     "content_html": "A CNN is a type of neural network designed to process sequential data, and it is particularly effective for tasks like language translation and text generation.",
     "correctness": "0.0"
    },
    {
     "id": 977736,
     "content_html": "A CNN is a type of neural network that includes recurrent layers, making it suitable for time series prediction and speech recognition.",
     "correctness": "0.0"
    },
    {
     "id": 977737,
     "content_html": "A CNN is a type of neural network that uses convolutional layers to process grid-like data structures, such as images, and is particularly effective for tasks like image classification, object detection, and recognizing spatial relationships.",
     "correctness": "1.0"
    },
    {
     "id": 977738,
     "content_html": "A CNN is a type of neural network that relies on decision trees, and it is particularly effective for classification tasks involving structured tabular data.",
     "correctness": "0.0"
    }
   ],
