   "id": 464190,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Applying universal design principles in data visualization and data source attribution helps ensure that people in which group are able to view and use the data?",
   "answers": [
    {
     "id": 965353,
     "content_html": "People with visual impairments",
     "correctness": "0.0"
    },
    {
     "id": 965354,
     "content_html": "People with cognitive impairments",
     "correctness": "0.0"
    },
    {
     "id": 965355,
     "content_html": "People with auditory impairments",
     "correctness": "0.0"
    },
    {
     "id": 965356,
     "content_html": "Any person who will use the data",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Universal design helps not only those with impairments, but anyone who will use the data. The data visualization and source attribution can be understood and accessed by all individuals regardless of their abilities or disabilities. This promotes inclusivity and equal access to information for all individuals."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Any person who will use the data"
    }
   ],
