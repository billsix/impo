 "questions": [
  {
   "id": 464187,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The admissions team of a large university would like to conduct research on which factors contribute the most to student success, thereby improving their selection process for new students. The dataset that they plan to use has numerical features such as high school GPA and scores on standardized tests as well as categorical features such as name, address, email address, and whether they played sports or did other extracurricular activities. The analysis of the data will be done by a team that involves student workers. Which of these features should be anonymized before the student workers can get to work?",
   "answers": [
    {
     "id": 965341,
     "content_html": "Name, address, and email address",
     "correctness": "1.0"
    },
    {
     "id": 965342,
     "content_html": "High school GPA and scores on standardized tests",
     "correctness": "0.0"
    },
    {
     "id": 965343,
     "content_html": "Sports and extracurricular activities",
     "correctness": "0.0"
    },
    {
     "id": 965344,
     "content_html": "None of the data should be anonymized",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This is necessary to protect the privacy of the students and comply with data protection regulations. As these features directly identify the individuals, they should be removed or replaced with generic labels in order to protect their personal information from being accessed by unauthorized individuals."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Name, address, and email address"
    }
   ],
   "community_solutions": []
  }
 ],
