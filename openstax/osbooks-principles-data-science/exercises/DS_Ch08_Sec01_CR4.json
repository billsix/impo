 "questions": [
  {
   "id": 464177,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What could be a serious consequence of a data security breach during the development process of a data science project?",
   "answers": [
    {
     "id": 965302,
     "content_html": "Unauthorized access to sensitive information",
     "correctness": "0.0"
    },
    {
     "id": 965303,
     "content_html": "Alteration or destruction of data",
     "correctness": "0.0"
    },
    {
     "id": 965304,
     "content_html": "Risk of legal issues",
     "correctness": "0.0"
    },
    {
     "id": 965305,
     "content_html": "All of the above",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This is because a data security breach during the development process of a data science project could lead to unauthorized access to sensitive information such as personal or financial data or alterations or destruction of data, which could impede the accuracy and reliability of the project. It could also result in legal consequences and damages to the company's reputation."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "All of the above"
    }
   ],
   "community_solutions": []
  }
 ],
