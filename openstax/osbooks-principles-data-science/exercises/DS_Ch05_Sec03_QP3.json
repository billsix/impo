   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Since the missing data is due to different reporting policies on different days of the week, an SMA window of 7 days is most appropriate."
    },
    {
     "images": [],
     "solution_type": "summary",
