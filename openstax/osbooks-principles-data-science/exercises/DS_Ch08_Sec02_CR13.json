   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is it important to monitor and regularly test algorithms for any potential bias?",
   "answers": [
    {
     "id": 965337,
     "content_html": "To ensure models are not overfitting",
     "correctness": "1.0"
    },
    {
     "id": 965338,
     "content_html": "To maintain the accuracy of the model",
     "correctness": "0.0"
    },
    {
     "id": 965339,
     "content_html": "To uphold fairness and equity in the decision-making process",
     "correctness": "0.0"
    },
    {
     "id": 965340,
     "content_html": "To avoid legal consequences",
     "correctness": "0.0"
    }
   ],
