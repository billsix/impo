  {
   "id": 510768,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Use the model to predict the world record fastest time for the 100 m spring in 2023. In August of 2023, Noah Lyles ran the 100 m sprint in 9.83 seconds. How does your prediction compare to this value?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "9.60. This is only about 2.3% off from the actual value of 9.83."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Using <span data-math=\"x=123\"></span> (years after 1900 for the year 2023), <span data-math=\"\\widehat y=-0.00769(123)+10.55=9.60\"></span>.<br>\nRelative Error: <span data-math=\"{\\vert9.83-9.60\\vert}/9.83=0.023\"></span>, or 2.3%"
    }
   ],
   "community_solutions": []
  }
