   "id": 488729,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following are valid sources of data for a data science project? Select all that apply.",
   "answers": [
    {
     "id": 974096,
     "content_html": "Public datasets",
     "correctness": "0.0"
    },
    {
     "id": 974097,
     "content_html": "Private databases from unaffiliated sources",
     "correctness": "0.0"
    },
    {
     "id": 974098,
     "content_html": "Open repositories such as Kaggle.com and OpenML",
     "correctness": "0.0"
    },
    {
     "id": 974099,
     "content_html": "All of the above",
     "correctness": "1.0"
    }
   ],
   "hints": [],
