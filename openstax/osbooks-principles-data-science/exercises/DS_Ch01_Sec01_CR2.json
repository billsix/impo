 "questions": [
  {
   "id": 490074,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the evolution of data management in the data science process?",
   "answers": [
    {
     "id": 975035,
     "content_html": "Initially, data was stored locally on individual computers, but with the advent of cloud-based systems, data is now stored on designated servers outside of local storage.",
     "correctness": "1.0"
    },
    {
     "id": 975036,
     "content_html": "Data management has remained static over time, with most data scientists continuing to store and process data locally on individual computers.",
     "correctness": "0.0"
    },
    {
     "id": 975037,
     "content_html": "The need for data management arose as a result of structured data becoming unmanageable, leading to the development of cloud-based systems for data storage.",
     "correctness": "0.0"
    },
    {
     "id": 975038,
     "content_html": "Data management systems have primarily focused on analysis rather than processing, resulting in the development of modern data warehousing solutions.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Data storage evolved from local to cloud-based systems for a variety of reasons, including increasing complexity of data, security concerns, reliability, etc. Option b) fails to recognize the evolution of data storage. Option c) incorrectly focuses on structured data as the sole reason for data storage solutions changing over time. Option d) incorrectly suggests that analysis of data was a driving factor in the evolution of data storage."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Initially, data was stored locally on individual computers, but with the advent of cloud-based systems, data is now stored on designated servers outside of local storage."
    }
   ],
   "community_solutions": []
  }
