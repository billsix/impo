  {
   "id": 616877,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  of the following is the reason given for the decision in this case?",
   "answers": [
    {
     "id": 1174731,
     "content_html": "Presidential privilege must supersede the need for evidence in a criminal trial."
    },
    {
     "id": 1174730,
     "content_html": "Due process and presidential privilege are mutually exclusive."
    },
    {
     "id": 1174732,
     "content_html": "Full disclosure of all facts is required for the judicial system to function properly."
    },
    {
     "id": 1174729,
     "content_html": "Public confidence in the presidency must be maintained."
    }
   ],
