     "id": 1174726,
     "content_html": "the bombing of Cambodia"
    },
    {
     "id": 1174728,
     "content_html": "President Nixon’s refusal to hand over the White House tapes"
    },
    {
     "id": 1174725,
     "content_html": "the firing of Special Prosecutor Archibald Cox"
    }
   ],
