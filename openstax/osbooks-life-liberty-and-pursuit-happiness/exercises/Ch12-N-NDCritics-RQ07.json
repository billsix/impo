   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The creation of agencies such as the Tennessee Valley Authority, the Agricultural Adjustment Administration, and the Civil Works Administration caused controversy primarily because they",
   "answers": [
    {
     "id": 1172673,
     "content_html": "challenged the traditionally understood role of the federal government in the economy"
    },
    {
     "id": 1172672,
     "content_html": "favored urban areas more than rural areas"
    },
    {
     "id": 1172671,
     "content_html": "were more popular with Democratic than Republican voters"
    },
    {
     "id": 1172670,
     "content_html": "drew major support from east of the Mississippi River"
    }
