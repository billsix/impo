 "questions": [
  {
   "id": 615908,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Reasons for the retreat from the goals of Reconstruction during the late nineteenth century included",
   "answers": [
    {
     "id": 1171600,
     "content_html": "achievement of political equality for freedmen with the passage of the Thirteenth, Fourteenth, and Fifteenth Amendments"
    },
    {
     "id": 1171601,
     "content_html": "loss of national interest in the “race question” as the industrial revolution took hold"
    },
    {
     "id": 1171599,
     "content_html": "greater national diversity as millions of African Americans left the South for northern cities"
    },
    {
     "id": 1171598,
     "content_html": "Homer Plessy’s successful challenge to segregation in the U.S. Supreme Court"
    }
   ],
