 "stimulus_html": "<figure>\n<img src=\"exercises/media/fc5d9cb85aa28030.png\" alt=\"Cartoon of King Andrew the First in kingly robes, holding a veto scroll with torn scraps of the Constitution at his feet.\" id=\"Figure6_10\">\n\n<figcaption><i>King Andrew the First</i>, created by an unknown artist c. 1833.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 615291,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the political cartoon, the intention of the artist is to",
   "answers": [
    {
     "id": 1169136,
     "content_html": "praise President Jackson for his strong and effective leadership while in office"
    },
    {
     "id": 1169135,
     "content_html": "support President Jackson’s use of the veto to “protect the common man”"
    },
    {
     "id": 1169137,
     "content_html": "illustrate belief that President Jackson abused his power as president"
    },
    {
     "id": 1169134,
     "content_html": "propose that Jackson should serve as president for life"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615292,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "People who agree with the sentiments expressed in the political cartoon would most likely support",
   "answers": [
    {
     "id": 1169140,
     "content_html": "the spread of slavery into the western territories"
    },
    {
     "id": 1169139,
     "content_html": "an increase in the tariff rates"
    },
    {
     "id": 1169138,
     "content_html": "the protection of American Indians from federal government interference"
    },
    {
     "id": 1169141,
     "content_html": "the formation of the Whig Party"
    }
   ],
