   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In his 1829 first inaugural address, President Jackson laid out his belief that the best policy toward American Indians was to",
   "answers": [
    {
     "id": 1169236,
     "content_html": "assist American Indians in the adoption of agriculture"
    },
    {
     "id": 1169237,
     "content_html": "set aside land west of the Mississippi for American Indians’ control and use"
    },
    {
     "id": 1169235,
     "content_html": "declare war on the Five Civilized Tribes"
    },
    {
     "id": 1169234,
     "content_html": "allow the Supreme Court to rule on the legality of their claim to land in the southeast"
    }
   ],
