   "stimulus_html": "",
   "stem_html": "Ignatius Donnelly, the author of the preamble to the Omaha Platform, inspired Populist voters with his",
   "answers": [
    {
     "id": 1170556,
     "content_html": "call for racial unity to break the dominance of the Democratic Party in the South"
    },
    {
     "id": 1170555,
     "content_html": "embrace of “sound money” as the key to prosperity for all"
    },
    {
     "id": 1170557,
     "content_html": "dramatic imagery of a nation divided between rich and poor"
    },
    {
     "id": 1170554,
     "content_html": "criticism of immigrants as the source of America’s problems"
    }
   ],
