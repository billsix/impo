   "id": 616266,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following would President Truman have found a valid reason to forego using atomic weapons on Japan?",
   "answers": [
    {
     "id": 1173031,
     "content_html": "It would anger the Soviet Union."
    },
    {
     "id": 1173032,
     "content_html": "It would turn global opinion against the United States."
    },
    {
     "id": 1173030,
     "content_html": "It would lead to his loss in the next presidential election."
    },
    {
     "id": 1173029,
     "content_html": "Scientists and military generals advised against their use."
    }
   ],
