   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The  U.S. Supreme Court’s <i>Dred Scott</i> decision in 1857 marked",
   "answers": [
    {
     "id": 1169644,
     "content_html": "a continuation of Supreme Court’s challenges to the institution of slavery in the 1850s"
    },
    {
     "id": 1169645,
     "content_html": "an attempt by the Supreme Court to resolve the issue of slavery that Congress had sought to reconcile through compromise"
    },
    {
     "id": 1169643,
     "content_html": "a reversal of decades of judicial activism by the Supreme Court"
    },
    {
     "id": 1169642,
     "content_html": "the catalyst that led to the creation of the Republican Party"
    }
   ],
