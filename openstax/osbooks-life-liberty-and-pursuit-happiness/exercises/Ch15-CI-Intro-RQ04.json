 "questions": [
  {
   "id": 616796,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The reaction of Democratic mayors toward President Johnson during the post-King assassination riots is best described as",
   "answers": [
    {
     "id": 1174407,
     "content_html": "grateful for the support of the federal government in calming the riots"
    },
    {
     "id": 1174406,
     "content_html": "mournful as a result of the many deaths that occurred in major cities"
    },
    {
     "id": 1174408,
     "content_html": "unsupportive because they considered Johnson “soft” on crime"
    },
    {
     "id": 1174405,
     "content_html": "thankful for the use of the National Guard"
    }
   ],
