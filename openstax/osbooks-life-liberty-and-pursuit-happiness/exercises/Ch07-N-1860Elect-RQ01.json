   "stimulus_html": "",
   "stem_html": "Illinois’s Stephen Douglas was considered the frontrunner to secure the Democratic presidential nomination in 1860 due to his political experience and ",
   "answers": [
    {
     "id": 1170080,
     "content_html": "his domination of Abraham Lincoln in the 1858 debates\n"
    },
    {
     "id": 1170079,
     "content_html": "the overwhelming support of southern Democrats after the <i>Dred Scott</i> decision\n"
    },
    {
     "id": 1170081,
     "content_html": "his support for popular sovereignty in drafting the Kansas-Nebraska Act\n"
    },
    {
     "id": 1170078,
     "content_html": "his call to end the prohibition on importing enslaved persons\n"
    }
   ],
