   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was not a weakness of the Articles of Confederation?",
   "answers": [
    {
     "id": 1167532,
     "content_html": "Inability of the federal government to levy taxes"
    },
    {
     "id": 1167531,
     "content_html": "Lack of control over interstate commerce"
    },
    {
     "id": 1167530,
     "content_html": "Weak legislative body requiring unanimous consent to change the Articles"
    },
    {
     "id": 1167533,
     "content_html": "Strong executive branch that vetoed laws from the legislative branch"
    }
   ],
