 "questions": [
  {
   "id": 614898,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One advantage the Federalists had during the ratification debate was that",
   "answers": [
    {
     "id": 1167564,
     "content_html": "many smaller state governments were open to the concept of a stronger federal government"
    },
    {
     "id": 1167565,
     "content_html": "highly organized authors published essay after essay supporting and explaining the new form of government"
    },
    {
     "id": 1167563,
     "content_html": "the large and influential states of New York and Virginia were eager to ratify the Constitution as soon as possible"
    },
    {
     "id": 1167562,
     "content_html": "almost unanimous support for the Constitution existed in every state"
    }
   ],
