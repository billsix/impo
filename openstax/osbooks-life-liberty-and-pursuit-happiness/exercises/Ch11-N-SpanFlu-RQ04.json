  {
   "id": 616046,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The quote “it is our duty to keep the people from fear. Worry kills more people than the epidemic” from Chicago Public Health Commissioner John Dill Robertson is related to what policy of the U.S. government?",
   "answers": [
    {
     "id": 1172153,
     "content_html": "Wartime censorship of news concerning the Spanish flu"
    },
    {
     "id": 1172152,
     "content_html": "The need for the medical profession to bring an end to the epidemic"
    },
    {
     "id": 1172151,
     "content_html": "Encouragement of accurate reporting regarding the epidemic"
    },
    {
     "id": 1172150,
     "content_html": "Temporary halting of migration"
    }
   ],
