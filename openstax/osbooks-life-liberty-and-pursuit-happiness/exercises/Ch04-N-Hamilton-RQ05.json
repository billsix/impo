 "questions": [
  {
   "id": 615051,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following were reasons presented in favor of the Bank of the United States except",
   "answers": [
    {
     "id": 1168176,
     "content_html": "the Continental Congress had been unable to pay soldiers during the Revolution"
    },
    {
     "id": 1168175,
     "content_html": "the Bank would be a depository for government tax revenue"
    },
    {
     "id": 1168174,
     "content_html": "the Bank was absolutely required for the United States to be able to conduct its business"
    },
    {
     "id": 1168177,
     "content_html": "the Bank would provide a source of funding for the U.S. government to purchase vast amounts of territory from foreign powers"
    }
   ],
