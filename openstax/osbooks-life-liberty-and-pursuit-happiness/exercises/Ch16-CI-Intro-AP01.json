   "stem_html": "What historical phenomenon most directly caused the trends seen in the charts?",
   "answers": [
    {
     "id": 1175076,
     "content_html": "Changing gender roles"
    },
    {
     "id": 1175075,
     "content_html": "Expanding number of jobs in defense-related industries"
    },
    {
     "id": 1175074,
     "content_html": "Increased immigration from Latin America and Asia"
    },
    {
     "id": 1175073,
     "content_html": "Technological innovation"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616964,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which was a direct result of the trends demonstrated in the charts?",
   "answers": [
    {
     "id": 1175079,
     "content_html": "Energy independence fueled job growth in the second half of the twentieth century."
    },
    {
     "id": 1175078,
     "content_html": "Affordable childcare ceased to be a political issue."
    },
    {
     "id": 1175077,
     "content_html": "Pay equality was achieved by 2000."
    },
    {
     "id": 1175080,
     "content_html": "Challenges arose to the continued funding of the welfare programs."
    }
   ],
   "hints": [],
