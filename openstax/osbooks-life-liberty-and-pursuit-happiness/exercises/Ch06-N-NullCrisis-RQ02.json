 "questions": [
  {
   "id": 615296,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the predominant Southern opinion of protectionist tariffs?",
   "answers": [
    {
     "id": 1169157,
     "content_html": "Southerners resented tariffs because they raised the cost of imported foreign goods and invited retaliatory tariffs that lowered foreign demand for their agricultural exports."
    },
    {
     "id": 1169156,
     "content_html": "Southerners supported protectionist tariffs because they also benefited from expanding U.S. industry."
    },
    {
     "id": 1169155,
     "content_html": "Southerners benefited from trade with European colonial powers that wished to keep the United States in an economically subordinate position."
    },
    {
     "id": 1169154,
     "content_html": "Southerners believed the Constitution explicitly denied Congress the power to pass tariffs of any kind."
    }
   ],
