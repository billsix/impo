   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "President Thomas Jefferson directed the Corps of Discovery under Meriwether Lewis to do all the following except",
   "answers": [
    {
     "id": 1168660,
     "content_html": "look for an all-water route to the Pacific Ocean"
    },
    {
     "id": 1168659,
     "content_html": "gather scientific information"
    },
    {
     "id": 1168658,
     "content_html": "inform Native Americans along the way that the land now belonged to the United States"
    },
    {
     "id": 1168661,
     "content_html": "concentrate exploration efforts to the east of the Continental Divide"
    }
   ],
