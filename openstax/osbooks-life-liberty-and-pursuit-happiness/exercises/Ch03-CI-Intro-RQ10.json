 "questions": [
  {
   "id": 614815,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the evolution of American colonists desiring independence?",
   "answers": [
    {
     "id": 1167233,
     "content_html": "Immediately after the French and Indian War, American colonists realized they would be better served economically and politically by full independence and advocated for it."
    },
    {
     "id": 1167232,
     "content_html": "After the British government passed the first direct tax, American colonists created a delegation to discuss and legislate independence."
    },
    {
     "id": 1167231,
     "content_html": "After the Declaration of Independence was agreed upon by committee members, all American colonists thoroughly supported the War for Independence."
    },
    {
     "id": 1167234,
     "content_html": "Incremental shifts toward independence were not complete even during the Revolution, because tens of thousands of American colonists remained loyal to Britain."
    }
   ],
