   "id": 614565,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The long-term effects of de Soto’s expedition to the American Southeast included all the following except",
   "answers": [
    {
     "id": 1166233,
     "content_html": "the introduction of European diseases\n"
    },
    {
     "id": 1166232,
     "content_html": "limited Spanish settlement in Florida throughout the colonial period\n"
    },
    {
     "id": 1166231,
     "content_html": "a precedent for Native American and European interactions\n"
    },
    {
     "id": 1166234,
     "content_html": "increased enthusiasm among future conquistadores to explore the region further\n"
    }
   ],
