    {
     "id": 1173075,
     "content_html": "To stop renewed German aggression"
    },
    {
     "id": 1173076,
     "content_html": "To halt Soviet aggression despite the wartime alliance"
    },
    {
     "id": 1173074,
     "content_html": "To help the British relinquish their empire"
    },
    {
