 "questions": [
  {
   "id": 614864,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the condition of Washington’s army in 1776?",
   "answers": [
    {
     "id": 1167429,
     "content_html": "Very well trained and disciplined, easily capable of meeting the British on an open battlefield"
    },
    {
     "id": 1167430,
     "content_html": "Malnourished, undersupplied, vulnerable to sickness, but inspired by their leader"
    },
    {
     "id": 1167428,
     "content_html": "A steady flow of new volunteers providing Washington with a very large and talented military"
    },
    {
     "id": 1167427,
     "content_html": "Mixture of American Indians, African Americans, and British colonists who worked well together, promoting new ideas of equality for the young nation"
    }
   ],
