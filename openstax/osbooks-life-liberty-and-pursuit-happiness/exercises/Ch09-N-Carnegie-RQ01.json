   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement about Andrew Carnegie and J. P. Morgan is correct?",
   "answers": [
    {
     "id": 1170436,
     "content_html": "Carnegie was born into a wealthy family and Morgan was not."
    },
    {
     "id": 1170435,
     "content_html": "Both men were from wealthy families."
    },
    {
     "id": 1170434,
     "content_html": "Both men lived “‘rags to riches’” stories."
    },
    {
     "id": 1170437,
     "content_html": "Morgan was from a wealthy family and Carnegie was not."
    }
