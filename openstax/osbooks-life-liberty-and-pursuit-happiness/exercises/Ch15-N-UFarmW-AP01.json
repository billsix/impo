     "id": 1174875,
     "content_html": "Undocumented immigration"
    },
    {
     "id": 1174874,
     "content_html": "Integration of the military"
    },
    {
     "id": 1174876,
     "content_html": "Lack of civil rights for farm laborers"
    },
    {
     "id": 1174873,
     "content_html": "Union disputes"
    }
   ],
