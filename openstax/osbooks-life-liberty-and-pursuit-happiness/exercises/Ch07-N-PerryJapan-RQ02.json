   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why  did the Japanese government agree to any of Commodore Perry’s demands? ",
   "answers": [
    {
     "id": 1169896,
     "content_html": "The Japanese government wanted to end its policy of national exclusion.\n"
    },
    {
     "id": 1169895,
     "content_html": "The U.S. government agreed to pay Japan $5,000,000 to accept the treaty.\n"
    },
    {
     "id": 1169897,
     "content_html": "The Japanese government sought U.S. protection from the rising power of China.\n"
    },
    {
     "id": 1169894,
