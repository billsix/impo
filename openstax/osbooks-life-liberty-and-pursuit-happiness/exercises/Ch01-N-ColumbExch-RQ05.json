 "questions": [
  {
   "id": 614557,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the Columbian Exchange affect the Americas? ",
   "answers": [
    {
     "id": 1166201,
     "content_html": "Domesticated animals from the Old World greatly improved the productivity of Native Americans’ farms."
    },
    {
     "id": 1166202,
     "content_html": "Native Americans suffered massive causalities from Old World diseases such as smallpox."
    },
    {
     "id": 1166200,
     "content_html": "The higher caloric value of crops such as potatoes and corn improved Native Americans’ diets."
    },
    {
     "id": 1166199,
     "content_html": "Native Americans learned to domesticate animals thanks to interactions with Europeans."
    }
   ],
