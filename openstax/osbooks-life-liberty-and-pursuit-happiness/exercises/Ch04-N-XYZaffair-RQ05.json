 "questions": [
  {
   "id": 615089,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "“Millions for defense but not a cent for tribute” meant",
   "answers": [
    {
     "id": 1168328,
     "content_html": "the United States was gearing up for war with Britain on the basis of the failure of the Jay Treaty"
    },
    {
     "id": 1168327,
     "content_html": "many citizens wanted a larger navy for the United States"
    },
    {
     "id": 1168329,
     "content_html": "anger over the XYZ Affair pushed the public to want war with France"
    },
    {
     "id": 1168326,
     "content_html": "the United States was insulted by Napoleon’s demands in the Convention of 1800"
    }
   ],
