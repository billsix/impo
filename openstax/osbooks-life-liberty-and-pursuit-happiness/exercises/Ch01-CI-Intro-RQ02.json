   "id": 614613,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What strategy did Hernán Cortés use to achieve victory over the Aztecs?",
   "answers": [
    {
     "id": 1166425,
     "content_html": "Large numbers of Spanish troops\n"
    },
    {
     "id": 1166424,
     "content_html": "Hot-air balloons for surveillance of the battlefield\n"
    },
    {
     "id": 1166426,
     "content_html": "Alliances with Indians who also wanted to defeat the Aztecs\n"
    },
    {
     "id": 1166423,
     "content_html": "Valuable gifts to Montezuma to persuade him not to fight\n"
    }
   ],
