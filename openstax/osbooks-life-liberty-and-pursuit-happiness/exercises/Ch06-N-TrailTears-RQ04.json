   "id": 615319,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The initial ruling of the Supreme Court in regard to American Indians stated",
   "answers": [
    {
     "id": 1169248,
     "content_html": "American Indians were citizens and had full protection under the Constitution"
    },
    {
     "id": 1169247,
     "content_html": "the various states had authority over American Indian nations within their jurisdiction"
    },
    {
     "id": 1169246,
     "content_html": "the Supreme Court had no authority over American Indian groups"
    },
    {
     "id": 1169249,
     "content_html": "Indian tribes were “domestic dependent nations” and had rights to their own land"
    }
   ],
