   "stimulus_html": "",
   "stem_html": "A  major incentive for migrants on the Oregon trail in the 1840s was",
   "answers": [
    {
     "id": 1170124,
     "content_html": "the chance to get rich in the gold fields\n"
    },
    {
     "id": 1170125,
     "content_html": "the availability of cheap land\n"
    },
    {
     "id": 1170123,
     "content_html": "the opportunity to find work building railroads\n"
    },
    {
     "id": 1170122,
     "content_html": "the need for workers in the steel industry\n"
    }
