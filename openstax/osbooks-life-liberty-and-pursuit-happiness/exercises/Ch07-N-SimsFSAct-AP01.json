 "is_vocab": false,
 "stimulus_html": "<p>“Sect. 15. Any sheriff, deputy sheriff, jailer, coroner, constable or other officer of this Commonwealth, or the police of any city or town, or any district, county, city or town officer, or any officer or other member of the volunteer militia of this Commonwealth, who shall hereafter arrest, imprison, detain or return, or aid in arresting, imprisoning, detaining or returning, any person for the reason that he is claimed or adjudged to be a fugitive from service or labor, shall be punished by fine not less than one thousand, and not exceeding two thousand dollars, and by imprisonment in the State Prison for not less than one, nor more than two, years.</p>\n<p>Sect. 16. The volunteer militia of this Commonwealth shall not act in any manner in the seizure, detention or rendition of any person for the reason that he is claimed or adjudged to be a fugitive from service or labor. . . . </p>\n<p>Sect. 19. No jail, prison, or other place of confinement belonging to, or used by, either the Commonwealth of Massachusetts or any county therein, shall be used for the detention or imprisonment of any person accused or convicted of any offence created by either of the said acts of congress mentioned . . .”</p>\n<p align=\"right\">Chap. 0489 An Act to protect the Rights and Liberties of the People of the Commonwealth of Massachusetts, 1855</p>\n<p><i>Refer to the excerpt provided.</i></p>",
 "questions": [
  {
   "id": 615468,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What  was a direct result of the provisions of the act in the excerpt",
   "answers": [
    {
     "id": 1169844,
     "content_html": "Massachusetts provided for gradual emancipation of slaves still living in the state.\n"
    },
    {
     "id": 1169843,
     "content_html": "Massachusetts outlawed abolitionist activities.\n"
    },
    {
     "id": 1169845,
     "content_html": "Massachusetts refused to enforce provisions of a federal law.\n"
    },
    {
     "id": 1169842,
     "content_html": "Massachusetts abolished slavery within its borders.\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615469,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This  act was written in response to",
   "answers": [
    {
     "id": 1169848,
     "content_html": "the declaration of war on Mexico\n"
    },
    {
     "id": 1169849,
     "content_html": "the Compromise of 1850\n"
    },
    {
     "id": 1169847,
     "content_html": "the Kansas-Nebraska Act\n"
    },
    {
     "id": 1169846,
     "content_html": "the <i>Dred Scott</i> decision\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615470,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The  passage of the act most directly reflects which continuity in American history?",
   "answers": [
    {
     "id": 1169852,
     "content_html": "Protection of private property rights is a government responsibility.\n"
    },
    {
     "id": 1169851,
     "content_html": "Different labor systems develop to meet the growing needs of the nation.\n"
    },
    {
     "id": 1169850,
     "content_html": "Internal migrations lead to tensions between the native and new populations.\n"
    },
    {
     "id": 1169853,
     "content_html": "Reserved powers of the states are balanced against the delegated power of the federal government.\n"
    }
   ],
