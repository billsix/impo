     "id": 1169453,
     "content_html": "the 1795 U.S. treaty with Spain"
    },
    {
     "id": 1169452,
     "content_html": "the Declaration of Independence"
    },
    {
     "id": 1169451,
     "content_html": "the Law of Nature and of Nature’s God"
    },
    {
     "id": 1169450,
     "content_html": "the example set by their predecessors on the Court, such as Chief Justice John Marshall"
    }
