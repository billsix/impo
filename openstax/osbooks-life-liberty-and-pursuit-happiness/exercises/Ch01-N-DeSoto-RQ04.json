 "questions": [
  {
   "id": 614564,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How were conquistadores like de Soto and Pizarro able to defeat and conquer the Inca?",
   "answers": [
    {
     "id": 1166229,
     "content_html": "Conquistadors had superior numbers of soldiers compared with the Inca.\n"
    },
    {
     "id": 1166230,
     "content_html": "Conquistadors had more advanced weapons than the Inca.\n"
    },
    {
     "id": 1166228,
     "content_html": "Conquistadors used the wealth gained from the Aztecs to defeat the Inca.\n"
    },
    {
     "id": 1166227,
     "content_html": "Conquistadors enslaved tribes that were rivals of the Inca to use as soldiers and defeat the Inca.\n"
    }
   ],
