 "questions": [
  {
   "id": 614859,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Declaration of Independence did not include",
   "answers": [
    {
     "id": 1167409,
     "content_html": "a list of grievances against the king"
    },
    {
     "id": 1167408,
     "content_html": "a statement of political theory articulating that the government was responsible to the people"
    },
    {
     "id": 1167407,
     "content_html": "a list of signatures that made the signers vulnerable to prosecution for treason if they lost the war or were captured"
    },
    {
     "id": 1167410,
     "content_html": "an Olive Branch Petition listing conditions that, if met by the British, would result in the colonists’ withdrawing the Declaration"
    }
   ],
