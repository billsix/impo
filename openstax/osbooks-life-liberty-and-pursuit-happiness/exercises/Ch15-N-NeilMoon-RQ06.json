   "id": 616821,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One major difference between the Soviet system and its space program and the U.S. system and space program was that the Soviets militarized their program and the United States primarily allowed for",
   "answers": [
    {
     "id": 1174507,
     "content_html": "a democratically elected government to make space policy"
    },
    {
     "id": 1174508,
     "content_html": "interplay between private markets and government to make space policy"
    },
    {
     "id": 1174506,
     "content_html": "no military influence in its space program"
    },
    {
     "id": 1174505,
     "content_html": "complete privatization of the space program"
    }
