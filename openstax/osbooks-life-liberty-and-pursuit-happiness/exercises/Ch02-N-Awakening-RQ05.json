   "id": 614719,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Who were the “New Lights”?",
   "answers": [
    {
     "id": 1166849,
     "content_html": "Critics who thought the emotional appeal of the evangelical ministers was foolish and led to social chaos"
    },
    {
     "id": 1166850,
     "content_html": "Followers of Great Awakening evangelical preachers whose sermons were notable for their emotion and dramatic appeal"
    },
    {
     "id": 1166848,
     "content_html": "People interested in Enlightenment interpretations of the Bible"
    },
    {
     "id": 1166847,
     "content_html": "Enlightenment preachers who wanted to introduce their parishioners to concepts such as deism"
    }
   ],
