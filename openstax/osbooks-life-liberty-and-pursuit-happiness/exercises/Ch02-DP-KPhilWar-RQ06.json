   "id": 614757,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the New England region, all the following were direct effects of King Philip’s War except",
   "answers": [
    {
     "id": 1167001,
     "content_html": "American Indians were driven out of their villages."
    },
    {
     "id": 1167000,
     "content_html": "Colonists’ homes were ransacked and destroyed in many frontier locations."
    },
    {
     "id": 1166999,
     "content_html": "The king of England restricted the colonists’ freedom."
    },
    {
     "id": 1167002,
     "content_html": "French colonists from Quebec united with the English to defeat the American Indians."
    }
   ],
