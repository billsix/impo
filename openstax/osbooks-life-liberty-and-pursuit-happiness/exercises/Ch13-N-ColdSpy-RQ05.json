   "stimulus_html": "",
   "stem_html": "Whitaker Chambers’ claims that Alger Hiss was a spy were",
   "answers": [
    {
     "id": 1173324,
     "content_html": "found to be true by the verification of other witnesses"
    },
    {
     "id": 1173323,
     "content_html": "proven false with evidence presented by Alger Hiss"
    },
    {
     "id": 1173322,
     "content_html": "declared inadmissible during the court proceedings"
    },
    {
     "id": 1173321,
     "content_html": "ignored, though Alger Hiss was still convicted of espionage"
    }
