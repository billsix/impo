   "stimulus_html": "",
   "stem_html": "President Truman decided to use the atomic bombs against Japan because",
   "answers": [
    {
     "id": 1173035,
     "content_html": "he personally considered the Japanese to be racially inferior"
    },
    {
     "id": 1173034,
     "content_html": "he wanted to totally destroy the Japanese economy"
    },
    {
     "id": 1173033,
     "content_html": "he sought revenge for Pearl Harbor"
    },
    {
     "id": 1173036,
     "content_html": "he feared the civilian and military cost of an invasion of the Japanese home islands"
    }
