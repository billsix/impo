   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Once in the Salt Lake Valley, during the first two winters of settlement, the Mormons",
   "answers": [
    {
     "id": 1169217,
     "content_html": "overcame hardship to establish a prosperous settlement"
    },
    {
     "id": 1169214,
     "content_html": "almost all died due to Indian attack, harsh weather, and lack of food"
    },
    {
     "id": 1169215,
     "content_html": "abandoned the settlement and returned east, only to return when winters were milder"
    },
    {
     "id": 1169216,
     "content_html": "made the short trek to claim vast gold deposits in California during the Gold Rush a few years later."
    }
   ],
