   "id": 616604,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The federal government’s response to the freedom rides was characterized generally by",
   "answers": [
    {
     "id": 1173955,
     "content_html": "overwhelming support, including federal protection of the riders"
    },
    {
     "id": 1173954,
     "content_html": "the full support of Attorney General Robert F. Kennedy and President John F. Kennedy, but not of Congress"
    },
    {
     "id": 1173956,
     "content_html": "observation and information gathering but limited actual support"
    },
    {
     "id": 1173953,
     "content_html": "official training in nonviolent tactics but little overt support"
    }
   ],
