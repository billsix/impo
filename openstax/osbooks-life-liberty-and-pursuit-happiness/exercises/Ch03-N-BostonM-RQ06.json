   "id": 614844,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was Britain’s direct response to the Boston Massacre?",
   "answers": [
    {
     "id": 1167349,
     "content_html": "Passage of the Declaratory Act, reasserting British jurisdiction over the colonies"
    },
    {
     "id": 1167348,
     "content_html": "Closing of Boston Harbor in retaliation for colonial economic protest"
    },
    {
     "id": 1167350,
     "content_html": "Repeal of all Townsend Act taxes except the one on tea"
    },
    {
     "id": 1167347,
     "content_html": "Awarding of religious freedom to French-Canadian colonists under British rule"
    }
   ],
