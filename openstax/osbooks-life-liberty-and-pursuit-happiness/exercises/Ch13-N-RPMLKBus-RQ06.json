   "stimulus_html": "",
   "stem_html": "All the following resulted from the Montgomery bus boycott except",
   "answers": [
    {
     "id": 1173463,
     "content_html": "the formation of the Southern Christian Leadership Conference (SCLC)"
    },
    {
     "id": 1173462,
     "content_html": "the emergence of Martin Luther King Jr. as a national leader"
    },
    {
     "id": 1173464,
     "content_html": "the immediate end of Jim Crow laws in Alabama"
    },
    {
     "id": 1173461,
     "content_html": "negative national publicity for the city of Montgomery"
    }
