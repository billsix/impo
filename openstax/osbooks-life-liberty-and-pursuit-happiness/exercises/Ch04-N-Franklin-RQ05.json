   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the strongest constitutional approach available to those who supported the abolition of slavery in the United States in the late eighteenth century?",
   "answers": [
    {
     "id": 1168232,
     "content_html": "The immorality of the institution of slavery"
    },
    {
     "id": 1168231,
     "content_html": "Growing public opinion that slavery should be abolished"
    },
    {
     "id": 1168233,
     "content_html": "The use of the general welfare and necessary and proper clauses in the Constitution"
    },
    {
     "id": 1168230,
     "content_html": "The support of political leaders from all regions of the United States"
    }
