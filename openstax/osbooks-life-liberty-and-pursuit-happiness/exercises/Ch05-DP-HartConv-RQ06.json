   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Hartford Convention’s recommendations and the Declaration of Independence are similar because they both",
   "answers": [
    {
     "id": 1169016,
     "content_html": "called for violent secession from the ruling government"
    },
    {
     "id": 1169015,
     "content_html": "called for amending the U.S. Constitution"
    },
    {
     "id": 1169014,
     "content_html": "laid the primary blame for the conflict on the king of England"
    },
    {
     "id": 1169017,
     "content_html": "included a list of grievances against the ruling government"
    }
   ],
