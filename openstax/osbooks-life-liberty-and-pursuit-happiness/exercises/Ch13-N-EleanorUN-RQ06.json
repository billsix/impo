 "questions": [
  {
   "id": 616304,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In regard to American policy, a major difference between the founding of the League of Nations and that of the United Nations was that",
   "answers": [
    {
     "id": 1173183,
     "content_html": "the United States had no relationship with the League of Nations"
    },
    {
     "id": 1173184,
     "content_html": "the U.S. Senate voted overwhelmingly to ratify the United Nations charter"
    },
    {
     "id": 1173182,
     "content_html": "the American people did not want the United States to join the United Nations"
    },
    {
     "id": 1173181,
     "content_html": "Americans accepted that U.N. policy would influence American foreign policy"
    }
   ],
