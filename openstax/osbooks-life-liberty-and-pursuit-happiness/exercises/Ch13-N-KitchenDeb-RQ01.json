   "stimulus_html": "",
   "stem_html": "The discussions between Nixon and Khrushchev in July 1959 are often referred to as the “Kitchen Debate” because they",
   "answers": [
    {
     "id": 1173660,
     "content_html": "took place in the kitchen of a model U.S. home in Moscow"
    },
    {
     "id": 1173659,
     "content_html": "occurred in the kitchen of the White House"
    },
    {
     "id": 1173658,
     "content_html": "were held in the home of the British historian Martin Kitchen"
    },
    {
     "id": 1173657,
     "content_html": "happened in the kitchen of Khrushchev’s country estate"
    }
