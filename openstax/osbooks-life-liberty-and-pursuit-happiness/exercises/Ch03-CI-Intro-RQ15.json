   "id": 614820,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Articles of Confederation were designed to",
   "answers": [
    {
     "id": 1167254,
     "content_html": "maintain state sovereignty, preventing the usurpation of power by a central government while allowing the states to function as a unit in military and diplomatic matters"
    },
    {
     "id": 1167253,
     "content_html": "create a strong federal government that could unify the states as a nation"
    },
    {
     "id": 1167252,
     "content_html": "mimic the powers of the British Crown, without the ability to tax"
    },
    {
     "id": 1167251,
     "content_html": "give a voice to each citizen of the United States regardless of race and gender"
    }
   ],
