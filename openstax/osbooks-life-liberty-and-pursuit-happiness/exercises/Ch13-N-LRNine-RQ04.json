 "questions": [
  {
   "id": 616381,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The result of the Little Rock Nine case was that",
   "answers": [
    {
     "id": 1173491,
     "content_html": "segregation throughout the South followed immediately"
    },
    {
     "id": 1173490,
     "content_html": "the Supreme Court rescinded its “by all deliberate speed” requirement"
    },
    {
     "id": 1173492,
     "content_html": "many public schools in the South did not integrate for more than a decade"
    },
    {
     "id": 1173489,
     "content_html": "the president called in troops several times across the South to enforce integration"
    }
   ],
