 "questions": [
  {
   "id": 615583,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best describes the change in the nature of work in the United States during the nineteenth century?",
   "answers": [
    {
     "id": 1170301,
     "content_html": "The factory system required workers to conform to schedules that maximized efficiency."
    },
    {
     "id": 1170300,
     "content_html": "Employers accepted the development of labor unions and provided more benefits for their employees."
    },
    {
     "id": 1170299,
     "content_html": "The workplace became safer and more conducive to productivity because of new opportunities for personal connection between workers and managers."
    },
    {
     "id": 1170298,
     "content_html": "The age of artisan specialization began."
    }
   ],
