 "questions": [
  {
   "id": 614870,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the Continental Army successfully thwart the British in the forests of New York?",
   "answers": [
    {
     "id": 1167452,
     "content_html": "Sheer force in an open meadow allowed the colonists to defeat the disciplined British in a surprise and definitive upset."
    },
    {
     "id": 1167453,
     "content_html": "They slowed progress by cutting down trees over their path and dismantling bridges, thus keeping the British from their supplies."
    },
    {
     "id": 1167451,
     "content_html": "American Indian allies of the Patriots used their considerable knowledge of the terrain to launch multiple surprise attacks."
    },
    {
     "id": 1167450,
     "content_html": "Patriots fed Loyalists false information, which led the British to make poor decisions."
    }
   ],
   "hints": [],
