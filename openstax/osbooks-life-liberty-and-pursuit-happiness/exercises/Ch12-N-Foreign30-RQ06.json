 "questions": [
  {
   "id": 616215,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Between September 1939 and the beginning of December 1941, President Roosevelt sought to help the Allies in all the following ways except",
   "answers": [
    {
     "id": 1172827,
     "content_html": "revising the Neutrality Acts to permit the sale of arms and ammunition on a cash-and-carry basis"
    },
    {
     "id": 1172826,
     "content_html": "lending war materials to countries whose survival was deemed vital to U.S. national security"
    },
    {
     "id": 1172828,
     "content_html": "organizing American volunteer units to fight Germans in France"
    },
    {
     "id": 1172825,
     "content_html": "sending U.S. naval vessels into the Atlantic on patrols to search for German submarines"
    }
   ],
