 "questions": [
  {
   "id": 614679,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the fate of Anne Hutchinson?",
   "answers": [
    {
     "id": 1166689,
     "content_html": "She became an important religious figure in Rhode Island."
    },
    {
     "id": 1166688,
     "content_html": "Roger Williams came to depend on her for running the colony of Rhode Island."
    },
    {
     "id": 1166687,
     "content_html": "She was killed by members of the Narragansett tribe in Rhode Island."
    },
    {
     "id": 1166690,
     "content_html": "She and some of her children were killed by Siwanoy Indians on Long Island."
    }
   ],
