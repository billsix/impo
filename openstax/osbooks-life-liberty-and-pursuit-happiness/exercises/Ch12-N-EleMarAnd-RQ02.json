   "id": 616203,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The 1936 presidential election is considered a “realignment” election for African American voters because they",
   "answers": [
    {
     "id": 1172780,
     "content_html": "switched their votes from the Republican Party to the Democratic Party"
    },
    {
     "id": 1172779,
     "content_html": "overwhelmingly supported the party of Lincoln in presidential elections"
    },
    {
     "id": 1172778,
     "content_html": "showed little electoral support for New Deal policies"
    },
    {
     "id": 1172777,
     "content_html": "doubled the size of their electoral turnout in the South"
    }
   ],
