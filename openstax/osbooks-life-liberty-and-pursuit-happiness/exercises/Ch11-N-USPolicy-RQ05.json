   "stimulus_html": "",
   "stem_html": "The Kellogg-Briand Pact",
   "answers": [
    {
     "id": 1172177,
     "content_html": "outlawed all offensive war"
    },
    {
     "id": 1172176,
     "content_html": "forgave Germany’s remaining war debts"
    },
    {
     "id": 1172175,
     "content_html": "limited the size of navies around the world"
    },
    {
     "id": 1172174,
     "content_html": "maintained the United States’ nonmembership in the League of Nations"
    }
