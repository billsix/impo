   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A significant difference between the gay rights movement after Stonewall and the Gay Liberation Front (GLF) was that the GLF and its allies",
   "answers": [
    {
     "id": 1174651,
     "content_html": "used popular media to make their message known"
    },
    {
     "id": 1174652,
     "content_html": "used more militant strategies in achieving their goals"
    },
    {
     "id": 1174650,
     "content_html": "ran candidates for political office to invoke change"
    },
    {
     "id": 1174649,
     "content_html": "used cultural endeavors to advance awareness of gay issues"
    }
