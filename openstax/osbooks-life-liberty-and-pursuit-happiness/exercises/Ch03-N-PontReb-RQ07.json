 "questions": [
  {
   "id": 614831,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was the primary method of warfare during Pontiac’s Rebellion?",
   "answers": [
    {
     "id": 1167295,
     "content_html": "British and American Indian groups advanced toward each other on open battlefields."
    },
    {
     "id": 1167298,
     "content_html": "American Indians took temporary control of British outposts throughout the Ohio River Valley."
    },
    {
     "id": 1167296,
     "content_html": "Naval warfare on the Ohio and Mississippi Rivers pitted canoes against frigates."
    },
    {
     "id": 1167297,
     "content_html": "Honorable rules of war ensured fair treatment of captives, and a cordial relationship was cultivated."
    }
   ],
