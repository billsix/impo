   "id": 615027,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which characteristic of the Articles of Confederation was the focus of reform for the Annapolis Convention?",
   "answers": [
    {
     "id": 1168081,
     "content_html": "Most of the power belonged to the states, which were unwilling to work together."
    },
    {
     "id": 1168080,
     "content_html": "Most of the power belonged to the national government, which could regulate commerce."
    },
    {
     "id": 1168079,
     "content_html": "Any reform to the document required a simple majority to enact that change."
    },
    {
     "id": 1168078,
     "content_html": "An electoral college submitted its votes for the executive branch."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615028,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which Revolutionary idea and prevailing political norm was challenged by the address provided?",
   "answers": [
    {
     "id": 1168084,
     "content_html": "A stronger national government would be better able to regulate interstate issues."
    },
    {
     "id": 1168085,
     "content_html": "Power should remain as local as possible, residing mostly in the state governments."
    },
    {
     "id": 1168083,
     "content_html": "Voter requirements should be relaxed so that as many people as possible could vote."
    },
    {
     "id": 1168082,
     "content_html": "A national leader is required for situations that require quick decisive action."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615029,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The excerpt reflects a growing belief among a small group of elite individuals that",
   "answers": [
    {
     "id": 1168088,
     "content_html": "domestic issues had largely been handled successfully by the Articles"
    },
