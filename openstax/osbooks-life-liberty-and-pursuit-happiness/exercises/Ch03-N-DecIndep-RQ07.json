 "questions": [
  {
   "id": 614858,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When the Continental Congress approved the Declaration of Independence, it",
   "answers": [
    {
     "id": 1167406,
     "content_html": "was the culmination of thorough debate and extensive negotiation necessary to achieve a unanimous decision"
    },
    {
     "id": 1167405,
     "content_html": "was then published for colonists who were to vote on whether they supported it"
    },
    {
     "id": 1167404,
     "content_html": "was positively received by the Loyalists who wanted colonists to form their own country and leave Great Britain"
    },
    {
     "id": 1167403,
     "content_html": "immediately created a new country that was recognized by other powers like France"
    }
   ],
