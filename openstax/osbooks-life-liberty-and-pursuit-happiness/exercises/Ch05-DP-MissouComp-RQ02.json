   "stimulus_html": "",
   "stem_html": "The term “Slave Power” was",
   "answers": [
    {
     "id": 1169036,
     "content_html": "John C. Calhoun’s nickname"
    },
    {
     "id": 1169035,
     "content_html": "a reference to the economic power of cotton cultivation in the Mississippi delta"
    },
    {
     "id": 1169034,
     "content_html": "a phrase referring to the physical strength of field hands"
    },
    {
     "id": 1169037,
     "content_html": "an expression of Northern frustration with Southern political dominance of the federal government"
    }
