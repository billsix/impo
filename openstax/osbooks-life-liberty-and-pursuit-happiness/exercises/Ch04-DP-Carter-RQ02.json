  {
   "id": 615098,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The main reason Robert Carter freed his slaves was that",
   "answers": [
    {
     "id": 1168364,
     "content_html": "Virginia was gradually ending the practice of slavery"
    },
    {
     "id": 1168363,
     "content_html": "he moved from Virginia to Baltimore"
    },
    {
     "id": 1168362,
     "content_html": "his sons expressed disdain for the institution of slavery"
    },
    {
     "id": 1168365,
     "content_html": "revolutionary principles and his religious convictions led him to believe slavery was wrong"
    }
   ],
