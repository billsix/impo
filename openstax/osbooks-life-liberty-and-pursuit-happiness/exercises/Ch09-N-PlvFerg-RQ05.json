 "questions": [
  {
   "id": 615662,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the majority opinion, the interpretation of the Fourteenth Amendment included all the following except the idea that",
   "answers": [
    {
     "id": 1170617,
     "content_html": "the Constitution does not have jurisdiction over private transportation"
    },
    {
     "id": 1170616,
     "content_html": "the Louisiana law was a reasonable regulation to preserve “the public peace and good order”"
    },
    {
     "id": 1170615,
     "content_html": "the Constitution does not secure “social equality”"
    },
    {
     "id": 1170614,
     "content_html": "the enforced separation of the two races does not stamp either with a badge of inferiority"
    }
   ],
