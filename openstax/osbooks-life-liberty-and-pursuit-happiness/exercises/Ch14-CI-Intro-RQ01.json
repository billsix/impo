   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The 1960 presidential election featured Democratic and Republican candidates who",
   "answers": [
    {
     "id": 1173799,
     "content_html": "came from similar family backgrounds"
    },
    {
     "id": 1173798,
     "content_html": "both entered national politics during the Great Depression"
    },
    {
     "id": 1173800,
     "content_html": "both entered Congress in 1946 after serving in World War II"
    },
    {
     "id": 1173797,
     "content_html": "had diametric positions on the Cold War"
    }
