   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the presidential campaign of 1968, the Democratic Party",
   "answers": [
    {
     "id": 1174251,
     "content_html": "nominated Robert F. Kennedy to be its standard bearer before his assassination"
    },
    {
     "id": 1174252,
     "content_html": "found itself split between factions supporting and opposing the war"
    },
    {
     "id": 1174250,
     "content_html": "emphasized it was running a “law and order” campaign"
    },
    {
     "id": 1174249,
     "content_html": "expelled George Wallace for his segregationist views"
    }
   ],
