 "questions": [
  {
   "id": 616552,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The 1960 presidential election was noteworthy because",
   "answers": [
    {
     "id": 1173811,
     "content_html": "the candidates represented widely divergent views on the key issues of the day"
    },
    {
     "id": 1173812,
     "content_html": "the use of televised debates became important in presidential political campaigns"
    },
    {
     "id": 1173810,
     "content_html": "the winner secured an overwhelming popular and electoral victory"
    },
    {
     "id": 1173809,
     "content_html": "it was the first presidential election of the Cold War era"
    }
   ],
