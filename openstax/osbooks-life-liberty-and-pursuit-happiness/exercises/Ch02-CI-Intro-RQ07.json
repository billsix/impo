   "stem_html": "The formation of the House of Burgesses in Virginia indicates the English",
   "answers": [
    {
     "id": 1166533,
     "content_html": "were focused on Christian missionary work sponsored by the crown"
    },
    {
     "id": 1166532,
     "content_html": "wanted cooperation between their settlers and American Indians on a diplomatic level"
    },
    {
     "id": 1166534,
     "content_html": "established a representative government in their North American colonies"
    },
    {
     "id": 1166531,
     "content_html": "followed an economic policy focused on agriculture, especially cotton"
    }
