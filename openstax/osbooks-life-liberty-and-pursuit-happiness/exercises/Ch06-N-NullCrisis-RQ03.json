 "questions": [
  {
   "id": 615297,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How would a proponent of state nullification describe the relationship between the states and the federal government?",
   "answers": [
    {
     "id": 1169160,
     "content_html": "The federal government makes the supreme law of the land and can nullify state laws."
    },
    {
     "id": 1169161,
     "content_html": "The states are sovereign entities and can decide to nullify a federal law that is inconsistent with the Constitution to protect their citizens."
    },
    {
     "id": 1169159,
     "content_html": "The federal and state governments share power and must negotiate over the application of federal laws to the states, reaching a compromise regarding nullification."
    },
    {
     "id": 1169158,
     "content_html": "The state government has more power than the federal government when it comes to issues of trade."
    }
   ],
