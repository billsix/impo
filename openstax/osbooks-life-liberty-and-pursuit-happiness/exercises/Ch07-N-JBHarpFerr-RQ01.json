 "questions": [
  {
   "id": 615517,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did John Brown oppose the Kansas-Nebraska Act (1854)?",
   "answers": [
    {
     "id": 1170040,
     "content_html": "He did not want the territories to enter the Union as free states. \n"
    },
    {
     "id": 1170041,
     "content_html": "He thought a southern Slave Power was attempting to spread slavery in the western territories. \n"
    },
    {
     "id": 1170039,
     "content_html": "He wanted the settlement of Kansas and the decision for statehood to be peaceful. \n"
    },
    {
     "id": 1170038,
     "content_html": "He was mostly concerned with preserving the integrity of the Missouri Compromise. \n"
    }
   ],
