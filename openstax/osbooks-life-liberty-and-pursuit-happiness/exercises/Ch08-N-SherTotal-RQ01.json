 "questions": [
  {
   "id": 615780,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Under the Union policy of pragmatism",
   "answers": [
    {
     "id": 1171088,
     "content_html": "it was safer for the Union army to attack and kill civilians than to confront the Confederate army"
    },
    {
     "id": 1171087,
     "content_html": "Union generals ordered their soldiers to respect private property in the Confederacy, including slaves, of all civilians"
    },
    {
     "id": 1171086,
     "content_html": "the Union destroyed any public and civilian property that could aid the war effort"
    },
    {
     "id": 1171089,
     "content_html": "Unionists and those who were neutral were treated better than those who supported the Confederacy"
    }
   ],
