 "questions": [
  {
   "id": 616033,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The political disposition of the United States during the 1920s can best be described as",
   "answers": [
    {
     "id": 1172100,
     "content_html": "in sympathy with radical new ideas that came out of Europe"
    },
    {
     "id": 1172101,
     "content_html": "a rejection of Wilsonian ideals, leading to Republican control at the federal level"
    },
    {
     "id": 1172099,
     "content_html": "a desire for strong international ties and a progressive domestic agenda"
    },
    {
     "id": 1172098,
     "content_html": "dissatisfaction with the two-party system and the emergence of third parties"
    }
   ],
