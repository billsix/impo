   "id": 615324,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which best describes William Lloyd Garrison’s initial stance on slavery?",
   "answers": [
    {
     "id": 1169268,
     "content_html": "He was a slaveholder who freed his slaves."
    },
    {
     "id": 1169267,
     "content_html": "He supported immediate emancipation of all enslaved persons."
    },
    {
     "id": 1169269,
     "content_html": "He supported gradual emancipation and colonization in Africa."
    },
    {
     "id": 1169266,
     "content_html": "He thought slaveholders should privately free their slaves."
    }
   ],
