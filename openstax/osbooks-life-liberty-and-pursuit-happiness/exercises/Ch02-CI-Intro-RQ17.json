 "questions": [
  {
   "id": 614650,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Pilgrims were referred to as “separatists” because",
   "answers": [
    {
     "id": 1166573,
     "content_html": "they had been forcibly removed to North America in retaliation for their political beliefs"
    },
    {
     "id": 1166572,
     "content_html": "they sought to establish an independent nation separate from England"
    },
    {
     "id": 1166574,
     "content_html": "they thought the Church of England could not be reformed and they needed to separate themselves from it"
    },
    {
     "id": 1166571,
     "content_html": "they successfully petitioned for the creation of Rhode Island as a separate colony"
    }
   ],
