 "questions": [
  {
   "id": 614596,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the Dutch settlement at New Amsterdam attract a diverse group of settlers?",
   "answers": [
    {
     "id": 1166358,
     "content_html": "The colony practiced a policy of religious toleration.\n"
    },
    {
     "id": 1166357,
     "content_html": "New Amsterdam’s location attracted numerous Europeans as well as Native Americans.\n"
    },
    {
     "id": 1166356,
     "content_html": "The Dutch West India Company issued quotas to control various groups of immigrants.\n"
    },
    {
     "id": 1166355,
     "content_html": "New Amsterdam’s location ensured relative safety from attacks by rival European groups.\n"
    }
   ],
