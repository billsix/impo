   "stem_html": "Which of the following most strongly influenced the events described in the excerpt?",
   "answers": [
    {
     "id": 1170780,
     "content_html": "The growth in popularity of labor unions"
    },
    {
     "id": 1170779,
     "content_html": "The expansion of the workforce due to rapid immigration"
    },
    {
     "id": 1170781,
     "content_html": "The expansion of industrialization and capitalism"
    },
    {
     "id": 1170778,
     "content_html": "The acquisition of overseas territories"
    }
   ],
