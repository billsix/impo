   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements most accurately describes the United States’ foreign policy during 1945–1960?",
   "answers": [
    {
     "id": 1173123,
     "content_html": "The United States distanced itself from the global free-market economy."
    },
    {
     "id": 1173122,
     "content_html": "The United States based its foreign policy on unilateral decision-making."
    },
    {
     "id": 1173121,
     "content_html": "The Cold War was based on military policy only."
    },
    {
     "id": 1173124,
     "content_html": "The United States formed military alliances in reaction to the Soviet Union’s aggression."
    }
