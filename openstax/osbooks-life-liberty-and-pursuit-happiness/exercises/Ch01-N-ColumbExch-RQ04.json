   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the Columbian Exchange affect Europe?",
   "answers": [
    {
     "id": 1166197,
     "content_html": "Domesticated animals from the New World greatly improved the productivity of European farms."
    },
    {
     "id": 1166196,
     "content_html": "Europeans suffered massive causalities form New World diseases such as syphilis."
    },
    {
     "id": 1166198,
     "content_html": "The higher caloric value of potatoes and corn improved the European diet."
    },
    {
     "id": 1166195,
     "content_html": "Domesticated animals from the New World wreaked havoc in Europe, where they had no natural predators."
    }
   ],
