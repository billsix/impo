 "questions": [
  {
   "id": 614845,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best contextualizes the Boston Massacre?",
   "answers": [
    {
     "id": 1167353,
     "content_html": "British declared that each purchased paper item would require a stamp tax."
    },
    {
     "id": 1167352,
     "content_html": "The Proclamation of 1763 prohibited settlement west of the Appalachian Mountains."
    },
    {
     "id": 1167351,
     "content_html": "Rowdy colonists dressed as American Indians and poured East India Tea into the harbor."
    },
    {
     "id": 1167354,
     "content_html": "British customs officials were headquartered in Boston to enforce the newly declared Townsend Acts."
    }
   ],
