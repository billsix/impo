   ],
   "combo_choices": []
  },
  {
   "id": 614759,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements would a historian use to support the argument presented by Roger Williams in the excerpt provided?",
   "answers": [
    {
     "id": 1167009,
     "content_html": "People have no obligation to follow law."
    },
    {
     "id": 1167008,
     "content_html": "Religious diversity is dangerous to a stable society."
    },
    {
     "id": 1167007,
     "content_html": "All government actions enforcing laws are illegitimate."
    },
    {
     "id": 1167010,
     "content_html": "People should be able to practice the religion of their choice."
    }
   ],
