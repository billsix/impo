   "id": 614758,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to the excerpt from Roger Williams, his <i>Letter to Providence</i> challenges what prevailing norm?",
   "answers": [
    {
     "id": 1167005,
     "content_html": "Religious freedom"
    },
    {
     "id": 1167004,
     "content_html": "Separation of church and state"
    },
    {
     "id": 1167006,
     "content_html": "Religious orthodoxy"
    },
    {
     "id": 1167003,
     "content_html": "Slave labor"
    }
   ],
   "hints": [],
