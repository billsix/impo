 "questions": [
  {
   "id": 615364,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The industrial advantage created by the Boston Manufacturing Company in 1813 was that",
   "answers": [
    {
     "id": 1169428,
     "content_html": "highly skilled workers were needed to produce textiles"
    },
    {
     "id": 1169427,
     "content_html": "a well-regulated industrial system increased workers’ pay"
    },
    {
     "id": 1169429,
     "content_html": "textiles could be produced as a finished product in one location"
    },
    {
     "id": 1169426,
     "content_html": "workers did not need to work more than ten hours per day"
    }
   ],
