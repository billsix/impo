 "stimulus_html": "<figure>\n<img src=\"exercises/media/4e75310d46f7e22b.png\" alt=\"A map that shows the vertical line drawn from Lake Ontario to the Gulf of Mexico by the Royal Proclamation of 1763. On the left of the line is the label “Lands reserved for the Indians”. On the right of the line the following are labeled from top to bottom: “Nova Scotia”, “New England”, “New York”, “Pennsylvania”, “Virginia”, “N. Carolina”, “S. Carolina”, “Georgia”, “W. Florida” and “E. Florida”.\">\n<figcaption>The line drawn by the Royal Proclamation of 1763 from Lake Ontario to the Gulf of Mexico is known as the Proclamation Line of 1763.</figcaption>\n</figure>\n<p><i>Refer to the map provided.</i></p>",
 "questions": [
  {
   "id": 614944,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Proclamation Line of 1763",
   "answers": [
    {
     "id": 1167746,
     "content_html": "expanded the size of the British colonies in North America"
    },
    {
     "id": 1167749,
     "content_html": "cut the colonists off from land that had previously been open to settlement"
    },
    {
     "id": 1167747,
     "content_html": "forced American Indians to move beyond the Mississippi River"
    },
    {
     "id": 1167748,
     "content_html": "gave up all the gains the British had acquired from the French and Indian War"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614945,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is true about the settlement of the area west of the line established by the Proclamation of 1763 after Pontiac’s Rebellion?",
   "answers": [
    {
     "id": 1167750,
     "content_html": "Colonists began to settle in the area because it was now British territory."
    },
    {
     "id": 1167751,
     "content_html": "Colonists fled the territory because the land was now entirely reserved for American Indians."
    },
    {
     "id": 1167752,
     "content_html": "American Indians were removed from all British colonies and forced to move onto this land."
    },
    {
     "id": 1167753,
     "content_html": "Colonists who had previously settled in this land refused to leave, creating more tension within the British colonies."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614946,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the significance of Pontiac’s Rebellion and its connection with the Proclamation of 1763?",
   "answers": [
    {
     "id": 1167757,
     "content_html": "The establishment of the proclamation line created animosity between the British government and colonists."
    },
    {
     "id": 1167754,
     "content_html": "Pontiac’s Rebellion demonstrated the inability of the British soldiers to drive all French influence from such a vast territory."
    },
    {
     "id": 1167755,
     "content_html": "British and colonial American soldiers learned new war tactics from the guerilla-style fighting of this conflict."
    },
    {
     "id": 1167756,
     "content_html": "More than any other event, Pontiac’s Rebellion demonstrated the ongoing conflict among the French, American Indians, and the British after the Seven Years’ War."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
