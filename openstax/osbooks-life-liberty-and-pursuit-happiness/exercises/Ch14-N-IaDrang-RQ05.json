   "stem_html": "The battle of the Ia Drang Valley",
   "answers": [
    {
     "id": 1174143,
     "content_html": "led North Vietnam to begin withdrawing its troops from South Vietnam"
    },
    {
     "id": 1174144,
     "content_html": "prevented North Vietnamese forces from driving to the South China Sea"
    },
    {
     "id": 1174142,
     "content_html": "forced General William C. Westmoreland to abandon his attrition strategy"
    },
    {
     "id": 1174141,
     "content_html": "triggered a major political upheaval within the South Vietnamese government"
    }
