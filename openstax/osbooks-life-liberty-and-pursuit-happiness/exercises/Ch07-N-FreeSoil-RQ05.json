 "questions": [
  {
   "id": 615439,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  statement regarding the major political parties’ positions on slavery in the 1840s is accurate?",
   "answers": [
    {
     "id": 1169728,
     "content_html": "Only the Whig Party publicly opposed slavery.\n"
    },
    {
     "id": 1169727,
     "content_html": "Only the Democratic Party split into factions regarding the continued existence of slavery.\n"
    },
    {
     "id": 1169726,
     "content_html": "Neither the Democratic nor the Whig Party nominated slaveholders for president.\n"
    },
    {
     "id": 1169729,
     "content_html": "Both the Democratic and the Whig Parties contained antislavery factions.\n"
    }
   ],
