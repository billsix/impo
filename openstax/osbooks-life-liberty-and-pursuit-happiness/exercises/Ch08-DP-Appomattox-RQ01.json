   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compared with the Union army strategy earlier in the war, Grant’s plan in 1864 involved",
   "answers": [
    {
     "id": 1171180,
     "content_html": "dividing his armies to better pursue the Confederate army"
    },
    {
     "id": 1171179,
     "content_html": "approaching General Lee for peace terms prior to further bloodshed"
    },
    {
     "id": 1171181,
     "content_html": "combining Union armies to move against the Confederate armies"
    },
    {
     "id": 1171178,
     "content_html": "abandoning the Army of the Potomac to reinforce the Army of Tennessee"
    }
   ],
