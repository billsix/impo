   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The goal of the Indian Patrol was",
   "answers": [
    {
     "id": 1174747,
     "content_html": "to raise awareness of substance abuse on reservations"
    },
    {
     "id": 1174746,
     "content_html": "to register Indians to vote in tribal elections"
    },
    {
     "id": 1174748,
     "content_html": "to monitor police, who activists claimed harassed Indian peoples unfairly"
    },
    {
     "id": 1174745,
     "content_html": "to stage protests at public events and historic sites to make people aware of the injustices Indians faced"
    }
   ],
