 "questions": [
  {
   "id": 615812,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was Andrew Johnson named Lincoln’s vice presidential running mate in the election of 1864?",
   "answers": [
    {
     "id": 1171216,
     "content_html": "The Know Nothings supported Johnson, a moderate Republican."
    },
    {
     "id": 1171217,
     "content_html": "Republicans believed that Johnson, a War Democrat, would broaden the ticket’s appeal."
    },
    {
     "id": 1171215,
     "content_html": "Johnson won the Republican nomination by winning a sufficient number of primary elections."
    },
    {
     "id": 1171214,
     "content_html": "Hundreds of voters petitioned for Johnson to be nominated."
    }
   ],
