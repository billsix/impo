   "id": 616181,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The 1933 National Industrial Recovery Act (NIRA) encouraged union growth because it",
   "answers": [
    {
     "id": 1172693,
     "content_html": "guaranteed workers collective bargaining rights"
    },
    {
     "id": 1172692,
     "content_html": "required businesses employing more than 50 workers to form unions"
    },
    {
     "id": 1172691,
     "content_html": "mandated union membership for textile workers and miners"
    },
    {
     "id": 1172690,
     "content_html": "hired union organizers to lead the National Recovery Administration"
    }
   ],
