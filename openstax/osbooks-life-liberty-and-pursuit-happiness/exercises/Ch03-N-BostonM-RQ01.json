   "id": 614839,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following methods was not used by colonists to protest the Acts passed by Parliament after the French and Indian War?",
   "answers": [
    {
     "id": 1167329,
     "content_html": "Boycotting British imports such as textiles"
    },
    {
     "id": 1167328,
     "content_html": "Publishing written arguments in newspapers and pamphlets"
    },
    {
     "id": 1167327,
     "content_html": "Antagonizing British soldiers in the streets with verbal and physical attacks"
    },
    {
     "id": 1167330,
     "content_html": "Forming militia and securing funds to declare a war for independence"
    }
