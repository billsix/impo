   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Waldorf Declaration was",
   "answers": [
    {
     "id": 1173275,
     "content_html": "an executive order issued by President Truman outlawing the Communist Party USA"
    },
    {
     "id": 1173276,
     "content_html": "a decision made by Hollywood studios not to employ persons who refused to testify before HUAC"
    },
    {
     "id": 1173274,
     "content_html": "the decision by Congress that allowed the federal government to arrest suspected communists"
    },
    {
     "id": 1173273,
     "content_html": "an order to prosecute those who sold atomic secrets to the Soviet Union"
    }
   ],
