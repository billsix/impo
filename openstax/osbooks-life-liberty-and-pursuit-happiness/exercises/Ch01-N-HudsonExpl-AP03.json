  {
   "id": 614598,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did join-stock companies contribute to the European race for empire in the seventeenth-century?",
   "answers": [
    {
     "id": 1166365,
     "content_html": "Joint-stock companies provided explorers with supplies for their voyages.\n"
    },
    {
     "id": 1166366,
     "content_html": "Joint-stock companies pooled resources to sponsor voyages as a gamble on potential profits and losses.\n"
    },
    {
     "id": 1166364,
     "content_html": "Joint-stock companies acted a liaison between explorers and monarchs.\n"
    },
    {
     "id": 1166363,
     "content_html": "Joint-stock companies oversaw relations with Native American groups.\n"
    }
   ],
