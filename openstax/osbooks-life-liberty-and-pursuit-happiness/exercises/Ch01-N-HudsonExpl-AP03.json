   "stem_html": "This document was created primarily to",
   "answers": [
    {
     "id": 1166361,
     "content_html": "establish religious toleration for all settlements of the Dutch West India Company\n"
    },
    {
     "id": 1166362,
     "content_html": "authorize any actions necessary for successful trading ventures on behalf of the Dutch West India Company\n"
    },
    {
     "id": 1166360,
     "content_html": "establish alliances with Native Americans\n"
    },
    {
     "id": 1166359,
     "content_html": "refute the authority of the monarch over business transactions of the Dutch West India Company\n"
    }
