 "questions": [
  {
   "id": 614843,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was John Adams’ intention when he defended the British redcoats involved in the Boston Massacre?",
   "answers": [
    {
     "id": 1167345,
     "content_html": "Adams was a fierce Loyalist who believed the crown had absolute authority in the colonies and desired to prove the redcoats had committed no crime."
    },
    {
     "id": 1167344,
     "content_html": "Adams wanted each redcoat to suffer the consequences of his murderous actions."
    },
    {
     "id": 1167346,
     "content_html": "Adams desired to prove that the colonists, regardless of their political rage, would always uphold the rule of law."
    },
    {
     "id": 1167343,
     "content_html": "Adams longed for a position as a lawyer in Great Britain and knew this case could fulfill his dream."
    }
   ],
