 "stimulus_html": "<figure id=\"fig01\" class=\"full-width\">\n<img src=\"exercises/media/462e3bf0e16bb091.png\" alt=\"The illustration shows a series of images: moving from left to right, the images show men stand in front of a train, a man in front of a car grabbing mail from a mailbox, a man on a bicycle with an airplane flying above him, a boy holding newspapers, and men using a dolly to transport bags in front of a ship.\">\n<figcaption>“Mail Transportation\"; San Pedro Post Office, San Pedro, California, c. 1935.</figcaption>\n</figure>\n<figure id=\"fig02\" class=\"full-width\">\n<img src=\"exercises/media/db95b8106c256e23.png\" alt=\"On the left, men hang on the side of a cliff. In the center left, a man rides a part being lifted by a crane. Behind him are structures that show the beginning of construction. On the center right, men gesture to him. Beside them, two men look at a blueprint. Behind them is a factory. On the right, men construct the parts.\">\n<figcaption>William Gropper, “Construction of a Dam,” 1939 for the U. S. Department of the Interior.</figcaption>\n</figure>\n<p><i>Refer to the images provided.</i></p>\n",
 "questions": [
  {
   "id": 616147,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A historian might use these two images to support the claim that",
   "answers": [
    {
     "id": 1172556,
     "content_html": "government-sponsored work programs led to socialism"
    },
    {
     "id": 1172555,
     "content_html": "the New Deal created a limited welfare state"
    },
    {
     "id": 1172557,
     "content_html": "public art created during the New Deal era celebrated the common worker"
    },
    {
     "id": 1172554,
     "content_html": "the construction of public buildings increased dramatically during the Great Depression"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616148,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What theme do these images have in common?",
   "answers": [
    {
     "id": 1172561,
     "content_html": "Energy and cooperation among workers engaged in big jobs"
    },
    {
     "id": 1172560,
     "content_html": "Sadness and desperation because of the Depression"
    },
    {
     "id": 1172559,
     "content_html": "Eager preparation for war"
    },
    {
     "id": 1172558,
     "content_html": "Gloom and foreboding about dangers ahead"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616149,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The images best reflect which continuity in U.S. history?",
   "answers": [
    {
     "id": 1172564,
     "content_html": "Automation rapidly decreased the number of manufacturing jobs"
    },
    {
     "id": 1172565,
     "content_html": "Infrastructure benefitted from federal expenditures"
    },
    {
     "id": 1172563,
     "content_html": "Rural areas more strongly represent traditional values"
    },
    {
     "id": 1172562,
     "content_html": "Industrial expansion started in northeastern cities"
    }
   ],
