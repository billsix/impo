 "questions": [
  {
   "id": 614649,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements best reflects the reasons for slavery in North America?",
   "answers": [
    {
     "id": 1166570,
     "content_html": "Labor-intensive crop production required cheap labor."
    },
    {
     "id": 1166569,
     "content_html": "A surplus of European laborers depressed salaries."
    },
    {
     "id": 1166568,
     "content_html": "The absence of economic opportunities limited Europeans’ motivation to settle in North America."
    },
    {
     "id": 1166567,
     "content_html": "Warfare between colonial rivals meant most colonists served as soldiers rather than as laborers."
    }
   ],
