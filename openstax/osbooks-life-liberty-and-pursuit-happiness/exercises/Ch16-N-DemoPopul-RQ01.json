   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "New Democrats such as Bill Clinton shifted the focus of the party because they believed Democrats should",
   "answers": [
    {
     "id": 1175243,
     "content_html": "cooperate more often with Republicans"
    },
    {
     "id": 1175244,
     "content_html": "position themselves at the political center rather than on the left"
    },
    {
     "id": 1175242,
     "content_html": "make stronger efforts to help the poor and give less attention to middle-class issues"
    },
    {
     "id": 1175241,
     "content_html": "adopt more Republican ideas, like supply-side economics"
    }
