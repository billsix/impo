 "questions": [
  {
   "id": 615713,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Once the Civil War broke out, one major advantage held by the South was that",
   "answers": [
    {
     "id": 1170820,
     "content_html": "it possessed more financial capital and could afford a long conflict"
    },
    {
     "id": 1170819,
     "content_html": "its superior navy would protect trade routes between the South and European trade partners"
    },
    {
     "id": 1170821,
     "content_html": "the Confederacy needed to fight only a defensive war, whereas the Union needed to conquer the South"
    },
    {
     "id": 1170818,
     "content_html": "the production of cotton gained the military support of Great Britain and France"
    }
   ],
