   "id": 615192,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Andrew Jackson commanded forces at the Battle of New Orleans that are best described as",
   "answers": [
    {
     "id": 1168740,
     "content_html": "American army regulars similar to their British counterparts"
    },
    {
     "id": 1168739,
     "content_html": "volunteers from New England and the Mid-Atlantic states"
    },
    {
     "id": 1168738,
     "content_html": "conscripts from throughout the United States"
    },
    {
     "id": 1168741,
     "content_html": "militiamen mostly from the frontier, Choctaw allies, some pirates, and a few professional soldiers"
    }
   ],
