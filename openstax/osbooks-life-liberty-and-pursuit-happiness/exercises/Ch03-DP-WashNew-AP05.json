 "stimulus_html": "<figure>\n<img src=\"exercises/media/73fffacc12cdfe5b.png\" alt=\"An image on the left shows a statue of Washington hanging up his military cloak and sword. A painting on the right shows Washington standing before Congress resigning his military commission. Men and women sit or stand around him, looking on. Some are also located in a balcony above and behind him.\">\n<figcaption>George Washington surrendering his military commission to the Congress in Annapolis on December 23, 1783.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 615013,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The event depicted in the image provided challenged what prevailing norm of the time?",
   "answers": [
    {
     "id": 1168025,
     "content_html": "A military leader kept control after the conflict was over."
    },
    {
     "id": 1168024,
     "content_html": "Battles were fought according to strict rules in an open space."
    },
    {
     "id": 1168023,
     "content_html": "Women were not allowed in public buildings on their own."
    },
    {
     "id": 1168022,
     "content_html": "Military officers received a triumphant welcome."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615014,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The action in the image provided most directly caused",
   "answers": [
    {
     "id": 1168029,
     "content_html": "a swell of patriotism and trust in Washington as a virtuous leader"
    },
    {
     "id": 1168028,
     "content_html": "a military coup whereby Washington took over as dictator"
    },
    {
     "id": 1168027,
     "content_html": "the French alliance, which supported the Americans with financial and military supplies"
    },
    {
     "id": 1168026,
     "content_html": "the formation of a new government that would address the weaknesses of the Articles of Confederation"
    }
   ],
