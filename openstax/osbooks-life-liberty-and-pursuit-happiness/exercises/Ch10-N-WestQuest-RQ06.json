   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Theodore Roosevelt became known as the conservation president largely because",
   "answers": [
    {
     "id": 1171592,
     "content_html": "he was the first president to support actions to protect the environment"
    },
    {
     "id": 1171593,
     "content_html": "he undertook environmental policy initiatives that generated publicity"
    },
    {
     "id": 1171591,
     "content_html": "he had unlimited congressional support for his environmental policies"
    },
    {
     "id": 1171590,
     "content_html": "he united ranching and mining interests in support of federal environmental policies"
    }
   ],
