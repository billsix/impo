   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following developments represented a continuation of the sentiments in the excerpt?",
   "answers": [
    {
     "id": 1171910,
     "content_html": "Support for laissez-faire economic policies"
    },
    {
     "id": 1171911,
     "content_html": "Expansion of mechanized farming on the Great Plains during the 1920s and 1930s"
    },
    {
     "id": 1171912,
     "content_html": "Development of post–World War II suburbs"
    },
    {
     "id": 1171913,
     "content_html": "Restrictions on pesticide use after the publication of Rachel Carson’s <i>Silent Spring</i>"
    }
   ],
