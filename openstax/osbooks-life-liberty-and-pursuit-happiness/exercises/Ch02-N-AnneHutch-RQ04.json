 "questions": [
  {
   "id": 614677,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At her trial, Anne Hutchinson most likely sealed her fate when she referred to which of the following?",
   "answers": [
    {
     "id": 1166681,
     "content_html": "Her sympathy with the women who had been accused of witchcraft in Salem"
    },
    {
     "id": 1166680,
     "content_html": "Her reliance on her husband to explain scripture to her"
    },
    {
     "id": 1166679,
     "content_html": "Her plan to go with Roger Williams to help found Rhode Island"
    },
    {
     "id": 1166682,
     "content_html": "Her belief that she had learned God’s will through an immediate revelation"
    }
   ],
