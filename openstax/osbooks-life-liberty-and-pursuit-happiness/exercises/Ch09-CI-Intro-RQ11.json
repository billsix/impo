   "id": 615584,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Opposition to economic consolidation by big business in the late nineteenth century was manifested in what way?",
   "answers": [
    {
     "id": 1170304,
     "content_html": "The banning of labor unions"
    },
    {
     "id": 1170305,
     "content_html": "Demands for regulatory laws"
    },
    {
     "id": 1170303,
     "content_html": "The Supreme Court’s decision in <i>U.S. v. E.C. Knight</i>"
    },
    {
     "id": 1170302,
     "content_html": "Government action to prevent work stoppages such as the Great Railroad Strike of 1877"
    }
