   "stimulus_html": "",
   "stem_html": "Which of the following did not contribute to the call for a Second Continental Congress in 1776?",
   "answers": [
    {
     "id": 1167237,
     "content_html": "The British attacks on Lexington and Concord and the violence at Bunker Hill"
    },
    {
     "id": 1167236,
     "content_html": "The popularity of a pro-independence pamphlet written by Thomas Paine"
    },
    {
     "id": 1167235,
     "content_html": "The need for a central entity to wage the resistance effort"
    },
    {
     "id": 1167238,
     "content_html": "The successful alliance between American colonists and France to wage war against the British"
    }
