 "questions": [
  {
   "id": 615043,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the major significance of the Jay and the Pinckney Treaties?",
   "answers": [
    {
     "id": 1168144,
     "content_html": "They permanently settled the boundaries of territories that were in question with European powers."
    },
    {
     "id": 1168143,
     "content_html": "They established most-favored-nation status with Spain and Britain."
    },
    {
     "id": 1168145,
     "content_html": "They defended U.S. national interests while avoiding war with European powers."
    },
    {
     "id": 1168142,
     "content_html": "They established a key alliance with Great Britain against the French revolutionary government."
    }
   ],
