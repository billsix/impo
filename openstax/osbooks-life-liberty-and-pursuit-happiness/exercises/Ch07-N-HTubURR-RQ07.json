 "questions": [
  {
   "id": 615459,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Even  after the Civil War, Harriet Tubman continued to demonstrate her conviction that she should do good for others by",
   "answers": [
    {
     "id": 1169809,
     "content_html": "raising funds necessary to run a home for aged and poor blacks in Auburn, New York\n"
    },
    {
     "id": 1169808,
     "content_html": "continuing to help enslaved persons escape from captivity by leading raids on southern plantations\n"
    },
    {
     "id": 1169807,
     "content_html": "disguising herself to escape from a Confederate prison and serve as a teacher\n"
    },
    {
     "id": 1169806,
     "content_html": "writing an inspiring autobiography detailing her heroic life\n"
    }
   ],
