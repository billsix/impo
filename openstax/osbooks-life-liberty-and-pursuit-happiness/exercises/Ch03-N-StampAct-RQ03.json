 "questions": [
  {
   "id": 614834,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does “taxation without representation” mean?",
   "answers": [
    {
     "id": 1167309,
     "content_html": "The colonies were taxed directly by the king rather than by representatives in Parliament."
    },
    {
     "id": 1167310,
     "content_html": "The colonists did not elect the representatives in Parliament who passed the tax."
    },
    {
     "id": 1167308,
     "content_html": "The tax was applied to all colonies equally without regard for the opinion of their representation in Parliament."
    },
    {
     "id": 1167307,
     "content_html": "The tax was enforced despite the colonies’ protests and petitions."
    }
   ],
