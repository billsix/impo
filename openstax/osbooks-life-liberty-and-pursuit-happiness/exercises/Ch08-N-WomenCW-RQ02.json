   "stimulus_html": "",
   "stem_html": "Women such as “Mother” Bickerdyke served in the war mainly as",
   "answers": [
    {
     "id": 1171016,
     "content_html": "volunteers on the home front, writing letters of encouragement to wounded soldiers"
    },
    {
     "id": 1171015,
     "content_html": "workers in factories, replacing men as they were drafted into the army"
    },
    {
     "id": 1171017,
     "content_html": "nurses on the frontlines"
    },
    {
     "id": 1171014,
     "content_html": "women disguised as men fighting on the frontlines"
    }
