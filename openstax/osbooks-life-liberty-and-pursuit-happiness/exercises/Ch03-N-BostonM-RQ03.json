 "questions": [
  {
   "id": 614841,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following provides an example of colonists participating in an economic protest against the Townsend Acts?",
   "answers": [
    {
     "id": 1167337,
     "content_html": "Well-known leaders like John Dickinson writing circular letters in protest"
    },
    {
     "id": 1167338,
     "content_html": "Women creating homespun clothes instead of purchasing imported goods"
    },
    {
     "id": 1167336,
     "content_html": "An organization called the Sons of Liberty burning effigies in public"
    },
    {
     "id": 1167335,
     "content_html": "Protestors dressing up like American Indians and dumping tea into the harbor"
    }
   ],
