 "questions": [
  {
   "id": 616373,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Federal court case <i>Browder v. Gayle</i> established that",
   "answers": [
    {
     "id": 1173459,
     "content_html": "the principles in <i>Brown v. Board of Education</i> were also relevant in the Montgomery Bus Boycott"
    },
    {
     "id": 1173460,
     "content_html": "the Montgomery bus segregation laws were a violation of the constitutional guarantee of equality"
    },
    {
     "id": 1173458,
     "content_html": "the principles of <i>Plessy v. Ferguson</i> were similar to those in the Montgomery bus company"
    },
    {
     "id": 1173457,
     "content_html": "the conviction of Martin Luther King Jr. was unconstitutional"
    }
   ],
