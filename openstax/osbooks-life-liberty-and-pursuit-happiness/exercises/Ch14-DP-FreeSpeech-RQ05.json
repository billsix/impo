   "id": 616780,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "John and Mary Beth Tinker wore black armbands to school protesting the Vietnam War to",
   "answers": [
    {
     "id": 1174343,
     "content_html": "show their support for the limited use of nuclear weapons to end the war"
    },
    {
     "id": 1174342,
     "content_html": "reject the idea of a negotiated settlement to the war"
    },
    {
     "id": 1174341,
     "content_html": "demonstrate their support for a foreign policy based on the domino theory"
    },
    {
     "id": 1174344,
     "content_html": "mourn Vietnamese and American casualties of the war"
    }
   ],
