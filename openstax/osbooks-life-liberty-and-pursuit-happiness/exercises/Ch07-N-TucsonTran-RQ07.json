   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After  the acquisition of the Arizona and New Mexican territories, the Mexican residents there",
   "answers": [
    {
     "id": 1169696,
     "content_html": "overwhelming left the area and resettled south in Mexico\n"
    },
    {
     "id": 1169697,
     "content_html": "primarily remained in the area and became resident aliens or U.S. citizens\n"
    },
    {
     "id": 1169695,
     "content_html": "staged a violent uprising and were forcibly removed to Texas\n"
    },
    {
     "id": 1169694,
     "content_html": "immediately lost title to their land and possessions\n"
    }
   ],
