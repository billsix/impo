   "stem_html": "The Albany Resolves",
   "answers": [
    {
     "id": 1171072,
     "content_html": "were a condemnation of Vallandigham’s actions and called for his incarceration"
    },
    {
     "id": 1171071,
     "content_html": "were a formal political statement of support for President Lincoln’s war strategies"
    },
    {
     "id": 1171073,
     "content_html": "gave Lincoln an opportunity to clarify his war policies while condemning Vallandigham’s actions"
    },
    {
     "id": 1171070,
     "content_html": "demanded an immediate end to the Civil War"
    }
