 "questions": [
  {
   "id": 614850,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following acts of legislation was not part of the Coercive Acts?",
   "answers": [
    {
     "id": 1167373,
     "content_html": "The Quartering Act, which required colonists to house and provide for British troops"
    },
    {
     "id": 1167372,
     "content_html": "The Quebec Act, which allowed freedom of religion to newly British French-Canadian colonists"
    },
    {
     "id": 1167374,
     "content_html": "The Declaratory Act, which asserted the British right to govern the colonists in any way they saw fit"
    },
    {
     "id": 1167371,
     "content_html": "The Boston Port Act, which required the harbor to close until the cost of the destroyed tea was reimbursed"
    }
   ],
