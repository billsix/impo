 "questions": [
  {
   "id": 616798,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Democrats lost the presidential election of 1968 for all the following reasons except",
   "answers": [
    {
     "id": 1174416,
     "content_html": "the overwhelming popularity of the Republican candidate"
    },
    {
     "id": 1174415,
     "content_html": "the violent anti-war protests that disrupted the Democratic Convention"
    },
    {
     "id": 1174414,
     "content_html": "a southern Democrat who drew traditional Democratic votes from the party’s nominee"
    },
    {
     "id": 1174413,
     "content_html": "the perception that the Democratic party was soft on crime"
    }
   ],
