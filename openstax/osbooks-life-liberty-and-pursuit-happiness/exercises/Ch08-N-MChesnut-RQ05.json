 "questions": [
  {
   "id": 615772,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "While Mary Chesnut lived as a refugee in North Carolina, she wrote in her diary about",
   "answers": [
    {
     "id": 1171056,
     "content_html": "her gratitude to her hostess for providing shelter under difficult circumstances"
    },
    {
     "id": 1171057,
     "content_html": "the harsh conditions at the end of the conflict and criticisms of her young hostess’s housekeeping"
    },
    {
     "id": 1171055,
     "content_html": "anger regarding her hostess’s inappropriate flirting with James Chesnut"
    },
    {
     "id": 1171054,
     "content_html": "disdain for the poor service provided by the hostess’s slaves and her lifelong fear of slave rebellions"
    }
   ],
