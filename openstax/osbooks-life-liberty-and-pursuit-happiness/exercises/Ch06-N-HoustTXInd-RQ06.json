   "id": 615346,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The United States did not immediately annex Texas for all the following reasons except",
   "answers": [
    {
     "id": 1169356,
     "content_html": "Texas would join the union as one or several slave states"
    },
    {
     "id": 1169355,
     "content_html": "annexation could mean war between the United States and Mexico"
    },
    {
     "id": 1169354,
     "content_html": "President Andrew Jackson ignored the Texans’ request"
    },
    {
     "id": 1169357,
     "content_html": "there was no support in the United States for annexation of Texas"
    }
   ],
