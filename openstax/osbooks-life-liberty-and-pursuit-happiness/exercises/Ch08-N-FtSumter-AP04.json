   "stem_html": "President Lincoln’s overall goal when he issued the provided statement was to",
   "answers": [
    {
     "id": 1171262,
     "content_html": "bring an end to the institution of slavery"
    },
    {
     "id": 1171263,
     "content_html": "send a military message to Great Britain and France to stay out of the conflict"
    },
    {
     "id": 1171265,
     "content_html": "maintain the Union"
    },
    {
     "id": 1171264,
     "content_html": "deliver a message of patriotism"
    }
   ],
