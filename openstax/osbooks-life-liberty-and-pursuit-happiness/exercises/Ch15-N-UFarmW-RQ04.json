 "questions": [
  {
   "id": 616910,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the National Labor Relations Act protect migrant workers?",
   "answers": [
    {
     "id": 1174863,
     "content_html": "It required that all American workers have equal opportunity to unionize."
    },
    {
     "id": 1174864,
     "content_html": "It did not provide them legal protection."
    },
    {
     "id": 1174862,
     "content_html": "It limited only the number of working hours."
    },
    {
     "id": 1174861,
     "content_html": "It provided only the right to collective bargaining."
    }
   ],
