   "id": 616424,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The main purpose of Nixon’s visit to the Soviet Union in July 1959 was",
   "answers": [
    {
     "id": 1173663,
     "content_html": "a secret mission to negotiate the presence of Soviet forces in Cuba"
    },
    {
     "id": 1173662,
     "content_html": "a diplomatic mission to encourage Khrushchev to sign a trade pact with the United States"
    },
    {
     "id": 1173664,
     "content_html": "the opening of the U.S. exhibit in Sokolniki Park in Moscow"
    },
    {
     "id": 1173661,
     "content_html": "an invitation to Khrushchev to visit the United States"
    }
   ],
