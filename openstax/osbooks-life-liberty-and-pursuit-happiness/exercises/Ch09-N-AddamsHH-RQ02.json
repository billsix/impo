   "id": 615640,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jane Addams’s Hull House was a social experiment designed to",
   "answers": [
    {
     "id": 1170528,
     "content_html": "preserve the status and power of native-born Americans"
    },
    {
     "id": 1170527,
     "content_html": "regulate the flow of immigrants into crowded cities"
    },
    {
     "id": 1170526,
     "content_html": "expose the danger the foreign-born presented to traditional values"
    },
    {
     "id": 1170529,
     "content_html": "reduce social tensions through an alliance of middle-class and working-class people"
    }
   ],
