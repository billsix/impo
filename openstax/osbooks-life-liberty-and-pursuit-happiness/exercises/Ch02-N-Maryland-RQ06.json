   "id": 614670,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a result of the Glorious Revolution in England in 1689, what action was taken in Maryland?",
   "answers": [
    {
     "id": 1166653,
     "content_html": "Slavery was banned in the colony."
    },
    {
     "id": 1166654,
     "content_html": "The Act of Toleration was revoked."
    },
    {
     "id": 1166652,
     "content_html": "Virginia conquered Maryland and took possession of the Chesapeake Bay."
    },
    {
     "id": 1166651,
     "content_html": "All Catholic landholders were forced to forfeit their possessions."
    }
   ],
