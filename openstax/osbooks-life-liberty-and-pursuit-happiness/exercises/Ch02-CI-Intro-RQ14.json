   "id": 614647,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements regarding the African slave trade is most accurate?",
   "answers": [
    {
     "id": 1166561,
     "content_html": "Most African slaves were sold to plantation owners in British North America."
    },
    {
     "id": 1166562,
     "content_html": "Brazil and the West Indies were the most common destinations for African slaves."
    },
    {
     "id": 1166560,
     "content_html": "Because of high mortality rates, the profits to merchants and ship owners from the slave trade were relatively low."
    },
    {
     "id": 1166559,
     "content_html": "The French imported slaves into their territories via the Mississippi River Valley."
    }
   ],
