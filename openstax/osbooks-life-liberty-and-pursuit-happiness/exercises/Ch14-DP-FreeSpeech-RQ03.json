   "stimulus_html": "",
   "stem_html": "Which statement regarding the antiwar movement is incorrect?",
   "answers": [
    {
     "id": 1174336,
     "content_html": "Anti-war protests usually featured violent clashes with the police."
    },
    {
     "id": 1174335,
     "content_html": "Protests against the Vietnam War started with young people."
    },
    {
     "id": 1174334,
     "content_html": "The burning of draft cards was a prominent feature of many anti-war protests."
    },
    {
     "id": 1174333,
     "content_html": "Many anti-war protesters were influenced by or veterans of the civil rights movement."
    }
