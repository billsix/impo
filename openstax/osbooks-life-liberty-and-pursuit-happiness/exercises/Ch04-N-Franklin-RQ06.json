   "id": 615066,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following resulted from the debate caused by the Quaker and Pennsylvania Society’s petitions to Congress except",
   "answers": [
    {
     "id": 1168236,
     "content_html": "Congress endorsed slavery’s protected status in the new nation"
    },
    {
     "id": 1168235,
     "content_html": "a fierce debate over slavery and its expansion continued into the next century"
    },
    {
     "id": 1168234,
     "content_html": "Franklin wrote a satire to express his commentary on Congress’s decision"
    },
    {
     "id": 1168237,
     "content_html": "the Quakers withdrew their petition"
    }
   ],
