 "questions": [
  {
   "id": 614913,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following describes republican virtue?",
   "answers": [
    {
     "id": 1167624,
     "content_html": "The ideology of small government that protects the rights of individuals by interfering as little as possible"
    },
    {
     "id": 1167625,
     "content_html": "Faithful adherence to the civic duties of government in an ethical and principled manner even at personal sacrifice"
    },
    {
     "id": 1167623,
     "content_html": "Strict adherence to fulfilling the wishes of constituents, regardless of personal beliefs"
    },
    {
     "id": 1167622,
     "content_html": "Allegiance to the monarchy because of Britain's economic superiority and promise of military protection"
    }
   ],
