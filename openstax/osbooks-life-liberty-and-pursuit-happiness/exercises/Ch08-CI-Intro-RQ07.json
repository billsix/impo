 "questions": [
  {
   "id": 615719,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One motivation of Confederate General Robert E. Lee in launching an invasion north of the Potomac River in the summer of 1862 was to",
   "answers": [
    {
     "id": 1170844,
     "content_html": "outflank Union General Ulysses S. Grant to prevent the secession of more states"
    },
    {
     "id": 1170843,
     "content_html": "set up a first line of defense for Richmond to encourage South Carolina to secede"
    },
    {
     "id": 1170842,
     "content_html": "destroy the Army of the Potomac and quickly defeat Jackson’s troops"
    },
    {
     "id": 1170845,
     "content_html": "attract recognition and support of the Confederacy by a foreign power such as Great Britain"
    }
   ],
