 "questions": [
  {
   "id": 614712,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What best describes the way the Stono Rebellion ultimately ended?",
   "answers": [
    {
     "id": 1166821,
     "content_html": "Almost every rebel successfully reached Florida, gaining freedom."
    },
    {
     "id": 1166822,
     "content_html": "An impromptu militia of white planters used weapons to wound and maim the rebellious slaves."
    },
    {
     "id": 1166820,
     "content_html": "The South Carolina legislature decreed that all slaves must be emancipated."
    },
    {
     "id": 1166819,
     "content_html": "Each rebel was granted the due process of law but was found guilty and executed."
    }
   ],
