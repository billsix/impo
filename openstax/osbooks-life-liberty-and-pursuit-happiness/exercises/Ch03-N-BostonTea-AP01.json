  {
   "id": 614962,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Bishop of St. Asaph, Jonathan Shipley, would support which of the following statements?",
   "answers": [
    {
     "id": 1167821,
     "content_html": "Liberty is a natural right."
    },
    {
     "id": 1167820,
     "content_html": "Liberty is a right provided by government."
    },
    {
     "id": 1167819,
     "content_html": "The British government should better regulate the colonies for economic gain."
    },
    {
     "id": 1167818,
     "content_html": "The colonists’ experience in self-government has been a failure."
    }
   ],
