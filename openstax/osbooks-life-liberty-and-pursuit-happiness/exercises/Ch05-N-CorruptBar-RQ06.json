   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The “corrupt bargain” in the history of the early republic refers to the Jacksonians’ accusation that",
   "answers": [
    {
     "id": 1168820,
     "content_html": "Andrew Jackson used an informal group of advisors"
    },
    {
     "id": 1168819,
     "content_html": "negotiation payments were made by the U.S. to the French during the Napoleonic Wars"
    },
    {
     "id": 1168818,
     "content_html": "Napoleon offered to sell the entire Louisiana Territory, not just New Orleans"
    },
    {
     "id": 1168821,
     "content_html": "Henry Clay agreed to give electoral support to John Quincy Adams in return for becoming Secretary of State"
    }
