   "stimulus_html": "",
   "stem_html": "The “compact theory” of government most clearly means",
   "answers": [
    {
     "id": 1169012,
     "content_html": "states have the right to secede"
    },
    {
     "id": 1169013,
     "content_html": "states hold the power to judge the constitutionality of federal legislation"
    },
    {
     "id": 1169011,
     "content_html": "federal law supersedes state law"
    },
    {
     "id": 1169010,
     "content_html": "the national government lacks the authority to increase the size of the United States"
    }
