   "id": 616863,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Initially, the United States refused to open diplomatic relations with the People’s Republic of China for all the following reasons except",
   "answers": [
    {
     "id": 1174676,
     "content_html": "the Chinese maintained close diplomatic ties with the Soviet Union"
    },
    {
     "id": 1174675,
     "content_html": "China declared war against the United States in the Korean Conflict"
    },
    {
     "id": 1174674,
     "content_html": "the United States recognized Taiwan as the legitimate government of China"
    },
    {
     "id": 1174673,
     "content_html": "the American government fought to keep the Chinese communists out of the United Nations"
    }
   ],
