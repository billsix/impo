   "id": 615298,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Tariff of Abominations was so called because it",
   "answers": [
    {
     "id": 1169164,
     "content_html": "did not allow for fair trade, hurting the U.S. economy as demand for foreign goods increased"
    },
    {
     "id": 1169165,
     "content_html": "appeared to favor the economic interests of the North at the expense of the South"
    },
    {
     "id": 1169163,
     "content_html": "brought great harm to the U.S. economy on all levels"
    },
    {
     "id": 1169162,
     "content_html": "caused the price of cotton to increase sharply"
    }
   ],
