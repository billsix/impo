 "questions": [
  {
   "id": 614842,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the effect of the Boston Massacre engraving and funeral procession in other colonies?",
   "answers": [
    {
     "id": 1167342,
     "content_html": "Patriots in other colonies interpreted the Boston event as a danger to all colonies."
    },
    {
     "id": 1167341,
     "content_html": "Newspapers barely reported the events and few colonists took notice."
    },
    {
     "id": 1167340,
     "content_html": "Loyalists were impressed by the successful actions taken by the British to regain control."
    },
    {
     "id": 1167339,
     "content_html": "Immediate actions were taken to create an intercolonial body that would protest these actions."
    }
   ],
