   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the establishment of Maryland contrast with that of the New England colonies?",
   "answers": [
    {
     "id": 1166581,
     "content_html": "Maryland was initially founded by Dutch settlers."
    },
    {
     "id": 1166580,
     "content_html": "Maryland was less tolerant of religious differences than the New England colonies."
    },
    {
     "id": 1166582,
     "content_html": "Maryland was founded as a safe haven for persecuted Catholics."
    },
    {
     "id": 1166579,
     "content_html": "Maryland prohibited slavery."
    }
