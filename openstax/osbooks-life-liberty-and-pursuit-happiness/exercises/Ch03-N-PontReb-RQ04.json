 "questions": [
  {
   "id": 614828,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One reason Pontiac’s Rebellion was initially successful was",
   "answers": [
    {
     "id": 1167286,
     "content_html": "Chief Pontiac allied with multiple American Indian groups to resist British encroachment"
    },
    {
     "id": 1167285,
     "content_html": "British popular support at home was very low for the continued use of force in the Americas"
    },
    {
     "id": 1167284,
     "content_html": "the redcoats remained very well organized and trained, resulting in an unbeatable military force"
    },
    {
     "id": 1167283,
     "content_html": "American Indian groups targeted settlements that were well fortified and highly populated"
    }
   ],
