 "questions": [
  {
   "id": 614910,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best provides context for explaining why American Revolutionaries distrusted standing armies?",
   "answers": [
    {
     "id": 1167612,
     "content_html": "Washington’s leadership throughout the Revolution was excessively cruel and deceptive."
    },
    {
     "id": 1167611,
     "content_html": "Instances of betrayal, like that of Benedict Arnold, eroded trust among the military and, ultimately, the public as well."
    },
    {
     "id": 1167613,
     "content_html": "A variety of historical examples of armies overthrowing republican governments created suspicion of a standing army."
    },
    {
     "id": 1167610,
     "content_html": "The egalitarian nature of the army was entirely new for the colonies and it weakened their unity."
    }
   ],
