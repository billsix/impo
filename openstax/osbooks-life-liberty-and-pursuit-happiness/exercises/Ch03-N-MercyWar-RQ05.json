 "questions": [
  {
   "id": 614905,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Warren and her contemporaries advanced the idea of Republican Motherhood because",
   "answers": [
    {
     "id": 1167593,
     "content_html": "it elevated the status of motherhood to civic importance and respect by making mothers responsible for instilling patriotic values in their children"
    },
    {
     "id": 1167592,
     "content_html": "it emphasized the ideal role of women as staying in the home and advising their husbands on political matters"
    },
    {
     "id": 1167591,
     "content_html": "it encouraged women to stand equal with their husbands in national matters"
    },
    {
     "id": 1167590,
     "content_html": "it relied on conservative beliefs about child-rearing as designed to protect children from oppositional political parties"
    }
   ],
