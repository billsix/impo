 "questions": [
  {
   "id": 614547,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best expresses the opinion of Columbus regarding the Native Americans he encountered?",
   "answers": [
    {
     "id": 1166161,
     "content_html": "Native Americans were civilized according to European standards."
    },
    {
     "id": 1166160,
     "content_html": "Europeans would find it very difficult to subjugate these groups."
    },
    {
     "id": 1166159,
     "content_html": "It was unlikely that these Native Americans would be suited for slavery."
    },
    {
     "id": 1166162,
     "content_html": "The inhabitants were native to the East Indies."
    }
   ],
