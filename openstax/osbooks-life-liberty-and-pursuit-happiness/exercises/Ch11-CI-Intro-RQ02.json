   "stimulus_html": "",
   "stem_html": "Once the United States had declared war on Germany, what was President Wilson’s major goal?",
   "answers": [
    {
     "id": 1172048,
     "content_html": "To achieve “peace without victory”"
    },
    {
     "id": 1172049,
     "content_html": "To make the world safe for democracy"
    },
    {
     "id": 1172047,
     "content_html": "To stop the spread of communism"
    },
    {
     "id": 1172046,
     "content_html": "To increase trade with Europe"
    }
