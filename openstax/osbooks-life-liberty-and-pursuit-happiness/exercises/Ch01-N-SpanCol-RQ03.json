 "questions": [
  {
   "id": 614572,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Native Americans were required to submit to Spanish law, but",
   "answers": [
    {
     "id": 1166262,
     "content_html": "many were able to preserve their culture while accommodating Spanish norms\n"
    },
    {
     "id": 1166261,
     "content_html": "most resorted to outright revolt to resist new impositions\n"
    },
    {
     "id": 1166260,
     "content_html": "many abandoned their culture to fully embrace the Spanish way of life\n"
    },
    {
     "id": 1166259,
     "content_html": "few were able to understand the new culture and therefore were punished\n"
    }
   ],
