 "questions": [
  {
   "id": 615063,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was Benjamin Franklin’s purpose in presenting the petition from the Pennsylvania Society to Congress?",
   "answers": [
    {
     "id": 1168224,
     "content_html": "To open a healthy national debate about the morality of slavery"
    },
    {
     "id": 1168225,
     "content_html": "To encourage Congress to not only ban the slave trade but also end slavery"
    },
    {
     "id": 1168223,
     "content_html": "To forestall the impending civil war"
    },
    {
     "id": 1168222,
     "content_html": "To challenge public support for slavery"
    }
   ],
