   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Henry Clay’s political compromises are most closely associated with efforts to",
   "answers": [
    {
     "id": 1169052,
     "content_html": "secure the ratification of antebellum constitutional amendments"
    },
    {
     "id": 1169051,
     "content_html": "reconcile the policies of Jeffersonian Republicans with those of Jacksonian Democrats"
    },
    {
     "id": 1169050,
     "content_html": "incorporate remaining Federalists into the Whig party"
    },
    {
     "id": 1169053,
     "content_html": "smooth over sectional disputes that threatened to break apart the Union"
    }
   ],
