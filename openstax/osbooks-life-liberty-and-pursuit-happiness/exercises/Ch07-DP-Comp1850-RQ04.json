   "id": 615565,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the Compromise of 1850 try to placate the South for the loss of sectional balance in the U.S. Senate? ",
   "answers": [
    {
     "id": 1170228,
     "content_html": "By enlarging slave states like Texas\n"
    },
    {
     "id": 1170227,
     "content_html": "By banning the slave trade in Washington, DC\n"
    },
    {
     "id": 1170229,
     "content_html": "By making it easier to recapture runaway slaves\n"
    },
    {
     "id": 1170226,
     "content_html": "By admitting Utah as a slave state\n"
    }
   ],
