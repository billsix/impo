  },
  {
   "id": 614780,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The French differed from the English in their attitude toward American Indians in that the French",
   "answers": [
    {
     "id": 1167093,
     "content_html": "forced American Indians to convert to Catholicism"
    },
    {
     "id": 1167092,
     "content_html": "hired American Indians to negotiate business deals with other American Indian nations"
    },
    {
     "id": 1167094,
     "content_html": "lived peacefully among the American Indians, creating more personal relationships with them"
    },
    {
     "id": 1167091,
     "content_html": "made it a strict practice never to intermarry with the American Indians"
    }
   ],
