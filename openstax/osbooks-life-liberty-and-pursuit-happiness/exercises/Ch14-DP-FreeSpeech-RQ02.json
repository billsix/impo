 "questions": [
  {
   "id": 616777,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In <i>Tinker v. Des Moines Independent Community School District,</i> the U.S. Supreme Court ruled that",
   "answers": [
    {
     "id": 1174331,
     "content_html": "students did not have First Amendment rights"
    },
    {
     "id": 1174330,
     "content_html": "wearing armbands to protest the Vietnam War was a disruptive act"
    },
    {
     "id": 1174332,
     "content_html": "the constitutional rights of public school students did not stop at the schoolhouse door"
    },
    {
     "id": 1174329,
     "content_html": "wearing armbands was symbolic speech not covered by the First Amendment"
    }
   ],
