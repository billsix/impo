 "questions": [
  {
   "id": 615538,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  of these inferences is best supported by the information in this essay?",
   "answers": [
    {
     "id": 1170121,
     "content_html": "Job opportunities in the west for strong young men outnumbered those available for other demographic groups.\n"
    },
    {
     "id": 1170120,
     "content_html": "Life was easier and less stressful for most people in the east, compared with in the west.\n"
    },
    {
     "id": 1170119,
     "content_html": "More people went west seeking work as cowboys than as lumberjacks or miners.\n"
    },
    {
     "id": 1170118,
     "content_html": "One of the biggest threats to those who moved west was attack by American Indians.\n"
    }
   ],
