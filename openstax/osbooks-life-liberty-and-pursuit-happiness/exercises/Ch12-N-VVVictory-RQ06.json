   "stimulus_html": "",
   "stem_html": "<figure id=\"fig07\">\n<img src=\"exercises/media/70980affcfb717a2.png\" alt=\"An African American soldier sits on a motorcycle parked in front of the Military Police: Colored building.\">\n<figcaption>“An MP on motorcycle stands ready to answer all calls around his area. Columbus, Georgia.” April 13, 1942.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>\n<p>Situations such as the one depicted in the photograph led to</p>\n",
   "answers": [
    {
     "id": 1172912,
     "content_html": "creation of the Double V campaign"
    },
    {
     "id": 1172911,
     "content_html": "formation of the WAVES (Women Accepted for Volunteer Emergency Service) and WACS (Women’s Army Auxiliary Corps)"
    },
    {
     "id": 1172910,
     "content_html": "a fully integrated United States military by the end of World War II"
    },
    {
     "id": 1172909,
     "content_html": "a ban on African American combat troops in World War II"
    }
   ],
