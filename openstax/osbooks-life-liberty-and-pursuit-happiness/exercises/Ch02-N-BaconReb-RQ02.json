 "questions": [
  {
   "id": 614694,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements best describes the role of Nathaniel Bacon during the late seventeenth century?",
   "answers": [
    {
     "id": 1166749,
     "content_html": "Bacon desired and worked for peaceful relations with the American Indians."
    },
    {
     "id": 1166748,
     "content_html": "Bacon was a steadfast supporter of William Berkeley’s policies in governing colonial Virginia."
    },
    {
     "id": 1166750,
     "content_html": "Bacon came from a family of wealth and privilege but rallied poor farmers to oppose the wealthy and elite leaders in Virginia."
    },
    {
     "id": 1166747,
     "content_html": "Bacon was born into a poor yeoman farmer’s family on the Virginia frontier and fought to overcome the injustice of the social system."
    }
   ],
