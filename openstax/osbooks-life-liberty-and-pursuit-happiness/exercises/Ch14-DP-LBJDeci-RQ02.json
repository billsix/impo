   "stimulus_html": "",
   "stem_html": "The Tet Offensive in January 1968 marked a turning point because it",
   "answers": [
    {
     "id": 1174371,
     "content_html": "represented a military victory for the North Vietnamese"
    },
    {
     "id": 1174370,
     "content_html": "led to the collapse of the South Vietnamese military"
    },
    {
     "id": 1174372,
     "content_html": "illustrated the limitations of U.S. military efforts in Vietnam"
    },
    {
     "id": 1174369,
     "content_html": "strengthened support for containment in the United States"
    }
   ],
