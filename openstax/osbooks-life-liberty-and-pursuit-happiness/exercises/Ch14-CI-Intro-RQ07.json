   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "President John Kennedy decided he could prop up the South Vietnamese government using counterinsurgency tactics, which would",
   "answers": [
    {
     "id": 1173823,
     "content_html": "deploy massive numbers of American ground troops to fight communist-backed forces"
    },
    {
     "id": 1173822,
     "content_html": "exclusively rely on American airpower to hold back North Vietnamese attacks"
    },
    {
     "id": 1173824,
     "content_html": "use counterguerrilla tactics by highly trained units using unconventional tactics"
    },
    {
     "id": 1173821,
     "content_html": "depend on United Nations peacekeeping forces to stop the spread of communist forces into South Vietnam"
    }
