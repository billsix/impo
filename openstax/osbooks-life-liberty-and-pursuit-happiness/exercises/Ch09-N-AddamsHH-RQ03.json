   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jane Addams supported a number of political agendas, which included",
   "answers": [
    {
     "id": 1170532,
     "content_html": "literacy requirements for immigrants entering America and requiring them to learn English"
    },
    {
     "id": 1170531,
     "content_html": "U.S. entry into World War I to promote the spread of democracy"
    },
    {
     "id": 1170533,
     "content_html": "laws limiting the workday to eight hours and extending suffrage to women"
    },
    {
     "id": 1170530,
     "content_html": "tax breaks for large corporations to help create more jobs"
    }
   ],
