   "id": 614928,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is not true of the economic situation faced by the United States in the 1780s?",
   "answers": [
    {
     "id": 1167684,
     "content_html": "British harbors were closed to American exports, hurting the opportunities for profitable trade."
    },
    {
     "id": 1167683,
     "content_html": "British goods were flooding American markets, making it extremely difficult for American merchants to be successful."
    },
    {
     "id": 1167682,
     "content_html": "State debts from the Revolution were extremely high, limiting the government’s ability to address other needs."
    },
    {
     "id": 1167685,
     "content_html": "French support continued after the .war, allowing an influx of money to buoy the new economy in the short term"
    }
   ],
