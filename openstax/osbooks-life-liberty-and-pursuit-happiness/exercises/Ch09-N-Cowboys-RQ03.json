  {
   "id": 615625,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After the Big Die-Up of 1886–1887, the western ranching industry",
   "answers": [
    {
     "id": 1170469,
     "content_html": "gradually shifted from big cattle companies to smaller, family-owned operations"
    },
    {
     "id": 1170468,
     "content_html": "accepted federal regulation of the range for conservation purposes"
    },
    {
     "id": 1170467,
     "content_html": "ceased to be an important part of the national economy"
    },
    {
     "id": 1170466,
     "content_html": "blamed the U.S. government for failing to control rustlers"
    }
   ],
