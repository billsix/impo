   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After the “starving time” in the winter of 1609–1610, there was a brief period of peaceful coexistence between the English and Powhatans. What was the main reason for this time of peace?",
   "answers": [
    {
     "id": 1166617,
     "content_html": "The Powhatans’ need for new technology"
    },
    {
     "id": 1166618,
     "content_html": "The marriage between John Rolfe and Pocahontas"
    },
    {
     "id": 1166616,
     "content_html": "The English and Powhatans’ desire to form an alliance against the Spanish"
    },
    {
     "id": 1166615,
     "content_html": "The English and Powhatans’ need for new food sources"
    }
