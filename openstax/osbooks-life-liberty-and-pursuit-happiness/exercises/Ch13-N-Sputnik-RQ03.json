  {
   "id": 616443,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the legal question the U.S. government hoped to resolve before launching a satellite?",
   "answers": [
    {
     "id": 1173739,
     "content_html": "Whether private companies would be allowed to launch their own satellites"
    },
    {
     "id": 1173740,
     "content_html": "Whether one nation could legally orbit a satellite over another nation"
    },
    {
     "id": 1173738,
     "content_html": "Who owned the patents on the satellite’s design?"
    },
    {
     "id": 1173737,
     "content_html": "Who was responsible if a satellite crashed and killed or injured someone on the ground?"
    }
   ],
