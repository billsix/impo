 "questions": [
  {
   "id": 614813,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the motives of the French military during the Revolutionary War?",
   "answers": [
    {
     "id": 1167225,
     "content_html": "The French military supported the British because the French feared for the security of their own colonial holdings."
    },
    {
     "id": 1167226,
     "content_html": "The French military supported the American patriots against France’s rival, the British, to raise France’s own global political and economic standing."
    },
    {
     "id": 1167224,
     "content_html": "The French military was hired by Congress to fight on behalf of the rebels because the colonial population was much too small to successfully overthrow the British."
    },
    {
     "id": 1167223,
     "content_html": "The French military provided financial support to the Americans but remained physically uninvolved in the conflict."
    }
   ],
