   "id": 616257,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The costs associated with the Manhattan Project did not lead to protest primarily because",
   "answers": [
    {
     "id": 1172995,
     "content_html": "Congress considered the costs to be justified"
    },
    {
     "id": 1172994,
     "content_html": "President Roosevelt overruled any objections"
    },
    {
     "id": 1172993,
     "content_html": "atomic bombs were inexpensive to build"
    },
    {
     "id": 1172996,
     "content_html": "they were concealed from Congress"
    }
