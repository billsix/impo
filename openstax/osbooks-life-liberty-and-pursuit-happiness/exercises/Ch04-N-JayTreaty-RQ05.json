 "questions": [
  {
   "id": 615084,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Jay Treaty between the United States and Great Britain in the 1790s had all the following provisions except",
   "answers": [
    {
     "id": 1168309,
     "content_html": "Congress imposed “commercial discrimination” on Britain"
    },
    {
     "id": 1168308,
     "content_html": "the British promised to withdraw troops stationed in the Great Lakes region"
    },
    {
     "id": 1168307,
     "content_html": "Great Britain was given favored-nation status"
    },
    {
     "id": 1168306,
     "content_html": "the United States promised to remain neutral in the conflict between Britain and France"
    }
   ],
