   "stimulus_html": "",
   "stem_html": "In 1836, the Texans fought for",
   "answers": [
    {
     "id": 1169348,
     "content_html": "more territory from Mexico"
    },
    {
     "id": 1169347,
     "content_html": "the ability to keep enslaved people although Mexico had outlawed slavery"
    },
    {
     "id": 1169349,
     "content_html": "their independence"
    },
    {
     "id": 1169346,
     "content_html": "the freedom to keep their weapons, which Mexico wanted to confiscate"
    }
