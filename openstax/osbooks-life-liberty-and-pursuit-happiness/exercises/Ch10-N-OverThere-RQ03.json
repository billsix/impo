  {
   "id": 615948,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the entry of the United States into World War I immediately affect the German war strategy?",
   "answers": [
    {
     "id": 1171761,
     "content_html": "Germany renewed its assaults on the western front and launched an aggressive U-boat campaign."
    },
    {
     "id": 1171760,
     "content_html": "Germany convinced Russia to switch sides and attack France."
    },
    {
     "id": 1171759,
     "content_html": "Germany bombed London and attacked the Panama Canal."
    },
    {
     "id": 1171758,
     "content_html": "Germany sued for peace in the face of overwhelming American military strength."
    }
