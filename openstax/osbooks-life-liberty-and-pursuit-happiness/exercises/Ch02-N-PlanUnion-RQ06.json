 "questions": [
  {
   "id": 614734,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is true regarding the Albany Plan of Union?",
   "answers": [
    {
     "id": 1166909,
     "content_html": "It was used as a template for the new government created at the Constitutional Convention in 1787."
    },
    {
     "id": 1166908,
     "content_html": "It established an early colonial confederation that was key to the British victory during the French and Indian War."
    },
    {
     "id": 1166910,
     "content_html": "It was generally ignored by colonial government and the British."
    },
    {
     "id": 1166907,
     "content_html": "It was drafted and supported by royal officials."
    }
   ],
