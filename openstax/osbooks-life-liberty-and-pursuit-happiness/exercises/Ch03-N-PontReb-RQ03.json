 "questions": [
  {
   "id": 614827,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the context of Pontiac’s Rebellion?",
   "answers": [
    {
     "id": 1167281,
     "content_html": "The colonists were upset about the taxes levied on them by the British Parliament."
    },
    {
     "id": 1167282,
     "content_html": "The American Indians were worried about the consequences of their allies, the French, being forced from the area as a result of the imperial war."
    },
    {
     "id": 1167280,
     "content_html": "Frontier settlers were unhappy with their lack of representation in coastal governments."
    },
    {
     "id": 1167279,
     "content_html": "Increased communication between settlers in different colonies prompted them to launch an offensive attack on American Indian groups in the Ohio River Valley."
    }
   ],
