   "id": 614981,
   "is_answer_order_important": false,
   "stimulus_html": "<p>“Article the third . . . Congress shall make no law respecting an establishment of religion, or prohibiting the free exercise thereof; or abridging the freedom of speech, or of the press; or the right of the people peaceably to assemble, and to petition the Government for a redress of grievances.”</p>\n<p align=\"right\">First Amendment, Bill of Rights</p>",
   "stem_html": "\n<p><i>Refer to the excerpt provided.</i></p>\nWhich of the following foundational documents influenced the excerpt provided?",
   "answers": [
    {
     "id": 1167894,
     "content_html": "Declaration of Independence, written by Thomas Jefferson"
    },
    {
     "id": 1167895,
     "content_html": "<i>Common Sense</i>, written by Thomas Paine"
    },
    {
     "id": 1167896,
     "content_html": "Declaratory Act, written by British Parliament"
    },
    {
     "id": 1167897,
     "content_html": "Virginia Statute of Religious Freedom, written by Thomas Jefferson"
    }
