   "id": 615158,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Regarding the War of 1812, which statement is most accurate?",
   "answers": [
    {
     "id": 1168604,
     "content_html": "Provisions of the Treaty of Ghent extended the United States’ northern border with Canada, giving the country significant territory in the Great Lakes."
    },
    {
     "id": 1168603,
     "content_html": "Native Americans in the Northwest Territory made significant long-term advances in gaining sovereignty over their ancestral lands."
    },
    {
     "id": 1168605,
     "content_html": "Congressional representatives from the newly admitted western states saw advantages in declaring war on the British."
    },
    {
     "id": 1168602,
     "content_html": "British troops successfully invaded the United States along the Atlantic Coast and the northern border, ultimately losing at the Battle of New Orleans."
    }
   ],
