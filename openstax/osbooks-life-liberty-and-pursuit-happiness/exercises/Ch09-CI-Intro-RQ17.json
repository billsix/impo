 "questions": [
  {
   "id": 615590,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did many African Americans who supported the ideas of Booker T. Washington respond to Jim Crow laws in the South?",
   "answers": [
    {
     "id": 1170328,
     "content_html": "African Americans formed agriculturally based unions and used the strike to achieve their demands."
    },
    {
     "id": 1170329,
     "content_html": "Many became accommodationists, learning a trade to earn a living and become economically independent."
    },
    {
     "id": 1170327,
     "content_html": "African Americans started a radical civil rights movement."
    },
    {
     "id": 1170326,
     "content_html": "African Americans in the South became sharecroppers and refused to interact with white society."
    }
   ],
