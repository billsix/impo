 "questions": [
  {
   "id": 614733,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did Benjamin Franklin and the Albany Congress suggest on the topic of colonial confederation?",
   "answers": [
    {
     "id": 1166905,
     "content_html": "The colonies would elect a single President who would be independent from the British government."
    },
    {
     "id": 1166906,
     "content_html": "A legislature would be formed with representation determined by each colony’s contribution to the common treasury."
    },
    {
     "id": 1166904,
     "content_html": "Each colony would receive equal representation in the confederation."
    },
    {
     "id": 1166903,
     "content_html": "Individual colonies would retain the independent power to negotiate treaties and land purchases with American Indian groups."
    }
   ],
