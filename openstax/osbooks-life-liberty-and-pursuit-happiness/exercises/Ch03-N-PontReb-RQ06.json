 "questions": [
  {
   "id": 614830,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the British colonial reaction to the Proclamation Line?",
   "answers": [
    {
     "id": 1167294,
     "content_html": "Many felt the British had sided with American Indians and did not recognize the needs of the British colonists."
    },
    {
     "id": 1167293,
     "content_html": "Colonists were willing to adhere to the law and fully respected the authority of the British government."
    },
    {
     "id": 1167292,
     "content_html": "The influx of British redcoats made the colonists feel safe and secure in their frontier settlements."
    },
    {
     "id": 1167291,
     "content_html": "Most wanted to ally with American Indian groups and were frustrated by this prohibiting of advancement and communication"
    }
   ],
