   "id": 616711,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "North Vietnam’s military strategy during the Vietnam War",
   "answers": [
    {
     "id": 1174147,
     "content_html": "aimed to confront U.S. troops with human wave assaults"
    },
    {
     "id": 1174146,
     "content_html": "sought to defeat U.S. military forces through frontal attacks on troop concentrations"
    },
    {
     "id": 1174145,
     "content_html": "sought to continue and extend the tactics used during the battle of the Ia Drang Valley"
    },
    {
     "id": 1174148,
     "content_html": "depended on patience and a belief that time favored the communist side"
    }
   ],
