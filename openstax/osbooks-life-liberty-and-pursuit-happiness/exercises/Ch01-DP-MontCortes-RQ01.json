   "id": 614599,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Native American allies helped the Spanish defeat the Aztecs because ",
   "answers": [
    {
     "id": 1166369,
     "content_html": "the Spanish conquered them first and demanded it\n"
    },
    {
     "id": 1166370,
     "content_html": "they saw it as an opportunity to rid themselves of Aztec oppression\n"
    },
    {
     "id": 1166368,
     "content_html": "they believed the Spanish to be gods and therefore wanted to please them\n"
    },
    {
     "id": 1166367,
     "content_html": "they believed aiding the Spanish would rid them of smallpox\n"
    }
   ],
