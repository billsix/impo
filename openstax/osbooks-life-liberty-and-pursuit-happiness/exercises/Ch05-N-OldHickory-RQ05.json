 "questions": [
  {
   "id": 615191,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was the early fighting in the Battle of New Orleans considered a strategic military victory, even though it was a tactical defeat?",
   "answers": [
    {
     "id": 1168737,
     "content_html": "It allowed Jackson time to build earthworks and defenses to hold off a superior force."
    },
    {
     "id": 1168736,
     "content_html": "It led to Andrew Jackson’s becoming a popular American hero."
    },
    {
     "id": 1168735,
     "content_html": "It forced the Americans to attack well-trained British troops."
    },
    {
     "id": 1168734,
     "content_html": "It allowed time for the Treaty of Ghent to be negotiated."
    }
   ],
