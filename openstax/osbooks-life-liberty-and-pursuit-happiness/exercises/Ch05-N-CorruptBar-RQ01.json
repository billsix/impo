 "questions": [
  {
   "id": 615207,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Andrew Jackson respond to the outcome of the presidential election of 1824?",
   "answers": [
    {
     "id": 1168801,
     "content_html": "He organized an opposition party and ran again in 1828."
    },
    {
     "id": 1168800,
     "content_html": "He sued in federal court."
    },
    {
     "id": 1168799,
     "content_html": "He appealed to the Federal Election Commission."
    },
    {
     "id": 1168798,
     "content_html": "He wrote a bestselling memoir about his experiences as a failed candidate."
    }
   ],
