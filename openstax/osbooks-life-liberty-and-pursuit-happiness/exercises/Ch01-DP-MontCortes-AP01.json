   "stem_html": "According to the first excerpt, which of the following motivated conquistadors like Cortés to explore and conquer lands in the New World?",
   "answers": [
    {
     "id": 1166393,
     "content_html": "The desire to have friendly relations with the Native Americans\n"
    },
    {
     "id": 1166394,
     "content_html": "The desire to gain wealth \n"
    },
    {
     "id": 1166392,
     "content_html": "The desire to gain allies against Muslim invaders from the Ottoman Empire\n"
    },
    {
     "id": 1166391,
     "content_html": "The desire to conquer Asia and Africa\n"
    }
   ],
