 "questions": [
  {
   "id": 615519,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was John Brown’s method of freeing the enslaved persons held in bondage in the United States? ",
   "answers": [
    {
     "id": 1170048,
     "content_html": "He supported compensated emancipation and resettlement in Africa. \n"
    },
    {
     "id": 1170047,
     "content_html": "He preferred disunion with slaveholders because of the institution of slavery. \n"
    },
    {
     "id": 1170046,
     "content_html": "He supported the nonviolent emancipation of enslaved persons by the outlawing of slavery across the country. \n"
    },
    {
     "id": 1170049,
     "content_html": "He advocated arming enslaved persons to fight a violent racial war for their liberation. \n"
    }
   ],
