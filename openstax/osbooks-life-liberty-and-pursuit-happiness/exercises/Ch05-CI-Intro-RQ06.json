  {
   "id": 615154,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the Jeffersonian Era, the decisions of the U.S. Supreme Court illustrated",
   "answers": [
    {
     "id": 1168588,
     "content_html": "a rejection of the major political philosophy of the Federalist era"
    },
    {
     "id": 1168587,
     "content_html": "the subordination of judicial power to that of the Congress and the president"
    },
    {
     "id": 1168586,
     "content_html": "a willingness to decide cases consistent with Jeffersonian-Republican philosophy"
    },
    {
     "id": 1168589,
     "content_html": "the emergence of a strong and independent branch of the U.S. constitutional system"
    }
   ],
