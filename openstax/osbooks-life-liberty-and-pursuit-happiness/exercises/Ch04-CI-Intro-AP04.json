   "id": 615118,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The most significant reason for Washington’s proclamation was that",
   "answers": [
    {
     "id": 1168444,
     "content_html": "he wanted the U.S. military to focus on defense against American Indians"
    },
    {
     "id": 1168443,
     "content_html": "Americans were united about which side to support in the war in Europe"
    },
    {
     "id": 1168445,
     "content_html": "the U.S. government could not afford to fight in a war against European powers"
    },
    {
