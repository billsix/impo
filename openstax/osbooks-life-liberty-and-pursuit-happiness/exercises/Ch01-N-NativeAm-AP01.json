     "id": 1166145,
     "content_html": "shrewd and untrusting"
    },
    {
     "id": 1166144,
     "content_html": "cannibalistic and uncivilized"
    },
    {
     "id": 1166143,
     "content_html": "uneducated and lazy"
    }
   ],
