   "stimulus_html": "",
   "stem_html": "During the Bank War, Nicholas Biddle was",
   "answers": [
    {
     "id": 1169548,
     "content_html": "a prominent member of Congress who wanted to expose Andrew Jackson’s antagonism towards the Bank of the United States"
    },
    {
     "id": 1169547,
     "content_html": "a political ally of Andrew Jackson’s who wanted to close the Bank of the United States"
    },
    {
     "id": 1169549,
     "content_html": "the president of the Bank of the United States, who wanted its charter renewed"
    },
    {
     "id": 1169546,
     "content_html": "Andrew Jackson’s secretary of the Treasury who transferred money from the Bank of the United States to Jackson’s pet banks"
    }
   ],
