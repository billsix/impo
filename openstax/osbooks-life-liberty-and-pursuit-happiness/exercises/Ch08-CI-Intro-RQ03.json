   "id": 615715,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "France’s main motivation for involvement in the western hemisphere during this time is best described as a",
   "answers": [
    {
     "id": 1170829,
     "content_html": "new interest in expanding its presence in North America, especially in Mexico"
    },
    {
     "id": 1170828,
     "content_html": "desire to split up the United States to keep it from becoming an economic rival"
    },
    {
     "id": 1170827,
     "content_html": "need for raw materials such as cotton for newly established factories"
    },
    {
     "id": 1170826,
     "content_html": "need for a new military ally in its continued rivalry with Great Britain"
    }
   ],
