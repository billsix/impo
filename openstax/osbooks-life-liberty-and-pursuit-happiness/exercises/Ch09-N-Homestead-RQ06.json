   "id": 615657,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The ultimate result of the Homestead Steel Strike could be described as a victory for",
   "answers": [
    {
     "id": 1170596,
     "content_html": "labor unions, because they achieved their goal of higher wages"
    },
    {
     "id": 1170595,
     "content_html": "labor unions, because Carnegie Steel granted workers an eight-hour work day"
    },
    {
     "id": 1170597,
     "content_html": "Carnegie Steel, because it broke the power of the labor union"
    },
    {
     "id": 1170594,
     "content_html": "Carnegie Steel, because it cut workers’ wages by 25%"
    }
