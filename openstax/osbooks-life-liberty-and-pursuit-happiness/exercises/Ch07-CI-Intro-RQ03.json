   "id": 615404,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Abraham  Lincoln’s criticism of popular sovereignty was based on",
   "answers": [
    {
     "id": 1169589,
     "content_html": "his unwillingness to believe a single vote could deprive anyone of the natural right to liberty"
    },
    {
     "id": 1169588,
     "content_html": "his reading of <i>Uncle Tom’s Cabin</i>"
    },
    {
     "id": 1169587,
     "content_html": "his personal experience of owning slaves years before"
    },
    {
     "id": 1169586,
     "content_html": "his participation in the attempt to rescue Anthony Burns"
    }
   ],
