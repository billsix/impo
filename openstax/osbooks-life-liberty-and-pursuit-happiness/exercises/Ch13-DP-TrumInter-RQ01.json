 "questions": [
  {
   "id": 616387,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What role did the United States play in events in Korea after World War II?",
   "answers": [
    {
     "id": 1173515,
     "content_html": "The United States promised to defend Korea against communist aggression according to the terms of the Truman Doctrine."
    },
    {
     "id": 1173516,
     "content_html": "The United States supported a process of free elections to set up a government in South Korea."
    },
    {
     "id": 1173514,
     "content_html": "The U.S. military had a continuing responsibility to protect Korea against threatened Japanese aggression."
    },
    {
     "id": 1173513,
     "content_html": "The United States collaborated with China to establish peace-keeping operations between North Korea and South Korea."
    }
   ],
