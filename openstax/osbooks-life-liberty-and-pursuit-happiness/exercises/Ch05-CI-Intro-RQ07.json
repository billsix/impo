 "questions": [
  {
   "id": 615155,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The purchase of the Louisiana Territory represented a constitutional challenge for the United States because",
   "answers": [
    {
     "id": 1168593,
     "content_html": "Congress and the president lacked the clear constitutional authority to increase the size of the nation"
    },
    {
     "id": 1168592,
     "content_html": "the United States lacked the funding to pay for the purchase"
    },
    {
     "id": 1168591,
     "content_html": "Democratic-Republicans felt threatened by the amount of land the purchase included"
    },
    {
     "id": 1168590,
     "content_html": "the Marshall Court had ruled the purchase unconstitutional"
    }
   ],
