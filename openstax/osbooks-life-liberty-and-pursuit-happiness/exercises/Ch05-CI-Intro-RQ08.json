   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Foreign relations preceding the War of 1812 presented a challenge for the young United States for all the following reasons except",
   "answers": [
    {
     "id": 1168596,
     "content_html": "war between Britain and France affected U.S. free trade"
    },
    {
     "id": 1168595,
     "content_html": "French attacks on American shipping continued despite congressional action"
    },
    {
     "id": 1168597,
     "content_html": "British support of the Embargo Act led the New England states to thrive economically"
    },
    {
     "id": 1168594,
     "content_html": "the <i>H.M.S. Leopard</i> fired upon the <i>U.S.S. Chesapeake</i>, seizing alleged British deserters"
    }
