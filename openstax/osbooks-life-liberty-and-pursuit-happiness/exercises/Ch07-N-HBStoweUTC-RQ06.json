   "stimulus_html": "",
   "stem_html": "<figure id=\"fig7_29\">\n<img src=\"exercises/media/58b518300a8c4125.png\" alt=\"Title page of the book Uncle Tom’s Cabin, showing several black people\">\n<figcaption>Title page of Harriet Beecher Stowe’s novel <i>Uncle Tom’s Cabin.</i></figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>\n<p>According to the title page, this edition of the novel was published in </p>",
   "answers": [
    {
     "id": 1169876,
     "content_html": "a free state and a slave state\n"
    },
    {
     "id": 1169877,
     "content_html": "a city known for its strong connection to abolitionist sentiment\n"
    },
    {
     "id": 1169875,
     "content_html": "states that bordered slave states\n"
    },
    {
     "id": 1169874,
     "content_html": "two of the 10 largest cities in the United States at the time\n"
    }
