 "stimulus_html": "<figure id=\"fig7_44\">\n<img src=\"exercises/media/43092c79de104ec5.png\" alt=\"Cartoon of a giant man being held down by men who stand on a platform on which is written “Democratic Platform,” along with “Central America, Cuba, and Kansas.” An African American man is being forced into the giant man’s mouth, while murder and chaos are depicted in the background. Coming out of the giant man’s mouth is a bubble with the text “Murder!!! help—neighbors help. O my poor wife and children. The bottom of the cartoon states: “Forcing slavery down the throat of a Free Soiler.”\">\n<figcaption>This cartoon from 1856 shows Lewis Cass and James Buchanan holding down the hair of a Free Soiler while Franklin Pierce holds down his beard and Stephen Douglas forces an African American down his throat.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>\n",
 "questions": [
  {
   "id": 615505,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following motivated the viewpoint in the cartoon?",
   "answers": [
    {
     "id": 1169993,
     "content_html": "Inclusion of proslavery provisions in the Democratic Party platform\n"
    },
    {
     "id": 1169992,
     "content_html": "Extension of the Missouri Compromise line to the Pacific\n"
    },
    {
     "id": 1169991,
     "content_html": "Compromises related to the entry of California as a free state\n"
    },
    {
     "id": 1169990,
     "content_html": "Existence of slavery in the Chesapeake states of Virginia and Maryland\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615506,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The conditions in the provided image influenced the",
   "answers": [
    {
     "id": 1169996,
     "content_html": "repeal of the Compromise of 1820\n"
    },
    {
     "id": 1169995,
     "content_html": "passage of the Indian Removal Act\n"
    },
    {
     "id": 1169994,
     "content_html": "development of the Oregon Trail\n"
    },
    {
     "id": 1169997,
     "content_html": "formation of the Republican Party\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615507,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The image most directly reflected a growing belief that",
   "answers": [
    {
     "id": 1170000,
     "content_html": "slavery was becoming increasingly unprofitable\n"
    },
    {
     "id": 1170001,
     "content_html": "the nation could not continue to exist with half the states permitting slavery and half not permitting it\n"
    },
    {
     "id": 1169999,
     "content_html": "economic power was shifting to west of the Mississippi River\n\n"
    },
    {
     "id": 1169998,
     "content_html": "slave labor would be replaced by that of recent immigrants"
    }
   ],
