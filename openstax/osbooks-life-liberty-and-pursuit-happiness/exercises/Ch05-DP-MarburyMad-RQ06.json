   "id": 615253,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A main result of the decisions rendered during the Marshall Court years was",
   "answers": [
    {
     "id": 1168984,
     "content_html": "a strengthening of Federalist power in the South and the West"
    },
    {
     "id": 1168983,
     "content_html": "the assertion that the federal judiciary is subordinate to the political branches of government"
    },
    {
     "id": 1168985,
     "content_html": "growing influence of the judicial branch in deciding the meaning of the U.S. Constitution"
    },
    {
     "id": 1168982,
     "content_html": "growing federal judicial support for states’ rights positions"
    }
   ],
