   "id": 616446,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The United States’ immediate response to the launch of Sputnik was",
   "answers": [
    {
     "id": 1173751,
     "content_html": "President Eisenhower’s doubling of the American military presence in Europe"
    },
    {
     "id": 1173752,
     "content_html": "the failed launch of a Vanguard rocket by the U.S. Navy"
    },
    {
     "id": 1173750,
     "content_html": "an increase in American missile production"
    },
    {
     "id": 1173749,
     "content_html": "President Eisenhower’s attempt to make the accomplishment seem unimportant"
    }
   ],
