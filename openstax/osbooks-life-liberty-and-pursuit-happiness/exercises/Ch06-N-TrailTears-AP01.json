 "is_vocab": false,
 "stimulus_html": "<p>“And be it further enacted, That it shall and may be lawful for the President to have the same superintendence and care over any tribe or nation in the country to which they may remove, as contemplated by this act, that he is now authorized to have over them at their present places of residence: Provided, That nothing in this act contained shall be construed as authorizing or directing the violation of any existing treaty between the United States and any of the Indian tribes.”</p>\n<p align=\"right\"><i>Indian Removal Act</i>, signed by Andrew Jackson May 28, 1830</p>\n<p><i>Refer to the excerpt provided.</i></p>",
 "questions": [
  {
   "id": 615322,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Indian Removal Act was a",
   "answers": [
    {
     "id": 1169261,
     "content_html": "formal acknowledgement of the president’s power to direct relocation of American Indians"
    },
    {
     "id": 1169260,
     "content_html": "radical departure from previous presidents’ policies regarding Indian ways of life"
    },
    {
     "id": 1169259,
     "content_html": "formal and specific assurance of protection of American Indians’ individual constitutional rights"
    },
    {
     "id": 1169258,
     "content_html": "repudiation of all previous treaties between the United States and American Indians"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615323,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The main idea expressed in the excerpt from the <i>Indian Removal Act</i> was most likely motivated by",
   "answers": [
    {
     "id": 1169264,
     "content_html": "an overwhelming demand from Congress for new treaties that would protect American Indians’ rights, culture, and economic survival by relocating them to rich farmlands in the west"
    },
    {
     "id": 1169265,
     "content_html": "a desire by the state of Georgia to remove the Cherokee from their land"
    },
    {
     "id": 1169263,
     "content_html": "Andrew Jackson’s demand that American Indians be protected by enforcement of all treaties between the United States and the tribes"
    },
    {
     "id": 1169262,
     "content_html": "the request by American Indians that they receive territory free of U.S. government interference"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
