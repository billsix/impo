 "questions": [
  {
   "id": 615931,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After the United States officially entered World War I, the power of the federal government",
   "answers": [
    {
     "id": 1171692,
     "content_html": "decreased, due to the unpopularity of the war"
    },
    {
     "id": 1171693,
     "content_html": "increased, with the creation of various boards to mobilize for a wartime economy"
    },
    {
     "id": 1171691,
     "content_html": "shifted to the states, as each struggled to reach its enlistment quota"
    },
    {
     "id": 1171690,
     "content_html": "shrank, as a result of congressional legislative action"
    }
   ],
