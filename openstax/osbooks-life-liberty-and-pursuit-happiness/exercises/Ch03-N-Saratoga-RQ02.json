 "questions": [
  {
   "id": 614868,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the French alliance change the war for the Americans?",
   "answers": [
    {
     "id": 1167446,
     "content_html": "France provided crucial military support and legitimate recognition of American independence, which strengthened the Americans militarily and politically."
    },
    {
     "id": 1167445,
     "content_html": "The French military intervened at the Battle of Saratoga, effectively saving Americans from decimation at the hands of the British."
    },
    {
     "id": 1167444,
     "content_html": "French recognition of the might of the American military prior to the Battle of Saratoga ensured that Americans were on equal footing with the British."
    },
    {
     "id": 1167443,
     "content_html": "The French provided crucial naval aid and troops to combat the British in their own element: the seas."
    }
   ],
