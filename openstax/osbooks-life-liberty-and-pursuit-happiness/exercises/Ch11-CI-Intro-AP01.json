 "stimulus_html": "<figure id=\"BRI_APUSH_11_02_SilverSam\" class=\"scaled-down-70\">\n<img src=\"exercises/media/8b6acd4c271621de.png\" alt=\"Uncle Sam sits on some steps and rests his chin in his hand. Behind him is a sign that reads “U.S. Treasury.” At his feet is a money sack labeled “Liquor revenue.” The caption reads “The Thirty Pieces of Silver.”\">\n<figcaption>This political cartoon shows Uncle Sam looking at a bag labeled “Liquor Revenue” and containing 30 pieces of silver. The caption reads, “The thirty pieces of silver. Uncle Sam (remorsefully): Does it pay?”</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 616092,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This political cartoon is a response to the",
   "answers": [
    {
     "id": 1172336,
     "content_html": "immigration of illiterate eastern Europeans"
    },
    {
     "id": 1172335,
     "content_html": "unionization of unskilled workers"
    },
    {
     "id": 1172334,
     "content_html": "failure of Progressive programs to help the poor"
    },
    {
     "id": 1172337,
     "content_html": "loss of tax revenue due to prohibition"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616093,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following groups would most likely support the sentiment that led to the situation depicted in the cartoon?",
   "answers": [
    {
     "id": 1172340,
     "content_html": "Farmers"
    },
    {
     "id": 1172339,
     "content_html": "Irish and German immigrants"
    },
    {
     "id": 1172341,
     "content_html": "Fundamentalist Christians"
    },
    {
     "id": 1172338,
     "content_html": "Members of labor unions"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616094,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The federal law hinted at in the political cartoon",
   "answers": [
    {
     "id": 1172344,
     "content_html": "made it illegal to drink alcoholic beverages without a permit from the U.S. Treasury"
    },
    {
     "id": 1172345,
     "content_html": "resulted in development of a big business that enriched criminal gangs linked to big-city political machines"
    },
    {
     "id": 1172343,
     "content_html": "was most popular among Irish, German, and Italian immigrants in big cities"
    },
    {
     "id": 1172342,
     "content_html": "became more difficult to enforce when the U.S. government promoted conservation of food during World War I"
    }
   ],
