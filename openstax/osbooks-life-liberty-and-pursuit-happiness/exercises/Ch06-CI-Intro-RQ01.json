   "stimulus_html": "",
   "stem_html": "Andrew Jackson defeated incumbent president John Quincy Adams in the election of 1828 primarily because of",
   "answers": [
    {
     "id": 1169064,
     "content_html": "Adams’s opposition to slavery"
    },
    {
     "id": 1169063,
     "content_html": "Jackson’s determination to remove American Indians"
    },
    {
     "id": 1169062,
     "content_html": "Adams’s perceived weakness in foreign relations"
    },
    {
     "id": 1169065,
     "content_html": "the Jackson campaign’s focus on reaching a broad electorate"
    }
