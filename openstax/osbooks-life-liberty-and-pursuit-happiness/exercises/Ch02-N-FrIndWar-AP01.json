   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following most accurately describes the impact on the colonies of the conflict described?",
   "answers": [
    {
     "id": 1167165,
     "content_html": "The colonies won their economic independence from England."
    },
    {
     "id": 1167164,
     "content_html": "The French gained permanent possession of the Ohio River Valley, ending English claims on the region."
    },
    {
     "id": 1167166,
     "content_html": "The English needed the colonies to help pay the cost of their defense and so increased taxation."
    },
    {
     "id": 1167163,
     "content_html": "The Great Awakening began to spread into the interior of North America."
    }
