   "stimulus_html": "",
   "stem_html": "Which of the following best describes the point of view of the soldier based on the excerpt provided?",
   "answers": [
    {
     "id": 1167161,
     "content_html": "He is dedicated to the cause of the British in the war."
    },
    {
     "id": 1167162,
     "content_html": "He resents that he has not received the benefits of Englishmen’s liberty."
    },
    {
     "id": 1167160,
     "content_html": "He will re-enlist at the first opportunity."
    },
    {
     "id": 1167159,
     "content_html": "He is comfortable that he has all the supplies he needs in the face of oncoming cold weather."
    }
   ],
