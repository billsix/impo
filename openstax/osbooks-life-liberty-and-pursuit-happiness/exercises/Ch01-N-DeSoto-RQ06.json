 "questions": [
  {
   "id": 614566,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What difficulties did de Soto and his men face while exploring Florida?",
   "answers": [
    {
     "id": 1166237,
     "content_html": "Freezing temperatures and large snow storms killed half the men.\n"
    },
    {
     "id": 1166238,
     "content_html": "Swamps made travel difficult for men and horses.\n"
    },
    {
     "id": 1166236,
     "content_html": "Desert conditions contributed to the death of 75 percent of de Soto’s men.\n"
    },
    {
     "id": 1166235,
     "content_html": "Attacks by French and English explorers forced de Soto to abandon the expedition.\n"
    }
   ],
