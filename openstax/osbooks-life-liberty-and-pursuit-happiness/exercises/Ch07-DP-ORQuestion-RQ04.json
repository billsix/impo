   "stimulus_html": "",
   "stem_html": "Some Whigs resented Polk’s compromise on the Oregon Question because it ",
   "answers": [
    {
     "id": 1170192,
     "content_html": "allowed the expansion of slavery into the Pacific Northwest\n"
    },
    {
     "id": 1170193,
     "content_html": "failed to acquire all of Oregon to offset the annexation of Texas\n"
    },
    {
     "id": 1170191,
     "content_html": "violated the sovereignty of American Indian tribes\n"
    },
    {
     "id": 1170190,
     "content_html": "hurt northern business interests by antagonizing Great Britain\n"
    }
