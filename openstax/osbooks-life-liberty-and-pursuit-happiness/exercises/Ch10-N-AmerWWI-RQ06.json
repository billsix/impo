   "stem_html": "Germany’s reasoning behind the Zimmerman telegram to Mexico was based, in part, on Mexico’s",
   "answers": [
    {
     "id": 1171744,
     "content_html": "desire to regain territory lost under the Louisiana Purchase"
    },
    {
     "id": 1171743,
     "content_html": "refusal to pay outstanding war debts to the United States"
    },
    {
     "id": 1171742,
     "content_html": "displeasure at harsh American restrictions on Mexican emigration"
    },
    {
     "id": 1171745,
     "content_html": "objection to the United States’ pursuit of Pancho Villa on Mexican soil"
    }
