   "id": 615748,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Congress passed a conscription law because",
   "answers": [
    {
     "id": 1170960,
     "content_html": "it was believed that a draft was a more democratic way of raising an army"
    },
    {
     "id": 1170959,
     "content_html": "too many men wanted to volunteer and the government needed a way to control the size of the army"
    },
    {
     "id": 1170958,
     "content_html": "Congress wanted more citizens in the army because too many immigrants were fighting the war"
    },
    {
     "id": 1170961,
     "content_html": "the rush to enlist to save the Union had ebbed and more men were needed"
    }
   ],
