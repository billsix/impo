 "questions": [
  {
   "id": 614917,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the Revolutionary War affect the U.S. relationship with the Church of England?",
   "answers": [
    {
     "id": 1167640,
     "content_html": "Most in the colonies remained devoted to their Anglican religion, and the church itself experienced little change."
    },
    {
     "id": 1167639,
     "content_html": "Loyalists were unwilling to support the Church of England because it conflicted with their views on liberty, resulting in a decline of Anglicanism in the colonies."
    },
    {
     "id": 1167638,
     "content_html": "Adherence to religious freedom was respected to such a degree that religious affiliation with the Anglican Church did not matter to the colonists."
    },
    {
     "id": 1167641,
     "content_html": "The Church of England was associated with Loyalists, so Patriots distrusted it to such an extent that the reputation of Anglicans was marred after the conclusion of the war."
    }
   ],
