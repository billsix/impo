 "questions": [
  {
   "id": 615467,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Changes  to the provisions of the Fugitive Slave Act in 1850 were designed to ",
   "answers": [
    {
     "id": 1169841,
     "content_html": "placate the South for the loss of the slave/free sectional balance in the Senate with the admission of California as a free state\n"
    },
    {
     "id": 1169840,
     "content_html": "counter the widespread popularity of William Lloyd Garrison’s calls for “immediate and uncompensated emancipation”\n"
    },
    {
     "id": 1169839,
     "content_html": "demonstrate the growing nationwide belief that slavery was a “positive good”\n"
    },
    {
     "id": 1169838,
     "content_html": "diminish the electoral power of the newly created Western states\n"
    }
   ],
