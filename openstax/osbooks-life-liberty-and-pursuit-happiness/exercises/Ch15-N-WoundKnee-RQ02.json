 "questions": [
  {
   "id": 616880,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One reason protestors chose to occupy Wounded Knee, South Dakota, was that",
   "answers": [
    {
     "id": 1174744,
     "content_html": "it had been the site of a massacre in 1890"
    },
    {
     "id": 1174743,
     "content_html": "it was on a high hill, which made it easy to defend"
    },
    {
     "id": 1174742,
     "content_html": "it was where tribal chair Richard Wilson lived"
    },
    {
     "id": 1174741,
     "content_html": "it had the reservation’s only radio station"
    }
   ],
