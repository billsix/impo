     "id": 1171512,
     "content_html": "the size of the trust determined its legality"
    },
    {
     "id": 1171511,
     "content_html": "labor unions violated antitrust legislation"
    },
    {
     "id": 1171513,
     "content_html": "unfair business practices could be successfully prosecuted"
    },
    {
     "id": 1171510,
     "content_html": "it was reasonable for monopolies to engage in unscrupulous business practices"
