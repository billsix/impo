 "questions": [
  {
   "id": 614817,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes George Washington’s leadership of the Continental Army?",
   "answers": [
    {
     "id": 1167241,
     "content_html": "Fierce fighter who had an iron grip on the infantry units and who would use his war experience to influence the colonial legislature"
    },
    {
     "id": 1167242,
     "content_html": "Long-term strategist willing to use new tactics to gain victories and boost morale"
    },
    {
     "id": 1167240,
     "content_html": "Lackluster commander unable to successfully achieve the task of independence"
    },
    {
     "id": 1167239,
     "content_html": "Extremely competitive personality who betrayed the revolutionary cause by siding with the British"
    }
   ],
