   "stimulus_html": "",
   "stem_html": "Robert F. Kennedy’s announcement that he would enter the race for the Democratic presidential nomination in 1968",
   "answers": [
    {
     "id": 1174267,
     "content_html": "signaled the resurgence of public opinion in favor of the Vietnam War"
    },
    {
     "id": 1174268,
     "content_html": "represented a serious challenge to Lyndon B. Johnson’s renomination"
    },
    {
     "id": 1174266,
     "content_html": "ensured a Republican presidential victory"
    },
    {
     "id": 1174265,
     "content_html": "supported a similar political agenda as that of Governor George Wallace of Alabama"
    }
