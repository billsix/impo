   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Government efforts to mobilize the economy during World War I influenced the development of programs to combat the Great Depression because",
   "answers": [
    {
     "id": 1172620,
     "content_html": "military leaders headed New Deal agencies"
    },
    {
     "id": 1172621,
     "content_html": "business-government cooperative efforts had proved successful before"
    },
    {
     "id": 1172619,
     "content_html": "public relations campaigns had little effect"
    },
    {
     "id": 1172618,
     "content_html": "the Supreme Court ruled any federal regulation of the economy to be unconstitutional"
    }
