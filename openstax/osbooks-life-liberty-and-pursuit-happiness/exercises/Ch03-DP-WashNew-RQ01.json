 "questions": [
  {
   "id": 614907,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes why Continental Army officers were angry and threatening to rebel against their leadership?",
   "answers": [
    {
     "id": 1167600,
     "content_html": "Washington had made a tactical error that resulted in huge losses for the Continental Army."
    },
    {
     "id": 1167599,
     "content_html": "The officers believed the Confederation Congress was acting tyrannically by placing executive power in Washington’s hands."
    },
    {
     "id": 1167601,
     "content_html": "The officers had neither been paid as promised by the Confederation Congress nor were they guaranteed pay once the war ended."
    },
    {
     "id": 1167598,
     "content_html": "Congress was imposing harsh taxes, so they wanted Washington to take control of the government as a military dictator."
    }
   ],
