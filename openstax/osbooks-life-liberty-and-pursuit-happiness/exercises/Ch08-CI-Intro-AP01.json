  {
   "id": 615817,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was an immediate outcome of the execution of the document?",
   "answers": [
    {
     "id": 1171234,
     "content_html": "The ratification of the Thirteenth Amendment to the U.S. Constitution"
    },
    {
     "id": 1171237,
     "content_html": "A major change in the Union’s wartime goals"
    },
    {
     "id": 1171235,
     "content_html": "The creation of the Freedmen’s Bureau"
    },
    {
     "id": 1171236,
     "content_html": "The end of the Civil War"
    }
