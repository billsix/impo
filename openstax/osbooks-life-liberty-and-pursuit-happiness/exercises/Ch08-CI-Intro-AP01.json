   ],
   "combo_choices": []
  },
  {
   "id": 615816,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "People who supported the ideals expressed in the excerpt might include",
   "answers": [
    {
     "id": 1171230,
     "content_html": "settlers who violated the <i>Proclamation of 1763</i>"
    },
    {
     "id": 1171233,
     "content_html": "northern abolitionists who agreed with William Lloyd Garrison"
    },
    {
     "id": 1171231,
     "content_html": "states’ rights supporters who agreed with the Virginia and Kentucky Resolutions"
    },
    {
     "id": 1171232,
     "content_html": "the authors of the resolutions published by the Hartford Convention"
    }
   ],
