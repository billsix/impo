 "questions": [
  {
   "id": 615059,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One major reason James Madison initially believed a bill of rights was unnecessary was that",
   "answers": [
    {
     "id": 1168208,
     "content_html": "a specific list of rights could be misinterpreted and violated"
    },
    {
     "id": 1168209,
     "content_html": "the United States would be broken into many factions and the majority could not violate the rights of the minority"
    },
    {
     "id": 1168207,
     "content_html": "individual rights were implied in the body of the Constitution"
    },
    {
     "id": 1168206,
     "content_html": "a bill of rights would give the people too much authority"
    }
   ],
