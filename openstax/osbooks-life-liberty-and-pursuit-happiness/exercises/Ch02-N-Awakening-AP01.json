  {
   "id": 614790,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on the excerpt provided, how could a historian describe Whitfield’s appeal to his audience?",
   "answers": [
    {
     "id": 1167133,
     "content_html": "Whitefield could not project his voice unaided to thousands of people."
    },
    {
     "id": 1167132,
     "content_html": "Whitefield looked a bit sloppy, but his audience overlooked that."
    },
    {
     "id": 1167134,
     "content_html": "Whitefield’s effect was almost overpowering."
    },
    {
     "id": 1167131,
     "content_html": "Whitefield was not a Calvinist preacher."
    }
