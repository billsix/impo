   ],
   "combo_choices": []
  },
  {
   "id": 615126,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the late eighteenth century, which group would most likely support the sentiments expressed in the excerpt?",
   "answers": [
    {
     "id": 1168476,
     "content_html": "A yeoman farmer from New York"
    },
    {
     "id": 1168475,
     "content_html": "A congressman from Virginia"
    },
    {
     "id": 1168477,
     "content_html": "A Quaker from Pennsylvania"
    },
    {
     "id": 1168474,
     "content_html": "A trade merchant from South Carolina"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615127,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The point of view presented in the petition excerpted suggests what about the institution of slavery?",
   "answers": [
    {
     "id": 1168481,
     "content_html": "The immorality of slavery outweighs potential economic gains from the use of slave labor."
    },
    {
     "id": 1168480,
     "content_html": "The economic and social arguments in favor of slavery are paramount."
    },
    {
     "id": 1168479,
     "content_html": "The social and cultural structure of American society in the late eighteenth century make slavery unnecessary."
    },
    {
     "id": 1168478,
     "content_html": "Although an “evil habit,” slavery is necessary for the United States to remain a viable economic power."
    }
   ],
