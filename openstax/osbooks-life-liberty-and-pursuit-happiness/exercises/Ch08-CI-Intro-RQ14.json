 "questions": [
  {
   "id": 615726,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the election of 1866, President Andrew Johnson’s “Swing Around the Circle” was considered",
   "answers": [
    {
     "id": 1170872,
     "content_html": "a success because Johnson persuaded many Democrats who formerly opposed him to support his reconstruction plan"
    },
    {
     "id": 1170871,
     "content_html": "a success because Democrats picked up a supermajority of support because the South was back in the Union"
    },
    {
     "id": 1170870,
     "content_html": "a failure because Republicans wanted Johnson to be more lenient to the South"
    },
    {
     "id": 1170873,
     "content_html": "a failure because Radical Republicans picked up a supermajority in Congress, meaning they could override any presidential veto"
    }
   ],
