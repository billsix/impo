 "questions": [
  {
   "id": 614911,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the attempted military coup of 1783 ultimately end?",
   "answers": [
    {
     "id": 1167616,
     "content_html": "Ranking officers garnered enough support from their troops to sequester the aging Washington and take control from Congress."
    },
    {
     "id": 1167617,
     "content_html": "Washington’s display of sacrifice and humility dissipated the tension and resulted in even greater respect for the commander in chief."
    },
    {
     "id": 1167615,
     "content_html": "Each officer who participated in the circulation of the address was identified and executed, setting an example for any who might have considered further action."
    },
    {
     "id": 1167614,
     "content_html": "A messenger dispatched to the Continental Congress convinced them to capitulate to the pleas of the soldiers with immediate paychecks and supplies."
    }
   ],
