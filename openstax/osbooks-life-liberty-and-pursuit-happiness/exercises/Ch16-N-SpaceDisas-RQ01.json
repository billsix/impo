   "stimulus_html": "",
   "stem_html": "After landing a human on the moon in 1969, NASA had to contend with",
   "answers": [
    {
     "id": 1175176,
     "content_html": "a loss of interest in funding space exploration"
    },
    {
     "id": 1175175,
     "content_html": "competition from privately funded space ventures"
    },
    {
     "id": 1175174,
     "content_html": "a surge in public support for space travel"
    },
    {
     "id": 1175173,
     "content_html": "the choice between focusing on a Mars mission or a space station on the moon"
    }
   ],
