   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the French send troops to secure the Ohio country in 1753?",
   "answers": [
    {
     "id": 1166934,
     "content_html": "To connect their imperial strongholds in Canada and Louisiana"
    },
    {
     "id": 1166933,
     "content_html": "To negotiate a treaty with the Indians"
    },
    {
     "id": 1166932,
     "content_html": "To build forts to protect French settlers"
    },
    {
     "id": 1166931,
     "content_html": "To clear the land for farming"
    }
   ],
