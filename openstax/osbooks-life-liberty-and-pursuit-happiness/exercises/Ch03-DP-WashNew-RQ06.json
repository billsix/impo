 "questions": [
  {
   "id": 614912,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following actions sealed Washington’s character as one of republican virtue?",
   "answers": [
    {
     "id": 1167620,
     "content_html": "Successful overthrow of the Continental Congress at the request of his highest-ranking officers"
    },
    {
     "id": 1167619,
     "content_html": "Victory over British General Cornwallis at Yorktown, Virginia"
    },
    {
     "id": 1167621,
     "content_html": "Peaceful transfer of power from commander in chief of the military to the legislative ruling body of the new nation"
    },
    {
     "id": 1167618,
     "content_html": "Inclusion of multiple classes and ethnicities within the ranks of his army"
    }
   ],
