 "questions": [
  {
   "id": 614621,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Although the Puritans aimed for the purification of the Church of England, Pilgrims believed which of the following?",
   "answers": [
    {
     "id": 1166457,
     "content_html": "The Church of England was right in all things and must separate itself from the Puritans.\n"
    },
    {
     "id": 1166458,
     "content_html": "The Church of England could not be purified and the Pilgrims must separate themselves from it.\n"
    },
    {
     "id": 1166456,
     "content_html": "The Puritans were a radical and dangerous sect.\n"
    },
    {
     "id": 1166455,
     "content_html": "Freedom to practice religion should be extended to all religious groups.\n"
    }
   ],
