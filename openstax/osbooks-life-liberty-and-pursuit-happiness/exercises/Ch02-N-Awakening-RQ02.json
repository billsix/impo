 "questions": [
  {
   "id": 614716,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did local ministers feel about George Whitefield and other traveling preachers coming to their towns uninvited?",
   "answers": [
    {
     "id": 1166837,
     "content_html": "They welcomed these popular preachers, who brought more people into their church."
    },
    {
     "id": 1166838,
     "content_html": "They worried that revivalists undermined their spiritual authority."
    },
    {
     "id": 1166836,
     "content_html": "They appreciated the chance to study the techniques of the traveling preachers."
    },
    {
     "id": 1166835,
     "content_html": "They were indifferent to the Great Awakening preachers."
    }
   ],
