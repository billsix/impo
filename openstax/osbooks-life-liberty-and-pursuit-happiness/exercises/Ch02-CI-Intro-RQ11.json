   "id": 614644,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following were factors that led to the eventual end of American Indian resistance to European explorers and colonists in North America except",
   "answers": [
    {
     "id": 1166550,
     "content_html": "the relatively few Europeans who came to the Americas"
    },
    {
     "id": 1166549,
     "content_html": "divisions and competition among different groups of Native Americans"
    },
    {
     "id": 1166548,
     "content_html": "the technological superiority of European weapons"
    },
    {
     "id": 1166547,
     "content_html": "the American Indians’ lack of immunity to European diseases such as smallpox"
    }
   ],
