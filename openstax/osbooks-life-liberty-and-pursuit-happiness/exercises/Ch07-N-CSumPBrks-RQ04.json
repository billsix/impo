   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the aftermath of the Sumner-Brooks incident, it became apparent that ",
   "answers": [
    {
     "id": 1170016,
     "content_html": "Henry Clay’s efforts to seek a political solution to slavery would work\n"
    },
    {
     "id": 1170015,
     "content_html": "Congressional representatives from west of the Mississippi River would earn the 1860 presidential nominations\n"
    },
    {
     "id": 1170014,
     "content_html": "opposition to the Fugitive Slave Act was diminishing\n"
    },
    {
     "id": 1170017,
     "content_html": "political compromise between the North and the South was unlikely\n"
    }
   ],
