 "questions": [
  {
   "id": 615660,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to the majority opinion in the <i>Plessy v. Ferguson</i> decision,",
   "answers": [
    {
     "id": 1170609,
     "content_html": "the Fourteenth Amendment could not have been intended to abolish distinctions based on color"
    },
    {
     "id": 1170608,
     "content_html": "the Fourteenth Amendment explicitly granted political and social equality"
    },
    {
     "id": 1170607,
     "content_html": "states were given the right to interpret the Amendment"
    },
    {
     "id": 1170606,
     "content_html": "no citizen has universal civil freedom"
    }
   ],
