   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An event that propelled William Tweed to a position of respect and more power in New York City was his",
   "answers": [
    {
     "id": 1170432,
     "content_html": "first successful election as mayor of New York in 1864"
    },
    {
     "id": 1170433,
     "content_html": "success in restoring order after the draft riots in 1863"
    },
    {
     "id": 1170431,
     "content_html": "ability to authorize public works to benefit large numbers of immigrants"
    },
    {
     "id": 1170430,
     "content_html": "success at providing comfortable housing for lower-income families"
    }
