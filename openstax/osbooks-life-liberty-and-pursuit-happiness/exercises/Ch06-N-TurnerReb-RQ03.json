   "stimulus_html": "",
   "stem_html": "When Nat Turner’s slave rebellion began in August 1831, the rebels killed",
   "answers": [
    {
     "id": 1169313,
     "content_html": "men, women, children, and infants"
    },
    {
     "id": 1169312,
     "content_html": "only exceptionally harsh overseers and plantation owners"
    },
    {
     "id": 1169311,
     "content_html": "enslaved persons who did not join the revolt"
    },
    {
     "id": 1169310,
     "content_html": "enslaved persons who threatened to inform plantation owners about the identity of the rebels"
    }
   ],
