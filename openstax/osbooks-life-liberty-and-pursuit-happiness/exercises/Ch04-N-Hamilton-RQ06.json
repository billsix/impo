   "id": 615052,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In regards to the national bank, James Madison feared",
   "answers": [
    {
     "id": 1168180,
     "content_html": "the precedent established by its creation could give too much authority to the Executive Branch"
    },
    {
     "id": 1168179,
     "content_html": "the necessary and proper clause could give Congress the authority to violate individual civil liberties"
    },
    {
     "id": 1168181,
     "content_html": "the Legislative Branch might overextend its constitutional authority"
    },
    {
     "id": 1168178,
     "content_html": "the government could create more corporations on a whim"
    }
   ],
