 "questions": [
  {
   "id": 615724,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At first, the Radical Republicans believed President Andrew Johnson could be a strong ally. However, Johnson’s attitude toward the South was",
   "answers": [
    {
     "id": 1170865,
     "content_html": "more lenient than Abraham Lincoln’s and provided almost no protections for the freed people"
    },
    {
     "id": 1170864,
     "content_html": "more lenient than Abraham Lincoln’s, although Johnson provided for protection of the freed people"
    },
    {
     "id": 1170863,
     "content_html": "just as lenient as Abraham Lincoln’s but required the ratification of the Fourteenth Amendment"
    },
    {
     "id": 1170862,
     "content_html": "just as lenient as Abraham Lincoln’s but required the ratification of the Fifteenth Amendment"
    }
   ],
