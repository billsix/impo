 "questions": [
  {
   "id": 615465,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What impact did the passage of the Fugitive Slave Act have on escaped enslaved persons and free blacks in the North? ",
   "answers": [
    {
     "id": 1169832,
     "content_html": "More escaped enslaved persons and free blacks sought legal protection in northern state courts.\n"
    },
    {
     "id": 1169831,
     "content_html": "Only free blacks who assisted runaway slaves could be prosecuted under the provisions of the new law.\n"
    },
    {
     "id": 1169833,
     "content_html": "The law denied free blacks and escaped slaves the opportunity for a jury trial and the right to testify in their own defense.\n"
    },
    {
     "id": 1169830,
     "content_html": "Little changed for free blacks or escaped slaves, because reaching the northern states guaranteed freedom.\n"
    }
   ],
