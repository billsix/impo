 "stimulus_html": "<figure>\n<img src=\"exercises/media/3404b0674a554439.png\" alt=\"A map of Virginia drawn by John Smith shows trees, rivers, and the Chesapeake Bay.\">\n<figcaption>John Smith’s 1624 map of Virginia.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 614762,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a plausible inference a historian could make about European exploration in the early seventeenth century, based on the information in the map provided?",
   "answers": [
    {
     "id": 1167022,
     "content_html": "Waterways were extremely important to early settlements."
    },
    {
     "id": 1167021,
     "content_html": "American Indians often violently clashed with early European settlers."
    },
    {
     "id": 1167020,
     "content_html": "The support of monarchs or joint-stock companies was vital to the success of early settlements."
    },
    {
     "id": 1167019,
     "content_html": "Cash crops were essential to the success of early settlements."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614763,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the major reason the English wanted to establish a colony in the region depicted in the map provided during the sixteenth century?",
   "answers": [
    {
     "id": 1167026,
     "content_html": "They saw the region as a strategic location from which to strike at Spanish treasure ships."
    },
    {
     "id": 1167025,
     "content_html": "They were lured by rumors of a southwest passage."
    },
    {
     "id": 1167024,
     "content_html": "They wanted to convert American Indians to Catholicism."
    },
    {
     "id": 1167023,
     "content_html": "They were granted a charter from the pope to claim all land on the eastern seaboard."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
