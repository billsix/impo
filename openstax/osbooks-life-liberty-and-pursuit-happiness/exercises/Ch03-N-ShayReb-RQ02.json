 "questions": [
  {
   "id": 614880,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the result of Shays’ Rebellion?",
   "answers": [
    {
     "id": 1167492,
     "content_html": "Debts of the farmers were forgiven because merchants and governors realized the state economy would ultimately benefit from farmers’ success."
    },
    {
     "id": 1167493,
     "content_html": "Many farmers returned home to their farms, although some fled across state lines."
    },
    {
     "id": 1167491,
     "content_html": "The rebel farmers were tried and persecuted for their treasonous crimes in the very courthouses they had marched upon."
    },
    {
     "id": 1167490,
     "content_html": "The Massachusetts government, realizing the need for a strong central government, invited the other states to a convention to revise the Articles of Confederation."
    }
   ],
