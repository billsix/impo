    {
     "id": 1172884,
     "content_html": "Violations of civil liberties on the home front"
    },
    {
     "id": 1172882,
     "content_html": "A recommitment to the neutrality legislation of the 1930s"
    },
    {
     "id": 1172881,
     "content_html": "Abandonment of the restrictive immigration policies of the late 1920s"
    }
   ],
