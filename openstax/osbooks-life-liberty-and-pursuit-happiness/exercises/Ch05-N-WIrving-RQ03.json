   "stem_html": "Washington Irving’s “The Legend of Sleepy Hollow” and “Rip Van Winkle”",
   "answers": [
    {
     "id": 1168932,
     "content_html": "offered a nostalgic look at the Puritan experience"
    },
    {
     "id": 1168931,
     "content_html": "rejected the republican values of the Revolutionary Era"
    },
    {
     "id": 1168933,
     "content_html": "suggested that the new economic values led to tensions in society"
    },
    {
     "id": 1168930,
     "content_html": "set classical mythological tales in American settings"
    }
