 "is_vocab": false,
 "stimulus_html": "<figure>\n<img id=\"Figure6_19\" src=\"exercises/media/e850f61113e63d53.png\" alt=\"Painting of the western United States showing a red line connecting Salt Lake City to Nauvoo, Illinois.\">\n<figcaption>The Mormon Trail during the migration of the late 1840s. (credit: work by National Park Service)</figcaption>\n</figure>\n<p><i>Refer to the map provided.</i></p>",
 "questions": [
  {
   "id": 615312,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was the main reason for the event depicted in the map?",
   "answers": [
    {
     "id": 1169218,
     "content_html": "The Mormons were being directed by Joseph Smith to their “promised land.”"
    },
    {
     "id": 1169221,
     "content_html": "The Mormons were escaping persecution in the various communities where they had previously settled."
    },
    {
     "id": 1169219,
     "content_html": "The federal government had promised the Mormons complete religious freedom in the West."
    },
    {
     "id": 1169220,
     "content_html": "The Mormon Trail was a well-established westward route."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615313,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a result of the event depicted on the map, the Mormons established",
   "answers": [
    {
     "id": 1169225,
     "content_html": "a well-planned, prosperous community of economic diversity"
    },
    {
     "id": 1169222,
     "content_html": "a colony where only Mormons were allowed to settle"
    },
    {
     "id": 1169223,
     "content_html": "a community that ultimately failed and served as a warning to others seeking to move into the harsh western territories"
    },
    {
     "id": 1169224,
     "content_html": "an innovative method of farming that did not depend on irrigation"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
