 "questions": [
  {
   "id": 615727,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After the election of 1866, the only political influence President Andrew Johnson had was",
   "answers": [
    {
     "id": 1170876,
     "content_html": "the ability to impeach senators"
    },
    {
     "id": 1170875,
     "content_html": "the ability to use the Supreme Court to ratify his decisions regarding Reconstruction"
    },
    {
     "id": 1170877,
     "content_html": "the veto, although many of his vetoes were overridden by Congress"
    },
    {
     "id": 1170874,
     "content_html": "the veto, which he used successfully"
    }
   ],
