   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The 1912 United States presidential election was significant because",
   "answers": [
    {
     "id": 1171800,
     "content_html": "all four presidential candidates rejected Progressive reforms to improve the economy"
    },
    {
     "id": 1171801,
     "content_html": "Theodore Roosevelt’s candidacy weakened traditional political party power"
    },
    {
     "id": 1171799,
     "content_html": "Eugene V. Debs’s candidacy split the Democratic Party"
    },
    {
     "id": 1171798,
     "content_html": "it brought an end to Progressive Era reforms at the national level"
    }
   ],
