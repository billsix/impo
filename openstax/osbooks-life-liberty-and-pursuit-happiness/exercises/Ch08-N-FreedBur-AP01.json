 "stimulus_html": "<figure id=\"BRI_APUSH_08_03_Franchise\">\n<img src=\"exercises/media/e5ed69ed9334cd19.png\" alt=\"The left figure, Pardon, shows Columbia sitting in a judge’s chair, surrounded by kneeling men. They clasp their hands and lay down their swords and flags. The caption reads “Shall I trust these men . . . ” The right figure, Franchise, shows Columbia standing next to an African American man who has lost a leg. She gestures to him, and the caption finishes, “ . . . And not this man?”\">\n<figcaption>“Pardon and Franchise” by Thomas Nast, 1865. (Left) Former Confederates begging for pardons and the right to vote. (Right) An African American soldier who fought for the Union during the Civil War. The character of Columbia asks, “<i>Shall I trust these men</i>. . . <i>and not this man?</i>”</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 615848,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The artist who produced this political cartoon is most clearly arguing for",
   "answers": [
    {
     "id": 1171358,
     "content_html": "citizenship for immigrants"
    },
    {
     "id": 1171359,
     "content_html": "citizenship for former Confederate leaders"
    },
    {
     "id": 1171361,
     "content_html": "the right of African American men to vote"
    },
    {
     "id": 1171360,
     "content_html": "equal rights but segregation of the races"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615849,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The creation of the cartoon was most likely a response to",
   "answers": [
    {
     "id": 1171362,
     "content_html": "the passage of the Thirteenth and Fourteenth Amendments to the Constitution"
    },
    {
     "id": 1171365,
     "content_html": "the passage of the first Black Codes in the post–Civil War South"
    },
    {
     "id": 1171363,
     "content_html": "the creation of the Freedman’s Bureau"
    },
    {
     "id": 1171364,
     "content_html": "the development of public schools in the South"
    }
   ],
   "hints": [],
   "formats": [
