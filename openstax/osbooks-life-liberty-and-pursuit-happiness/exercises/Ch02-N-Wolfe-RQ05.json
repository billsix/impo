 "questions": [
  {
   "id": 614745,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The end of the Seven Years’ War changed the dynamic in North America in all the following ways except",
   "answers": [
    {
     "id": 1166954,
     "content_html": "the French presence in the Great Lakes region continued to complicate British policy toward American Indians in the Ohio River Valley"
    },
    {
     "id": 1166953,
     "content_html": "the war resulted in continued conflict with American Indians as settlers moved west despite the Proclamation of 1763"
    },
    {
     "id": 1166952,
     "content_html": "the war created tension between the British government and North American colonists stemming from disregard of colonial contributions to the war and economic measures enacted by Parliament to pay for the war"
    },
    {
     "id": 1166951,
     "content_html": "the war established British domination of North America east of the Mississippi River"
    }
   ],
