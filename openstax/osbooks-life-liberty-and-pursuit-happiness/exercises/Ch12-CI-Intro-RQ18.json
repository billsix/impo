 "questions": [
  {
   "id": 616146,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best applies to working women during World War II?",
   "answers": [
    {
     "id": 1172552,
     "content_html": "Women had very few types of jobs from which to choose."
    },
    {
     "id": 1172553,
     "content_html": "Most women remained on the job after the war and rose to supervisory positions."
    },
    {
     "id": 1172551,
     "content_html": "Government publicity programs were created to dissuade married women from working."
    },
    {
     "id": 1172550,
     "content_html": "Women helped avert the labor shortage during the war, but later, many voluntarily left their jobs or were forced out of those jobs."
    }
   ],
