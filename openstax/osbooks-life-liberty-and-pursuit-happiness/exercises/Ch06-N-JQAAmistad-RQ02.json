 "questions": [
  {
   "id": 615369,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At first, the U.S. government’s official position in regard to <i>The Amistad</i> was that",
   "answers": [
    {
     "id": 1169448,
     "content_html": "the United States had a right to keep the ship and its cargo and would use the ship in normal commerce"
    },
    {
     "id": 1169447,
     "content_html": "the United States had a right to ownership of the cargo on the ship, and the captives would be sent to the Deep South"
    },
    {
     "id": 1169449,
     "content_html": "the United States agreed with the Spanish government and intended to return the ship to Spain"
    },
    {
     "id": 1169446,
     "content_html": "the United States agreed to let the ship and the captives go to Cuba"
    }
   ],
