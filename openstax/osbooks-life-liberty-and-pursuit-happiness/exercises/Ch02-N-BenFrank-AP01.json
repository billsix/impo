 "stimulus_html": "<figure>\n<img src=\"exercises/media/50f5f6239501a71d.png\" alt=\"A painting of  Benjamin Franklin holding a key in the air on a string to attract electricity from the sky is shown.\">\n<figcaption><i>Benjamin Franklin Drawing Electricity from the Sky</i> by Benjamin West (c. 1816).</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 614791,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A historian might use the image of Benjamin Franklin to support which of the following statements?",
   "answers": [
    {
     "id": 1167137,
     "content_html": "Franklin was interested in proving traditional religious beliefs through scientific experimentation."
    },
    {
     "id": 1167136,
     "content_html": "Franklin believed in a democratic form of government."
    },
    {
     "id": 1167138,
     "content_html": "Enlightenment thinking such as Franklin’s was based on science and reason."
    },
    {
     "id": 1167135,
     "content_html": "Franklin advocated civic virtue and political activism."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614792,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following could a historian use to support Franklin’s reputation as a thinker of the Enlightenment?",
   "answers": [
    {
     "id": 1167141,
     "content_html": "Franklin’s devotion to the Calvinist faith"
    },
    {
     "id": 1167140,
     "content_html": "Franklin’s publication of <i>Poor Richard’s Almanac</i>"
    },
    {
     "id": 1167139,
     "content_html": "Franklin’s apprenticeship to his brother"
    },
    {
     "id": 1167142,
     "content_html": "Franklin’s role in the founding of the Academy of Pennsylvania"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614793,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Enlightenment had the most significant impact on",
   "answers": [
    {
     "id": 1167145,
     "content_html": "the Great Awakening"
    },
    {
     "id": 1167144,
     "content_html": "Bacon’s Rebellion"
    },
    {
     "id": 1167146,
     "content_html": "the ideals behind the American Revolution"
    },
    {
     "id": 1167143,
     "content_html": "the demands of the Stamp Act Congress"
    }
   ],
