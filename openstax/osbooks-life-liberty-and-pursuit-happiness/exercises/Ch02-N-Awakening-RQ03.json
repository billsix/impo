 "questions": [
  {
   "id": 614717,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of these was not a way in which the ministry of the Great Awakening challenged social conventions?",
   "answers": [
    {
     "id": 1166841,
     "content_html": "Following their conviction that all believers were equal before God, some evangelicals allowed women to “exhort,” or preach informally during meetings."
    },
    {
     "id": 1166840,
     "content_html": "White evangelicals ordained converted African Americans and American Indians to preach or be missionaries"
    },
    {
     "id": 1166839,
     "content_html": "Some evangelicals began to argue that, in light of the Gospel’s implications, enslaving people was sinful."
    },
    {
     "id": 1166842,
     "content_html": "Sometimes children were allowed to preach from the pulpit."
    }
   ],
