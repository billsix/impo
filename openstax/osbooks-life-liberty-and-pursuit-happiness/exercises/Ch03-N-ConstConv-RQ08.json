 "questions": [
  {
   "id": 614892,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements best describes the new Constitution?",
   "answers": [
    {
     "id": 1167541,
     "content_html": "A bundle of compromises between geographic and demographic factions that outlined the new government"
    },
    {
     "id": 1167540,
     "content_html": "A direct reaction to monarchical rule allowing a weak executive branch with little power to levy taxes"
    },
    {
     "id": 1167539,
     "content_html": "An outline of grievances against the king that articulated a new form of government for the young nation"
    },
    {
     "id": 1167538,
     "content_html": "A specific formulation of how each branch of the government would interact with the others"
    }
   ],
