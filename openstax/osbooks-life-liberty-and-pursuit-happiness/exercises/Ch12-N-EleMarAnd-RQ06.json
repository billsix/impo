 "questions": [
  {
   "id": 616207,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Before the New Deal, African American voters tended to vote for the Republican Party primarily because",
   "answers": [
    {
     "id": 1172795,
     "content_html": "they were allowed to register only with the Republican Party in the South"
    },
    {
     "id": 1172794,
     "content_html": "the Republicans supported extending New Deal programs across the rural South"
    },
    {
     "id": 1172796,
     "content_html": "it was the Republican President Abraham Lincoln who issued the Emancipation Proclamation"
    },
    {
     "id": 1172793,
     "content_html": "the Republican Party was responsible for ending military Reconstruction"
    }
   ],
