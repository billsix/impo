 "questions": [
  {
   "id": 614741,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What issues resulting from the French and Indian War contributed to changes in British colonial policy after the war?",
   "answers": [
    {
     "id": 1166937,
     "content_html": "The cost of conducting the war was paid primarily by the colonial legislatures, encouraging the British to increasingly treat the colonies as equal trading partners."
    },
    {
     "id": 1166938,
     "content_html": "Policies intended to increase tax and customs revenue from the colonies were implemented by the British government."
    },
    {
     "id": 1166936,
     "content_html": "Respect for colonial militias increased throughout the British military and was reflected in promotion of militia officers"
    },
    {
     "id": 1166935,
     "content_html": "With the French presence in North America eliminated, British policy endorsed unrestricted settlement of territory west of the Appalachian Mountains."
    }
   ],
