   "id": 615082,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A significant benefit for the United States that resulted from the ratification of the Jay Treaty was",
   "answers": [
    {
     "id": 1168300,
     "content_html": "the end of the seizure of U.S. ships by the French navy"
    },
    {
     "id": 1168299,
     "content_html": "the opening of territory for settlement west of the Appalachian Mountains"
    },
    {
     "id": 1168301,
     "content_html": "a new treaty with Spain giving the United States free access to the port of New Orleans"
    },
    {
     "id": 1168298,
     "content_html": "U.S. access to territory west of the Mississippi River"
    }
