 "questions": [
  {
   "id": 615913,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best compares northern and southern views of literacy requirements for voting?",
   "answers": [
    {
     "id": 1171620,
     "content_html": "Northern whites generally viewed literacy tests as a challenge to the 15th Amendment."
    },
    {
     "id": 1171619,
     "content_html": "Southern whites saw literacy requirements as a challenge to progressive reforms."
    },
    {
     "id": 1171618,
     "content_html": "Southern whites used literacy requirements as justification to keep immigrants from voting."
    },
    {
     "id": 1171621,
     "content_html": "Many Northern whites were sympathetic to the underlying assumptions of race at the basis of literacy requirements."
    }
   ],
