 "questions": [
  {
   "id": 615150,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best describes Thomas Jefferson’s first term as president?",
   "answers": [
    {
     "id": 1168572,
     "content_html": "He betrayed his campaign principles, alienating his supporters after having won a clear and convincing victory in the electoral vote."
    },
    {
     "id": 1168573,
     "content_html": "He maintained his core principles and pragmatically adapted to the circumstances he faced in office."
    },
    {
     "id": 1168571,
     "content_html": "He rewarded Federalists with prime positions in his new administration."
    },
    {
     "id": 1168570,
     "content_html": "His actions did little to change the country from the one that emerged during the Washington and Adams administrations."
    }
   ],
