   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One of James Madison’s constitutional principles was rejected. This principle would have given",
   "answers": [
    {
     "id": 1168193,
     "content_html": "the Federal government a veto over state legislation"
    },
    {
     "id": 1168192,
     "content_html": "the Executive Branch more authority than the other two branches of government"
    },
    {
     "id": 1168191,
     "content_html": "more authority to the governor of each state"
    },
    {
     "id": 1168190,
     "content_html": "explicit rights to the people"
    }
