 "questions": [
  {
   "id": 614826,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the effects of the Royal Proclamation of 1763?",
   "answers": [
    {
     "id": 1167275,
     "content_html": "It forbade colonists from settling too far from British control along the frontier."
    },
    {
     "id": 1167278,
     "content_html": "It reserved a portion of the British colonial landholdings for American Indians, to prevent future conflict."
    },
    {
     "id": 1167276,
     "content_html": "It set in motion the colonial desire to eradicate all American Indians from British lands."
    },
    {
     "id": 1167277,
     "content_html": "It served as a peace treaty between France and Britain, ultimately ending the French and Indian War."
    }
   ],
