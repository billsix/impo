   "stimulus_html": "",
   "stem_html": "President Franklin D. Roosevelt authorized the Manhattan Project because he",
   "answers": [
    {
     "id": 1173027,
     "content_html": "wanted to prepare for the post-World War II struggle against the Soviet Union"
    },
    {
     "id": 1173028,
     "content_html": "feared that Nazi Germany would develop an atomic weapon"
    },
    {
     "id": 1173026,
     "content_html": "intended to use atomic weapons against Japan"
    },
    {
     "id": 1173025,
     "content_html": "sought a last line of defense in case the United States homeland was invaded"
    }
   ],
