  {
   "id": 614941,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following ideas would be best supported by historians using the excerpt provided as evidence?",
   "answers": [
    {
     "id": 1167736,
     "content_html": "That children wrote unbiased accounts during wartime"
    },
    {
     "id": 1167737,
     "content_html": "That women and families supported the troops during the Revolution"
    },
    {
     "id": 1167735,
     "content_html": "That new and advanced technology allowed for more accurate gunfire"
    },
    {
     "id": 1167734,
     "content_html": "That most New England families felt loyalty and support for the British Crown"
    }
