  },
  {
   "id": 614940,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The context surrounding the event in the excerpt provided may best be described as",
   "answers": [
    {
     "id": 1167732,
     "content_html": "intercolonial unity in the face of British attack"
    },
    {
     "id": 1167731,
     "content_html": "strategically planned offensive in the wake of British hostilities"
    },
    {
     "id": 1167733,
     "content_html": "incremental buildup of tension throughout Massachusetts over British occupation and legislation"
    },
    {
     "id": 1167730,
     "content_html": "defiance of the Proclamation Line of 1763 and the subsequent conflict over land between American Indians, British, and colonists"
    }
   ],
