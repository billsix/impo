 "questions": [
  {
   "id": 614600,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the context for the political situation in the Aztec capital prior to Cortés’s arrival?",
   "answers": [
    {
     "id": 1166373,
     "content_html": "Tenochtitlan was experiencing a Golden Age.\n"
    },
    {
     "id": 1166372,
     "content_html": "Tenochtitlan was recovering from a recent defeat by the Aztecs’ rivals, the Tlaxcalans.\n"
    },
    {
     "id": 1166374,
     "content_html": "Tenochtitlan was held together by political and military might, and tensions simmered below the surface.\n"
    },
    {
     "id": 1166371,
     "content_html": "Tenochtitlan’s elite had begun the process of converting to Christianity thanks to missionaries who preceded Cortés’s men.\n"
    }
   ],
