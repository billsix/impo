 "questions": [
  {
   "id": 615416,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  was a result of passage of the Kansas-Nebraska Act?",
   "answers": [
    {
     "id": 1169636,
     "content_html": "Diminished national support for the abolitionist movement"
    },
    {
     "id": 1169635,
     "content_html": "Legal challenges that led the Act to be declared unconstitutional by the Supreme Court"
    },
    {
     "id": 1169634,
     "content_html": "Reduction of the threat Southern slaveholders perceived from northern interests"
    },
    {
     "id": 1169637,
     "content_html": "Partisan realignment in the North and the creation of the Republican Party"
    }
   ],
