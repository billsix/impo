   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Events in the decades after the Watts Riots (1965) and the Rodney King incident (1991) best illustrate",
   "answers": [
    {
     "id": 1175227,
     "content_html": "a significant lessening of racial tensions in the United States, especially in urban areas"
    },
    {
     "id": 1175226,
     "content_html": "the success of minority policing in urban areas"
    },
    {
     "id": 1175225,
     "content_html": "the widespread implementation of policing reforms"
    },
    {
     "id": 1175228,
     "content_html": "the difficulty of reducing tensions between police departments and African Americans in many communities"
    }
