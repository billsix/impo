     "id": 1170852,
     "content_html": "Union victory at Chickamauga Creek"
    },
    {
     "id": 1170853,
     "content_html": "appointment of Ulysses S. Grant as commander of the Union Armies"
    },
    {
     "id": 1170851,
     "content_html": "burning of Atlanta by troops under Jefferson Davis"
    },
    {
     "id": 1170850,
     "content_html": "Union capture of Fort Wagner and Fort Hudson"
    }
