 "is_vocab": false,
 "stimulus_html": "<figure>\n<img src=\"exercises/media/58c3f8e3e6c82aec.png\" alt=\"A political cartoon of a cut-up snake is shown. Each part is labeled with a letter representing the colonies.\">\n<figcaption>Benjamin Franklin published his famous “Join, or Die” cartoon in the <i>Pennsylvania Gazette</i> in 1754.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 614794,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The political cartoon published by Benjamin Franklin suggests",
   "answers": [
    {
     "id": 1167149,
     "content_html": "colonial governments must focus on their own self-interest"
    },
    {
     "id": 1167148,
     "content_html": "British colonies must work in cooperation with the British government"
    },
    {
     "id": 1167147,
     "content_html": "separatist movements dissenting against the Church of England were dangerous to the success of the colonies"
    },
    {
     "id": 1167150,
     "content_html": "colonial governments needed to form a confederation to successfully protect their interests against threats by the French and by American Indians"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614795,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In his cartoon, Benjamin Franklin combined the New England colonies into one group and listed the other colonies individually. What does this say about the New England colonies?",
   "answers": [
    {
     "id": 1167153,
     "content_html": "The individual New England colonies were viewed as illegitimate by the other colonies."
    },
    {
     "id": 1167154,
     "content_html": "The New England colonies had a practice of cooperating on issues that were shared concerns."
    },
    {
     "id": 1167152,
     "content_html": "The southern colonies were expressing their desire to join the New England confederacy."
    },
    {
     "id": 1167151,
     "content_html": "The British government had already established a confederation in some of its colonies but not others."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614796,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Benjamin Franklin created the image in response to",
   "answers": [
    {
     "id": 1167157,
     "content_html": "British concerns that the colonies were not providing a unified front against French opposition"
    },
    {
     "id": 1167156,
     "content_html": "advocates for the independence of each colony"
    },
    {
     "id": 1167158,
     "content_html": "concerns that the colonies were facing threats of attack by the French and by American Indians"
    },
    {
     "id": 1167155,
     "content_html": "support for strengthening the alliance between the British colonies and the Iroquois Confederation"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
