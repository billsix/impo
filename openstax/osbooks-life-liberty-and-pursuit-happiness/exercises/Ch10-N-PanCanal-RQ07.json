   "id": 615920,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did disease affect the building of the Panama Canal?",
   "answers": [
    {
     "id": 1171648,
     "content_html": "It killed many workers but had minimal impact on completion of the project."
    },
    {
     "id": 1171647,
     "content_html": "It delayed completion of the American canal project for several decades."
    },
    {
     "id": 1171649,
     "content_html": "It stopped the French canal project, shifting final construction efforts to the U.S. government."
    },
    {
     "id": 1171646,
     "content_html": "It forced the builders to import former Caribbean slaves who had immunities."
    }
   ],
