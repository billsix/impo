 "questions": [
  {
   "id": 615280,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the main idea of John C. Calhoun’s <i>Exposition and Protest</i>, published in 1828?",
   "answers": [
    {
     "id": 1169093,
     "content_html": "That states had the right to declare a federal law unconstitutional"
    },
    {
     "id": 1169092,
     "content_html": "That the South was against the policies of President John Quincy Adams"
    },
    {
     "id": 1169091,
     "content_html": "That South Carolina wanted to create its own tariff policy"
    },
    {
     "id": 1169090,
     "content_html": "That States’ rights were subordinate to Federal policy"
    }
   ],
