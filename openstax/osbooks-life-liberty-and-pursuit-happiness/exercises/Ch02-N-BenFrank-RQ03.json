 "questions": [
  {
   "id": 614725,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How was Franklin’s Academy of Pennsylvania unique among the early colonial universities, such as Harvard and Yale?",
   "answers": [
    {
     "id": 1166873,
     "content_html": "It was founded on Puritan principles."
    },
    {
     "id": 1166872,
     "content_html": "It was the first university founded in the American colonies."
    },
    {
     "id": 1166871,
     "content_html": "It was chartered by the British crown."
    },
    {
     "id": 1166874,
     "content_html": "It focused on business and public service instead of religious training."
    }
   ],
