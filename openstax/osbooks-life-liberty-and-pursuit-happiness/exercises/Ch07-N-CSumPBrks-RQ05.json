 "questions": [
  {
   "id": 615512,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement is most accurate regarding the Sumner-Brooks incident?",
   "answers": [
    {
     "id": 1170021,
     "content_html": "Both men were considered heroes in their respective regions, further increasing sectional tensions.\n"
    },
    {
     "id": 1170020,
     "content_html": "Charles Sumner retired from office and later became a supporter of lenient treatment of the South during Reconstruction.\n"
    },
    {
     "id": 1170019,
     "content_html": "The Supreme Court censured Preston Brooks and removed him from Congress.\n"
    },
    {
     "id": 1170018,
     "content_html": "Preston Brooks was jailed for assault, but his apology served to lessen sectional discord.\n"
    }
   ],
