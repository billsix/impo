 "questions": [
  {
   "id": 614616,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did rival European nations attempt to undermine the dominance of Spain in early American settlements?",
   "answers": [
    {
     "id": 1166437,
     "content_html": "The English, Dutch, and French formed an alliance to fight Spain for its American colonies.\n"
    },
    {
     "id": 1166436,
     "content_html": "Spain’s rivals formed alliances with the American Indians to overthrow Spanish dominance.\n"
    },
    {
     "id": 1166435,
     "content_html": "Spain’s rivals used diplomacy to get Spain to allow them to form their own colonies.\n"
    },
    {
     "id": 1166438,
     "content_html": "Spain’s rivals legalized piracy to seize Spanish goods and created the “black legend” to highlight Spain’s cruelty to the American Indians.\n"
    }
   ],
