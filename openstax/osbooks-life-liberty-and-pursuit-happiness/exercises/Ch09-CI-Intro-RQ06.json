   "stimulus_html": "",
   "stem_html": "Vertical integration in business is best described as",
   "answers": [
    {
     "id": 1170285,
     "content_html": "control of all aspects of an industry from origin to distribution in the marketplace"
    },
    {
     "id": 1170284,
     "content_html": "control of the marketplace for a particular industry"
    },
    {
     "id": 1170283,
     "content_html": "a monopoly on taking raw materials and producing them into textiles"
    },
    {
     "id": 1170282,
     "content_html": "the ability to combine diverse industries into one major corporation"
    }
