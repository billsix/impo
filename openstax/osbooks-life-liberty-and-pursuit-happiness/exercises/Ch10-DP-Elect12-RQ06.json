 "questions": [
  {
   "id": 615963,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements best summarizes the outcome of the 1912 presidential election?",
   "answers": [
    {
     "id": 1171820,
     "content_html": "The Democratic Party platform won the Electoral College but not the popular vote."
    },
    {
     "id": 1171819,
     "content_html": "Third-party candidates played an insignificant role in choosing the victor."
    },
    {
     "id": 1171818,
     "content_html": "Similarities in the Democratic and Socialist party platforms split the popular vote between their candidates."
    },
    {
     "id": 1171821,
     "content_html": "A split in the Republican Party contributed to the Democratic Party victory."
    }
   ],
