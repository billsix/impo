 "questions": [
  {
   "id": 615268,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Missouri’s admission to the Union led to a crisis because",
   "answers": [
    {
     "id": 1169044,
     "content_html": "Missouri was the first state since the American Revolution to request entry to the Union"
    },
    {
     "id": 1169043,
     "content_html": "the U.S. Constitution had not provided a method for new states to enter the Union"
    },
    {
     "id": 1169042,
     "content_html": "Missouri’s location might enable the creation of new slave states in the Northwest Territory"
    },
    {
     "id": 1169045,
     "content_html": "Missouri’s entry threatened to further tip political power toward southern interests"
    }
   ],
