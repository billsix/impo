 "questions": [
  {
   "id": 614594,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the Dutch establish a settlement at New Amsterdam?",
   "answers": [
    {
     "id": 1166350,
     "content_html": "To guard the entrance to the Hudson River and the fur trade\n"
    },
    {
     "id": 1166349,
     "content_html": "As an outpost for religious freedom\n"
    },
    {
     "id": 1166348,
     "content_html": "To convert native groups to Christianity\n"
    },
    {
     "id": 1166347,
     "content_html": "To guard against pirate raids by rival European powers\n"
    }
   ],
