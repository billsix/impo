 "stimulus_html": "<figure>\n<img src=\"exercises/media/cc31da86e8a991d0.png\" alt=\"A painting of settlers with Indians, peacefully talking in a village.\">\n<figcaption>\nPenn’s Treaty with the Indians when he founded the colony of Pennsylvania in North America, painted in 1771 by Benjamin West.\n</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 614777,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following could a historian use to describe William Penn’s inspiration for the action in the scene depicted?",
   "answers": [
    {
     "id": 1167082,
     "content_html": "Penn’s Quaker beliefs in equality and fair treatment"
    },
    {
     "id": 1167081,
     "content_html": "The future economic success of Penn’s colony"
    },
    {
     "id": 1167080,
     "content_html": "The perceived racial superiority of Europeans that existed in Penn’s colony"
    },
    {
     "id": 1167079,
     "content_html": "The desire to convert American Indians to the “one true God”"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614778,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The actions portrayed in the image provided challenge which prevailing norm of the seventeenth century?",
   "answers": [
    {
     "id": 1167085,
     "content_html": "Reliance on forced labor for agricultural work"
    },
    {
     "id": 1167086,
     "content_html": "Conquest of American Indians’ land with violence or economic pressure"
    },
    {
     "id": 1167084,
     "content_html": "Consistent cooperation between American Indians and European settlers"
    },
    {
     "id": 1167083,
     "content_html": "Equality among all European and American Indian groups"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
