 "questions": [
  {
   "id": 615917,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compared with the proposed Nicaraguan canal, the reason Panama emerged as the primary location for the canal was",
   "answers": [
    {
     "id": 1171636,
     "content_html": "its relatively easy terrain for canal building compared with that of other possible routes"
    },
    {
     "id": 1171635,
     "content_html": "lack of any volcanic activity or mountainous terrain"
    },
    {
     "id": 1171634,
     "content_html": "full support of the Colombian government for the Panamanian route"
    },
    {
     "id": 1171637,
     "content_html": "favorable treaty terms for the United States after Panama rebelled against Colombia"
    }
   ],
