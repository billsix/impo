 "questions": [
  {
   "id": 615039,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Charles Genêt present a foreign policy challenge to the young United States?",
   "answers": [
    {
     "id": 1168128,
     "content_html": "He exposed hidden disagreements between Federalists and Jeffersonian-Republicans."
    },
    {
     "id": 1168127,
     "content_html": "He openly ridiculed Congress’s authority to declare war."
    },
    {
     "id": 1168129,
     "content_html": "His actions repeatedly demonstrated his flouting of U.S. sovereignty."
    },
    {
     "id": 1168126,
     "content_html": "He discouraged the formation of clubs to support the French Revolution."
    }
   ],
