   "stimulus_html": "",
   "stem_html": "The Supreme Court’s rulings on the National Industrial Recovery Act (1935) and the Agricultural Adjustment Act (1936) led to",
   "answers": [
    {
     "id": 1172632,
     "content_html": "an electoral defeat for Franklin Roosevelt in 1936"
    },
    {
     "id": 1172633,
     "content_html": "a plan to reorganize the federal courts to be more sympathetic to the New Deal"
    },
    {
     "id": 1172631,
     "content_html": "impeachment proceedings against the chief justice of the Supreme Court"
    },
    {
     "id": 1172630,
     "content_html": "passage of an unprecedented number of New Deal laws by Congress"
    }
   ],
