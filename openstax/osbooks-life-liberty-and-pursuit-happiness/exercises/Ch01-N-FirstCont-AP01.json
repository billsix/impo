 "is_vocab": false,
 "stimulus_html": "<figure><img src=\"exercises/media/f4ebc928c6fddfae.png\" alt=\"A woodcut shows King Ferdinand of Spain as a crowned, robed ruler seated on a throne, surrounded by land and sea. He points across the Atlantic, where Columbus lands with three large ships. A large group of Indians is shown on the shore.\">\n<figcaption>This 1495 woodcut is from an Italian translation of the letter Columbus sent to the Spanish court after his first voyage.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 614551,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The depiction of the Native Americans in the top right of the woodcut reinforced European perceptions of Native Americans by showing that",
   "answers": [
    {
     "id": 1166177,
     "content_html": "Native American populations were complex societies on equal footing with European nations"
    },
    {
     "id": 1166176,
     "content_html": "Europeans expected fierce and successful resistance to their exploration efforts"
    },
    {
     "id": 1166178,
     "content_html": "Native populations were primitive societies that would be easily subjugated by the Spanish"
    },
    {
     "id": 1166175,
     "content_html": "the Americas were populated by diverse populations and cultures"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614552,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the most significant result of Columbus’s voyages to the Americas in the late fifteenth century?",
   "answers": [
    {
     "id": 1166181,
     "content_html": "Native Americans adopted Spanish military and agricultural technologies.\n"
    },
    {
     "id": 1166182,
     "content_html": "Native Americans’ patterns of economic and cultural exchange were fundamentally changed.\n"
    },
    {
     "id": 1166180,
     "content_html": "The planting of European crops drove American crops into extinction.\n"
    },
    {
     "id": 1166179,
     "content_html": "New World diseases spread to Eurasia and decimated the populations there.\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
