 "questions": [
  {
   "id": 615802,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Emancipation Proclamation did not free the slaves of the border states, because",
   "answers": [
    {
     "id": 1171176,
     "content_html": "those states had declared their neutrality in the Civil War"
    },
    {
     "id": 1171177,
     "content_html": "the Proclamation applied only to the states at war with the United States"
    },
    {
     "id": 1171175,
     "content_html": "Lincoln was not interested in the slaves of the border states"
    },
    {
     "id": 1171174,
     "content_html": "the border states threatened to sue in federal court"
    }
   ],
