   "id": 614751,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "William Bradford’s main role in the Plymouth community was",
   "answers": [
    {
     "id": 1166977,
     "content_html": "captain of the <i>Mayflower</i> who led the settlers on a safe journey across the Atlantic Ocean"
    },
    {
     "id": 1166976,
     "content_html": "negotiator between the Puritans and the American Indians"
    },
    {
     "id": 1166978,
     "content_html": "governor of the Plymouth Colony who chronicled the history of the community"
    },
    {
     "id": 1166975,
     "content_html": "leader of the “strangers” who was also a major investor in the Plymouth settlement"
    }
   ],
