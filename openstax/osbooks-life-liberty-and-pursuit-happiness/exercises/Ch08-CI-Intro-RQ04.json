   "id": 615716,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which event had the biggest impact on Great Britain’s decision to remain neutral in the American Civil War?",
   "answers": [
    {
     "id": 1170832,
     "content_html": "Several decisive Confederate victories in 1862 and 1863"
    },
    {
     "id": 1170831,
     "content_html": "The decision of France to remain neutral throughout the war"
    },
    {
     "id": 1170830,
     "content_html": "An increase in the output of its own factories"
    },
    {
     "id": 1170833,
     "content_html": "Lincoln’s decision to make abolition of slavery a major war goal"
    }
