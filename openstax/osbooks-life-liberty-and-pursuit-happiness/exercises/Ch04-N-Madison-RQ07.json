 "questions": [
  {
   "id": 615060,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was not a reason that the delegates at the Constitutional Convention omitted adding a bill of rights to the original document?",
   "answers": [
    {
     "id": 1168210,
     "content_html": "Many delegates believed a bill of rights would be unnecessary because all the states had their own."
    },
    {
     "id": 1168211,
     "content_html": "There was a strong belief that individual rights were implied in the document they had already created."
    },
    {
     "id": 1168212,
     "content_html": "A debate over adding a bill of rights would have prolonged the Convention and could have endangered the work they were about to complete."
    },
    {
     "id": 1168213,
     "content_html": "A bill of rights would have been next to impossible to enforce in a nation as large as the United States."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
