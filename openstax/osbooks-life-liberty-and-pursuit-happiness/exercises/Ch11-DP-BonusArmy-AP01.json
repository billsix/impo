 "is_vocab": false,
 "stimulus_html": "<figure id=\"BRI_APUSH_11_04_BonusArmy2\" class=\"scaled-down-70\">\n<img src=\"exercises/media/b1127d3741ddb069.png\" alt=\"A crowd of men lies on the lawn in front of the Capitol at night.\">\n<figcaption>Members of the Bonus Army laid siege to Capitol, spending the night on plaza lawns during the summer of 1932.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 616127,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The situation depicted in the photograph came about because",
   "answers": [
    {
     "id": 1172476,
     "content_html": "Congress was debating the Sedition Act"
    },
    {
     "id": 1172477,
     "content_html": "Congress was debating the passage of the Army Bonus Bill"
    },
    {
     "id": 1172475,
     "content_html": "the stock market plummeted on Black Thursday and many were left without a job"
    },
    {
     "id": 1172474,
     "content_html": "knowledge of the Teapot Dome Scandal leaked to the press"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616128,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The veterans in the photograph were unsuccessful in the short term. What was the longer-term result of their protest?",
   "answers": [
    {
     "id": 1172480,
     "content_html": "By peaceably exercising their First Amendment rights, the veterans inspired the president to have a change of heart and support their cause."
    },
    {
     "id": 1172479,
     "content_html": "The veterans later won a lawsuit against the brutal police chief who had ordered their camp burned and property destroyed."
    },
    {
     "id": 1172478,
     "content_html": "The veterans joined forces to campaign for the reelection of Herbert Hoover because of his law-and-order philosophy."
    },
    {
     "id": 1172481,
     "content_html": "The incident inspired legislation providing more adequately for future veterans who put their lives on hold to answer their country’s call to military duty."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
