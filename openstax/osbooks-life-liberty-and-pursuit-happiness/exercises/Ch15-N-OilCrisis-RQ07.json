 "questions": [
  {
   "id": 616894,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an accurate comparison of the 1973 and 1979 oil crises?",
   "answers": [
    {
     "id": 1174800,
     "content_html": "Both crises led to a renewed interest in examining renewable energy sources."
    },
    {
     "id": 1174799,
     "content_html": "The 1973 crisis resulted from cuts in domestic oil production, whereas the 1979 crisis was the result of the Yom Kippur War."
    },
    {
     "id": 1174798,
     "content_html": "The 1973 crisis was more severe than the crisis of 1979."
    },
    {
     "id": 1174797,
     "content_html": "Both crises led to reduced regulations to expand domestic oil production."
    }
   ],
