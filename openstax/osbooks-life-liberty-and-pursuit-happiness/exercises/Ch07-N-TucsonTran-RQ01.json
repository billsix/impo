 "questions": [
  {
   "id": 615425,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  of the following was true for Mexicans in the Southwest under the Treaty of Guadalupe Hidalgo?",
   "answers": [
    {
     "id": 1169672,
     "content_html": "They were forcibly relocated south to areas controlled by Mexico."
    },
    {
     "id": 1169671,
     "content_html": "They could petition the U.S. government for immediate statehood."
    },
    {
     "id": 1169673,
     "content_html": "They could keep their Mexican citizenship and become resident aliens in the United States."
    },
    {
     "id": 1169670,
     "content_html": "They could automatically become U.S. citizens after a 14-year residency.\n"
    }
   ],
