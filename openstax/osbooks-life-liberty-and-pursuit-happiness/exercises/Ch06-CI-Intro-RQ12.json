   "id": 615284,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Whig Party most likely won the election of 1840 because of",
   "answers": [
    {
     "id": 1169108,
     "content_html": "its wholesale support of the expansion of slavery west of the Mississippi River"
    },
    {
     "id": 1169109,
     "content_html": "the declining popularity of Martin Van Buren after the Panic of 1837"
    },
    {
     "id": 1169107,
     "content_html": "the Whigs’ philosophy that smaller government equals more effective government"
    },
    {
     "id": 1169106,
     "content_html": "the popularity of William Henry Harrison as an anti-Jacksonian"
    }
   ],
