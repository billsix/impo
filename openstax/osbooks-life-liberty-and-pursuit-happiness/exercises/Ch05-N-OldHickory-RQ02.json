 "questions": [
  {
   "id": 615188,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What actions did Andrew Jackson take to prepare for the Battle of New Orleans?",
   "answers": [
    {
     "id": 1168724,
     "content_html": "Sent the militia away and used only regular Army troops"
    },
    {
     "id": 1168725,
     "content_html": "Declared martial law, armed a free black regiment, and built ramparts"
    },
    {
     "id": 1168723,
     "content_html": "Burned the city of New Orleans to deny it to the British"
    },
    {
     "id": 1168722,
     "content_html": "Fought a major naval battle in the Gulf of Mexico to drive off the landing force"
    }
   ],
