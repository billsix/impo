 "questions": [
  {
   "id": 615392,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Andrew Jackson justified vetoing the bill to recharter the Bank of the United States for all the following reasons except",
   "answers": [
    {
     "id": 1169541,
     "content_html": "the Jacksonians believed the bank contributed to U.S. intervention in the War of 1812 and other wars"
    },
    {
     "id": 1169540,
     "content_html": "Jackson believed the bank was unconstitutional and that the Supreme Court had erred in <i>McCulloch v. Maryland</i>"
    },
    {
     "id": 1169539,
     "content_html": "the Jacksonians believed the bank acted as a monopoly and received exclusive privileges from Congress"
    },
    {
     "id": 1169538,
     "content_html": "foreigners controlled more than 20 percent of the bank’s stock"
    }
   ],
