   "stimulus_html": "",
   "stem_html": "William F. Buckley Jr. believed academic freedom on college campuses was",
   "answers": [
    {
     "id": 1173695,
     "content_html": "beneficial to students because it allowed them to explore different ideas"
    },
    {
     "id": 1173694,
     "content_html": "an interesting concept in theory but a failure in practice"
    },
    {
     "id": 1173696,
     "content_html": "a way for an unaccountable faculty to teach a radical point of view"
    },
    {
     "id": 1173693,
     "content_html": "free-thinkers’ way of indoctrinating their students"
    }
