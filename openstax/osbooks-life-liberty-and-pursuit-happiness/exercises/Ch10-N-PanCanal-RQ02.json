 "questions": [
  {
   "id": 615915,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "By the end of the nineteenth century, a canal through Central America was declared vital to U.S. national security because",
   "answers": [
    {
     "id": 1171629,
     "content_html": "the United States had emerged from the Spanish-American War with possessions in the Caribbean and the Pacific"
    },
    {
     "id": 1171628,
     "content_html": "European interest in an all-water route to China had increased and potential trade promised to enrich American businesses"
    },
    {
     "id": 1171627,
     "content_html": "the United States sought to avoid contact with the German navy and a canal made that goal feasible"
    },
    {
     "id": 1171626,
     "content_html": "the United States had sparked a revolution in Nicaragua and required quick access to the region"
    }
   ],
