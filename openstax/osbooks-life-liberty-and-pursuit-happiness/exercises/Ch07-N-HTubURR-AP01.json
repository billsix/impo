    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615461,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What caused the pattern seen in the provided map?",
   "answers": [
    {
     "id": 1169817,
     "content_html": "Free states in closest proximity to slave states saw the greatest activity.\n"
    },
    {
     "id": 1169816,
     "content_html": "New England had only a modest connection to the abolitionist cause.\n"
    },
    {
     "id": 1169815,
     "content_html": "The Erie Canal boats guaranteed safe passage to runaway enslaved persons.\n"
    },
    {
     "id": 1169814,
     "content_html": "Communities of runaway enslaved persons settled along the southern shores of the Great Lakes.\n"
    }
   ],
