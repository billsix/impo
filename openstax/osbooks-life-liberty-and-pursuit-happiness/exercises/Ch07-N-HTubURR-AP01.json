 "stimulus_html": "<figure id=\"fig7_23\">\n<img src=\"exercises/media/8c9386a9f0eefc42.png\" alt=\"Map of the United States showing the area from Minnesota, Iowa, and Missouri on the left to Tennessee and North Carolina at the bottom to New England. Red lines indicate the routes of the Underground Railroad. They are heavily concentrated in Ohio and around the Philadelphia area.\">\n<figcaption>This map features the routes of the Underground Railroad in red.</figcaption>\n</figure>\n<p><i>Refer to the map provided.</i></p>\n",
 "questions": [
  {
   "id": 615460,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The provided map most clearly depicts",
   "answers": [
    {
     "id": 1169812,
     "content_html": "the impact of the transportation revolution of the Jacksonian Era\n"
    },
    {
     "id": 1169811,
     "content_html": "the limits of westward expansion\n"
    },
    {
     "id": 1169813,
     "content_html": "resistance to state and federal legislation\n"
    },
    {
     "id": 1169810,
     "content_html": "the decline in cotton cultivation\n"
    }
   ],
   "hints": [],
