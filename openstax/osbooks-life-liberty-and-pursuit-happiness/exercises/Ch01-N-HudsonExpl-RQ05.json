   "id": 614595,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Henry Hudson and his crew interact with Native Americans during their voyage?",
   "answers": [
    {
     "id": 1166353,
     "content_html": "Hudson’s interactions with Native Americans were based entirely on peaceful trade.\n"
    },
    {
     "id": 1166352,
     "content_html": "Hudson’s interactions with Native Americans were violent.\n"
    },
    {
     "id": 1166351,
     "content_html": "Hudson had little interaction with Native Americans, because most had died of European diseases.\n"
    },
    {
     "id": 1166354,
     "content_html": "Hudson’s interactions with Native Americans involved both trade and violence.\n"
    }
   ],
