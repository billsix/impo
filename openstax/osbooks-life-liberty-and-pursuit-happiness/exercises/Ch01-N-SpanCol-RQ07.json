 "questions": [
  {
   "id": 614576,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Spanish law permitting a slave to purchase freedom allowed for",
   "answers": [
    {
     "id": 1166277,
     "content_html": "a strict racial hierarchy in which African slaves were consistently at the bottom\n"
    },
    {
     "id": 1166278,
     "content_html": "opportunities for free blacks to become sailors, militiamen, and blacksmiths\n"
    },
    {
     "id": 1166276,
     "content_html": "additional conflicts between slaves and Spaniards\n"
    },
    {
     "id": 1166275,
     "content_html": "the establishment of a Catholic church that excluded non-Spanish people\n"
    }
   ],
