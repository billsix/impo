   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The most important advantage of the airplane during World War I was that",
   "answers": [
    {
     "id": 1172273,
     "content_html": "it was used on reconnaissance missions"
    },
    {
     "id": 1172272,
     "content_html": "it was used to deliver heavy equipment to outposts"
    },
    {
     "id": 1172271,
     "content_html": "aerial dogfights contributed significant military victories"
    },
    {
     "id": 1172270,
     "content_html": "pilots could deliver heavy bomb payloads across long distances"
    }
