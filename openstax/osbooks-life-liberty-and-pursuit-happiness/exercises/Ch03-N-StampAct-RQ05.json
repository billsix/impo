   "id": 614836,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Stamp Act overturned the policy of salutary neglect, which for years had",
   "answers": [
    {
     "id": 1167318,
     "content_html": "allowed the colonists to govern themselves without too much interference"
    },
    {
     "id": 1167317,
     "content_html": "asserted Britain’s right to legislate for the colonies in any jurisdiction"
    },
    {
     "id": 1167316,
     "content_html": "forbade the colonists to settle west of the Appalachian Mountains"
    },
    {
     "id": 1167315,
     "content_html": "enabled American Indians to become naturalized British citizens after a waiting period"
    }
   ],
