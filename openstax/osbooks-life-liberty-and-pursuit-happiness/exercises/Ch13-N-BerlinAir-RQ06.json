   "stimulus_html": "",
   "stem_html": "The North Atlantic Treaty Organization was created to",
   "answers": [
    {
     "id": 1173255,
     "content_html": "encourage central European nations to overthrow their Soviet-style governments"
    },
    {
     "id": 1173256,
