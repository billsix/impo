 "is_vocab": false,
 "stimulus_html": "<p>“[for the] Indians with whom We are connected . . . should not be molested or disturbed . . . no Governor . . . [may] grant Warrants of Survey, or pass any Patents for Lands beyond the Bounds of their respective Governments. . . .</p>\n<p>We do . . . require that no private Person do presume to make any purchase from the said Indians of Lands reserved to the said Indians.”</p>\n<p align=\"right\">Excerpt from the Royal Proclamation of 1763</p>\n<p><i>Refer to the excerpt provided</i>.</p>",
 "questions": [
  {
   "id": 614799,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the reasoning for the British decision to limit settlement in the west by issuing the Proclamation of 1763?",
   "answers": [
    {
     "id": 1167169,
     "content_html": "The French maintained a powerful presence there and additional settlement would increase the chances of another war."
    },
    {
     "id": 1167170,
     "content_html": "Expansion of colonial settlements would bring about more conflict with American Indians and require more military protection from the British military."
    },
    {
     "id": 1167168,
     "content_html": "Colonial militias would be able to address any conflicts with American Indians."
    },
    {
     "id": 1167167,
     "content_html": "The legal process of issuing warrants of survey was too complicated and time consuming."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614800,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Proclamation of 1763 angered many colonists for all the following reasons except",
   "answers": [
    {
     "id": 1167173,
     "content_html": "they did not view American Indians as the rightful possessors of the land"
    },
    {
     "id": 1167172,
     "content_html": "they felt disrespected and neglected by the British"
    },
    {
     "id": 1167171,
     "content_html": "they believed the colonies’ economic growth would be limited by this policy"
    },
    {
     "id": 1167174,
     "content_html": "they feared defeat by the American Indians if Britain did not rescind the order"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
