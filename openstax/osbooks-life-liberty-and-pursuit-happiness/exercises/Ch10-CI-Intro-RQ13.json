   "stimulus_html": "",
   "stem_html": "Intervention in Haiti, the Dominican Republic, and the Mexican Revolution demonstrated that President Woodrow Wilson’s foreign policy",
   "answers": [
    {
     "id": 1171461,
     "content_html": "continued an expansion of the United States’ role in the world"
    },
    {
     "id": 1171460,
     "content_html": "abandoned the precedents established by Theodore Roosevelt"
    },
    {
     "id": 1171459,
     "content_html": "concentrated on removing the threat of war in Europe"
    },
    {
     "id": 1171458,
     "content_html": "recognized the threat of Soviet intervention in the Western Hemisphere"
    }
