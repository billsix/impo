   ],
   "combo_choices": []
  },
  {
   "id": 615272,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best summarizes Jefferson’s sentiments when he writes in the excerpt, “We have the wolf by the ears, and we can neither hold him, nor safely let him go. Justice is in one scale, and self-preservation in the other”?",
   "answers": [
    {
     "id": 1169061,
     "content_html": "Slavery presents a problem with no easy answer for the nation."
    },
    {
     "id": 1169060,
     "content_html": "The aftermath of the Missouri Compromise will lead to war."
    },
    {
     "id": 1169059,
     "content_html": "Only Congress can put an end to slavery."
    },
    {
     "id": 1169058,
     "content_html": "Slavery will eventually end without government intervention."
    }
   ],
