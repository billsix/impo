 "questions": [
  {
   "id": 615338,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which best describes the white response to Nat Turner’s Rebellion?",
   "answers": [
    {
     "id": 1169325,
     "content_html": "Whites responded brutally, but after a few days, leaders were able to limit the retribution."
    },
    {
     "id": 1169324,
     "content_html": "Whites were relatively subdued at first, but as the extent of devastation became clear, they sought ever more brutal retribution."
    },
    {
     "id": 1169323,
     "content_html": "The white response was surprisingly mild."
    },
    {
     "id": 1169322,
     "content_html": "Whites sought vengeance however they could get it."
    }
   ],
