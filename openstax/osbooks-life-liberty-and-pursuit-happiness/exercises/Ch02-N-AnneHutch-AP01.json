   "id": 614776,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The excerpt provided supports which generalization about the seventeenth-century Massachusetts Bay Colony?",
   "answers": [
    {
     "id": 1167077,
     "content_html": "Women had an unusual number of political and religious rights."
    },
    {
     "id": 1167078,
     "content_html": "There was little to no religious toleration."
    },
    {
     "id": 1167076,
     "content_html": "Christians and Jews enjoyed equal rights in colonial New England."
    },
    {
     "id": 1167075,
     "content_html": "English settlers were trying to attract a diverse population for permanent settlement."
    }
