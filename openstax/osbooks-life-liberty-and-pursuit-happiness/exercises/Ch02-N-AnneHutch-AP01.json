   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on the excerpt of Anne Hutchinson’s testimony, which statement is not true?",
   "answers": [
    {
     "id": 1167073,
     "content_html": "Anne Hutchinson was steeped in her understanding and knowledge of the Bible."
    },
    {
     "id": 1167072,
     "content_html": "Anne Hutchinson was certain about her theological convictions."
    },
    {
     "id": 1167074,
     "content_html": "Anne Hutchinson doubted her knowledge of theological matters due to her sex."
    },
    {
     "id": 1167071,
     "content_html": "Anne Hutchinson was convinced that God revealed truths to her."
    }
   ],
