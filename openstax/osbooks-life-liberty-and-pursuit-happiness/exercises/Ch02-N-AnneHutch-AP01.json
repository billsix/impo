   "id": 614774,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What passage in the excerpt provided most seriously violates Puritan beliefs of the mid-seventeenth century?",
   "answers": [
    {
     "id": 1167069,
     "content_html": "Hutchinson’s contention that the Constitution of the Church of England was false"
    },
    {
     "id": 1167070,
     "content_html": "Her statement that she had a revelation from God"
    },
    {
     "id": 1167068,
     "content_html": "Her reference to the Old Testament"
    },
    {
     "id": 1167067,
     "content_html": "Her admission that she kept a day of “solemn humiliation”"
    }
   ],
