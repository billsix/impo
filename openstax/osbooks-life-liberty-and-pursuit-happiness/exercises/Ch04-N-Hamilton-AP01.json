    {
     "id": 1168453,
     "content_html": "the Constitution must be interpreted broadly for the government to function properly"
    },
    {
     "id": 1168451,
     "content_html": "the government cannot create entities such as a national bank because those powers are not implied by the Constitution"
    },
    {
     "id": 1168450,
     "content_html": "the delegated powers in the Constitution are more significant than the implied powers"
    }
   ],
