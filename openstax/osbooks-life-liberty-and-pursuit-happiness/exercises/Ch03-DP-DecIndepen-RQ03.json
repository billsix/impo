   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following were arguments for remaining in the British Empire except",
   "answers": [
    {
     "id": 1167661,
     "content_html": "colonists had fair representation in Parliament"
    },
    {
     "id": 1167660,
     "content_html": "colonists benefitted from the protection of the Royal Navy"
    },
    {
     "id": 1167659,
     "content_html": "colonists participated in a lucrative trade with Great Britain and her Caribbean colonies"
    },
    {
     "id": 1167658,
     "content_html": "most colonists shared a strong cultural identity with their British brethren"
    }
