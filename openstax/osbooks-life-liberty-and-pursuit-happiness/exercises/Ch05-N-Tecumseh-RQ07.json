 "questions": [
  {
   "id": 615203,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A main objection of Tecumseh to the Treaty of Fort Wayne was",
   "answers": [
    {
     "id": 1168784,
     "content_html": "the United States paid an excessive amount for the land"
    },
    {
     "id": 1168783,
     "content_html": "the treaty should have been negotiated with the British government"
    },
    {
     "id": 1168785,
     "content_html": "land was held communally by different Native American nations, not as private property"
    },
    {
     "id": 1168782,
     "content_html": "the land had already been ceded to the colonists during the American Revolution"
    }
   ],
