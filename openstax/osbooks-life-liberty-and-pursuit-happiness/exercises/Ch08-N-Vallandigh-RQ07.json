 "questions": [
  {
   "id": 615779,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was President Lincoln’s motivation for overturning the immediate emancipation of all slaves in the state of Missouri during the Civil War?",
   "answers": [
    {
     "id": 1171084,
     "content_html": "Lincoln wanted other border states to also emancipate their slaves."
    },
    {
     "id": 1171083,
     "content_html": "Although surprised by the decision, Lincoln felt he should do nothing."
    },
    {
     "id": 1171085,
     "content_html": "Lincoln feared that Missouri and other border states might secede."
    },
    {
     "id": 1171082,
     "content_html": "Lincoln wanted to issue the Emancipation Proclamation immediately."
    }
   ],
