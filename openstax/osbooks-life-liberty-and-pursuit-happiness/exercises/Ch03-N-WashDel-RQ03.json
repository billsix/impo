 "questions": [
  {
   "id": 614862,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best explains the significance of the victory at Trenton from the viewpoint of the Americans?",
   "answers": [
    {
     "id": 1167421,
     "content_html": "This critical battle was the first skirmish in the American Revolution and is remembered as “the shot heard ‘round the world.”"
    },
    {
     "id": 1167420,
     "content_html": "This tactical victory was critical in gaining French support, which came with national recognition and monetary assistance."
    },
    {
     "id": 1167419,
     "content_html": "The naval support provided by France in this victory spelled the end of the war and victory for the Americans."
    },
    {
     "id": 1167422,
     "content_html": "The popular support generated from this battle renewed enlistments and support from the colonists to continue fighting against the British."
    }
   ],
