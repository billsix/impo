 "stimulus_html": "<figure id=\"Ch14_fig02\">\n<img src=\"exercises/media/4ef0c7e0ef44299a.png\" alt=\"Smoke pours out of the windows and doors of a bus on the side of the road.\">\n<figcaption>A Greyhound bus carrying freedom riders was firebombed by an angry mob while in Anniston, Alabama, in 1961. Forced to evacuate, the passengers were then assaulted. (credit: “Freedom Riders Bus Attack” by Federal Bureau of Investigation)</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>\n",
 "questions": [
  {
   "id": 616607,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The events in the image most directly led to",
   "answers": [
    {
     "id": 1173967,
     "content_html": "a Supreme Court decision declaring segregation unconstitutional"
    },
    {
     "id": 1173968,
     "content_html": "increased support for passage of the Civil Rights Act of 1964"
    },
    {
     "id": 1173966,
     "content_html": "the development of the counterculture"
    },
    {
     "id": 1173965,
     "content_html": "Martin Luther King Jr.’s becoming a civil rights leader"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616608,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The event in the photograph contributed to which of the following?",
   "answers": [
    {
     "id": 1173972,
     "content_html": "Debates over the role of government in American life"
    },
    {
     "id": 1173971,
     "content_html": "An increase in public confidence in political institutions"
    },
    {
     "id": 1173970,
     "content_html": "Domestic opposition to containment"
    },
    {
     "id": 1173969,
     "content_html": "The abandonment of direct-action techniques to achieve civil rights"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616609,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The event in the image was most directly shaped by",
   "answers": [
    {
     "id": 1173975,
     "content_html": "the techniques and strategies of the anti-war movement"
    },
    {
     "id": 1173974,
     "content_html": "desegregation of the armed forces"
    },
    {
     "id": 1173976,
     "content_html": "a desire to achieve the promise of the Fourteenth Amendment"
    },
    {
     "id": 1173973,
     "content_html": "Lyndon Johnson’s Great Society program"
    }
   ],
