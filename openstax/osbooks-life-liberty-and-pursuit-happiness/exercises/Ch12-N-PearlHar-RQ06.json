 "questions": [
  {
   "id": 616227,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did American foreign policy change after December 7, 1941?",
   "answers": [
    {
     "id": 1172875,
     "content_html": "The United States declared war on Germany, setting up the “Europe first” military strategy for World War II."
    },
    {
     "id": 1172874,
     "content_html": "The United States joined the League of Nations to counter growing fascism and totalitarianism."
    },
    {
     "id": 1172873,
     "content_html": "The United States formed a collective-security agreement with Great Britain, the Soviet Union, and Communist China to fight totalitarianism abroad."
    },
    {
     "id": 1172876,
     "content_html": "The United States declared war on Japan, abandoning the neutrality policy it had followed since the end of World War I."
    }
   ],
