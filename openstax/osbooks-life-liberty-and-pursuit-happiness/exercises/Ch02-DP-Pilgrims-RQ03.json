 "questions": [
  {
   "id": 614748,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the Pilgrims interactions with American Indians in the first years of their colony?",
   "answers": [
    {
     "id": 1166965,
     "content_html": "Interactions with American Indians were uniformly violent."
    },
    {
     "id": 1166966,
     "content_html": "Interactions varied among the different groups living in the area."
    },
    {
     "id": 1166964,
     "content_html": "The Pilgrims resented American Indians for the success of their harvests."
    },
    {
     "id": 1166963,
     "content_html": "The Pilgrims were successful in widespread conversion of American Indian groups."
    }
   ],
