     "id": 1167952,
     "content_html": "a continuity in the powers of American government"
    },
    {
     "id": 1167951,
     "content_html": "the expansion of the United States’ physical territory"
    },
    {
     "id": 1167950,
     "content_html": "commitment to gender and racial equality in America"
    }
