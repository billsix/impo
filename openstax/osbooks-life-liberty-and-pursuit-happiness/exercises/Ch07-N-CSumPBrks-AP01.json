    {
     "id": 1170031,
     "content_html": "the admission of California as a free state"
    },
    {
     "id": 1170030,
     "content_html": "the secession of South Carolina\n"
    },
    {
     "id": 1170033,
     "content_html": "the sectional tension regarding slavery in the United States\n"
    }
   ],
