 "questions": [
  {
   "id": 615231,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of these was an effect of completion of the Erie Canal?",
   "answers": [
    {
     "id": 1168896,
     "content_html": "Its fees made it more difficult for farmers to ship their crops long distances."
    },
    {
     "id": 1168895,
     "content_html": "It led to so much new wooden construction that fires increased, causing upstate New York to be called the “burned-over district.”"
    },
    {
     "id": 1168894,
     "content_html": "It made New York so prosperous that the westward shift in the geographical center of the U.S. population stopped for a while."
    },
    {
     "id": 1168897,
     "content_html": "Within a few years, it carried goods worth double the value of all freight shipped down the Mississippi River to New Orleans."
    }
   ],
