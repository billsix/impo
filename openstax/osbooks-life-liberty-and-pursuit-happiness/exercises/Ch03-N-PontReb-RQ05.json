 "questions": [
  {
   "id": 614829,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following did not occur during Pontiac’s Rebellion?",
   "answers": [
    {
     "id": 1167289,
     "content_html": "The British government hoped to settle the conflict by restricting colonists’ westward movement."
    },
    {
     "id": 1167288,
     "content_html": "American Indian groups used guerilla tactics to resist the highly trained British military."
    },
    {
     "id": 1167287,
     "content_html": "American Indian tribes made alliances based on local needs and circumstances, not necessarily a unified identity."
    },
    {
     "id": 1167290,
     "content_html": "Europeans generally treated the American Indians with respect for their personal beliefs and culture."
    }
   ],
