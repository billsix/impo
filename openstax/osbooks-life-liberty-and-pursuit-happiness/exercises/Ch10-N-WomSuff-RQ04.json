  {
   "id": 615890,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The existence of the National American Woman Suffrage Association and the National Women’s Party in the early twentieth century best demonstrated that",
   "answers": [
    {
     "id": 1171528,
     "content_html": "continuity existed in the goals and methodology within the women’s movement"
    },
    {
     "id": 1171527,
     "content_html": "foreign-born and native-born organizational leadership clashed"
    },
    {
     "id": 1171529,
     "content_html": "disagreements existed about how best to achieve the franchise for women"
    },
    {
     "id": 1171526,
     "content_html": "a geographic schism existed in the women’s movement"
    }
   ],
