   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The most significant lesson Americans learned from the Battle of Iwo Jima was that",
   "answers": [
    {
     "id": 1172967,
     "content_html": "Japan was close to military and political collapse"
    },
    {
     "id": 1172966,
     "content_html": "the kamikaze were unstoppable"
    },
    {
     "id": 1172968,
     "content_html": "an invasion of Japan would come at a high cost of lives for both sides"
    },
    {
     "id": 1172965,
     "content_html": "total victory over Japan was impossible"
    }
