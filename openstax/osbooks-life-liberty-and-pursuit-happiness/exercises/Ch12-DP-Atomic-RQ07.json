   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A reason proposed for not using atomic weapons against Japan in the summer of 1945 was",
   "answers": [
    {
     "id": 1173051,
     "content_html": "the Japanese government’s clear willingness to negotiate"
    },
    {
     "id": 1173052,
     "content_html": "the threat to Allied prisoners of war"
    },
    {
     "id": 1173050,
     "content_html": "sentiment favoring collaboration with the Soviet Union to invade Japan’s core islands"
    },
    {
     "id": 1173049,
     "content_html": "American public’s moral resistance to radical solutions"
    }
