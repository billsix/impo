 "questions": [
  {
   "id": 616638,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following accurately compares first- and second-wave feminism?",
   "answers": [
    {
     "id": 1174091,
     "content_html": "Both movements made access to birth control a central issue."
    },
    {
     "id": 1174090,
     "content_html": "Second-wave feminism sought political equality and voting rights, whereas first-wave feminism sought to honor a woman’s role as a mother."
    },
    {
     "id": 1174092,
     "content_html": "Both movements sought constitutional change to guarantee various rights to women."
    },
    {
     "id": 1174089,
     "content_html": "First-wave feminism focused on the loss of women’s jobs to returning soldiers, whereas second-wave feminism focused on equal pay for equal work."
    }
   ],
