   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The term “Era of Good Feelings” is misleading because",
   "answers": [
    {
     "id": 1168608,
     "content_html": "the Federalist Party remained strong in New England and the newly admitted western states"
    },
    {
     "id": 1168607,
     "content_html": "emerging nationalism failed to capture the imagination of the American public"
    },
    {
     "id": 1168606,
     "content_html": "Andrew Jackson challenged President Monroe’s reelection bid"
    },
    {
     "id": 1168609,
     "content_html": "rising sectionalism led to disagreements over the Bank of the United States and tariffs"
    }
