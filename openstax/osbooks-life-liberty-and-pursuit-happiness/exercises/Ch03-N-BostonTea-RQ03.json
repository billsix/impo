 "questions": [
  {
   "id": 614848,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was the colonists’ primary reason for protesting the Tea Act?",
   "answers": [
    {
     "id": 1167365,
     "content_html": "Taxes were so high they couldn’t afford to buy tea."
    },
    {
     "id": 1167366,
     "content_html": "They felt the act violated the concept of representative government."
    },
    {
     "id": 1167364,
     "content_html": "Patriots desired to prove their strength and unity throughout the colonies."
    },
    {
     "id": 1167363,
     "content_html": "Colonists wanted to prevent American Indians from assimilating to city life."
    }
   ],
