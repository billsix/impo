   "id": 616433,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In writing about Wisconsin Senator Joseph McCarthy, William F. Buckley Jr.",
   "answers": [
    {
     "id": 1173699,
     "content_html": "praised McCarthy’s work as worthy and noble without fault"
    },
    {
     "id": 1173700,
     "content_html": "claimed that, although he made some errors, McCarthy was a patriotic crusader"
    },
    {
     "id": 1173698,
     "content_html": "campaigned for McCarthy during his reelection campaign in 1952"
    },
    {
     "id": 1173697,
     "content_html": "believed McCarthy should be hailed as an American hero"
    }
   ],
