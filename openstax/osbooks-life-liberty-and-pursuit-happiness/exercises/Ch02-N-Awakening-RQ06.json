 "questions": [
  {
   "id": 614720,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "It has been argued that the Great Awakening contributed to a decline in the importance of established religion during the second part of the eighteenth century, because",
   "answers": [
    {
     "id": 1166853,
     "content_html": "people were alienated by the anti-intellectual quality of the sermons they had to listen to"
    },
    {
     "id": 1166852,
     "content_html": "many ministers simply quit the profession and denounced any form of Christianity"
    },
    {
     "id": 1166854,
     "content_html": "the revivals had weakened the hold of established churches in colonial America"
    },
    {
     "id": 1166851,
     "content_html": "many Americans converted to Judaism or Islam"
    }
   ],
