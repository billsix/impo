 "questions": [
  {
   "id": 614925,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the Patriots achieved military victory over the British, what result was most widely feared?",
   "answers": [
    {
     "id": 1167672,
     "content_html": "The colonists would uphold their values of republican virtue and liberty to create a successful government."
    },
    {
     "id": 1167673,
     "content_html": "Following international precedent, the commanding general would take over the government and begin dictatorial rule."
    },
    {
     "id": 1167671,
     "content_html": "Ideas of inalienable rights would materialize in an egalitarian society, where men and women were equal."
    },
    {
     "id": 1167670,
     "content_html": "Patriots would become staunch supporters of the mother country regardless of their victory."
    }
   ],
