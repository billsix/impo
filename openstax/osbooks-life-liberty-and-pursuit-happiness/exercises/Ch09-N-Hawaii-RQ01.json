   "stimulus_html": "",
   "stem_html": "What became the crucial justification for finalizing Hawaiian annexation?",
   "answers": [
    {
     "id": 1170500,
     "content_html": "American sugar interests demanded it."
    },
    {
     "id": 1170499,
     "content_html": "The Queen of Hawaii was murdered, leaving the country with no viable ruler."
    },
    {
     "id": 1170498,
     "content_html": "The Chinese Empire threatened to seize Hawaii."
    },
    {
     "id": 1170501,
     "content_html": "The United States went to war with Spain."
    }
