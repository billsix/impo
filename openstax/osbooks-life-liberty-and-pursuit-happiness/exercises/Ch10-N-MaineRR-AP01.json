 "stimulus_html": "<figure>\n<img src=\"exercises/media/c903e533a1b5ec59.png\" alt=\"Theodore Roosevelt gestures to a group of buildings with his gun and leads a group of soldiers up a hill.\">\n<figcaption>From the 1904 book <i>American Boy’s Life of Theodore Roosevelt</i>.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 615983,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The events depicted in this image most directly led to",
   "answers": [
    {
     "id": 1171900,
     "content_html": "rejection of American interventionism in Latin America"
    },
    {
     "id": 1171899,
     "content_html": "an end to peacetime conscription"
    },
    {
     "id": 1171901,
     "content_html": "intense debate about America’s proper role in the world"
    },
    {
     "id": 1171898,
     "content_html": "rejection of the Progressive Era at the polls"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615984,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A historian might use this image to support the point that",
   "answers": [
    {
     "id": 1171905,
     "content_html": "innovations in communication and technology contributed to a growth of mass culture"
    },
    {
     "id": 1171904,
     "content_html": "war fatigue led to a reevaluation of American foreign policy"
    },
    {
     "id": 1171903,
     "content_html": "political instability led to pressure to reform the American political system"
    },
    {
     "id": 1171902,
     "content_html": "the American military suffered from inadequate funding"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615985,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This image was created in response to",
   "answers": [
    {
     "id": 1171908,
     "content_html": "the end of the Plains Wars with the American Indians"
    },
    {
     "id": 1171909,
     "content_html": "America’s victory in the Spanish-American War"
    },
    {
     "id": 1171907,
     "content_html": "America’s entry into World War I"
    },
    {
     "id": 1171906,
     "content_html": "the U.S. annexation of the Philippines"
    }
