 "questions": [
  {
   "id": 614860,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the goal of Washington’s famed crossing of the Delaware River on December 25, 1777?",
   "answers": [
    {
     "id": 1167413,
     "content_html": "To retreat from New York to his encampment at Valley Forge, Pennsylvania"
    },
    {
     "id": 1167414,
     "content_html": "To ambush German Hessian troops and seize an opportunity for a victory"
    },
    {
     "id": 1167412,
     "content_html": "To surround Philadelphia and protect the capital from British invasion"
    },
    {
     "id": 1167411,
     "content_html": "To outrun a torrent of harsh weather conditions and allow his troops time to recuperate"
    }
   ],
