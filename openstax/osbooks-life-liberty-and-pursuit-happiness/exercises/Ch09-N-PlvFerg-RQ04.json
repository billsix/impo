 "questions": [
  {
   "id": 615661,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to the dissenting opinion in the <i>Plessy v. Ferguson</i> decision,",
   "answers": [
    {
     "id": 1170612,
     "content_html": "the main point of the Fourteenth Amendment was to enforce “political” equality of the races “before the law”"
    },
    {
     "id": 1170611,
     "content_html": "the Court was unable to see how the Louisiana statute deprived Plessy of, or in any way affected his right to, his property"
    },
    {
     "id": 1170610,
     "content_html": "the Constitution does not require the government to guarantee equality of results"
    },
    {
     "id": 1170613,
     "content_html": "the Constitution is color-blind and neither knows nor tolerates classes among citizens"
    }
   ],
   "hints": [],
