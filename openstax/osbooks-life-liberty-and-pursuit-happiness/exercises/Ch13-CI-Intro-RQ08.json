 "questions": [
  {
   "id": 616283,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Taft-Hartley Act was most likely passed as a result of",
   "answers": [
    {
     "id": 1173100,
     "content_html": "fear of labor involvement in radical politics and activities"
    },
    {
     "id": 1173099,
     "content_html": "concern that strong labor unions could rekindle a depression"
    },
    {
     "id": 1173098,
     "content_html": "fear that labor would restrict the freedom of workers"
    },
    {
     "id": 1173097,
     "content_html": "desire to make the labor strike illegal"
    }
   ],
