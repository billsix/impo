 "stimulus_html": "<figure>\n<img src=\"exercises/media/2e30d14c9d7c9160.png\" alt=\"Wilson empties buckets of water into a pump, called “Business Prosperity Pump.” The buckets are labeled “Anti-Trust Legislation,” “Tariff Legislation,” and “Currency Legislation.” Wilson says, “Now watch her come.”\">\n<figcaption>Cartoon depicting President Wilson’s fiscal policies, published June 26, 1914.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 615998,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The developments depicted in the cartoon were most directly shaped by",
   "answers": [
    {
     "id": 1171960,
     "content_html": "the aftermath of the Spanish-American War"
    },
    {
     "id": 1171961,
     "content_html": "economic instability associated with the industrial revolution"
    },
    {
     "id": 1171959,
     "content_html": "social concerns connected with a massive increase in immigration"
    },
    {
     "id": 1171958,
     "content_html": "expansion of suffrage to women"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615999,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following represented a continuation of the developments depicted in the cartoon?",
   "answers": [
    {
     "id": 1171964,
     "content_html": "Gospel of Wealth of the late nineteenth century"
    },
    {
     "id": 1171963,
     "content_html": "Laissez-faire policies of the 1920s"
    },
    {
     "id": 1171965,
     "content_html": "Pro-business Supreme Court decisions"
    },
    {
     "id": 1171962,
     "content_html": "Conservation efforts and creation of national parks"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616000,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This political cartoon most directly reflected a growing belief that",
   "answers": [
    {
     "id": 1171968,
     "content_html": "transition to an urban, industrial economy would seriously threaten American values"
    },
    {
     "id": 1171967,
     "content_html": "middle- and upper-class reformers would foster positive social change in the cities"
    },
    {
     "id": 1171966,
     "content_html": "geographic factors led to regional political differences"
    },
    {
     "id": 1171969,
     "content_html": "federal legislation would effectively regulate the economy"
    }
   ],
