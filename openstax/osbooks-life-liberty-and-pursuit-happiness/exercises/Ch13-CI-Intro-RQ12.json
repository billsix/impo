   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Anti-communist crusader Senator Joseph McCarthy overplayed his advantage in the Red Scare when he",
   "answers": [
    {
     "id": 1173115,
     "content_html": "claimed members of the president’s Cabinet were known communists"
    },
    {
     "id": 1173114,
     "content_html": "charged Martin Luther King Jr. with being a communist"
    },
    {
     "id": 1173116,
     "content_html": "asserted the U.S. Army knowingly protected known communists in its leadership"
    },
    {
     "id": 1173113,
     "content_html": "hinted that President Eisenhower could be a communist"
    }
   ],
