   "stimulus_html": "",
   "stem_html": "Lincoln’s strategy regarding Fort Sumter included",
   "answers": [
    {
     "id": 1170840,
     "content_html": "evacuating the fort to postpone confrontation with the new Confederacy"
    },
    {
     "id": 1170839,
     "content_html": "a surprise resupply mission before Southern troops could mobilize"
    },
    {
     "id": 1170841,
     "content_html": "watchful waiting and caution so the Union would not be the aggressor"
    },
    {
     "id": 1170838,
     "content_html": "overwhelming attack to demonstrate his resolve to preserve the Union"
    }
   ],
