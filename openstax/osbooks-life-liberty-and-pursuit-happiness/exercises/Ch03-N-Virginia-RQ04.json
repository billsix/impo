 "questions": [
  {
   "id": 614876,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was not an effect of Virginia’s established Anglican Church before the Revolution?",
   "answers": [
    {
     "id": 1167476,
     "content_html": "All residents of the state had to pay taxes to support that church."
    },
    {
     "id": 1167475,
     "content_html": "Any preacher not of that established church could not preach without a license."
    },
    {
     "id": 1167474,
     "content_html": "Public ridiculing of minority religions was common."
    },
    {
     "id": 1167477,
     "content_html": "Dissenters, those who didn’t agree with the established religion, were able to practice their own religion as long as they paid a tax assessment."
    }
   ],
