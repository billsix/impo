   "id": 614729,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Benjamin Franklin’s <i>Plan of Union</i> faced all the following obstacles except",
   "answers": [
    {
     "id": 1166889,
     "content_html": "colonial leaders’ distrust and fear of losing power"
    },
    {
     "id": 1166888,
     "content_html": "failure of the Iroquois to provide a working example of the benefits of confederation"
    },
    {
     "id": 1166887,
     "content_html": "British concerns about ceding too much authority to colonial governments"
    },
    {
     "id": 1166890,
     "content_html": "British endorsement of the recommendations cited in the Albany Plan"
    }
   ],
