 "questions": [
  {
   "id": 615259,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the Federalists attempt to resist Democratic Republican rule in the early nineteenth century?",
   "answers": [
    {
     "id": 1169008,
     "content_html": "They blocked the creation of new states by setting impossibly high population requirements."
    },
    {
     "id": 1169007,
     "content_html": "They declared the Alien and Sedition Acts unconstitutional."
    },
    {
     "id": 1169009,
     "content_html": "Some advocated secession, while moderates proposed a series of amendments to increase New England’s political power."
    },
    {
     "id": 1169006,
     "content_html": "They voted for U.S. entry into the War of 1812 to increase New England’s shipbuilding capacity."
    }
   ],
