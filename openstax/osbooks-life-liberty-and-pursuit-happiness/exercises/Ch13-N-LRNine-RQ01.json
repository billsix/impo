   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In May 1954, the Supreme Court decided in <i>Brown v. Board of Education</i> (1954) that",
   "answers": [
    {
     "id": 1173479,
     "content_html": "the “separate but equal” doctrine should be enforced more actively"
    },
    {
     "id": 1173478,
     "content_html": "segregation should be abolished in every southern institution"
    },
    {
     "id": 1173477,
     "content_html": "the plaintiffs did not have proper legal standing"
    },
    {
     "id": 1173480,
     "content_html": "segregation in public education was unconstitutional"
    }
   ],
