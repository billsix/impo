 "questions": [
  {
   "id": 614849,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes a significant change in British North America after the Boston Tea Party and retaliatory Coercive Acts?",
   "answers": [
    {
     "id": 1167369,
     "content_html": "Loyalists began leaving the colonies, fleeing to safety in Canada."
    },
    {
     "id": 1167370,
     "content_html": "Patriots coordinated intercolonial bodies and began articulating an American identity and cause."
    },
    {
     "id": 1167368,
     "content_html": "American Indians allied with the colonists in protest of Britain’s taxes and forceful presence."
    },
    {
     "id": 1167367,
     "content_html": "Parliament realized the taxes were unfair and repealed the majority of them."
    }
   ],
