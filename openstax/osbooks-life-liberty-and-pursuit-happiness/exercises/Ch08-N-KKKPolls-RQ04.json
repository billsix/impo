 "questions": [
  {
   "id": 615795,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The decision in <i>U.S. v. Cruikshank</i> (1876) stated that",
   "answers": [
    {
     "id": 1171148,
     "content_html": "the <i>Slaughterhouse</i> decision was overturned, giving new meaning to the Privileges and Immunities Clause"
    },
    {
     "id": 1171149,
     "content_html": "the actions of one private citizen against another did not fall under the federal government’s jurisdiction"
    },
    {
     "id": 1171147,
     "content_html": "the Fourteenth and Fifteenth Amendments took priority over state laws"
    },
    {
     "id": 1171146,
     "content_html": "all white supremacist organizations were unlawful and would be subject to prosecution by the Freedmen’s Bureau"
    }
   ],
