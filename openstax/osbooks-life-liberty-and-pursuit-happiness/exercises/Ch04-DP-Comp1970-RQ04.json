 "questions": [
  {
   "id": 615105,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A site on the Potomac River was selected for the capital city for all the following reasons except",
   "answers": [
    {
     "id": 1168392,
     "content_html": "the river could become a major artery for commerce"
    },
    {
     "id": 1168391,
     "content_html": "the location was roughly on the border between the northern and southern states"
    },
    {
     "id": 1168390,
     "content_html": "the location was a compromise offered by Alexander Hamilton in return for support of his financial plan"
    },
    {
     "id": 1168393,
     "content_html": "the location was selected by George Washington because he required the capital city to be near his home in northern Virginia"
    }
   ],
