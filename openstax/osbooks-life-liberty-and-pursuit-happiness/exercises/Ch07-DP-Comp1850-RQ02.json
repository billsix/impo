   "stimulus_html": "",
   "stem_html": "What did the final Compromise of 1850 achieve? ",
   "answers": [
    {
     "id": 1170220,
     "content_html": "A lasting peace between the sections\n"
    },
    {
     "id": 1170221,
     "content_html": "The end of the slave trade in the national capital\n"
    },
    {
     "id": 1170219,
     "content_html": "A new parity in the Senate between North and South\n"
    },
    {
     "id": 1170218,
     "content_html": "An expanded geographic area for Texas\n"
    }
