   "stimulus_html": "",
   "stem_html": "A key result of New Deal legislation was to create a federal government",
   "answers": [
    {
     "id": 1172612,
     "content_html": "unresponsive to the problems created by the Great Depression"
    },
    {
     "id": 1172611,
     "content_html": "that nationalized important industries within the United States economy"
    },
    {
     "id": 1172613,
     "content_html": "that used emergency powers to expand the federal regulatory state"
    },
    {
     "id": 1172610,
     "content_html": "determined to continue the economic policies of the 1920s"
    }
