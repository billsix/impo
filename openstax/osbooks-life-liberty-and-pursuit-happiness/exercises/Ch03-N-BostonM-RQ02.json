 "questions": [
  {
   "id": 614840,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Boston Massacre refers to",
   "answers": [
    {
     "id": 1167333,
     "content_html": "the period when mobs frequently wounded or killed British soldiers in the streets of Boston because the soldiers were viewed as symbols of British tyranny"
    },
    {
     "id": 1167334,
     "content_html": "the episode in which a Boston mob attacked British soldiers who then fired into the crowd, killing five colonists"
    },
    {
     "id": 1167332,
     "content_html": "the period when the British enforced the Stamp, Sugar, Tea, and Townshend Acts on the colonies"
    },
    {
     "id": 1167331,
     "content_html": "the funerals held for murdered colonists that thousands of Bostonians attended to demonstrate solidarity against the British"
    }
   ],
