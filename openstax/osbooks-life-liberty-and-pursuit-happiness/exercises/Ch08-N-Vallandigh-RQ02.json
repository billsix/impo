 "questions": [
  {
   "id": 615774,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which best represents Lincoln’s position on General Burnside’s Order No. 38?",
   "answers": [
    {
     "id": 1171064,
     "content_html": "Lincoln had ordered General Burnside to issue Order No. 38."
    },
    {
     "id": 1171063,
     "content_html": "Lincoln supported Order No. 38 and wanted to suppress all dissent during the war."
    },
    {
     "id": 1171065,
     "content_html": "Lincoln did not approve the order and, as president, wanted to control administration policy."
    },
    {
     "id": 1171062,
     "content_html": "Lincoln did not know about the order because it was issued on the Ohio frontier."
    }
   ],
