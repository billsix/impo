   "stimulus_html": "",
   "stem_html": "The greatest impact of the Mexican War of 1846–1848 was that",
   "answers": [
    {
     "id": 1169117,
     "content_html": "the United States gained a significant amount of territory in its quest to expand to the Pacific"
    },
    {
     "id": 1169116,
     "content_html": "abolitionism spread across the North and South"
    },
    {
     "id": 1169115,
     "content_html": "slavery was outlawed in the new territories"
    },
    {
     "id": 1169114,
     "content_html": "Texas became a state at the conclusion of the fighting"
    }
