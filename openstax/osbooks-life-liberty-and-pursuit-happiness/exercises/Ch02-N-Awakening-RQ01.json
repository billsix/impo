 "questions": [
  {
   "id": 614715,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Many historians believe the Great Awakening helped set the stage for the American Revolution. Which of these ideas best supports that argument?",
   "answers": [
    {
     "id": 1166834,
     "content_html": "Evangelical teaching during the Great Awakening proposed that each individual believer was equal before God, which made it easier to accept the radical implications of democracy."
    },
    {
     "id": 1166833,
     "content_html": "Many Great Awakening preachers were political radicals."
    },
    {
     "id": 1166832,
     "content_html": "Churches under the Great Awakening were much more democratic than earlier churches had been."
    },
    {
     "id": 1166831,
     "content_html": "Great Awakening theology argued that only those who were among God’s “elect” would go to Heaven when they died."
    }
   ],
