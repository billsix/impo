 "questions": [
  {
   "id": 614697,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following describes a significant result of Bacon’s Rebellion?",
   "answers": [
    {
     "id": 1166762,
     "content_html": "The wealthy planter class gained greater control of Virginia politics and economics."
    },
    {
     "id": 1166761,
     "content_html": "Yeoman frontier farmers gained seats on the governor’s council."
    },
    {
     "id": 1166760,
     "content_html": "Slaves and indentured servants who joined the rebellion were granted amnesty and emancipation."
    },
    {
     "id": 1166759,
     "content_html": "William Berkeley was granted additional lands in the Ohio Valley for his service."
    }
   ],
