   "stimulus_html": "",
   "stem_html": "As a delegate to the United Nations, Eleanor Roosevelt worked for which of the following issues?",
   "answers": [
    {
     "id": 1173180,
     "content_html": "International human rights"
    },
    {
     "id": 1173179,
     "content_html": "The independence of colonies around the world"
    },
    {
     "id": 1173178,
     "content_html": "Collective security against the Soviet Union"
    },
    {
     "id": 1173177,
     "content_html": "The eradication of diseases such as polio"
    }
