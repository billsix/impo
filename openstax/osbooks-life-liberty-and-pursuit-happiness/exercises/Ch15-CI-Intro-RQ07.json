   "stimulus_html": "",
   "stem_html": "Richard Nixon’s policy for the Vietnam War when he took office is best described as",
   "answers": [
    {
     "id": 1174419,
     "content_html": "working with the Democratic Congress on ending the war"
    },
    {
     "id": 1174420,
     "content_html": "not wanting to abandon the South Vietnam government"
    },
    {
     "id": 1174418,
     "content_html": "hoping to send more troops to Asia"
    },
    {
     "id": 1174417,
     "content_html": "hoping to sway public opinion to support the war"
    }
