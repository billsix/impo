   "stimulus_html": "",
   "stem_html": "The image provided most likely represents",
   "answers": [
    {
     "id": 1166289,
     "content_html": "the enslavement of Native Americans by colonizers in the Americas\n"
    },
    {
     "id": 1166290,
     "content_html": "the dynamic social hierarchy in Spanish colonies\n"
    },
    {
     "id": 1166288,
     "content_html": "the system of forced labor created to efficiently extract precious mineral resources\n"
    },
    {
     "id": 1166287,
     "content_html": "Spanish reliance on Native Americans for political and economic advancement\n"
    }
   ],
