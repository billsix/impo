 "is_vocab": false,
 "stimulus_html": "<figure>\n<img src=\"exercises/media/12b63050c6cd81cf.png\" alt=\"The cartoon shows an elephant sick in bed. He has ice tied to his head. A woman fans him. Dr. Uncle Sam sits on the bed and measures the elephant’s heartrate. A bottle of “rest cure” sits on a cloth labeled GOP on the bedside table. A Roosevelt pie, with one piece missing, is on the floor. The caption at the bottom reads, “Dr. Sam: ‘He may pull through—with a long rest.’”\">\n<figcaption>“Dr. Sam: ‘He May Pull Through—With a Long Rest.’” This cartoon, by Hayes, was published in <i>Harper’s Weekly</i>, July 20, 1912.</figcaption>\n</figure>\n<p><i>Refer to the image provided. </i></p>",
 "questions": [
  {
   "id": 616013,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This political cartoon was created in response to",
   "answers": [
    {
     "id": 1172020,
     "content_html": "the Republican Party’s support of the Thirteenth, Fourteenth, and Fifteenth Amendments"
    },
    {
     "id": 1172019,
     "content_html": "Republican opposition to the Treaty of Versailles"
    },
    {
     "id": 1172018,
     "content_html": "Democratic support for the women’s suffrage amendment"
    },
    {
     "id": 1172021,
     "content_html": "a split within the Republican party for the presidential nomination"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616014,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The events depicted in this cartoon most directly led to",
   "answers": [
    {
     "id": 1172024,
     "content_html": "new U.S. territorial acquisitions in the Western Hemisphere"
    },
    {
     "id": 1172023,
     "content_html": "an end to government reforms expanding voter participation"
    },
    {
     "id": 1172025,
     "content_html": "reforms strengthening business and financial regulations"
    },
    {
     "id": 1172022,
     "content_html": "America’s active intervention in World War I"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616015,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A historian might use this image to support the contention that",
   "answers": [
    {
     "id": 1172029,
     "content_html": "agreement on the goals and tactics of the Progressive movement proved difficult"
    },
    {
     "id": 1172028,
     "content_html": "the Democratic Party provided more popular progressive reforms than the Republicans"
    },
    {
     "id": 1172027,
     "content_html": "the public saw little benefit from progressive reforms before World War I"
    },
    {
     "id": 1172026,
     "content_html": "Progressive Era presidents exercised little leadership in setting reform agendas"
    }
   ],
   "hints": [],
