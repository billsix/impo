   "id": 615221,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In addition to engaging in fur trading, mountain men contributed to the development of the young nation by",
   "answers": [
    {
     "id": 1168856,
     "content_html": "establishing educational institutions to serve settlers who followed them west"
    },
    {
     "id": 1168857,
     "content_html": "exploring western territory and identifying alternate travel routes"
    },
    {
     "id": 1168855,
     "content_html": "serving as official U.S. ambassadors to the western Native American tribes"
    },
    {
     "id": 1168854,
     "content_html": "serving as cartographers who created detailed maps for the U.S. Army"
    }
