 "questions": [
  {
   "id": 615321,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The greatest impetus for whites pushing American Indians off their traditional territory was the",
   "answers": [
    {
     "id": 1169256,
     "content_html": "belief that American Indians were inferior and had no ability to work the land"
    },
    {
     "id": 1169257,
     "content_html": "desire for the land for development and the acquisition of wealth"
    },
    {
     "id": 1169255,
     "content_html": "belief that North America was destined to be a white continent, where enslaved African persons would work the land"
    },
    {
     "id": 1169254,
     "content_html": "belief that American Indians would be safer and happier in land west of the Mississippi River"
    }
   ],
