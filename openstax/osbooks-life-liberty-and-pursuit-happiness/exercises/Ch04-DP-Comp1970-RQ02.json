   "id": 615103,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The “assumption of debt” in Hamilton’s financial plan meant",
   "answers": [
    {
     "id": 1168385,
     "content_html": "the federal government would pay off all public debt from the American Revolution"
    },
    {
     "id": 1168384,
     "content_html": "the American people would need to assume their own debt"
    },
    {
     "id": 1168383,
     "content_html": "the federal government would sell bonds to fund the debt"
    },
    {
     "id": 1168382,
     "content_html": "the federal government would sell western land to pay off debt from the Revolution"
    }
   ],
