   "stem_html": "At the time of the Homestead Steel Strike, Henry Clay Frick was",
   "answers": [
    {
     "id": 1170588,
     "content_html": "president of the Amalgamated Association of Iron and Steel Workers"
    },
    {
     "id": 1170587,
     "content_html": "a member of the Pinkerton Detective Agency"
    },
    {
     "id": 1170589,
     "content_html": "in charge of operations of Andrew Carnegie’s Pittsburgh-area steel works"
    },
    {
     "id": 1170586,
     "content_html": "governor of the state of Pennsylvania and an ally of Andrew Carnegie"
    }
