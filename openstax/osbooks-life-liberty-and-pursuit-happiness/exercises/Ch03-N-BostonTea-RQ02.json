 "questions": [
  {
   "id": 614847,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best explains the justification for Parliament to pass the Intolerable Acts, or Coercive Acts?",
   "answers": [
    {
     "id": 1167361,
     "content_html": "Parliament was seeking financial retribution for the Seven Years’ War and the damages done to the colonies."
    },
    {
     "id": 1167360,
     "content_html": "The laws would ensure that customs officials would be treated with respect and deference."
    },
    {
     "id": 1167362,
     "content_html": "Parliament claimed the laws were necessary to punish the city for mob action and loss of property as a warning to other cities that Parliament would not be resisted."
    },
    {
     "id": 1167359,
     "content_html": "Parliament wanted to model proper British taxation laws and practices that the colonies would, in turn, adopt themselves."
    }
   ],
