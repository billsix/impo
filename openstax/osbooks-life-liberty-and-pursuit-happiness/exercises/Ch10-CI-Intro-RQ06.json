 "questions": [
  {
   "id": 615866,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Theodore Roosevelt’s expansion of federal regulatory power reflected his belief that",
   "answers": [
    {
     "id": 1171432,
     "content_html": "Congress’s power was constitutionally superior to that of other branches of government"
    },
    {
     "id": 1171431,
     "content_html": "the Supreme Court needed a national spokesperson to publicize its decisions"
    },
    {
     "id": 1171433,
     "content_html": "the executive branch could best create social stability and avert revolution"
    },
    {
     "id": 1171430,
     "content_html": "the federal bureaucracy needed to be severely curtailed to reflect the needs of the people"
    }
   ],
