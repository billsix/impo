   "id": 615731,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The main consideration for President Abraham Lincoln and his cabinet in deciding what to do about Fort Sumter was",
   "answers": [
    {
     "id": 1170892,
     "content_html": "the opportunity to begin a war to end the institution of slavery"
    },
    {
     "id": 1170893,
     "content_html": "the imperative to hold federal territory"
    },
    {
     "id": 1170891,
     "content_html": "an opening to begin a well-planned blockade of the South"
    },
    {
     "id": 1170890,
     "content_html": "a chance to act that would quickly gain popular support in the North"
    }
   ],
