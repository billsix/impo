   "stimulus_html": "",
   "stem_html": "Changes to the power of the Speaker of the House in 1910 led to",
   "answers": [
    {
     "id": 1171669,
     "content_html": "growing independence of individual members of Congress to report to their constituents"
    },
    {
     "id": 1171668,
     "content_html": "increased power for political parties in the House of Representatives"
    },
    {
     "id": 1171667,
     "content_html": "increased likelihood of passing major legislation with bipartisan support"
    },
    {
     "id": 1171666,
     "content_html": "growth in the overall power of Congress compared with that of the president"
    }
