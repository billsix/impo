   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The United States’ agreement to sign the treaty excerpted here most directly illustrates a foreign policy that",
   "answers": [
    {
     "id": 1172396,
     "content_html": "called for total isolation of the United States from world affairs"
    },
    {
     "id": 1172395,
     "content_html": "allowed U.S. diplomats to initiate objectives that were successful in maintaining world peace"
    },
    {
     "id": 1172397,
     "content_html": "gave the United States a role in world affairs without membership in the League of Nations"
    },
    {
     "id": 1172394,
     "content_html": "permitted the United States to unilaterally maintain world peace"
    }
