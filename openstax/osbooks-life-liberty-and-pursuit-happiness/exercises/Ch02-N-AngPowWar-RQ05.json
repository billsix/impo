 "questions": [
  {
   "id": 614663,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What happened to Anglo-Powhatan relations after the death of Opechancanough?",
   "answers": [
    {
     "id": 1166625,
     "content_html": "A state of war continued between the English and Powhatan for two more decades."
    },
    {
     "id": 1166624,
     "content_html": "The Powhatan eradicated the English colony."
    },
    {
     "id": 1166626,
     "content_html": "Opechancanough’s successor negotiated a peace treaty with the English."
    },
    {
     "id": 1166623,
     "content_html": "The English discovered gold on land they took from the Powhatan."
    }
   ],
