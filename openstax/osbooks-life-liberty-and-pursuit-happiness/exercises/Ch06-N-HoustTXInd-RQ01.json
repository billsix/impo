 "questions": [
  {
   "id": 615341,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the Mexican government welcome Americans to Texas during the 1820s?",
   "answers": [
    {
     "id": 1169336,
     "content_html": "The Mexican government approved of and encouraged Manifest Destiny."
    },
    {
     "id": 1169335,
     "content_html": "More workers were needed in the lucrative oil fields, and Mexico’s government hoped to profit from selling the oil."
    },
    {
     "id": 1169334,
     "content_html": "Mexico hoped to benefit from additional plantations based on the free labor of enslaved people."
    },
    {
     "id": 1169337,
     "content_html": "A larger population of people loyal to Mexico and obedient to Mexico’s laws would contribute to greater prosperity in the region."
    }
   ],
