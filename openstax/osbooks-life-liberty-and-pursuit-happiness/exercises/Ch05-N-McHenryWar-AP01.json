   "stem_html": "The sentiments expressed in the excerpt were mainly a response to",
   "answers": [
    {
     "id": 1168708,
     "content_html": "the rise of the Whig Party in the aftermath of the Era of Good Feelings"
    },
    {
     "id": 1168707,
     "content_html": "the failure of the Jeffersonian Republicans to achieve electoral success"
    },
    {
     "id": 1168709,
     "content_html": "American policy concerns resulting from the Napoleonic Wars"
    },
    {
     "id": 1168706,
     "content_html": "westward expansion in the aftermath of the Louisiana Purchase"
    }
   ],
