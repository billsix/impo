  },
  {
   "id": 615185,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The excerpt best reflects an effort by supporters to",
   "answers": [
    {
     "id": 1168712,
     "content_html": "follow the foreign policy recommendations of George Washington’s Farewell Address"
    },
    {
     "id": 1168713,
     "content_html": "reject the Federalist Party’s position on war with England"
    },
    {
     "id": 1168711,
     "content_html": "support the political aspirations of Andrew Jackson"
    },
    {
     "id": 1168710,
     "content_html": "encourage U.S. military support of the anti-monarchy forces of the French Revolution"
    }
   ],
