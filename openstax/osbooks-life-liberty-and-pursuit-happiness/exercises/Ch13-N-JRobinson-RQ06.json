   "id": 616358,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As his rookie season came to an end, Jackie Robinson’s experience in major league baseball",
   "answers": [
    {
     "id": 1173399,
     "content_html": "came to an end as he returned to the Negro Leagues"
    },
    {
     "id": 1173398,
     "content_html": "led him to leave the Brooklyn Dodgers to make more money with another team"
    },
    {
     "id": 1173397,
     "content_html": "forced his retirement from the sport"
    },
    {
     "id": 1173400,
     "content_html": "led to his being honored as the National League’s Rookie of the Year"
    }
   ],
