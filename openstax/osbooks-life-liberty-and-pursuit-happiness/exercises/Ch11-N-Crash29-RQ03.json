   "stimulus_html": "",
   "stem_html": "By 1932, the Great Depression had caused",
   "answers": [
    {
     "id": 1172300,
     "content_html": "the loss of 50 percent of all jobs in the country"
    },
    {
     "id": 1172301,
     "content_html": "massive underemployment across the country"
    },
    {
     "id": 1172299,
     "content_html": "the reelection of Herbert Hoover, who promised to end the crisis"
    },
    {
     "id": 1172298,
     "content_html": "the end of the Roosevelt administration, due to its failure to solve the problems"
    }
