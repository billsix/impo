 "questions": [
  {
   "id": 615609,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following occurred after the death of Lieutenant Colonel George Custer except",
   "answers": [
    {
     "id": 1170404,
     "content_html": "Sitting Bull was no longer recognized as chief"
    },
    {
     "id": 1170403,
     "content_html": "the U.S. government authorized the killing of more buffalo herds"
    },
    {
     "id": 1170405,
     "content_html": "the American Indians were forced to sign a revised Fort Laramie Treaty"
    },
    {
     "id": 1170402,
     "content_html": "Congress claimed ownership of the Black Hills for the United States"
    }
   ],
