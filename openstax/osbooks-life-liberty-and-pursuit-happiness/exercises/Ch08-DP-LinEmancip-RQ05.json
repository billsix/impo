 "questions": [
  {
   "id": 615801,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Lincoln waited until the fall of 1862 to issue the Emancipation Proclamation because",
   "answers": [
    {
     "id": 1171173,
     "content_html": "he had agreed to wait for a Union military victory"
    },
    {
     "id": 1171172,
     "content_html": "Congress was not yet in session"
    },
    {
     "id": 1171171,
     "content_html": "he had been waiting for the slaves to stage a rebellion"
    },
    {
     "id": 1171170,
     "content_html": "the border states petitioned him to wait"
    }
   ],
