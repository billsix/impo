   "id": 614549,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following does not describe the experience of Native Americans encountering Portuguese explorers and settlers in Brazil?",
   "answers": [
    {
     "id": 1166169,
     "content_html": "Forced labor in sugar mills in the coastal areas"
    },
    {
     "id": 1166170,
     "content_html": "Peaceful relations based on equitable trade of goods"
    },
    {
     "id": 1166168,
     "content_html": "Loss of land to individuals settling areas endowed to them by the government"
    },
    {
     "id": 1166167,
     "content_html": "Pursuit by slave raiders of those Native Americans fleeing to the interior"
    }
   ],
