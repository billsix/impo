   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was a major impetus for the social and political movement that inspired the excerpt?",
   "answers": [
    {
     "id": 1170772,
     "content_html": "Unlimited development of the steel industry in the East"
    },
    {
     "id": 1170773,
     "content_html": "Unfair treatment of farmers by the railroad companies"
    },
    {
     "id": 1170771,
     "content_html": "Unfair treatment of factory workers by the owner class"
    },
    {
     "id": 1170770,
     "content_html": "Unlimited immigration to the United States by southern and eastern Europeans"
    }
   ],
