     "id": 1170768,
     "content_html": "Antebellum reforms of the 1840s"
    },
    {
     "id": 1170767,
     "content_html": "Jacksonian Democrats’ platform of the 1820s and 1830s"
    },
    {
     "id": 1170769,
     "content_html": "Know Nothings of the 1850s"
    },
    {
     "id": 1170766,
     "content_html": "Anti-Masonic Party of the 1830s"
    }
   ],
