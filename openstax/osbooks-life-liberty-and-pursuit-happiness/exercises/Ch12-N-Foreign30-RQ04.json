   "id": 616213,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In an effort to aid the Allies despite isolationist sentiment in Congress at the start of World War II, President Franklin Roosevelt supported all the following except",
   "answers": [
    {
     "id": 1172819,
     "content_html": "negotiating a destroyers-for-naval bases deal with Great Britain"
    },
    {
     "id": 1172818,
     "content_html": "seeking to replace the “cash-carry” policy with “lend-lease”"
    },
    {
     "id": 1172817,
     "content_html": "engaging in personal diplomacy with the leader of Great Britain"
    },
    {
     "id": 1172820,
     "content_html": "sending American troops to reinforce British defenses"
    }
   ],
