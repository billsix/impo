   "stimulus_html": "",
   "stem_html": "Lincoln’s first political act, which demonstrated his hatred of slavery, was",
   "answers": [
    {
     "id": 1171156,
     "content_html": "formulating a bill to end slavery in the District of Columbia"
    },
    {
     "id": 1171155,
     "content_html": "pushing the Thirteenth Amendment through Congress"
    },
    {
     "id": 1171157,
     "content_html": "proposing a resolution in the Illinois legislature that included a denunciation of slavery"
    },
    {
     "id": 1171154,
     "content_html": "opening recruitment in the Union Army to black volunteers"
    }
