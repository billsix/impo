   "id": 614695,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Nathaniel Bacon carried out which of the following actions?",
   "answers": [
    {
     "id": 1166753,
     "content_html": "He returned to England to stand trial for treason."
    },
    {
     "id": 1166754,
     "content_html": "He burned the capital city of Jamestown."
    },
    {
     "id": 1166752,
     "content_html": "He demanded the colonial government cease its war against local American Indians."
    },
    {
     "id": 1166751,
     "content_html": "He attempted to return William Berkeley to the governorship of Virginia."
    }
   ],
