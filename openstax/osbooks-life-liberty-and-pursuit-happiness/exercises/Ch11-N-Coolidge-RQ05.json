   "stimulus_html": "",
   "stem_html": "In 1920, the Harding-Coolidge ticket was elected for all the following reasons except",
   "answers": [
    {
     "id": 1172244,
     "content_html": "voters’ desire to “return to normalcy”"
    },
    {
     "id": 1172243,
     "content_html": "a promise to secure law and order after a series of strikes and the Red Scare"
    },
    {
     "id": 1172242,
     "content_html": "a pledge to administer a more cautious government"
    },
    {
     "id": 1172245,
     "content_html": "voters’ desire to join the League of Nations"
    }
