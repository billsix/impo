   "id": 614768,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following religious groups was not protected by the Maryland Act of Toleration?",
   "answers": [
    {
     "id": 1167046,
     "content_html": "Jews"
    },
    {
     "id": 1167045,
     "content_html": "Puritans"
    },
    {
     "id": 1167044,
     "content_html": "Anglicans"
    },
    {
     "id": 1167043,
     "content_html": "Catholics"
    }
   ],
