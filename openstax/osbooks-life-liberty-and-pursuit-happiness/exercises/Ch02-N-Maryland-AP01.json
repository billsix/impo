  },
  {
   "id": 614769,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best summarizes the attitude toward religious beliefs expressed in the document provided?",
   "answers": [
    {
     "id": 1167050,
     "content_html": "Christians should be allowed to practice their faith without fear of persecution."
    },
    {
     "id": 1167049,
     "content_html": "Maryland was created as a haven for Catholics; thus only Catholicism is permitted there."
    },
    {
     "id": 1167048,
     "content_html": "Religion should be the basis for all political law in the colony."
    },
    {
     "id": 1167047,
     "content_html": "Uniformity of religion is required for a tranquil prosperous community."
    }
   ],
