   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Rwandan crisis presented a foreign policy crisis for President Clinton because it",
   "answers": [
    {
     "id": 1175460,
     "content_html": "deviated from the country’s long-standing containment policy"
    },
    {
     "id": 1175459,
     "content_html": "was the only African crisis the United States faced during his administration"
    },
    {
     "id": 1175458,
     "content_html": "dealt with Soviet influence in northern Africa"
    },
    {
     "id": 1175457,
     "content_html": "affirmed the United States’ willingness to intervene in civil wars"
    }
