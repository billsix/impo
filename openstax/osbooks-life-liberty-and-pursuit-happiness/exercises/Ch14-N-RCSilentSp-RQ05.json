   "id": 616614,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One long-term success of Earth Day, first celebrated in 1970, was that it",
   "answers": [
    {
     "id": 1173995,
     "content_html": "succeeded in eliminating the use of chemical pesticides in its first year"
    },
    {
     "id": 1173996,
     "content_html": "resulted in curricula being developed for environmental courses, raising nationwide environmental awareness"
    },
    {
     "id": 1173994,
     "content_html": "led to the establishment of a Cabinet-level Department of Environmental Conservation"
    },
    {
     "id": 1173993,
     "content_html": "doubled the size of the national park system"
    }
   ],
