   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In interpreting his own pollster’s data, President Carter believed",
   "answers": [
    {
     "id": 1174899,
     "content_html": "Americans wanted the United States to remain in the Vietnam War"
    },
    {
     "id": 1174900,
     "content_html": "many Americans felt the future was not theirs to make any longer"
    },
    {
     "id": 1174898,
     "content_html": "the federal government could solve most domestic problems"
    },
    {
     "id": 1174897,
     "content_html": "America could unilaterally handle all world crises, given the funding"
    }
   ],
