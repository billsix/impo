   "id": 614615,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the major cause of the sharp decline in American Indian populations after their first contact with the Europeans?",
   "answers": [
    {
     "id": 1166433,
     "content_html": "War with the Europeans\n"
    },
    {
     "id": 1166432,
     "content_html": "American Indians’ migration to other parts of the world\n"
    },
    {
     "id": 1166434,
     "content_html": "American Indians’ exposure to European diseases for which they had no immunity\n"
    },
    {
     "id": 1166431,
     "content_html": "An already small population that suffered no significant decline\n"
    }
