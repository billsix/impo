 "stimulus_html": "<figure id=\"BRI_APUSH_08_02_Vote\">\n<img src=\"exercises/media/713187b2e2f6d3ac.png\" alt=\"The illustration shows a line of black men standing under an American flag, waiting to cast their votes. Some of them are dressed in civilian clothes; others are in soldier uniforms.\">\n<figcaption>This political cartoon entitled “The First Vote” by Alfred R. Waud appeared in <i>Harper’s Weekly</i> on November 16, 1867.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 615818,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The right portrayed in the political cartoon was granted by",
   "answers": [
