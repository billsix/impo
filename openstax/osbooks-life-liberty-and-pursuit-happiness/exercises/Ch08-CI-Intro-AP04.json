     "id": 1171239,
     "content_html": "the ratification of the Fourteenth Amendment to the Constitution"
    },
    {
     "id": 1171241,
     "content_html": "the ratification of the Fifteenth Amendment to the Constitution"
    },
    {
     "id": 1171240,
     "content_html": "the passage of the Force Act in 1871"
    }
