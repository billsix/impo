   "id": 616252,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "By the time the United States attacked the Japanese on Iwo Jima in early 1945, American military planners",
   "answers": [
    {
     "id": 1172975,
     "content_html": "were preparing for a quick end to the war with the use of the atomic bomb"
    },
    {
     "id": 1172974,
     "content_html": "had rejected the unconditional surrender of Japan"
    },
    {
     "id": 1172973,
     "content_html": "were celebrating the end of the war in Europe months earlier"
    },
    {
     "id": 1172976,
     "content_html": "projected heavy casualties and a high cost to invading Japan"
    }
   ],
