 "is_vocab": false,
 "stimulus_html": "<figure>\n<img src=\"exercises/media/6bde8cdbcc2d4510.png\" alt=\"Caricature of a man striking another man with a club and pulling his scarf while horrified women look on.\">\n<figcaption>Caricature of a British press gang, 1780.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 615194,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on the image provided, what is the purpose of a press gang?",
   "answers": [
    {
     "id": 1168748,
     "content_html": "To punish publishers of disloyal American newspapers"
    },
    {
     "id": 1168747,
     "content_html": "To capture suspected French smugglers"
    },
    {
     "id": 1168749,
     "content_html": "To force sailors to join the British navy"
    },
    {
     "id": 1168746,
     "content_html": "To punish German women who acted as spies"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615195,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "By 1870, why was it considered necessary for the government to carry out the activity depicted in the image?",
   "answers": [
    {
     "id": 1168752,
     "content_html": "The Spanish government was desperate to draft more soldiers into its army."
    },
    {
     "id": 1168751,
     "content_html": "American publishers were conspiring against their local elected assemblies."
    },
    {
     "id": 1168750,
     "content_html": "French smugglers had caused terrible losses to the Americans."
    },
    {
     "id": 1168753,
     "content_html": "The British royal navy was dependent on this practice to maintain sufficient numbers of sailors."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615196,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "By 1812, which of these was a direct result of the practice depicted in the image?",
   "answers": [
    {
     "id": 1168757,
     "content_html": "The United States declared war on Great Britain."
    },
    {
     "id": 1168756,
     "content_html": "The British were the laughingstock of Europe."
    },
    {
     "id": 1168755,
     "content_html": "The British were able to reinforce their navy to maintain their position as the world’s most powerful empire."
    },
    {
     "id": 1168754,
     "content_html": "American military power forced the soundly defeated British to live up to their commitments in the treaty that had ended the Revolutionary War."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
