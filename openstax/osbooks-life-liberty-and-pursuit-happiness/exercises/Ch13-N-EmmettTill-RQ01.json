 "questions": [
  {
   "id": 616361,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the main reason African Americans left Mississippi for northern cities during the post–World War II years?",
   "answers": [
    {
     "id": 1173412,
     "content_html": "To escape poverty by getting jobs in factories"
    },
    {
     "id": 1173411,
     "content_html": "To establish homes for family members who would soon follow"
    },
    {
     "id": 1173410,
     "content_html": "To attend integrated universities"
    },
    {
     "id": 1173409,
     "content_html": "To purchase property, which was illegal for African Americans in Mississippi"
    }
   ],
