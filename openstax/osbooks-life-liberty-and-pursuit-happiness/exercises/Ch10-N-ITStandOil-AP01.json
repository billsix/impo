 "stimulus_html": "<figure>\n<img src=\"exercises/media/5184c1a2377d1f1a.png\" alt=\"The cartoon shows a Standard Oil tank as an octopus. Its tentacles reach out and wrap around the Capitol building, the state house, and workers in the copper and steel industries. One tentacle reaches for the white house.\">\n<figcaption>This 1904 cartoon by Udo Keppler appeared in <i>Puck</i> magazine.</figcaption>\n</figure>\n<p><i>Refer to the image provided. </i></p>",
 "questions": [
  {
   "id": 615977,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This political cartoon most directly reflected a growing belief that",
   "answers": [
    {
     "id": 1171876,
     "content_html": "increased voter participation was needed in urban government"
    },
    {
     "id": 1171877,
     "content_html": "public interests had become secondary to private interests"
    },
    {
     "id": 1171875,
     "content_html": "business practices led to ruination of the environment"
    },
    {
     "id": 1171874,
     "content_html": "government power had exceeded its constitutional limits"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615978,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which group would most directly support the point of view of this cartoon?",
   "answers": [
    {
     "id": 1171880,
     "content_html": "Advocates of social Darwinism"
    },
    {
     "id": 1171879,
     "content_html": "Radical Republicans of the post–Civil War era"
    },
    {
     "id": 1171881,
     "content_html": "Muckraking journalists of the Progressive Era"
    },
    {
     "id": 1171878,
     "content_html": "Nativists from the early twentieth century"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615979,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The point of view portrayed in this cartoon challenged what prevailing norm?",
   "answers": [
    {
     "id": 1171885,
     "content_html": "Public support for laissez-faire economic policies"
    },
    {
     "id": 1171884,
     "content_html": "Rural suspicion of the increasing urbanization of the North"
    },
    {
     "id": 1171883,
     "content_html": "Calls for increasing the political power of the citizen"
    },
    {
     "id": 1171882,
     "content_html": "Economic instability created by vast inequalities of wealth"
    }
   ],
