   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the state trial jury acquit Emmett Till’s killers?",
   "answers": [
    {
     "id": 1173415,
     "content_html": "The defense testimony was persuasive"
    },
    {
     "id": 1173414,
     "content_html": "Many blacks were present in the courtroom"
    },
    {
     "id": 1173416,
     "content_html": "White witnesses gave dishonest testimony"
    },
    {
     "id": 1173413,
     "content_html": "Till’s body was never found"
    }
