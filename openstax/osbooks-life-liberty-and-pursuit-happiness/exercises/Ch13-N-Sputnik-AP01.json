 "stimulus_html": "<figure>\n<img src=\"exercises/media/da2818029b5e99e6.png\" alt=\"The cartoon shows a blindfolded man labeled “US Science” struggling to pull two men, labeled “Unnecessary Government Secrecy” and “US Education Lag,” in a cart. In the background, a runner labeled “Russian Science” races ahead. The caption reads “Wonder why we’re not keeping pace?”\">\n<figcaption>“Wonder why we’re not keeping pace?” cartoon by Herbert Block, as it appeared in the <i>Washington Post</i>. (credit: A 1950 Herblock Cartoon, © The Herb Block Foundation)</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 616447,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The main idea expressed in the provided image revealed which of the following in the 1950s?",
   "answers": [
    {
     "id": 1173756,
     "content_html": "Government invested the most funding in a defense system based on conventional weapons."
    },
    {
     "id": 1173755,
     "content_html": "The United States did not fear the Soviet Union or a third world war."
    },
    {
     "id": 1173754,
     "content_html": "The federal government believed America was adequately prepared for any military action."
    },
    {
     "id": 1173753,
     "content_html": "The government feared the creation of a military-industrial complex."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616448,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An immediate response to the event depicted in the political cartoon was",
   "answers": [
    {
     "id": 1173759,
     "content_html": "a build-up of American military forces in Western Europe"
    },
    {
     "id": 1173760,
     "content_html": "the passage of the National Defense Education Act"
    },
    {
     "id": 1173758,
     "content_html": "the creation of the Interstate Highway system"
    },
    {
     "id": 1173757,
     "content_html": "reinforcement of the policy of containment"
    }
   ],
