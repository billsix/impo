 "stimulus_html": "<p>Population of the United States, 1830-1860</p>\n<table id=\"tab7_2\">\n<thead>\n<tr>\n<td>Census Year</td>\n<td>1830</td>\n<td>1840</td>\n<td>1850</td>\n<td>1860</td>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Total Population</td>\n<td>12,860,702</td>\n<td>17,063,353</td>\n<td>23,191,876</td>\n<td>31,443,321</td>\n</tr>\n<tr>\n<td>% Change over decade</td>\n<td>33.5</td>\n<td>32.7</td>\n<td>35.9</td>\n<td>35.6</td>\n</tr>\n<tr>\n<td>Total no. of states</td>\n<td>24</td>\n<td>26</td>\n<td>30</td>\n<td>33</td>\n</tr>\n</tbody>\n</table>\n<p>Immigration to the United States, 1820-1859</p>\n<table id=\"tab7_3\">\n<thead>\n<tr>\n<td>Years</td>\n<td>1820-1829</td>\n<td>1830-1839</td>\n<td>1840-1849</td>\n<td>1850-1859</td>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Total Immigration</td>\n<td>99,272</td>\n<td>422,771</td>\n<td>1,369,259</td>\n<td>2,619,680</td>\n</tr>\n<tr>\n<td>From Ireland</td>\n<td>51,617</td>\n<td>170,672</td>\n<td>656,145</td>\n<td>1,209,486</td>\n</tr>\n<tr>\n<td>From Germany</td>\n<td>5753</td>\n<td>124,726</td>\n<td>385,434</td>\n<td>976,072</td>\n</tr>\n</tbody>\n</table>\n<p><i>Refer to the tables provided.</i></p>\n",
 "questions": [
  {
   "id": 615422,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  population trend for the period 1830–1860 is seen in the two provided tables?",
   "answers": [
    {
     "id": 1169661,
     "content_html": "Population more than doubled over this period."
    },
    {
     "id": 1169660,
     "content_html": "The highest rate of increase occurred in the 1830s."
    },
    {
     "id": 1169659,
     "content_html": "Immigration primarily accounted for increase in population."
    },
    {
     "id": 1169658,
     "content_html": "Each new state brought in two million additional people."
    }
   ],
