 "questions": [
  {
   "id": 615092,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following correctly summarizes the views of Federalists and Jeffersonian-Republicans on the Naturalization Act (1798)?",
   "answers": [
    {
     "id": 1168340,
     "content_html": "Federalists disputed the Jeffersonian-Republicans’ claim that Congress had the power to establish rules for naturalization."
    },
    {
     "id": 1168339,
     "content_html": "Jeffersonian-Republicans were in favor of extending the naturalization period for immigrants, whereas Federalists were opposed."
    },
    {
     "id": 1168341,
     "content_html": "Federalists believed immigrants from France and Ireland might encourage war with Great Britain, whereas Jeffersonian-Republicans did not."
    },
    {
     "id": 1168338,
     "content_html": "Jeffersonian-Republicans wanted to reduce the naturalization period, whereas Federalists wanted to extend it."
    }
   ],
