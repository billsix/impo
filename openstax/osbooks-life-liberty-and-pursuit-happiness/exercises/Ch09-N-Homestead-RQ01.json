 "questions": [
  {
   "id": 615652,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Amalgamated Association of Iron and Steel Workers eventually called off the Homestead Strike because",
   "answers": [
    {
     "id": 1170576,
     "content_html": "Henry Clay Frick gave in to the demands of the workers"
    },
    {
     "id": 1170575,
     "content_html": "most of the striking workers were able to find better-paying jobs at other mills"
    },
    {
     "id": 1170574,
     "content_html": "Carnegie promised to provide AA with more negotiating power"
    },
    {
     "id": 1170577,
     "content_html": "AA lost the support of other unions in the face of government intervention in the strike"
    }
   ],
