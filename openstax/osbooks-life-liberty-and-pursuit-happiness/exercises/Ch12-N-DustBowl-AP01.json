   "stem_html": "When the excerpted song was written, the government",
   "answers": [
    {
     "id": 1172600,
     "content_html": "believed in providing welfare for all citizens"
    },
    {
     "id": 1172601,
     "content_html": "created programs to provide jobs and relief for those suffering in the Great Depression"
    },
    {
     "id": 1172599,
     "content_html": "required people to move where agricultural work could be offered"
    },
    {
     "id": 1172598,
     "content_html": "provided no assistance to the people"
    }
