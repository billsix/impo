 "questions": [
  {
   "id": 615072,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the main incentive for the invention of the cotton gin?",
   "answers": [
    {
     "id": 1168260,
     "content_html": "Soil was being rapidly depleted by tobacco and a more profitable crop was necessary."
    },
    {
     "id": 1168259,
     "content_html": "The slave population was growing rapidly and increased cotton production was required."
    },
    {
     "id": 1168258,
     "content_html": "Southern plantation owners needed to diversify to better use the crop rotation method."
    },
    {
     "id": 1168261,
     "content_html": "American planters wanted to profitably provide English textile mills with raw cotton."
    }
   ],
