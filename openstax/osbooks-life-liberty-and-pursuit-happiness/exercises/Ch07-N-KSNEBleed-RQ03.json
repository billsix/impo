   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One major consequence of the Kansas-Nebraska Act was that it",
   "answers": [
    {
     "id": 1169968,
     "content_html": "increased the number of slave states\n"
    },
    {
     "id": 1169967,
     "content_html": "reduced North-South tensions\n"
    },
    {
     "id": 1169969,
     "content_html": "led to the creation of the Republican Party\n"
    },
    {
     "id": 1169966,
     "content_html": "destroyed the Democratic Party\n"
    }
   ],
