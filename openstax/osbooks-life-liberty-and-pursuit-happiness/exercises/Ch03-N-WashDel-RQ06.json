 "questions": [
  {
   "id": 614865,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes one of the British military’s most important advantages?",
   "answers": [
    {
     "id": 1167433,
     "content_html": "Disciplined redcoats who fought using innovative tactics in the North American forests"
    },
    {
     "id": 1167432,
     "content_html": "Extensive popular support at home that allowed the British to wage continued war with confidence"
    },
    {
     "id": 1167434,
     "content_html": "A supreme naval force that successfully captured most colonial port cities without difficulty"
    },
    {
     "id": 1167431,
     "content_html": "A strong alliance with the French that gave the British much-needed monetary support and sea-patrolling power"
    }
   ],
