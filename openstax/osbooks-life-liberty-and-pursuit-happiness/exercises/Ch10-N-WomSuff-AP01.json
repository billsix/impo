 "stimulus_html": "<figure>\n<img src=\"exercises/media/d671ef94e302734f.png\" alt=\"The map is titled “Votes for Women a Success: North America proves it.” Each region in North America is labeled with the extent of suffrage given to women: Full Suffrage: Alaska, British Columbia, Alberta, Saskatchewan, Manitoba, Ontario, Washington, Oregon, California, Nevada, Utah, Arizona, Colorado, Montana, Idaho, Wyoming, Kansas. Presidential Suffrage: North Dakota, Nebraska, Illinois, Indiana, Michigan, Ohio, Rhode Island. Primary Suffrage: Arkansas. No Suffrage: Yukon, Northwest Territory, Quebec, Newfoundland, Nova Scotia, Maine, New Hampshire, Vermont, Massachusetts, New York, Connecticut, Pennsylvania, New Jersey, Delaware, Maryland, West Virginia, Virginia, North Carolina, South Carolina, Georgia, Florida, Alabama, Mississippi, Tennessee, Kentucky, Wisconsin, Minnesota, South Dakota, Iowa, Missouri, Louisiana, Oklahoma, Texas, New Mexico, Mexico, Central America. The caption at the bottom reads “The Canadian provinces of British Columbia, Alberta, Saskatchewan, and Manitoba extended full suffrage to their women in 1916. Ontario gave them full suffrage in March, 1917. How long will the Republic of the United States lag behind the Monarchy of Canada?”\">\n<figcaption>This map, published in 1917, contrasts the state of women’s suffrage throughout North America.</figcaption>\n</figure>\n<p><i>Refer to the image provided. </i></p>",
 "questions": [
  {
   "id": 615980,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This image reflects which continuity in American history?",
   "answers": [
    {
     "id": 1171888,
     "content_html": "Official restrictions on freedom of speech increase during wartime."
    },
    {
     "id": 1171889,
     "content_html": "Notions of national identity coexist with regional and group identities."
    },
    {
     "id": 1171887,
     "content_html": "Urban areas provide new cultural opportunities for city dwellers."
    },
    {
     "id": 1171886,
     "content_html": "Political corruption leads to calls for economic reform."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615981,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The trend demonstrated in the image was most directly shaped by",
   "answers": [
    {
     "id": 1171892,
     "content_html": "greater interest in politics along the frontier"
    },
    {
     "id": 1171891,
     "content_html": "new mass-communication technologies"
    },
    {
     "id": 1171893,
     "content_html": "multiple reasons to support expanded suffrage"
    },
    {
     "id": 1171890,
     "content_html": "opposition to American entry into World War I"
    }
   ],
   "hints": [],
