   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "John F. Kennedy wanted to focus on foreign policy in his inaugural speech primarily because",
   "answers": [
    {
     "id": 1173916,
     "content_html": "domestic policies divided Americans at home"
    },
    {
     "id": 1173915,
     "content_html": "there was a wide divergence of opinion regarding federal spending"
    },
    {
     "id": 1173914,
     "content_html": "the Cold War era was coming to an end"
    },
    {
     "id": 1173913,
     "content_html": "greater political divisions existed regarding the goals of American foreign policy"
    }
   ],
