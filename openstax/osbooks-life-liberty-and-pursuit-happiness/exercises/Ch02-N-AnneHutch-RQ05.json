   "stem_html": "What sentence was pronounced on Anne Hutchinson?",
   "answers": [
    {
     "id": 1166685,
     "content_html": "She was let off with a warning because it was her first offense."
    },
    {
     "id": 1166686,
     "content_html": "She was sentenced to be jailed and then banished from the colony."
    },
    {
     "id": 1166684,
     "content_html": "She was sentenced to be hanged."
    },
    {
     "id": 1166683,
     "content_html": "None; she died before a sentence could be pronounced."
    }
