   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the main goal of the War Democrats from the North?",
   "answers": [
    {
     "id": 1170920,
     "content_html": "To end the war immediately, allowing the Confederacy to remain outside the union"
    },
    {
     "id": 1170919,
     "content_html": "To emancipate the slaves"
    },
    {
     "id": 1170921,
     "content_html": "To restore the Union"
    },
    {
     "id": 1170918,
     "content_html": "To undermine the efforts of President Lincoln’s war policy"
    }
