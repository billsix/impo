   "id": 615760,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compared with white soldiers, black Union regiments typically",
   "answers": [
    {
     "id": 1171008,
     "content_html": "served in largely integrated units"
    },
    {
     "id": 1171007,
     "content_html": "served in segregated units, performing tasks similar to those of white soldiers"
    },
    {
     "id": 1171009,
     "content_html": "did menial labor at first but then fought for the Union"
    },
    {
     "id": 1171006,
     "content_html": "were usually sent into battle first to draw the fire of Confederate units"
    }
   ],
