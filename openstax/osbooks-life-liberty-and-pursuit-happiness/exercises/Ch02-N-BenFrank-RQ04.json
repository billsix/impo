   "id": 614726,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best describes Benjamin Franklin’s religious outlook?",
   "answers": [
    {
     "id": 1166877,
     "content_html": "He was a devout Catholic."
    },
    {
     "id": 1166876,
     "content_html": "He supported state-run religious institutions favoring a particular denomination."
    },
    {
     "id": 1166875,
     "content_html": "He rejected the philosophy of Enlightenment thinkers for traditional Protestant views."
    },
    {
     "id": 1166878,
     "content_html": "He was skeptical of organized religion and focused instead on moral virtue."
    }
   ],
