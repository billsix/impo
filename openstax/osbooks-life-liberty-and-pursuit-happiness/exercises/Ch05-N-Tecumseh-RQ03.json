   "stimulus_html": "",
   "stem_html": "The main goal of Tecumseh’s Confederacy was to unite Native American tribes",
   "answers": [
    {
     "id": 1168768,
     "content_html": "east and west of the Appalachian Mountains"
    },
    {
     "id": 1168767,
     "content_html": "to remove the British from their remaining forts in the Old Northwest Territory"
    },
    {
     "id": 1168769,
     "content_html": "against encroachment of American settlers"
    },
    {
     "id": 1168766,
     "content_html": "to create a separate state within the United States"
    }
