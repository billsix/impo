 "stimulus_html": "<figure id=\"fig7_36\">\n<img src=\"exercises/media/7230f69dd69275ec.png\" alt=\"Image of a harbor with boats in the water and soldiers lined up along the shore.\">\n<figcaption>This print depicts the first landing of U.S. representatives in Japan, under Commodore M.C. Perry at Gore-Hama on July 14, 1853.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>\n",
 "questions": [
  {
   "id": 615486,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The  events depicted reflected a growing belief that",
   "answers": [
    {
     "id": 1169916,
     "content_html": "rising sectional tensions would lead to a civil war between the slave and free states\n"
    },
    {
     "id": 1169915,
     "content_html": "the militarization of Japan was a threat to American interests in the Pacific\n"
    },
    {
     "id": 1169917,
     "content_html": "the addition of California to the United States would encourage Pacific economic trade\n"
    },
    {
     "id": 1169914,
     "content_html": "American expansionism should end at the continental borders\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615487,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The  events depicted in the provided image most directly led to",
   "answers": [
    {
     "id": 1169921,
     "content_html": "an end to Japanese isolation\n"
    },
    {
     "id": 1169920,
     "content_html": "improvement in U.S. diplomatic relations in China\n"
    },
    {
     "id": 1169919,
     "content_html": "the annexation of the Philippines\n"
    },
    {
     "id": 1169918,
     "content_html": "a great migration from Japan to the United States\n"
    }
   ],
