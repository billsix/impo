 "questions": [
  {
   "id": 614603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Groups seeking to discredit the idea that Montezuma made a rational decision to invite the Spanish into Tenochtitlan would use which of the following to support their argument?",
   "answers": [
    {
     "id": 1166386,
     "content_html": "Montezuma believed the Spanish to be gods.\n"
    },
    {
     "id": 1166385,
     "content_html": "Montezuma felt it would be best to meet the Spanish in his own city.\n"
    },
    {
     "id": 1166384,
     "content_html": "Montezuma believed he could convince the Spanish to become his allies.\n"
    },
    {
     "id": 1166383,
     "content_html": "Montezuma wanted to avoid outright war before gaining additional information about Spanish intentions.\n"
    }
   ],
