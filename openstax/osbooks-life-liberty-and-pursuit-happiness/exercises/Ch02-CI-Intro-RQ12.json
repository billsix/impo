   "id": 614645,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which best describes the impact European diseases had on Native American populations?",
   "answers": [
    {
     "id": 1166553,
     "content_html": "Native American people were able to develop immunities to these diseases after exposure."
    },
    {
     "id": 1166552,
     "content_html": "Native Americans and Europeans suffered from an exchange of diseases they were not used to."
    },
    {
     "id": 1166554,
     "content_html": "Native populations were decimated throughout the Americas."
    },
    {
     "id": 1166551,
     "content_html": "Europeans were able to develop treatment for these diseases thanks to assistance from Native American populations."
    }
