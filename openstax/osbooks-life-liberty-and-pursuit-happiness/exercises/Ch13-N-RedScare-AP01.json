     "id": 1173295,
     "content_html": "The policy of containment"
    },
    {
     "id": 1173294,
     "content_html": "The continuation of New Deal programs"
    },
    {
     "id": 1173296,
     "content_html": "The Red Scare"
    },
    {
     "id": 1173293,
     "content_html": "Racism in the South"
    }
   ],
