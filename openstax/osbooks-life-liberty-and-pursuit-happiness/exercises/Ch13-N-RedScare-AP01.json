     "id": 1173300,
     "content_html": "Multiple scandals during the Grant Administration"
    },
    {
     "id": 1173298,
     "content_html": "Reaction to labor unrest in the late nineteenth century"
    },
    {
     "id": 1173297,
     "content_html": "Theodore Roosevelt’s Progressive policies"
    }
