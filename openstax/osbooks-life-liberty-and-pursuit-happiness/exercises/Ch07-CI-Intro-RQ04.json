 "questions": [
  {
   "id": 615405,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  factor contributed to Abraham Lincoln’s election as president in 1860?",
   "answers": [
    {
     "id": 1169593,
     "content_html": "Lincoln’s popular support came from northern states with many Electoral College votes."
    },
    {
     "id": 1169592,
     "content_html": "The Democratic Party had lost support in the South after the <i>Dred Scott</i> case."
    },
    {
     "id": 1169591,
     "content_html": "Northern Democrats threw their support behind Lincoln and considered him a moderate."
    },
    {
     "id": 1169590,
     "content_html": "A third party, the Constitutional Union Party, pulled away key Democratic votes."
    }
   ],
