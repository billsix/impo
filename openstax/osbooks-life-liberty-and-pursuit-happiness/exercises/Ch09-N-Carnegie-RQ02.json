 "questions": [
  {
   "id": 615618,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Andrew Carnegie successfully used what strategy to build the most successful steel company in the world?",
   "answers": [
    {
     "id": 1170440,
     "content_html": "He resisted risky business innovation to stick with proven methods."
    },
    {
     "id": 1170439,
     "content_html": "He reinvested all his profits in business expansion as quickly as possible."
    },
    {
     "id": 1170441,
     "content_html": "He used consolidation to gain control of raw materials and reduce competition."
    },
    {
     "id": 1170438,
     "content_html": "He made wise investments with the family fortune he inherited."
    }
   ],
