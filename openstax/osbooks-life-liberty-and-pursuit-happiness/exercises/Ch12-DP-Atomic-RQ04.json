 "questions": [
  {
   "id": 616268,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement most accurately describes the Manhattan Project?",
   "answers": [
    {
     "id": 1173039,
     "content_html": "Its primary goal was the creation of a nuclear weapon to use against Nazi Germany."
    },
    {
     "id": 1173040,
     "content_html": "It relied on the work of scientists who had fled totalitarian regimes for the United States."
    },
    {
     "id": 1173038,
     "content_html": "The technology on which it depended was an open secret in scientific and military circles, with many nations engaging in a nuclear arms race."
    },
    {
     "id": 1173037,
     "content_html": "Only American citizens worked on the project, because of concerns about national security."
    }
   ],
