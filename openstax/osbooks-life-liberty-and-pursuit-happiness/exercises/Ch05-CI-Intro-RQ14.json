 "questions": [
  {
   "id": 615162,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best applies to slavery in the United States during the first quarter of the nineteenth century?",
   "answers": [
    {
     "id": 1168620,
     "content_html": "The greatest population density of slaves existed in the Mississippi Delta region."
    },
    {
     "id": 1168619,
     "content_html": "Federal prohibitions on the importation of slaves were ended by 1820."
    },
    {
     "id": 1168621,
     "content_html": "Agricultural expansion increased the value of slaves and frequency of their being traded in the domestic slave trade."
    },
    {
     "id": 1168618,
     "content_html": "Decreased slave resistance led to a lessening of state and local regulations."
    }
   ],
