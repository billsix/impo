   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Congress was able to charter a national bank by virtue of",
   "answers": [
    {
     "id": 1168169,
     "content_html": "the necessary and proper clause of the Constitution"
    },
    {
     "id": 1168168,
     "content_html": "the authority given to the judicial branch"
    },
    {
     "id": 1168167,
     "content_html": "a loose interpretation of the Constitution that called for a regulatory body over the U.S. economy"
    },
    {
     "id": 1168166,
     "content_html": "the authority given to the executive branch"
    }
   ],
