   "stimulus_html": "",
   "stem_html": "The Reagan Doctrine can best be described as",
   "answers": [
    {
     "id": 1175027,
     "content_html": "rejection of the post–World War II European boundaries"
    },
    {
     "id": 1175026,
     "content_html": "active effort to end the Cold War through international peacekeeping organizations"
    },
    {
     "id": 1175028,
     "content_html": "active support of anti-communist guerilla forces in multiple countries"
    },
    {
     "id": 1175025,
     "content_html": "pursuit of a foreign policy of peaceful coexistence with the Soviet Union and China"
    }
   ],
