 "questions": [
  {
   "id": 614811,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the British use the institution of slavery as a tool against the colonists in the Revolutionary War?",
   "answers": [
    {
     "id": 1167217,
     "content_html": "Southern slaveholders forced slaves to fight on their behalf."
    },
    {
     "id": 1167218,
     "content_html": "By promising freedom in exchange for slaves’ support, the British encouraged Patriots’ slaves to rebel against their owners."
    },
    {
     "id": 1167216,
     "content_html": "Slaves were captured and forced to haul goods and supplies for the British army."
    },
    {
     "id": 1167215,
     "content_html": "The British saw slavery as evil and motivated slaves to fight to abolish the institution in the colonies."
    }
   ],
