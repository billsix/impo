   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Under Spanish law, Native Americans were required to",
   "answers": [
    {
     "id": 1166258,
     "content_html": "attend church services and pay religious fees and taxes to support their conversion\n"
    },
    {
     "id": 1166257,
     "content_html": "share their Native American culture with the Spanish to create a coherent community\n"
    },
    {
     "id": 1166256,
     "content_html": "move their homes to Spanish-approved communities\n"
    },
    {
     "id": 1166255,
     "content_html": "marry Spaniards and support their families by working\n"
    }
   ],
