   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After the Battle of Antietam prevented a successful invasion of the Union, President Lincoln understood",
   "answers": [
    {
     "id": 1170925,
     "content_html": "the aim of the war must be changed to completely defeating the South"
    },
    {
     "id": 1170924,
     "content_html": "the focus of the war needed to change to keep the number of casualties down"
    },
    {
     "id": 1170923,
     "content_html": "General McClellan needed to change his strategy and become more aggressive in his battle tactics"
    },
    {
     "id": 1170922,
     "content_html": "Virginia must be captured to force a Confederate surrender"
    }
   ],
