 "questions": [
  {
   "id": 614655,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the significance of the House of Burgesses?",
   "answers": [
    {
     "id": 1166594,
     "content_html": "It was the first European representative body in the New World."
    },
    {
     "id": 1166593,
     "content_html": "It put an end to the “starving time” in the Jamestown colony."
    },
    {
     "id": 1166592,
     "content_html": "It rescued survivors from the Lost Colony of Roanoke."
    },
    {
     "id": 1166591,
     "content_html": "It ensured the establishment of Catholicism in the English colonies."
    }
   ],
