   "id": 616997,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Los Angeles African American communities of Watts and Compton were created as a result of",
   "answers": [
    {
     "id": 1175211,
     "content_html": "the exodus of former slaves during Reconstruction"
    },
    {
     "id": 1175210,
     "content_html": "the Great Migration out of the South in the early twentieth century"
    },
    {
     "id": 1175212,
     "content_html": "jobs opened up by massive military spending during World War II"
    },
    {
     "id": 1175209,
     "content_html": "the white flight out of the cities during the 1960s"
    }
   ],
