     "id": 1171401,
     "content_html": "give Congress authority over the president’s choice of cabinet members"
    },
    {
     "id": 1171400,
     "content_html": "give the Radical Republicans the ability to appoint the President’s cabinet"
    },
    {
     "id": 1171399,
     "content_html": "control the political actions of the executive branch"
    },
    {
     "id": 1171398,
     "content_html": "grant the presidential cabinet more authority"
    }
