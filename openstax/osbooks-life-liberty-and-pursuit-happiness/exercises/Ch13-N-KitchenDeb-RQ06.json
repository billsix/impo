    {
     "id": 1173679,
     "content_html": "“hot war”"
    },
    {
     "id": 1173680,
     "content_html": "attempt by both sides to win over the people of the developing world"
    },
    {
     "id": 1173678,
     "content_html": "propaganda ploy by the Soviet Union to persuade Western Europe to join its allies"
    },
    {
     "id": 1173677,
     "content_html": "battle of wits in the United Nations"
