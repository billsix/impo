 "questions": [
  {
   "id": 614927,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following components of the Articles of Confederation frustrated advocates of its reform?",
   "answers": [
    {
     "id": 1167680,
     "content_html": "The idea that the power belonged with the people of the United States"
    },
    {
     "id": 1167679,
     "content_html": "The government’s lack of a judicial mediating body"
    },
    {
     "id": 1167681,
     "content_html": "The requirement for unanimous agreement on any change to the document"
    },
    {
     "id": 1167678,
     "content_html": "The rule that politicians’ pay came from the states and not the federal government"
    }
   ],
