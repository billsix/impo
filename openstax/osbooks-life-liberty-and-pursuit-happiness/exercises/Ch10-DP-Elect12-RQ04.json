 "questions": [
  {
   "id": 615961,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the 1912 presidential campaign, Theodore Roosevelt’s view of trusts, compared with Woodrow Wilson’s, was",
   "answers": [
    {
     "id": 1171812,
     "content_html": "more supportive of breaking up all trusts in banking and finance"
    },
    {
     "id": 1171813,
     "content_html": "more lenient in that Roosevelt distinguished between good trusts and bad trusts"
    },
    {
     "id": 1171811,
     "content_html": "equally opposed to the existence of monopolies"
    },
    {
     "id": 1171810,
     "content_html": "more reliant on the regulatory powers of Congress"
    }
   ],
