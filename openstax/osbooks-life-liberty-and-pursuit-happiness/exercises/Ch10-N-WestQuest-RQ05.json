     "id": 1171588,
     "content_html": "the establishment of federal forest reserves"
    },
    {
     "id": 1171589,
     "content_html": "the creation of the U.S. Forest Service"
    },
    {
     "id": 1171587,
     "content_html": "the establishment of Yosemite National Park in California"
    },
    {
     "id": 1171586,
     "content_html": "the creation of Yellowstone National Park in Wyoming"
    }
