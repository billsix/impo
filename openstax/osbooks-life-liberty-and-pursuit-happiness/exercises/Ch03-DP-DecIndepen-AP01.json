    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615022,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following political ideas influenced the ideas expressed in the excerpts provided?",
   "answers": [
    {
     "id": 1168061,
     "content_html": "The right of people to participate in their government"
    },
    {
     "id": 1168060,
     "content_html": "The idea of following your dream"
    },
    {
     "id": 1168059,
     "content_html": "The right to worship freely without persecution"
    },
    {
     "id": 1168058,
     "content_html": "The idea that local and federal government must share power"
    }
   ],
