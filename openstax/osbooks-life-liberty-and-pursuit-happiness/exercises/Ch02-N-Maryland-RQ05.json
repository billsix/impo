   "stem_html": "From 1649 to1660, the rule of England under Oliver Cromwell",
   "answers": [
    {
     "id": 1166650,
     "content_html": "was based upon Puritan beliefs and discrimination against Catholics"
    },
    {
     "id": 1166649,
     "content_html": "granted religious freedom to all Christians in England"
    },
    {
     "id": 1166648,
     "content_html": "tolerated non-Puritans"
    },
    {
     "id": 1166647,
     "content_html": "reduced religious tensions in England and Ireland"
    }
   ],
