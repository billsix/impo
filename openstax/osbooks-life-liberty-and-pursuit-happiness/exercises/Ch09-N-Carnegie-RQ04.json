 "questions": [
  {
   "id": 615620,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which most accurately describes Andrew Carnegie’s charitable contribution to American society?",
   "answers": [
    {
     "id": 1170448,
     "content_html": "He left most of his fortune to his family and used the rest to build a university dedicated to medical studies."
    },
    {
     "id": 1170447,
     "content_html": "He set aside some of his fortune for the public welfare, mainly in education."
    },
    {
     "id": 1170449,
     "content_html": "He spent most of his fortune building libraries and museums and endowing other philanthropic endeavors."
    },
    {
     "id": 1170446,
     "content_html": "He bequeathed college scholarships to the children of his employees."
    }
   ],
