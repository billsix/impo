 "questions": [
  {
   "id": 614545,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was an outcome of the first expedition to the Americas led by Christopher Columbus?",
   "answers": [
    {
     "id": 1166153,
     "content_html": "Columbus led an expedition into the present-day United States."
    },
    {
     "id": 1166152,
     "content_html": "The first permanent settlement in North America was founded at St. Augustine."
    },
    {
     "id": 1166154,
     "content_html": "The expedition landed on the island of Hispaniola and engaged in trade with the native population."
    },
    {
     "id": 1166151,
     "content_html": "Columbus led Spanish troops in overthrowing the Aztecs in present-day Mexico."
    }
   ],
