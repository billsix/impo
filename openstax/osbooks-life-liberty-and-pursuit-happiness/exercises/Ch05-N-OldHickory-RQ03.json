   "id": 615189,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Securing access to New Orleans was of consistent national interest in early U.S. history because",
   "answers": [
    {
     "id": 1168728,
     "content_html": "winning the support of its demographically diverse population meant electoral victory"
    },
    {
     "id": 1168729,
     "content_html": "it served as an entryway to the major transportation network of the western portion of the United States"
    },
    {
     "id": 1168727,
     "content_html": "its natural defensive features presented a secure fortress against invaders"
    },
    {
     "id": 1168726,
     "content_html": "it served as a major destination for cotton cultivation"
    }
