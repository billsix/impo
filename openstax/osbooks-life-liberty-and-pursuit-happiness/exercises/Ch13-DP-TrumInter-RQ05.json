   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A lesson learned during World War II was that unchecked aggression often led to bigger, deadlier wars. One example of unchecked aggression was",
   "answers": [
    {
     "id": 1173531,
     "content_html": "“spilling of American blood on American soil” before the Mexican War"
    },
    {
     "id": 1173530,
     "content_html": "the sinking of the U.S.S. <i>Maine</i> in 1898"
    },
    {
     "id": 1173532,
     "content_html": "the German remilitarization of the Rhineland in 1936"
    },
    {
     "id": 1173529,
     "content_html": "the Japanese attack on Pearl Harbor in 1941"
    }
