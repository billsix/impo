   "stimulus_html": "",
   "stem_html": "Nat Turner is best characterized as",
   "answers": [
    {
     "id": 1169304,
     "content_html": "a runaway slave who arrived in Southampton County, Virginia, intent on leading a slave revolt"
    },
    {
     "id": 1169305,
     "content_html": "an enslaved preacher who led a revolt against slaveowners"
    },
    {
     "id": 1169303,
     "content_html": "an enslaved man who led the fight for abolition in Virginia"
    },
    {
     "id": 1169302,
     "content_html": "a free black man who encouraged local enslaved persons to revolt"
    }
   ],
