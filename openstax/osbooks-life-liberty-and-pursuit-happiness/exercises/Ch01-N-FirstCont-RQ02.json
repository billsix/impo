   "stimulus_html": "",
   "stem_html": "Portugal encouraged settlement of land in Brazil by endowing portions of land to individual <i>donatories</i>. These individuals could create and govern towns, levy taxes, and enslave native populations in return for",
   "answers": [
    {
     "id": 1166157,
     "content_html": "funding future explorations into South America"
    },
    {
     "id": 1166156,
     "content_html": "opening trade routes for French traders"
    },
    {
     "id": 1166155,
     "content_html": "establishing peaceful relationships with the surrounding Native Americans"
    },
    {
     "id": 1166158,
     "content_html": "financing the settlement of their endowed portions of land"
    }
   ],
