 "questions": [
  {
   "id": 615113,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which argument most directly supports George Washington’s reason for issuing the Proclamation of Neutrality?",
   "answers": [
    {
     "id": 1168425,
     "content_html": "The United States was unprepared to fight in a major European war."
    },
    {
     "id": 1168424,
     "content_html": "After his experience in the American Revolution, Washington became a pacifist."
    },
    {
     "id": 1168423,
     "content_html": "Washington needed to focus on Native American nations fighting settlers on the frontier."
    },
    {
     "id": 1168422,
     "content_html": "Washington feared another Shays’ Rebellion."
    }
   ],
