 "stimulus_html": "<figure>\n<img src=\"exercises/media/00c6e47869723357.png\" alt=\"Cannon smokes a cigar and holds a gavel while he stands behind a podium. He says, “The gentleman from Illinois is recognized!” The floor is crowded with representatives looking friendly with one another.\">\n<figcaption>This 1908 political cartoon of House Speaker Joseph Cannon is titled, “The House is in session according to the minority point of view.”</figcaption>\n</figure>\n<p><i>Refer to the image provided. </i></p>",
 "questions": [
  {
   "id": 615995,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This cartoon reflects the minority political party’s view that",
   "answers": [
    {
     "id": 1171949,
     "content_html": "the Speaker of the House controls all that occurs in the House"
    },
    {
     "id": 1171948,
     "content_html": "women should be granted the right to vote"
    },
    {
     "id": 1171947,
     "content_html": "political parties are losing power"
    },
    {
     "id": 1171946,
     "content_html": "the House of Representatives lacks party discipline"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615996,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The situation in the provided image most directly reflected a growing belief that",
   "answers": [
    {
     "id": 1171952,
     "content_html": "political reform needed to start at the city level"
    },
    {
     "id": 1171953,
     "content_html": "Progressive Era political reforms needed to give power to citizens"
    },
    {
     "id": 1171951,
     "content_html": "rural states held too much national political power"
    },
    {
     "id": 1171950,
     "content_html": "trusts were a part of American economic life"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615997,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was a direct result of the partisan events depicted in the cartoon?",
   "answers": [
    {
     "id": 1171956,
     "content_html": "Rejection of immigration restrictions on Southern and Eastern Europeans"
    },
    {
     "id": 1171955,
     "content_html": "Rejection of the Treaty of Versailles"
    },
    {
     "id": 1171957,
     "content_html": "Lessening of political party influence in Congress"
    },
    {
     "id": 1171954,
     "content_html": "Entry of the United States into World War I"
    }
   ],
