 "questions": [
  {
   "id": 615453,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why  was the Fugitive Slave Act of 1850 considered stricter than ones it replaced? ",
   "answers": [
    {
     "id": 1169784,
     "content_html": "It prevented slaveholders from pursuing runaway enslaved persons.\n"
    },
    {
     "id": 1169785,
     "content_html": "It provided for harsher punishment of those who helped runaway enslaved persons.\n"
    },
    {
     "id": 1169783,
     "content_html": "It meant that Northerners who assisted runaways would no longer be prosecuted.\n"
    },
    {
     "id": 1169782,
     "content_html": "Its provisions applied to the northern United States and Canada.\n"
    }
   ],
