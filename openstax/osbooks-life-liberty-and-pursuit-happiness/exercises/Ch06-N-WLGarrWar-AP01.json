   "id": 615331,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which assertion is most directly related to the Garrison letter to Ebenezer Dole?",
   "answers": [
    {
     "id": 1169297,
     "content_html": "Slavery violates the enslaved person’s inalienable rights to life, liberty, and the pursuit of happiness."
    },
    {
     "id": 1169296,
     "content_html": "Powers not delegated to the Constitution are reserved to the states or the people."
    },
    {
     "id": 1169295,
     "content_html": "People accused of crimes are entitled to a fair and speedy trial."
    },
    {
     "id": 1169294,
     "content_html": "It is the right of enslaved people to throw off a despotic form of government that does not provide for their security."
    }
   ],
