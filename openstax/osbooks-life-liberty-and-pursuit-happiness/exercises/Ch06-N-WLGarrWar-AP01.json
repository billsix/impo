   "stimulus_html": "",
   "stem_html": "The excerpt could be used as support for the idea that",
   "answers": [
    {
     "id": 1169292,
     "content_html": "slaves are treated more justly than prisoners"
    },
    {
     "id": 1169291,
     "content_html": "the life of a prisoner is similar to that of a slave in many important ways"
    },
    {
     "id": 1169293,
     "content_html": "it is better and more just to be imprisoned than to be enslaved"
    },
    {
     "id": 1169290,
     "content_html": "slaves and prisoners are usually mistreated in ways that violate the Founding principles of liberty and equality"
    }
   ],
