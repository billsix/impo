   ],
   "combo_choices": []
  },
  {
   "id": 614804,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes a long-term effect of King Philip’s War?",
   "answers": [
    {
     "id": 1167189,
     "content_html": "New England settlers began to rely more heavily on African slaves."
    },
    {
     "id": 1167190,
     "content_html": "American Indians began siding with the French in imperial conflicts."
    },
    {
     "id": 1167188,
     "content_html": "Most American Indian groups adopted a nomadic lifestyle to escape persecution."
    },
    {
     "id": 1167187,
     "content_html": "English governance grew more responsive to the needs of American Indians."
    }
   ],
