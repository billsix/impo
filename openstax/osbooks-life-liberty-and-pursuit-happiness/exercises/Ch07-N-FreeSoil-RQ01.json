  {
   "id": 615435,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Opponents  of slavery in the antebellum era were",
   "answers": [
    {
     "id": 1169712,
     "content_html": "united in the goal to totally abolish slavery in the United States\n"
    },
    {
     "id": 1169713,
     "content_html": "split over when and how to abolish slavery or limit its expansion\n"
    },
    {
     "id": 1169711,
     "content_html": "confined to the states that had been in the original New England colonies\n"
    },
    {
     "id": 1169710,
     "content_html": "unwilling to support the use of violent tactics to achieve their goals\n"
    }
   ],
