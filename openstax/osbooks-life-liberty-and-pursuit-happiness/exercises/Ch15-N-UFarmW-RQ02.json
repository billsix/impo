   "stimulus_html": "",
   "stem_html": "The law that allowed unions like the UFW to organize and negotiate with growers was",
   "answers": [
    {
     "id": 1174855,
     "content_html": "the 1935 National Labor Relations Act"
    },
    {
     "id": 1174856,
     "content_html": "the 1975 Agricultural Labor Relations Board Act"
    },
    {
     "id": 1174854,
     "content_html": "the Fourteenth Amendment"
    },
    {
     "id": 1174853,
     "content_html": "the court decision in the <i>UFW vs Bruce Church, Inc</i>. case"
    }
