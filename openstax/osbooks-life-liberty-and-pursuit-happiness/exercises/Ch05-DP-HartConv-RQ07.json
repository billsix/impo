   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a result of the Hartford Convention and its aftermath, the Federalist Party became",
   "answers": [
    {
     "id": 1169020,
     "content_html": "the politically dominant party in New England and the Old Northwest Territory"
    },
    {
     "id": 1169019,
     "content_html": "a formidable opponent of the rising Jacksonian Democrats"
    },
    {
     "id": 1169018,
     "content_html": "a signal that Hamiltonian forces dominated the national government"
    },
    {
     "id": 1169021,
     "content_html": "a political party with diminishing electoral support"
    }
   ],
