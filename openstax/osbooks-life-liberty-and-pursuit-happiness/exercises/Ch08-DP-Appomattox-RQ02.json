   "stimulus_html": "",
   "stem_html": "A major advantage Ulysses S. Grant held toward the end of the Civil War was",
   "answers": [
    {
     "id": 1171184,
     "content_html": "his knowledge of the terrain"
    },
    {
     "id": 1171183,
     "content_html": "enthusiastic public support for his strategy"
    },
    {
     "id": 1171185,
     "content_html": "the ability to better achieve his strategy by overwhelming force"
    },
    {
     "id": 1171182,
     "content_html": "control of the transportation system to move troops more quickly"
    }
