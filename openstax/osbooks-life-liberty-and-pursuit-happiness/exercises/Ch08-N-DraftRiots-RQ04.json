   "stimulus_html": "",
   "stem_html": "The term “Copperhead” was used to describe",
   "answers": [
    {
     "id": 1170972,
     "content_html": "men who avoided the draft"
    },
    {
     "id": 1170971,
     "content_html": "men who paid another to take their place in the draft"
    },
    {
     "id": 1170973,
     "content_html": "Northern opponents of the Civil War who were labeled traitors"
    },
    {
     "id": 1170970,
     "content_html": "men who took the place of drafted men"
    }
