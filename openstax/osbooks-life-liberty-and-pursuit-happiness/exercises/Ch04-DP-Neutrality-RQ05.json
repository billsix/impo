   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Genêt most clearly overstepped his role as ambassador from France when he",
   "answers": [
    {
     "id": 1168420,
     "content_html": "recruited twelve ships of privateers to fight for the French Republic"
    },
    {
     "id": 1168419,
     "content_html": "arrived in Charleston, South Carolina, to raise support for the French in their war against Great Britain"
    },
    {
     "id": 1168418,
     "content_html": "made a speech in Philadelphia criticizing the U.S. government"
    },
    {
     "id": 1168421,
     "content_html": "issued an ultimatum to President Washington demanding American support for France"
    }
