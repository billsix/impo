 "questions": [
  {
   "id": 614659,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The “headright system” established in 1616 by the Virginia Company of London is best described as",
   "answers": [
    {
     "id": 1166609,
     "content_html": "a poll tax on every member of the colony who had a say in choosing the people who ran the colony"
    },
    {
     "id": 1166610,
     "content_html": "a grant of 50 acres of land to people who paid for their own or someone else’s passage to Virginia"
    },
    {
     "id": 1166608,
     "content_html": "a tax on cattle, assessed “by head”"
    },
    {
     "id": 1166607,
     "content_html": "rights given to original colonists over those who came after 1616"
    }
   ],
