   "id": 615914,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A Central American canal in the Western Hemisphere was not completed until the early twentieth century because",
   "answers": [
    {
     "id": 1171624,
     "content_html": "there was little interest in building a canal before 1890"
    },
    {
     "id": 1171625,
     "content_html": "technological innovation and disease control were lacking"
    },
    {
     "id": 1171623,
     "content_html": "political upheaval in Latin America limited economic opportunities"
    },
    {
     "id": 1171622,
     "content_html": "railroad construction left little capital for canal building"
    }
   ],
