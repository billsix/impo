   "id": 615794,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The main decision in the <i>Slaughterhouse Cases</i> (1873) stated that",
   "answers": [
    {
     "id": 1171145,
     "content_html": "the Fourteenth Amendment did not expand federal power over the states"
    },
    {
     "id": 1171144,
     "content_html": "white supremacist organizations had a legal right to exist"
    },
    {
     "id": 1171143,
     "content_html": "African Americans did not have equal protection under the law"
    },
    {
     "id": 1171142,
     "content_html": "the Fifteenth Amendment did not apply to the various states"
    }
   ],
