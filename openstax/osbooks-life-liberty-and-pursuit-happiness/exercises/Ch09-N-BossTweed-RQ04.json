   "stimulus_html": "",
   "stem_html": "The Tweed Ring made most of its money from graft. One major example was",
   "answers": [
    {
     "id": 1170424,
     "content_html": "charging businesses money to protect them from crime bosses"
    },
    {
     "id": 1170423,
     "content_html": "unfairly taxing immigrants"
    },
    {
     "id": 1170425,
     "content_html": "inflating the cost of major city projects such as the courthouse"
    },
    {
     "id": 1170422,
     "content_html": "inflating the tolls charged to cross the Brooklyn Bridge"
    }
