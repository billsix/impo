   "stimulus_html": "",
   "stem_html": "As a result of the successful Montgomery Bus Boycott, Martin Luther King Jr. was",
   "answers": [
    {
     "id": 1173455,
     "content_html": "elected mayor of Montgomery"
    },
    {
     "id": 1173454,
     "content_html": "targeted as a terrorist and held in jail for the duration of the boycott"
    },
    {
     "id": 1173456,
     "content_html": "recognized as a new national voice for African American civil rights"
    },
    {
     "id": 1173453,
     "content_html": "made head pastor of his church"
    }
