   "id": 615061,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Southern representatives used all the following arguments to condemn the Quaker petition presented to the House of Representations in 1790 except",
   "answers": [
    {
     "id": 1168216,
     "content_html": "the Constitution supported noninterference with the institution until 1808"
    },
    {
     "id": 1168217,
     "content_html": "public support for slavery existed throughout the United States"
    },
    {
     "id": 1168215,
     "content_html": "slavery was economically necessary for the viability of the South’s agricultural industry"
    },
    {
     "id": 1168214,
     "content_html": "the Bible defended the use of slavery"
    }
   ],
