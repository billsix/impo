 "questions": [
  {
   "id": 614591,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why were European empires locked in a competition to discover the Northwest Passage?",
   "answers": [
    {
     "id": 1166337,
     "content_html": "It would provide a shortcut to the slave coast of Africa.\n"
    },
    {
     "id": 1166336,
     "content_html": "It would keep explorers safe from the threat of piracy.\n"
    },
    {
     "id": 1166335,
     "content_html": "It would ensure easier access to the trade winds for the return voyage to Europe.\n"
    },
    {
     "id": 1166338,
     "content_html": "It would provide a shortcut to the riches of the East Indies and China.\n"
    }
   ],
