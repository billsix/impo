     "id": 1173310,
     "content_html": "she had stolen atomic secrets from Los Alamos"
    },
    {
     "id": 1173309,
     "content_html": "she had recruited known communist Morton Sobell"
    },
    {
     "id": 1173312,
     "content_html": "prosecutors hoped to pressure her husband into confessing he was a spy"
    }
