 "questions": [
  {
   "id": 614664,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best describes the precedent established by interaction between the English and Powhatan during the first half of the seventeenth century?",
   "answers": [
    {
     "id": 1166629,
     "content_html": "Peace existed between the English and American Indians until American independence."
    },
    {
     "id": 1166628,
     "content_html": "The French began to take advantage of the hostile relationship between the English and American Indians."
    },
    {
     "id": 1166630,
     "content_html": "The English established a policy of domination over the American Indians that continued through the remainder of the Colonial Era."
    },
    {
     "id": 1166627,
     "content_html": "The English and American Indians began a lucrative trade relationship that led to English domination of North America."
    }
   ],
