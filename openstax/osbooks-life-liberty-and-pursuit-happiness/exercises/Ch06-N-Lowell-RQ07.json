 "questions": [
  {
   "id": 615712,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best describes the Lowell Girls in comparison to New England women that did not work in the mills?",
   "answers": [
    {
     "id": 1170817,
     "content_html": "Lowell Girls tended to marry much later than other women"
    },
    {
     "id": 1170816,
     "content_html": "After leaving the mills, Lowell Girls tended to return to farms"
    },
    {
     "id": 1170815,
     "content_html": "Lowell Girls tended to come from large towns prior to working in the mills"
    },
    {
     "id": 1170814,
     "content_html": "Many Lowell Girls worked in the mills under orders from their families"
    }
   ],
