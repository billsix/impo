 "questions": [
  {
   "id": 616309,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following motivated Harry Colmery when he originated the idea of the G.I. Bill?",
   "answers": [
    {
     "id": 1173203,
     "content_html": "American soldiers were underpaid and deserved more economic opportunities."
    },
    {
     "id": 1173204,
     "content_html": "Millions of returning soldiers in search of jobs at the same time would put too much pressure on the American economy."
    },
    {
     "id": 1173202,
     "content_html": "The impending Red Scare meant the nation had to maintain its military preparedness."
    },
    {
     "id": 1173201,
     "content_html": "Women were refusing to give up their factory jobs when the war was over."
    }
   ],
