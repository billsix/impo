 "questions": [
  {
   "id": 615445,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  best characterizes those who came to California during the gold rush?",
   "answers": [
    {
     "id": 1169752,
     "content_html": "They were family units looking to establish permanent settlements.\n"
    },
    {
     "id": 1169753,
     "content_html": "Most were men and white.\n"
    },
    {
     "id": 1169751,
     "content_html": "Women, African Americans, and Chinese settlers controlled most of the mining activity.\n"
    },
    {
     "id": 1169750,
     "content_html": "Because the gold rush attracted little international attention, there were few foreign miners."
    }
   ],
