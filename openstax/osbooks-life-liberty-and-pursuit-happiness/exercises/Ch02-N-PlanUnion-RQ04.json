 "questions": [
  {
   "id": 614732,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was unity among the colonies an elusive goal in the 1750s?",
   "answers": [
    {
     "id": 1166901,
     "content_html": "The lack of funding for a confederation made the plan impossible to carry out."
    },
    {
     "id": 1166902,
     "content_html": "Political and cultural differences among the colonies made union difficult."
    },
    {
     "id": 1166900,
     "content_html": "A pre-existing confederation among several of the states prohibited any further union."
    },
    {
     "id": 1166899,
     "content_html": "The colonists feared the British were encouraging unity to limit colonial power."
    }
   ],
