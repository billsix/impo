   "stimulus_html": "",
   "stem_html": "Leaders of the civil rights movement believed the main formula for attracting more sympathy from the media was to have",
   "answers": [
    {
     "id": 1174071,
     "content_html": "a large crowd of onlookers"
    },
    {
     "id": 1174072,
     "content_html": "peaceful protesters who were subjected to violence by defenders of Jim Crow laws"
    },
    {
     "id": 1174070,
     "content_html": "Dr. Martin Luther King Jr. personally involved in the protests"
    },
    {
     "id": 1174069,
     "content_html": "the support of the federal government"
    }
