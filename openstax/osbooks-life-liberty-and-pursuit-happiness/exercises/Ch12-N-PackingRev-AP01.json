  {
   "id": 616201,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The excerpt from Roosevelt’s fireside chat best reflects which continuity in U.S. history?",
   "answers": [
    {
     "id": 1172772,
     "content_html": "A belief in the democratic philosophy of the Declaration of Independence"
    },
    {
     "id": 1172771,
     "content_html": "The warning about political parties in George Washington’s Farewell Address"
    },
    {
     "id": 1172770,
     "content_html": "The belief in compromise, as demonstrated in the Compromise of 1850"
    },
    {
     "id": 1172769,
     "content_html": "The need to expand the electorate, as in the Fifteenth and Nineteenth amendments"
    }
   ],
