   "stem_html": "This excerpt was written in response to",
   "answers": [
    {
     "id": 1172767,
     "content_html": "the failure of New Deal legislation to solve the ills of the Great Depression"
    },
    {
     "id": 1172766,
     "content_html": "criticism of the New Deal by those on the left who felt it did not go far enough"
    },
    {
     "id": 1172765,
     "content_html": "conservative Republican members of Congress who tried to block New Deal bills"
    },
    {
     "id": 1172768,
     "content_html": "the Supreme Court’s ruling that a significant amount of New Deal legislation was unconstitutional"
    }
   ],
   "hints": [],
