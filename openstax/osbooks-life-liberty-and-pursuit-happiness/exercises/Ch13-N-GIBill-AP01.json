 "is_vocab": false,
 "stimulus_html": "<figure>\n<img src=\"exercises/media/5bb1afc1ed6d99ad.png\" alt=\"Men walk towards the door of a building. The poster reads “Veterans: prepare for your future through educational training. Consult your nearest office of the Veterans Administration.”\">\n<figcaption>A 1944 government poster informing soldiers about the G.I. Bill.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 616314,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The main intent of the poster at the provided link was to encourage",
   "answers": [
    {
     "id": 1173223,
     "content_html": "men to volunteer for military service"
    },
    {
     "id": 1173222,
     "content_html": "all men to receive a college education"
    },
    {
     "id": 1173224,
     "content_html": "men who served during the war to take advantage of their benefits"
    },
    {
     "id": 1173221,
     "content_html": "former soldiers to apply for a job in the Veterans Administration"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616315,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One of the major social outcomes of the sentiments expressed in the poster was that",
   "answers": [
    {
     "id": 1173228,
     "content_html": "millions of men were propelled into the middle class"
    },
    {
     "id": 1173227,
     "content_html": "the New Deal was no longer needed"
    },
    {
     "id": 1173226,
     "content_html": "government assistance for veterans became a bad investment"
    },
    {
     "id": 1173225,
     "content_html": "the government continued to be in a state of deficit spending"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616316,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the context of the poster?",
   "answers": [
    {
     "id": 1173231,
     "content_html": "Training for returning veterans was needed because the New Deal programs failed."
    },
    {
     "id": 1173232,
     "content_html": "Millions of returning soldiers needed education and job-training opportunities."
    },
    {
     "id": 1173230,
     "content_html": "The failures of the Bonus Army march were still fresh in the minds of Americans."
    },
    {
     "id": 1173229,
     "content_html": "Women needed job training because factories were closing down after the war."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
