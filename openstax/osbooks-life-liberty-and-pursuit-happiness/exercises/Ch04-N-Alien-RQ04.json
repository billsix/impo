   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jeffersonian-Republicans believed the Sedition Act was",
   "answers": [
    {
     "id": 1168348,
     "content_html": "a direct violation of the Fifth Amendment"
    },
    {
     "id": 1168349,
     "content_html": "meant to silence criticism of the Adams administration"
    },
    {
     "id": 1168347,
     "content_html": "necessary to protect national security in a time of war"
    },
    {
     "id": 1168346,
     "content_html": "essential to holding newspapers accountable for the truth of what they printed."
    }
