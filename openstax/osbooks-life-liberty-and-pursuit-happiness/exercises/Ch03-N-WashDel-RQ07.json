 "questions": [
  {
   "id": 614866,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How were many of the Continental army’s needs financed in the winter of 1777?",
   "answers": [
    {
     "id": 1167437,
     "content_html": "The Continental Congress was able to print colonial currency, which retained its value and supported the war effort."
    },
    {
     "id": 1167436,
     "content_html": "John and Samuel Adams collected donations for the war effort from colonists throughout New England."
    },
    {
     "id": 1167438,
     "content_html": "Robert Morris, a very wealthy merchant and a Patriot, provided for the army from his personal funds."
    },
    {
     "id": 1167435,
     "content_html": "The French assisted financially and militarily after the rebels’ stunning defeat at Trenton."
    }
   ],
