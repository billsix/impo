 "questions": [
  {
   "id": 615502,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A notable aspect of the creation of the Republican Party was that",
   "answers": [
    {
     "id": 1169980,
     "content_html": "it formed around the personality of one man, Abraham Lincoln\n"
    },
    {
     "id": 1169981,
     "content_html": "it formed as a party against the expansion of slavery\n"
    },
    {
     "id": 1169979,
     "content_html": "it was the first time a third party formed to address the slavery issue\n"
    },
    {
     "id": 1169978,
     "content_html": "its members came exclusively from areas outside the 13 original colonies\n"
    }
   ],
