   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is true?",
   "answers": [
    {
     "id": 1168162,
     "content_html": "The national bank created under the Articles of Confederation could not issue bank notes."
    },
    {
     "id": 1168165,
     "content_html": "Under the Constitution, the government could collect tax revenue ."
    },
    {
     "id": 1168163,
     "content_html": "The national bank created under the Articles of Confederation could not encourage private investment."
    },
    {
     "id": 1168164,
     "content_html": "Under the Constitution, the national bank was prohibited from investing money in private business ventures."
    }
