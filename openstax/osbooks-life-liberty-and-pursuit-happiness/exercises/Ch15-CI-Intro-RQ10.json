    {
     "id": 1174431,
     "content_html": "the creation of the Environmental Protection Agency"
    },
    {
     "id": 1174432,
     "content_html": "the creation of the National Endowment for the Humanities"
    },
    {
     "id": 1174430,
     "content_html": "a dramatic increase in Social Security payments"
    },
    {
     "id": 1174429,
     "content_html": "the creation of the Drug Enforcement Agency"
    }
