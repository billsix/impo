 "questions": [
  {
   "id": 615197,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A criticism the Indian tribes leveled against the Fort Wayne Treaty was that",
   "answers": [
    {
     "id": 1168760,
     "content_html": "generous prices were offered for the land"
    },
    {
     "id": 1168759,
     "content_html": "the tribes were united in their opposition to the treaty"
    },
    {
     "id": 1168761,
     "content_html": "William Henry Harrison’s maneuvering created dissension within the tribes"
    },
    {
     "id": 1168758,
     "content_html": "only Tecumseh and his brother Tenskwatawa supported it"
    }
   ],
