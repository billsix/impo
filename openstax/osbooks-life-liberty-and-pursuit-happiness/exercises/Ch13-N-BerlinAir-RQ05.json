   "stimulus_html": "",
   "stem_html": "Operation Little Vittles was",
   "answers": [
    {
     "id": 1173251,
     "content_html": "a temporary restart of the Berlin Airlift when the Soviet Union moved more troops into eastern Germany"
    },
    {
     "id": 1173250,
     "content_html": "an attempt to airlift supplies into parts of Eastern Europe to bring an end to Soviet occupation"
    },
    {
     "id": 1173249,
     "content_html": "the delivery of supplies to the Benelux nations to keep them securely on the side of the Western allies"
    },
    {
     "id": 1173252,
     "content_html": "the distribution of candy to the children of western Berlin during the Berlin crisis"
    }
   ],
