   "id": 616032,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compared with the Ku Klux Klan of the post-Civil War years, the Klan of the 1920s was",
   "answers": [
    {
     "id": 1172096,
     "content_html": "more restrictive about who could join"
    },
    {
     "id": 1172097,
     "content_html": "larger and more widespread, with more targets for its activities"
    },
    {
     "id": 1172095,
     "content_html": "less violent"
    },
    {
     "id": 1172094,
     "content_html": "more like a social organization than a militant group"
    }
   ],
