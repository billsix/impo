  },
  {
   "id": 615137,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Despite the change in the relationship between the United States and France, based on the excerpt, within the next decade, the two nations were able to",
   "answers": [
    {
     "id": 1168520,
     "content_html": "maintain their alliance during the War of 1812"
    },
    {
     "id": 1168521,
     "content_html": "complete a historical land sale that doubled the size of the United States"
    },
    {
     "id": 1168519,
     "content_html": "preserve an amiable trade relationship in the Caribbean"
    },
    {
     "id": 1168518,
     "content_html": "protect trans-Atlantic trade from the British navy"
    }
