     "id": 1168559,
     "content_html": "U.S. forces were removing American Indians from Ohio"
    },
    {
     "id": 1168561,
     "content_html": "the United States wanted to maintain trade relations with both Britain and France"
    },
    {
     "id": 1168558,
     "content_html": "the United States did not trust representatives of the French government"
    }
   ],
