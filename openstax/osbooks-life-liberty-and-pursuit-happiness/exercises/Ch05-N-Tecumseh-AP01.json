   "stem_html": "In the excerpt, Tecumseh had a goal of",
   "answers": [
    {
     "id": 1168788,
     "content_html": "establishing an Indian territory in the trans-Mississippi west, under the authority of the federal government"
    },
    {
     "id": 1168787,
     "content_html": "integrating Native Americans into the United States"
    },
    {
     "id": 1168789,
     "content_html": "asserting a Pan-Indian unity and strength to counter westward migration"
    },
    {
     "id": 1168786,
     "content_html": "relocating Native tribes from the United States into British-controlled Canada"
    }
   ],
