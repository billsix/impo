   "stem_html": "What was a direct result of the situation described in the excerpt?",
   "answers": [
    {
     "id": 1168792,
     "content_html": "Removal of the Cherokee Indians along the Trail of Tears"
    },
    {
     "id": 1168791,
     "content_html": "Establishment of Indian boarding schools, such as the one in Carlisle, Pennsylvania"
    },
    {
     "id": 1168790,
     "content_html": "Creation of reservations in the American Southwest and Great Basin"
    },
    {
     "id": 1168793,
     "content_html": "Armed conflict that led to the collapse of Tecumseh’s confederacy"
    }
   ],
