   "stimulus_html": "",
   "stem_html": "The Freedmen’s Bureau can best be described as an organization that",
   "answers": [
    {
     "id": 1170856,
     "content_html": "assisted in the redistribution of land to freed people in the South"
    },
    {
     "id": 1170857,
     "content_html": "aided former slaves and white refugees with legal and economic problems"
    },
    {
     "id": 1170855,
     "content_html": "provided a college education to all freed people"
    },
    {
     "id": 1170854,
     "content_html": "campaigned for the ratification of the Thirteenth, Fourteenth, and Fifteenth Amendments"
    }
