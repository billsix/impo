 "questions": [
  {
   "id": 615635,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following were reasons some Americans opposed Hawaiian annexation except",
   "answers": [
    {
     "id": 1170509,
     "content_html": "they supported the movement of the Hawaiian people to become an independent democratic nation"
    },
    {
     "id": 1170508,
     "content_html": "they believed annexation would be unconstitutional and violated American values"
    },
    {
     "id": 1170507,
     "content_html": "they believed the actions of the U.S. government toward the Hawaiian monarchy were unlawful"
    },
    {
     "id": 1170506,
     "content_html": "they believed the United States could enjoy the benefits of trade with Hawaii without the burdens of annexation"
    }
   ],
