 "questions": [
  {
   "id": 616089,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The most immediate reason for the demand made by war veterans in 1932 was that",
   "answers": [
    {
     "id": 1172325,
     "content_html": "they believed they deserved more pay for serving during the war and needed money"
    },
    {
     "id": 1172324,
     "content_html": "union workers then earned more money than American soldiers and Congress believed the soldiers deserved a bonus"
    },
    {
     "id": 1172323,
     "content_html": "the cost of living in America was rising"
    },
    {
     "id": 1172322,
     "content_html": "other Allied countries such as France provided money to their veterans"
    }
   ],
