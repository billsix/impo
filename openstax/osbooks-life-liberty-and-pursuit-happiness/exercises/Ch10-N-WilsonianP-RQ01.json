   "stimulus_html": "",
   "stem_html": "The federal income tax created in 1913 was meant to",
   "answers": [
    {
     "id": 1171676,
     "content_html": "transfer political power back to rural states"
    },
    {
     "id": 1171677,
     "content_html": "offset some of the revenue lost from lowered tariff rates"
    },
    {
     "id": 1171675,
     "content_html": "provide the majority of the funds needed for the federal government’s operating budget"
    },
    {
     "id": 1171674,
     "content_html": "redistribute wealth to the urban poor"
    }
   ],
