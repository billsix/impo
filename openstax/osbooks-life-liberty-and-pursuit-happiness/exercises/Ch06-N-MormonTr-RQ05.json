   "id": 615310,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Unlike some other religious sects founded during the Second Great Awakening, the Mormons",
   "answers": [
    {
     "id": 1169210,
     "content_html": "increased in population at a slow but steady rate"
    },
    {
     "id": 1169211,
     "content_html": "rejected the concept of tithing (i.e., a duty to give 10 percent of one’s income to the church)"
    },
    {
     "id": 1169212,
     "content_html": "merged with mainstream religious sects"
    },
    {
     "id": 1169213,
     "content_html": "migrated as a group to an area where they would be beyond the reach of the U.S. government"
    }
   ],
