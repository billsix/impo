 "questions": [
  {
   "id": 616058,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The political power of the Ku Klux Klan in the 1920s can be best described as having",
   "answers": [
    {
     "id": 1172200,
     "content_html": "most influence on local elections and no impact on national government"
    },
    {
     "id": 1172199,
     "content_html": "the power to keep African Americans and Catholics from voting in elections"
    },
    {
     "id": 1172198,
     "content_html": "almost no influence at all"
    },
    {
     "id": 1172201,
     "content_html": "the power to elect some members into key leadership positions, such as governorships and Senate seats"
    }
   ],
