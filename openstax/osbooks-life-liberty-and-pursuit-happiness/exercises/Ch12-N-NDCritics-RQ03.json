   "stimulus_html": "",
   "stem_html": "President Roosevelt’s critics from the left believed",
   "answers": [
    {
     "id": 1172656,
     "content_html": "New Deal policies had gone too far toward socialism"
    },
    {
     "id": 1172655,
     "content_html": "Roosevelt was unconstitutionally expanding the powers of the presidency"
    },
    {
     "id": 1172654,
     "content_html": "a massive redistribution of wealth would be upheld by the U.S. Supreme Court"
    },
    {
     "id": 1172657,
     "content_html": "the federal government was not doing enough to deal with the Great Depression"
    }
