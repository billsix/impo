 "questions": [
  {
   "id": 614731,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the British fear a failure of their alliance with the Iroquois?",
   "answers": [
    {
     "id": 1166897,
     "content_html": "Iroquois military strength was powerful enough to expel the British from their colonies."
    },
    {
     "id": 1166896,
     "content_html": "The British feared the Iroquois would enter into agreement with Spain."
    },
    {
     "id": 1166898,
     "content_html": "Britain could not afford to go to war with France without the assistance and/or neutrality of the Iroquois."
    },
    {
     "id": 1166895,
     "content_html": "Colonial government would be encouraged to rebel against British rule."
    }
   ],
