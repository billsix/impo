   "stimulus_html": "",
   "stem_html": "<p>1992 Presidential Election Results</p>\n<table>\n<thead>\n<tr>\n<td>Candidate</td>\n<td>Party</td>\n<td>No. of Electoral Votes</td>\n<td>No. of Popular Votes (%)</td>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>William J. Clinton</td>\n<td>Democratic</td>\n<td>370</td>\n<td>44,908,254 (43)</td>\n</tr>\n<tr>\n<td>George H. W. Bush</td>\n<td>Republican</td>\n<td>168</td>\n<td>39,102,343 (37.4)</td>\n</tr>\n<tr>\n<td>Ross Perot</td>\n<td>Independent</td>\n<td>0</td>\n<td>19,743,821 (18.9)</td>\n</tr>\n</tbody>\n</table>\n<p><i>Refer to the table provided.</i></p>\n<p>The information in the table best illustrates that</p>",
   "answers": [
    {
     "id": 1175263,
     "content_html": "foreign policy experience mattered most to voters"
    },
    {
     "id": 1175264,
     "content_html": "“It’s the economy, stupid” resonated with the voters"
    },
    {
     "id": 1175262,
     "content_html": "NAFTA had little impact on voter behavior"
    },
    {
     "id": 1175261,
     "content_html": "experience governing at the national level was an electoral advantage"
    }
   ],
