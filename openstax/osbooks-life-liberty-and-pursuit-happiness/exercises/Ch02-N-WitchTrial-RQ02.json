 "questions": [
  {
   "id": 614702,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How was the use of “spectral evidence” in trials of those accused as witches different in the New England colonies and in England?",
   "answers": [
    {
     "id": 1166782,
     "content_html": "In English law, spectral evidence was grounds for suspicion, not proof."
    },
    {
     "id": 1166781,
     "content_html": "There was no difference in the use of spectral evidence."
    },
    {
     "id": 1166780,
     "content_html": "Spectral evidence was not admissible in English courts."
    },
    {
     "id": 1166779,
     "content_html": "The issue of spectral evidence never came up in England."
    }
   ],
