 "questions": [
  {
   "id": 614909,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was an immediate cause of the growing unrest among Washington’s troops?",
   "answers": [
    {
     "id": 1167609,
     "content_html": "An anonymous address calling for a military coup had circulated throughout the camp."
    },
    {
     "id": 1167608,
     "content_html": "Washington punished his men for poor performance on the field, demoralizing them."
    },
    {
     "id": 1167607,
     "content_html": "Alexander Hamilton gave a fiery speech inspiring troops to overthrow the ineffective tyranny of Congress."
    },
    {
     "id": 1167606,
     "content_html": "Covert British actions led many troops to believe they would receive amnesty for their actions if they toppled the standing civic structure of the colonies."
    }
   ],
