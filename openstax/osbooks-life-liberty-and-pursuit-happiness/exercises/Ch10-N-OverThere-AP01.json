   "id": 616007,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This poster most directly reflects",
   "answers": [
    {
     "id": 1171996,
     "content_html": "the need for mobilization of wartime industries"
    },
    {
     "id": 1171995,
     "content_html": "an effort to increase the number of enlisted servicemen"
    },
    {
     "id": 1171997,
     "content_html": "encouragement to buy defense bonds to finance the war effort"
    },
    {
     "id": 1171994,
     "content_html": "promotion of women in the wartime workforce"
    }
