   "id": 614637,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "England’s Queen Elizabeth I created military and political tension with Spain when she",
   "answers": [
    {
     "id": 1166522,
     "content_html": "refused to recognize Spanish claims to all North American territory"
    },
    {
     "id": 1166521,
     "content_html": "established English colonies in Mexico and South America"
    },
    {
     "id": 1166520,
     "content_html": "supported the Catholic Church over the oppositions of the Protestant reformers"
    },
    {
     "id": 1166519,
     "content_html": "sanctioned privateers such as Walter Raleigh to attack English ships on behalf of Spain"
    }
   ],
