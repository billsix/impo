 "questions": [
  {
   "id": 615251,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following represents the constitutional question at the center of the <i>Marbury v. Madison</i> case?",
   "answers": [
    {
     "id": 1168974,
     "content_html": "Could President Jefferson or Congress ask for a writ of mandamus to keep Marbury from his commission?"
    },
    {
     "id": 1168977,
     "content_html": "Was a law duly enacted by Congress but inconsistent with the U.S. Constitution valid?"
    },
    {
     "id": 1168975,
     "content_html": "Could President Jefferson and Secretary of State Madison refuse to give Marbury his commission?"
    },
    {
     "id": 1168976,
     "content_html": "Was John Marshall’s “midnight appointment” as chief justice of the Supreme Court valid?"
    }
   ],
