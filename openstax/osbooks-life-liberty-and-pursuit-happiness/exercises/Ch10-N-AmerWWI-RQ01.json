 "questions": [
  {
   "id": 615939,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The U.S. government did not take a side at the outset of World War I because",
   "answers": [
    {
     "id": 1171725,
     "content_html": "America’s large immigrant population had ties to both the Allies and the Central powers"
    },
    {
     "id": 1171724,
     "content_html": "America’s banking and trading interests overwhelming favored the Central powers"
    },
    {
     "id": 1171723,
     "content_html": "the U.S. government had little diplomatic interest in Western Europe"
    },
    {
     "id": 1171722,
     "content_html": "Americans expected the war to last for many years and cause millions of deaths"
    }
   ],
