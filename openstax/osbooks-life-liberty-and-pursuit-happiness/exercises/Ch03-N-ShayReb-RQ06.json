 "questions": [
  {
   "id": 614884,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why wasn’t the federal government able to support Massachusetts in putting down Shays’ Rebellion?",
   "answers": [
    {
     "id": 1167509,
     "content_html": "The federal government lacked the funds to gather and send troops to New England."
    },
    {
     "id": 1167508,
     "content_html": "The Articles of Confederation explicitly stated a national militia was forbidden."
    },
    {
     "id": 1167507,
     "content_html": "Shays’ supporters infiltrated the federal legislative branch and thwarted attempts to put down the rebellion."
    },
    {
     "id": 1167506,
     "content_html": "Washington’s Continental Army was accepting the surrender of the British and couldn’t risk splitting troops."
    }
   ],
