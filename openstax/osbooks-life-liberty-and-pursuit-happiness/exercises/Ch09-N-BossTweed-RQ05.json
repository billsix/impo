   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the late nineteenth century, Thomas Nast was best known as",
   "answers": [
    {
     "id": 1170428,
     "content_html": "a political opponent of William Tweed’s who served as governor of New York"
    },
    {
     "id": 1170427,
     "content_html": "a critic of the Tweed Ring who published exposés about Boss Tweed"
    },
    {
     "id": 1170426,
     "content_html": "an immigrant who was helped by Tweed and went on to a successful political career"
    },
    {
     "id": 1170429,
     "content_html": "a critic of Tweed who sketched political cartoons exposing his corruption"
    }
   ],
