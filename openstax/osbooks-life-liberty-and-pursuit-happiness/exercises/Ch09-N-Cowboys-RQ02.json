 "questions": [
  {
   "id": 615624,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the trail drives between 1867 and 1887?",
   "answers": [
    {
     "id": 1170464,
     "content_html": "Cowboys faced constant danger from Indian attack and rustlers."
    },
    {
     "id": 1170463,
     "content_html": "Drovers developed a meritocratic culture blind to racial difference."
    },
    {
     "id": 1170465,
     "content_html": "Cowboys endured harsh conditions and frequent boredom."
    },
    {
     "id": 1170462,
     "content_html": "Cowboys received high wages and as much beef as they could eat."
    }
   ],
