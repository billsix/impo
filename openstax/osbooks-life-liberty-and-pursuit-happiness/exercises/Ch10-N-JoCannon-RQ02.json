   "stimulus_html": "",
   "stem_html": "Progressives believed the effect political parties had on government was",
   "answers": [
    {
     "id": 1171656,
     "content_html": "neutral, because party loyalty did not translate to political power"
    },
    {
     "id": 1171657,
     "content_html": "negative, because political parties drew power away from the people"
    },
    {
     "id": 1171655,
     "content_html": "positive, because political parties best represented the people’s wishes"
    },
    {
     "id": 1171654,
     "content_html": "negative, because the state legislatures selected members of the House of Representatives"
    }
