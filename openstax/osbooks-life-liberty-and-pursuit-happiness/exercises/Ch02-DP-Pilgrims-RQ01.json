 "questions": [
  {
   "id": 614746,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The label “Puritan” describes",
   "answers": [
    {
     "id": 1166958,
     "content_html": "Protestants who desired to “purify” the Church of England of all traces of Catholic teachings by working from within"
    },
    {
     "id": 1166957,
     "content_html": "those in England who opposed the progress of the Protestant Reformation"
    },
    {
     "id": 1166956,
     "content_html": "those in England who embraced all the changes made by the Lutheran Church in Germany and wanted to bring them to England"
    },
    {
     "id": 1166955,
     "content_html": "those in England who wanted England to remain a loyal subject of the pope in Rome"
    }
   ],
