   "stimulus_html": "",
   "stem_html": "The government’s handling of the Bonus Army March in 1932 helped guarantee that",
   "answers": [
    {
     "id": 1172332,
     "content_html": "Americans would support the Bonus Marchers’ demands"
    },
    {
     "id": 1172331,
     "content_html": "Congress would pass the legislation as demanded"
    },
    {
     "id": 1172333,
     "content_html": "President Herbert Hoover would lose his reelection bid"
    },
    {
     "id": 1172330,
     "content_html": "Republicans would gain control of Congress"
    }
