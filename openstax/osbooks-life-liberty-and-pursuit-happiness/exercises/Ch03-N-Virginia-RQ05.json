 "questions": [
  {
   "id": 614877,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best explains how the idea of religious freedom evolved in Virginia?",
   "answers": [
    {
     "id": 1167481,
     "content_html": "Over many years, the idea of having an established church gave way to the idea of no established church, then to tolerating multiple churches, and finally to having no government interference whatsoever."
    },
    {
     "id": 1167480,
     "content_html": "From the start of the colony, many protested an established religion, and it was overthrown during the Revolution."
    },
    {
     "id": 1167479,
     "content_html": "After the disestablishment of a state-sponsored church, Virginia ensured its residents would remain devout by creating tax incentives for them to support a church of their choice."
    },
    {
     "id": 1167478,
     "content_html": "As early as 1619, the Virginia Act of Religious Toleration promised the opportunity for any Christian to worship, which was extended to members of other religions after the Revolution."
    }
   ],
