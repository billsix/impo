 "questions": [
  {
   "id": 614704,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was the conviction rate of accused witches in Salem so high?",
   "answers": [
    {
     "id": 1166790,
     "content_html": "People were not hanged if they confessed, so many confessed to save their own lives."
    },
    {
     "id": 1166789,
     "content_html": "Many people genuinely believed they were witches."
    },
    {
     "id": 1166788,
     "content_html": "Many people were actually engaging in various witch rituals."
    },
    {
     "id": 1166787,
     "content_html": "Salem Village had an unusually large population."
    }
   ],
