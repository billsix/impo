   "id": 615954,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Migration of southern African American sharecroppers increased dramatically in the early twentieth century because",
   "answers": [
    {
     "id": 1171784,
     "content_html": "their skills transferred easily to northern factories"
    },
    {
     "id": 1171783,
     "content_html": "they followed the progress of the boll weevil northward"
    },
    {
     "id": 1171785,
     "content_html": "they sought to escape economic hardship"
    },
    {
     "id": 1171782,
     "content_html": "they saved enough to purchase their own homes"
    }
   ],
