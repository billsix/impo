   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During most of the Vietnam War period, the general student population of Kent State University was considered",
   "answers": [
    {
     "id": 1174519,
     "content_html": "more radical than most"
    },
    {
     "id": 1174520,
     "content_html": "largely middle-class and apolitical"
    },
    {
     "id": 1174518,
     "content_html": "unusually outspoken on social issues"
    },
    {
     "id": 1174517,
     "content_html": "among the last all-white groups at a public university"
    }
   ],
