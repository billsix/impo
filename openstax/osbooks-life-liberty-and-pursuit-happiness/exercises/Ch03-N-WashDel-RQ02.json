 "questions": [
  {
   "id": 614861,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was not a difficulty faced by Washington in the winter of 1777?",
   "answers": [
    {
     "id": 1167417,
     "content_html": "Enlistments were expiring and Washington was struggling to keep a functioning militia."
    },
    {
     "id": 1167416,
     "content_html": "The military as underfunded and had no money to offer for enlistment extensions or to purchase adequate supplies."
    },
    {
     "id": 1167415,
     "content_html": "Lack of supplies meant that soldiers were hungry, shoeless, and vulnerable to sickness."
    },
    {
     "id": 1167418,
     "content_html": "Through poor leadership, Washington led his militia into multiple battles they couldn’t win, suffering many casualties."
    }
   ],
