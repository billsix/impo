   "stimulus_html": "",
   "stem_html": "Japan’s imperial expansion in China and Asia in the 1930s was driven by all the following except",
   "answers": [
    {
     "id": 1172856,
     "content_html": "fears that the communists would seize power in China"
    },
    {
     "id": 1172855,
     "content_html": "a desire to secure vital natural resources"
    },
    {
     "id": 1172854,
     "content_html": "resentment against American and European influence in the region"
    },
    {
     "id": 1172853,
     "content_html": "assumptions of Japanese racial superiority over the peoples of Asia"
    }
   ],
