 "questions": [
  {
   "id": 615605,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Fort Laramie Treaty of 1851 largely provided for",
   "answers": [
    {
     "id": 1170388,
     "content_html": "the creation of Indian reservations across the United States, restricting American Indians’ access to land that belonged to settlers populating the west"
    },
    {
     "id": 1170387,
     "content_html": "the Transcontinental Railroad to be built across American Indian territory"
    },
    {
     "id": 1170389,
     "content_html": "the guarantee that settlers would be allowed to safely cross American Indian territory on their way westward"
    },
    {
     "id": 1170386,
     "content_html": "the assimilation of American Indians into European-American culture"
    }
   ],
