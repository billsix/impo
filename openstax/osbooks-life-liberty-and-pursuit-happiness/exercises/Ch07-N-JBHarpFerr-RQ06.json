 "questions": [
  {
   "id": 615523,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<figure id=\"fig7_52\">\n<img src=\"exercises/media/b3a885a523393cba.png\" alt=\"Image of a man meeting a female slave holding a child. A flag behind him reads, “Sig Semper Tyrannis.” Other men surround the scene.\">\n<figcaption>This image from 1863 depicts John Brown meeting an enslaved woman on the steps of the Charlestown courthouse. He is on his way to execution after being convicted of treason. The drawing was originally captioned: “Regarding with a look of compassion a Slave-mother and Child who obstructed the passage on his way to the Scaffold. --Capt. Brown stooped and kissed the Child--then met his fate.”</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>\n<p>By the time this illustration was made, the popular view of John Brown</p>",
   "answers": [
    {
     "id": 1170064,
     "content_html": "had not changed because most Americans considered him mentally unstable\n"
    },
    {
     "id": 1170063,
     "content_html": "had moderated because most Americans viewed him as a flawed human being\n"
    },
    {
     "id": 1170062,
     "content_html": "had declined as people came to realize the horrors of the Civil War\n"
    },
    {
     "id": 1170065,
     "content_html": "had become more positive because many viewed Brown as a hero for the abolitionist cause\n"
    }
   ],
