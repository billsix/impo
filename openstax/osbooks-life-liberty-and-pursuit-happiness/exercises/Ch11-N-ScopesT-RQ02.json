  {
   "id": 616072,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In regard to the Scopes trial, William Jennings Bryan believed all the following except",
   "answers": [
    {
     "id": 1172256,
     "content_html": "the Bible’s account of creation was accurate"
    },
    {
     "id": 1172257,
     "content_html": "John T. Scopes had the right to freedom of speech in the classroom"
    },
    {
     "id": 1172255,
     "content_html": "other states should pass laws similar to the Butler Law"
    },
    {
     "id": 1172254,
     "content_html": "he himself was meant to serve as the preeminent defender of the Christian faith"
    }
   ],
