 "questions": [
  {
   "id": 615377,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes Frederick Douglass’s childhood?",
   "answers": [
    {
     "id": 1169480,
     "content_html": "He was raised by his mother on a tobacco plantation and knew few of his other relatives."
    },
    {
     "id": 1169479,
     "content_html": "He was raised by his parents on a small farm, where he worked side by side with the family of the farm’s owner."
    },
    {
     "id": 1169478,
     "content_html": "He was raised by his master and mistress on a cotton plantation, where he was granted more privileges than an enslaved person typically received."
    },
    {
     "id": 1169481,
     "content_html": "He was raised by his grandmother and never knew the identity of his father."
    }
   ],
