   "stimulus_html": "",
   "stem_html": "The Louisiana Purchase is consistent with Jeffersonian-Republican philosophy because it",
   "answers": [
    {
     "id": 1168657,
     "content_html": "allowed for the expansion of an agrarian America"
    },
    {
     "id": 1168656,
     "content_html": "provided a specific constitutional method for acquiring new territory"
    },
    {
     "id": 1168655,
     "content_html": "promised the expansion of slavery into the western territories"
    },
    {
     "id": 1168654,
     "content_html": "drew the United States closer to a declaration of war against Great Britain"
    }
