   "id": 615390,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Like John Quincy Adams, David Walker most directly used what to support his argument?",
   "answers": [
    {
     "id": 1169532,
     "content_html": "The major tenets of the Constitution"
    },
    {
     "id": 1169531,
     "content_html": "Enlightenment arguments of the natural rights of man"
    },
    {
     "id": 1169533,
     "content_html": "The natural rights principles of the Declaration of Independence"
    },
    {
     "id": 1169530,
     "content_html": "The Bill of Rights"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615391,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "With which of these statements would John Quincy Adams and David Walker most likely have agreed?",
   "answers": [
    {
     "id": 1169536,
     "content_html": "The U.S. government must immediately and radically abolish slavery in all its forms throughout the country."
    },
    {
     "id": 1169535,
     "content_html": "The three-fifths clause of the Constitution should be repealed by executive order to eliminate the “slave power” of the South."
    },
    {
     "id": 1169537,
     "content_html": "Because all humans are created equal, all persons possess the right to have their petitions to Congress accepted and given meaningful consideration."
    },
    {
     "id": 1169534,
     "content_html": "Blacks must take responsibility for their liberation into their own hands and work against the institution of slavery by any means necessary, including violence."
    }
   ],
