  {
   "id": 615742,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "General Robert E. Lee’s invasion of Pennsylvania in 1863 differed from his invasion of Maryland in 1862 in that Lee",
   "answers": [
    {
     "id": 1170936,
     "content_html": "had a larger army in 1862"
    },
    {
     "id": 1170935,
     "content_html": "had a better sense of where the enemy was in 1863"
    },
    {
     "id": 1170937,
     "content_html": "ignored the garrison at Harpers Ferry in 1863"
    },
    {
     "id": 1170934,
     "content_html": "had just won a victory over a Union army in 1862"
    }
   ],
