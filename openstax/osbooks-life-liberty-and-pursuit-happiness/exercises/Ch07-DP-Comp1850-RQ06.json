   "id": 615567,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In contrast to the provisions of the Missouri Compromise of 1820, the Compromise of 1850 ",
   "answers": [
    {
     "id": 1170237,
     "content_html": "applied to territory within the Mexican Cession\n"
    },
    {
     "id": 1170236,
     "content_html": "created a new line marking the border between slave and free states at 54°40′\n"
    },
    {
     "id": 1170235,
     "content_html": "allowed for the possible creation of both slave and free states\n"
    },
    {
     "id": 1170234,
     "content_html": "did not receive any southern support\n"
    }
   ],
