   "stimulus_html": "",
   "stem_html": "A major result of the Treaty of Greenville was that",
   "answers": [
    {
     "id": 1168276,
     "content_html": "American Indian nations were forced onto reservations"
    },
    {
     "id": 1168275,
     "content_html": "the British were forced from their forts in the Great Lakes region"
    },
    {
     "id": 1168277,
     "content_html": "other American Indian nations began to adopt the civilization policy"
    },
    {
     "id": 1168274,
     "content_html": "more warfare occurred between the United States and American Indian nations"
    }
