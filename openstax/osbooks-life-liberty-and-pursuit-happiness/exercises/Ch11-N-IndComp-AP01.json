 "stimulus_html": "<figure id=\"BRI_APUSH_11_03_Assembly\" class=\"scaled-down-70\">\n<img src=\"exercises/media/e6c64de6aef91601.png\" alt=\"A row of men stand next to a conveyer belt filled with a line of wheels. Each man adds a different piece to the wheel, and the progression is seen across the photograph. Boxes of materials are under the belt.\">\n<figcaption>An automobile factory during the early part of the twentieth century is shown.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 616112,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes events depicted in this photograph?",
   "answers": [
    {
     "id": 1172416,
     "content_html": "Skilled labor was increasingly valued in factories."
    },
    {
     "id": 1172415,
     "content_html": "Unsanitary working conditions led to the rise of labor unions."
    },
    {
     "id": 1172414,
     "content_html": "Poor working conditions led to the publication of exposés like <i>The Jungle</i>."
    },
    {
     "id": 1172417,
     "content_html": "The assembly line increased production and profitability."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616113,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Manufacturing strategies such as those used in the photo were first successfully implemented in the automobile industry by",
   "answers": [
    {
     "id": 1172420,
     "content_html": "Alfred P. Sloan"
    },
    {
     "id": 1172419,
     "content_html": "William Durant"
    },
    {
     "id": 1172421,
     "content_html": "Henry Ford"
    },
    {
     "id": 1172418,
     "content_html": "Eli Whitney"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616114,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A historian might use this image to support which historical claim?",
   "answers": [
    {
     "id": 1172425,
     "content_html": "New manufacturing techniques led to increased production of consumer goods."
    },
    {
     "id": 1172424,
     "content_html": "The U.S. population centers were shifting toward rural areas."
    },
    {
     "id": 1172423,
     "content_html": "Episodes of credit and market instability led to the Great Depression."
    },
    {
     "id": 1172422,
     "content_html": "Migration to large cities led to the industrial revolution."
    }
   ],
