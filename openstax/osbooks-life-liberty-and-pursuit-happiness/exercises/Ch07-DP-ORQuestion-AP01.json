   "id": 615559,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "This excerpt challenged which prevailing assumption about westward expansion?",
   "answers": [
    {
     "id": 1170204,
     "content_html": "Westward expansion captured American national interest in the nineteenth century.\n"
    },
    {
     "id": 1170203,
     "content_html": "Territorial settlement was intertwined with foreign policy.\n"
    },
    {
     "id": 1170202,
     "content_html": "Economic advancement motivated migrants.\n"
    },
    {
     "id": 1170205,
     "content_html": "Interest in settling California began with the gold rush.\n"
    }
   ],
