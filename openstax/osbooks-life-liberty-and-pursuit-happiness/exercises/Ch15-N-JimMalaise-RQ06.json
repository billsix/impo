   "stimulus_html": "",
   "stem_html": "Overall, President Carter’s “malaise speech”",
   "answers": [
    {
     "id": 1174908,
     "content_html": "was initially accepted by Americans, but came to hurt his chances of reelection"
    },
    {
     "id": 1174907,
     "content_html": "was accepted by the American people, helping to turn around a slow economy"
    },
    {
     "id": 1174906,
     "content_html": "was rejected by the American people outright as a hurtful and elitist speech"
    },
    {
     "id": 1174905,
     "content_html": "was reluctantly approved by Americans but the solutions proposed in it failed"
    }
