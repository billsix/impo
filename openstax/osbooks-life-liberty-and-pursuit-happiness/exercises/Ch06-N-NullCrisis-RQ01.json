   "id": 615295,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The purpose of a protective tariff is to",
   "answers": [
    {
     "id": 1169152,
     "content_html": "create a system of international trade based upon free trade, fair deals, and mutually profitable relationships with other countries"
    },
    {
     "id": 1169151,
     "content_html": "protect industries in one state from those in another"
    },
    {
     "id": 1169150,
     "content_html": "provide regulation of imported goods"
    },
    {
     "id": 1169153,
     "content_html": "make sure domestically made products have a marketplace advantage over similar foreign products"
    }
   ],
