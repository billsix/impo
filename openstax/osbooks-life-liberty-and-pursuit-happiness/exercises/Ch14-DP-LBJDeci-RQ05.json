  {
   "id": 616790,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "South Vietnam did not commit to a decision at the 1968 peace talks, because",
   "answers": [
    {
     "id": 1174384,
     "content_html": "it was awaiting the results of the U.S. election"
    },
    {
     "id": 1174383,
     "content_html": "it refused to take a seat alongside the North Vietnamese"
    },
    {
     "id": 1174382,
     "content_html": "the United States had dramatically increased bombing of Laos and Cambodia"
    },
    {
     "id": 1174381,
     "content_html": "President Johnson had withdrawn U.S. troops from Vietnam"
    }
   ],
