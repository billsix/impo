   "stimulus_html": "",
   "stem_html": "President Wilson’s policies resembled Theodore Roosevelt’s New Nationalism because Wilson",
   "answers": [
    {
     "id": 1171685,
     "content_html": "expanded the regulatory bureaucracy of the U.S. government"
    },
    {
     "id": 1171684,
     "content_html": "prosecuted the same trusts as Roosevelt"
    },
    {
     "id": 1171683,
     "content_html": "signed executive orders dismantling the major trusts"
    },
    {
     "id": 1171682,
     "content_html": "supported internationalism"
    }
   ],
