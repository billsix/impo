   "stimulus_html": "",
   "stem_html": "In vetoing the recharter of the Bank of the United States, Andrew Jackson expressed his disapproval of which Supreme Court decision?",
   "answers": [
    {
     "id": 1169572,
     "content_html": "<i>Marbury v. Madison</i>"
    },
    {
