   "id": 615401,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the motivation for the event described in the excerpts?",
   "answers": [
    {
     "id": 1169577,
     "content_html": "A disagreement over the proper interpretation and use of the president’s veto power"
    },
    {
     "id": 1169576,
     "content_html": "The failure of the agricultural industry, due to the lack of available funding"
    },
    {
     "id": 1169575,
     "content_html": "Clay’s desire for a political victory to match Jackson’s winning of the Nullification Crisis"
    },
    {
     "id": 1169574,
     "content_html": "Lingering animosity between Clay and Jackson over the “Corrupt Bargain” in the election of 1824"
    }
