   "stimulus_html": "",
   "stem_html": "Henry Ford temporarily closed his factories in 1927 because",
   "answers": [
    {
     "id": 1172220,
     "content_html": "the Great Depression created a massive downturn in the economy"
    },
    {
     "id": 1172219,
     "content_html": "the Ford “Model T” became mechanically obsolete"
    },
    {
     "id": 1172218,
     "content_html": "Ford Motor Company was hit with a major strike"
    },
    {
     "id": 1172221,
     "content_html": "he needed to resolve how to deal with competition from General Motors"
    }
   ],
