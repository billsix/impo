   "id": 615073,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did Secretary of War Henry Knox suggest to President George Washington in regard to American treatment of American Indians?",
   "answers": [
    {
     "id": 1168264,
     "content_html": "That the government begin assigning American Indians to reservations"
    },
    {
     "id": 1168263,
     "content_html": "That the government continue fighting American Indians"
    },
    {
     "id": 1168262,
     "content_html": "That the United States create a strong trade relationship with all American Indians nations"
    },
    {
     "id": 1168265,
     "content_html": "That the United States treat American Indians as sovereign nations"
    }
   ],
