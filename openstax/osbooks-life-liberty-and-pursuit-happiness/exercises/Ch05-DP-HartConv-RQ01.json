   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The amendments proposed by the Hartford Convention included provisions to",
   "answers": [
    {
     "id": 1168996,
     "content_html": "limit New England’s ability to win electoral victories"
    },
    {
     "id": 1168997,
     "content_html": "limit the power of Congress to declare war"
    },
    {
     "id": 1168995,
     "content_html": "increase the power of Congress to admit new states into the Union"
    },
    {
     "id": 1168994,
     "content_html": "apply the Three-Fifths Compromise to all the states in the Union"
    }
   ],
