   "stem_html": "The Atlantic slave trade",
   "answers": [
    {
     "id": 1166305,
     "content_html": "brought more slaves to the sugar-producing colonies than to any other area\n"
    },
    {
     "id": 1166306,
     "content_html": "was supported in part by freed slaves who became slave owners themselves\n"
    },
    {
     "id": 1166304,
     "content_html": "brought more slaves to the British colonies than to the Caribbean\n"
    },
    {
     "id": 1166303,
     "content_html": "reached its height in the early 1600s\n"
    }
