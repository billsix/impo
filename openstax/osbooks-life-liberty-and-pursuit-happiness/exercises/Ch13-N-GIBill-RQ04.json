  {
   "id": 616311,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A major difference between the G.I. Bill and the first veterans’ pension bill after the Civil War was that the G.I. Bill",
   "answers": [
    {
     "id": 1173211,
     "content_html": "offered fewer options for returning soldiers"
    },
    {
     "id": 1173210,
     "content_html": "opened a shorter window of time during which a veteran could receive benefits"
    },
    {
     "id": 1173209,
     "content_html": "provided benefits to all veterans who had a job"
    },
    {
     "id": 1173212,
     "content_html": "allowed veterans to take out a low-interest small business or home-ownership loan"
    }
   ],
