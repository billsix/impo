  {
   "id": 616396,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best explains the risk in the United States–led invasion at Inchon?",
   "answers": [
    {
     "id": 1173551,
     "content_html": "The garrisoned North Korean soldiers stationed at Inchon were elite forces."
    },
    {
     "id": 1173550,
     "content_html": "The Soviets threatened retaliation with nuclear weapons."
    },
    {
     "id": 1173549,
     "content_html": "There was a growing belief that MacArthur was hiding an alcohol problem."
    },
    {
     "id": 1173552,
     "content_html": "The tides made it hard for an invading force to land."
    }
   ],
