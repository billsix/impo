     "id": 1169580,
     "content_html": "The Louisiana Purchase"
    },
    {
     "id": 1169581,
     "content_html": "The annexation of territory belonging to Mexico"
    },
    {
     "id": 1169579,
     "content_html": "The acquisition of the Hawaiian Islands"
    },
    {
     "id": 1169578,
     "content_html": "War with Great Britain"
