   "stimulus_html": "",
   "stem_html": "The CIO challenged the organizing philosophy of the American Federation of Labor (AFL) because the CIO",
   "answers": [
    {
     "id": 1172705,
     "content_html": "organized workers along industrial rather than craft lines"
    },
    {
     "id": 1172704,
     "content_html": "supported Republican rather than Democratic candidates for elected office"
    },
    {
     "id": 1172703,
     "content_html": "organized rural rather than urban areas"
    },
    {
     "id": 1172702,
     "content_html": "represented more women than men"
    }
