     "id": 1170736,
     "content_html": "Progressives in major cities"
    },
    {
     "id": 1170735,
     "content_html": "the mainstream American press"
    },
    {
     "id": 1170734,
     "content_html": "northern states"
    },
    {
     "id": 1170737,
     "content_html": "the African American community"
    }
   ],
