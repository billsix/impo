 "questions": [
  {
   "id": 614838,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following does not describe a significant effect of the Stamp Act Congress?",
   "answers": [
    {
     "id": 1167325,
     "content_html": "It was one of the first intercolonial cooperative congressional bodies."
    },
    {
     "id": 1167324,
     "content_html": "Its plea to the king contributed to the successful repeal of the Stamp Act."
    },
    {
     "id": 1167323,
     "content_html": "Its Declaration of Rights formed a basis for later colonial protest."
    },
    {
     "id": 1167326,
     "content_html": "It represented a turning point in history when the colonists united in their resolution to separate from Great Britain."
    }
   ],
