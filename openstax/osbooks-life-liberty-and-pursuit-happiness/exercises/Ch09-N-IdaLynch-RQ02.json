     "id": 1170488,
     "content_html": "an unfortunate by-product of Jim Crow legislation"
    },
    {
     "id": 1170487,
     "content_html": "immoral and should be made illegal"
    },
    {
     "id": 1170489,
     "content_html": "needed to preserve the social order"
    },
    {
     "id": 1170486,
     "content_html": "no different from any type of murder"
    }
