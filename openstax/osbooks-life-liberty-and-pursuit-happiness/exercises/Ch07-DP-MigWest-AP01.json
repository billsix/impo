 "stimulus_html": "<figure id=\"fig7_59\">\n<img src=\"exercises/media/36e4f1a190772c34.png\" alt=\"(a) Cover of the book Seth Jones; or, The Captives of the Frontier by Edward S. Ellis (1860), showing a man with a gun. (b) Cover of the book The Black Princess, showing two men (one appears to be American Indian) fighting.\">\n<figcaption>(a) Cover of <i>Seth Jones; or, The Captives of the Frontier</i> by Edward S. Ellis (1860). (b) Cover of a dime novel published in 1860 entitled <i>The Black Princess.</i></figcaption>\n</figure>\n<p><i>Refer to the images provided.</i></p>",
 "questions": [
  {
   "id": 615543,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Publication of novels such as those in the images provided encouraged",
   "answers": [
    {
     "id": 1170140,
     "content_html": "an increase in abolitionist sentiment \n"
    },
    {
     "id": 1170139,
     "content_html": "reform movements to improve the status of American Indians\n"
    },
    {
     "id": 1170138,
     "content_html": "a decrease in overall migration to the western territories\n"
    },
    {
     "id": 1170141,
     "content_html": "the popular view of a romanticized West\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615544,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The images provided best represent what continuity in U.S. history?",
   "answers": [
    {
     "id": 1170144,
     "content_html": "The relative scarcity of women on the frontier allowed for greater equality.\n"
    },
    {
     "id": 1170143,
     "content_html": "Escape from religious persecution was a powerful motivation for emigration.\n"
    },
    {
     "id": 1170145,
     "content_html": "The frontier held allure as a place for adventure.\n"
    },
    {
     "id": 1170142,
     "content_html": "Men often emigrated first and sent for their families later.\n"
    }
   ],
