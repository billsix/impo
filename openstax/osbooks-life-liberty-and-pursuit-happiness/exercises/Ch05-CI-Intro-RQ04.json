 "questions": [
  {
   "id": 615152,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Thomas Jefferson’s election in 1800 can most accurately be described as",
   "answers": [
    {
     "id": 1168580,
     "content_html": "a repudiation of French interference in American politics"
    },
    {
     "id": 1168579,
     "content_html": "surprising given Jefferson’s monarchical bearing and elitist manners"
    },
    {
     "id": 1168578,
     "content_html": "limited in scope, because Jeffersonian-Republican victories did not extend beyond the presidency"
    },
    {
     "id": 1168581,
     "content_html": "a rejection of the Federalist policies of the 1790s"
    }
   ],
