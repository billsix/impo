 "questions": [
  {
   "id": 615230,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is one important reason that New York State legislators opposed the canal at first?",
   "answers": [
    {
     "id": 1168892,
     "content_html": "They believed canal projects were inherently unconstitutional."
    },
    {
     "id": 1168891,
     "content_html": "They did not want to participate in the national market."
    },
    {
     "id": 1168893,
     "content_html": "They worried that the canal would bolster DeWitt Clinton’s political prospects."
    },
    {
     "id": 1168890,
     "content_html": "They believed the federal government should build post offices and post roads, not the state legislature."
    }
   ],
