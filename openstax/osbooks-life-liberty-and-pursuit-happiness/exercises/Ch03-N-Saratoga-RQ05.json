 "questions": [
  {
   "id": 614871,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following resulted from the Battle of Saratoga except",
   "answers": [
    {
     "id": 1167456,
     "content_html": "Continental General Gates acquired thousands of small arms and artillery pieces, which the Patriots desperately needed"
    },
    {
     "id": 1167455,
     "content_html": "British forces were reduced when those who surrendered agreed to return to England for the duration of the war"
    },
    {
     "id": 1167454,
     "content_html": "the Americans struck a formal alliance with France, bringing them recognition on the global stage as well as monetary and military support"
    },
    {
     "id": 1167457,
     "content_html": "George Washington was promoted to Commander in Chief of the Continental Army after this stunning victory"
    }
   ],
