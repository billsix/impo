 "questions": [
  {
   "id": 615202,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What impact did Tecumseh have on his brother Tenskwatawa’s followers?",
   "answers": [
    {
     "id": 1168781,
     "content_html": "Tecumseh transformed a religious movement into a political one."
    },
    {
     "id": 1168780,
     "content_html": "Tenskwatawa’s followers rejected Tenskwatawa as a prophet."
    },
    {
     "id": 1168779,
     "content_html": "Tenskwatawa’s followers changed allegiance to support the Americans."
    },
    {
     "id": 1168778,
     "content_html": "Tecumseh relocated the tribes to the Indian territory west of the Mississippi."
    }
   ],
