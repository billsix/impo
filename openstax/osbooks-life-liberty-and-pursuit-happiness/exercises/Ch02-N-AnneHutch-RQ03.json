 "questions": [
  {
   "id": 614676,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the General Council prohibit Anne Hutchinson from holding meetings in 1637?",
   "answers": [
    {
     "id": 1166678,
     "content_html": "The Puritan authorities took issue with a woman holding controversial meetings to discuss the Bible and Puritan doctrine."
    },
    {
     "id": 1166677,
     "content_html": "The Puritan authorities were about to ask John Cotton to leave the colony and so objected to his ideas getting so much publicity."
    },
    {
     "id": 1166676,
     "content_html": "The Puritan authorities believed Anne Hutchinson’s husband, a merchant, was using the meetings to sell his wares."
    },
    {
     "id": 1166675,
     "content_html": "The Puritan authorities were divided about the issues Anne Hutchinson raised and wanted time to debate the matter among themselves."
    }
   ],
