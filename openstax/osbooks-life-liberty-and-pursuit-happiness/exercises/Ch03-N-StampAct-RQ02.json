 "questions": [
  {
   "id": 614833,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the purpose of the Stamp Act?",
   "answers": [
    {
     "id": 1167305,
     "content_html": "To test the limits of the colonists’ tolerance of abuse and tyranny"
    },
    {
     "id": 1167304,
     "content_html": "To punish the colonies for their rebellious, destructive, and violent actions"
    },
    {
     "id": 1167303,
     "content_html": "To demonstrate clearly that the colonies were still subject to the will of Parliament and the king despite salutary neglect"
    },
    {
     "id": 1167306,
     "content_html": "To increase revenue and help defray the cost of keeping British soldiers on the frontier after the Seven Years’ War"
    }
   ],
