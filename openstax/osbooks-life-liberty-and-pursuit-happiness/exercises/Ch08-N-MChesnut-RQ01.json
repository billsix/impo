 "questions": [
  {
   "id": 615768,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why would a historian find Mary Chesnut’s life useful in a narrative about the American Civil War?",
   "answers": [
    {
     "id": 1171040,
     "content_html": "Chesnut was a sympathizer and spy for the Union."
    },
    {
     "id": 1171039,
     "content_html": "Chesnut’s nursing skills revolutionized the manner in which the wounded were cared for during wartime."
    },
    {
     "id": 1171041,
     "content_html": "Chesnut’s diaries left a detailed record of the life of an upper-class Confederate woman during the war."
    },
    {
     "id": 1171038,
     "content_html": "Chesnut’s written opinions were objective."
    }
   ],
