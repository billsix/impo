   "id": 616214,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Lend-Lease Act was a significant departure from most of American interwar foreign policy because it",
   "answers": [
    {
     "id": 1172823,
     "content_html": "was supported by the America First Committee"
    },
    {
     "id": 1172822,
     "content_html": "was drafted by members of the Nye Committee"
    },
    {
     "id": 1172824,
     "content_html": "recognized the need for direct American support of the Allies"
    },
    {
     "id": 1172821,
     "content_html": "came after Congress had declared war on Japan"
    }
