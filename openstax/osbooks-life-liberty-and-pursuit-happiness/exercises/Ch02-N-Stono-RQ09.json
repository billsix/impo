 "questions": [
  {
   "id": 614714,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the immediate impact of the Stono Rebellion on South Carolina?",
   "answers": [
    {
     "id": 1166829,
     "content_html": "Freedom for all the enslaved peoples in the rebellion"
    },
    {
     "id": 1166828,
     "content_html": "A reorganization of plantation labor to create wage-based jobs"
    },
    {
     "id": 1166830,
     "content_html": "New laws that attempted to further restrict the autonomy of enslaved people"
    },
    {
     "id": 1166827,
     "content_html": "Reduced fear among local white planters"
    }
   ],
