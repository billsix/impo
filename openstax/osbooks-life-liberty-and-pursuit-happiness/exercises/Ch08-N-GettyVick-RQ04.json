   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Union victories at Gettysburg and Vicksburg signified",
   "answers": [
    {
     "id": 1170948,
     "content_html": "the Civil War still had a long way to go"
    },
    {
     "id": 1170947,
     "content_html": "the Union still underestimated the Confederacy’s strength and motivation for victory"
    },
    {
     "id": 1170949,
     "content_html": "the Union had reached a turning point in the war but much hard fighting remained"
    },
    {
     "id": 1170946,
     "content_html": "the South would surrender within a year"
    }
   ],
