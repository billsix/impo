 "questions": [
  {
   "id": 615531,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the most accurate statement regarding the selection of the 1860 Republican presidential nominee?",
   "answers": [
    {
     "id": 1170096,
     "content_html": "Abraham Lincoln had been the frontrunner in the lead-up to the nominating convention.\n"
    },
    {
     "id": 1170095,
     "content_html": "The Republican nomination process attracted little national attention in 1860.\n"
    },
    {
     "id": 1170094,
     "content_html": "The newly formed Republican Party had difficulty getting qualified candidates to run for president.\n"
    },
    {
     "id": 1170097,
     "content_html": "A formidable group of nominees, including New York’s William Seward, competed for the Republican nomination.\n"
    }
   ],
