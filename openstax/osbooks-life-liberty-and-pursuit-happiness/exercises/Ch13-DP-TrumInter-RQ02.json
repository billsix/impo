 "questions": [
  {
   "id": 616388,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the outbreak of the Korean War change President Truman’s opinion of NSC 68?",
   "answers": [
    {
     "id": 1173519,
     "content_html": "Truman believed he could ignore NSC 68 indefinitely."
    },
    {
     "id": 1173520,
     "content_html": "The underlying assumptions of NSC 68 seemed proven to be sound."
    },
    {
     "id": 1173518,
     "content_html": "Truman lost faith in long-term policy planning."
    },
    {
     "id": 1173517,
     "content_html": "The Chinese Civil War became a more important issue."
    }
   ],
