 "questions": [
  {
   "id": 614643,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the outcome and consequence of the Pequot War of 1636–1639?",
   "answers": [
    {
     "id": 1166545,
     "content_html": "The Pequot successfully rallied neighboring American Indian peoples to join their resistance to English settlers."
    },
    {
     "id": 1166544,
     "content_html": "After a long struggle, the Spanish defeated the Pequot and solidified their claims to territory in present-day Mexico."
    },
    {
     "id": 1166546,
     "content_html": "The Pequot were defeated by the combined forces of the English, the Narragansett, and the Mohegan."
    },
    {
     "id": 1166543,
     "content_html": "The Pequot were successful in gaining concessions from the English settlers in return for support against the Narragansett people."
    }
   ],
