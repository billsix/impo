 "questions": [
  {
   "id": 616357,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The owner of the Cleveland Indians moved his team’s spring training site from Florida to Arizona because",
   "answers": [
    {
     "id": 1173395,
     "content_html": "it was more cost effective for the team to train in Arizona"
    },
    {
     "id": 1173396,
     "content_html": "he thought Arizona would be free of the racial segregation found in Florida"
    },
    {
     "id": 1173394,
     "content_html": "his players demanded the move to help end the controversy over race"
    },
    {
     "id": 1173393,
     "content_html": "he wanted to be closer to his home in Arizona"
    }
   ],
