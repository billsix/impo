     "id": 1170824,
     "content_html": "desire to split up the United States to keep it from becoming an economic rival"
    },
    {
     "id": 1170825,
     "content_html": "need for cotton in its textile industry"
    },
    {
     "id": 1170823,
     "content_html": "requirement for staple food crops produced on Confederate farms"
    },
    {
     "id": 1170822,
     "content_html": "need for a new military ally in its continued rivalry with France"
    }
