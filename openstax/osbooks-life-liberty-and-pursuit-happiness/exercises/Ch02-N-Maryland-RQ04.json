 "questions": [
  {
   "id": 614668,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Maryland’s Act of Toleration in 1649 did which of the following?",
   "answers": [
    {
     "id": 1166643,
     "content_html": "Protected the free practice of all religions in Maryland"
    },
    {
     "id": 1166646,
     "content_html": "Protected the free practice of all sects of Christianity in Maryland"
    },
    {
     "id": 1166644,
     "content_html": "Required all non-Christians to pay a tax to practice their religion in Maryland"
    },
    {
     "id": 1166645,
     "content_html": "Ensured Puritan rule of Maryland for the next forty years"
    }
   ],
