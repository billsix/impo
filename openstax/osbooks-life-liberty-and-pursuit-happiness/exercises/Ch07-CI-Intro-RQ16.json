 "questions": [
  {
   "id": 615417,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In  the 1860 election, southern Democrats rejected the presidential candidacy of Stephen Douglas because",
   "answers": [
    {
     "id": 1169641,
     "content_html": "they felt popular sovereignty insufficiently protected their interests"
    },
    {
     "id": 1169640,
     "content_html": "Abraham Lincoln had considered making Stephen Douglas his vice president"
    },
    {
     "id": 1169639,
     "content_html": "they knew the slave states held a majority of electoral votes"
    },
    {
     "id": 1169638,
     "content_html": "South Carolina had already seceded from the Union"
    }
   ],
