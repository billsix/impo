 "questions": [
  {
   "id": 615638,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In addition to the fact that Hawaii had a climate conducive to growing a profitable sugar crop, a major argument put forth by American businesspeople (who lived in Hawai’i) for annexation was that",
   "answers": [
    {
     "id": 1170520,
     "content_html": "Hawaii would provide a strategic naval base in the Pacific"
    },
    {
     "id": 1170521,
     "content_html": "the islands were an excellent gateway to the East and Asian trade"
    },
    {
     "id": 1170519,
     "content_html": "the native population wanted the islands to be annexed"
    },
    {
     "id": 1170518,
     "content_html": "the native population and Japanese immigrants provided cheap labor"
    }
   ],
