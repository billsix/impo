 "questions": [
  {
   "id": 614548,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Although there is little documentation of the perspective of Native Americans, the few reports that do exist indicate that Native Americans held which of the following views regarding European explorers?",
   "answers": [
    {
     "id": 1166165,
     "content_html": "The civilized behavior and appearance of the Europeans were admired."
    },
    {
     "id": 1166164,
     "content_html": "Any European technology was a vast improvement and should be adopted immediately."
    },
    {
     "id": 1166163,
     "content_html": "The Europeans were gods."
    },
    {
     "id": 1166166,
     "content_html": "Europeans tools and goods that were deemed useful should be adopted selectively."
    }
   ],
