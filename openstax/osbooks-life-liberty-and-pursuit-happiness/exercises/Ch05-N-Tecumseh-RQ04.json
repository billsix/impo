 "questions": [
  {
   "id": 615200,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<figure>\n<img src=\"exercises/media/d95b5b836bcf8d97.png\" alt=\"Map of Indiana divided by land given to the United States by Native Americans by treaty. At the top left: Treaty of Chicago (1821) with Treaty of Tippencanoe (1832) under it; upper right: Treaty of Mississinwas (1826) with Treaty of Wabash (1840) under it; center: Treaty of St. Mary’s (1818); center right and below St. Mary’s: Treaty of Grouseland (1805) with Vincennes Tract and Clark’s Grant on either side; lower left and right under St. Mary’s: Treaty of Fort Wayne (1809) with the Treaty of Greenville (1795) to the far right; and the Treaty of Vincennes (1804) at the very bottom.\">\n<figcaption>Map depicting Native American land cessations to the State of Indiana circa 1832.</figcaption>\n</figure>\n<p><i>Refer to the map provided.</i></p>\nThe map best illustrates which of the following?",
   "answers": [
    {
     "id": 1168773,
     "content_html": "U.S. interest in this area accelerated after the Louisiana Purchase."
    },
    {
     "id": 1168772,
     "content_html": "The treaty ending the American Revolution secured Native American land for the colonists."
    },
    {
     "id": 1168771,
     "content_html": "The British ceded vast tracts of land in the Old Northwest Territory to the Americans in the early nineteenth century."
    },
    {
     "id": 1168770,
     "content_html": "Tecumseh’s Confederacy achieved its goals during the period shown."
    }
   ],
