 "questions": [
  {
   "id": 614825,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is true about the American Indian warriors during Pontiac’s Rebellion?",
   "answers": [
    {
     "id": 1167273,
     "content_html": "American Indians changed their fighting tactics to match those of the trained British, fighting in organized lines and groups."
    },
    {
     "id": 1167272,
     "content_html": "American Indians were heavily outnumbered because many British troops had remained stationed in the West after the recent end of the Seven Years’ War."
    },
    {
     "id": 1167274,
     "content_html": "American Indians used guerrilla war tactics to defeat the organized British troops."
    },
    {
     "id": 1167271,
     "content_html": "American Indians avoided British forts and fought only in the wilderness."
    }
   ],
