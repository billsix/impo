   "stem_html": "The XYZ Affair was a result of",
   "answers": [
    {
     "id": 1168312,
     "content_html": "the failure of U.S. trade policy in the mid-1790s"
    },
    {
     "id": 1168313,
     "content_html": "the undeclared naval war between America and France"
    },
    {
     "id": 1168311,
     "content_html": "the seizure of American ships by the British"
    },
    {
     "id": 1168310,
     "content_html": "the impressment of American sailors by European naval powers"
    }
