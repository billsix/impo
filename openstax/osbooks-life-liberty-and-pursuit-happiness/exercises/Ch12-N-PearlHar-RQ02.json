  {
   "id": 616223,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What event played a significant role in the Japanese decision to go to war with the United States?",
   "answers": [
    {
     "id": 1172859,
     "content_html": "German dictator Adolf Hitler urged Japan to distract the United States from Europe."
    },
    {
     "id": 1172858,
     "content_html": "President Roosevelt threatened to declare war on Japan."
    },
    {
     "id": 1172860,
     "content_html": "American embargoes on oil and other supplies vital to the Japanese war machine"
    },
    {
     "id": 1172857,
     "content_html": "Japanese fears of American military intervention in China"
    }
   ],
