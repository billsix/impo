   "id": 614648,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the purpose of slave codes in the North American colonies?",
   "answers": [
    {
     "id": 1166565,
     "content_html": "To provide a list of rights and protections for slaves"
    },
    {
     "id": 1166566,
     "content_html": "To set laws defining the legal status of enslaved individuals"
    },
    {
     "id": 1166564,
     "content_html": "To establish agreement between European powers on the logistics of the slave trade"
    },
    {
     "id": 1166563,
     "content_html": "To develop better living conditions during the Middle Passage"
    }
   ],
