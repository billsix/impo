 "questions": [
  {
   "id": 614918,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is not true about the relationship between African Americans and the Loyalist Cause?",
   "answers": [
    {
     "id": 1167644,
     "content_html": "Many Loyalists in the Caribbean relied on slave labor and were hesitant about the possibility of their property being freed."
    },
    {
     "id": 1167643,
     "content_html": "As the war continued, many southern enslaved people escaped from their plantations and joined Loyalist troops."
    },
    {
     "id": 1167645,
     "content_html": "Free Blacks overwhelmingly supported the Loyalists because that gave them opportunities elsewhere in the British empire."
    },
    {
     "id": 1167642,
     "content_html": "At the conclusion of the War, most African American Loyalists received transportation to Nova Scotia where they were able to start their lives as free people."
    }
   ],
