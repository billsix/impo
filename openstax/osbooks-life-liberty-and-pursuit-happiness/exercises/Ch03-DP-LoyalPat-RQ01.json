 "questions": [
  {
   "id": 614914,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What best describes the Patriots before and during the American Revolution?",
   "answers": [
    {
     "id": 1167628,
     "content_html": "Patriots usually had strong economic ties to Great Britain and were hesitant to risk their livelihoods by joining the cause."
    },
    {
     "id": 1167629,
     "content_html": "Patriots supported the cause of liberty and independence for the colonies, which meant active support of the war effort."
    },
    {
     "id": 1167627,
     "content_html": "Most Patriots had religious commitments that prevented them from joining a side, even though it made them unpopular."
    },
    {
     "id": 1167626,
     "content_html": "Support for the war increased over time, and by the end of the conflict, every colonist identified as a Patriot."
    }
   ],
