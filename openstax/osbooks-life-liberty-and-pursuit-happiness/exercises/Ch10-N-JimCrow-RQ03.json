   "stimulus_html": "",
   "stem_html": "The primary purpose of Jim Crow legislation was to",
   "answers": [
    {
     "id": 1171605,
     "content_html": "legalize racial segregation"
    },
    {
     "id": 1171604,
     "content_html": "guarantee the Equal Protection Clause of the Fourteenth Amendment"
    },
    {
     "id": 1171603,
     "content_html": "reduce mob violence and the number of lynchings in the South"
    },
    {
     "id": 1171602,
     "content_html": "provide separate but equal accommodations"
    }
