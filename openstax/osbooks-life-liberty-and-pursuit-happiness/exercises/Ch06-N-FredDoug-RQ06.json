 "questions": [
  {
   "id": 615381,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did Frederick Douglass’s transformative fight with Edward Covey teach him?",
   "answers": [
    {
     "id": 1169496,
     "content_html": "Slaves could not fight back against slavery."
    },
    {
     "id": 1169495,
     "content_html": "Running away would be severely punished."
    },
    {
     "id": 1169494,
     "content_html": "Slaves could never win their freedom."
    },
    {
     "id": 1169497,
     "content_html": "Resisting slavery could help him recover his worth as a human being."
    }
   ],
