   "id": 615626,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Cowboys are symbols of American culture for all the following reasons except",
   "answers": [
    {
     "id": 1170472,
     "content_html": "they represent cherished ideals of freedom, individualism, and opportunity"
    },
    {
     "id": 1170471,
     "content_html": "they evoke nostalgia for a slower, simpler time"
    },
    {
     "id": 1170470,
     "content_html": "popular culture has transformed them into dramatic heroes of the Old West"
    },
    {
     "id": 1170473,
     "content_html": "they promoted the virtues and benefits of subsistence farming"
    }
   ],
