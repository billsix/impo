 "questions": [
  {
   "id": 615651,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The 1890s political label “silverite” refers to a person who",
   "answers": [
    {
     "id": 1170572,
     "content_html": "was against the circulation of silver as money"
    },
    {
     "id": 1170571,
     "content_html": "wanted to maintain strict adherence to the gold standard"
    },
    {
     "id": 1170573,
     "content_html": "supported a 16-to-1 ratio of silver to gold as currency"
    },
    {
     "id": 1170570,
     "content_html": "stood for “sound money”"
    }
   ],
