 "questions": [
  {
   "id": 615211,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Henry Clay most likely gave his support to John Quincy Adams in the 1824 presidential election because",
   "answers": [
    {
     "id": 1168817,
     "content_html": "the New Englander supported Clay’s “American system”"
    },
    {
     "id": 1168816,
     "content_html": "Andrew Jackson had limited support in the old Northwest Territory"
    },
    {
     "id": 1168815,
     "content_html": "Clay had been offered a position in Crawford’s Cabinet"
    },
    {
     "id": 1168814,
     "content_html": "the men came from the same geographic region"
    }
   ],
