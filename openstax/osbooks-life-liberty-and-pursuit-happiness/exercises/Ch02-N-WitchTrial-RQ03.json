 "questions": [
  {
   "id": 614703,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the fate of those who confessed to being witches in Salem Village?",
   "answers": [
    {
     "id": 1166785,
     "content_html": "They were immediately hanged on the grounds that there was no doubt as to their guilt."
    },
    {
     "id": 1166786,
     "content_html": "Only those who refused to confess were hanged—for clinging obstinately to Satan."
    },
    {
     "id": 1166784,
     "content_html": "Men tended to be acquitted whether or not they confessed."
    },
    {
     "id": 1166783,
     "content_html": "Regardless of whether they confessed, some were burned and some hanged."
    }
   ],
