 "questions": [
  {
   "id": 616047,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The passage of the Sedition Act made it even more difficult to fight the flu pandemic because",
   "answers": [
    {
     "id": 1172157,
     "content_html": "it stifled honest discussion and reporting of the disease"
    },
    {
     "id": 1172156,
     "content_html": "it allowed the arrest of many of the health-care workers fighting the disease"
    },
    {
     "id": 1172155,
     "content_html": "it increased immigration and thus the flow of disease carriers into the United States"
    },
    {
     "id": 1172154,
     "content_html": "it reopened schools and businesses that had been closed to control the contagion"
    }
   ],
