 "questions": [
  {
   "id": 615228,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following contributed to the success of the Erie Canal?",
   "answers": [
    {
     "id": 1168884,
     "content_html": "The Missouri River shortened the distance the canal would need to span."
    },
    {
     "id": 1168883,
     "content_html": "Most of the laborers were formally educated in engineering."
    },
    {
     "id": 1168885,
     "content_html": "Elevation changes across the Appalachian Mountains were gradual."
    },
    {
     "id": 1168882,
     "content_html": "The distance it spanned was far less than canals already existing in the United States."
    }
   ],
