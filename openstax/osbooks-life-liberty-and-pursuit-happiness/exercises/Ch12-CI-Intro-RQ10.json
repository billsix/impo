 "questions": [
  {
   "id": 616138,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement most accurately states the relationship between African Americans and New Deal programs?",
   "answers": [
    {
     "id": 1172520,
     "content_html": "Southern African Americans received little support from New Deal spending and continued to support the Republican Party."
    },
    {
     "id": 1172521,
     "content_html": "Despite discrimination in the administration of New Deal programs, a political realignment occurred, with African Americans beginning to vote overwhelmingly Democratic."
    },
    {
     "id": 1172519,
     "content_html": "New Deal legislation specifically prohibited racial discrimination."
    },
    {
     "id": 1172518,
     "content_html": "African Americans rejected the assistance provided by New Deal programs."
    }
   ],
