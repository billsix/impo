   "stimulus_html": "",
   "stem_html": "How did Douglass achieve his freedom?",
   "answers": [
    {
     "id": 1169488,
     "content_html": "He worked odd jobs, earned money, and bought his freedom."
    },
    {
     "id": 1169487,
     "content_html": "His freedom was purchased for him by abolitionists."
    },
    {
     "id": 1169489,
     "content_html": "He escaped to the North on the Underground Railroad."
    },
    {
     "id": 1169486,
     "content_html": "The state of Maryland abolished slavery."
    }
   ],
