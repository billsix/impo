 "questions": [
  {
   "id": 614808,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At the conclusion of the French and Indian War, what was the political status of the territory west of the Appalachian Mountains?",
   "answers": [
    {
     "id": 1167206,
     "content_html": "Colonial settlers were forbidden to cross the Appalachian Mountains."
    },
    {
     "id": 1167205,
     "content_html": "The British government acquired this territory and governed it under the Northwest Ordinance."
    },
    {
     "id": 1167204,
     "content_html": "Colonial rebels were banished to these territories, which were held by the British but very loosely governed."
    },
    {
     "id": 1167203,
     "content_html": "The French governed this territory as a colony until it was purchased by Jefferson in 1803."
    }
   ],
