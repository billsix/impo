 "stimulus_html": "<figure>\n<img id=\"Figure4_18\" src=\"exercises/media/45db0a0df9a6f93d.png\" alt=\"An illustration of several people working to operate a cotton gin.\">\n<figcaption><i>The First Cotton Gin</i> appeared in <i>Harper's Weekly</i> in 1869. This image depicts a roller gin, which preceded Eli Whitney's invention.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 366749,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A major impact on the United States of the event depicted in the drawing was that",
   "answers": [
    {
     "id": 889273,
     "content_html": "the need for paid agriculture labor in the South decreased as machines replaced workers"
    },
    {
     "id": 889274,
     "content_html": "the Deep South became an almost exclusive one-crop economy"
    },
    {
     "id": 889275,
     "content_html": "northern politicians issued an immediate call for the abolition of slavery"
    },
    {
     "id": 889276,
     "content_html": "the United States became a world-leading industrial power"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 366750,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A significant long-term impact of the event depicted was that",
   "answers": [
    {
     "id": 889277,
     "content_html": "as the nation expanded westward, the southern states became more defensive of the institution of slavery"
    },
    {
     "id": 889278,
     "content_html": "the South supported higher tariffs to protect the cotton industry"
    },
    {
     "id": 889279,
     "content_html": "poor, uneducated whites began to plant and harvest cotton"
    },
    {
     "id": 889280,
     "content_html": "a factory system developed in the South to produce textiles"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 366751,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement does the drawing best support?",
   "answers": [
    {
     "id": 889281,
     "content_html": "Slave labor is immoral and should be banned."
    },
    {
     "id": 889282,
     "content_html": "The federal government initially supported the expansion of slavery into the western territories."
    },
    {
     "id": 889283,
     "content_html": "The invention of the cotton gin increased the demand for slave labor."
    },
    {
     "id": 889284,
     "content_html": "The development of technology in the late eighteenth century provided free blacks with economic opportunities."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
