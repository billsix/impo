 "questions": [
  {
   "id": 615058,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Alexander Hamilton’s major argument against a bill of rights was that",
   "answers": [
    {
     "id": 1168205,
     "content_html": "a specific list of rights could be misinterpreted and violated"
    },
    {
     "id": 1168204,
     "content_html": "it was too burdensome for the federal government to enforce"
    },
    {
     "id": 1168203,
     "content_html": "it would be abused and interpreted differently by the different states"
    },
    {
     "id": 1168202,
     "content_html": "the rights would be redundant because states already had their own bills of rights"
    }
   ],
