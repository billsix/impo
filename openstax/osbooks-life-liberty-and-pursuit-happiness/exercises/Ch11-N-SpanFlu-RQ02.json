   "stimulus_html": "",
   "stem_html": "As the Spanish flu progressed across the United States, a unique characteristic that emerged was that the disease",
   "answers": [
    {
     "id": 1172144,
     "content_html": "seemed to be without symptoms until the end"
    },
    {
     "id": 1172143,
     "content_html": "killed a disproportionate number of women"
    },
    {
     "id": 1172142,
     "content_html": "struck a disproportionate number of people in New England"
    },
    {
     "id": 1172145,
     "content_html": "killed mostly young, healthy adults"
    }
