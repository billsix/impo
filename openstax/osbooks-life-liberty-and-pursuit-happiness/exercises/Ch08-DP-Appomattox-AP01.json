  {
   "id": 615857,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was part of Lincoln’s understanding of “the work we are in”?",
   "answers": [
    {
     "id": 1171396,
     "content_html": "Punishing the South for treason"
    },
    {
     "id": 1171395,
     "content_html": "Collecting money from the South to provide charity for Union widows and orphans"
    },
    {
     "id": 1171394,
     "content_html": "Dividing plantations and distributing the land to freed people"
    },
    {
     "id": 1171397,
     "content_html": "Healing the Union through a plan that offered respect and forgiveness wherever possible"
    }
   ],
