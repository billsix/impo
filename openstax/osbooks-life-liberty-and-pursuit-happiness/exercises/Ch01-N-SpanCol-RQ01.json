 "questions": [
  {
   "id": 614570,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did the Spanish build their colonies alongside Native American communities such as the Tenochtitlan?",
   "answers": [
    {
     "id": 1166254,
     "content_html": "To capitalize on preexisting cities and power structures\n"
    },
    {
     "id": 1166253,
     "content_html": "To show respect for the Native American towns and villages\n"
    },
    {
     "id": 1166252,
     "content_html": "As a way to collaborate with the Native Americans and the African slaves\n"
    },
    {
     "id": 1166251,
     "content_html": "As a means to extract even more natural resources from the Native Americans\n"
    }
   ],
