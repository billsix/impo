 "questions": [
  {
   "id": 615781,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The use of “hard war” by the Union army was",
   "answers": [
    {
     "id": 1171093,
     "content_html": "meant to accelerate the end of the war by ending any Confederate hope for victory"
    },
    {
     "id": 1171092,
     "content_html": "a new military strategy developed by General Ulysses S. Grant"
    },
    {
     "id": 1171091,
     "content_html": "a precursor to “conciliation” that would be used in the world wars of the twentieth century"
    },
    {
     "id": 1171090,
     "content_html": "considered a “crime against humanity” and never used again by the U.S. military"
    }
   ],
