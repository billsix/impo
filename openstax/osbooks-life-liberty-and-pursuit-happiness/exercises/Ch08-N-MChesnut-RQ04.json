 "questions": [
  {
   "id": 615771,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did Mary Chesnut’s father and husband have in common?",
   "answers": [
    {
     "id": 1171053,
     "content_html": "Both were wealthy and prominent politicians who supported states’ rights in South Carolina."
    },
    {
     "id": 1171052,
     "content_html": "Both were influential industrialists who engaged in profitable trade with their counterparts in the North."
    },
    {
     "id": 1171051,
     "content_html": "Both supported the candidacy of Abraham Lincoln and participated in negotiations aimed at peaceful resolution of the crisis at Fort Sumter."
    },
    {
     "id": 1171050,
     "content_html": "Both profited handsomely from munitions sales during the Civil War."
    }
   ],
