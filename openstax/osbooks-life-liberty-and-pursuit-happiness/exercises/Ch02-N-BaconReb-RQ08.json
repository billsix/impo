  {
   "id": 614700,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an accurate overall description of Bacon’s Rebellion?",
   "answers": [
    {
     "id": 1166773,
     "content_html": "Spanish-led raids on southern colonies such as South Carolina, Maryland, and Virginia to gain slaves and raw materials"
    },
    {
     "id": 1166774,
     "content_html": "A clash between the eastern shore’s landed gentry who controlled the colonial government and the poorer, frontier-based small farmers, along with slaves and servants"
    },
    {
     "id": 1166772,
     "content_html": "A war between the New England colonies and the southern colonies over the extent of Puritan control over colonial government"
    },
    {
     "id": 1166771,
     "content_html": "An uprising of Virginia colonists to show their displeasure against King James II and their desire for his removal from the throne"
    }
   ],
