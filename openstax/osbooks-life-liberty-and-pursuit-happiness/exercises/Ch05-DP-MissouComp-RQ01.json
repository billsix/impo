 "questions": [
  {
   "id": 615265,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Henry Clay was known as the “Great Compromiser” because",
   "answers": [
    {
     "id": 1169033,
     "content_html": "over three decades, he crafted multiple proposals that temporarily reduced sectionalist tensions"
    },
    {
     "id": 1169032,
     "content_html": "he proposed multiple amendments to the Constitution to paper over differences between Federalists and Anti-Federalists"
    },
    {
     "id": 1169031,
     "content_html": "he successfully persuaded opponents to accept the diffusion argument, encouraging the spread of slavery throughout the Louisiana Purchase"
    },
    {
     "id": 1169030,
     "content_html": "he won praise from supporters and opponents for his ability to smooth over political differences on issues relating primarily to trade and tariffs"
    }
   ],
