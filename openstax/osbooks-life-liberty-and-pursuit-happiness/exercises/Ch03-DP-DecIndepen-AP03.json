  {
   "id": 615024,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following reflects the main idea about the events described in excerpt provided?",
   "answers": [
    {
     "id": 1168068,
     "content_html": "Jefferson’s politics were not important in his selection as principal author of the Declaration."
    },
    {
     "id": 1168069,
     "content_html": "Jefferson’s background and writing skill ensured his selection as principal author of the Declaration"
    },
    {
     "id": 1168067,
     "content_html": "Jefferson and Adams each had a clearly defined role in authoring the document."
    },
    {
     "id": 1168066,
     "content_html": "Jefferson and Adams agreed on the exact language to be used in the document."
    }
