   "stimulus_html": "",
   "stem_html": "Which of the following events unfolded due to reasons similar to those described in the excerpt provided?",
   "answers": [
    {
     "id": 1168065,
     "content_html": "George Washington being appointed commander in chief"
    },
    {
     "id": 1168064,
     "content_html": "Robert Morris personally financing the American Revolution"
    },
    {
     "id": 1168063,
     "content_html": "Patrick Henry giving his “Give Me Liberty or Give Me Death” speech"
    },
    {
     "id": 1168062,
     "content_html": "Abigail Adams imploring her husband to include ladies in the new government"
    }
   ],
