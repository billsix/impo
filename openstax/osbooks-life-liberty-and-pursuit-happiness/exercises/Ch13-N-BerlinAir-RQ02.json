 "questions": [
  {
   "id": 616318,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Truman administration decided to respond to the Berlin Blockade by organizing an airlift for all the following reasons except",
   "answers": [
    {
     "id": 1173239,
     "content_html": "the size of the Red Army made a military response unwise"
    },
    {
     "id": 1173238,
     "content_html": "the United States did not want to appear to be giving in to Soviet policy"
    },
    {
     "id": 1173237,
     "content_html": "it seemed unlikely that the Soviets would try to shoot down unarmed cargo planes"
    },
    {
     "id": 1173240,
     "content_html": "the British and French were unwilling to offer any assistance"
    }
   ],
