   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The beliefs stated in this document most clearly contributed to which of the following?",
   "answers": [
    {
     "id": 1171860,
     "content_html": "Support for Woodrow Wilson’s Fourteen Point peace plan, committing the United States to participate in the League of Nations"
    },
    {
     "id": 1171859,
     "content_html": "Passage of the women’s suffrage amendment"
    },
    {
     "id": 1171861,
     "content_html": "Failure of the U.S. Senate to ratify the Treaty of Versailles"
    },
    {
     "id": 1171858,
     "content_html": "The need for a draft during World War I"
    }
