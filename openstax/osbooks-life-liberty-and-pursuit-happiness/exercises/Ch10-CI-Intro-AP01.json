     "content_html": "nativist sentiment due to increased immigration from Southern and Eastern Europe"
    },
    {
     "id": 1171853,
     "content_html": "the need to finance U.S. involvement in World War I"
    },
    {
     "id": 1171851,
     "content_html": "payment for territories acquired after the Spanish-American War"
    },
    {
     "id": 1171850,
     "content_html": "negative reaction to violations of civil liberties at the end of World War I"
    }
   ],
