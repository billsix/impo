   "id": 614713,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which was not an impact of the Stono Rebellion on the social structure in South Carolina during the middle of the eighteenth century?",
   "answers": [
    {
     "id": 1166825,
     "content_html": "Increased fear among white plantation owners"
    },
    {
     "id": 1166824,
     "content_html": "Implementation of laws that restricted slave movements and freedoms"
    },
    {
     "id": 1166826,
     "content_html": "Freedom for those who instigated the rebellion"
    },
    {
     "id": 1166823,
     "content_html": "Deaths of white people and black people in Charleston"
    }
