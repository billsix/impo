 "questions": [
  {
   "id": 614812,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the role of American Indian tribes in the Revolutionary War?",
   "answers": [
    {
     "id": 1167221,
     "content_html": "American Indians mostly moved into the Northwest Territories to escape the conflict."
    },
    {
     "id": 1167222,
     "content_html": "American Indians often sided with the British, although some fought alongside the colonists."
    },
    {
     "id": 1167220,
     "content_html": "American Indians unanimously supported the British cause in return for protection."
    },
    {
     "id": 1167219,
     "content_html": "American Indians generally supported the colonists, believing that the colonists’ commitment to freedom and independence would make it more likely that Indians’ property rights would be protected."
    }
   ],
