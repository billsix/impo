   "stimulus_html": "",
   "stem_html": "Opponents of women’s suffrage raised all the following arguments except",
   "answers": [
    {
     "id": 1171532,
     "content_html": "women lacked the mental capacity for civic literacy"
    },
    {
     "id": 1171531,
     "content_html": "women would most likely vote their husbands’ choice anyway"
    },
    {
     "id": 1171530,
     "content_html": "voting and civic engagement were not properly in women’s domestic sphere"
    },
    {
     "id": 1171533,
     "content_html": "reform legislation would result in economic growth nationwide"
    }
