   "id": 616771,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Although the Berkeley Free Speech Movement attracted nationwide attention as the symbol of liberal campus protests, in fact, its supporters",
   "answers": [
    {
     "id": 1174307,
     "content_html": "consisted of the overwhelming majority of enrolled UC Berkeley students"
    },
    {
     "id": 1174306,
     "content_html": "primarily were from the business and science departments"
    },
    {
     "id": 1174305,
     "content_html": "primarily were from the political right"
    },
    {
     "id": 1174308,
     "content_html": "initially were from an ideological cross-section of the campus"
    }
   ],
