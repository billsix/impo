 "questions": [
  {
   "id": 614919,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the Patriots had lost the war, what would have been a likely consequence for them?",
   "answers": [
    {
     "id": 1167649,
     "content_html": "Patriots would be punished for rebelling against the Crown, and the organizers would likely face death."
    },
    {
     "id": 1167648,
     "content_html": "Their allies would safely transport Patriots out of the colonies."
    },
    {
     "id": 1167647,
     "content_html": "Patriots would be able to negotiate a new form of democratic government with the Crown."
    },
    {
     "id": 1167646,
     "content_html": "Patriots would immediately realize their mistake and become Loyalists once again."
    }
   ],
