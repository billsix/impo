 "stimulus_html": "<figure id=\"fig7_20\">\n<img src=\"exercises/media/56df530d852efca8.png\" alt=\"Advertisement showing a clipper ship on the right and men with picks and mining carts on the left in front of an open mine. The word California features prominently on the page below the illustration. Above the illustration, text reads “A new and magnificent clipper for San Francisco. Merchants’ express line of clipper ships! Loading non but first-class vessels and regularly dispatching the greatest number. The splendid new out-and-out clipper ship.” Below the word California reads “Henry Barber, Commander, at Pier 13 East River. This elegant Clipper Ship was built expressly for this trade by Samuel Hall, Esq., of East Boston, the builder of the celebrated Clippers “Surprise,” “Gamecock,” “John Gilpin,” and others. She will fully equal them in speed: Usually prompt dispatch and a very quick trip may be relied upon. Engagements should be completed at once.\">\n<figcaption>Advertisement circa 1850.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>\n",
 "questions": [
  {
   "id": 615450,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The  advertisement reflects which continuity in U.S. history?",
   "answers": [
    {
     "id": 1169772,
     "content_html": "A frontier environment fostered some aspects of gender equality.\n"
    },
    {
     "id": 1169771,
     "content_html": "Changes in transportation technology came with safety concerns.\n"
    },
    {
     "id": 1169770,
     "content_html": "Social tensions resulted from increased immigration.\n"
    },
    {
     "id": 1169773,
     "content_html": "Economic opportunity motivated westward expansion.\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615451,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The  events depicted in this advertisement most directly led to",
   "answers": [
    {
     "id": 1169776,
     "content_html": "war with Mexico\n"
    },
    {
     "id": 1169777,
     "content_html": "the Compromise of 1850\n"
    },
    {
     "id": 1169775,
     "content_html": "the Kansas-Nebraska Act\n"
    },
    {
     "id": 1169774,
     "content_html": "establishment of the Oregon boundary at the 49th parallel\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615452,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Advertisements  like the one provided were most directly shaped by",
   "answers": [
    {
     "id": 1169780,
     "content_html": "competition from the transcontinental railroad\n"
    },
    {
     "id": 1169781,
     "content_html": "the need for alternatives to an arduous overland route\n"
    },
    {
     "id": 1169779,
     "content_html": "the Whig program of federally funded infrastructure projects\n"
    },
    {
     "id": 1169778,
     "content_html": "San Francisco’s position as the major U.S. port city\n"
    }
   ],
