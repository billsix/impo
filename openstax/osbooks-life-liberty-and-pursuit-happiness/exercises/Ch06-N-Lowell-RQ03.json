 "questions": [
  {
   "id": 615361,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What impact did the Lowell Girls have on the development of a labor movement in the newly industrial Northeast?",
   "answers": [
    {
     "id": 1169416,
     "content_html": "They went on strike because of closely regulated living conditions."
    },
    {
     "id": 1169415,
     "content_html": "They encouraged a more productive work place."
    },
    {
     "id": 1169414,
     "content_html": "They broke the control of monopolistic factory owners."
    },
    {
     "id": 1169417,
     "content_html": "They used activism to gain more rights, such as striking over reduced wages."
    }
   ],
