   "stimulus_html": "",
   "stem_html": "The fur trade between American Indians and Europeans began",
   "answers": [
    {
     "id": 1166721,
     "content_html": "when the Europeans made permanent settlements on the North American continent"
    },
    {
     "id": 1166722,
     "content_html": "when European explorers and fishermen began to trade for supplies with American Indians during the presettlement era"
    },
    {
     "id": 1166720,
     "content_html": "when English pirates came across American Indians in North America while looking for Spanish ships to raid"
    },
    {
     "id": 1166719,
     "content_html": "as a result of a war between the French and the English over North American territorial domination"
    }
