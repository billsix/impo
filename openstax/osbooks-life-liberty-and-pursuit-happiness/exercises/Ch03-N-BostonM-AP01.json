   "id": 614956,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The principle expressed in the English Bill of Rights that contributed most to the tensions in Boston was",
   "answers": [
    {
     "id": 1167796,
     "content_html": "the right of petition should not be denied"
    },
    {
     "id": 1167797,
     "content_html": "a standing army should not be kept among them during a time of peace"
    },
    {
     "id": 1167795,
     "content_html": "the king should not suspend or ignore laws"
    },
    {
     "id": 1167794,
     "content_html": "special courts should not be convened"
    }
   ],
