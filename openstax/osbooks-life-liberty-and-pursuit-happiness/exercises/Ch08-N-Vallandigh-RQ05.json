   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the 1861 order from the Chief Justice of the Supreme Court in <i>Ex Parte Merryman,</i> Chief Justice Roger B. Taney ruled that",
   "answers": [
    {
     "id": 1171076,
     "content_html": "President Lincoln had the right to regulate free speech"
    },
    {
     "id": 1171075,
     "content_html": "only Congress could alter civil liberties"
    },
    {
     "id": 1171077,
     "content_html": "only Congress could suspend habeas corpus"
    },
    {
     "id": 1171074,
     "content_html": "the arrest of Clement Vallandigham was unconstitutional"
    }
   ],
