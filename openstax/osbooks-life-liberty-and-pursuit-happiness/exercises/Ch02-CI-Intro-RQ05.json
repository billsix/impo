 "questions": [
  {
   "id": 614638,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The establishment of colonies in Jamestown by the English, in Quebec by the French, and in Albany by the Dutch is best explained by which of the following statements?",
   "answers": [
    {
     "id": 1166525,
     "content_html": "Many European nations acquiesced to Spanish dominance in North America."
    },
    {
     "id": 1166524,
     "content_html": "American Indian populations in North America were successful in driving off Spanish conquistadors."
    },
    {
     "id": 1166526,
     "content_html": "Spain’s focus on the Caribbean, Mexico, and South America opened the door for other nations to establish footholds in North America."
    },
    {
     "id": 1166523,
     "content_html": "Cooperative efforts by European monarchs led to the successful colonization of North America."
    }
   ],
