   "stimulus_html": "",
   "stem_html": "Why were the Chinese interested in meeting with Nixon?",
   "answers": [
    {
     "id": 1174667,
     "content_html": "Nixon promised them aid."
    },
    {
     "id": 1174666,
     "content_html": "Mao’s revolution was working."
    },
    {
     "id": 1174668,
     "content_html": "China’s relationship with the Soviet Union was disintegrating."
    },
    {
     "id": 1174665,
     "content_html": "China had just been granted Most Favored Nation status and wanted U.S. investment."
    }
