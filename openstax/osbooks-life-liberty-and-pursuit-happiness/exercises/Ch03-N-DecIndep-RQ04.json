 "questions": [
  {
   "id": 614855,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best explains the process of writing the Declaration of Independence?",
   "answers": [
    {
     "id": 1167393,
     "content_html": "Thomas Jefferson took it upon himself to write the document without guidance from the Continental Congress."
    },
    {
     "id": 1167394,
     "content_html": "After multiple calls for independence, a committee was created to collaborate on a document that would go through revisions and debate."
    },
    {
     "id": 1167392,
     "content_html": "A small radical faction within the Continental Congress met without permission to write a document that would galvanize the independence movement."
    },
    {
     "id": 1167391,
     "content_html": "By May 1776, each colony was convinced of the need for independence, and all worked together to create a document that represented their views."
    }
   ],
