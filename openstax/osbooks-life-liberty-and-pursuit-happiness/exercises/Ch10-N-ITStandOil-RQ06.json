 "questions": [
  {
   "id": 615884,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Compared with other Progressive Era critics of corporations, Ida Tarbell was unusual in that she",
   "answers": [
    {
     "id": 1171504,
     "content_html": "believed that the press had an obligation to expose big business"
    },
    {
     "id": 1171503,
     "content_html": "befriended Rockefeller later in her life"
    },
    {
     "id": 1171505,
     "content_html": "opposed unfair business practices, rather than the sheer size of Gilded Age corporations"
    },
    {
     "id": 1171502,
     "content_html": "worked for Standard Oil as a young woman"
    }
   ],
   "hints": [],
