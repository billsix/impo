 "questions": [
  {
   "id": 615109,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Although Thomas Jefferson agreed that the United States should remain neutral in the war between Great Britain and France, he was outraged when President Washington issued the Proclamation of Neutrality because, according to Jefferson",
   "answers": [
    {
     "id": 1168409,
     "content_html": "the Proclamation established a precedent that granted too much power to the president"
    },
    {
     "id": 1168408,
     "content_html": "Congress was not consulted about the Proclamation"
    },
    {
     "id": 1168407,
     "content_html": "the French would break the Alliance of 1778 with the United States"
    },
    {
     "id": 1168406,
     "content_html": "the British would end their trade relationship with the United States"
    }
   ],
