     "id": 1172427,
     "content_html": "loaning a large sum of money to Germany for reparation payments"
    },
    {
     "id": 1172429,
     "content_html": "lowering business taxes"
    },
    {
     "id": 1172428,
     "content_html": "reducing regulation of business and industry"
    }
