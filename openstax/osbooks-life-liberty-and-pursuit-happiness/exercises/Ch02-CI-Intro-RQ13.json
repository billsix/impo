   "id": 614646,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the “Middle Passage”?",
   "answers": [
    {
     "id": 1166557,
     "content_html": "The long-sought waterway through North America that would provide access to Asia"
    },
    {
     "id": 1166558,
     "content_html": "The second leg of the profitable triangular trade route that transported humans from West Africa to the Americas to be sold as slaves"
    },
    {
     "id": 1166556,
     "content_html": "The exchange of goods and services between the Americas and Europe"
    },
    {
     "id": 1166555,
     "content_html": "The trade routes established by the French that connected Quebec to the Mississippi River"
    }
   ],
