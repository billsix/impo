   "stimulus_html": "",
   "stem_html": "Before the Civil War, Mary Chesnut could be best described as",
   "answers": [
    {
     "id": 1171044,
     "content_html": "a woman who worked hard on her farm on the southern frontier"
    },
    {
     "id": 1171043,
     "content_html": "one of the few working women who served as a nurse in Southern society"
    },
    {
     "id": 1171045,
     "content_html": "a woman of high social standing in the South"
    },
    {
     "id": 1171042,
     "content_html": "a prominent educator of young women"
    }
