 "questions": [
  {
   "id": 616955,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Major demographic changes in the United States in the 1980s included",
   "answers": [
    {
     "id": 1175043,
     "content_html": "widespread return to Rust Belt states because of dissatisfaction with the quality of life in Sun Belt states"
    },
    {
     "id": 1175044,
     "content_html": "more immigration from Latin America and Asia"
    },
    {
     "id": 1175042,
     "content_html": "a baby boom in the industrial heartland rivaling that of the post–World War II years"
    },
    {
     "id": 1175041,
     "content_html": "lower life expectancy due to the AIDS epidemic"
    }
   ],
