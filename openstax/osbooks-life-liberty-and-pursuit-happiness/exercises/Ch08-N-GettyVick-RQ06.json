 "questions": [
  {
   "id": 615747,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Gettysburg signal a change in Robert E. Lee’s strategy?",
   "answers": [
    {
     "id": 1170957,
     "content_html": "Lee never again launched a large-scale invasion of the North."
    },
    {
     "id": 1170956,
     "content_html": "Lee removed his subordinate generals from their command."
    },
    {
     "id": 1170955,
     "content_html": "Lee reevaluated his commitment to frontal infantry attacks."
    },
    {
     "id": 1170954,
     "content_html": "Lee resigned his commission as commander of the Army of Northern Virginia."
    }
   ],
