   "stimulus_html": "",
   "stem_html": "The Proclamation of 1763",
   "answers": [
    {
     "id": 1166945,
     "content_html": "was negotiated by the British, French, and Spanish governments as a plan to bring the Seven Years’ War to an end"
    },
    {
     "id": 1166946,
     "content_html": "prohibited North American colonists from purchasing and settling lands west of the Appalachian Mountains"
    },
    {
     "id": 1166944,
     "content_html": "placed all French territory in North America under British control"
    },
    {
     "id": 1166943,
     "content_html": "allowed for greater taxation of the British colonies in North America"
    }
   ],
