 "is_vocab": false,
 "stimulus_html": "<p>“Ironically, the Mormons who sought to escape from the United States ended up playing a role in extending the United States. Their way of life, originally a millenarian critique of the larger society and a collectivist, authoritarian dissent from American individualistic pluralism, now impresses observers as the most ‘American’ of all.”</p>\n<p align=\"right\">Daniel Walker Howe, <i>What Hath God Wrought: The Transformation of America, 1815–1848</i></p>\n<p><i>Refer to the excerpt provided.</i></p>",
 "questions": [
  {
   "id": 615314,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to Daniel Walker Howe, what attribute of Mormon society demonstrated the essence of the American character?",
   "answers": [
    {
     "id": 1169226,
     "content_html": "Strict theocracy"
    },
    {
     "id": 1169227,
     "content_html": "Liberal socialism"
    },
    {
     "id": 1169228,
     "content_html": "Authoritarian agrarianism"
    },
    {
     "id": 1169229,
     "content_html": "Individualistic pluralism"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615315,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did Mormons seeking the opportunity to practice their religious beliefs extend the geographic area of the United States?",
   "answers": [
    {
     "id": 1169230,
     "content_html": "They moved in large numbers to the Great Salt Lake Basin and quickly won admission to the Union as the state of Deseret."
    },
    {
     "id": 1169231,
     "content_html": "They forced non-Mormons out of the area so Mormons could enter the Union as a theocratic state."
    },
    {
     "id": 1169232,
     "content_html": "Joseph Smith asked the Utah territorial government to declare Mormon settlements an independent region not subject to the territorial legislature."
    },
    {
     "id": 1169233,
     "content_html": "They undertook diligent mission activity, encouraging immigration to the region and increasing the population of Utah Territory."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
