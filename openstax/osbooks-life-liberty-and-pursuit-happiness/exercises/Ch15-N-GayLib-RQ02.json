   "stimulus_html": "",
   "stem_html": "Alfred Kinsey’s research on sexuality was controversial because of",
   "answers": [
    {
     "id": 1174635,
     "content_html": "his use of a small sample pool"
    },
    {
     "id": 1174634,
     "content_html": "his reliance on a few simple categories of classification"
    },
    {
     "id": 1174636,
     "content_html": "his use of a disproportionate number of prison inmates"
    },
    {
     "id": 1174633,
     "content_html": "a new wave of social activism in the 1960s"
    }
