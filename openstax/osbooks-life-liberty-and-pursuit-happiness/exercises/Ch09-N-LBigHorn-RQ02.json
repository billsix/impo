 "questions": [
  {
   "id": 615606,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Oglala Sioux leader Black Hawk refused to sign the Fort Laramie Treaty of 1851 because",
   "answers": [
    {
     "id": 1170392,
     "content_html": "the Sioux nation was at war with the United States"
    },
    {
     "id": 1170393,
     "content_html": "the land the Americans wanted had already been captured by the Oglala Sioux"
    },
    {
     "id": 1170391,
     "content_html": "American Indians did not recognize land ownership rights"
    },
    {
     "id": 1170390,
     "content_html": "signing the treaty would have forced the Oglala Sioux to move from their homeland"
    }
   ],
