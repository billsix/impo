 "questions": [
  {
   "id": 614929,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did some politicians fiercely protect the rights of the states in the Articles of Confederation over the idea of a centralized government?",
   "answers": [
    {
     "id": 1167689,
     "content_html": "They wanted strict adherence to the Patriotic cause, which had freed them from a tyrant king and parliament that abused its power."
    },
    {
     "id": 1167688,
     "content_html": "A central government would require negotiations with other foreign powers, costing thousands of dollars the country didn’t have."
    },
    {
     "id": 1167687,
     "content_html": "Every citizen was represented by the current government and politicians did not want to risk changing that."
    },
    {
     "id": 1167686,
     "content_html": "The Articles were so successful in handling foreign and domestic affairs that a centralized government was not necessary."
    }
   ],
   "hints": [],
