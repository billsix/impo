   "stimulus_html": "",
   "stem_html": "The New Left argued that",
   "answers": [
    {
     "id": 1174180,
     "content_html": "labor unions had abandoned the old left’s goals by joining the power elite"
    },
    {
     "id": 1174179,
     "content_html": "current American foreign policy goals in Southeast Asia were attainable"
    },
    {
     "id": 1174178,
     "content_html": "the United States served as a model of racial tolerance and moderate foreign policy"
    },
    {
     "id": 1174177,
     "content_html": "the white working class would be the central core of the New Left’s power"
    }
   ],
