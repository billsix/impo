 "questions": [
  {
   "id": 616365,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a result of the trial of Emmett Till’s killers and Till’s funeral,",
   "answers": [
    {
     "id": 1173427,
     "content_html": "the social advancement of African Americans slowed for the remainder of the 1950s"
    },
    {
     "id": 1173426,
     "content_html": "integrated schools in Chicago became segregated again"
    },
    {
     "id": 1173428,
     "content_html": "the nation began to have more sympathy for the African American community"
    },
    {
     "id": 1173425,
     "content_html": "anti-lynching laws were passed"
    }
   ],
