 "questions": [
  {
   "id": 614699,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was a major complaint of Nathaniel Bacon and his followers?",
   "answers": [
    {
     "id": 1166769,
     "content_html": "Maryland Catholics were a threat to the existence of the Virginia colony."
    },
    {
     "id": 1166768,
     "content_html": "Frontier farmers had too much control of the colonial government in Richmond."
    },
    {
     "id": 1166767,
     "content_html": "The king of England did not fully support Berkeley’s plan to deal with the Indian threat."
    },
    {
     "id": 1166770,
     "content_html": "All American Indian tribes were a threat to English colonists and must be eliminated."
    }
   ],
