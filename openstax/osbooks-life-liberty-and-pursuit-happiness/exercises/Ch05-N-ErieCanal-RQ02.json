 "questions": [
  {
   "id": 615229,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was a technological achievement that benefited the canal?",
   "answers": [
    {
     "id": 1168888,
     "content_html": "Because most of the labor was mechanized, very few people and animals were involved in the canal’s construction."
    },
    {
     "id": 1168887,
     "content_html": "Communication technologies such as telegraph and telephone improved the process of purchasing building materials."
    },
    {
     "id": 1168886,
     "content_html": "Engineering advances allowed the canal to be completed without using dangerous explosives."
    },
    {
     "id": 1168889,
     "content_html": "The locks constructed in Lockport, New York, were far higher than any previously constructed."
    }
   ],
