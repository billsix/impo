 "questions": [
  {
   "id": 614900,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the debate for ratification ultimately end?",
   "answers": [
    {
     "id": 1167572,
     "content_html": "Not enough states voted to ratify and the Constitution did not become the government of the United States,"
    },
    {
     "id": 1167571,
     "content_html": "The minimum number of states ratified the Constitution, so it became the law of the land, but only for the states that accepted it."
    },
    {
     "id": 1167573,
     "content_html": "Each state ultimately ratified the Constitution, despite close votes and thorough debates."
    },
    {
     "id": 1167570,
     "content_html": "Debates continue on the merits of the Constitution, and a few states still need to hold their ratifying convention."
    }
   ],
