 "questions": [
  {
   "id": 615372,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The founding principle on which John Quincy Adams based his argument before the Supreme Court was",
   "answers": [
    {
     "id": 1169460,
     "content_html": "federalism, which required that national law and treaties take precedence over New York law"
    },
    {
     "id": 1169459,
     "content_html": "checks and balances, which gave the Supreme Court the final jurisdiction over the case"
    },
    {
     "id": 1169461,
     "content_html": "that all humans possess natural and inalienable rights"
    },
    {
     "id": 1169458,
     "content_html": "freedom of contract, which protected the rights of the ship owners"
    }
   ],
   "hints": [],
