   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the 1896 election, the Democratic Party effectively neutralized the Populist challenge to the traditional two-party system by",
   "answers": [
    {
     "id": 1170564,
     "content_html": "endorsing the subtreasury system"
    },
    {
     "id": 1170563,
     "content_html": "criticizing Jim Crow laws and the disfranchisement of black voters"
    },
    {
     "id": 1170562,
     "content_html": "portraying the Populists as anarchists and hicks"
    },
    {
     "id": 1170565,
     "content_html": "nominating pro-silver politician William Jennings Bryan for president"
    }
