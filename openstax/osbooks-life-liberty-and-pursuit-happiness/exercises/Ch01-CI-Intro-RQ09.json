 "questions": [
  {
   "id": 614620,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did John Winthrop mean in referring to the Puritan settlement as a “city upon a hill”?",
   "answers": [
    {
     "id": 1166453,
     "content_html": "The Puritans would build their settlement on a hill i to see enemies when they approached. \n"
    },
    {
     "id": 1166452,
     "content_html": "Because their settlement was on the coast, the Puritans would create a lighthouse on a hill to guide ships.\n"
    },
    {
     "id": 1166454,
     "content_html": "The Puritan settlement would be a model society and an example to those in England of how a Christian society should operate.\n"
    },
    {
     "id": 1166451,
     "content_html": "The Puritan settlement would be a model of democratic government.\n"
    }
   ],
