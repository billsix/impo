 "questions": [
  {
   "id": 614587,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best describes the interaction between Europeans and Africans in capturing slaves on the African continent?",
   "answers": [
    {
     "id": 1166321,
     "content_html": "Europeans directly raided the African continent and captured slaves with the permission of African rulers.\n"
    },
    {
     "id": 1166322,
     "content_html": "Europeans relied on Africans as business partners to capture and provide them with slaves for payment.\n"
    },
    {
     "id": 1166320,
     "content_html": "Europeans sought the advice of African rulers and merchants on the best places to purchase slaves within the continent.\n"
    },
    {
     "id": 1166319,
     "content_html": "Europeans and African rulers and merchants had little to no interaction during the Atlantic slave trade.\n"
    }
   ],
