 "questions": [
  {
   "id": 616285,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why were many middle-class women dissatisfied with their lives in the 1950s?",
   "answers": [
    {
     "id": 1173108,
     "content_html": "They were excluded from most career opportunities."
    },
    {
     "id": 1173107,
     "content_html": "The cost of living was too high."
    },
    {
     "id": 1173106,
     "content_html": "Fear of losing their traditional roles caused them constant anxiety."
    },
    {
     "id": 1173105,
     "content_html": "They opposed the early civil rights movement."
    }
   ],
