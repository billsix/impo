  {
   "id": 616749,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Black Panther Party for Self-Defense was characterized by all the following except",
   "answers": [
    {
     "id": 1174219,
     "content_html": "it was founded by Huey Newton and Bobby Seale"
    },
    {
     "id": 1174218,
     "content_html": "it operated, in part, as a welfare agency for poor black communities"
    },
    {
     "id": 1174217,
     "content_html": "it served as a source of inspiration for the Black Lives Matter movement"
    },
    {
     "id": 1174220,
     "content_html": "it was modeled after Dr. King’s Southern Christian Leadership Conference"
    }
   ],
