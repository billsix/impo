 "questions": [
  {
   "id": 614916,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following generalizations is true about Loyalists, Patriots, and neutrals?",
   "answers": [
    {
     "id": 1167636,
     "content_html": "The Declaration of Independence was a turning point that decided for each of these groups who they would support in the Revolution."
    },
    {
     "id": 1167635,
     "content_html": "Loyalists were typically upper class, Patriots typically middle class, and neutrals usually lower class."
    },
    {
     "id": 1167637,
     "content_html": "There was no deciding factor; instead, each person made choices on the basis of political beliefs, economic opportunity, and proximity to war."
    },
    {
     "id": 1167634,
     "content_html": "Almost all Scotch-Irish supported the neutral cause, whereas almost all African Americans supported the Patriot cause of liberty."
    }
   ],
