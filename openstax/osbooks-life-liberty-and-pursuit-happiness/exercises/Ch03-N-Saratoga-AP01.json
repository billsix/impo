 "is_vocab": false,
 "stimulus_html": "<figure>\n<img src=\"exercises/media/9c9c50e5415ba2cb.png\" alt=\"An engraving of Benjamin Franklin, wearing a fur hat, glasses, and a coat.\">\n<figcaption>A 1777 engraving of Benjamin Franklin.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 614973,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The image shown could be used to support which one of the following conclusions?",
   "answers": [
    {
     "id": 1167864,
     "content_html": "Benjamin Franklin was the popular and international favorite for the first president of the new United States because of his philosophical writings and scientific discoveries."
    },
    {
     "id": 1167863,
     "content_html": "Benjamin Franklin was a proponent of capitalizing on the lands west of the Appalachian Mountains, which would benefit the colonies in their fight against the British."
    },
    {
     "id": 1167865,
     "content_html": "Benjamin Franklin was revered in Paris as an internationally renowned scientist and a manifestation of American republicanism, which served him in negotiating with the French for more funds."
    },
    {
     "id": 1167862,
     "content_html": "Benjamin Franklin was seen by the British as the embodiment of American independence, and they used his image to spread propaganda about American colonists being uncultured and uneducated."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614974,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the causal link between the America victory at Saratoga and French military aid to Americans?",
   "answers": [
    {
     "id": 1167869,
     "content_html": "The victory at Saratoga proved the potential of the American troops and demonstrated to the French that the Americans could possibly defeat the British."
    },
    {
     "id": 1167868,
     "content_html": "The victory at Saratoga demonstrated that the Americans could potentially defeat the French, so it was necessary to secure them as allies before they became opponents."
    },
    {
     "id": 1167867,
     "content_html": "The victory at Saratoga was pyrrhic, meaning the Americans were almost entirely defeated, and the French took pity on them to appear as the saviors of the conflict."
    },
    {
     "id": 1167866,
     "content_html": "The victory at Saratoga demonstrated the American commitment to the ideals of liberty and republicanism, with which the French identified."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
