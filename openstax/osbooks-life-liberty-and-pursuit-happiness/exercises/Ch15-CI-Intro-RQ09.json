   "stimulus_html": "",
   "stem_html": "A significant strategy President Nixon used to quell anti-war protests on college campuses was",
   "answers": [
    {
     "id": 1174428,
     "content_html": "ending educational deferments"
    },
    {
     "id": 1174427,
     "content_html": "requiring more technology than troops for the war"
    },
    {
     "id": 1174426,
     "content_html": "changing the military to an all-volunteer organization"
    },
    {
     "id": 1174425,
     "content_html": "allowing the National Guard to occupy major college campuses"
    }
