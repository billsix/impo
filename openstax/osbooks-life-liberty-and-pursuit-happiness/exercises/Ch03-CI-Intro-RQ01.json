 "questions": [
  {
   "id": 614806,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the fiscal consequences of the French and Indian War?",
   "answers": [
    {
     "id": 1167197,
     "content_html": "The French and Indian War caused the Northwest Territories to be absorbed into the British colonial government, leading to an increase in British resources."
    },
    {
     "id": 1167198,
     "content_html": "The French and Indian War exploded the British national debt and tax burden, leading to Parliament’s decision to tax the colonies to pay the war’s cost."
    },
    {
     "id": 1167196,
     "content_html": "The French and Indian War caused the colonies to realize their economic self-sufficiency and allowed colonial governments to impose taxes upon their citizens."
    },
    {
     "id": 1167195,
     "content_html": "The French and Indian War resulted in a British loss, which left the British economically indebted to France and forced them to use the colonies to pay this debt."
    }
   ],
