   "stimulus_html": "",
   "stem_html": "This excerpt from John Winthrop’s sermon, given while en route to the Massachusetts Bay Colony, might be used by a historian to support the development of which of the following ideas in U.S. history?",
   "answers": [
    {
     "id": 1167013,
     "content_html": "Separation of church and state"
    },
    {
     "id": 1167012,
     "content_html": "Limited government"
    },
    {
     "id": 1167011,
     "content_html": "Abolition"
    },
    {
     "id": 1167014,
     "content_html": "American exceptionalism"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614761,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best expresses the main idea of the excerpt provided?",
   "answers": [
    {
     "id": 1167018,
     "content_html": "We must serve as an example to others."
    },
    {
     "id": 1167017,
     "content_html": "We will triumph over our enemies"
    },
    {
     "id": 1167016,
     "content_html": "Others will praise us for our piety."
    },
    {
     "id": 1167015,
     "content_html": "We must endure persecution for our beliefs."
    }
   ],
