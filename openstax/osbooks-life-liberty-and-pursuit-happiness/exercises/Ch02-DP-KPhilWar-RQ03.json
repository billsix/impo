  {
   "id": 614754,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following contributed to the start of King Philip’s War in 1674 except",
   "answers": [
    {
     "id": 1166989,
     "content_html": "the general decline of American Indian power in the region"
    },
    {
     "id": 1166988,
     "content_html": "the suspicious death of Phillip’s (Metacom’s) brother"
    },
    {
     "id": 1166987,
     "content_html": "the terrorizing of English cattle by Phillip’s warriors"
    },
    {
     "id": 1166990,
     "content_html": "inefficient interpreters from France who generated tension between the American Indians and the English"
    }
   ],
