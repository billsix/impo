 "stimulus_html": "<figure id=\"fig2_14\">\n<img src=\"exercises/media/ac3996f397ee7e08.png\" alt=\"The cartoon shows Boss Tweed with a money bag as his head and a dollar sign as his face. The caption at the bottom of the cartoon reads “The ‘Brains’ that achieved the Tammany victory at the Rochester Democratic Convention.”\">\n<figcaption>Thomas Nast depicts Boss Tweed in <i>Harper’s Weekly</i> (October 21, 1871).</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 615684,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Thomas Nast’s intent in drawing the political cartoon was to",
   "answers": [
    {
     "id": 1170704,
     "content_html": "demonstrate the generosity of the political boss in the late nineteenth century"
    },
    {
     "id": 1170705,
     "content_html": "show how corrupt Boss Tweed and Tammany Hall were in New York politics"
    },
    {
     "id": 1170703,
     "content_html": "illustrate the greed of industrialists during the late nineteenth century"
    },
    {
     "id": 1170702,
     "content_html": "show how honest politicians were"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615685,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following emerged to seek to correct the problems created by the situation lampooned in the cartoon?",
   "answers": [
    {
     "id": 1170708,
     "content_html": "The Populist movement"
    },
    {
     "id": 1170709,
     "content_html": "The Progressive Era"
    },
    {
     "id": 1170707,
     "content_html": "The Know Nothings"
    },
    {
     "id": 1170706,
     "content_html": "The Second Great Awakening"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 615686,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which group probably benefited most from the situation portrayed in the cartoon?",
