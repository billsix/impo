   "stimulus_html": "",
   "stem_html": "All of the following are true of Rosa Parks except",
   "answers": [
    {
     "id": 1173443,
     "content_html": "she served as secretary of the Montgomery NAACP"
    },
    {
     "id": 1173442,
     "content_html": "she trained young people in civil rights activism"
    },
    {
     "id": 1173444,
     "content_html": "she unintentionally challenged the bus segregation laws of Montgomery"
    },
    {
     "id": 1173441,
     "content_html": "she was well-trained in civil disobedience"
    }
