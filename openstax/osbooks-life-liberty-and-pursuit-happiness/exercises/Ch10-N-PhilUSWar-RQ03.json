 "questions": [
  {
   "id": 615935,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How did the concept of social Darwinism affect the Philippine-American War?",
   "answers": [
    {
     "id": 1171709,
     "content_html": "It provided a pseudoscientific justification for colonial domination based on racial superiority."
    },
    {
     "id": 1171708,
     "content_html": "It advocated for the creation of a two-ocean navy in the aftermath of Spanish-American War."
    },
    {
     "id": 1171707,
     "content_html": "It supported American imperialism within the Western Hemisphere, not outside it."
    },
    {
     "id": 1171706,
     "content_html": "It rejected military force and hastened the end of the conflict."
    }
   ],
