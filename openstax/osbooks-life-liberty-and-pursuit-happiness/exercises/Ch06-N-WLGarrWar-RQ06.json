 "questions": [
  {
   "id": 615329,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did Garrison apologize for advocating gradual emancipation?",
   "answers": [
    {
     "id": 1169289,
     "content_html": "He came to believe that because slavery was a national sin, it was unjust and cowardly to do anything less than demand an immediate end to it."
    },
    {
     "id": 1169288,
     "content_html": "Because slaveholders had invested significant amounts of money in purchasing and providing for their slaves, it would be unjust to deprive them of their property without compensating them in some way."
    },
    {
     "id": 1169287,
     "content_html": "Slavery was on its way to extinction anyway, and it would be wise to simply allow it to fade away as agriculture in the South became more mechanized."
    },
    {
     "id": 1169286,
     "content_html": "It was not feasible to move all slaves and descendants of slaves to Africa, because, by the 1830s, most enslaved people had no knowledge of Africa."
    }
   ],
