 "questions": [
  {
   "id": 616272,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A reason to use atomic weapons against Japan in the summer of 1945 was that",
   "answers": [
    {
     "id": 1173056,
     "content_html": "the projected loss of approximately one million lives during an American invasion of Japan was unacceptable"
    },
    {
     "id": 1173055,
     "content_html": "a blockade to starve Japan into surrender was impractical because the Japanese merchant fleet could easily supply the country with food and other needs"
    },
    {
     "id": 1173054,
     "content_html": "use of the bomb was included in an agreement between the United States and the Soviet Union about how to conclude fighting in the Pacific Theater"
    },
    {
     "id": 1173053,
     "content_html": "the Japanese had hinted they were willing to surrender after Iwo Jima and Okinawa"
    }
   ],
