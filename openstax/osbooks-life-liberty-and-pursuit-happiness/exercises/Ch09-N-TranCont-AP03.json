   ],
   "combo_choices": []
  },
  {
   "id": 615677,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to this author, the only event in American history more exciting than the ceremony he describes was",
   "answers": [
    {
     "id": 1170677,
     "content_html": "the colonies’ commitment to break away from England"
    },
    {
     "id": 1170676,
     "content_html": "the completion of the Constitution"
    },
    {
     "id": 1170675,
     "content_html": "the celebration of victory after the Revolutionary War"
    },
    {
     "id": 1170674,
     "content_html": "the New Era that began following the Civil War"
    }
   ],
