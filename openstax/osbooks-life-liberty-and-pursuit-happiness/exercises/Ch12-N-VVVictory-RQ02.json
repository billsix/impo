   "id": 616232,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During World War II, the Tuskegee Airmen, the Red Ball Express, and the 92nd Regiment Buffalo Soldiers were noteworthy for",
   "answers": [
    {
     "id": 1172896,
     "content_html": "the heroism of their segregated military units"
    },
    {
     "id": 1172895,
     "content_html": "their deployment exclusively in the Pacific Theater of Operations"
    },
    {
     "id": 1172894,
     "content_html": "being fully integrated combat units"
    },
    {
     "id": 1172893,
     "content_html": "being the “service units” that provided and supplied food and maintenance to white combat troops"
    }
   ],
