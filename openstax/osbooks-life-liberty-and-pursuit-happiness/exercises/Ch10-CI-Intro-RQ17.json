   "id": 615877,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When President Woodrow Wilson proposed the Fourteen Points, the Allied nations responded by",
   "answers": [
    {
     "id": 1171476,
     "content_html": "incorporating the idealistic tone of the Fourteen Points into the Treaty of Versailles"
    },
    {
     "id": 1171477,
     "content_html": "rejecting the concept of peace without victory"
    },
    {
     "id": 1171475,
     "content_html": "inviting German representatives to negotiate the Treaty of Versailles"
    },
    {
     "id": 1171474,
     "content_html": "supporting the creation of independent nations from the remains of the Austro-Hungarian empire"
    }
   ],
