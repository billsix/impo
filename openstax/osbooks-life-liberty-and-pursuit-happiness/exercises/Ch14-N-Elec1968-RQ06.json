   "stimulus_html": "",
   "stem_html": "The events of 1968 led President Lyndon B. Johnson to alter his foreign policy by",
   "answers": [
    {
     "id": 1174271,
     "content_html": "escalating the presence of ground troops in Vietnam"
    },
    {
     "id": 1174270,
     "content_html": "dramatically increasing bombing of Laos and Cambodia"
    },
    {
     "id": 1174272,
     "content_html": "promoting peace talks with North Vietnam"
    },
    {
     "id": 1174269,
     "content_html": "expanding the policy of containment in Southeast Asia"
    }
