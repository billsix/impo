 "questions": [
  {
   "id": 616641,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the fate of the Equal Rights Amendment?",
   "answers": [
    {
     "id": 1174104,
     "content_html": "It was never ratified by the required 38 states."
    },
    {
     "id": 1174103,
     "content_html": "It became law in 1982."
    },
    {
     "id": 1174102,
     "content_html": "It was overturned by the Supreme Court in 1992."
    },
    {
     "id": 1174101,
     "content_html": "It was unnecessary because women already had equal rights under the Nineteenth Amendment."
    }
   ],
