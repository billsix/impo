   "stimulus_html": "",
   "stem_html": "An important cause of the Homestead Steel Strike in 1892 was that",
   "answers": [
    {
     "id": 1170580,
     "content_html": "Henry Clay Frick deployed the Pinkertons before attempts to negotiate with AA"
    },
    {
     "id": 1170581,
     "content_html": "Henry Clay Frick locked the workers out of the mill after negotiations failed"
    },
    {
     "id": 1170579,
     "content_html": "the American Federation of Labor encouraged AA to strike"
    },
    {
     "id": 1170578,
     "content_html": "an assassination attempt on Henry Clay Frick created chaos in the mill"
    }
