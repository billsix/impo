   "id": 614809,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the main purpose of the Stamp Act Congress?",
   "answers": [
    {
     "id": 1167209,
     "content_html": "To declare independence from the British government"
    },
    {
     "id": 1167208,
     "content_html": "To develop a new Constitution to govern the colonies"
    },
    {
     "id": 1167207,
     "content_html": "To establish the Stamp Act and other tax legislation"
    },
    {
     "id": 1167210,
     "content_html": "To formalize the colonial complaints against Parliament"
    }
   ],
