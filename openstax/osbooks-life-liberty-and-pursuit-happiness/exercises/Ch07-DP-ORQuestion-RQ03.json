   "stem_html": "In the Oregon Treaty, Great Britain and the United States agreed to an international boundary at ",
   "answers": [
    {
     "id": 1170188,
     "content_html": "the Columbia River\n"
    },
    {
     "id": 1170187,
     "content_html": "the line of 54°40′ north latitude\n"
    },
    {
     "id": 1170186,
     "content_html": "the 49th parallel exclusively\n"
    },
    {
     "id": 1170189,
     "content_html": "the 49th parallel, but with Britain retaining all of Vancouver Island\n"
    }
