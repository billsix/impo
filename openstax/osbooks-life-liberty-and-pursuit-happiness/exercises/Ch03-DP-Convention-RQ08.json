 "questions": [
  {
   "id": 614934,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following describes the primary issue that galvanized nationalists to try to reform the Articles of Confederation?",
   "answers": [
    {
     "id": 1167709,
     "content_html": "The government’s inability to regulate interstate and foreign commerce, especially in the face of economic adversity"
    },
    {
     "id": 1167708,
     "content_html": "Excessive printing of a national currency, causing inflation and speculation"
    },
    {
     "id": 1167707,
     "content_html": "Inept handling of the admission of new states into the union"
    },
    {
     "id": 1167706,
     "content_html": "Increased taxation on foreign goods, making them more expensive than citizens could afford"
    }
   ],
