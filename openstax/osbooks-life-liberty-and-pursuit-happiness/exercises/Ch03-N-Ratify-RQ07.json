  {
   "id": 614899,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Many Anti-Federalists argued that the Constitution’s strong national government was",
   "answers": [
    {
     "id": 1167568,
     "content_html": "absolutely necessary to protect the sovereignty of the nation"
    },
    {
     "id": 1167569,
     "content_html": "too similar to the monarchy from which colonists had fought to be free"
    },
    {
     "id": 1167567,
     "content_html": "carefully crafted to prevent any abuses of private citizens"
    },
    {
     "id": 1167566,
     "content_html": "akin to the Articles of Confederation, which required no change"
    }
   ],
