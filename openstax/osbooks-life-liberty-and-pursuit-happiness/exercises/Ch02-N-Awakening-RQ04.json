 "questions": [
  {
   "id": 614718,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Who were the “Old Lights”?",
   "answers": [
    {
     "id": 1166845,
     "content_html": "People who read books from the Enlightenment and did not attend church or meeting on Sundays"
    },
    {
     "id": 1166844,
     "content_html": "Jewish residents of Newport, Rhode Island"
    },
    {
     "id": 1166843,
     "content_html": "Elderly people admired for their knowledge of the Bible and scripture"
    },
    {
     "id": 1166846,
     "content_html": "Ministers and their parishioners who insisted upon sober and rational religious practices and rejected the style of the evangelical preachers"
    }
   ],
