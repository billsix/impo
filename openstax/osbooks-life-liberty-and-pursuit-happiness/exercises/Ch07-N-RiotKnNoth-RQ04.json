 "questions": [
  {
   "id": 615491,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best characterizes immigration to the United States from 1840 to 1860?",
   "answers": [
    {
     "id": 1169936,
     "content_html": "It dropped to all-time lows due to international financial panics.\n"
    },
    {
     "id": 1169937,
     "content_html": "It surged, with most European immigrants coming from Ireland and the German states.\n"
    },
    {
     "id": 1169935,
     "content_html": "The majority of immigrants came from countries in the Western Hemisphere.\n"
    },
    {
     "id": 1169934,
     "content_html": "It suffered a net decline (i.e., more people left the country than came in) as economic opportunity improved in Europe.\n"
    }
   ],
