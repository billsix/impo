 "questions": [
  {
   "id": 615395,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Panic of 1819 was a turning point in U.S. economic history because",
   "answers": [
    {
     "id": 1169552,
     "content_html": "it guaranteed the election of Andrew Jackson as president"
    },
    {
     "id": 1169551,
     "content_html": "it resulted in the decision in <i>McCulloch v. Maryland</i>, stating the Bank of the United States was constitutional"
    },
    {
     "id": 1169553,
     "content_html": "it demonstrated to “hard currency” supporters that only gold- and silver-backed currency would maintain a viable economy, giving credence to Jackson’s beliefs about the national bank in the 1830s"
    },
    {
     "id": 1169550,
     "content_html": "it led to the nomination of Henry Clay, who, as president, would have guaranteed the continuation of the Bank of the United States"
    }
   ],
