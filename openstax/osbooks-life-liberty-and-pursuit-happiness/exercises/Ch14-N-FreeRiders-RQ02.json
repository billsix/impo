   "stimulus_html": "",
   "stem_html": "Freedom riders from the early 1960s were best known for",
   "answers": [
    {
     "id": 1173943,
     "content_html": "inciting violent protests against urban policing policies"
    },
    {
     "id": 1173942,
     "content_html": "providing transportation to those participating in the Montgomery bus boycott"
    },
    {
     "id": 1173941,
     "content_html": "boycotting travel on segregated buses across the South"
    },
    {
     "id": 1173944,
     "content_html": "challenging segregated seating on interstate bus routes"
    }
