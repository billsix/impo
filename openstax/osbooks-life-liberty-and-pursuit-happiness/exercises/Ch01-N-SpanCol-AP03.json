 "stimulus_html": "<figure>\n<img src=\"exercises/media/7ecdcc89757c4fd5.png\" alt=\"An image shows a drawing of Native Americans working the land, plowing and harvesting.\">\n<figcaption>A depiction of Native Americans working in Tucumán (Argentina).</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 614608,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Native Americans in this image were most likely",
   "answers": [
    {
     "id": 1166403,
     "content_html": "treated respectfully by their employers and paid a fair wage\n"
    },
    {
     "id": 1166404,
     "content_html": "contributing to a society that promoted equality among races and sexes\n"
    },
    {
     "id": 1166405,
     "content_html": "extracting natural resources for their own personal gain\n"
    },
    {
     "id": 1166406,
     "content_html": "working for the Spaniards as part of their encomienda tribute\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614609,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The main purpose of the system depicted in this image was to",
   "answers": [
    {
     "id": 1166407,
     "content_html": "establish a racial hierarchy for social situations\n"
    },
    {
     "id": 1166408,
     "content_html": "alleviate the disputes that occurred between Native Americans and Spaniards\n"
    },
    {
     "id": 1166410,
     "content_html": "govern and tax the native communities\n"
    },
    {
     "id": 1166409,
     "content_html": "create a tolerant community with multiple religions and ways of governing\n"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
