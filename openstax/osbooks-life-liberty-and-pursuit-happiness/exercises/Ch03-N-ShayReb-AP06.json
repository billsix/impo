 "is_vocab": false,
 "stimulus_html": "<p>“II. Each state retains its sovereignty, freedom, and independence, and every power, jurisdiction, and right, which is not by this Confederation expressly delegated to the United States, in Congress assembled.</p>\n<p>III. The said States hereby severally enter into a firm league of friendship with each other, for their common defense, the security of their liberties, and their mutual and general welfare, binding themselves to assist each other, against all force offered to, or attacks made upon them, or any of them, on account of religion, sovereignty, trade, or any other pretense whatever.”</p>\n<p align=\"right\">Articles of Confederation, 1781</p>\n<p><i>Refer to the excerpt provided.</i></p>",
 "questions": [
  {
   "id": 614987,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was the main intent of the second article of the Articles of Confederation?",
   "answers": [
    {
     "id": 1167921,
     "content_html": "Prevent a tyrannical leader from usurping power, like the king of England did"
    },
    {
     "id": 1167920,
     "content_html": "Create a powerful national government with the power to defend its borders"
    },
    {
     "id": 1167919,
     "content_html": "Articulate a Bill of Rights that would protect each citizen from oppression"
    },
    {
     "id": 1167918,
     "content_html": "Establish a flexible government that could share power between state and federal levels"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 614988,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the impact on Shays’ Rebellion of the central government under the Articles of Confederation?",
   "answers": [
    {
     "id": 1167925,
     "content_html": "The national government lacked the power by which it could bring order to the troubled states."
    },
    {
     "id": 1167924,
     "content_html": "The league of friendship created an interstate alliance that required nearby New England militias to support Massachusetts."
    },
    {
     "id": 1167923,
     "content_html": "Excessive tax collection by the federal government brought an influx of funds, allowing the state to lower its tax rates."
    },
    {
     "id": 1167922,
     "content_html": "The farmers’ liberties were secured by the Articles because they were protected by freedom of speech, petition, and assembly."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
