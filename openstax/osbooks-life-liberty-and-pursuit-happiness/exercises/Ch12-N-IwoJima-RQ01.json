   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "American forces launched an assault to capture the island of Iwo Jima in February 1945 because",
   "answers": [
    {
     "id": 1172963,
     "content_html": "the island was an important Japanese naval base"
    },
    {
     "id": 1172962,
     "content_html": "Iwo Jima was one of the Japanese home islands"
    },
    {
     "id": 1172961,
     "content_html": "capturing Iwo Jima would convince the Japanese to immediately surrender"
    },
    {
     "id": 1172964,
     "content_html": "the airfields located on Iwo Jima had strategic importance"
    }
