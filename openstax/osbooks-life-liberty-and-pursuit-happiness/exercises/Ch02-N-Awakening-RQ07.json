 "questions": [
  {
   "id": 614721,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "George Whitefield was immensely popular as a preacher in the colonies because",
   "answers": [
    {
     "id": 1166857,
     "content_html": "he explained the intricacies of Christian doctrine with great precision and erudition"
    },
    {
     "id": 1166856,
     "content_html": "he preached to small groups so he could get to know his audience"
    },
    {
     "id": 1166858,
     "content_html": "he appealed to the emotions of his listeners, many of whom experienced the “new birth” of evangelical conversion"
    },
    {
     "id": 1166855,
     "content_html": "he made his listeners feel good about themselves and reassured them that they would be admitted to Heaven"
    }
   ],
