 "questions": [
  {
   "id": 615493,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which characteristic distinguished most German immigrants from their Irish counterparts in the antebellum period? ",
   "answers": [
    {
     "id": 1169944,
     "content_html": "German immigrants were primarily Catholics.\n"
    },
    {
     "id": 1169945,
     "content_html": "German immigrants had more professionals and artisans in their ranks.\n"
    },
    {
     "id": 1169943,
     "content_html": "German immigrants had no political aspirations.\n"
    },
    {
     "id": 1169942,
     "content_html": "German immigrants were more likely to settle in northeastern port cities.\n"
    }
   ],
