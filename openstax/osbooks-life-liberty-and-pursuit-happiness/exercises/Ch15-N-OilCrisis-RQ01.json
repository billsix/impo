   "stem_html": "Why did the Yom Kippur War produce the first oil embargo in 1973?",
   "answers": [
    {
     "id": 1174776,
     "content_html": "President Nixon supported Israel."
    },
    {
     "id": 1174775,
     "content_html": "The Soviet Union ordered OPEC to embargo oil."
    },
    {
     "id": 1174774,
     "content_html": "The price of oil declined because of the war."
    },
    {
     "id": 1174773,
     "content_html": "Saudi Arabia needed the hard currency."
    }
