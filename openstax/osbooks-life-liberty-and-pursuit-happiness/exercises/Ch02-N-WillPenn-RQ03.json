   "id": 614682,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "All the following were reasons American Indian groups were willing to engage with William Penn except",
   "answers": [
    {
     "id": 1166701,
     "content_html": "decades of disease had reduced their numbers"
    },
    {
     "id": 1166700,
     "content_html": "they sought an alliance to protect them from larger nearby tribes"
    },
    {
     "id": 1166699,
     "content_html": "Penn conducted fair business transactions with the American Indians"
    },
    {
     "id": 1166702,
     "content_html": "they saw an opportunity for conquest over the English colonizers"
    }
   ],
