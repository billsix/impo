   "id": 614878,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Virginia Statute of Religious Freedom did all the following except",
   "answers": [
    {
     "id": 1167484,
     "content_html": "provide an example for the other states that wanted to discontinue an established church"
    },
    {
     "id": 1167483,
     "content_html": "inspire James Madison to include it in the First Amendment of the Bill of Rights"
    },
    {
     "id": 1167482,
     "content_html": "end the established church in Virginia"
    },
    {
     "id": 1167485,
     "content_html": "create a severe backlash from devout Baptists, who continued to protest the loss of religious influence on government for decades"
    }
   ],
