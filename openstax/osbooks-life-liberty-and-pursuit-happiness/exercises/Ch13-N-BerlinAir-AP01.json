 "stimulus_html": "<figure>\n<img src=\"exercises/media/cb0c50c215d78390.png\" alt=\"A group of people look up at a low-flying plane.\">\n<figcaption>Berliners watching a C-54 land at Berlin Tempelhof Airport, 1948.</figcaption>\n</figure>\n<p><i>Refer to the image provided.</i></p>",
 "questions": [
  {
   "id": 616323,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The context surrounding the events portrayed in the photograph included all the following except",
   "answers": [
    {
     "id": 1173259,
     "content_html": "the end of a major world conflict"
    },
    {
     "id": 1173258,
     "content_html": "the Cold War"
    },
    {
     "id": 1173260,
     "content_html": "American support for a Democratic Poland"
    },
    {
     "id": 1173257,
     "content_html": "the development of a policy of containment"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616324,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The events in the image arose most directly from",
   "answers": [
    {
     "id": 1173263,
     "content_html": "the desire of the United States to rebuild Europe after World War I"
    },
    {
     "id": 1173264,
     "content_html": "the objective of the United States and its allies to protect people in weaker allied nations"
    },
    {
     "id": 1173262,
     "content_html": "the policy of using American pro-democracy propaganda to force newly communist nations to overthrow their governments"
    },
    {
     "id": 1173261,
     "content_html": "the American desire to occupy all of Germany after World War II"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  },
  {
   "id": 616325,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the key difference between American policy after World War I and the policy depicted in the provided photograph?",
   "answers": [
    {
     "id": 1173268,
     "content_html": "After World War I, the United States was more isolated than after World War II."
    },
    {
     "id": 1173267,
     "content_html": "After World War I, the United States wanted to actively prevent the spread of communism."
    },
    {
     "id": 1173266,
     "content_html": "After World War II, the United States decided it needed to rebuild Germany on its own."
    },
    {
     "id": 1173265,
     "content_html": "After World War II, the American people demanded a return to <i>laissez-faire</i> capitalism."
    }
   ],
