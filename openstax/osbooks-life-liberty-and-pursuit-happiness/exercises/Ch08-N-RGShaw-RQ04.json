   "stimulus_html": "",
   "stem_html": "The significance of the Battle of Fort Wagner was that",
   "answers": [
    {
     "id": 1171001,
     "content_html": "capturing the fort was necessary to capturing Charleston, South Carolina"
    },
    {
     "id": 1171000,
     "content_html": "it became the turning point of the war in the Deep South"
    },
    {
     "id": 1170999,
     "content_html": "it had little military significance"
    },
    {
     "id": 1170998,
     "content_html": "it resulted in a major Union victory"
    }
