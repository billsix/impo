 "questions": [
  {
   "id": 614756,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which best explains what happened to King Philip (Metacom) during the war?",
   "answers": [
    {
     "id": 1166997,
     "content_html": "He successfully led his people to triumph, halting English advancement on American Indian lands."
    },
    {
     "id": 1166996,
     "content_html": "He retreated to Canada, never to be seen or heard from again."
    },
    {
     "id": 1166998,
     "content_html": "He was found and murdered by English leader Benjamin Church."
    },
    {
     "id": 1166995,
     "content_html": "He was sold into slavery and toiled in sugar cane fields until his death."
    }
   ],
