 "questions": [
  {
   "id": 614930,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What group was especially open to the idea of a more powerful central government, because of their experience during the Revolutionary War?",
   "answers": [
    {
     "id": 1167692,
     "content_html": "Women who had supported the troops by sewing clothes, providing food, and even fighting on the frontlines but were never recognized by the current government"
    },
    {
     "id": 1167691,
     "content_html": "African Americans who had fought in the war but were never given the freedom they were promised"
    },
    {
     "id": 1167693,
     "content_html": "Veterans who had suffered without adequate food, supplies, and compensation and were acutely aware of the need for a stronger governmental authority"
    },
    {
     "id": 1167690,
     "content_html": "Children who had been orphaned during the war and desired an authority figure to guide them through their early adult years"
    }
   ],
