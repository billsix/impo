 "questions": [
  {
   "id": 615334,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Despite poor odds for success, what indication did Nat Turner say led him to believe the time was right to lead a slave rebellion?",
   "answers": [
    {
     "id": 1169308,
     "content_html": "Several enslaved people independently came to Turner and whispered that they would join a revolt if he would lead it."
    },
    {
     "id": 1169309,
     "content_html": "He believed God used nature to give him a sign that the time had come."
    },
    {
     "id": 1169307,
     "content_html": "Unrest among slaves led many to be ready to risk everything to gain their freedom."
    },
    {
     "id": 1169306,
     "content_html": "Plantation owners throughout the South had gradually become much harsher in their treatment of enslaved workers by 1830."
    }
   ],
