     "id": 1172228,
     "content_html": "he opposed negative campaigning"
    },
    {
     "id": 1172229,
     "content_html": "he emulated his progressive predecessors"
    },
    {
     "id": 1172227,
     "content_html": "he sorted out the Teapot Dome scandal with bipartisan support"
    },
    {
     "id": 1172226,
     "content_html": "he supported lower taxes and a balanced budget"
    }
