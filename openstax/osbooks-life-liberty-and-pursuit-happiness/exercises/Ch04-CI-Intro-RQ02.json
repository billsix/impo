   "id": 615033,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The majority of those who opposed Alexander Hamilton’s financial plan were found in the ____________.",
   "answers": [
    {
     "id": 1168104,
     "content_html": "South because the plan suggested the gradual abolition of slavery"
    },
    {
     "id": 1168105,
     "content_html": "South because southerners feared the plan would lead to a stronger centralized national government"
    },
    {
     "id": 1168103,
     "content_html": "West because veterans who bought old debt certificates would not receive face value upon redemption"
    },
    {
     "id": 1168102,
     "content_html": "West because frontier settlers thought the plan favored the merchant class"
    }
   ],
