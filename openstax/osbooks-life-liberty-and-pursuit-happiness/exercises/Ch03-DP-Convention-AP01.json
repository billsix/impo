   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following gives the excerpt historical context?",
   "answers": [
    {
     "id": 1168077,
     "content_html": "Ineffective government control of interstate commerce and chaotic domestic rebellions"
    },
    {
     "id": 1168076,
     "content_html": "A successful international alliance with France and the waging of the Revolution"
    },
    {
     "id": 1168075,
     "content_html": "Creation of the Northwest Ordinance Treaty of 1787"
    },
    {
     "id": 1168074,
     "content_html": "Continued respect between British merchants and U.S. manufacturers"
    }
