 "questions": [
  {
   "id": 614921,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was George Washington considered an exceptional choice for commander in chief of the Continental Army?",
   "answers": [
    {
     "id": 1167656,
     "content_html": "Washington’s military prowess was cemented at the Battle of Fort Necessity, where he led a victorious campaign during the French and Indian War."
    },
    {
     "id": 1167657,
     "content_html": "Washington’s southern affiliation would bring in more geographical support for the cause and strengthen the chances of victory."
    },
    {
     "id": 1167655,
     "content_html": "Washington’s affluence meant that he would be able to personally fund much of the army’s needs."
    },
    {
     "id": 1167654,
     "content_html": "Trained from a young age to be a military man, Washington was well versed in multiple styles of fighting the enemy."
    }
   ],
