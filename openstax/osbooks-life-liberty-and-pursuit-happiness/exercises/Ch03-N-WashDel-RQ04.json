 "questions": [
  {
   "id": 614863,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following actions best illustrates Washington’s strategy of innovation and necessity?",
   "answers": [
    {
     "id": 1167426,
     "content_html": "With enlistments ready to expire, Washington led a surprise attack on Christmas morning designed to boost morale and motivate his troops."
    },
    {
     "id": 1167425,
     "content_html": "Knowing his men were exhausted, Washington continued to push them toward Cornwallis to ensure a victory."
    },
    {
     "id": 1167424,
     "content_html": "Given his large army, Washington decided to meet the British in an open battlefield and defeat them using British tactics."
    },
    {
     "id": 1167423,
     "content_html": "Weak with words, Washington successfully inspired his men to reenlist with a ten-dollar bounty."
    }
   ],
