  {
   "id": 616125,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following most directly contributed to the trend depicted in the graph?",
   "answers": [
    {
     "id": 1172469,
     "content_html": "Investors hoping to get rich quickly borrowed to invest more in stocks than they could afford to lose."
    },
    {
     "id": 1172468,
     "content_html": "Massive unemployment beginning in the middle of the 1920s led to a drop in stock prices."
    },
    {
     "id": 1172467,
     "content_html": "The collapse of the banking industry led many banks to foreclose on home loans, eventually leading to the stock market crash."
    },
    {
     "id": 1172466,
     "content_html": "New industries such as steel and oil failed, leading to extreme levels of unemployment."
    }
   ],
