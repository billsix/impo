   "id": 616406,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Like the Truman Doctrine, the Eisenhower Doctrine pledged to",
   "answers": [
    {
     "id": 1173592,
     "content_html": "support governments threatened by Soviet aggression, but specifically in the Middle East"
    },
    {
     "id": 1173591,
     "content_html": "make loans to European countries seeking to rebuild after World War II"
    },
    {
     "id": 1173590,
     "content_html": "act as an intermediary for any nation that wished to remain nonaligned"
    },
    {
     "id": 1173589,
     "content_html": "refrain from selling weapons to any nation that was a potential threat to Israel"
    }
   ],
