  {
   "id": 615574,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The high rate of voter participation in the late nineteenth century existed",
   "answers": [
    {
     "id": 1170264,
     "content_html": "because the major parties disagreed about how to handle strikes and labor organizing"
    },
    {
     "id": 1170265,
     "content_html": "despite the fact that the major parties did not have significant policy differences"
    },
    {
     "id": 1170263,
     "content_html": "because of the success of the Democrats in controlling the office of president"
    },
    {
     "id": 1170262,
     "content_html": "as a result of an increase in African Americans exercising their voting rights"
    }
   ],
