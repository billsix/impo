   "id": 614574,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In practice, the encomienda system created a",
   "answers": [
    {
     "id": 1166270,
     "content_html": "forced labor system to support plantation-based agriculture and mining\n"
    },
    {
     "id": 1166269,
     "content_html": "labor system whereby Native Americans voluntarily paid tribute to their Spanish conquistadors\n"
    },
    {
     "id": 1166268,
     "content_html": "collaborative labor system that encouraged Native Americans and Spaniards to work together\n"
    },
    {
     "id": 1166267,
     "content_html": "labor system that paid Native Americans for their labor on large Spanish construction projects\n"
    }
   ],
