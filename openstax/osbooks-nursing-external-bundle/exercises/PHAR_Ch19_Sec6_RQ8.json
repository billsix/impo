 "questions": [
  {
   "id": 660470,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A Black client with heart failure has recently had their medication regimen changed to the combination medication hydralazine and isosorbide dinitrate. What education does the nurse provide the client?",
   "answers": [
    {
     "id": 1310995,
     "content_html": "This medication regimen will increase afterload.",
     "correctness": "0.0"
    },
    {
     "id": 1310994,
     "content_html": "These two medications increase systemic vascular resistance.",
     "correctness": "0.0"
    },
    {
     "id": 1310996,
     "content_html": "Hydralazine/isosorbide dinitrate works better than other heart failure medications for Black clients.",
     "correctness": "1.0"
    },
    {
     "id": 1310993,
     "content_html": "This medication combination will cause better diuresis.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Research has shown that beta blockers and medications affecting the RAAS do not work as well in the treatment of heart failure for Black clients as hydralazine and isosorbide dinitrate do. "
    }
   ],
   "community_solutions": []
  }
