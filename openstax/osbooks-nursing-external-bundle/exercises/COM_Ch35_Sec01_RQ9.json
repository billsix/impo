 "questions": [
  {
   "id": 647651,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community health nurse works in a clinic that treats clients who lack insurance and have a history of opioid use disorder. Which of the following approaches should the nurse use when working with these clients?",
   "answers": [
    {
     "id": 1276291,
     "content_html": "The nurse should treat these clients the same as other clients.",
     "correctness": "0.0"
    },
    {
     "id": 1276292,
     "content_html": "The nurse should recognize these clients are at high risk for having symptoms related to both mental illness and substance use disorders.",
     "correctness": "1.0"
    },
    {
     "id": 1276290,
     "content_html": "The nurse should focus only on the client’s physical needs related to the opioid use disorder.",
     "correctness": "0.0"
    },
    {
     "id": 1276289,
     "content_html": "The nurse should discourage the use of harm reduction approaches such as needle exchange programs and help the client focus on eliminating their drug use.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Opioid use disorder often co-occurs with mental health disorders, making assessment and treatment complex."
    }
   ],
   "community_solutions": []
  }
