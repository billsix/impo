   "stem_html": "Which concept should the nurse consider when developing community programs to meet the needs of the baby boomer generation?",
   "answers": [
    {
     "id": 1275059,
     "content_html": "The baby boomer population is steadily declining.",
     "correctness": "0.0"
    },
