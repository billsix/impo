 "questions": [
  {
   "id": 367116,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "John’s daughter asks why he can’t just take a vitamin to meet his nutritional needs. Which of the following is the best response by the nurse?",
   "answers": [
    {
     "id": 890329,
     "content_html": "Vitamins and supplements are used as a last resort.",
     "correctness": "0.0"
    },
    {
     "id": 890330,
     "content_html": "Vitamins and supplements do not contain adequate amounts of needed nutrients.",
     "correctness": "0.0"
    },
    {
     "id": 890331,
     "content_html": "Taking vitamins and supplements may be confusing for the client and difficult to remember to take.",
     "correctness": "0.0"
    },
    {
     "id": 890332,
     "content_html": "Research shows that eating a nutrient-rich diet is the best source of micronutrients to support cognition.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Supplementing the diet with micronutrients has been shown to improve cognition in some studies of clients with Alzheimer’s disease, but the best health benefits have been verified with a varied multinutrient-rich diet rather than with supplements alone."
    }
   ],
   "community_solutions": []
  }
 ],
