   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The community health nurse is working with a group of sexual assault survivors. During a group discussion, the nurse offers each client 10 minutes to share their feelings with the group. This action by the nurse is consistent with which of the CDC’s principles of trauma-informed care?",
   "answers": [
    {
     "id": 1276107,
     "content_html": "Cultural, historical, and gender issues",
     "correctness": "0.0"
    },
    {
     "id": 1276106,
     "content_html": "Empowerment and choice",
     "correctness": "0.0"
    },
    {
     "id": 1276105,
     "content_html": "Collaboration and mutuality",
     "correctness": "0.0"
    },
    {
     "id": 1276108,
     "content_html": "Trustworthiness and transparency",
     "correctness": "1.0"
    }
   ],
