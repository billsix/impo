 "questions": [
  {
   "id": 388445,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Now that the client has advanced from stage 2 to 3 CKD, what assessment findings indicate a need to change the current nutritional plan?",
   "answers": [
    {
     "id": 917038,
     "content_html": "GFR of 51 mL/min/1.73 m<sup>2</sup>",
     "correctness": "0.0"
    },
    {
     "id": 917039,
     "content_html": "Symptoms of heart failure",
     "correctness": "1.0"
    },
    {
     "id": 917040,
     "content_html": "No dependent edema",
     "correctness": "0.0"
    },
    {
     "id": 917041,
     "content_html": "Glucose levels that are low",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Symptoms of heart failure create a need to change the plan. In stage 3, if heart failure is present, additional dietary measures are implemented. If they are not present, the same diet can be followed."
    }
   ],
   "community_solutions": []
  }
