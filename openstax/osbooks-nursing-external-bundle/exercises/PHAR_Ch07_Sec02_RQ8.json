   "id": 660343,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with a history of anaphylaxis to sulfonamides is being treated for a urinary tract infection. Which of the following medications is contraindicated in the care of this client?",
   "answers": [
    {
     "id": 1310487,
     "content_html": "Metronidazole",
     "correctness": "0.0"
    },
    {
     "id": 1310486,
     "content_html": "Ciprofloxacin",
     "correctness": "0.0"
    },
    {
     "id": 1310485,
     "content_html": "Cephalexin",
     "correctness": "0.0"
    },
    {
     "id": 1310488,
     "content_html": "Sulfamethoxazole",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sulfamethoxazole contains a sulfonamide group and could cause a cross-sensitivity in the client."
    }
   ],
