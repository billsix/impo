 "questions": [
  {
   "id": 660375,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is assigned to a client with a diagnosis of myasthenia gravis. The client was taking pyridostigmine 1000 mg daily. Due to the exacerbation of their symptoms, the provider increased the dose to 1500 mg daily. What condition should the nurse be assessing?",
   "answers": [
    {
     "id": 1310615,
     "content_html": "Sinus tachycardia",
     "correctness": "0.0"
    },
    {
     "id": 1310614,
     "content_html": "Hypertension",
     "correctness": "0.0"
    },
    {
     "id": 1310616,
     "content_html": "Fluid volume deficit",
     "correctness": "1.0"
    },
    {
     "id": 1310613,
     "content_html": "Fluid volume overload",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because the client’s dose was increased, they are at risk for cholinergic crisis. This is characterized by increased urine output, diarrhea, vomiting, excess salivation, and diaphoresis."
    }
   ],
   "community_solutions": []
  }
 ],
