   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse contacts a provider for a medication order, and the provider enters the order electronically from a remote computer. This is best described as what type of technology?",
   "answers": [
    {
     "id": 1310355,
     "content_html": "Health information technology (HIT)",
     "correctness": "0.0"
    },
    {
     "id": 1310354,
     "content_html": "Protected health information (PHI)",
     "correctness": "0.0"
    },
    {
     "id": 1310356,
     "content_html": "Computerized prescriber order entry (CPOE)",
     "correctness": "1.0"
    },
    {
     "id": 1310353,
     "content_html": "Electronic health record (EHR)",
     "correctness": "0.0"
    }
   ],
