   "id": 660102,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which food preparation technique should the nurse advise a client to use to prevent loss of water-soluble vitamins from the food?",
   "answers": [
    {
     "id": 1309524,
     "content_html": "Use less water in food preparation.",
     "correctness": "1.0"
    },
    {
     "id": 1309523,
     "content_html": "Cook food for a longer time.",
     "correctness": "0.0"
    },
    {
     "id": 1309522,
     "content_html": "Cook at a higher temperature.",
     "correctness": "0.0"
    },
    {
     "id": 1309521,
     "content_html": "Cut food into larger pieces.",
     "correctness": "0.0"
    }
   ],
