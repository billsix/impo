   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is providing education to a client with a total cholesterol of 240 mg/dL. Which of the following diet strategies needs to be included?",
   "answers": [
    {
     "id": 1309867,
     "content_html": "Continue to consume 5–7 alcoholic beverages each week",
     "correctness": "0.0"
    },
    {
     "id": 1309868,
     "content_html": "Decrease intake of red meat and full-fat dairy products",
     "correctness": "1.0"
    },
    {
     "id": 1309866,
     "content_html": "Decrease intake of oatmeal, lentils, and other sources of fiber",
     "correctness": "0.0"
    },
    {
     "id": 1309865,
     "content_html": "Continue the current diet plan— this cholesterol level is within the accepted range",
     "correctness": "0.0"
    }
   ],
