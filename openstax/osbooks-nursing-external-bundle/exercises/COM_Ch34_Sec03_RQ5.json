   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Three generalized groups participate in the creation of health policies: private institutions (micro-level), state- and regional-level agencies and lawmakers (meso-level), and federal agencies and lawmakers (macro-level). At the meso-level, health care policies concern the county, state, or larger geographical region, such as developing vaccination clinics at the state level."
    }
   ],
