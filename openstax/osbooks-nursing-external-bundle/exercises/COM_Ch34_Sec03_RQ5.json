   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action would a nurse perform when involved in the development of health policy at the meso-level?",
   "answers": [
    {
     "id": 1276236,
     "content_html": "Developing free statewide vaccination clinics",
     "correctness": "1.0"
    },
