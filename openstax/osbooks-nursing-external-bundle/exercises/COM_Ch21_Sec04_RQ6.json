   "id": 647508,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is discussing the importance of regular exercise with a client diagnosed with hypertension. The client responds, “I just don’t have the time for exercise.” The nurse determines that the client has which time orientation?",
   "answers": [
    {
     "id": 1275719,
     "content_html": "Past time orientation",
     "correctness": "0.0"
    },
    {
     "id": 1275720,
     "content_html": "Present time orientation",
     "correctness": "1.0"
    },
    {
     "id": 1275718,
     "content_html": "Future time orientation",
     "correctness": "0.0"
    },
    {
     "id": 1275717,
     "content_html": "Lack of time orientation",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Present-oriented people focus on the moment and respond to immediate needs. They live in the here and now, with future consequences playing a less significant role."
    }
   ],
   "community_solutions": []
  }
