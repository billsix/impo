 "questions": [
  {
   "id": 660349,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is talking with a 17-year-old client who states they have heard about vaccines to prevent sexually transmitted infections. Which condition should the nurse tell the client is preventable with vaccination?",
   "answers": [
    {
     "id": 1310511,
     "content_html": "Hepatitis C",
     "correctness": "0.0"
    },
    {
     "id": 1310510,
     "content_html": "HIV",
     "correctness": "0.0"
    },
    {
     "id": 1310512,
     "content_html": "Human papillomavirus",
     "correctness": "1.0"
    },
    {
     "id": 1310509,
     "content_html": "Chlamydia",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "It is important that clients receive the HPV vaccine before becoming sexually active, if possible, to provide maximal protection against the HPV strains most likely to cause cancer."
    }
   ],
   "community_solutions": []
  }
