 "questions": [
  {
   "id": 647503,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action should the nurse take to meet the nutritional needs of a Jewish client?",
   "answers": [
    {
     "id": 1275699,
     "content_html": "Order a kosher meal for the client.",
     "correctness": "0.0",
     "feedback_html": ""
    },
    {
     "id": 1275700,
     "content_html": "Ask the client about their dietary preferences.",
     "correctness": "1.0"
    },
    {
     "id": 1275698,
     "content_html": "Have the meal served on paper plates.",
     "correctness": "0.0"
    },
    {
     "id": 1275697,
     "content_html": "Consult with the dietitian.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Cultural dietary practices are complex and multifaceted. Therefore, the nurse should approach cultural dietary practices with respect and cultural sensitivity and ask the client about their unique dietary needs and preferences. The nurse should not make assumptions."
    }
   ],
   "community_solutions": []
  }
