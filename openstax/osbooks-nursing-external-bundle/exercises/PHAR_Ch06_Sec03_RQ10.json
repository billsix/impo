   "id": 660338,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with rheumatoid arthritis is prescribed adalimumab at a dose of 40 mg every other week. The vials of adalimumab available are labeled as 40 mg per 0.8 mL. How many milliliters should the nurse administer to the client for each dose?",
   "answers": [
    {
     "id": 1310467,
     "content_html": "0.2 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310466,
     "content_html": "0.4 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310465,
     "content_html": "0.6 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310468,
     "content_html": "0.8 mL",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Divide the prescribed dose (40 mg) by the concentration of the adalimumab solution (40 mg/0.8 mL);  <span data-math=\"40\\;\\mathrm{mg}\\;÷\\;40\\;\\mathrm{mg}/0.8\\;\\mathrm{mL}\\;=\\;0.8\\;\\mathrm{mL}\"></span>."
    }
   ],
   "community_solutions": []
  }
 ],
