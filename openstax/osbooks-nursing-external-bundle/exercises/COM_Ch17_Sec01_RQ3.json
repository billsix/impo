   "stem_html": "Which community nursing diagnosis has the nurse written appropriately?",
   "answers": [
    {
     "id": 1275547,
     "content_html": "Ineffective coping related to multiple stressors as evidenced by the client crying and stating she has no support system",
     "correctness": "0.0"
    },
    {
     "id": 1275546,
     "content_html": "Risk of ineffective health maintenance among individuals who do not have access to a primary care provider",
     "correctness": "0.0"
    },
    {
     "id": 1275545,
     "content_html": "Risk of cardiovascular disease related to poor diet, sedentary lifestyle, and lack of access safe places to exercise",
     "correctness": "0.0"
    },
    {
     "id": 1275548,
     "content_html": "Risk of obesity among school-age children related to lack of access to healthy food choices and opportunities for physical activity",
     "correctness": "1.0"
    }
   ],
