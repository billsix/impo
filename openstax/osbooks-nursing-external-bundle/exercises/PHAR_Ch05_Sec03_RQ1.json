   "id": 660326,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is to administer 1 L of 5% dextrose in water (D<sub>5</sub>W) over 6 hours. The IV set delivers 10 drops per milliliter. What is the drip rate per minute that the nurse should set? Round to the nearest whole number.",
   "answers": [
    {
     "id": 1310419,
     "content_html": "27 drops per minute",
     "correctness": "0.0"
    },
    {
     "id": 1310420,
     "content_html": "28 drops per minute",
     "correctness": "1.0"
    },
    {
     "id": 1310418,
     "content_html": "29 drops per minute",
     "correctness": "0.0"
    },
    {
     "id": 1310417,
     "content_html": "30 drops per minute",
     "correctness": "0.0"
    }
   ],
