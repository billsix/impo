   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Convert 1 L to 1000 mL, and then calculate drops needed: <span data-math=\"1000\\;\\mathrm{mL}\\;\\times\\;10\\;\\mathrm{drops}/\\mathrm{mL}\\;=\\;10,000\\;\\mathrm{drops}\"></span>. Then divide the total number of drops by the total number of minutes: <span data-math=\"10,000\\;\\mathrm{drops}\\;÷\\;(6\\;\\mathrm{hours}\\;\\times\\;60\\;\\mathrm{minutes}/\\mathrm{hour})\\;=\\;27.78\\;\\mathrm{drops}/\\mathrm{minute}\"></span>. Round to 28 drops/minute."
    }
   ],
   "community_solutions": []
  }
 ],
