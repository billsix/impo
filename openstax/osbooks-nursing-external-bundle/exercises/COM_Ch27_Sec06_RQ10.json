 "questions": [
  {
   "id": 647572,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The community health nurse preceptor is discussing vulnerable populations with a student. How does the nurse define a vulnerable or disadvantaged population?",
   "answers": [
    {
     "id": 1275975,
     "content_html": "Groups of people with higher mortality rates",
     "correctness": "0.0"
    },
    {
     "id": 1275974,
     "content_html": "Groups with a lower life expectancy",
     "correctness": "0.0"
    },
    {
     "id": 1275976,
     "content_html": "Groups of people who are at increased risk for adverse health outcomes",
     "correctness": "1.0"
    },
    {
     "id": 1275973,
     "content_html": "Groups experiencing homelessness and mental illness",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Disadvantaged populations are groups of individuals with a higher risk for adverse health outcomes. Individuals experiencing homelessness, veterans, LGBTQIA+ populations, migrant workers, individuals with disabilities, and those who have experienced ACEs are all considered disadvantaged populations that increase their risk for significant health disparities."
    }
   ],
   "community_solutions": []
  }
