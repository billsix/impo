   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Because this client already has serious issues with their kidneys, the nurse educates the client’s parents on nutritional measures to prevent further kidney issues that can exacerbate their other conditions. Which option would necessitate the need for further education?",
   "answers": [
    {
     "id": 879479,
     "content_html": "Broccoli",
     "correctness": "0.0"
    },
