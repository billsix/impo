 "questions": [
  {
   "id": 660116,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client asks the nurse about taking supplements for improving memory. Which would be the nurse’s best response?",
   "answers": [
    {
     "id": 1309579,
     "content_html": "“You should start taking fish oil immediately to improve blood flow to your brain.”",
     "correctness": "0.0"
    },
    {
     "id": 1309578,
     "content_html": "“You should start taking a potassium supplement because this will help with nerve conduction.”",
     "correctness": "0.0"
    },
    {
     "id": 1309577,
     "content_html": "“You should start taking zinc because this will help regenerate myelin to help your nervous system.”",
     "correctness": "0.0"
    },
    {
     "id": 1309580,
     "content_html": "“You should review the content of your current diet with the nutritionist.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Although supplements may be beneficial in some cases, most nutrients are best absorbed when they are consumed as regular food. Even though many Americans do not eat a healthy diet, it is best to evaluate current dietary patterns and offer changes before recommending dietary supplements."
    }
   ],
   "community_solutions": []
  }
