 "questions": [
  {
   "id": 375194,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jadalyn was prescribed fluoxetine 20 mg once daily. What is an important point for the nurse to emphasize to Jadalyn when teaching about these drugs?",
   "answers": [
    {
     "id": 900111,
     "content_html": "“Full therapeutic effects usually are seen in the first 2 weeks. If not, the dose can be increased.”",
     "correctness": "0.0"
    },
    {
     "id": 900112,
     "content_html": "“Take this medication in the morning to prevent nighttime insomnia.”",
     "correctness": "1.0"
    },
    {
     "id": 900113,
     "content_html": "“Avoid acetaminophen and take ibuprofen or aspirin when needed for pain or fever.”",
     "correctness": "0.0"
    },
    {
     "id": 900114,
     "content_html": "“This can increase your blood pressure, so notify the provider if you have headaches or blurred vision.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Fluoxetine has a stimulant effect and may interfere with sleep if taken close to bedtime. Therapeutic effects take 4–6 weeks."
    }
   ],
   "community_solutions": []
  }
