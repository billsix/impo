   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching Jamal and their spouse how to choose foods high in omega-3 fatty acids. Which food choices would indicate understanding by the client?",
   "answers": [
    {
     "id": 917358,
     "content_html": "Dairy and eggs",
     "correctness": "0.0"
    },
    {
     "id": 917359,
     "content_html": "Fatty fish and oils",
     "correctness": "0.0"
    },
    {
     "id": 917360,
     "content_html": "Colorful fruits and vegetables",
     "correctness": "1.0"
    },
    {
     "id": 917361,
     "content_html": "Peanut butter and almond butter",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
