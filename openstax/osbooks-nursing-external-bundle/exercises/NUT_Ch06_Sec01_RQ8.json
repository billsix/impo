 "questions": [
  {
   "id": 660125,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is educating a client who is breastfeeding about maternal dietary habits that can promote the infant’s health. Which of the following statements by the client indicates the need for additional instruction?",
   "answers": [
    {
     "id": 1309615,
     "content_html": "“I will be sure to eat some leafy green vegetables.”",
     "correctness": "0.0"
    },
    {
     "id": 1309614,
     "content_html": "“I will drink plenty of fluids throughout the day.”",
     "correctness": "0.0"
    },
    {
     "id": 1309616,
     "content_html": "“I need to eat fewer carbohydrates.”",
     "correctness": "1.0"
    },
    {
     "id": 1309613,
     "content_html": "“I need to eat 300–400 extra calories each day.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Lactating mothers should not restrict carbohydrate intake. They need to eat fruits, vegetables, and complex carbohydrates including whole-grain foods, such as cereals, breads, pastas, and oatmeal."
    }
   ],
   "community_solutions": []
  }
 ],
