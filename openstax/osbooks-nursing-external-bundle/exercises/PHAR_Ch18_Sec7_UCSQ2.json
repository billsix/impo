   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse teaches Hahn about a heart-healthy diet. Which statement by Hahn indicates a need for further teaching?",
   "answers": [
    {
     "id": 886649,
     "content_html": "“I can eat red meat every day.”",
     "correctness": "1.0"
    },
    {
     "id": 886650,
     "content_html": "“I need to reduce my salt intake.” ",
     "correctness": "0.0"
    },
    {
     "id": 886651,
     "content_html": "“Apples and oranges are a good snack option.”",
     "correctness": "0.0"
    },
    {
     "id": 886652,
     "content_html": "“I can replace table salt with dried herbs.”",
     "correctness": "0.0"
    }
   ],
