    {
     "id": 1311436,
     "content_html": "Magnesium citrate",
     "correctness": "1.0"
    },
    {
     "id": 1311435,
     "content_html": "Bisacodyl",
     "correctness": "0.0"
    },
    {
     "id": 1311434,
     "content_html": "Psyllium",
     "correctness": "0.0"
    },
    {
