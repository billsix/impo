  {
   "id": 660471,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with heart failure who takes digoxin. Which assessment finding should the nurse report to the health care provider prior to administering the drug?",
   "answers": [
    {
     "id": 1310999,
     "content_html": "Blood pressure 124/78 mm Hg",
     "correctness": "0.0"
    },
    {
     "id": 1310998,
     "content_html": "Respiratory rate 16 breaths/minute",
     "correctness": "0.0"
    },
    {
     "id": 1310997,
     "content_html": "Temperature 98.2°F",
     "correctness": "0.0"
    },
    {
     "id": 1311000,
     "content_html": "Heart rate 54 beats/minute",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Digoxin is a cardiac glycoside and slows the heart rate. It can cause bradycardia. The health care provider should be notified before administering this drug."
    }
   ],
