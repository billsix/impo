   "id": 647379,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an example of a health disparity?",
   "answers": [
    {
     "id": 1275204,
     "content_html": "BIPOC clients who are pregnant experience the highest rates of infant mortality",
     "correctness": "1.0"
    },
    {
     "id": 1275203,
     "content_html": "Heart disease and cancer are the two leading causes of death across race, gender, and ethnicity",
     "correctness": "0.0"
    },
    {
     "id": 1275202,
     "content_html": "Older adults have worse overall health outcomes compared with young adults",
     "correctness": "0.0"
    },
    {
     "id": 1275201,
     "content_html": "Professional tennis players tend to have a higher prevalence of elbow injuries",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Health disparities are preventable differences in health between groups of individuals, usually as a result of social or economic factors, geographic location, and environment. BIPOC clients who are pregnant experience the highest rates of infant mortality due to a myriad of social and economic disadvantages including racism."
    }
   ],
