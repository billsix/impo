   "id": 660652,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client transitioning from female to male is taking an androgen, and the nurse is concerned that one of their current medications may need to have the dosage adjusted. Which medication is the nurse most likely concerned about?",
   "answers": [
    {
     "id": 1311723,
     "content_html": "Metoprolol",
     "correctness": "0.0"
    },
    {
     "id": 1311724,
     "content_html": "Insulin",
     "correctness": "1.0"
    },
    {
     "id": 1311722,
     "content_html": "Estrogen",
     "correctness": "0.0"
    },
    {
     "id": 1311721,
     "content_html": "Bupropion",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Androgens may decrease blood glucose levels; therefore, any hypoglycemic medication is likely to need a dosage adjustment."
    }
   ],
   "community_solutions": []
  }
