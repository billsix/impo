 "questions": [
  {
   "id": 660583,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client in the clinic is prescribed aluminum hydroxide by the provider. The nurse should include which of the following in the client’s education?",
   "answers": [
    {
     "id": 1311448,
     "content_html": "Take the medication 2 hours before or after other medications.",
     "correctness": "1.0"
    },
    {
     "id": 1311447,
     "content_html": "This medication will put you at risk for respiratory infections like pneumonia.",
     "correctness": "0.0"
    },
    {
     "id": 1311446,
     "content_html": "Stop taking this medication if constipation develops.",
     "correctness": "0.0"
    },
    {
     "id": 1311445,
     "content_html": "You will need lab work to check your blood level of magnesium.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Aluminum hydroxide interferes with the absorption of many medications if taken at the same time."
    }
   ],
   "community_solutions": []
  }
