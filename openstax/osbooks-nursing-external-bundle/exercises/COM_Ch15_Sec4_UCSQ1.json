   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is likely correct regarding the office manager?",
   "answers": [
    {
     "id": 878858,
     "content_html": "They are fostering a culture that values teamwork and collaboration with other departments.",
     "correctness": "0.0"
    },
    {
     "id": 878859,
     "content_html": "They are providing equity in time to all clients to decrease the potential for health disparities.",
     "correctness": "0.0"
    },
    {
     "id": 878860,
     "content_html": "They do not perceive health promotion and disease prevention as a valuable part of health care.",
     "correctness": "1.0"
    },
    {
     "id": 878861,
     "content_html": "They do not have a focus on managing client demand as it relates to the health care system.",
     "correctness": "0.0"
    }
   ],
