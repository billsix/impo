 "questions": [
  {
   "id": 647382,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The community health nurse is looking for a way to improve heart health. Within the framework of the SDOH and upstream thinking, what contributing factor to improving heart health would the nurse most likely focus on within the community?",
   "answers": [
    {
     "id": 1275215,
     "content_html": "Vaping",
     "correctness": "0.0"
    },
    {
     "id": 1275214,
     "content_html": "Low levels of physical activity",
     "correctness": "0.0"
    },
    {
     "id": 1275216,
     "content_html": "Lack of safe places to exercise",
     "correctness": "1.0"
    },
    {
     "id": 1275213,
     "content_html": "Unhealthy diet",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Upstream thinking refers to looking beyond lifestyle choices and instead addressing the root causes of some of the health style choices. For this scenario, having a lack of safe places to exercise is the main driver of the low levels of physical activity."
    }
   ],
   "community_solutions": []
  }
