 "questions": [
  {
   "id": 647386,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community health nurse is working with a group of gay Black clients who are describing some of the negative social interactions they have experienced. This group is likely affected by which of the following:",
   "answers": [
    {
     "id": 1275232,
     "content_html": "Intersectionality",
     "correctness": "1.0"
    },
    {
     "id": 1275231,
     "content_html": "Entitlements",
     "correctness": "0.0"
    },
    {
     "id": 1275230,
     "content_html": "Gender disparities",
     "correctness": "0.0"
    },
    {
     "id": 1275229,
     "content_html": "Racial disparities",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Intersectionality occurs when one type of discrimination intersects with other factors of discrimination, such as gender, ethnicity, socioeconomic status, disability, age, geographic location, gender identity, and sexual orientation, among others."
    }
   ],
   "community_solutions": []
  }
