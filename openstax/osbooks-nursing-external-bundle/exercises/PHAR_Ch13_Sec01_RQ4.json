 "questions": [
  {
   "id": 660404,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client has been taking fluoxetine for 2 weeks. They tell the nurse they do not think the medication is working because they still feel depressed. What is the nurse’s best response?",
   "answers": [
    {
     "id": 1310731,
     "content_html": "“This may not be the best medication for you. Let me call the provider to get something different.”",
     "correctness": "0.0"
    },
    {
     "id": 1310730,
     "content_html": "“You might still be depressed, but you look and sound a lot better.”",
     "correctness": "0.0"
    },
    {
     "id": 1310732,
     "content_html": "“This drug takes about 4–6 weeks before you may see full therapeutic effects.”",
     "correctness": "1.0"
    },
    {
     "id": 1310729,
     "content_html": "“I will call the provider and ask if the dosage can be increased.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The brain has to adapt to these types of drugs. Although a person can feel some benefit in 2 weeks, full effects can take 4–6 weeks. It is important to emphasize this to the client or else they will simply stop taking the drug."
    }
   ],
   "community_solutions": []
  }
 ],
