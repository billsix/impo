   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The Nurse Practice Act is the state’s governing law that determines the scope of practice of nursing that school nurses must follow."
    }
