   "id": 647589,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A school nurse is preparing a presentation to the school board on the scope of practice of the school nurse. Which information will the nurse present?",
   "answers": [
    {
     "id": 1276043,
     "content_html": "The school district’s job description for the school nurse overrides the Nurse Practice Act.",
     "correctness": "0.0"
    },
    {
     "id": 1276044,
     "content_html": "The Nurse Practice Act is a state law that determines the scope of practice for the school nurse.",
     "correctness": "1.0"
    },
    {
     "id": 1276042,
     "content_html": "The scope of nursing practice for the school nurse is the same in every state.",
     "correctness": "0.0"
    },
    {
     "id": 1276041,
     "content_html": "The state medical board decides the scope of practice for the school nurse in each state.",
     "correctness": "0.0"
    }
   ],
