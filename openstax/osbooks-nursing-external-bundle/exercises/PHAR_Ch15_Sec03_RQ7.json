   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is collaborating with a client with a known alcohol use disorder who has recently been prescribed disulfiram. Which clinical effect should the nurse educate the client about if they decide to consume alcohol?",
   "answers": [
    {
     "id": 1310831,
     "content_html": "CNS depression",
     "correctness": "0.0"
    },
    {
     "id": 1310832,
     "content_html": "Flushing",
     "correctness": "1.0"
    },
    {
     "id": 1310830,
     "content_html": "Withdrawal",
     "correctness": "0.0"
    },
    {
     "id": 1310829,
     "content_html": "Seizures",
     "correctness": "0.0"
    }
   ],
