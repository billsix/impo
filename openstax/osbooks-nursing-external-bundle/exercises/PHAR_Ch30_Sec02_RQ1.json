  {
   "id": 660577,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is instructing a client being discharged with a prescription for diphenoxylate with atropine. Which of the following instructions should be given to the client? ",
   "answers": [
    {
     "id": 1311423,
     "content_html": "It will take 2 weeks before the full effects of the medication are achieved.",
     "correctness": "0.0"
    },
    {
     "id": 1311422,
     "content_html": "Take the prescribed amount of medication every day, even if your symptoms improve.",
     "correctness": "0.0"
    },
    {
     "id": 1311424,
     "content_html": "Keep some throat lozenges handy as dry mouth is a common side effect of this medication.",
     "correctness": "1.0"
    },
    {
     "id": 1311421,
     "content_html": "This medication will not make you drowsy.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Dry mouth and other anticholinergic effects are common adverse effects of diphenoxylate with atropine."
    }
   ],
   "community_solutions": []
  }
