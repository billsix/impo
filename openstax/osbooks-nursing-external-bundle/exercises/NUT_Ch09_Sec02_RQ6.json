   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which nursing diagnosis is a priority for an older adult client just diagnosed with nutritional anemia?",
   "answers": [
    {
     "id": 1309748,
     "content_html": "Risk for falls",
     "correctness": "1.0"
    },
    {
     "id": 1309747,
     "content_html": "Risk for imbalanced nutrition, less than body requirements",
     "correctness": "0.0"
    },
    {
     "id": 1309746,
     "content_html": "Frail elderly syndrome, related to malnutrition",
     "correctness": "0.0"
    },
    {
     "id": 1309745,
     "content_html": "Risk for bleeding",
     "correctness": "0.0"
    }
   ],
