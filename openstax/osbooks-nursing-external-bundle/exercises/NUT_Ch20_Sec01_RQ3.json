 "questions": [
  {
   "id": 660265,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching ways to promote healthy teeth in children. Which of the following practices is recommended for children?",
   "answers": [
    {
     "id": 1310175,
     "content_html": "Brush teeth once a day in the morning.",
     "correctness": "0.0"
    },
    {
     "id": 1310174,
     "content_html": "Introduce fluoride toothpaste at 3 years of age.",
     "correctness": "0.0"
    },
    {
     "id": 1310176,
     "content_html": "Brush teeth with a fluoride toothpaste.",
     "correctness": "1.0"
    },
    {
     "id": 1310173,
     "content_html": "Schedule the first dental visit at 1 year of age.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Starting in infancy, parents should brush their children’s teeth at least twice a day with a fluoride toothpaste according to their dentist’s recommendations. The first dental visit should occur no later than the eruption of the first tooth, which happens well before 1 year of age in most children."
    }
   ],
   "community_solutions": []
  }
 ],
