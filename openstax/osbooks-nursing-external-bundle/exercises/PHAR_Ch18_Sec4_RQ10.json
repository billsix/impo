 "questions": [
  {
   "id": 660458,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is preparing to administer carvedilol to a client with hypertension. Which assessment finding should the nurse report to the health care provider before administering the drug?",
   "answers": [
    {
     "id": 1310948,
     "content_html": "Apical heart rate 56 beats/minute",
     "correctness": "1.0"
    },
    {
     "id": 1310947,
     "content_html": "Blood pressure 114/74 mm Hg",
     "correctness": "0.0"
    },
    {
     "id": 1310946,
     "content_html": "Temperature 98.6°F",
     "correctness": "0.0"
    },
    {
     "id": 1310945,
     "content_html": "Respiratory rate 18 breaths/minute",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Carvedilol is a beta-adrenergic blocker and slows the heart rate. A side effect of carvedilol is bradycardia. The health care provider should be notified of bradycardia in a client before the administration of the drug."
    }
   ],
   "community_solutions": []
  }
