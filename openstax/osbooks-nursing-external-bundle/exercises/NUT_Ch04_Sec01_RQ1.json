 "questions": [
  {
   "id": 660103,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with a small bowel obstruction. The client asks why they are experiencing vomiting of stool. What response by the nurse is appropriate?",
   "answers": [
    {
     "id": 1309528,
     "content_html": "The gastrointestinal tract is one long tube, so a blockage will cause contents to move backward.",
     "correctness": "1.0"
    },
    {
     "id": 1309527,
     "content_html": "The pyloric valve prevents stool from flowing into the stomach when the intestines are blocked.",
     "correctness": "0.0"
    },
    {
     "id": 1309526,
     "content_html": "Peristaltic movement prevents the backflow of contents when the intestines are blocked.",
     "correctness": "0.0"
    },
    {
     "id": 1309525,
     "content_html": "Obstruction of the small bowel will not cause vomiting of stool.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because the gastrointestinal tract is a long, hollow tube, closing off the tube in any area causes any contents to flow backward. Stool will backflow into the stomach because it cannot move forward to the anus to exit the body."
    }
   ],
   "community_solutions": []
  }
 ],
