 "questions": [
  {
   "id": 660643,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During an assessment interview, a client reveals they are nonbinary. Which action is the most important one for the nurse to take when working with this client?",
   "answers": [
    {
     "id": 1311688,
     "content_html": "Self-assess personal attitudes toward nonbinary individuals",
     "correctness": "1.0"
    },
    {
     "id": 1311687,
     "content_html": "Review the client’s childhood history for possible sexual abuse",
     "correctness": "0.0"
    },
    {
     "id": 1311686,
     "content_html": "Encourage discussion of the client’s aversion to heterosexual relationships",
     "correctness": "0.0"
    },
    {
     "id": 1311685,
     "content_html": "Explore the client’s family history of gender identity",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The most important action for a nurse caring for transgender and nonbinary clients is to self-assess their own personal attitudes, beliefs, and feelings regarding these clients."
    }
   ],
   "community_solutions": []
  }
 ],
