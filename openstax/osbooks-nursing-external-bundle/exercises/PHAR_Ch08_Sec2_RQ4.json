   "stimulus_html": "",
   "stem_html": "Which statement made by a client indicates to the nurse that the client understands self-care during myelosuppressive chemotherapy?",
   "answers": [
    {
     "id": 1310543,
     "content_html": "“I will include more salads in my diet.”",
     "correctness": "0.0"
    },
    {
