   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Hemoglobin A1C is a lab test that measures how well the client’s glucose has been controlled over a 3-month period. An increased hemoglobin A1C level indicates that the client’s diet needs to be adjusted."
    }
   ],
