 "questions": [
  {
   "id": 660142,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following indicates the diet plan for the client with diabetes type 2 needs to be adjusted?",
   "answers": [
    {
     "id": 1309683,
     "content_html": "The client reports weight loss.",
     "correctness": "0.0"
    },
    {
     "id": 1309682,
     "content_html": "The client’s hemoglobin A1C level has remained at 5.2%.",
     "correctness": "0.0"
    },
    {
     "id": 1309684,
     "content_html": "The client’s hemoglobin A1C has increased  to 9.5%.",
     "correctness": "1.0"
    },
    {
     "id": 1309681,
     "content_html": "The client has not experienced hypoglycemia.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
