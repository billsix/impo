 "questions": [
  {
   "id": 660119,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client admitted with traumatic brain injury develops syndrome of inappropriate antidiuretic hormone (SIADH). The nurse should prioritize which intervention to improve the client’s nutritional status?",
   "answers": [
    {
     "id": 1309591,
     "content_html": "Infuse intravenous fluids rapidly.",
     "correctness": "0.0"
    },
    {
     "id": 1309590,
     "content_html": "Perform a dysphagia screen.",
     "correctness": "0.0"
    },
    {
     "id": 1309592,
     "content_html": "Restrict fluids.",
     "correctness": "1.0"
    },
    {
     "id": 1309589,
     "content_html": "Check the client’s blood glucose level.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client is hyponatremic due to the head injury and is conserving fluids. In addition to fluid restriction, medications may be administered to correct SIADH."
    }
   ],
   "community_solutions": []
  }
