 "questions": [
  {
   "id": 660572,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When assessing a client’s gastrointestinal health, which question should the nurse ask?",
   "answers": [
    {
     "id": 1311403,
     "content_html": "“Do you have problems walking?”",
     "correctness": "0.0"
    },
    {
     "id": 1311404,
     "content_html": "“Have you had an unintended weight gain or loss?”",
     "correctness": "1.0"
    },
    {
     "id": 1311402,
     "content_html": "“Do you have any drug allergies?”",
     "correctness": "0.0"
    },
    {
     "id": 1311401,
     "content_html": "“How many hours do you sleep each night?”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "When assessing a client’s gastrointestinal system, the nurse should ask whether the client has had any unintended weight gain or loss. A change in weight may be due to factors affecting the appetite or the ingestion, digestion, or absorption of nutrients."
    }
   ],
   "community_solutions": []
  }
