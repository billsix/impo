   "id": 365717,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which nonpharmacologic treatment should the nurse anticipate the health care provider will prescribe for the client?",
   "answers": [
    {
     "id": 886633,
     "content_html": "Increase salt intake.",
     "correctness": "0.0"
    },
    {
     "id": 886634,
     "content_html": "Stop smoking.",
     "correctness": "1.0"
    },
    {
     "id": 886635,
     "content_html": "Walk 30–40 minutes twice weekly.",
     "correctness": "0.0"
    },
    {
     "id": 886636,
     "content_html": "Take naproxen sodium for headaches.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
