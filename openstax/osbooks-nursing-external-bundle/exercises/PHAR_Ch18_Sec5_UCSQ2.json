   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client who smokes should be advised to stop smoking to aid in blood pressure control and reduce the risk for coronary artery disease. Other nonpharmacologic treatments for hypertension include weight reduction, salt restriction, exercising 30–40 minutes four times/week, and limiting alcohol intake."
    }
   ],
