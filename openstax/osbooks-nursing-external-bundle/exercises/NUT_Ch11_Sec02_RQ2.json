   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is reviewing a client’s medical record and notes that the last two blood pressure readings were 130/81 mm Hg and 122/99 mm Hg. Which diagnosis does the nurse anticipate for this client?",
   "answers": [
    {
     "id": 1309827,
     "content_html": "Normal blood pressure",
     "correctness": "0.0"
    },
    {
     "id": 1309826,
     "content_html": "Elevated blood pressure",
     "correctness": "0.0"
    },
    {
     "id": 1309825,
     "content_html": "Low blood pressure",
     "correctness": "0.0"
    },
    {
     "id": 1309828,
     "content_html": "Hypertensive blood pressure",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
