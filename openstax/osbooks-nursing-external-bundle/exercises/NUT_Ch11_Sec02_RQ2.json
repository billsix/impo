   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Hypertension is defined as a systolic blood pressure greater than 129 mm Hg and/or a diastolic blood pressure greater than 80 mm Hg."
    }
   ],
