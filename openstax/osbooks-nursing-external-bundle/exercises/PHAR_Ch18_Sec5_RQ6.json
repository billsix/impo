 "questions": [
  {
   "id": 660459,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is providing education to a client who has a new prescription for verapamil. The nurse should instruct the client to avoid which beverage when taking verapamil?",
   "answers": [
    {
     "id": 1310951,
     "content_html": "Milk",
     "correctness": "0.0"
    },
    {
     "id": 1310950,
     "content_html": "Coffee",
     "correctness": "0.0"
    },
    {
     "id": 1310949,
     "content_html": "Tomato juice",
     "correctness": "0.0"
    },
    {
     "id": 1310952,
     "content_html": "Grapefruit juice",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Verapamil is a calcium channel blocker. Grapefruit juice increases blood levels of verapamil by inhibiting its metabolism. The excess amount of medication can intensify the medication’s hypotensive effect, placing the client at an increased risk for syncopal episodes."
    }
   ],
   "community_solutions": []
  }
 ],
