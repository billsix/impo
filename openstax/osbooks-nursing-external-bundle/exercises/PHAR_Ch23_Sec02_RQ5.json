 "questions": [
  {
   "id": 660508,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client with a respiratory disorder that they may have no symptoms initially but will gradually experience shortness of breath with normal day-to-day activities. Which condition is the nurse describing?",
   "answers": [
    {
     "id": 1311147,
     "content_html": "Bronchitis",
     "correctness": "0.0"
    },
    {
     "id": 1311146,
     "content_html": "Pharyngitis",
     "correctness": "0.0"
    },
    {
     "id": 1311145,
     "content_html": "Sinusitis",
     "correctness": "0.0"
    },
    {
     "id": 1311148,
     "content_html": "Emphysema",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Emphysema develops gradually, and many clients have no symptoms at first. Most clients notice shortness of breath when doing normal activities."
    }
   ],
   "community_solutions": []
  }
