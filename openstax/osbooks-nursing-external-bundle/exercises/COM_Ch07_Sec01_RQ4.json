 "questions": [
  {
   "id": 647366,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse works at a clinic that provides care to clients through all stages of heart failure and coordinates transitions of care. Which care delivery model is the clinic using to provide care to clients?",
   "answers": [
    {
     "id": 1275151,
     "content_html": "Collaborative care",
     "correctness": "0.0"
    },
    {
     "id": 1275152,
     "content_html": "Integrated service line",
     "correctness": "1.0"
    },
    {
     "id": 1275150,
     "content_html": "Provider-sponsored health plan",
     "correctness": "0.0"
    },
    {
     "id": 1275149,
     "content_html": "Medical home",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Care delivery models refer to how health care providers work together to provide health care to clients. In the integrated service lines, hospitals and health care systems organize around specific disease states such as heart failure throughout the continuum of client care."
    }
   ],
   "community_solutions": []
  }
