   "id": 660639,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A male high school student who plays on the football team has been referred to the school nurse. He reports feeling anxious and irritable, and his stomach bothers him most of the time. He tells the nurse, “I never had acne problems, but now it’s terrible. And my hair is falling out.” What question by the nurse would be most appropriate?",
   "answers": [
    {
     "id": 1311671,
     "content_html": "“Do you have a family history of depression or anxiety?”",
     "correctness": "0.0"
    },
    {
     "id": 1311670,
     "content_html": "“Are you eating a lot of greasy or spicy foods?”",
     "correctness": "0.0"
    },
    {
     "id": 1311672,
     "content_html": "“Are you taking anything to help you build up your muscle strength?”",
     "correctness": "1.0"
    },
    {
     "id": 1311669,
     "content_html": "“How many hours of sleep are you getting each night?”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Given the context of a high school football player with these signs and symptoms, the nurse should recognize that the student may be misusing steroids. This question can help the nurse further assess the situation."
    }
   ],
