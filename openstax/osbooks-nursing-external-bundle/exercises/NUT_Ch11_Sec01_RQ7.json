   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with a history of cardiac arrest due to torsades de pointes. Which laboratory value is a priority for the nurse to monitor in this client?",
   "answers": [
    {
     "id": 1309811,
     "content_html": "Total cholesterol",
     "correctness": "0.0"
    },
    {
     "id": 1309810,
     "content_html": "Calcium levels",
     "correctness": "0.0"
    },
    {
     "id": 1309812,
     "content_html": "Magnesium levels",
     "correctness": "1.0"
    },
    {
     "id": 1309809,
     "content_html": "Potassium levels",
     "correctness": "0.0"
    }
   ],
   "hints": [],
