   "stimulus_html": "",
   "stem_html": "Clients taking opioid antitussives should be monitored closely for what adverse effect?",
   "answers": [
    {
     "id": 1311191,
     "content_html": "Increased heart rate",
     "correctness": "0.0"
    },
    {
     "id": 1311190,
