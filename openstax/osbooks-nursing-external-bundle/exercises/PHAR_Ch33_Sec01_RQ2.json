 "questions": [
  {
   "id": 660604,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following factors favors glomerular filtration?",
   "answers": [
    {
     "id": 1311531,
     "content_html": "Hydrostatic pressure in the Bowman’s capsule",
     "correctness": "0.0"
    },
    {
     "id": 1311530,
     "content_html": "Oncotic pressure of the glomerular capillaries",
     "correctness": "0.0"
    },
    {
     "id": 1311529,
     "content_html": "Contraction of the mesangial cells",
     "correctness": "0.0"
    },
    {
     "id": 1311532,
     "content_html": "Glomerular capillary hydrostatic pressure",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The hydrostatic pressure in the glomerular capillaries promotes glomerular filtration, whereas the hydrostatic pressure in the Bowman’s capsule and the oncotic pressure of the glomerular capillaries oppose glomerular filtration."
    }
   ],
