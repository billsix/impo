 "questions": [
  {
   "id": 660553,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is assessing a client for type 1 diabetes. Which of the following findings should the nurse expect if the client does, in fact, have diabetes?",
   "answers": [
    {
     "id": 1311327,
     "content_html": "Hemoglobin A1c 5.6%",
     "correctness": "0.0"
    },
    {
     "id": 1311326,
     "content_html": "Fasting blood glucose 101 mg/dL",
     "correctness": "0.0"
    },
    {
     "id": 1311325,
     "content_html": "Random blood glucose 150 mg/dL",
     "correctness": "0.0"
    },
    {
     "id": 1311328,
     "content_html": "Glycosylated hemoglobin 6.8%",
     "correctness": "1.0"
    }
   ],
