   "id": 660251,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is working with a client who has diverticulitis and has been prescribed ciprofloxacin. Which food should this client avoid while taking this medication?",
   "answers": [
    {
     "id": 1310119,
     "content_html": "Red meat",
     "correctness": "0.0"
    },
    {
     "id": 1310120,
     "content_html": "Milk",
     "correctness": "1.0"
    },
    {
     "id": 1310118,
     "content_html": "Tomatoes",
     "correctness": "0.0"
    },
    {
     "id": 1310117,
     "content_html": "Oatmeal",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Ciprofloxacin, frequently used for diverticulitis, should not be taken with calcium-rich or calcium-fortified foods because the calcium can hinder ciprofloxacin’s absorption."
    }
   ],
   "community_solutions": []
  }
