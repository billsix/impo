  {
   "id": 367485,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During testing, Bao is found to have a deficiency in galactose-1-phosphate uridyltransferase. Which change should the nurse expect in Bao’s diet?",
   "answers": [
    {
     "id": 891166,
     "content_html": "None until later in life",
     "correctness": "0.0"
    },
    {
     "id": 891167,
     "content_html": "An increase in the number of breastfeedings daily",
     "correctness": "0.0"
    },
    {
     "id": 891168,
     "content_html": "A switch to a low-protein formula",
     "correctness": "0.0"
    },
    {
     "id": 891169,
     "content_html": "A switch to a lactose-free formula",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Children with galactosemia need to be on a lactose-free diet their entire lives to prevent life-threatening problems."
    }
   ],
   "community_solutions": []
  }
