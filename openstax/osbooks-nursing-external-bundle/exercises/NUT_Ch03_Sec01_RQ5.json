 "questions": [
  {
   "id": 660095,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which information should the nurse give to a client taking high doses of water-soluble vitamins?",
   "answers": [
    {
     "id": 1309495,
     "content_html": "Excess water-soluble vitamins are stored in fatty tissue.",
     "correctness": "0.0"
    },
    {
     "id": 1309494,
     "content_html": "Excess water-soluble vitamins are stored in the liver.",
     "correctness": "0.0"
    },
    {
     "id": 1309493,
     "content_html": "Excess water-soluble vitamins quickly reach toxic levels.",
     "correctness": "0.0"
    },
    {
     "id": 1309496,
     "content_html": "Excess water-soluble vitamins are excreted in the urine.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Excess water-soluble vitamins are excreted in the urine; they are not stored in fatty tissue or the liver."
    }
   ],
   "community_solutions": []
  }
