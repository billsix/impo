    {
     "id": 1311383,
     "content_html": "Early fullness after eating",
     "correctness": "0.0"
    },
    {
     "id": 1311382,
     "content_html": "Heartburn",
     "correctness": "0.0"
    },
    {
     "id": 1311384,
     "content_html": "Aspiration of food",
     "correctness": "1.0"
    },
    {
     "id": 1311381,
     "content_html": "Vomiting",
     "correctness": "0.0"
    }
