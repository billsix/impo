   "id": 660085,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing dietary instruction to a team of college athletes. Which source of energy does the nurse explain is used first during exercise?",
   "answers": [
    {
     "id": 1309456,
     "content_html": "Circulating glucose",
     "correctness": "1.0"
    },
    {
     "id": 1309455,
     "content_html": "Stored glycogen",
     "correctness": "0.0"
    },
    {
     "id": 1309454,
     "content_html": "Skeletal muscle",
     "correctness": "0.0"
    },
    {
     "id": 1309453,
     "content_html": "Fat stores",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "During exercise, circulating glucose is the first source of energy used. When this energy source is depleted, glycogen stored in skeletal muscle is used, followed by fat."
    }
   ],
