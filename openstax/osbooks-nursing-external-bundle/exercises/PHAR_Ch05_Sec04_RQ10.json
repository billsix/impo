   "id": 660332,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client who has been taking St. John’s wort for the management of depression. Which of the following should the nurse instruct the client about regarding the use of St. John’s wort?",
   "answers": [
    {
     "id": 1310443,
     "content_html": "It may cause weight gain and fluid retention.",
     "correctness": "0.0"
    },
    {
     "id": 1310442,
     "content_html": "It is safe to use during pregnancy.",
     "correctness": "0.0"
    },
    {
     "id": 1310441,
     "content_html": "It should be taken with food.",
     "correctness": "0.0"
    },
    {
     "id": 1310444,
     "content_html": "It may interact with other drugs such as antidepressants.",
     "correctness": "1.0"
    }
   ],
