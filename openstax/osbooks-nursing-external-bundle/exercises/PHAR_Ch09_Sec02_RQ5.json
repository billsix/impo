   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is gathering an admission history from a newly admitted client. The nurse observes that the client appears calm and they have relaxed breathing. Which specific part of the nervous system is activated?",
   "answers": [
    {
     "id": 1310583,
     "content_html": "Peripheral nervous system",
     "correctness": "0.0"
    },
    {
     "id": 1310582,
     "content_html": "Sympathetic nervous system",
     "correctness": "0.0"
    },
    {
     "id": 1310584,
     "content_html": "Parasympathetic nervous system",
     "correctness": "1.0"
    },
    {
     "id": 1310581,
     "content_html": "Autonomic nervous system",
     "correctness": "0.0"
    }
   ],
