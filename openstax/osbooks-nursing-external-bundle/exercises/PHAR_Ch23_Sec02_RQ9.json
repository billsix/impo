 "questions": [
  {
   "id": 660511,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client has been diagnosed with COPD and asks why they should quit smoking because the damage has already been done. What is an appropriate response by the nurse?",
   "answers": [
    {
     "id": 1311159,
     "content_html": "“You are right. Quitting now will not do anything to help you.”",
     "correctness": "0.0"
    },
    {
     "id": 1311160,
     "content_html": "“Smoking cessation can prevent further damage and may help heal some lung tissue.”",
     "correctness": "1.0"
    },
    {
     "id": 1311158,
     "content_html": "“You cannot take some of your medications while smoking.”",
     "correctness": "0.0"
    },
    {
     "id": 1311157,
     "content_html": "“Quitting smoking will cure the disease.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Quitting smoking will not cure the disease, but it can prevent more damage."
    }
   ],
   "community_solutions": []
  }
