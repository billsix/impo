 "questions": [
  {
   "id": 660082,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client reports feeling overwhelmed by all the nutrition advice showing up on the client’s social media account feed. How should the nurse respond?",
   "answers": [
    {
     "id": 1309443,
     "content_html": "“Show me what you are looking at on social media.”",
     "correctness": "0.0"
    },
    {
     "id": 1309442,
     "content_html": "“You cannot believe most of what you see online. You should rely on your health care providers for nutrition information.”",
     "correctness": "0.0"
    },
    {
     "id": 1309441,
     "content_html": "“Try not to spend so much time on social media as it is a sedentary activity.”",
     "correctness": "0.0"
    },
    {
     "id": 1309444,
     "content_html": "“It can be overwhelming. Let’s talk about what you should look for to determine if the information is valid and reliable.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "This response acknowledges the client’s feelings and initiates the process of educating the client on how to evaluate nutrition information on social media."
    }
   ],
   "community_solutions": []
  }
 ],
