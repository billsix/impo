   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse anticipates that a client from a culture that values collectivism will utilize which concept when making a health care decision?",
   "answers": [
    {
     "id": 1275735,
     "content_html": "Making an independent decision",
     "correctness": "0.0"
    },
    {
     "id": 1275736,
     "content_html": "Seeking input from the community",
     "correctness": "1.0"
    },
    {
     "id": 1275734,
     "content_html": "Prioritizing mental health needs",
     "correctness": "0.0"
    },
    {
     "id": 1275733,
     "content_html": "Considering all available options",
     "correctness": "0.0"
    }
   ],
