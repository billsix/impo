   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Diltiazem and verapamil have FDA warnings concerning interactions with simvastatin. Diltiazem and verapamil inhibit the metabolism of simvastatin, increasing simvastatin plasma levels and the risk for adverse effects."
    }
   ],
