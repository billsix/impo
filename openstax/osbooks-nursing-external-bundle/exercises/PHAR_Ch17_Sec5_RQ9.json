   "id": 660451,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which antidysrhythmic medication would increase the risk for statin-related adverse effects in a client who takes simvastatin?",
   "answers": [
    {
     "id": 1310919,
     "content_html": "Dofetilide",
     "correctness": "0.0"
    },
    {
     "id": 1310918,
     "content_html": "Metoprolol",
     "correctness": "0.0"
    },
    {
