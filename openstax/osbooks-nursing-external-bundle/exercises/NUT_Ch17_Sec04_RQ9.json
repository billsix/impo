 "questions": [
  {
   "id": 660242,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is reviewing a client’s laboratory results and notices there has been little progress in raising the client’s vitamin K level. Which assessment finding can the nurse directly relate to this continued deficiency?",
   "answers": [
    {
     "id": 1310083,
     "content_html": "Pharyngitis",
     "correctness": "0.0"
    },
    {
     "id": 1310084,
     "content_html": "Ecchymosis",
     "correctness": "1.0"
    },
    {
     "id": 1310082,
     "content_html": "Skin dryness",
     "correctness": "0.0"
    },
    {
     "id": 1310081,
     "content_html": "Weight loss",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Ecchymosis, or bruising, is consistent with vitamin K deficiency because vitamin K is needed for adequate blood clotting."
    }
   ],
   "community_solutions": []
  }
