 "questions": [
  {
   "id": 660412,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 10-year-old child is receiving methylphenidate. The parent tells the nurse the child will not sleep while on the medication. What is the best response?",
   "answers": [
    {
     "id": 1310764,
     "content_html": "“Do not give the medication after 6 p.m.”",
     "correctness": "1.0"
    },
    {
     "id": 1310763,
     "content_html": "“You can give 25 mg diphenhydramine at bedtime.”",
     "correctness": "0.0"
    },
    {
     "id": 1310762,
     "content_html": "“Cut the bedtime dose in half so that it will not interfere with sleep.”",
     "correctness": "0.0"
    },
    {
     "id": 1310761,
     "content_html": "“This is a serious adverse reaction. We will need to contact the provider.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because this drug is a stimulant, it should not be taken near the evening or it will interrupt sleep."
    }
   ],
   "community_solutions": []
  }
