   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The CDC helps to track and investigate foodborne illnesses through the following surveillance systems: PulseNet, Foodborne Diseases Active Surveillance Network (FoodNet), System for Enteric Disease Response, Investigation, and Coordination (SEDRIC), and Foodborne Disease Outbreak Surveillance System."
    }
