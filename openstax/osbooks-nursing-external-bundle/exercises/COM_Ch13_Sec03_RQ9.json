   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which surveillance system would the CDC utilize to track and investigate foodborne illnesses?",
   "answers": [
    {
     "id": 1275412,
     "content_html": "System for Enteric Disease Response, Investigation, and Coordination (SEDRIC)",
     "correctness": "1.0"
    },
    {
     "id": 1275411,
     "content_html": "National Notifiable Disease Surveillance System (NNDSS)",
     "correctness": "0.0"
    },
    {
     "id": 1275410,
     "content_html": "Global Outbreak Alert and Response Network (GOARN)",
     "correctness": "0.0"
    },
    {
     "id": 1275409,
     "content_html": "Waterborne Disease and Outbreak Surveillance System (WBDOSS)",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
