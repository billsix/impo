   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing nutritional counseling to a client planning pregnancy. The nurse should emphasize the importance of consuming what micronutrients to avoid macrocytic anemia?",
   "answers": [
    {
     "id": 1309735,
     "content_html": "Vitamin D",
     "correctness": "0.0"
    },
    {
     "id": 1309734,
     "content_html": "Vitamin E",
     "correctness": "0.0"
    },
    {
     "id": 1309736,
     "content_html": "Folic acid",
     "correctness": "1.0"
    },
    {
     "id": 1309733,
     "content_html": "Vitamin C",
     "correctness": "0.0"
    }
   ],
