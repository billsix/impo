 "questions": [
  {
   "id": 660355,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is reviewing the medical record for a client receiving doxorubicin for breast cancer. The record shows that the client has received a lifetime total of 360 mg/m<sup>2</sup>. Which action should the nurse take?",
   "answers": [
    {
     "id": 1310536,
     "content_html": "Continue with treatment and routine monitoring because this is within safe lifetime dose limits",
     "correctness": "1.0"
    },
    {
     "id": 1310535,
     "content_html": "Call the pharmacy to ask that the cumulative dose be reduced",
     "correctness": "0.0"
    },
    {
     "id": 1310534,
     "content_html": "Notify the provider that the client needs a dose reduction",
     "correctness": "0.0"
    },
    {
     "id": 1310533,
     "content_html": "Notify the client that the next chemotherapy appointment will be delayed",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse should continue with the treatment because the client’s lifetime total of doxorubicin is within the maximum lifetime limit of 550 mg/m<sup>2</sup>."
    }
   ],
   "community_solutions": []
  }
