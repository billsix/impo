  {
   "id": 660205,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a pregnant client who has nutritional deficits. How should the nurse describe the potential fetal effects from maternal malnourishment?",
   "answers": [
    {
     "id": 1309935,
     "content_html": "The fetus will experience lower blood glucose levels.",
     "correctness": "0.0"
    },
    {
     "id": 1309934,
     "content_html": "The fetus will develop a slower-than-normal heart rate.",
     "correctness": "0.0"
    },
    {
     "id": 1309936,
     "content_html": "The fetus may develop cognitive and behavioral delays.",
     "correctness": "1.0"
    },
    {
     "id": 1309933,
     "content_html": "The fetus may experience hormone imbalances.",
     "correctness": "0.0"
    }
   ],
