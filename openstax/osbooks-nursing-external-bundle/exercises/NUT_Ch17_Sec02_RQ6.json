   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing dietary instruction to a client who needs to eat foods that support the gut’s normal microbial growth. Which of the following statements indicates that the client understands the education?",
   "answers": [
    {
     "id": 1310067,
     "content_html": "“I will drink at least a liter of water every day.”",
     "correctness": "0.0"
    },
    {
     "id": 1310068,
     "content_html": "“I will eat yogurt every morning with my breakfast.”",
     "correctness": "1.0"
    },
    {
     "id": 1310066,
     "content_html": "“I will make sure I eat protein at every meal.”",
     "correctness": "0.0"
    },
    {
     "id": 1310065,
     "content_html": "“I will drink an extra glass of milk every day.”",
     "correctness": "0.0"
    }
   ],
