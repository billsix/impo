 "questions": [
  {
   "id": 660294,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The provider has ordered meperidine 150 mg IM every 6 hours, as needed, for pain. The pharmacy supplies meperidine 100 mg/mL. How many mL should the nurse administer to the client?",
   "answers": [
    {
     "id": 1310291,
     "content_html": "1 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310292,
     "content_html": "1.5 mL",
     "correctness": "1.0"
    },
    {
     "id": 1310290,
     "content_html": "2 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310289,
     "content_html": "3.5 mL",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse sets up the following equation: <span data-math=\"D\\;÷\\;H\\; \\times \\;Q\\; = \\;A\"></span>.\n <span data-math=\"D\"></span> represents the desired dose (the dose ordered), <span data-math=\"H\"></span> the amount on hand or available, <span data-math=\"Q\"></span> the quantity or volume of the drug form (tablet, capsule, liquid), and <span data-math=\"A\"></span> the amount calculated to be administered to the client. Therefore, <span data-math=\"150\\;\\text{mg}\\; ÷ \\;100\\;\\text{mg}\\; \\times \\;1\\;\\text{mL}\\; = \\;1.5\\;\\text{mL}\"></span>.\n"
    }
   ],
   "community_solutions": []
  }
