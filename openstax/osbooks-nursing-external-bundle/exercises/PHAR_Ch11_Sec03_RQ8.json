   "id": 660392,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is reviewing discharge instructions with a client with a new prescription for pregabalin. Which of the following points should be included in this discussion?",
   "answers": [
    {
     "id": 1310683,
     "content_html": "Weight loss is noted with prolonged use.",
     "correctness": "0.0"
    },
    {
     "id": 1310682,
     "content_html": "The drug is a first-line treatment for seizure disorders.",
     "correctness": "0.0"
    },
    {
     "id": 1310681,
     "content_html": "Improvement in suicidal ideation is common.",
     "correctness": "0.0"
    },
    {
     "id": 1310684,
     "content_html": "Altered impulse control can result at therapeutic doses.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
