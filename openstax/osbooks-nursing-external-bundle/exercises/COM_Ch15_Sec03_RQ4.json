 "questions": [
  {
   "id": 647446,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An individual who is trying to lose weight is dining out with friends. While looking at the menu, they notice that the restaurant includes calorie content with all menu items. How is this information likely to impact the individual’s menu choices?",
   "answers": [
    {
     "id": 1275471,
     "content_html": "It is a barrier.",
     "correctness": "0.0"
    },
    {
     "id": 1275472,
     "content_html": "It is a cue to action.",
     "correctness": "1.0"
    },
    {
     "id": 1275470,
     "content_html": "It is an innovation.",
     "correctness": "0.0"
    },
    {
     "id": 1275469,
     "content_html": "It is perceived susceptibility.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Cues to action are events, people, or things that trigger people to change behavior. Because the individual has been mindful of their weight loss, this cue is likely to influence their food choices."
    }
   ],
   "community_solutions": []
  }
 ],
