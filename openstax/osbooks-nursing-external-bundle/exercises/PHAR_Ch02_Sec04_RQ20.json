 "questions": [
  {
   "id": 660302,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The provider ordered dobutamine hydrochloride 5 mcg/kg/minute IV for a 132 lb client. The pharmacy supplied 250 mg in 250 mL of D<sub>5</sub>W. How many mL/hour should be infused?",
   "answers": [
    {
     "id": 1310323,
     "content_html": "12 mL/hour",
     "correctness": "0.0"
    },
    {
     "id": 1310322,
     "content_html": "15 mL/hour",
     "correctness": "0.0"
    },
    {
     "id": 1310324,
     "content_html": "18 mL/hour",
     "correctness": "1.0"
    },
    {
     "id": 1310321,
     "content_html": "23 mL/hour",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "First, convert the client’s weight from pounds to kilograms (<span data-math=\"2.2\\;\\text{lb} = 1\\;\\text{kg}\"></span>). Therefore, the client weighs <br>60 kg.<br> Set the equation up in dimensional analysis: <br><span data-math=\"\\frac{{5\\;\\text{mcg}}}{{\\text{kg/min} }} \\;\\times\\; 60\\;\\text{kg}\\; \\times \\;\\frac{{60\\;\\min }}{{1\\;\\text{hour}}}\\; \\times \\;\\frac{{1\\;\\text{mg}}}{{1000\\;\\text{mcg}}}\\; \\times \\;\\frac{{250\\;\\text{mL}}}{{250\\;\\text{mg}}}\\; = \\;\\frac{{4,500,000}}{{250,000}} = 18\\;\\text{mL/hour}\"></span>."
    }
   ],
   "community_solutions": []
  }
 ],
