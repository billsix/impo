   "id": 647563,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following individuals is experiencing homelessness?",
   "answers": [
    {
     "id": 1275939,
     "content_html": "17-year-old staying at friend’s house due to a disagreement with their parents",
     "correctness": "0.0"
    },
    {
     "id": 1275938,
     "content_html": "30-year-old incarcerated following an arrest for drug possession",
     "correctness": "0.0"
    },
    {
     "id": 1275940,
     "content_html": "55-year-old sleeping in a car after losing their job",
     "correctness": "1.0"
    },
    {
     "id": 1275937,
     "content_html": "40-year-old spending 40 percent of their income on rent",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Homelessness refers to individuals or families who lack a regular, fixed, and adequate nighttime residence. This includes those living in shelters or in public or private locations not designed for regular sleeping, such as in cars, parks, abandoned buildings, transportation stations, and campgrounds."
    }
   ],
