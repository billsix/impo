 "questions": [
  {
   "id": 364034,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the results, what should the nurse conclude about the effectiveness of the nutritional plan?",
   "answers": [
    {
     "id": 880553,
     "content_html": "It is effective, but the client is nonadherent.",
     "correctness": "0.0"
    },
    {
     "id": 880554,
     "content_html": "It is effective, but the client is not documenting her food intake correctly.",
     "correctness": "0.0"
    },
    {
     "id": 880555,
     "content_html": "It is ineffective because the client cannot comprehend the instructions well enough.",
     "correctness": "0.0"
    },
    {
     "id": 880556,
     "content_html": "It is ineffective because the client’s Crohn’s disease is preventing absorption.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "With Crohn’s disease, and when a client has many bowel movements daily, absorption becomes a problem. In particular, iron, calcium, and vitamin D are not absorbed properly in this disease process."
    }
   ],
