   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which activity will the nurse perform during the evaluation step of a health intervention program whose objective is to teach community members about identifying and reducing cardiac risk factors?",
   "answers": [
    {
     "id": 1275635,
     "content_html": "Select the learning theory to be used in the program",
     "correctness": "0.0"
    },
    {
     "id": 1275634,
     "content_html": "Identify what learners already know about cardiac risk factors",
     "correctness": "0.0"
    },
    {
     "id": 1275636,
     "content_html": "Determine if learners can identify their cardiac risk factors",
     "correctness": "1.0"
    },
    {
     "id": 1275633,
     "content_html": "Develop strategies for teaching about cardiac risk factors",
     "correctness": "0.0"
