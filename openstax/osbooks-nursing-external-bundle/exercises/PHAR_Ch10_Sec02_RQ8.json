 "questions": [
  {
   "id": 660374,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What indicates an optimal dosage of acetylcholinesterase (AChE) inhibitors for clients with myasthenia gravis?",
   "answers": [
    {
     "id": 1310611,
     "content_html": "Muscle relaxation",
     "correctness": "0.0"
    },
    {
     "id": 1310610,
     "content_html": "Pupil constriction",
     "correctness": "0.0"
    },
    {
     "id": 1310609,
     "content_html": "Increased intestinal motility",
     "correctness": "0.0"
    },
    {
     "id": 1310612,
     "content_html": "Increased ability to raise eyelids",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The AChE inhibitors prescribed for myasthenia gravis increase muscle strength and muscle relaxation. Since clients may have drooping of the eyes due to muscle weakness, the ability to raise the eyelids independently is evident of increased muscle strength."
    }
   ],
   "community_solutions": []
  }
