 "questions": [
  {
   "id": 660291,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client has been prescribed an oral medication that is supplied as a large unscored caplet. The client refuses to take the medication with the statement, “I cannot swallow such a large pill.” What is the nurse’s <em>best</em> action?",
   "answers": [
    {
     "id": 1310279,
     "content_html": "Convince the client to go ahead and take the medication.",
     "correctness": "0.0"
    },
    {
     "id": 1310278,
     "content_html": "Call the provider to request an IV form of the drug.",
     "correctness": "0.0"
    },
    {
     "id": 1310277,
     "content_html": "Break the caplet in half so it is easier to swallow.",
     "correctness": "0.0"
    },
    {
     "id": 1310280,
     "content_html": "Call the pharmacy and request an oral solution of the drug.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The best course of action is to request the pharmacy to send up a liquid form of the medicine because that does not change the route. A caplet that is not scored should not be split by the nurse."
    }
   ],
   "community_solutions": []
  }
 ],
