 "questions": [
  {
   "id": 660344,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client presents to the health care provider’s office with a report of profuse watery diarrhea that started 10 days after they began taking clindamycin for a skin infection. Which organism does the nurse anticipate is responsible for the client’s symptoms?",
   "answers": [
    {
     "id": 1310491,
     "content_html": "<em>Staphylococcus aureus</em>",
     "correctness": "0.0"
    },
    {
     "id": 1310490,
     "content_html": "<em>Pseudomonas aeruginosa</em>",
     "correctness": "0.0"
    },
    {
     "id": 1310492,
     "content_html": "<em>Clostridioides difficile</em>",
     "correctness": "1.0"
    },
    {
     "id": 1310489,
     "content_html": "<em>Streptococcus pneumoniae</em>",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<em>Clostridioides difficile</em> is responsible for causing colitis and severe diarrhea after taking clindamycin."
    }
   ],
   "community_solutions": []
