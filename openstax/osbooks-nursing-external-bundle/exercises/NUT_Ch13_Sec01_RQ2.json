 "questions": [
  {
   "id": 660193,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "On initial laboratory tests, an adult client’s albumin level is below 3.5 g/dL. Which additional test could potentially be utilized to gather additional information about nutritional risk for malnutrition?",
   "answers": [
    {
     "id": 1309887,
     "content_html": "Hemoglobin A1C",
     "correctness": "0.0"
    },
    {
     "id": 1309886,
     "content_html": "Antinuclear antibodies (ANA)",
     "correctness": "0.0"
    },
    {
     "id": 1309888,
     "content_html": "Prealbumin",
     "correctness": "1.0"
    },
    {
     "id": 1309885,
     "content_html": "Chest x-ray",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Albumin is the primary protein of the body. Decreased levels may indicate chronic disease, malabsorption, malnutrition with low protein, or dilution by IV fluids. Follow-on diagnostics would be pre-albumin and blood urea nitrogen."
    }
   ],
   "community_solutions": []
  }
