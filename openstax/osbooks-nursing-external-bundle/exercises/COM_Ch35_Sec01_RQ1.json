 "questions": [
  {
   "id": 647643,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community/public health nurse is organizing an outreach program to educate the community on the availability of over-the-counter naloxone. Which response by a community member indicates to the nurse that the person understands the indication for naloxone?",
   "answers": [
    {
     "id": 1276259,
     "content_html": "“Naloxone is a long-term treatment for opioid addiction.”",
     "correctness": "0.0"
    },
    {
     "id": 1276258,
     "content_html": "“Naloxone prevents opioid cravings in individuals with substance use disorders.”",
     "correctness": "0.0"
    },
    {
     "id": 1276260,
     "content_html": "“Naloxone is used to rapidly reverse the effects of an opioid overdose.”",
     "correctness": "1.0"
    },
    {
     "id": 1276257,
     "content_html": "“Naloxone is a preventive medication to reduce the risk of opioid misuse.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Naloxone is specifically used to rapidly reverse the effects of an opioid overdose. It works by binding to opioid receptors in the brain, displacing other opioids and restoring normal breathing in individuals experiencing an overdose. This knowledge is crucial for community nurses involved in overdose response."
    }
   ],
   "community_solutions": []
  }
 ],
