   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is reviewing lab values for a client who has been taking over-the-counter antacid medications. Which of the following findings could be attributed to antacid use?",
   "answers": [
    {
     "id": 1311459,
     "content_html": "Hypocalcemia",
     "correctness": "0.0"
    },
    {
     "id": 1311458,
     "content_html": "Hyperphosphatemia",
     "correctness": "0.0"
    },
    {
     "id": 1311457,
     "content_html": "Hyponatremia",
     "correctness": "0.0"
    },
    {
     "id": 1311460,
     "content_html": "Hypermagnesemia",
     "correctness": "1.0"
    }
   ],
