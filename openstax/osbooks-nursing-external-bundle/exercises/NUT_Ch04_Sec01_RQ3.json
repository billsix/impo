 "questions": [
  {
   "id": 660104,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is assessing a 3-year-old client who has been brought in by their parents due to refusal to eat and seems to choke on fluids easily. The nurse assesses that the client has uncontrolled drooling, is hyperthermic, and has a very muffled cry. What precaution should the nurse take when assessing the gastrointestinal system of this client?",
   "answers": [
    {
     "id": 1309532,
     "content_html": "Avoid use of tongue blade/depressor.\n",
     "correctness": "1.0"
    },
    {
     "id": 1309531,
     "content_html": "Avoid deep palpation of the abdomen.",
     "correctness": "0.0"
    },
    {
     "id": 1309530,
     "content_html": "Avoid percussion of the abdomen.",
     "correctness": "0.0"
    },
    {
     "id": 1309529,
     "content_html": "Avoid assessment of liver margins.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client’s symptoms are associated with epiglottitis, and using a tongue blade, depressor, or laryngoscope to exam the throat or mouth could trigger a laryngospasm and respiratory distress."
    }
   ],
   "community_solutions": []
  }
 ],
