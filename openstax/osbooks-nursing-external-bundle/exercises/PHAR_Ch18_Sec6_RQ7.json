 "questions": [
  {
   "id": 660461,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is teaching a client with newly diagnosed hypertension about a prescription for hydrochlorothiazide. Which instruction should the nurse include in the client teaching?",
   "answers": [
    {
     "id": 1310959,
     "content_html": "Take this medication at bedtime.",
     "correctness": "0.0"
    },
    {
     "id": 1310960,
     "content_html": "Monitor for leg cramps.",
     "correctness": "1.0"
    },
    {
     "id": 1310958,
     "content_html": "Avoid citrus juices.",
     "correctness": "0.0"
    },
    {
     "id": 1310957,
     "content_html": "Reduce your intake of potassium-rich foods.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Hydrochlorothiazide is a thiazide diuretic and can deplete potassium levels in the body. Clients should eat foods rich in potassium. Clients should monitor themselves for signs of hypokalemia such as fatigue, tachycardia, muscle weakness, and leg cramps."
    }
   ],
   "community_solutions": []
  }
 ],
