 "questions": [
  {
   "id": 660597,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A provider at a weight-loss clinic is considering starting phentermine for a 35-year-old client. The nurse is performing a medication reconciliation for the client. Which medication would the nurse have concerns about?",
   "answers": [
    {
     "id": 1311503,
     "content_html": "Acetaminophen",
     "correctness": "0.0"
    },
    {
     "id": 1311502,
     "content_html": "Omeprazole",
     "correctness": "0.0"
    },
    {
     "id": 1311501,
     "content_html": "Zinc",
     "correctness": "0.0"
    },
    {
     "id": 1311504,
     "content_html": "Phenelzine",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Concurrent use of phenelzine, an MAOI, is contraindicated with phentermine. MAOIs should not be used 14 days before or after phenelzine use."
    }
   ],
   "community_solutions": []
  }
