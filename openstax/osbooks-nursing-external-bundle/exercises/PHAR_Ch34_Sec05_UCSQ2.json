   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which nonpharmacologic treatment should the nurse question if the health care provider prescribes it for the client?",
   "answers": [
    {
     "id": 888213,
     "content_html": "Eat a low-sodium diet.",
     "correctness": "0.0"
    },
    {
     "id": 888214,
     "content_html": "Eat a low-potassium diet.",
     "correctness": "1.0"
    },
    {
     "id": 888215,
     "content_html": "Walk 10 minutes three times a week.",
     "correctness": "0.0"
    },
    {
     "id": 888216,
     "content_html": "Elevate legs when sitting.",
     "correctness": "0.0"
    }
   ],
