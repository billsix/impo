   "id": 660495,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At what rate should the nurse administer adenosine 6 mg IV to a client with supraventricular tachycardia?",
   "answers": [
    {
     "id": 1311096,
     "content_html": "Over 1–2 seconds",
     "correctness": "1.0"
    },
    {
     "id": 1311095,
     "content_html": "Over 1 minute",
     "correctness": "0.0"
    },
    {
     "id": 1311094,
     "content_html": "Over 5–10 minutes",
     "correctness": "0.0"
    },
    {
     "id": 1311093,
     "content_html": "Slowly over 1–2 hours",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Adenosine has a very short half-life and should be administered as a rapid IV bolus directly into a vein over 1–2 seconds, followed by a rapid saline flush."
    }
