 "questions": [
  {
   "id": 373051,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In addition to the parental chemotherapy regimen, Guadalupe will take tamoxifen orally at home. The nurse instructs the client on this new medication. Which of the following statements by Guadalupe indicates the need for additional instruction?",
   "answers": [
    {
     "id": 898606,
     "content_html": "“This medication will make my menstrual periods heavier.”",
     "correctness": "1.0"
    },
    {
     "id": 898607,
     "content_html": "“I will likely gain weight while taking this medication.”",
     "correctness": "0.0"
    },
    {
     "id": 898608,
     "content_html": "“I might start having hot flashes.”",
     "correctness": "0.0"
    },
    {
     "id": 898609,
     "content_html": "“This medication could cause nausea and vomiting.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Tamoxifen is an antiestrogen hormonal agent. Taking this medication will result in amenorrhea, or the absence of menstrual cycles."
    }
   ],
   "community_solutions": []
  }
 ],
