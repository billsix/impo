 "questions": [
  {
   "id": 647509,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client who is reluctant to take pain medication, fearing that if they do so others will see them as weak. Which of the following statements best describes how the nurse should initially respond?",
   "answers": [
    {
     "id": 1275724,
     "content_html": "The nurse should acknowledge the client’s cultural influences and listen to the client’s concerns.",
     "correctness": "1.0"
    },
    {
     "id": 1275723,
     "content_html": "The nurse should provide additional education on the benefits of taking the medication.",
     "correctness": "0.0"
    },
    {
     "id": 1275722,
     "content_html": "The nurse should encourage the client to prioritize their personal health and well-being.",
     "correctness": "0.0"
    },
    {
     "id": 1275721,
     "content_html": "The nurse should encourage the client to prioritize their physical needs over what others may think.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Values and beliefs are non-visible aspects of culture that shape a client’s perspective. The nurse should acknowledge this and listen to the client’s concerns."
    }
   ],
   "community_solutions": []
  }
 ],
