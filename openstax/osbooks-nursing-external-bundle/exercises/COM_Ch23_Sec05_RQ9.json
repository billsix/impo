 "questions": [
  {
   "id": 647531,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the best action for the nurse to take when communicating with a client who speaks a language the nurse does not understand?",
   "answers": [
    {
     "id": 1275812,
     "content_html": "Arrange for a medical interpreter.",
     "correctness": "1.0"
    },
    {
     "id": 1275811,
     "content_html": "Ask a family member to translate.",
     "correctness": "0.0"
    },
    {
     "id": 1275810,
     "content_html": "Ask a clerical staff member who speaks the language to translate.",
     "correctness": "0.0"
    },
    {
     "id": 1275809,
     "content_html": "Use a smartphone app to translate.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Best practice is to use a trained medical translator who not only knows the client’s language but also understands cultural sensitivity."
    }
   ],
   "community_solutions": []
  }
