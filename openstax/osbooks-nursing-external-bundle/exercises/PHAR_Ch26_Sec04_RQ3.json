   "stimulus_html": "",
   "stem_html": "A client is prescribed octreotide 150 mcg subcutaneously daily in three divided doses. The available drug comes in a concentration of 100 mcg/mL. How many milliliters should the nurse administer for each dose?",
   "answers": [
    {
     "id": 1311264,
     "content_html": "0.5 mL",
     "correctness": "1.0"
    },
    {
     "id": 1311263,
     "content_html": "1.0 mL",
     "correctness": "0.0"
    },
    {
     "id": 1311262,
     "content_html": "1.5 mL",
     "correctness": "0.0"
    },
    {
     "id": 1311261,
     "content_html": "2.0 mL",
     "correctness": "0.0"
    }
   ],
