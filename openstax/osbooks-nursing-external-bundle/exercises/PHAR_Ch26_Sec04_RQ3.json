     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\frac{150\\;\\mathrm{mcg}}{\\;3\\;\\mathrm{doses}}\\;=\\;\\frac{50\\;\\mathrm{mcg}}{\\;1\\;\\mathrm{dose}}\"></span><br><span data-math=\"\\frac{50\\;\\mathrm{mcg}}{x\\;\\mathrm{mL}}\"></span> (desired dose) <span data-math=\"=\\;\\frac{100\\;\\mathrm{mcg}}{\\;1\\;\\mathrm{mL}}\"></span> (supply on hand) <br><span data-math=\"\\begin{aligned}100x&amp;=\\;50\\times1\\;\\\\x&amp;=\\frac{50}{100}\\\\x&amp;=0.5\\;\\mathrm{mL}\\;\\mathrm{per}\\;\\mathrm{dose.}\\end{aligned}\"></span>"
    }
