   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Fludrocortisone is a mineralocorticoid that can cause hypokalemia and hypertension. Monitoring for these adverse effects is essential to ensure client safety."
    }
   ],
