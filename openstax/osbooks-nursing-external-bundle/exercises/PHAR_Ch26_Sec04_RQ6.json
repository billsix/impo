 "questions": [
  {
   "id": 660539,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client is prescribed fludrocortisone. Which findings indicate to the nurse that the client is having adverse effects from this medication?",
   "answers": [
    {
     "id": 1311272,
     "content_html": "Hypokalemia and hypertension",
     "correctness": "1.0"
    },
    {
     "id": 1311271,
     "content_html": "Hypoglycemia and hypertension",
     "correctness": "0.0"
    },
    {
     "id": 1311270,
     "content_html": "Hypokalemia and hypotension",
     "correctness": "0.0"
    },
    {
     "id": 1311269,
     "content_html": "Hyperglycemia and hypotension",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
