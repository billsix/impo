 "questions": [
  {
   "id": 647600,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is concerned about the increasing rate of hospital readmissions in clients due to not filling or picking up prescriptions at the pharmacy after discharge from the hospital. Which intervention should the nurse recommend to the hospital leadership to improve adherence to the medication regimen after discharge?",
   "answers": [
    {
     "id": 1276087,
     "content_html": "Calling prescriptions in to the client’s pharmacy at discharge",
     "correctness": "0.0"
    },
    {
     "id": 1276086,
     "content_html": "Handing client prescriptions for home medications during discharge instruction",
     "correctness": "0.0"
    },
    {
     "id": 1276088,
     "content_html": "Providing client with home medications at discharge",
     "correctness": "1.0"
    },
    {
     "id": 1276085,
     "content_html": "Telling the client that medication adherence will reduce readmissions to the hospital",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Research suggests that medication adherence is improved when clients are given their medications in the hospital at the time of discharge compared to needing to pick up prescriptions at a pharmacy."
    }
   ],
   "community_solutions": []
  }
 ],
