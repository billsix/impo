   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client’s original CKD stage was stage 3, which is associated with the GFR range of 30 to 59 mL/min/1.73 m<sup>2</sup>. During pregnancy, the range is expected to increase, so a lower range would be something to address immediately. At 15 mL/min/1.73 m<sup>2</sup>, the client would require dialysis as an immediate intervention."
    }
   ],
   "community_solutions": []
  }
