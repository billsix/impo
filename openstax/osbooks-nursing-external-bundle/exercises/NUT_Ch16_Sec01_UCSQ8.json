   "id": 363603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When Kayla is being monitored during her pregnancy, which lab value would be concerning and require immediate treatment?",
   "answers": [
    {
     "id": 879371,
     "content_html": "GFR 56 mL/min/1.73 m<sup>2</sup>",
     "correctness": "0.0"
    },
    {
     "id": 879372,
     "content_html": "GFR 15 mL/min/1.73 m<sup>2</sup>",
     "correctness": "1.0"
    },
    {
     "id": 879373,
     "content_html": "GFR 87 mL/min/1.73 m<sup>2</sup>",
     "correctness": "0.0"
    },
