 "questions": [
  {
   "id": 647576,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is teaching family members how to read food labels. According to the Calgary Family Intervention Model, which of the following actions by the family incorporates all three functional domains?",
   "answers": [
    {
     "id": 1275991,
     "content_html": "The family groups the low-sodium foods together in the cabinets.",
     "correctness": "0.0"
    },
    {
     "id": 1275990,
     "content_html": "The family explains back to the nurse how to read a nutrition label.",
     "correctness": "0.0"
    },
    {
     "id": 1275989,
     "content_html": "The family practices reading labels at home to reinforce what they learned.",
     "correctness": "0.0"
    },
    {
     "id": 1275992,
     "content_html": "The family reads nutrition labels when shopping and selects low-sodium foods for their meals.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The most effective nursing interventions address all three functional domains: cognitive, behavioral, and affective. Incorporating reading labels into their shopping routine indicates the family understands what was taught (cognitive), changed their behavior when shopping (behavioral), and recognized its importance and incorporated it into their family’s routine (affective)."
    }
   ],
   "community_solutions": []
  }
 ],
