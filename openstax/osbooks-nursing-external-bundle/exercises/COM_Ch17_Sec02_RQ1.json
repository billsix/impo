 "questions": [
  {
   "id": 647463,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse assesses a client’s health literacy prior to providing education. The client is able to use interactive websites, identify multiple resources to gather health information, and assist others in health decision-making. Which health literacy level describes the client’s skills?",
   "answers": [
    {
     "id": 1275539,
     "content_html": "Functional health literacy",
     "correctness": "0.0"
    },
    {
     "id": 1275540,
     "content_html": "Interactive health literacy",
     "correctness": "1.0"
    },
    {
     "id": 1275538,
     "content_html": "Critical health literacy",
     "correctness": "0.0"
    },
    {
     "id": 1275537,
     "content_html": "Organizational health literacy",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A client with interactive health literacy has skills that have advanced beyond the functional, or basic, health literacy level. This client is able to use a variety of sources to answer health questions and apply that information to real-life scenarios."
    }
   ],
   "community_solutions": []
  }
