 "questions": [
  {
   "id": 660202,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following findings is the best indicator that the client has followed the prescribed nutritional plan to maintain a healthy weight?",
   "answers": [
    {
     "id": 1309923,
     "content_html": "The client can verbalize why obesity is detrimental to pulmonary health.",
     "correctness": "0.0"
    },
    {
     "id": 1309922,
     "content_html": "The client can describe the MyPlate approach to food selection.",
     "correctness": "0.0"
    },
    {
     "id": 1309921,
     "content_html": "The client’s food log demonstrates adherence to healthy nutritional plan.",
     "correctness": "0.0"
    },
    {
     "id": 1309924,
     "content_html": "The client has reached their recommended weight range.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "While all of these findings can indicate the client is knowledgeable of and is following the prescribed nutritional plan, actually maintaining the recommended weight is an objective measure that indicates adherence."
    }
   ],
   "community_solutions": []
  }
