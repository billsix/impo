     "correctness": "0.0"
    },
    {
     "id": 927276,
     "content_html": "Fasting blood glucose",
     "correctness": "0.0"
    },
    {
     "id": 927277,
     "content_html": "Glycosylated hemoglobin (hemoglobin A1c)",
     "correctness": "1.0"
