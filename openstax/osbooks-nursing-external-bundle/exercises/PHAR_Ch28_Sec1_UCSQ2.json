   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To determine the client’s blood glucose level over the last 3 months, which diagnostic test does the nurse anticipate the health care provider will order?",
   "answers": [
    {
     "id": 927274,
     "content_html": "Complete blood count",
     "correctness": "0.0"
    },
    {
     "id": 927275,
