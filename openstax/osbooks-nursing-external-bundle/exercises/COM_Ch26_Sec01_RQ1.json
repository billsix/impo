 "questions": [
  {
   "id": 647553,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community health clinic provides care to clients during the prenatal, perinatal, and postnatal periods. What is an example of a primary prevention intervention the community nurse at the clinic might implement?",
   "answers": [
    {
     "id": 1275899,
     "content_html": "Administering Rhogam to clients who are Rh-negative",
     "correctness": "0.0"
    },
    {
     "id": 1275898,
     "content_html": "Screening clients for gestational diabetes during pregnancy",
     "correctness": "0.0"
    },
    {
     "id": 1275900,
     "content_html": "Providing education on prenatal nutrition and exercise to clients",
     "correctness": "1.0"
    },
    {
     "id": 1275897,
     "content_html": "Administering antibiotics to prevent group B streptococcus transmission",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Primary prevention for childbearing clients refers to activities aimed at preventing health problems before they occur, such as providing education about healthy nutrition and exercise."
    }
   ],
   "community_solutions": []
  }
