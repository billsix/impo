   "id": 647422,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The public health nurse is studying the proportion of the population in a certain county that had pneumonia during the winter months. Which epidemiological measure will the nurse use?",
   "answers": [
    {
     "id": 1275375,
     "content_html": "Attack rate",
     "correctness": "0.0"
    },
    {
     "id": 1275374,
     "content_html": "Incidence rate",
     "correctness": "0.0",
     "feedback_html": ""
    },
    {
     "id": 1275376,
     "content_html": "Prevalence rate",
     "correctness": "1.0"
    },
    {
     "id": 1275373,
     "content_html": "Risk ratio",
     "correctness": "0.0"
    }
   ],
