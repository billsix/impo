  {
   "id": 660413,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client presents to the clinic reporting dull, throbbing left leg pain, rated as 4/10 on a 0–10 pain scale. They have been experiencing this for the past year following a leg fracture in a car collision. The nurse determines that this client is experiencing which type of pain?",
   "answers": [
    {
     "id": 1310767,
     "content_html": "Acute pain",
     "correctness": "0.0"
    },
    {
     "id": 1310768,
     "content_html": "Chronic pain",
     "correctness": "1.0"
    },
    {
     "id": 1310766,
     "content_html": "Neuropathic pain",
     "correctness": "0.0"
    },
    {
     "id": 1310765,
     "content_html": "Severe pain",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client’s pain is considered chronic because it has been going on for more than 3 months."
    }
