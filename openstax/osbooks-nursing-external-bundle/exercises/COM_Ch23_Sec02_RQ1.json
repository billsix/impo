 "questions": [
  {
   "id": 647523,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is assessing a client who lives in an area described as a food desert. The nurse identifies that the client is therefore at risk for which disorder?",
   "answers": [
    {
     "id": 1275780,
     "content_html": "Obesity",
     "correctness": "1.0"
    },
    {
     "id": 1275779,
     "content_html": "Parkinson’s disease",
     "correctness": "0.0"
    },
    {
     "id": 1275778,
     "content_html": "Multiple sclerosis",
     "correctness": "0.0"
    },
    {
     "id": 1275777,
     "content_html": "Chronic obstructive pulmonary disease",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Communities that are “food deserts” lack grocery stores and available transportation. Moreover, residents may not have the financial resources to afford healthy food and may rely on fast food and convenience stores. These conditions place residents at risk for obesity, diabetes, and heart disease."
    }
   ],
   "community_solutions": []
  }
