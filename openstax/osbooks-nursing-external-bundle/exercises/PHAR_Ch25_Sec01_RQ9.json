 "questions": [
  {
   "id": 660526,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is providing education to a client who has been prescribed salmeterol, a long-acting beta-2 adrenergic agonist. The nurse instructs the client on the proper use of the medication. Which of the following statements by the client indicates a need for further education?",
   "answers": [
    {
     "id": 1311220,
     "content_html": "“I should use salmeterol for quick relief during an asthma attack.”",
     "correctness": "1.0"
    },
    {
     "id": 1311219,
     "content_html": "“I will rinse my mouth after using the inhaler to prevent throat irritation.”",
     "correctness": "0.0"
    },
    {
     "id": 1311218,
     "content_html": "“Salmeterol is a long-acting medication that helps prevent asthma symptoms.”",
     "correctness": "0.0"
    },
    {
     "id": 1311217,
     "content_html": "“I should not exceed the prescribed dosage of salmeterol in a 24-hour period.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Salmeterol is a long-acting beta-agonist that is not intended for quick relief during an asthma attack."
    }
   ],
   "community_solutions": []
  }
 ],
