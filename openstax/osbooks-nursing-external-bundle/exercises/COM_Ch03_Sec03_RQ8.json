 "questions": [
  {
   "id": 647330,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action will the community health nurse take when engaged in the activity of social prescribing?",
   "answers": [
    {
     "id": 1275007,
     "content_html": "Referring a client with heart failure to a cardiac rehabilitation program",
     "correctness": "0.0"
    },
    {
     "id": 1275006,
     "content_html": "Teaching a client with a new diagnosis of diabetes how to inject insulin",
     "correctness": "0.0"
    },
    {
     "id": 1275008,
     "content_html": "Suggesting volunteer work to a client who is feeling depressed after retiring",
     "correctness": "1.0"
    },
    {
     "id": 1275005,
     "content_html": "Assessing the social resources of a community",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Social prescribing involves referring clients and families to community resources, activities, and groups other than those traditionally thought of as being related to the health care setting. Volunteering is an example of social prescribing that can improve a client’s emotional health, social connectedness, and feelings of empowerment."
    }
   ],
   "community_solutions": []
  }
