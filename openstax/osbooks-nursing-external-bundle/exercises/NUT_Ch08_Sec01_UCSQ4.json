    {
     "id": 891900,
     "content_html": "“I will limit my intake of concentrated sweets.”",
     "correctness": "0.0"
    },
    {
     "id": 891901,
     "content_html": "“I will avoid eating nuts.”",
     "correctness": "1.0"
    },
    {
     "id": 891902,
     "content_html": "“I will try to eat different fruits and vegetables.”",
     "correctness": "0.0"
    },
    {
     "id": 891903,
     "content_html": "“I will incorporate protein into my meals and snacks.”",
     "correctness": "0.0"
    }
