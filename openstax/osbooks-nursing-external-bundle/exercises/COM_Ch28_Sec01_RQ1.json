 "questions": [
  {
   "id": 647573,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is assessing a family that includes an adult and a school-aged child named Jackson. Which of the following questions should the nurse prioritize to ask the adult?",
   "answers": [
    {
     "id": 1275979,
     "content_html": "Do you have any concerns about your son’s health?",
     "correctness": "0.0"
    },
    {
     "id": 1275980,
     "content_html": "What is your relationship to Jackson?",
     "correctness": "1.0"
    },
    {
     "id": 1275978,
     "content_html": "Is Jackson’s other parent a source of support for you?",
     "correctness": "0.0"
    },
    {
     "id": 1275977,
     "content_html": "How many other children do you have?",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Nurses should not assume that an adult with a child is the child’s parent. The nurse should first confirm the type of relationship between Jackson and the adult."
    }
   ],
   "community_solutions": []
  }
 ],
