   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse educates Jamal about abstaining from alcohol and suggests a few other nutritional modifications. Based on the client’s case, what studies or tests should the nurse expect the health care provider to prescribe to investigate other potential changes needed in treatment?",
   "answers": [
    {
     "id": 890902,
     "content_html": "Magnetic resonance imaging of the head",
     "correctness": "0.0"
    },
    {
     "id": 890903,
     "content_html": "PET scan",
     "correctness": "1.0"
    },
    {
     "id": 890904,
     "content_html": "Computed tomography scan of the head with contrast",
     "correctness": "0.0"
    },
    {
     "id": 890905,
     "content_html": "Cerebral angiogram",
     "correctness": "0.0"
    }
   ],
