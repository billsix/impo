   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Cerebral blood flow should be evaluated with a PET scan to determine whether poor blood flow could be contributing to Jamal’s changes in cognitive status."
    }
   ],
