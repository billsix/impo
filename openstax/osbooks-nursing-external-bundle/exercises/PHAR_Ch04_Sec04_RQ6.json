   "id": 660321,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is caring for a pregnant client who is in labor. Which of the following statements accurately describes the concept of positive feedback in the context of labor?",
   "answers": [
    {
     "id": 1310399,
     "content_html": "Oxytocin is suppressed, stimulating uterine contractions.",
     "correctness": "0.0"
    },
    {
     "id": 1310400,
     "content_html": "Oxytocin is released, stimulating uterine contractions.",
     "correctness": "1.0"
    },
    {
     "id": 1310398,
     "content_html": "Oxytocin is suppressed, increasing contractions.",
     "correctness": "0.0"
    },
    {
     "id": 1310397,
     "content_html": "Oxytocin is released, halting uterine contractions.",
     "correctness": "0.0"
    }
   ],
