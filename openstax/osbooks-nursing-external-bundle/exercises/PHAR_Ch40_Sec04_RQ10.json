 "questions": [
  {
   "id": 660682,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is preparing to discharge a client with a new prescription for metronidazole. Which statement should be included in the discharge teaching?",
   "answers": [
    {
     "id": 1311843,
     "content_html": "“Limit your oral fluid intake to 2000 mL/day.”",
     "correctness": "0.0"
    },
    {
     "id": 1311842,
     "content_html": "“You may stop taking this medication when your skin looks better.”",
     "correctness": "0.0"
    },
    {
     "id": 1311844,
     "content_html": "“You will experience severe side effects if you drink alcohol while on this drug.”",
     "correctness": "1.0"
    },
    {
     "id": 1311841,
     "content_html": "“This medication will eliminate the bacterial organisms on your skin.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Drinking alcoholic beverages when taking metronidazole results in a disulfiram-like reaction, which is evidenced by diaphoresis, hypotension, and nausea/vomiting."
    }
   ],
   "community_solutions": []
  }
