   "id": 660673,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 32-year-old client diagnosed with acne has been prescribed tretinoin. Which teaching point should the nurse include in the client’s discharge instructions?",
   "answers": [
    {
     "id": 1311808,
     "content_html": "It is essential that you avoid pregnancy throughout therapy with tretinoin.",
     "correctness": "1.0"
    },
    {
     "id": 1311807,
     "content_html": "This medication should be used liberally across the affected area four times daily.",
     "correctness": "0.0"
    },
    {
     "id": 1311806,
     "content_html": "You may take this medication only during the first 12 weeks of pregnancy.",
     "correctness": "0.0"
    },
    {
     "id": 1311805,
     "content_html": "You should stop taking your birth control because it reacts negatively with tretinoin.",
     "correctness": "0.0"
    }
   ],
