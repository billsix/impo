   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which sign is most concerning for the client receiving mannitol?",
   "answers": [
    {
     "id": 1311588,
     "content_html": "Lung congestion and peripheral edema",
     "correctness": "1.0"
    },
    {
     "id": 1311587,
     "content_html": "Increased urine output",
     "correctness": "0.0"
    },
    {
     "id": 1311586,
     "content_html": "Orthostatic hypotension",
     "correctness": "0.0"
    },
    {
     "id": 1311585,
     "content_html": "Elevated blood glucose levels",
     "correctness": "0.0"
    }
