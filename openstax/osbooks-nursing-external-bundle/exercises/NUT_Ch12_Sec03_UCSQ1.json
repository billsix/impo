 "questions": [
  {
   "id": 367510,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is educating Tara on nutritional considerations related to her condition. Which education statement would be appropriate for the nurse to tell Tara?",
   "answers": [
    {
     "id": 891260,
     "content_html": "“You need to increase your intake of potassium-rich foods.”",
     "correctness": "0.0"
    },
    {
     "id": 891261,
     "content_html": "“You need to increase the amount of sodium in your diet.”",
     "correctness": "0.0"
    },
    {
     "id": 891262,
     "content_html": "“You need to identify a small list of foods that you can easily prepare and eat several times a week.”",
     "correctness": "0.0"
    },
    {
     "id": 891263,
     "content_html": "“You may need a vitamin supplement if you are unable to eat a variety of foods.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client is taking furosemide, which is a diuretic. Diuretics increase the risk for water-soluble vitamin deficiencies particularly if the client is not able to eat a varied, nutrient-rich diet."
    }
   ],
   "community_solutions": []
  }
 ],
