 "questions": [
  {
   "id": 660561,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 76-year-old client with diabetes and renal impairment is scheduled for a diagnostic test requiring the use of contrast dye. Which of the following drugs should the nurse instruct the client to stop taking 24 hours prior to the procedure?",
   "answers": [
    {
     "id": 1311360,
     "content_html": "Metformin",
     "correctness": "1.0"
    },
    {
     "id": 1311359,
     "content_html": "Insulin lispro",
     "correctness": "0.0"
    },
    {
     "id": 1311358,
     "content_html": "Glipizide",
     "correctness": "0.0"
    },
    {
     "id": 1311357,
     "content_html": "Linagliptin",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Metformin should be held 24 hours prior to and 48 hours after contrast dye administration in clients with renal impairment."
    }
   ],
   "community_solutions": []
  }
