 "questions": [
  {
   "id": 647496,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is developing communication materials for a community health program. What action should the nurse take to create materials incorporating the needs of the intended target population?",
   "answers": [
    {
     "id": 1275671,
     "content_html": "Use medical terminology to increase health literacy",
     "correctness": "0.0"
    },
    {
     "id": 1275670,
     "content_html": "Write in the passive voice and end with the key message",
     "correctness": "0.0"
    },
    {
     "id": 1275669,
     "content_html": "Plan to only release the communication on social media sites",
     "correctness": "0.0"
    },
    {
     "id": 1275672,
     "content_html": "Use images and language that represent the target population",
     "correctness": "1.0"
    }
   ],
