 "questions": [
  {
   "id": 660293,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The provider has ordered dofetilide 0.5 mg orally every 12 hours. The pharmacy supplies dofetilide 125 mcg tablets. How many tablets will the nurse administer?",
   "answers": [
    {
     "id": 1310287,
     "content_html": "0.5 tablets",
     "correctness": "0.0"
    },
    {
     "id": 1310286,
     "content_html": "2 tablets",
     "correctness": "0.0"
    },
    {
     "id": 1310285,
     "content_html": "3 tablets",
     "correctness": "0.0"
    },
    {
     "id": 1310288,
     "content_html": "4 tablets",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse determines that 0.5 mg is equal to 500 mcg and sets up the following equation: <span data-math=\"D\\;÷\\;H\\; \\times \\;Q\\; = \\;A\"></span>. <span data-math=\"D\"></span> represents the desired dose (the dose ordered), <span data-math=\"H\"></span> the amount on hand or available, <span data-math=\"Q\"></span> the quantity or volume of the drug form (tablet, capsule, liquid), and <span data-math=\"A\"></span> the amount calculated to be administered to the client. Therefore, <span data-math=\"500\\;\\text{mcg}\\;÷\\;125\\;\\text{mcg}\\; \\times \\;1\\;\\text{tablet}\\; = \\;4\\ \\, \\text{tablets}\"></span>."
    }
   ],
   "community_solutions": []
  }
 ],
