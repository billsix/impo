   "id": 660443,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is creating a monitoring protocol for drugs that require special monitoring of the QT interval. Which drug will be included?",
   "answers": [
    {
     "id": 1310887,
     "content_html": "Lidocaine",
     "correctness": "0.0"
    },
    {
     "id": 1310888,
     "content_html": "Procainamide",
     "correctness": "1.0"
    },
    {
     "id": 1310886,
     "content_html": "Mexiletine",
     "correctness": "0.0"
    },
    {
     "id": 1310885,
     "content_html": "Flecainide",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
