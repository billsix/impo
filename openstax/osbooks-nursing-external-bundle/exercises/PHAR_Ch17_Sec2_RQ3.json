   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Procainamide is a sodium channel blocker antidysrhythmic drug, but it also has activity as a potassium channel blocker. Potassium blocker drugs require monitoring of the QT interval."
    }
   ],
