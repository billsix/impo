   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which stage of the natural history of disease should the nurse most likely suspect for Deanna?",
   "answers": [
    {
     "id": 875720,
     "content_html": "Susceptible",
     "correctness": "1.0"
    },
    {
     "id": 875721,
