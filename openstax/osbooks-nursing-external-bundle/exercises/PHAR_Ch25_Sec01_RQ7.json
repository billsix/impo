 "questions": [
  {
   "id": 660525,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is assessing a client who has been prescribed a respiratory anticholinergic medication. What medical history would be a concern for this nurse when administering the anticholinergic medication?",
   "answers": [
    {
     "id": 1311215,
     "content_html": "History of hypertension",
     "correctness": "0.0"
    },
    {
     "id": 1311214,
     "content_html": "History of osteoarthritis",
     "correctness": "0.0"
    },
    {
     "id": 1311213,
     "content_html": "History of migraines",
     "correctness": "0.0"
    },
    {
     "id": 1311216,
     "content_html": "History of urinary retention",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Respiratory anticholinergic medications have the potential to worsen urinary retention due to their ability to relax smooth muscles, including those in the urinary tract."
    }
   ],
   "community_solutions": []
  }
