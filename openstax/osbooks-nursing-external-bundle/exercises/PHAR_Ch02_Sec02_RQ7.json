   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When administering digoxin, a drug with a narrow therapeutic index, the nurse should assess for which effect?",
   "answers": [
    {
     "id": 1310259,
     "content_html": "Reduced first-pass effect",
     "correctness": "0.0"
    },
    {
     "id": 1310258,
     "content_html": "Increased tolerance",
     "correctness": "0.0"
    },
    {
     "id": 1310257,
     "content_html": "Reduced dependence",
     "correctness": "0.0"
    },
    {
     "id": 1310260,
     "content_html": "Increased toxicity",
     "correctness": "1.0"
    }
   ],
