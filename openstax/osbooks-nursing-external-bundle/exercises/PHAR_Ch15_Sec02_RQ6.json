 "questions": [
  {
   "id": 660428,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is educating a client with an opioid use disorder and their parent about how to recognize the signs and symptoms of opioid overdose and when to administer naloxone. Which of the following statements should the nurse make?",
   "answers": [
    {
     "id": 1310828,
     "content_html": "“After giving naloxone, call emergency services immediately.”",
     "correctness": "1.0"
    },
    {
     "id": 1310827,
     "content_html": "“Naloxone will last 2–3 hours.”",
     "correctness": "0.0"
    },
    {
     "id": 1310826,
     "content_html": "“Naloxone has no adverse effects.”",
     "correctness": "0.0"
    },
    {
     "id": 1310825,
     "content_html": "“Naloxone may induce seizures.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because of the short-acting nature of naloxone, it is imperative to call emergency services after naloxone administration to get definitive care prior to the client re-sedating."
    }
   ],
   "community_solutions": []
  }
 ],
