   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement, when made by a client, demonstrates that further teaching by the nurse is necessary regarding the use of topical corticosteroids?",
   "answers": [
    {
     "id": 1311832,
     "content_html": "“I will cover the lesion with an occlusive dressing after I apply the steroid cream.”",
     "correctness": "1.0"
    },
    {
     "id": 1311831,
     "content_html": "“I should use a thin layer of this medication directly on the lesion.”",
     "correctness": "0.0"
    },
    {
     "id": 1311830,
     "content_html": "“This medication will reduce irritation and swelling.”",
     "correctness": "0.0"
    },
    {
     "id": 1311829,
     "content_html": "“I should cleanse my skin before applying this medication.”",
     "correctness": "0.0"
    }
   ],
