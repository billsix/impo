   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following drugs is commonly prescribed to treat seizures and can cause behavioral and psychotic adverse effects?",
   "answers": [
    {
     "id": 1310703,
     "content_html": "Carbamazepine",
     "correctness": "0.0"
    },
    {
     "id": 1310702,
     "content_html": "Rimegepant",
     "correctness": "0.0"
    },
    {
     "id": 1310701,
     "content_html": "Acetazolamide",
     "correctness": "0.0"
    },
    {
     "id": 1310704,
     "content_html": "Levetiracetam",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
