   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Levetiracetam is used in the treatment of seizures and causes adverse effects such as behavioral symptoms of hostility and aggression as well as psychotic symptoms of  hallucinations and delirium."
    }
