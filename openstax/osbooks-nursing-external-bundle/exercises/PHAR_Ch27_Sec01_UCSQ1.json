     "images": [],
     "solution_type": "detailed",
     "content_html": "This client with hyperthyroidism is showing evidence of toxicity to methimazole. Manifestations of methimazole toxicity are similar to those of hypothyroidism and include cold intolerance, weight gain, fatigue, lack of energy, bradycardia, and depression."
    }
