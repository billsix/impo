 "questions": [
  {
   "id": 660315,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client who has been experiencing diarrhea. Which anion does the nurse anticipate the client is losing through this loss of extracellular fluid?",
   "answers": [
    {
     "id": 1310375,
     "content_html": "Calcium",
     "correctness": "0.0"
    },
    {
     "id": 1310374,
     "content_html": "Sodium",
     "correctness": "0.0"
    },
    {
     "id": 1310373,
     "content_html": "Potassium",
     "correctness": "0.0"
    },
    {
     "id": 1310376,
     "content_html": "Chloride",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Chloride and phosphorus are major anions in the extracellular fluid volume. When the client loses extracellular fluid through diarrhea, chloride is lost. The other options listed are cations in the extracellular fluid."
    }
   ],
   "community_solutions": []
  }
 ],
