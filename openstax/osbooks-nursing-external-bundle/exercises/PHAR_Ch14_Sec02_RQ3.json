   "stimulus_html": "",
   "stem_html": "A client with no past medical history is prescribed acetaminophen, as needed, for pain related to starting a new workout regimen. They have acetaminophen 500 mg tablets at home. The nurse instructs the client not to exceed how many tablets per day?",
   "answers": [
    {
     "id": 1310779,
     "content_html": "10",
     "correctness": "0.0"
    },
    {
