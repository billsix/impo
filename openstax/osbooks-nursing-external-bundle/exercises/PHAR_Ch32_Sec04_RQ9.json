  {
   "id": 660601,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is aware that a combination medication of an antidepressant and an opioid antagonist may be prescribed for weight loss. Which medication is it?",
   "answers": [
    {
     "id": 1311519,
     "content_html": "Chromium picolinate and naltrexone",
     "correctness": "0.0"
    },
    {
     "id": 1311518,
     "content_html": "Phentermine and topiramate",
     "correctness": "0.0"
    },
    {
     "id": 1311517,
     "content_html": "Phenelzine and naloxone",
     "correctness": "0.0"
    },
    {
     "id": 1311520,
     "content_html": "Bupropion and naltrexone",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Bupropion is an antidepressant, and naltrexone is an opioid antagonist; when combined, they have been effective in weight management."
    }
   ],
   "community_solutions": []
  }
