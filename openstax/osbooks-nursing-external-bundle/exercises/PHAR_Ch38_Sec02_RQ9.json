 "questions": [
  {
   "id": 660659,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client has been prescribed an ocular antiviral, trifluridine, for ocular herpes. The nurse instructs the client to seek immediate treatment if they experience which condition?",
   "answers": [
    {
     "id": 1311752,
     "content_html": "Floaters and flashes of light",
     "correctness": "1.0"
    },
    {
     "id": 1311751,
     "content_html": "Fatigue",
     "correctness": "0.0"
    },
    {
     "id": 1311750,
     "content_html": "Hordeolum",
     "correctness": "0.0"
    },
    {
     "id": 1311749,
     "content_html": "Tearing of the eye",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Serious side effects of ocular antiviral medications include retinal detachment, which is manifested by floaters and flashes of light."
    }
   ],
   "community_solutions": []
  }
