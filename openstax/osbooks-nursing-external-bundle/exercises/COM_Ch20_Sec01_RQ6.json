  {
   "id": 647498,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When planning a community health program, which is the best method to ensure the target population’s sociocultural and linguistic needs are met?",
   "answers": [
    {
     "id": 1275679,
     "content_html": "Incorporate knowledge about the culture into activities",
     "correctness": "0.0"
    },
    {
     "id": 1275678,
     "content_html": "Hire an interpreter to assist with program delivery",
     "correctness": "0.0"
    },
    {
     "id": 1275680,
     "content_html": "Include community members in program planning and implementation",
     "correctness": "1.0"
    },
    {
     "id": 1275677,
     "content_html": "Ensure staff are culturally competent",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Including members of the target population in program planning, recruitment, implementation, and evaluation is the best method to ensure sociocultural and linguistic needs are met."
    }
