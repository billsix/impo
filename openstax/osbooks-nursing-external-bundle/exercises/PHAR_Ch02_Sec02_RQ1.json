 "questions": [
  {
   "id": 660283,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The client is taking an 800 mg dose of a medication with a half-life of 4 hours. How much medication will be available in the body after 12 hours?",
   "answers": [
    {
     "id": 1310247,
     "content_html": "400 mg",
     "correctness": "0.0"
    },
    {
     "id": 1310246,
     "content_html": "200 mg",
     "correctness": "0.0"
    },
    {
     "id": 1310248,
     "content_html": "100 mg",
     "correctness": "1.0"
    },
    {
     "id": 1310245,
     "content_html": "50 mg",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The amount of the drug would halve every 4 hours. In 4 hours, 400 mg of the drug would be available. In 8 hours, 200 mg would be available, and in 12 hours, 100 mg of the drug would be available"
    }
   ],
   "community_solutions": []
  }
 ],
