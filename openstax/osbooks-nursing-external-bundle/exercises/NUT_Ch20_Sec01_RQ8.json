 "questions": [
  {
   "id": 660269,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a menopausal client who had a FRAX assessment that indicated a high risk for fracture in the next 10 years. What should the nurse encourage the client to do now to help mitigate this risk?",
   "answers": [
    {
     "id": 1310191,
     "content_html": "Ask their health care provider to prescribe an estrogen supplement.",
     "correctness": "0.0"
    },
    {
     "id": 1310190,
     "content_html": "Ask their health care provider to check their calcium and vitamin D levels.",
     "correctness": "0.0"
    },
    {
     "id": 1310189,
     "content_html": "Include extra protein in their diet.",
     "correctness": "0.0"
    },
    {
     "id": 1310192,
     "content_html": "Get daily weight-bearing exercise such as walking.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Weight-bearing exercise and maintenance of a healthy weight help prevent age-related osteoporotic changes in menopausal individuals."
    }
   ],
   "community_solutions": []
  }
 ],
