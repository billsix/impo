 "questions": [
  {
   "id": 660215,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When should the nurse perform a bladder scan to determine a client’s PVR?",
   "answers": [
    {
     "id": 1309975,
     "content_html": "Before the client voids",
     "correctness": "0.0"
    },
    {
     "id": 1309976,
     "content_html": "Immediately after the client voids",
     "correctness": "1.0"
    },
    {
     "id": 1309974,
     "content_html": "One hour after the client voids",
     "correctness": "0.0"
    },
    {
     "id": 1309973,
     "content_html": "When the client has the urge to void",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Since the PVR is the amount of urine left in the bladder after the client has urinated, the nurse should scan the bladder immediately after the client has urinated."
    }
   ],
