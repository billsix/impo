 "questions": [
  {
   "id": 647608,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is working with a family that has a member who was just diagnosed with a mental illness. Another family member tells the nurse that he believes the client is “just being annoying and trying to get attention.” Which of the following best describes the family member’s statement?",
   "answers": [
    {
     "id": 1276120,
     "content_html": "It reflects the public stigma around mental illness.",
     "correctness": "1.0"
    },
    {
     "id": 1276119,
     "content_html": "It reflects the institutional stigma around mental illness.",
     "correctness": "0.0"
    },
    {
     "id": 1276118,
     "content_html": "Since a close family member made the comment, it is a form of self-stigma.",
     "correctness": "0.0"
    },
    {
     "id": 1276117,
     "content_html": "It is a discriminatory statement.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Public stigma involves negative attitudes others have about mental illness."
    }
   ],
   "community_solutions": []
  }
 ],
