   "id": 647452,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the COVID-19 pandemic, a public health department wanted to introduce a smartphone application (app) that could track and notify individuals who came into close contact with a confirmed case. However, the department encountered challenges in gaining widespread acceptance and adoption of the new technology. Which concept from the diffusion of innovations theory likely influenced the implementation of the app?",
   "answers": [
    {
     "id": 1275495,
     "content_html": "Trialability",
     "correctness": "0.0"
    },
    {
     "id": 1275494,
     "content_html": "Observability",
     "correctness": "0.0"
    },
    {
     "id": 1275493,
     "content_html": "Relative advantage",
     "correctness": "0.0"
    },
    {
     "id": 1275496,
     "content_html": "Compatibility ",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The app likely does not fit with the intended audience, leading to a lack of widespread acceptance, which would indicate an issue with compatibility."
    }
   ],
   "community_solutions": []
  }
