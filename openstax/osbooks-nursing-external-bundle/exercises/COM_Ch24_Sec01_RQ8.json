 "questions": [
  {
   "id": 647540,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is a member of an interdisciplinary committee whose goal is to develop a culturally and linguistically competent organization. Which action by the committee would help to meet this goal?",
   "answers": [
    {
     "id": 1275848,
     "content_html": "Develop an organizational mission statement for cultural competence",
     "correctness": "1.0"
    },
    {
     "id": 1275847,
     "content_html": "Encourage each department to develop a cultural competency plan",
     "correctness": "0.0"
    },
    {
     "id": 1275846,
     "content_html": "Encourage employees to find ways to develop their cultural competence",
     "correctness": "0.0"
    },
    {
     "id": 1275845,
     "content_html": "Hire individuals with the most work experience",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "To show its strong commitment to cultural competence, the organization should have a mission statement that reflects its commitment to cultural and linguistic competence."
    }
   ],
   "community_solutions": []
  }
 ],
