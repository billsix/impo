   "stimulus_html": "",
   "stem_html": "A client is prescribed loratadine 10 mg orally once daily for seasonal allergies. The available tablets are 5 mg each. How many tablets should the client take per dose?",
   "answers": [
    {
     "id": 1311187,
     "content_html": "1 tablet",
     "correctness": "0.0"
    },
    {
     "id": 1311188,
     "content_html": "2 tablets",
     "correctness": "1.0"
    },
    {
     "id": 1311186,
     "content_html": "3 tablets",
     "correctness": "0.0"
    },
    {
