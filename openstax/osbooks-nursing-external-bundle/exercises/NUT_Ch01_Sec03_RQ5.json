 "questions": [
  {
   "id": 660078,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is analyzing a popular diet plan with a client. Which of the following information would cause the nurse to question the validity of the presented diet?",
   "answers": [
    {
     "id": 1309427,
     "content_html": "It specifies a target calorie range the client is expected to follow.",
     "correctness": "0.0"
    },
    {
     "id": 1309428,
     "content_html": "The diet’s supporting evidence comes from a single physician affiliated with the required meal plan.",
     "correctness": "1.0"
    },
    {
     "id": 1309426,
     "content_html": "Following it necessitates keeping a detailed journal describing food intake.",
     "correctness": "0.0"
    },
    {
     "id": 1309425,
     "content_html": "Different nutrients must be consumed in prescribed amounts.",
     "correctness": "0.0"
    }
   ],
