 "questions": [
  {
   "id": 647522,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with a visual impairment requires information about his medication regimen in accessible formats such as braille or audio recordings. According to the Campinha-Bacote model, which component of the model should the nurse consider when providing information about the medication regimen to the client?",
   "answers": [
    {
     "id": 1275775,
     "content_html": "Cultural competence",
     "correctness": "0.0"
    },
    {
     "id": 1275774,
     "content_html": "Cultural awareness",
     "correctness": "0.0"
    },
    {
     "id": 1275776,
     "content_html": "Cultural skill",
     "correctness": "1.0"
    },
    {
     "id": 1275773,
     "content_html": "Cultural desire",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The component of cultural skill emphasizes the need for health care providers to possess the necessary knowledge and abilities to effectively understand and communicate with individuals from diverse backgrounds, such as the client with a visual impairment. The nurse should have the cultural skill to provide medication information in accessible formats, such as braille or audio recordings, to ensure effective communication and culturally congruent care."
    }
   ],
   "community_solutions": []
  }
 ],
