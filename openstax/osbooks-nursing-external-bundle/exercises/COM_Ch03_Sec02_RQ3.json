   "stimulus_html": "",
   "stem_html": "Which statement describes the purpose of defining a scope of practice for nurses?",
   "answers": [
    {
     "id": 1274987,
     "content_html": "Establishing principles and guidelines for professional behaviors and ethics",
     "correctness": "0.0"
    },
    {
