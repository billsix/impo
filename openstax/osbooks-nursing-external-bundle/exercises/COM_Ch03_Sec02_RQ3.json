     "content_html": "Outlining specific clinical skills and procedures nurses may perform",
     "correctness": "0.0"
    },
    {
     "id": 1274988,
     "content_html": "Ensuring nurses work within their level of qualification, expertise, and competence",
     "correctness": "1.0"
    },
    {
     "id": 1274985,
     "content_html": "Promoting collaboration in teamwork within a health care setting",
     "correctness": "0.0"
