   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following outcomes would indicate an improvement in Meena's endocrine health after implementing the care plan?",
   "answers": [
    {
     "id": 892504,
     "content_html": "Decreased TSH level and improved blood glucose control",
     "correctness": "1.0"
    },
    {
     "id": 892505,
     "content_html": "Increased TSH level and decreased T4 level",
     "correctness": "0.0"
    },
    {
     "id": 892506,
     "content_html": "Increased appetite and weight gain",
     "correctness": "0.0"
    },
    {
     "id": 892507,
     "content_html": "Decreased heart rate and increased blood pressure",
     "correctness": "0.0"
    }
   ],
