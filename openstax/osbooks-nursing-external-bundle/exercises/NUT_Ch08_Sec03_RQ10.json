 "questions": [
  {
   "id": 660152,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is documenting a client’s medications during an admission assessment. Which of the following medications can decrease parathyroid levels, thereby increasing the risk for bone fractures?",
   "answers": [
    {
     "id": 1309723,
     "content_html": "Levothyroxine",
     "correctness": "0.0"
    },
    {
     "id": 1309722,
     "content_html": "Metformin",
     "correctness": "0.0"
    },
    {
     "id": 1309724,
     "content_html": "Furosemide",
     "correctness": "1.0"
    },
    {
     "id": 1309721,
     "content_html": "Insulin",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Loop diuretics, such as furosemide, cause the parathyroid gland to decrease the production of parathyroid hormone, which is important in maintaining bone stability."
    }
   ],
   "community_solutions": []
  }
