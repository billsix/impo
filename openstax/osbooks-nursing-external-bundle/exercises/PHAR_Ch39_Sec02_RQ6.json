 "questions": [
  {
   "id": 660668,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which assessment finding indicates to the nurse that a client receiving an otic antibiotic may have a resistant infection, also known as a superinfection?",
   "answers": [
    {
     "id": 1311787,
     "content_html": "Low blood pressure and elevated heart rate",
     "correctness": "0.0"
    },
    {
     "id": 1311786,
     "content_html": "Tearing eyes on the affected side",
     "correctness": "0.0"
    },
    {
     "id": 1311788,
     "content_html": "Pain and ear itching",
     "correctness": "1.0"
    },
    {
     "id": 1311785,
     "content_html": "Headache and nausea",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Pain and ear itching are signs that a superinfection may be present, in which case an ear swab will be needed to test for a superinfection."
    }
   ],
   "community_solutions": []
  }
