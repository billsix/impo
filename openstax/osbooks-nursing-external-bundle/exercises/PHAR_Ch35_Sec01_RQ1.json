   "id": 660623,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client is receiving trimethoprim and sulfamethoxazole for a urinary tract infection. The nurse should monitor the client for which potential adverse effect?",
   "answers": [
    {
     "id": 1311608,
     "content_html": "Photosensitivity",
     "correctness": "1.0"
    },
    {
     "id": 1311607,
     "content_html": "Hypoglycemia",
     "correctness": "0.0"
    },
    {
     "id": 1311606,
     "content_html": "Tinnitus",
     "correctness": "0.0"
    },
    {
     "id": 1311605,
     "content_html": "Hypertension",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A potential adverse effect of trimethoprim and sulfamethoxazole is photosensitivity (increased sensitivity to sunlight or artificial light)."
    }
   ],
   "community_solutions": []
  }
