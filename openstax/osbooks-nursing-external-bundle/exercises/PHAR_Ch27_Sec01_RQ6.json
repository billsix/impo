   "id": 660545,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which laboratory findings would indicate to the nurse that a client has hypoparathyroidism?",
   "answers": [
    {
     "id": 1311295,
     "content_html": "Ionized serum calcium 5.0 mg/dL",
     "correctness": "0.0"
    },
    {
     "id": 1311294,
     "content_html": "Total serum calcium 9.8 mg/dL",
     "correctness": "0.0"
    },
    {
     "id": 1311296,
     "content_html": "Phosphate 5.7 mg/dL",
     "correctness": "1.0"
    },
    {
     "id": 1311293,
     "content_html": "Vitamin D 50 mmol/L",
     "correctness": "0.0"
    }
   ],
