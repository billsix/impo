   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with fluid volume excess. Which of the following manifestations is consistent with this condition?",
   "answers": [
    {
     "id": 1311552,
     "content_html": "Jugular vein distention",
     "correctness": "1.0"
    },
    {
     "id": 1311551,
     "content_html": "Bradycardia",
     "correctness": "0.0"
    },
    {
     "id": 1311550,
     "content_html": "Elevated hematocrit",
     "correctness": "0.0"
    },
    {
     "id": 1311549,
     "content_html": "Hypotension",
     "correctness": "0.0"
    }
   ],
