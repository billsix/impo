 "questions": [
  {
   "id": 660378,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is teaching a 74-year-old client how to properly apply a rivastigmine transdermal patch. Which of the following statements from the client requires additional teaching?",
   "answers": [
    {
     "id": 1310628,
     "content_html": "“The patch needs to be changed weekly.”",
     "correctness": "1.0"
    },
    {
     "id": 1310627,
     "content_html": "“I should apply the patch over a clean, hairless, and intact area of the skin.”",
     "correctness": "0.0"
    },
    {
     "id": 1310626,
     "content_html": "“The old patch must be removed before a new patch is put on.”",
     "correctness": "0.0"
    },
    {
     "id": 1310625,
     "content_html": "“Sites should be rotated and the same site should not be used for 14 days.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The patch needs to be changed every 24 hours, not weekly. All the other options are correct statements."
    }
   ],
   "community_solutions": []
  }
 ],
