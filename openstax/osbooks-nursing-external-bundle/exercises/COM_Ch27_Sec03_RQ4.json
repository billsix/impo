 "questions": [
  {
   "id": 647566,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an example of heteronormativity in health care?",
   "answers": [
    {
     "id": 1275952,
     "content_html": "Discussing oral contraception with all women of childbearing age regardless of sexual orientation",
     "correctness": "1.0"
    },
    {
     "id": 1275951,
     "content_html": "Refusing care to a client based on sexual orientation or gender identity",
     "correctness": "0.0"
    },
    {
     "id": 1275950,
     "content_html": "Using birth-assigned pronouns rather than client-identified pronouns",
     "correctness": "0.0"
    },
    {
     "id": 1275949,
     "content_html": "Asking the client if they would like their same-sex partner included in the medical discussion",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Heteronormativity is a form of implicit bias. Discussing oral contraception with all women of childbearing age regardless of their sexual orientation is a classic example of heteronormativity. Other examples of implicit bias include referring to same-sex partners as “friends” or intentionally excluding same-sex partners from health conversations."
    }
   ],
   "community_solutions": []
  }
 ],
