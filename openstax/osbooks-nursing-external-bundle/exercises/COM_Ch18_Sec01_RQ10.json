 "questions": [
  {
   "id": 647482,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which belief by an individual indicates to the nurse that the individual is ready for a health change?",
   "answers": [
    {
     "id": 1275616,
     "content_html": "They believe they are susceptible to a health problem.",
     "correctness": "1.0"
    },
    {
     "id": 1275615,
     "content_html": "They believe the health problem is not serious.",
     "correctness": "0.0"
    },
    {
     "id": 1275614,
     "content_html": "They believe taking action will have no effect on the health problem.",
     "correctness": "0.0"
    },
    {
     "id": 1275613,
     "content_html": "They lack confidence in their ability to make a change.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "An individual is ready for a change in health behavior when they believe they are susceptible to the health problem, they believe the health problem has serious consequences, they believe taking action will reduce the risk of the health problem, they believe the benefits of change outweigh the costs, they are exposed to factors that prompt change, and they are confident in their ability to make a change."
    }
   ],
   "community_solutions": []
  }
 ],
