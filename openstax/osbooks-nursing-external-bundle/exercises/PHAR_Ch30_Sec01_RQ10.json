  {
   "id": 660576,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client how to use a scopolamine patch. Which of the following statements by the client indicates the need for further instruction?",
   "answers": [
    {
     "id": 1311420,
     "content_html": "“I need to put this on as soon as I start to feel nauseated.”",
     "correctness": "1.0"
    },
    {
     "id": 1311419,
     "content_html": "“One patch should last 3 days.”",
     "correctness": "0.0"
    },
    {
     "id": 1311418,
     "content_html": "“I need to wash my hands after applying the patch.”",
     "correctness": "0.0"
    },
    {
     "id": 1311417,
     "content_html": "“I should not touch the adhesive section when applying the patch.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Scopolamine patches are used for motion sickness and should be applied 4 hours prior to traveling."
    }
