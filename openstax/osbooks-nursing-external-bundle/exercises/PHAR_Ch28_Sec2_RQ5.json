 "questions": [
  {
   "id": 660558,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is teaching a client with diabetes about a new prescription for insulin isophane NPH. Which of the following instructions should the nurse include in the teaching?",
   "answers": [
    {
     "id": 1311347,
     "content_html": "Discard the insulin isophane NPH if cloudy.",
     "correctness": "0.0"
    },
    {
     "id": 1311346,
     "content_html": "Take insulin isophane NPH 15 minutes before meals.",
     "correctness": "0.0"
    },
    {
     "id": 1311348,
     "content_html": "Eat a snack 7 hours after taking the insulin isophane NPH.",
     "correctness": "1.0"
    },
    {
     "id": 1311345,
     "content_html": "Rotate insulin isophane NPH injection sites once a week.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Insulin isophane NPH peaks in 4–12 hours. The client is at risk for hypoglycemia during this time and should eat a snack to prevent hypoglycemia."
    }
   ],
   "community_solutions": []
  }
 ],
