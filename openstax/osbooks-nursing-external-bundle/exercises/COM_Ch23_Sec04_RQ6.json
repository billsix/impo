 "questions": [
  {
   "id": 647528,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which actions by the nurse demonstrate that the nurse values cultural diversity?",
   "answers": [
    {
     "id": 1275799,
     "content_html": "The nurse discusses cultural diversity with people from their own culture.",
     "correctness": "0.0"
    },
    {
     "id": 1275798,
     "content_html": "The nurse compares other cultures to the nurse’s culture.",
     "correctness": "0.0"
    },
    {
     "id": 1275797,
     "content_html": "The nurse treats everyone from the same culture in a similar manner.",
     "correctness": "0.0"
    },
    {
     "id": 1275800,
     "content_html": "The nurse volunteers at a free immigrant health clinic.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse demonstrates valuing of diversity by volunteering at a clinic that provides free care to immigrants. This practice allows the nurse to learn about the culture of the immigrant group and to establish relationships within the community. Discussing diversity with individuals from the same cultural background, comparing other cultures to one’s own culture, and treating everyone from the same culture in a like manner do not demonstrate that the nurse values diversity."
    }
   ],
   "community_solutions": []
  }
 ],
