 "questions": [
  {
   "id": 660646,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client undergoing MTF transition has been prescribed the antiandrogen medication spironolactone. Which statement by the client indicates understanding of the adverse effects?",
   "answers": [
    {
     "id": 1311699,
     "content_html": "“I may notice my voice is getting deeper.”",
     "correctness": "0.0"
    },
    {
     "id": 1311700,
     "content_html": "“I should report any irregular heart rhythm and muscle cramps.”",
     "correctness": "1.0"
    },
    {
     "id": 1311698,
     "content_html": "“This drug may cause facial hair growth.”",
     "correctness": "0.0"
    },
    {
     "id": 1311697,
     "content_html": "“I need to eat foods high in potassium.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Hyperkalemia is the most common and most serious adverse effect of spironolactone. Cardiac dysrhythmias and muscle cramps are indications of hyperkalemia and should be reported."
    }
   ],
   "community_solutions": []
  }
