 "questions": [
  {
   "id": 647324,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which nursing action following World War II represents an autonomous public-health nursing function?",
   "answers": [
    {
     "id": 1274983,
     "content_html": "Providing direct care to wounded soldiers in military hospitals",
     "correctness": "0.0"
    },
    {
     "id": 1274984,
     "content_html": "Conducting vaccination campaigns to promote immunizations",
     "correctness": "1.0"
    },
    {
     "id": 1274982,
     "content_html": "Collaborating with physicians to perform medical procedures",
     "correctness": "0.0"
    },
    {
     "id": 1274981,
     "content_html": "Assisting in surgical operations in field hospitals",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Following WWII, nurses sought professional roles with greater autonomy and found that public/community health nursing met this need. In this public/community health role, nurses provided education to raise public awareness of health issues, including the promotion of vaccinations to increase the proportion of the population receiving a vaccination."
    }
   ],
