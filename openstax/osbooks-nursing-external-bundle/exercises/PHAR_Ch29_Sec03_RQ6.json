 "questions": [
  {
   "id": 660570,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with insufficient lipase production. The nurse explains to the client that absorption of which vitamin will be impaired?",
   "answers": [
    {
     "id": 1311395,
     "content_html": "Folate",
     "correctness": "0.0"
    },
    {
     "id": 1311394,
     "content_html": "Vitamin B<sub>12</sub>",
     "correctness": "0.0"
    },
    {
     "id": 1311396,
     "content_html": "Vitamin K",
     "correctness": "1.0"
    },
    {
     "id": 1311393,
     "content_html": "Thiamine",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Lipase is involved in the breakdown of fats and the absorption of fat-soluble vitamins. This means the client will have deficient levels of vitamin K, a fat-soluble vitamin."
    }
   ],
   "community_solutions": []
  }
