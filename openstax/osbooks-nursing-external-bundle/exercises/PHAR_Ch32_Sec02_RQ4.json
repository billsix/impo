 "questions": [
  {
   "id": 660596,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The clinic nurse is teaching a 25-year-old female client about her new prescription for benzphetamine. What statement by the client indicates understanding?",
   "answers": [
    {
     "id": 1311500,
     "content_html": "“It is best to use a method of birth control because the medication can be harmful to a fetus.”",
     "correctness": "1.0"
    },
    {
     "id": 1311499,
     "content_html": "“This medication will make me very sleepy.”",
     "correctness": "0.0"
    },
    {
     "id": 1311498,
     "content_html": "“I will be hungry on this medication.”",
     "correctness": "0.0"
    },
    {
     "id": 1311497,
     "content_html": "“This medication is best taken right before bed.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Benzphetamine should not be given to clients who are pregnant; clients of childbearing age should be counseled to practice strict birth control methods to avoid pregnancy while on the medication."
    }
   ],
   "community_solutions": []
  }
