 "questions": [
  {
   "id": 647592,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which activity would the correctional nurse implement to address tertiary health promotion in individuals with long-term disease who are incarcerated?",
   "answers": [
    {
     "id": 1276055,
     "content_html": "Teach rescue inhaler use for people with asthma",
     "correctness": "0.0"
    },
    {
     "id": 1276054,
     "content_html": "Administer medication for the treatment of hepatitis C",
     "correctness": "0.0"
    },
    {
     "id": 1276056,
     "content_html": "Advocate for low-sodium dietary options for people with hypertension",
     "correctness": "1.0"
    },
    {
     "id": 1276053,
     "content_html": "Recommend physical therapy for people with arthritis",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The most common long-term conditions in incarcerated individuals are hypertension, arthritis, asthma, and hepatitis. Tertiary health promotion reduces the severity of disease, such as providing low-sodium dietary options for those with hypertension."
    }
   ],
   "community_solutions": []
  }
