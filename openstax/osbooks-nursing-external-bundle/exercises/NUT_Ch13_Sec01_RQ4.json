  {
   "id": 660195,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is instructing an older client on the importance of adequate calcium and vitamin D intake. Which of the following age-related changes would this intervention affect?",
   "answers": [
    {
     "id": 1309896,
     "content_html": "Decreased lung capacity",
     "correctness": "1.0"
    },
    {
     "id": 1309895,
     "content_html": "Increased muscle atrophy",
     "correctness": "0.0"
    },
    {
     "id": 1309894,
     "content_html": "Decreased elasticity",
     "correctness": "0.0"
    },
    {
     "id": 1309893,
     "content_html": "Increased vascular resistance",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Calcium and vitamin D intake reduce the risk of osteoporosis and kyphoscoliosis that decrease the size and diameter of the rib cage and reduce lung capacity."
    }
   ],
   "community_solutions": []
  }
