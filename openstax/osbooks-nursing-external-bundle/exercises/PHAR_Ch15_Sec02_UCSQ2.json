 "questions": [
  {
   "id": 367162,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What effects of opioid withdrawal should the nurse educate the client about that can happen if he continues taking opioids along with naltrexone?",
   "answers": [
    {
     "id": 890481,
     "content_html": "Hypotension",
     "correctness": "0.0"
    },
    {
     "id": 890482,
     "content_html": "Respiratory depression",
     "correctness": "0.0"
    },
    {
     "id": 890483,
     "content_html": "Lethargy",
     "correctness": "0.0"
    },
    {
     "id": 890484,
     "content_html": "Diarrhea",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Diarrhea is a common symptom of opioid withdrawal and can occur if clients continue to use opioids while taking the opioid antagonist naltrexone."
    }
   ],
   "community_solutions": []
  }
