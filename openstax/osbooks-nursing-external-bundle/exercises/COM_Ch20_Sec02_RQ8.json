   "id": 647500,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which data source would a nurse use to perform an impact evaluation of an existing community health program?",
   "answers": [
    {
     "id": 1275687,
     "content_html": "Participant surveys completed prior to and on the final day of the program",
     "correctness": "0.0"
    },
    {
     "id": 1275686,
     "content_html": "Participant surveys completed prior to and 90 days following the program",
     "correctness": "0.0"
    },
    {
     "id": 1275688,
     "content_html": "Local community health assessment prior to and following the program",
     "correctness": "1.0"
    },
    {
     "id": 1275685,
     "content_html": "Local community health assessment following program conclusion",
     "correctness": "0.0"
    }
   ],
