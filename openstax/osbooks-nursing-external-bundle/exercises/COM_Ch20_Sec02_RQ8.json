   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Impact evaluation measures the degree that the community health program achieves its primary goal. Most often, community health assessment data is used to evaluate the impact of existing community health programs. Pre-program CHA data and CHA data collected after the program was implemented are used to determine long-term impact."
    }
   ],
