 "questions": [
  {
   "id": 660634,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client in labor is receiving an oxytocin infusion. Which signs and symptoms are a priority for the nurse to assess further?",
   "answers": [
    {
     "id": 1311651,
     "content_html": "Maternal heart rate of 102 beats/minute and blood pressure of 146/90 mm Hg",
     "correctness": "0.0"
    },
    {
     "id": 1311652,
     "content_html": "Sudden onset of confusion and muscle cramps",
     "correctness": "1.0"
    },
    {
     "id": 1311650,
     "content_html": "Client-reported headache of 4 out of 10 on the pain scale",
     "correctness": "0.0"
    },
    {
     "id": 1311649,
     "content_html": "Urine output of 100 mL/hour",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Oxytocin’s effect on the kidneys can cause water intoxication and dilutional hyponatremia, which are considered significant side effects. Signs and symptoms of hyponatremia are related to the central nervous system (CNS) and musculoskeletal system."
    }
   ],
