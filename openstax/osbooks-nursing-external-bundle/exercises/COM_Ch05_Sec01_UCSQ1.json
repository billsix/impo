 "questions": [
  {
   "id": 369072,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When assessing Jose, what factors about his ethnic background should the nurse consider?",
   "answers": [
    {
     "id": 894841,
     "content_html": "The client is at a higher risk for certain health conditions because of his ethnic background.",
     "correctness": "1.0"
    },
    {
     "id": 894842,
     "content_html": "The client has the same risk for certain health conditions as anyone else his age.",
     "correctness": "0.0"
    },
    {
     "id": 894843,
     "content_html": "The client is a member of a minority group that is decreasing in numbers over time.",
     "correctness": "0.0"
    },
    {
     "id": 894844,
     "content_html": "The client is a member of a minority group that is eligible for additional health-related resources.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Underrepresented populations, such as ethnic minorities, tend to be impacted the most by chronic health conditions such as hypertension and heart disease."
    }
   ],
   "community_solutions": []
  }
