 "questions": [
  {
   "id": 660642,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 68-year-old male client comes to the emergency department with chest pain. Before administering the ordered sublingual nitroglycerin, which question is most important for the nurse to ask the client?",
   "answers": [
    {
     "id": 1311683,
     "content_html": "“How long have you had the chest pain?”",
     "correctness": "0.0"
    },
    {
     "id": 1311682,
     "content_html": "“Do you have a history of cardiac problems?”",
     "correctness": "0.0"
    },
    {
     "id": 1311681,
     "content_html": "“When did you last eat or drink anything?”",
     "correctness": "0.0"
    },
    {
     "id": 1311684,
     "content_html": "“Do you take any medications for erectile dysfunction?”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Nitroglycerin is contraindicated when a client is using drugs for ED. The combination can cause significant hypotension and possible cardiac arrest."
    }
   ],
   "community_solutions": []
  }
 ],
