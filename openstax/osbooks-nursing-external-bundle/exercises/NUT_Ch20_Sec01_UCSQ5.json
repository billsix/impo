 "questions": [
  {
   "id": 366703,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is the highest priority right now to promote the child’s musculoskeletal health?",
   "answers": [
    {
     "id": 889105,
     "content_html": "The child should begin exercising twice daily.",
     "correctness": "0.0"
    },
    {
     "id": 889106,
     "content_html": "The nurse should teach the mother about components of a healthy diet for children.",
     "correctness": "1.0"
    },
    {
     "id": 889107,
     "content_html": "The child should be excused from gym class and referred to a specialist.",
     "correctness": "0.0"
    },
    {
     "id": 889108,
     "content_html": "The child should drink whole milk instead of juice boxes with meals.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The mother urgently needs to change this child’s diet so that they can achieve a healthy weight. Being overweight places additional strain on a child’s skeletal system putting them at increased risk for injury and may make them reluctant to participate in physical activity."
    }
   ],
