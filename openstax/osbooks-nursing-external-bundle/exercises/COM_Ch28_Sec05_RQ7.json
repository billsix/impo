 "questions": [
  {
   "id": 647579,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The community nurse is working with a family and determines one of the family members is repeatedly telling another family member who has a disability that “he needs to stop being lazy and get a job.” This is an example of what type of abuse?",
   "answers": [
    {
     "id": 1276003,
     "content_html": "Sexual abuse",
     "correctness": "0.0"
    },
    {
     "id": 1276002,
     "content_html": "Physical abuse",
     "correctness": "0.0"
    },
    {
     "id": 1276004,
     "content_html": "Emotional abuse",
     "correctness": "1.0"
    },
    {
     "id": 1276001,
     "content_html": "Neglect",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "There are three different types of abuse: physical, sexual, and emotional. Emotional abuse harms a person’s self-worth or emotional well-being."
    }
   ],
   "community_solutions": []
  }
