 "questions": [
  {
   "id": 647546,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community health nurse critically examines their practice to decrease the influence of privilege when providing care to clients in a low-income area. Which statement does the nurse understand to be a critical aspect of privilege in nursing?",
   "answers": [
    {
     "id": 1275871,
     "content_html": "The nursing profession is not influenced by privilege.",
     "correctness": "0.0"
    },
    {
     "id": 1275870,
     "content_html": "Privilege is solely determined by socioeconomic status.",
     "correctness": "0.0"
    },
    {
     "id": 1275872,
     "content_html": "Acknowledging one’s privilege is critical to addressing unjust systems.",
     "correctness": "1.0"
    },
    {
     "id": 1275869,
     "content_html": "Privilege has no impact on health disparities or health outcomes.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Acknowledging privilege is crucial to promoting fairness and advocating for change. Nurses should recognize their social privileges and actively work to address disparities and inequalities within the health care system. According to the ANA, nurses must acknowledge their social privileges and take responsibility to address unjust systems and structures."
    }
   ],
   "community_solutions": []
  }
