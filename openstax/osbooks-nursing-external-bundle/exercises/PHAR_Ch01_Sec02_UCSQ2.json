 "questions": [
  {
   "id": 367313,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is discussing the use of over-the-counter medications with Vy. What advantages of using over-the-counter drugs will the nurse discuss?",
   "answers": [
    {
     "id": 890814,
     "content_html": "Over-the-counter drugs do not need to be reported to the provider.",
     "correctness": "0.0"
    },
    {
     "id": 890815,
     "content_html": "Insurance companies will reimburse the cost of over-the-counter medications.",
     "correctness": "0.0"
    },
    {
     "id": 890816,
     "content_html": "Minor ailments can be treated by the client rather than the prescriber.",
     "correctness": "1.0"
    },
    {
     "id": 890817,
     "content_html": "Over-the-counter drugs are always safe.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Visits to health care providers may be reduced when clients self-medicate, following the directions that come with the medication, for minor ailments."
    }
   ],
   "community_solutions": []
  }
