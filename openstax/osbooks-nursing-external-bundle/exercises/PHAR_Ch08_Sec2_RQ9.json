 "questions": [
  {
   "id": 660359,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is reviewing laboratory reports for a client receiving chemotherapy and notes an absolute neutrophil count of 1.4 cells/mcL. Which order should the nurse anticipate?",
   "answers": [
    {
     "id": 1310551,
     "content_html": "Epoetin alfa",
     "correctness": "0.0"
    },
    {
     "id": 1310552,
     "content_html": "Filgrastim",
     "correctness": "1.0"
    },
    {
     "id": 1310550,
     "content_html": "Packed red blood cells",
     "correctness": "0.0"
    },
    {
     "id": 1310549,
     "content_html": "Interferon A",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because this client has a low absolute neutrophil count, the nurse anticipates an order for filgrastim to stimulate stem cell production of white blood cells."
    }
   ],
