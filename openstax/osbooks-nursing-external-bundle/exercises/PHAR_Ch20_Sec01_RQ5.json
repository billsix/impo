 "questions": [
  {
   "id": 660473,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client with a pulmonary embolism about their new medication, heparin. What will the nurse tell the client about the purpose of heparin?",
   "answers": [
    {
     "id": 1311007,
     "content_html": "It will dissolve the blood clot quickly.",
     "correctness": "0.0"
    },
    {
     "id": 1311006,
     "content_html": "It will prevent platelet-to-platelet adhesion.",
     "correctness": "0.0"
    },
    {
     "id": 1311005,
     "content_html": "It will enhance clotting.",
     "correctness": "0.0"
    },
    {
     "id": 1311008,
     "content_html": "It will prevent further clot formation.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Heparin is an anticoagulant. It will prevent further clot formation while the body naturally breaks down the clot, but it will not directly dissolve the clot."
    }
   ],
   "community_solutions": []
  }
 ],
