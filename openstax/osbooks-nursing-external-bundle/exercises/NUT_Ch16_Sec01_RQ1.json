   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client in the first trimester of pregnancy. Which assessment finding requires follow-up by the nurse?",
   "answers": [
    {
     "id": 1310008,
     "content_html": "Decreased GFR",
     "correctness": "1.0"
    },
    {
     "id": 1310007,
     "content_html": "Increased fluid retention",
     "correctness": "0.0"
    },
    {
     "id": 1310006,
     "content_html": "Mild glycosuria ",
     "correctness": "0.0"
    },
    {
     "id": 1310005,
     "content_html": "Proteinuria",
     "correctness": "0.0"
    }
   ],
