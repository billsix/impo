   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which environmental condition is a consequence of the redlining of neighborhoods that has negatively affected health outcomes of BIPOC individuals?",
   "answers": [
    {
     "id": 1275119,
     "content_html": "Decreased urban heat",
     "correctness": "0.0"
    },
    {
     "id": 1275120,
     "content_html": "Less green space",
     "correctness": "1.0"
    },
    {
     "id": 1275118,
     "content_html": "Improved air quality",
     "correctness": "0.0"
    },
    {
     "id": 1275117,
     "content_html": "Increased access to clean water",
     "correctness": "0.0"
    }
   ],
