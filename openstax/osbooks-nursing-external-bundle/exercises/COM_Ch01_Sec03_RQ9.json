   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which concept should the nurse utilize when planning transitional care for a population?",
   "answers": [
    {
     "id": 1274931,
     "content_html": "Providing care in multiple areas of the care continuum to address all client needs",
     "correctness": "0.0"
    },
    {
     "id": 1274930,
     "content_html": "Reactively managing health conditions during transitions between health care sites",
     "correctness": "0.0"
    },
    {
     "id": 1274929,
     "content_html": "Preventing hospital readmissions and adverse events",
     "correctness": "0.0"
    },
    {
     "id": 1274932,
     "content_html": "Coordinating clients as they move between care settings",
     "correctness": "1.0"
    }
   ],
