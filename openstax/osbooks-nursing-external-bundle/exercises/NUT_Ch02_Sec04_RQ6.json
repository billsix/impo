   "id": 660092,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is assessing a client who describes the color of their urine as pale yellow. Which statement would the nurse give to the client?",
   "answers": [
    {
     "id": 1309483,
     "content_html": "“You probably have a urinary tract infection.”",
     "correctness": "0.0"
    },
    {
     "id": 1309482,
     "content_html": "“You need to drink more fluids.”",
     "correctness": "0.0"
    },
    {
     "id": 1309481,
     "content_html": "“You need to decrease your water intake.”",
     "correctness": "0.0"
    },
    {
     "id": 1309484,
     "content_html": "“You are well hydrated.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client who is well hydrated will have pale or light-colored urine."
    }
   ],
