  {
   "id": 647588,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which intervention can the nurse implement to reduce the spread of infectious disease in a correctional facility?",
   "answers": [
    {
     "id": 1276039,
     "content_html": "Encouraging daily handwashing",
     "correctness": "0.0"
    },
    {
     "id": 1276038,
     "content_html": "Asking about HIV status at intake to a correctional setting",
     "correctness": "0.0"
    },
    {
     "id": 1276037,
     "content_html": "Questioning people about sexual practices",
     "correctness": "0.0"
    },
    {
     "id": 1276040,
     "content_html": "Advocating for vaccination for hepatitis A and hepatitis B",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Infectious diseases are a major concern in correctional facilities where the environmental conditions make the spread of infectious disease more likely. The CDC recommends primary prevention for hepatitis A in correctional setting by beginning the hepatitis A for all unvaccinated juveniles under the age of 18 and all adults who are at increased risk for hepatitis A infection such as men who have sex with men, those who use IV drugs, and individuals experiencing homelessness. The CDC also recommends beginning the hepatitis B vaccine series for juveniles and unvaccinated adults."
    }
   ],
   "community_solutions": []
  }
