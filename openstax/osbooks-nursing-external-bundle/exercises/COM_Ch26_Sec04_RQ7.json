   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "When comparing health outcomes between adult men and adult women in the United States, it is important to consider potential disparities. Cerebrovascular disease is a major disease in both genders, but adult women tend to have higher rates compared to adult men."
    }
