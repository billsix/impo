 "questions": [
  {
   "id": 647559,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which health disparity would the public health nurse apply when developing community adult health education programs?",
   "answers": [
    {
     "id": 1275923,
     "content_html": "Men have a higher life expectancy compared to women.",
     "correctness": "0.0"
    },
    {
     "id": 1275924,
     "content_html": "Women experience higher rates of cerebrovascular disease compared to men.",
     "correctness": "1.0"
    },
    {
     "id": 1275922,
     "content_html": "Women have a higher mortality rate compared to men.",
     "correctness": "0.0"
    },
    {
     "id": 1275921,
     "content_html": "Men experience higher rates of COPD compared to women.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
