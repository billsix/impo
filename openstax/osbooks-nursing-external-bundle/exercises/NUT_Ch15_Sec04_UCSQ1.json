   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on these assessment findings, what would the nurse document about the success of the nutritional plan for Mr. Vasquez?",
   "answers": [
    {
     "id": 887473,
     "content_html": "Plan is effective.",
     "correctness": "0.0"
    },
    {
