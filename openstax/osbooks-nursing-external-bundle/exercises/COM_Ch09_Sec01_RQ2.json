 "questions": [
  {
   "id": 647384,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse researcher has found that clients living in rural areas tend to have higher rates of hospitalization for chronic lung disease than those living in affluent urban areas. Which of the following terms describes what the nurse researcher has identified?",
   "answers": [
    {
     "id": 1275224,
     "content_html": "Health disparities",
     "correctness": "1.0"
    },
    {
     "id": 1275223,
     "content_html": "Health determinants",
     "correctness": "0.0"
    },
    {
     "id": 1275222,
     "content_html": "Intersectionality",
     "correctness": "0.0"
    },
    {
     "id": 1275221,
     "content_html": "Socially disadvantaged populations",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A health disparity is a health difference that adversely affects disadvantaged populations in comparison to a reference population based on one or more health outcomes."
    }
   ],
   "community_solutions": []
  }
