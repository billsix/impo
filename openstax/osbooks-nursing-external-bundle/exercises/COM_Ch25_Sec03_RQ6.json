 "questions": [
  {
   "id": 647548,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which outcome is a potential consequence of power imbalances in nurse-client interactions?",
   "answers": [
    {
     "id": 1275879,
     "content_html": "Increased client autonomy and decision making",
     "correctness": "0.0"
    },
    {
     "id": 1275878,
     "content_html": "Enhanced trust and rapport between the nurse and client",
     "correctness": "0.0"
    },
    {
     "id": 1275880,
     "content_html": "Unequal treatment and compromised client autonomy",
     "correctness": "1.0"
    },
    {
     "id": 1275877,
     "content_html": "Improved communication and understanding between parties",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "In nursing, power imbalances can create conflicts and hinder effective communication between nurses and clients due to differing roles, knowledge, and authority. Power imbalances can lead to unequal treatment, where nurses may make decisions without considering client preferences. This compromises client autonomy and can result in decisions that may not align with the client’s wishes or values."
    }
   ],
   "community_solutions": []
  }
