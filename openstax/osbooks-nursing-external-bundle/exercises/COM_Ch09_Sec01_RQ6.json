 "questions": [
  {
   "id": 647388,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A public health nurse determines that a non-English-speaking Hispanic client needs additional medical evaluation and treatment for cancer. Which of the following statements best describes the nurse’s assessment of this situation?",
   "answers": [
    {
     "id": 1275239,
     "content_html": "This client is insured and should be able to receive treatment accompanied by a medical interpreter.",
     "correctness": "0.0"
    },
    {
     "id": 1275238,
     "content_html": "This client has a primary care provider who should be able to help the client navigate the system.",
     "correctness": "0.0"
    },
    {
     "id": 1275237,
     "content_html": "This client’s access to health care may be limited by the ability of the health care system to provide services when they are needed.",
     "correctness": "0.0"
    },
    {
     "id": 1275240,
     "content_html": "This client’s access to health care may be limited by the availability of culturally competent providers.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Inadequate availability of culturally competent providers can limit health care access for non-English-speaking clients."
    }
   ],
   "community_solutions": []
  }
 ],
