 "questions": [
  {
   "id": 660534,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is caring for a client with acromegaly. Which explanation of this disorder will the nurse give to the client?",
   "answers": [
    {
     "id": 1311251,
     "content_html": "“Excess growth hormone causes increased bone density.”",
     "correctness": "0.0"
    },
    {
     "id": 1311250,
     "content_html": "“Increased growth hormone results in decreased insulin resistance.”",
     "correctness": "0.0"
    },
    {
     "id": 1311249,
     "content_html": "“Elevated growth hormone leads to increased muscle mass and strength.”",
     "correctness": "0.0"
    },
    {
     "id": 1311252,
     "content_html": "“Too much growth hormone causes abnormal growth of bones and soft tissues.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Acromegaly is a disorder caused by excessive growth hormone secretion from the pituitary, which results in abnormal growth of bones and soft tissues."
    }
   ],
   "community_solutions": []
  }
