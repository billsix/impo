   "stimulus_html": "",
   "stem_html": "Which statement explains the correlation of Katrice’s obesity and her pulmonary health?",
   "answers": [
    {
     "id": 891332,
     "content_html": "Obesity is a nonmodifiable risk factor and shouldn’t be the focus for asthma clients.",
     "correctness": "0.0"
    },
    {
     "id": 891333,
     "content_html": "Obesity increases a client’s likelihood of access to vital nutrients.",
     "correctness": "0.0"
    },
    {
     "id": 891334,
     "content_html": "Obesity alters the mechanics of the pulmonary system, leading to wheezing and airway hyperresponsiveness.",
     "correctness": "1.0"
    },
