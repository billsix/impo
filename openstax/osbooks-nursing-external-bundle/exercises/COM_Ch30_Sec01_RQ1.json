   "id": 647593,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which transition of care intervention would the community health nurse perform when a client is discharged from the hospital to home?",
   "answers": [
    {
     "id": 1276059,
     "content_html": "Assisting the client with activities of daily living",
     "correctness": "0.0"
    },
    {
     "id": 1276058,
     "content_html": "Administering medications in the home setting",
     "correctness": "0.0"
    },
    {
     "id": 1276060,
     "content_html": "Performing medication reconciliation",
     "correctness": "1.0"
    },
    {
     "id": 1276057,
     "content_html": "Transporting client to medical appointments",
     "correctness": "0.0",
     "feedback_html": ""
