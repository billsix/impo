   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Transitional care refers to the provision of care to clients during transitions between different health care settings, ensuring continuity and safety. Medication reconciliation is an important intervention during transitional care to review and reconcile medication lists, address changes in medications, provide education, and promote adherence to prevent medication errors and adverse events during transitions."
    }
   ],
