 "questions": [
  {
   "id": 660420,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with a history of opioid use disorder is prescribed naltrexone to aid in abstaining from opioid use. Which information will the nurse give the client?",
   "answers": [
    {
     "id": 1310795,
     "content_html": "This drug reverses an accidental overdose.",
     "correctness": "0.0"
    },
    {
     "id": 1310796,
     "content_html": "This drug blunts the effects of opioids.",
     "correctness": "1.0"
    },
    {
     "id": 1310794,
     "content_html": "This drug can cause euphoria.",
     "correctness": "0.0"
    },
    {
     "id": 1310793,
     "content_html": "This drug causes a high feeling.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Naltrexone is an opioid antagonist that can be used orally and intramuscularly to aid clients who are attempting to quit using opioids. While the client is taking naltrexone, any opioids taken will not be able to activate opioid receptors, blunting the effects of opioids and the feelings of euphoria."
    }
   ],
   "community_solutions": []
  }
 ],
