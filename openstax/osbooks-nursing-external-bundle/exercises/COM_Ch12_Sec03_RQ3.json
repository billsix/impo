   "id": 647415,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The school nurse is developing a plan to reduce direct transmission of disease. Which mode of transmission will be included in this plan?",
   "answers": [
    {
     "id": 1275348,
     "content_html": "Droplet spread",
     "correctness": "1.0"
    },
    {
     "id": 1275347,
     "content_html": "Foodborne",
     "correctness": "0.0"
    },
    {
     "id": 1275346,
     "content_html": "Mosquito borne",
     "correctness": "0.0"
    },
    {
     "id": 1275345,
     "content_html": "Surface spread",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Direct transmission occurs when an infectious agent is transmitted by direct contact or droplet spread. Droplet spread is considered direct transmission as the particles travel only a short distance and do not remain suspended in the air for long periods of time or distance."
    }
   ],
