 "questions": [
  {
   "id": 660592,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge instructions to a client with a gastric ulcer who is taking sucralfate. What information regarding administration is important to stress to the client?",
   "answers": [
    {
     "id": 1311484,
     "content_html": "Take this medication 4 times a day; do not miss a dose.",
     "correctness": "1.0"
    },
    {
     "id": 1311483,
     "content_html": "Limit dietary fiber and fluids.",
     "correctness": "0.0"
    },
    {
     "id": 1311482,
     "content_html": "Take with an antacid as needed.",
     "correctness": "0.0"
    },
    {
     "id": 1311481,
     "content_html": "It is safe to take before dialysis.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sucralfate adheres to the stomach lining for about 6 hours and will need to be repeated to ensure protection of the mucosal lining."
    }
   ],
   "community_solutions": []
  }
