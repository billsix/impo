   "stimulus_html": "",
   "stem_html": "Which mineral deficiency should the nurse anticipate in the client diagnosed with goiter?",
   "answers": [
    {
     "id": 1309511,
     "content_html": "Iron",
     "correctness": "0.0"
    },
    {
     "id": 1309512,
