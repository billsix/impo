 "questions": [
  {
   "id": 647526,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which concept does the nurse identify as an organizational barrier to culturally competent health care in a community?",
   "answers": [
    {
     "id": 1275791,
     "content_html": "Not enough primary care providers in a community",
     "correctness": "0.0"
    },
    {
     "id": 1275792,
     "content_html": "A lack of medical interpreters",
     "correctness": "1.0"
    },
    {
     "id": 1275790,
     "content_html": "Absence of health care insurance",
     "correctness": "0.0"
    },
    {
     "id": 1275789,
     "content_html": "An inability to afford health care",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "An organizational barrier is one that exists within an organization. It includes the provision of linguistically competent services, such as medical interpreters. Structural inequities are systemic barriers and disparities in a health care system that block individuals or groups from receiving high-quality care, such as an insufficient number of primary care providers and the inability of individuals to afford health care or obtain health care insurance."
    }
   ],
   "community_solutions": []
  }
 ],
