   "stimulus_html": "",
   "stem_html": "Nutrition can impact the development of neurofibrillary tangles that are found in individuals with Alzheimer’s disease. Which of the following provides structural strength to microtubules in the neuron?",
   "answers": [
    {
     "id": 1309587,
     "content_html": "Beta-amyloid",
     "correctness": "0.0"
    },
    {
     "id": 1309586,
     "content_html": "Amyloid precursor protein",
     "correctness": "0.0"
    },
    {
     "id": 1309588,
     "content_html": "Tau protein",
     "correctness": "1.0"
    },
    {
     "id": 1309585,
     "content_html": "Microglia",
     "correctness": "0.0"
    }
   ],
