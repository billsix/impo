 "questions": [
  {
   "id": 660200,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is instructing a client with chronic obstructive pulmonary disease  (COPD) on strategies to maximize food intake. Which of the following responses by the client indicates additional education is needed?",
   "answers": [
    {
     "id": 1309915,
     "content_html": "“I will treat myself to cake or pudding for dessert.”",
     "correctness": "0.0"
    },
    {
     "id": 1309914,
     "content_html": "“I will eat add cheese to my food whenever possible.”",
     "correctness": "0.0"
    },
    {
     "id": 1309913,
     "content_html": "“I will eat more cold foods rather than hot meals.”",
     "correctness": "0.0"
    },
    {
     "id": 1309916,
     "content_html": "“I will try to eat as much as I can during the evening before I go to bed.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client should eat smaller, more frequent meals. Larger meals should be consumed earlier in the day when the client is less tired."
    }
   ],
   "community_solutions": []
  }
 ],
