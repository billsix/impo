 "questions": [
  {
   "id": 647536,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by a nurse promotes a welcoming environment for culturally diverse clients?",
   "answers": [
    {
     "id": 1275831,
     "content_html": "Calling the client by the name on their birth certificate",
     "correctness": "0.0"
    },
    {
     "id": 1275830,
     "content_html": "Using a family member to interpret for a client with LEP",
     "correctness": "0.0"
    },
    {
     "id": 1275832,
     "content_html": "Displaying brochures and posters that represent diversity",
     "correctness": "1.0"
    },
    {
     "id": 1275829,
     "content_html": "Providing a client’s bill of rights in languages other than English",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Creating a welcoming environment is part of the Promoting Cultural and Linguistic Competency Self-Assessment Checklist. The nurse can help create a welcoming environment by displaying posters, brochures, and other materials that represent the diversity of the client population."
    }
   ],
   "community_solutions": []
  }
 ],
