 "questions": [
  {
   "id": 647569,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following scenarios contains a barrier to care for individuals with disabilities at a clinic?",
   "answers": [
    {
     "id": 1275964,
     "content_html": "The practice is very busy, and 15 minutes are allotted per client encounter.",
     "correctness": "1.0"
    },
    {
     "id": 1275963,
     "content_html": "Sidewalks with curb outlets and ramps with automated door openers are available.",
     "correctness": "0.0"
    },
    {
     "id": 1275962,
     "content_html": "A web-based interpreter service that is closed-captioned with large print is used. ",
     "correctness": "0.0"
    },
    {
     "id": 1275961,
     "content_html": "The clinic has large examination rooms with mobile medical equipment.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Individuals with disabilities face frequent barriers to care. Aspects of care that create barriers to providing optimal and equitable care are an inaccessible physical environment, a lack of assistive technology for communication, programmatic barriers of lack of time for medical examinations, negative attitudes toward individuals with disabilities, and social and transportation barriers. Allotting 15 minutes per client encounter is a barrier to providing comprehensive care to individuals who require modifications due to mobility, hearing, or vision difficulties."
    }
   ],
   "community_solutions": []
  }
 ],
