   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After reviewing the client’s symptoms, the nurse anticipates which diagnosis by the health care provider?",
   "answers": [
    {
     "id": 944140,
     "content_html": "Gestational diabetes",
     "correctness": "0.0"
    },
