   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Due to the client’s age, gradual onset of symptoms and sedentary lifestyle, she will most likely be diagnosed with type 2 diabetes mellitus. This client’s symptoms of fatigue, polyuria, thirst, and blurred vision are consistent with this diagnosis."
    }
