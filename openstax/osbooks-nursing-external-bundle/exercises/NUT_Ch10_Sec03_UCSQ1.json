 "questions": [
  {
   "id": 366591,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse should include which of the following in Catalina’s discharge instructions regarding taking oral iron?",
   "answers": [
    {
     "id": 888657,
     "content_html": "Iron should be taken with milk or tea.",
     "correctness": "0.0"
    },
    {
     "id": 888658,
     "content_html": "If stomach discomfort occurs, take the iron with an antacid.",
     "correctness": "0.0"
    },
    {
     "id": 888659,
     "content_html": "If a dose is missed, double the dose for the next day.",
     "correctness": "0.0"
    },
    {
     "id": 888660,
     "content_html": "Iron should be taken with orange juice to enhance absorption.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Taking iron with orange juice will increase gastrointestinal absorption. Taking iron with milk, tea, or coffee can decrease its absorption. Antacids should be taken 2 hours before or 4 hours after taking iron for better absorption because iron is better absorbed in an acidic environment. Missed doses of iron should not be made up."
    }
   ],
   "community_solutions": []
  }
 ],
