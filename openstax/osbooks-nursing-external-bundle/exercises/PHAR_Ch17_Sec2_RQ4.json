 "questions": [
  {
   "id": 660444,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse provided education to a client who will be taking quinidine long term. Which response from the client indicates the teaching was effective?",
   "answers": [
    {
     "id": 1310891,
     "content_html": "“I should start taking a laxative to prevent the most common side effect, constipation.”",
     "correctness": "0.0"
    },
    {
     "id": 1310890,
     "content_html": "“Quinine is another name for quinidine and may be on my prescription bottle.”",
     "correctness": "0.0"
    },
    {
     "id": 1310889,
     "content_html": "“I should drink grapefruit juice to ensure my vitamin levels are adequate.”",
     "correctness": "0.0"
    },
    {
     "id": 1310892,
     "content_html": "“If I experience excessive diarrhea, I should alert my provider.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Quinidine is associated with a high incidence of diarrhea. Because diarrhea can cause electrolyte abnormalities, excessive diarrhea should be reported to the health care provider."
    }
   ],
   "community_solutions": []
  }
 ],
