   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which intervention would the nurse include in a plan of care for a client in the preparation stage of the transtheoretical model?",
   "answers": [
    {
     "id": 1275579,
     "content_html": "Provide education on the benefits of weight loss",
     "correctness": "0.0"
    },
    {
     "id": 1275580,
     "content_html": "Assist in development of realistic goals for weight loss",
     "correctness": "1.0"
    },
    {
     "id": 1275578,
     "content_html": "Assist in identification of triggers for return to a sedentary lifestyle",
     "correctness": "0.0"
    },
    {
     "id": 1275577,
     "content_html": "Provide positive reinforcement after starting an exercise program",
     "correctness": "0.0"
    }
