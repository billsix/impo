 "questions": [
  {
   "id": 647561,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which intervention would the public health nurse implement in the community to address the Healthy People 2030 goal of reducing falls in older adults?",
   "answers": [
    {
     "id": 1275931,
     "content_html": "Provide assistive ambulation devices",
     "correctness": "0.0"
    },
    {
     "id": 1275930,
     "content_html": "Encourage sedentary activity",
     "correctness": "0.0"
    },
    {
     "id": 1275932,
     "content_html": "Reduce inappropriate medications",
     "correctness": "1.0"
    },
    {
     "id": 1275929,
     "content_html": "Ambulate only with a caregiver",
     "correctness": "0.0"
    }
   ],
