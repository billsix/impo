 "questions": [
  {
   "id": 647612,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse working in a refugee camp should consider which of the following when working with refugees in the camp?",
   "answers": [
    {
     "id": 1276135,
     "content_html": "Refugees do not receive protection under international law.",
     "correctness": "0.0"
    },
    {
     "id": 1276134,
     "content_html": "Refugees can return to their home country after fleeing and seeking asylum in another country.",
     "correctness": "0.0"
    },
    {
     "id": 1276136,
     "content_html": "Their health is influenced by both camp conditions and their country of origin.",
     "correctness": "1.0"
    },
    {
     "id": 1276133,
     "content_html": "Most refugee camps are built according to public health standards.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Refugees’ health status is influenced by conditions in their home countries, conditions during their travel, and conditions present in their camp."
    }
   ],
   "community_solutions": []
  }
 ],
