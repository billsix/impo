 "questions": [
  {
   "id": 660341,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with osteoarthritis is prescribed indomethacin, a nonsteroidal anti-inflammatory drug (NSAID). The client has also been taking aspirin over the counter to assist with the pain. The nurse should monitor the client for which potential adverse effect?",
   "answers": [
    {
     "id": 1310479,
     "content_html": "Hyperglycemia",
     "correctness": "0.0"
    },
    {
     "id": 1310478,
     "content_html": "Respiratory depression",
     "correctness": "0.0"
    },
    {
     "id": 1310480,
     "content_html": "Gastrointestinal bleeding",
     "correctness": "1.0"
    },
    {
     "id": 1310477,
     "content_html": "Hypotension",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "NSAIDs can cause irritation and damage to the gastrointestinal lining, resulting in gastrointestinal bleeding."
    }
   ],
   "community_solutions": []
  }
