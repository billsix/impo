   "id": 660169,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client about sickle cell disease. Which of the following dietary strategies can decrease the risk of disease complications?",
   "answers": [
    {
     "id": 1309791,
     "content_html": "Eating several small meals throughout the day",
     "correctness": "0.0"
    },
    {
     "id": 1309790,
     "content_html": "Limiting carbohydrate intake",
     "correctness": "0.0"
    },
    {
     "id": 1309792,
     "content_html": "Consuming dairy products and other sources of vitamin D",
     "correctness": "1.0"
    },
    {
     "id": 1309789,
     "content_html": "Avoiding seafood",
     "correctness": "0.0"
    }
   ],
