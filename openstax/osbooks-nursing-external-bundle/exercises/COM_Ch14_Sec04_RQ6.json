   "id": 647438,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is performing an environmental assessment in an apartment building where many people have reported burning eyes, skin rash, stuffy nose, and sore throat. Which type of hazard does the nurse anticipate is present in the apartment building?",
   "answers": [
    {
     "id": 1275439,
     "content_html": "Radon",
     "correctness": "0.0"
    },
    {
     "id": 1275438,
     "content_html": "Mice",
     "correctness": "0.0"
    },
    {
     "id": 1275440,
     "content_html": "Mold",
     "correctness": "1.0"
    },
    {
     "id": 1275437,
     "content_html": "Lead",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Mold, a biological in-home health hazard, can produce burning eyes, skin rash, stuffy nose, and sore throat as well as coughing and wheezing."
    }
   ],
