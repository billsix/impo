   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The underlying theme of universal design is ensuring access for everyone. It refers to the design of spaces, communication modalities, environments, and products that are accessible and usable by all individuals including those with disability needs and chronic illness."
    }
