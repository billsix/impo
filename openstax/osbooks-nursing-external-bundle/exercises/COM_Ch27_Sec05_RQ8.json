   "stimulus_html": "",
   "stem_html": "The nurse recognizes that the concept of universal design emphasizes which component?",
   "answers": [
    {
     "id": 1275967,
     "content_html": "Disability needs",
     "correctness": "0.0"
    },
    {
     "id": 1275966,
