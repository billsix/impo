   "id": 660301,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The provider ordered moxifloxacin 400 mg IV piggyback daily. The pharmacy supplied moxifloxacin 400 mg in 250 mL normal saline. The instructions are to infuse over 60 minutes. At how many mL/hour will the infusion pump be set?",
   "answers": [
    {
     "id": 1310319,
     "content_html": "100 mL/hour",
     "correctness": "0.0"
    },
    {
     "id": 1310318,
     "content_html": "200 mL/hour",
     "correctness": "0.0"
    },
    {
     "id": 1310320,
     "content_html": "250 mL/hour",
     "correctness": "1.0"
    },
    {
     "id": 1310317,
     "content_html": "400 mL/hour",
     "correctness": "0.0"
    }
   ],
