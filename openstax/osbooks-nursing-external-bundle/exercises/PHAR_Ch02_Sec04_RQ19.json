   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse sets up the following equation: <span data-math=\"D\\;÷\\;H\\; \\times \\;Q\\; = \\;A\"></span>. <span data-math=\"D\"></span> represents the desired dose (the dose ordered), <span data-math=\"H\"></span> the amount on hand or available, <span data-math=\"Q\"></span> the quantity or volume of the drug form (tablet, capsule, liquid), and <span data-math=\"A\"></span> the amount calculated to be administered to the client. Therefore, <span data-math=\"400\\;\\text{mg}\\;÷\\;400\\;\\text{mg}\\; \\times \\;250\\;\\text{mL}\\; = \\;250\\;\\text{mL}\"></span> to be infused over 1 hour."
    }
   ],
