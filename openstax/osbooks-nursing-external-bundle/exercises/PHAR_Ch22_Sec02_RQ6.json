  {
   "id": 660498,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The health care provider has ordered diltiazem IV bolus 0.25 mg/kg for a client with atrial fibrillation with rapid ventricular response. The client weighs 176 lb (80 kg). What is the correct dose of diltiazem for the nurse to administer?",
   "answers": [
    {
     "id": 1311107,
     "content_html": "15 mg",
     "correctness": "0.0"
    },
    {
     "id": 1311108,
     "content_html": "20 mg",
     "correctness": "1.0"
    },
    {
     "id": 1311106,
     "content_html": "25 mg",
     "correctness": "0.0"
    },
    {
     "id": 1311105,
     "content_html": "30 mg",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The ordered dose of diltiazem is 0.25 mg/kg, and <span data-math=\"176\\;\\mathrm{lb}\\;÷\\;2.2\\;\\mathrm{kg}\\;=\\;80\\;\\mathrm{kg},\"></span> so <span data-math=\"0.25\\;\\mathrm{mg}/\\mathrm{kg}\\;\\times\\;80\\;\\mathrm{kg}=\\;20\\;\\mathrm{mg}.\"></span>"
    }
   ],
   "community_solutions": []
  }
 ],
