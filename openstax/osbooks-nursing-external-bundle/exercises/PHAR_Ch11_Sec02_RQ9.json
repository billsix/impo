 "questions": [
  {
   "id": 660387,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is preparing medications for assigned clients. The nurse calls the prescriber concerned about administering benztropine to one of the clients. What would be the reason for the concern?",
   "answers": [
    {
     "id": 1310663,
     "content_html": "58-year-old with diarrhea",
     "correctness": "0.0"
    },
    {
     "id": 1310662,
     "content_html": "66-year-old with urinary incontinence",
     "correctness": "0.0"
    },
    {
     "id": 1310664,
     "content_html": "84-year-old with glaucoma",
     "correctness": "1.0"
    },
    {
     "id": 1310661,
     "content_html": "74-year-old with symptomatic bradycardia",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Benztropine is an anticholinergic. One of the adverse effects of this classification is the potential to increase intraocular pressure; therefore, it should be avoided in clients with glaucoma."
    }
   ],
   "community_solutions": []
  }
