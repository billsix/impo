 "questions": [
  {
   "id": 420776,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement indicates Katrice and her parents understand the normal function of the pulmonary system?",
   "answers": [
    {
     "id": 926640,
     "content_html": "“It’s ok if I wheeze every day; as long as I use the inhaler, my lung function will stay the same for my whole life.”",
     "correctness": "0.0"
    },
    {
     "id": 926641,
     "content_html": "“The pulmonary system goes from my mouth through to the bottom of my lungs; it’s how my body gets oxygen.”",
     "correctness": "1.0"
    },
    {
     "id": 926642,
     "content_html": "“Wheezing is a sign that my airways have expanded too much, and air is moving through them too fast.”",
     "correctness": "0.0"
    },
    {
     "id": 926643,
     "content_html": "“Secondhand smoke doesn’t affect the lung tissue.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The pulmonary or respiratory system comprises the upper airways, the lower airways, lungs, and alveolar sacs. The primary function of the pulmonary system is to ensure adequate oxygenation throughout the body."
    }
   ],
   "community_solutions": []
  }
