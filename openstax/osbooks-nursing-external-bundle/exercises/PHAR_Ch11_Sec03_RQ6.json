 "questions": [
  {
   "id": 660391,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client who is going to begin therapy with the immunomodulator teriflunomide. Which test is important to have done before the drug is started?",
   "answers": [
    {
     "id": 1310679,
     "content_html": "Serum creatinine",
     "correctness": "0.0"
    },
    {
     "id": 1310678,
     "content_html": "Hemoglobin A1C",
     "correctness": "0.0"
    },
    {
     "id": 1310680,
     "content_html": "Tuberculin skin test",
     "correctness": "1.0"
    },
    {
     "id": 1310677,
     "content_html": "Liver function test",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "This drug can exacerbate tuberculosis. If a tuberculin skin test and chest radiograph (x-ray) are positive, the client must be treated for TB before starting the prescribed drug."
    }
   ],
   "community_solutions": []
  }
