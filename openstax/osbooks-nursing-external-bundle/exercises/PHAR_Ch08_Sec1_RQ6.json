 "questions": [
  {
   "id": 660353,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which finding should the nurse expect in a client with acute myelogenous leukemia who has developed tumor lysis syndrome?",
   "answers": [
    {
     "id": 1310527,
     "content_html": "Hypokalemia",
     "correctness": "0.0"
    },
    {
     "id": 1310526,
     "content_html": "Hypophosphatemia",
     "correctness": "0.0"
    },
    {
     "id": 1310528,
     "content_html": "Hypocalcemia",
     "correctness": "1.0"
    },
    {
     "id": 1310525,
     "content_html": "Alkalosis",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Tumor lysis syndrome occurs when cancer cells are destroyed, releasing cellular debris and electrolytes into the blood, resulting in hypocalcemia, hyperkalemia, hyperphosphatemia, and acidosis."
    }
   ],
   "community_solutions": []
  }
