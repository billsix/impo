 "questions": [
  {
   "id": 366399,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Because of Gordon’s history of chronic renal disease, which symptom should the nurse tell him to report immediately if it occurs?",
   "answers": [
    {
     "id": 888209,
     "content_html": "Increased urine output",
     "correctness": "0.0"
    },
    {
     "id": 888210,
     "content_html": "Decreased urine output",
     "correctness": "1.0"
    },
    {
     "id": 888211,
     "content_html": "Weight loss of 3 pounds in a week",
     "correctness": "0.0"
    },
    {
     "id": 888212,
     "content_html": "Weight gain of 3 pounds in a week",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Anuria is a contraindication to diuretic administration. Accordingly, decreasing urine output should be reported to the health care provider because it could indicate that the client’s renal function is deteriorating."
    }
   ],
   "community_solutions": []
  }
