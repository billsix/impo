  {
   "id": 660179,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is evaluating a client at a follow-up appointment who reports following a heart-healthy nutritional plan for 3 months. Which objective data should the nurse utilize to support the client’s statement?",
   "answers": [
    {
     "id": 1309832,
     "content_html": "BMI change from 30 to 29 kg/m<sup>2</sup>",
     "correctness": "1.0"
    },
    {
     "id": 1309831,
     "content_html": "LDL change from 100 to 110 mg/dL",
     "correctness": "0.0"
    },
    {
     "id": 1309830,
     "content_html": "Blood pressure from 142/88 to 144/86  mm Hg",
     "correctness": "0.0"
    },
    {
     "id": 1309829,
     "content_html": "Increased shortness of breath",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client’s body mass index (BMI) has decreased from 30 kg/m<sup>2</sup>, in the obese range, to 29 kg/m<sup>2</sup>, in the overweight range."
    }
   ],
