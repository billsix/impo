 "questions": [
  {
   "id": 660263,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is educating a client about the FRAX assessment. Which statement by the client indicates the need for further teaching?",
   "answers": [
    {
     "id": 1310168,
     "content_html": "“The FRAX will tell my doctor if I have osteoporosis.”",
     "correctness": "1.0"
    },
    {
     "id": 1310167,
     "content_html": "“The FRAX will tell my doctor if I’m at risk for a fracture.”",
     "correctness": "0.0"
    },
    {
     "id": 1310166,
     "content_html": "“The results of the FRAX will help the nurse develop my plan of care.”",
     "correctness": "0.0"
    },
    {
     "id": 1310165,
     "content_html": "“The FRAX is a risk assessment for osteoporosis.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The FRAX does not diagnose osteoporosis, but it can estimate a person’s risk for a bone fracture within 10 years. This information can help the nurse and client plan care and implement strategies to help mitigate risks in the home and other environments."
    }
   ],
   "community_solutions": []
  }
