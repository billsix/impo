 "questions": [
  {
   "id": 364238,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following assessment questions is the most important for the nurse to ask this client to obtain more information about their nutritional status?",
   "answers": [
    {
     "id": 881324,
     "content_html": "Have you experienced any changes in your weight or appetite?",
     "correctness": "1.0"
    },
    {
     "id": 881325,
     "content_html": "Do you have trouble sleeping?",
     "correctness": "0.0"
    },
    {
     "id": 881326,
     "content_html": "Are you able to track what you eat?",
     "correctness": "0.0"
    },
    {
     "id": 881327,
     "content_html": "Do you like to cook?",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Although all these questions can provide information about the client’s nutrition, it is most important to identify if the client has had changes in their weight or appetite which can directly reflect her current physical health."
    }
   ],
   "community_solutions": []
  }
 ],
