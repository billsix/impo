   "stimulus_html": "",
   "stem_html": "A client presents with hyperaldosteronism. What assessment findings should the nurse expect?",
   "answers": [
    {
     "id": 1311283,
     "content_html": "Decreased blood pressure, increased potassium levels",
     "correctness": "0.0"
