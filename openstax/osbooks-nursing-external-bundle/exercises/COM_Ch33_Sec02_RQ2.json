   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which information would the nurse provide to a state legislator about the need for safe staffing ratios in hospitals?",
   "answers": [
    {
     "id": 1276183,
     "content_html": "A six-client-to-one nurse ratio on a medical-surgical unit is ideal for positive client outcomes.",
     "correctness": "0.0"
    },
    {
     "id": 1276184,
     "content_html": "Inadequate client-nurse ratios increased mortality during the COVID-19 pandemic.",
     "correctness": "1.0"
    },
    {
     "id": 1276182,
     "content_html": "Client-to-nurse staffing ratios do not adversely affect client outcomes.",
     "correctness": "0.0"
    },
    {
     "id": 1276181,
     "content_html": "Safe staffing ratios should be set by each hospital.",
     "correctness": "0.0"
    }
