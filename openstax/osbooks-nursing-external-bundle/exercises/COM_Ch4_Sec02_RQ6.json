   "id": 647338,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is explaining to a client that smoking cessation will add years of quality to their life. Which population health metric is the nurse describing?",
   "answers": [
    {
     "id": 1275039,
     "content_html": "Years of healthy life lost due to disability",
     "correctness": "0.0"
    },
    {
     "id": 1275038,
     "content_html": "Disability-adjusted life years",
     "correctness": "0.0"
    },
    {
     "id": 1275040,
     "content_html": "Quality-adjusted life years",
     "correctness": "1.0"
    },
    {
     "id": 1275037,
     "content_html": "Years of life lost",
     "correctness": "0.0"
    }
   ],
