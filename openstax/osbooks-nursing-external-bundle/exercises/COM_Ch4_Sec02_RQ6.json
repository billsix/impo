   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The years of reasonable quality of life that the client will gain after quitting smoking are referred to as quality-adjusted life years."
    }
   ],
