 "questions": [
  {
   "id": 647461,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the concept of holism in community-based nursing?",
   "answers": [
    {
     "id": 1275531,
     "content_html": "Focuses on the physical health of individuals living in the community",
     "correctness": "0.0"
    },
    {
     "id": 1275530,
     "content_html": "Treats hospitals and clinics, transportation, food stores, and green space as separate entities",
     "correctness": "0.0"
    },
    {
     "id": 1275532,
     "content_html": "Recognizes the interconnectedness of community policies, health risks, and medical services",
     "correctness": "1.0"
    },
    {
     "id": 1275529,
     "content_html": "Implements evidence-based practices for the needs and wants of specific communities",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Holism is the concept that all parts of a whole are interconnected and do not exist or function without each other. When applied to community-based nursing, holism means that the nurse must consider that the whole community comprises multiple dimensions of health."
    }
   ],
   "community_solutions": []
  }
