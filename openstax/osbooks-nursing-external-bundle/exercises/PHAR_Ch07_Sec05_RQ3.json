 "questions": [
  {
   "id": 660350,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is counseling a client about their new tuberculosis diagnosis and the medications they will be taking. Which of the following educational points should the nurse make to the client?",
   "answers": [
    {
     "id": 1310515,
     "content_html": "“Your urine may turn blue.”",
     "correctness": "0.0"
    },
    {
     "id": 1310516,
     "content_html": "“Follow up with the health care provider if you cannot tell the difference between green and red.”",
     "correctness": "1.0"
    },
    {
     "id": 1310514,
     "content_html": "“Missing doses every once in a while is not a problem.”",
     "correctness": "0.0"
    },
    {
     "id": 1310513,
     "content_html": "“There are no drug interactions to worry about with your tuberculosis medication.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A toxic effect of ethambutol is the loss of ability to distinguish between the colors red and green, warranting a change in drug therapy."
    }
   ],
   "community_solutions": []
  }
