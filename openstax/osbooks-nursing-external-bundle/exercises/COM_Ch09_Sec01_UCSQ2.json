 "questions": [
  {
   "id": 447090,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One aspect of health care access is clients’ ability to attend scheduled appointments. Which of the following factors is most likely to facilitate clients’ ability to access health care?",
   "answers": [
    {
     "id": 936632,
     "content_html": "Having a chronic disease",
     "correctness": "0.0"
    },
    {
     "id": 936633,
     "content_html": "Having adequate insurance coverage",
     "correctness": "1.0"
    },
    {
     "id": 936634,
     "content_html": "Having strong social support",
     "correctness": "0.0"
    },
    {
     "id": 936635,
     "content_html": "Having the ability to take time off work for appointments",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "All of these choices could potentially affect someone’s ability to access health care, but having adequate insurance coverage is most likely to facilitate clients’ access to health care."
    }
   ],
   "community_solutions": []
  }
 ],
