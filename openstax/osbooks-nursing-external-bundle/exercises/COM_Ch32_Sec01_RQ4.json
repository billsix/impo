 "questions": [
  {
   "id": 647616,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using the six steps of disaster risk assessment to determine a community’s hazard risk, which question would the nurse ask during step 3, vulnerability assessment?",
   "answers": [
    {
     "id": 1276151,
     "content_html": "Is the hazard risk high, moderate, or low?",
     "correctness": "0.0"
    },
    {
     "id": 1276150,
     "content_html": "Is the risk of disaster seasonal?",
     "correctness": "0.0"
    },
    {
     "id": 1276152,
     "content_html": "What are the estimated damages that would occur with the hazard?",
     "correctness": "1.0"
    },
    {
     "id": 1276149,
     "content_html": "What road might be impacted during the hazard?",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "During step 3, vulnerability assessment, the nurse determines the probability that the community will be negatively affected by a hazard. This includes an estimation of damages and the community’s capacity to reverse or combat those damages."
    }
   ],
