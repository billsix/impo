   "id": 647363,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community health nurse is working at a community event to help individuals obtain health insurance. For which individual would the nurse most likely recommend Medicare?",
   "answers": [
    {
     "id": 1275139,
     "content_html": "A 62-year-old client with heart failure",
     "correctness": "0.0"
    },
    {
     "id": 1275138,
     "content_html": "A 54-year-old client who is employed",
     "correctness": "0.0"
    },
    {
     "id": 1275137,
     "content_html": "A 28-year-old client with two children and no income",
     "correctness": "0.0"
    },
    {
     "id": 1275140,
     "content_html": "A healthy retired 67-year-old client",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Medicare is a government health insurance program that covers Americans 65 years of age and older, regardless of their health. It may also cover some individuals with disabilities, end-stage renal disease, and amyotrophic lateral sclerosis."
    }
   ],
