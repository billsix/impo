 "questions": [
  {
   "id": 647409,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action will the public health nurse perform when conducting an ethical community study?",
   "answers": [
    {
     "id": 1275323,
     "content_html": "Require each participant who provides informed consent to complete the study.",
     "correctness": "0.0"
    },
    {
     "id": 1275322,
     "content_html": "Obtain informed consent only from vulnerable populations.",
     "correctness": "0.0"
    },
    {
     "id": 1275321,
     "content_html": "Get informed consent only if the risks of participating in the study are high.",
     "correctness": "0.0"
    },
    {
     "id": 1275324,
     "content_html": "Obtain informed consent from each participant in the study.",
     "correctness": "1.0"
    }
   ],
