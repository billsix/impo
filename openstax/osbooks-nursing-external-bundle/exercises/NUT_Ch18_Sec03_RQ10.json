 "questions": [
  {
   "id": 660252,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge education to a client who has been prescribed amoxicillin. Which food should the nurse instruct the client to incorporate into their diet to help prevent medication-related nutrient depletion?",
   "answers": [
    {
     "id": 1310123,
     "content_html": "Beans",
     "correctness": "0.0"
    },
    {
     "id": 1310122,
     "content_html": "Whole grains",
     "correctness": "0.0"
    },
    {
     "id": 1310121,
     "content_html": "Sunflower seeds",
     "correctness": "0.0"
    },
    {
     "id": 1310124,
     "content_html": "Kale",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Kale can help prevent vitamin K deficiency. Amoxicillin is known to deplete vitamin K and vitamin B<sub>12</sub>."
    }
   ],
   "community_solutions": []
  }
