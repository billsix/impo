    {
     "id": 1310340,
     "content_html": "Improves outcomes",
     "correctness": "1.0"
    },
    {
     "id": 1310339,
     "content_html": "Decreases the likelihood of the client refusing treatment",
     "correctness": "0.0"
    },
    {
     "id": 1310338,
     "content_html": "Removes harmful conditions",
     "correctness": "0.0"
    },
    {
     "id": 1310337,
     "content_html": "Decreases the chance of the client denying their illness",
     "correctness": "0.0"
    }
