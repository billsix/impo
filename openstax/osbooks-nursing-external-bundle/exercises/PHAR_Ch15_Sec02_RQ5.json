 "questions": [
  {
   "id": 660427,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is evaluating a client for treatment of their opioid use disorder. They have a history of intravenous use of agents such as oxycodone and heroin. Which medication is the prescriber most likely to order to deter intravenous abuse of the medication?",
   "answers": [
    {
     "id": 1310823,
     "content_html": "Methadone",
     "correctness": "0.0"
    },
    {
     "id": 1310822,
     "content_html": "Lorazepam",
     "correctness": "0.0"
    },
    {
     "id": 1310824,
     "content_html": "Buprenorphine-naloxone",
     "correctness": "1.0"
    },
    {
     "id": 1310821,
     "content_html": "Chlordiazepoxide",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The naloxone in this drug makes it so that if it is injected instead of being used orally, it will prevent the buprenorphine from causing as much euphoria as it would by itself."
    }
   ],
   "community_solutions": []
