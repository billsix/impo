 "questions": [
  {
   "id": 370843,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following nutritional strategies should be included in the client education for Meena's hypothyroidism management?",
   "answers": [
    {
     "id": 897630,
     "content_html": "Recommend a low-protein, high-carbohydrate diet.",
     "correctness": "0.0"
    },
    {
     "id": 897631,
     "content_html": "Encourage increased consumption of iodine-rich foods.",
     "correctness": "1.0"
    },
    {
     "id": 897632,
     "content_html": "Advise her to avoid goitrogenic foods, such as cruciferous vegetables.",
     "correctness": "0.0"
    },
    {
     "id": 897633,
     "content_html": "Promote a diet high in saturated fats and processed foods.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Although iodine deficiency is not the primary cause of the client’s hypothyroidism, ensuring adequate iodine intake can still be beneficial for thyroid health. Educating the client about incorporating iodine-rich foods, such as dairy products, and iodized salt into her diet can help support her thyroid function alongside her medical treatment for hypothyroidism. Seafood is another good source of iodine, but the client’s cultural background may limit the amount of seafood she consumes."
    }
   ],
   "community_solutions": []
  }
 ],
