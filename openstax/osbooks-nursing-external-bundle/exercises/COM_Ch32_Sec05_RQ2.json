 "questions": [
  {
   "id": 647614,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using the START triage system, which victim would the nurse triage as immediate or red during a disaster response?",
   "answers": [
    {
     "id": 1276143,
     "content_html": "A victim who is not breathing after two attempts to open the airway",
     "correctness": "0.0"
    },
    {
     "id": 1276142,
     "content_html": "A victim who has a broken arm and can obey commands",
     "correctness": "0.0"
    },
    {
     "id": 1276141,
     "content_html": "A victim who has multiple lacerations on extremities and chest",
     "correctness": "0.0"
    },
    {
     "id": 1276144,
     "content_html": "A victim who has a respiratory rate greater than 30 beats/minute with flail chest",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The START algorithm places this victim in the red category, in need of immediate care. The victim in the red category can be helped by immediate intervention and transport, requires medical attention within minutes for survival (up to 60 minutes), and has a compromised airway, breathing, or circulation. This client with tachypnea (rapid respiratory rate) and a flail chest has breathing difficulties that require immediate intervention."
    }
   ],
   "community_solutions": []
  }
