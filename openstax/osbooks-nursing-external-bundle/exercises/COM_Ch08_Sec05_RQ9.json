 "questions": [
  {
   "id": 647381,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why does the nurse assess the SDOH when caring for individuals and their families in the community?",
   "answers": [
    {
     "id": 1275212,
     "content_html": "The SDOH have a significant impact on the health, wellness, and quality of life of individuals and families",
     "correctness": "1.0"
    },
    {
     "id": 1275211,
     "content_html": "By assessing the SDOH, the nurse can standardize interventions based on where the individual and family reside",
     "correctness": "0.0"
    },
    {
     "id": 1275210,
     "content_html": "Because nursing is founded on the principle of social justice",
     "correctness": "0.0"
    },
    {
     "id": 1275209,
     "content_html": "The nurse wants to investigate the reasons why certain individuals and families have asthma",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The SDOH affect the health and wellness of individuals and contribute to many risk factors for disease and premature death. There is a large inequity in the distribution of disease in this country, and the way to address these disparities is by being equitable and not just focusing on equality."
    }
   ],
   "community_solutions": []
  }
 ],
