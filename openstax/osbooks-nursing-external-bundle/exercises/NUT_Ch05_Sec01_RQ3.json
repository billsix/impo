   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client who is in the early stage of Alzheimer’s disease. The client and family inquire about meal choices. Which food choice would be most appropriate for the nurse to discuss with the client?",
   "answers": [
    {
     "id": 1309572,
     "content_html": "Colored berries",
     "correctness": "1.0"
    },
    {
     "id": 1309571,
