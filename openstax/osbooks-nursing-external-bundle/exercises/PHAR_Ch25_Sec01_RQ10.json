 "questions": [
  {
   "id": 660527,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is caring for a client who has been prescribed tiotropium, an anticholinergic medication used to manage COPD. The nurse provides education to the client regarding the medication. Which of the following statements made by the client indicates an understanding of tiotropium?",
   "answers": [
    {
     "id": 1311223,
     "content_html": "“This medication will help reduce airway inflammation.”",
     "correctness": "0.0"
    },
    {
     "id": 1311222,
     "content_html": "“I should take this medication during an acute COPD exacerbation.”",
     "correctness": "0.0"
    },
    {
     "id": 1311224,
     "content_html": "“Tiotropium works by relaxing the muscles in my airways.”",
     "correctness": "1.0"
    },
    {
     "id": 1311221,
     "content_html": "“I can take an extra dose of tiotropium if I experience worsening symptoms.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Tiotropium is an anticholinergic medication that works by blocking the action of acetylcholine, a neurotransmitter that causes bronchoconstriction. By blocking acetylcholine, tiotropium helps to relax the smooth muscles in the airways, leading to bronchodilation and improved airflow."
    }
   ],
   "community_solutions": []
  }
 ],
