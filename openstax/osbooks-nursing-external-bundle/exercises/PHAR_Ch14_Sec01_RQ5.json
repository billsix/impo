 "questions": [
  {
   "id": 660415,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 75-year-old client reports intermittent pain that ranges from 4 to 10 on a 0–10 scale. The client states that the pain started 5 years ago after they had herpes zoster (shingles). The nurse understands that this pain is classified as which of the following types?",
   "answers": [
    {
     "id": 1310775,
     "content_html": "Nociceptive",
     "correctness": "0.0"
    },
    {
     "id": 1310776,
     "content_html": "Neuropathic",
     "correctness": "1.0"
    },
    {
     "id": 1310774,
     "content_html": "Acute",
     "correctness": "0.0"
    },
    {
     "id": 1310773,
     "content_html": "Visceral",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The affected nerves were damaged by the varicella-zoster virus. Shingles pain, or postherpetic neuralgia, develops in up to 50% of individuals over the age of 65 who contract the disease."
    }
   ],
   "community_solutions": []
  }
