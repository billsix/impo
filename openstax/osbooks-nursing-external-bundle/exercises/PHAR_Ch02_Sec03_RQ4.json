 "questions": [
  {
   "id": 660289,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client about self-administering a fentanyl transdermal patch. Which statement indicates an understanding of client teaching?",
   "answers": [
    {
     "id": 1310271,
     "content_html": "“I will cut the patch in half when my pain is not severe.”",
     "correctness": "0.0"
    },
    {
     "id": 1310270,
     "content_html": "“I will rotate the patch application site every 7 days.”",
     "correctness": "0.0"
    },
    {
     "id": 1310272,
     "content_html": "“I will remove the old patch before applying a new one.”",
     "correctness": "1.0"
    },
    {
     "id": 1310269,
     "content_html": "“I will cleanse the application site with alcohol before applying.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The old patch should be removed before applying a new one to avoid a drug overdose."
    }
   ],
   "community_solutions": []
  }
