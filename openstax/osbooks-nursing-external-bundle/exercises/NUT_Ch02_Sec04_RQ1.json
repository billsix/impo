    {
     "id": 1309475,
     "content_html": "Obtain water from a neighboring county.",
     "correctness": "0.0"
    },
    {
     "id": 1309474,
     "content_html": "Boil the water.",
     "correctness": "0.0"
    },
    {
     "id": 1309473,
     "content_html": "Buy a water softener.",
     "correctness": "0.0"
    },
    {
     "id": 1309476,
     "content_html": "Purchase bottled water.",
     "correctness": "1.0",
