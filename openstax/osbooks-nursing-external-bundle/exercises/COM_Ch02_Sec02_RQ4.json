   "id": 647316,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community health nurse is teaching nursing students about the development of the modern public health system. Which reform movement will the nurse note as foundational to the modern public health system?",
   "answers": [
    {
     "id": 1274951,
     "content_html": "Smoking tobacco indoors",
     "correctness": "0.0"
    },
    {
     "id": 1274952,
     "content_html": "Child labor and working conditions",
     "correctness": "1.0"
    },
    {
     "id": 1274950,
     "content_html": "Drinking water cleanliness",
     "correctness": "0.0"
    },
    {
     "id": 1274949,
     "content_html": "Opioid prescribing",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Reform movements concerning child labor, working conditions, and overcrowding of cities led to policies and regulations aiming to protect the health of the public. This period in U.S. history, and the efforts of workers to reform practices, are credited with establishing the modern public health system."
    }
   ],
