   "stimulus_html": "",
   "stem_html": "Which action would the nurse perform in the policy formulation phase of the stage-sequential model of policy development?",
   "answers": [
    {
     "id": 1276219,
     "content_html": "Carrying out a food inspection in a restaurant",
