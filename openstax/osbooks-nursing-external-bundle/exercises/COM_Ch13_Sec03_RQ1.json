   "id": 647423,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Public health surveillance can be described primarily as which of the following actions?",
   "answers": [
    {
     "id": 1275380,
     "content_html": "Monitoring occurrences of public health problems",
     "correctness": "1.0"
    },
    {
     "id": 1275379,
     "content_html": "Developing interventions to control disease outbreaks",
     "correctness": "0.0"
    },
    {
     "id": 1275378,
     "content_html": "Collecting health-related information from community members",
     "correctness": "0.0"
    },
    {
     "id": 1275377,
     "content_html": "Tracking individuals who have been exposed to an infectious disease",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Public health surveillance is a method that a community has available to monitor the health among its population by detecting problems, communicating alerts as needed, guiding the appropriate response, and evaluating the effect of the response."
    }
   ],
