 "questions": [
  {
   "id": 660563,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with inflammation of the biliary duct. The nurse anticipates that the client will need to limit dietary intake of which nutrient?",
   "answers": [
    {
     "id": 1311368,
     "content_html": "Fats",
     "correctness": "1.0"
    },
    {
     "id": 1311367,
     "content_html": "Proteins",
     "correctness": "0.0"
    },
    {
     "id": 1311366,
     "content_html": "Carbohydrates",
     "correctness": "0.0"
    },
    {
     "id": 1311365,
     "content_html": "Fiber",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Bile, secreted by the liver, aids in digestion by breaking down fats into fatty acids; therefore, the client may need to limit intake of dietary fat."
    }
   ],
   "community_solutions": []
  }
