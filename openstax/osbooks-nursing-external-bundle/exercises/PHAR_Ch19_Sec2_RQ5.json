 "questions": [
  {
   "id": 660467,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client is taking valsartan, carvedilol, and spironolactone daily. What monitoring should the nurse educate the client about to ensure safe medication administration?",
   "answers": [
    {
     "id": 1310984,
     "content_html": "Electrolytes, because two of the medications cause an elevation in potassium",
     "correctness": "1.0"
    },
    {
     "id": 1310983,
     "content_html": "Electrolytes, because two of the medications cause a decrease in potassium",
     "correctness": "0.0"
    },
    {
     "id": 1310982,
     "content_html": "Glucose, because the combination of medications can lower blood glucose",
     "correctness": "0.0"
    },
    {
     "id": 1310981,
     "content_html": "Uric acid, because the combination of medications can increase uric acid",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Valsartan and spironolactone can cause potassium to be reabsorbed in the nephron. Clients are at risk for hyperkalemia."
    }
   ],
   "community_solutions": []
  }
 ],
