  {
   "id": 660507,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 60-year-old client with a 35-year history of smoking two packs of cigarettes a day reports a chronic cough and thick sputum. Based on these assessment findings, the nurse suspects the client has which condition?",
   "answers": [
    {
     "id": 1311143,
     "content_html": "Emphysema",
     "correctness": "0.0"
    },
    {
     "id": 1311142,
     "content_html": "Asthma",
     "correctness": "0.0"
    },
    {
     "id": 1311141,
     "content_html": "Sinusitis",
     "correctness": "0.0"
    },
    {
     "id": 1311144,
     "content_html": "Chronic bronchitis",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Chronic bronchitis is characterized by chronic cough and sputum production. The most common cause is smoking."
    }
   ],
   "community_solutions": []
  }
