  {
   "id": 366645,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The health care provider orders aspirin for James. Which action should the nurse take?",
   "answers": [
    {
     "id": 888873,
     "content_html": "Tell James not to chew the aspirin.",
     "correctness": "0.0"
    },
    {
     "id": 888874,
     "content_html": "Tell James that aspirin will relieve his pain.",
     "correctness": "0.0"
    },
    {
     "id": 888875,
     "content_html": "Ask James if he has a history of asthma.",
     "correctness": "1.0"
    },
    {
     "id": 888876,
     "content_html": "Teach James that aspirin causes vasodilation.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A history of asthma is a contraindication to taking aspirin."
    }
