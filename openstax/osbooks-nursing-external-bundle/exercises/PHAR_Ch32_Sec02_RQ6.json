 "questions": [
  {
   "id": 660598,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "While counseling a client on different anorexiants, the nurse advises them that office visits may be required every 14 days to assess progress and evaluate the effectiveness of the weight-loss medication. The nurse is referring to which medication?",
   "answers": [
    {
     "id": 1311507,
     "content_html": "Phentermine",
     "correctness": "0.0"
    },
    {
     "id": 1311506,
     "content_html": "Phendimetrazine",
     "correctness": "0.0"
    },
    {
     "id": 1311508,
     "content_html": "Phentermine/topiramate",
     "correctness": "1.0"
    },
    {
     "id": 1311505,
     "content_html": "Benzphetamine",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The dosage of phentermine/topiramate is usually readjusted every 14 days based on effectiveness."
    }
   ],
   "community_solutions": []
  }
