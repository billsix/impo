   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Ibuprofen is the generic name for Motrin; Motrin is the brand or trade name for ibuprofen. The chemical name for ibuprofen is 2-(4-isobutylphenyl) propanoic acid."
    }
