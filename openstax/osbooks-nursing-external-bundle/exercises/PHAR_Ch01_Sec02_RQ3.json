   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client receives a prescription for ibuprofen and wants to know if they can take Motrin instead. Which response should the nurse give the client?",
   "answers": [
    {
     "id": 1310215,
     "content_html": "“Yes, Motrin is the chemical name for ibuprofen.”",
     "correctness": "0.0"
    },
    {
     "id": 1310216,
     "content_html": "“Yes, Motrin is the trade name for ibuprofen.”",
     "correctness": "1.0"
    },
    {
     "id": 1310214,
     "content_html": "“Yes, ibuprofen is the brand name for Motrin.”",
     "correctness": "0.0"
    },
    {
     "id": 1310213,
     "content_html": "“Yes, ibuprofen is the chemical name for Motrin.”",
     "correctness": "0.0"
