   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What instruction should the nurse give to a client on a fluid restriction secondary to kidney disease who reports increased thirst?",
   "answers": [
    {
     "id": 1309995,
     "content_html": "Suck on hard, sweet candies.",
     "correctness": "0.0"
    },
    {
     "id": 1309994,
     "content_html": "Use large glasses for drinking.",
     "correctness": "0.0"
    },
    {
     "id": 1309993,
     "content_html": "Fill drinking glasses completely.",
     "correctness": "0.0"
    },
    {
     "id": 1309996,
     "content_html": "Sip fluids slowly.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "They should sip fluids slowly and savor them and not gulp them down quickly."
    }
