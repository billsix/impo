 "questions": [
  {
   "id": 367670,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse asks Sarah about her protein intake. Sarah reports that she has been regularly craving and eating cheeseburgers. Why should the nurse be concerned about this finding?",
   "answers": [
    {
     "id": 891892,
     "content_html": "Sarah is not choosing lean protein sources.",
     "correctness": "1.0"
    },
    {
     "id": 891893,
     "content_html": "Sarah is eating too much cheese.",
     "correctness": "0.0"
    },
    {
     "id": 891894,
     "content_html": "Eating a lot of red meat can indicate anemia.",
     "correctness": "0.0"
    },
    {
     "id": 891895,
     "content_html": "This is not a concerning finding as long as Sarah is consuming adequate amounts of food.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A healthy diet includes protein from lean sources such as chicken or seafood. Cheeseburgers are high in saturated fat, which can worsen insulin resistance."
    }
   ],
   "community_solutions": []
  }
