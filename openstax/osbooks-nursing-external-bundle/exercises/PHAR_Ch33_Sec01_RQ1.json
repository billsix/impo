   "id": 660603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following laboratory tests is typically used as an estimate of the glomerular filtration rate?",
   "answers": [
    {
     "id": 1311527,
     "content_html": "Hematocrit",
     "correctness": "0.0"
    },
    {
     "id": 1311526,
     "content_html": "BUN",
     "correctness": "0.0"
    },
    {
     "id": 1311528,
     "content_html": "Creatinine",
     "correctness": "1.0"
    },
    {
     "id": 1311525,
     "content_html": "Sodium",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
