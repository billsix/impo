   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The creatinine level is viewed as a reasonable assessment of the GFR. Measurement of the actual GFR requires either an insulin infusion or radioisotope exposure."
    }
