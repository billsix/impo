 "questions": [
  {
   "id": 647587,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which concept should the nurse use when providing care for individuals who are incarcerated?",
   "answers": [
    {
     "id": 1276035,
     "content_html": "Education levels of the incarcerated population are the same as the general population.",
     "correctness": "0.0"
    },
    {
     "id": 1276036,
     "content_html": "There is a lack of privacy when caring for incarcerated people.",
     "correctness": "1.0"
    },
    {
     "id": 1276034,
     "content_html": "Therapeutic nurse-client relationships are not utilized in correctional nursing.",
     "correctness": "0.0"
    },
    {
     "id": 1276033,
     "content_html": "Most incarcerated people are middle-age or older adults.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "There is a lack of privacy when caring for incarcerated individuals since corrections officers oversee all aspects of the health care delivery system within correctional centers. Balancing the conflicting roles of public safety and security by the corrections department and the professional nursing mission to promote the well-being of all clients is at the heart of corrections nursing."
    }
   ],
   "community_solutions": []
  }
