   "stimulus_html": "",
   "stem_html": "The nurse receives orders to administer nitroglycerin sublingually. Which parameter will the nurse monitor to determine the effectiveness of nitroglycerin?",
   "answers": [
    {
     "id": 888869,
     "content_html": "Chest pain",
     "correctness": "1.0"
    },
    {
     "id": 888870,
     "content_html": "Heart rate",
     "correctness": "0.0"
    },
    {
