   "id": 371216,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on Harold’s past medical history of chronic obstructive pulmonary disease (COPD) and the physical examination, which of the following medications would be the highest priority to administer to him?",
   "answers": [
    {
     "id": 897968,
     "content_html": "Salmeterol",
     "correctness": "1.0"
    },
    {
     "id": 897969,
     "content_html": "Ipratropium bromide",
     "correctness": "0.0"
    },
    {
     "id": 897970,
     "content_html": "Tiotropium",
     "correctness": "0.0"
    },
    {
     "id": 897971,
     "content_html": "Ephedrine",
     "correctness": "0.0"
    }
   ],
   "hints": [],
