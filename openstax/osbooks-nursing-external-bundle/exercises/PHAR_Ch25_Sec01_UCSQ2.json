   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Beta-adrenergic agonists, such as salmeterol, are often used as part of long-term management for COPD. They provide bronchodilation and help improve airflow by relaxing the airway smooth muscles."
    }
