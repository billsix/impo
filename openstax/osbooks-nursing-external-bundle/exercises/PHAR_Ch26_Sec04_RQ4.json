 "questions": [
  {
   "id": 660538,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with adrenal insufficiency is prescribed hydrocortisone. Which action should the nurse take to detect potential adverse effects of this drug?",
   "answers": [
    {
     "id": 1311267,
     "content_html": "Monitor for hypoglycemia and hypertension",
     "correctness": "0.0"
    },
    {
     "id": 1311268,
     "content_html": "Assess for hyperglycemia and hypertension",
     "correctness": "1.0"
    },
    {
     "id": 1311266,
     "content_html": "Check for hypoglycemia and weight loss",
     "correctness": "0.0"
    },
    {
     "id": 1311265,
     "content_html": "Assess for weight loss and hypertension",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Hydrocortisone is a steroid drug that can cause hyperglycemia and increase blood pressure. Monitoring for these potential adverse effects is essential to ensure client safety."
    }
   ],
