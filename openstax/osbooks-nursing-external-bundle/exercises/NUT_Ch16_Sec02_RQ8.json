   "stimulus_html": "",
   "stem_html": "The nurse is working at a community health fair, providing information about risk reduction for renal cancer. Which nutritional instruction will the nurse teach to reduce the risk for renal cancer?",
   "answers": [
    {
     "id": 1310036,
     "content_html": "Increase intake of cruciferous vegetables.",
     "correctness": "1.0"
    },
    {
     "id": 1310035,
     "content_html": "Increase intake of red meat.",
     "correctness": "0.0"
    },
    {
     "id": 1310034,
     "content_html": "Eat more pan-fried foods.",
     "correctness": "0.0"
    },
    {
     "id": 1310033,
     "content_html": "Cook meats on the grill.",
     "correctness": "0.0"
    }
