 "questions": [
  {
   "id": 660622,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge teaching for a client who was started on a thiazide diuretic during this hospitalization. Which statement indicates that additional instruction is required?",
   "answers": [
    {
     "id": 1311604,
     "content_html": "“I’m concerned about getting up to go to the bathroom all night every night.”",
     "correctness": "1.0"
    },
    {
     "id": 1311603,
     "content_html": "“I will let the doctor know if I develop leg cramps.”",
     "correctness": "0.0"
    },
    {
     "id": 1311602,
     "content_html": "“I need to read food labels to check for salt.”",
     "correctness": "0.0"
    },
    {
     "id": 1311601,
     "content_html": "“I need to eat some potassium every day for a month or so.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse should instruct the client to take diuretics in the morning to help prevent nocturia."
    }
   ],
   "community_solutions": []
  }
