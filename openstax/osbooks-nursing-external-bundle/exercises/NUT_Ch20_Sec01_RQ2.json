   "stimulus_html": "",
   "stem_html": "The nurse is reviewing a client’s chart and notes their current medications. Which classification of medication increases the client’s risk for fracture?",
   "answers": [
    {
     "id": 1310171,
     "content_html": "Antibiotics",
     "correctness": "0.0"
    },
    {
     "id": 1310170,
     "content_html": "Antidepressants",
     "correctness": "0.0"
    },
    {
     "id": 1310169,
     "content_html": "NSAIDs",
     "correctness": "0.0"
    },
    {
     "id": 1310172,
     "content_html": "Corticosteroids",
     "correctness": "1.0"
    }
   ],
   "hints": [],
