 "questions": [
  {
   "id": 647635,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which assessment finding will the nurse anticipate in a family in the cycle of poverty?",
   "answers": [
    {
     "id": 1276227,
     "content_html": "The family has created the conditions that keep them impoverished.",
     "correctness": "0.0"
    },
    {
     "id": 1276228,
     "content_html": "Members of the family have a low level of education.",
     "correctness": "1.0"
    },
    {
     "id": 1276226,
     "content_html": "Poverty is created by the family’s laziness.",
     "correctness": "0.0"
    },
    {
     "id": 1276225,
     "content_html": "The family has social connections and support systems.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The cycle of poverty is a series of events that occur between generations. The main idea is that once a person or family becomes impoverished, it is almost impossible to change their economic status, and an external intervention is needed to break the cycle. One characteristic of a family in the cycle of poverty is the low level of education among the family members."
    }
   ],
   "community_solutions": []
  }
