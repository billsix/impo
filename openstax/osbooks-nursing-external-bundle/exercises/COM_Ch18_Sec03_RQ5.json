   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "SMART goals are specific, measurable, attainable, realistic, and time-bound. The program objective of “Reported alcohol use by county youth will decrease from five percent to four percent by December 31, 2025” meets all of these requirements."
    }
