   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an example of a program objective written using the SMART approach?",
   "answers": [
    {
     "id": 1275595,
     "content_html": "Colon cancer screening will increase in the community.",
     "correctness": "0.0"
    },
    {
     "id": 1275596,
     "content_html": "Reported alcohol use by county youth will decrease from five percent to four percent by December 31, 2025.",
     "correctness": "1.0"
    },
    {
     "id": 1275594,
     "content_html": "By next year, more county residents will meet physical activity recommendations.",
     "correctness": "0.0"
    },
    {
     "id": 1275593,
     "content_html": "County adult obesity rates will decrease from 60 percent to 30 percent within the next 2 months.",
     "correctness": "0.0"
    }
   ],
