 "questions": [
  {
   "id": 660605,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge teaching for an adult client who has experienced recurrent renal calculi. Which of these instructions is appropriate for this client?",
   "answers": [
    {
     "id": 1311535,
     "content_html": "Increase calcium intake.",
     "correctness": "0.0"
    },
    {
     "id": 1311534,
     "content_html": "Avoid consuming dark-colored fluids.",
     "correctness": "0.0"
    },
    {
     "id": 1311536,
     "content_html": "Increase fluid intake to approximately 2–3 liters each day.",
     "correctness": "1.0"
    },
    {
     "id": 1311533,
     "content_html": "Increase protein intake from poultry and fish.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Increasing fluid intake decreases urine concentration, which in turn decreases the concentration of minerals in the urine that contribute to stone formation."
    }
   ],
   "community_solutions": []
  }
 ],
