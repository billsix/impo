 "questions": [
  {
   "id": 660231,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is developing a teaching plan for a client who has just entered stage 4 CKD. Which instruction will the nurse give the client?",
   "answers": [
    {
     "id": 1310039,
     "content_html": "There are no restrictions on fluid intake.",
     "correctness": "0.0"
    },
    {
     "id": 1310038,
     "content_html": "Reduce calcium intake.",
     "correctness": "0.0"
    },
    {
     "id": 1310040,
     "content_html": "Restrict potassium intake.",
     "correctness": "1.0"
    },
    {
     "id": 1310037,
     "content_html": "Increase magnesium intake.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client with stage 4 CKD should restrict intake of potassium as well as that of magnesium, phosphorus, and sodium."
    }
   ],
   "community_solutions": []
  }
