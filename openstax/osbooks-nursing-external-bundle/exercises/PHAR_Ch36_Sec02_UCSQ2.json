 "questions": [
  {
   "id": 366985,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After discussing all the options for contraception with Susan and considering that Susan does not want children, which method do Susan and the nurse think may be the best for her?",
   "answers": [
    {
     "id": 890001,
     "content_html": "Oral, daily combination hormone pill",
     "correctness": "0.0"
    },
    {
     "id": 890002,
     "content_html": "Depo-Provera injection once every 3 months",
     "correctness": "0.0"
    },
    {
     "id": 890003,
     "content_html": "Hormonal IUD",
     "correctness": "0.0"
    },
    {
     "id": 890004,
     "content_html": "Copper IUD",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The copper IUD is the longest-lasting contraceptive device and does not contain hormones. Because Susan is slightly overweight, has a smoking history, and has migraine headaches, any hormonal contraceptive may cause serious side effects."
    }
   ],
   "community_solutions": []
  }
