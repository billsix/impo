 "questions": [
  {
   "id": 647562,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The public health nurse is providing education to families of older adults in the community about risk factors for elder abuse. Which factor would the nurse include in this teaching?",
   "answers": [
    {
     "id": 1275935,
     "content_html": "The older adult’s level of physical activity",
     "correctness": "0.0"
    },
    {
     "id": 1275934,
     "content_html": "The frequency of visits from family and friends",
     "correctness": "0.0"
    },
    {
     "id": 1275933,
     "content_html": "The presence of chronic health conditions in the older adult",
     "correctness": "0.0"
    },
    {
     "id": 1275936,
     "content_html": "The presence of mental illness in the older adult",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Elder abuse is an intentional act or failure to act that causes or creates a risk of harm to an older adult. Older adults with mental illness are at increased risk for elder abuse due to their diminished capacity to recognize and report mistreatment, understand their rights, or protect themselves from harm."
    }
   ],
   "community_solutions": []
  }
 ],
