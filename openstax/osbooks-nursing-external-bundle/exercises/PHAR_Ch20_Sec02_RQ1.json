 "questions": [
  {
   "id": 660474,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse admits a client with an acute pulmonary embolism and is instructed to start heparin. Which of the following tests can the nurse best use to adjust the dose of heparin?",
   "answers": [
    {
     "id": 1311012,
     "content_html": "Partial thromboplastin time (PTT)",
     "correctness": "1.0"
    },
    {
     "id": 1311011,
     "content_html": "International normalized ratio (INR)",
     "correctness": "0.0"
    },
    {
     "id": 1311010,
     "content_html": "Complete blood count (CBC)",
     "correctness": "0.0"
    },
    {
     "id": 1311009,
     "content_html": "Prothrombin time (PT)",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Heparin can be monitored by using the partial thromboplastin time or anti-factor Xa level, depending on the institutional protocol."
    }
   ],
   "community_solutions": []
  }
