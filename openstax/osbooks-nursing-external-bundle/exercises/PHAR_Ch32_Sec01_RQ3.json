 "questions": [
  {
   "id": 660595,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is providing education to a group of adults about the differences between overweight and obesity. Which statement by one of the participants demonstrates an accurate understanding of these terms?",
   "answers": [
    {
     "id": 1311495,
     "content_html": "“Overweight and obesity are essentially the same, just different terms for having excess body fat.”",
     "correctness": "0.0"
    },
    {
     "id": 1311496,
     "content_html": "“Overweight refers to having a BMI between 25 and 29.9, whereas obesity is defined as a BMI of 30 or higher.”",
     "correctness": "1.0"
    },
    {
     "id": 1311494,
     "content_html": "“Obesity is a medical condition, whereas overweight is merely a cosmetic concern.”",
     "correctness": "0.0"
    },
    {
     "id": 1311493,
     "content_html": "“Being overweight is a more severe health condition than obesity due to the increased risk of cardiovascular diseases.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Obesity and overweight are not the same; the distinguishing factor is a person’s client’s BMI. Overweight, with a BMI of 25–29, may lead to obesity. Obesity has a higher BMI (<span data-math=\"\\geq\"></span>30) and is associated with serious consequences."
    }
   ],
   "community_solutions": []
  }
 ],
