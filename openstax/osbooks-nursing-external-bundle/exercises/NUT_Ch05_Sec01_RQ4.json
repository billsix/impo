    {
     "id": 1309576,
     "content_html": "Nuts, seeds, and salmon",
     "correctness": "1.0"
    },
    {
     "id": 1309575,
     "content_html": "Cheese, milk, and margarine",
     "correctness": "0.0"
    },
    {
     "id": 1309574,
     "content_html": "Lean red meats, potatoes, and white bread",
     "correctness": "0.0"
    },
    {
     "id": 1309573,
     "content_html": "Eggs, lamb, and zero-calorie beverages",
     "correctness": "0.0"
    }
