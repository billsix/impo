 "questions": [
  {
   "id": 367375,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When evaluating ways to help improve Jamal’s nutritional intake based on the information obtained, what is the best suggestion to cost-effectively improve the nutritional plan?",
   "answers": [
    {
     "id": 890898,
     "content_html": "Buy more fresh fruits and vegetables.",
     "correctness": "0.0"
    },
    {
     "id": 890899,
     "content_html": "Use an air fryer to cook foods without breading.",
     "correctness": "1.0"
    },
    {
     "id": 890900,
     "content_html": "Eat more microwaved meals to make meal preparation easier.",
     "correctness": "0.0"
    },
    {
     "id": 890901,
     "content_html": "Increase the number of daily servings of fruit juice.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because of rising food costs, it may be helpful to use an air fryer to avoid deep-frying foods while maintaining the client’s current food preferences, such as fried foods, and increasing adherence to the meal plan."
    }
   ],
   "community_solutions": []
  }
