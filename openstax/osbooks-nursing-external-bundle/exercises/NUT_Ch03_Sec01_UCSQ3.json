   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How could Curtis “Make Every Bite” count?",
   "answers": [
    {
     "id": 887849,
     "content_html": "Increase consumption of toaster pastries since they are vitamin B fortified.",
     "correctness": "0.0"
    },
    {
     "id": 887850,
     "content_html": "Add another powdered cheese packet to his macaroni and cheese.",
     "correctness": "0.0"
    },
    {
     "id": 887851,
     "content_html": "Provide a vitamin gummy daily.",
     "correctness": "0.0"
    },
    {
     "id": 887852,
     "content_html": "Experiment with fruit and vegetable smoothies for an after school snack.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
