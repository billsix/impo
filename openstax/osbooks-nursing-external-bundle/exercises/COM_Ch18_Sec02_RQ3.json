 "questions": [
  {
   "id": 647475,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which question might the nurse answer to determine if the ethical standard of proportionality will be upheld during a community health program?",
   "answers": [
    {
     "id": 1275587,
     "content_html": "Do the program benefits outweigh the potential risks?",
     "correctness": "0.0"
    },
    {
     "id": 1275586,
     "content_html": "Do the program planners provide rationale for program choices?",
     "correctness": "0.0"
    },
    {
     "id": 1275588,
     "content_html": "Does the program decrease health inequities identified in the community?",
     "correctness": "1.0"
    },
    {
     "id": 1275585,
     "content_html": "Has the target population been involved in the program planning process?",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Proportionality states the program or action is equitable and fair. It also refers to decreasing inequities that already exist so that health outcomes are more proportional."
    }
   ],
   "community_solutions": []
  }
