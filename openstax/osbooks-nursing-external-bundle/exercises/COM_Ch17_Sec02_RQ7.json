 "questions": [
  {
   "id": 647469,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is developing a teaching plan for a client newly diagnosed with diabetes. Which action by the nurse focuses on the psychomotor domain of learning?",
   "answers": [
    {
     "id": 1275563,
     "content_html": "Providing reinforcement for efforts toward self-care",
     "correctness": "0.0"
    },
    {
     "id": 1275562,
     "content_html": "Teaching about the relationship between insulin and blood glucose levels",
     "correctness": "0.0"
    },
    {
     "id": 1275564,
     "content_html": "Instructing the client on self-administration of insulin",
     "correctness": "1.0"
    },
    {
     "id": 1275561,
     "content_html": "Discussing the symptoms of hypoglycemia and hyperglycemia",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The psychomotor domain is the performance of skills that require neuromuscular coordination. An example is self-administration of insulin."
    }
   ],
   "community_solutions": []
  }
