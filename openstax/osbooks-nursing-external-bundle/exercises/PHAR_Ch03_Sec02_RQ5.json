 "questions": [
  {
   "id": 660307,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is completing their eighth 12-hour shift in a row. Which item from the ANA Code of Ethics is the nurse at risk of violating?",
   "answers": [
    {
     "id": 1310343,
     "content_html": "The nurse should practice with compassion and respect for the inherent dignity, worth, and unique attributes of the clients.",
     "correctness": "0.0"
    },
    {
     "id": 1310344,
     "content_html": "The nurse owes the same duty to self as to others, including the responsibility to promote health and safety.",
     "correctness": "1.0"
    },
    {
     "id": 1310342,
     "content_html": "The nurse’s primary commitment is to the client, whether an individual, family, group, community, or population.",
     "correctness": "0.0"
    },
    {
     "id": 1310341,
     "content_html": "The nurse collaborates with other health care professionals to protect human rights, promote health diplomacy, and reduce health disparities.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse should own the duty of caring for self. This, in turn, will improve client safety when allowing oneself the self-care of time off."
    }
   ],
   "community_solutions": []
  }
