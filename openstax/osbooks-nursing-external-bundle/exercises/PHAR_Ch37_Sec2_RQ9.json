 "questions": [
  {
   "id": 660648,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An 18-year-old male comes to a transgender clinic. The client says they feel like a woman and have thought about transitioning gender but are still uncertain. The nurse expects which hormone would be the most appropriate for this client?",
   "answers": [
    {
     "id": 1311707,
     "content_html": "Estrogen",
     "correctness": "0.0"
    },
    {
     "id": 1311706,
     "content_html": "Prolactin",
     "correctness": "0.0"
    },
    {
     "id": 1311705,
     "content_html": "Testosterone",
     "correctness": "0.0"
    },
    {
     "id": 1311708,
     "content_html": "Spironolactone",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Spironolactone is an androgen blocker but does not block testosterone. Because the client is unsure about whether to transition, spironolactone is an appropriate choice because changes in sexual characteristics with spironolactone are reversible."
    }
   ],
   "community_solutions": []
  }
 ],
