   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action should the nurse take to evaluate the effectiveness of carbamide peroxide administered to a client’s ear?\n",
   "answers": [
    {
     "id": 1311803,
     "content_html": "Take the client’s temperature.",
     "correctness": "0.0"
    },
    {
     "id": 1311804,
     "content_html": "Examine the ear canal.",
     "correctness": "1.0"
    },
    {
     "id": 1311802,
     "content_html": "Check the client’s hearing.",
     "correctness": "0.0"
    },
    {
     "id": 1311801,
     "content_html": "Ask the client to rate their pain.",
     "correctness": "0.0"
    }
   ],
