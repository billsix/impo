   "id": 660587,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is administering IV cimetidine to a client admitted to the ICU with a GI bleed. Which of the following adverse effects is the client at increased risk for when receiving cimetidine parenterally?",
   "answers": [
    {
     "id": 1311463,
     "content_html": "Gynecomastia",
     "correctness": "0.0"
    },
    {
     "id": 1311462,
     "content_html": "Confusion",
     "correctness": "0.0"
    },
    {
     "id": 1311461,
     "content_html": "Agranulocytosis",
     "correctness": "0.0"
    },
    {
     "id": 1311464,
     "content_html": "Hypotension",
     "correctness": "1.0"
    }
   ],
