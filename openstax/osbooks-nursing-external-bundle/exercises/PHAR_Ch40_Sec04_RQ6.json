   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nursing student asks the nurse how impetigo treatment works. The nurse explains that the primary goal in the treatment of impetigo is to:",
   "answers": [
    {
     "id": 1311835,
     "content_html": "Reduce swelling and scaling",
     "correctness": "0.0"
    },
    {
     "id": 1311834,
     "content_html": "Decrease scarring as the lesion heals",
     "correctness": "0.0"
    },
    {
     "id": 1311833,
     "content_html": "Soften the tissues to reduce pain",
     "correctness": "0.0"
    },
    {
     "id": 1311836,
     "content_html": "Eliminate the causative bacteria",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Impetigo is a localized infection that requires treatment with antibiotics to eliminate the causative bacteria."
    }
   ],
