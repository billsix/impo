 "questions": [
  {
   "id": 660207,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge teaching for a client with respiratory alterations. Which of the following statements regarding the effects of nutrition on the immune system and lung health should be included in the plan?",
   "answers": [
    {
     "id": 1309943,
     "content_html": "Good nutrition is important, although it does not prevent acute respiratory tract infections.",
     "correctness": "0.0"
    },
    {
     "id": 1309942,
     "content_html": "Nutrition only affects lung tissue repair, not the immune system.",
     "correctness": "0.0"
    },
    {
     "id": 1309941,
     "content_html": "Improper nutritional intake alters the immune system but does not impact lung health.",
     "correctness": "0.0"
    },
    {
     "id": 1309944,
     "content_html": "Nutrition plays a role in supporting the immune system to prevent and treat infection and repair lung tissue.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Nutrition plays a role in supporting the immune system, which prevents and treats infections while also repairing lung tissue."
    }
   ],
