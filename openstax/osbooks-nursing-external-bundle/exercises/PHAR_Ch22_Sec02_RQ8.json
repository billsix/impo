   "stimulus_html": "",
   "stem_html": "Which adverse effect should the nurse monitor for in the client receiving dopamine by peripheral IV infusion?",
   "answers": [
    {
     "id": 1311115,
     "content_html": "Dizziness",
     "correctness": "0.0"
    },
    {
     "id": 1311116,
     "content_html": "Skin sloughing at the IV site",
     "correctness": "1.0"
    },
    {
     "id": 1311114,
     "content_html": "Electrolyte abnormalities",
     "correctness": "0.0"
    },
    {
