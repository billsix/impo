 "questions": [
  {
   "id": 647556,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action should the nurse take to promote family engagement during a community class on healthy toddler nutrition?",
   "answers": [
    {
     "id": 1275911,
     "content_html": "Provide standardized healthy food guidelines to all families",
     "correctness": "0.0"
    },
    {
     "id": 1275912,
     "content_html": "Learn about each family’s cultural practices and beliefs related to food and health",
     "correctness": "1.0"
    },
    {
     "id": 1275910,
     "content_html": "Implement interventions related to food choices based on the nurse’s personal beliefs",
     "correctness": "0.0"
    },
    {
     "id": 1275909,
     "content_html": "Encourage the family to only provide the healthy food options suggested",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Effective family engagement involves actively involving the family in the planning and implementation of health promotion interventions. By collaborating with each family, the nurse can gain a deeper understanding of their cultural practices, values, and beliefs related to health. This understanding enables the nurse to tailor interventions that are respectful, culturally appropriate, and aligned with the family’s preferences, leading to better engagement and improved health outcomes."
    }
   ],
   "community_solutions": []
  }
 ],
