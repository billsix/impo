 "questions": [
  {
   "id": 660665,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which communication technique is most effective for the nurse to use when communicating with a client with hearing impairment?",
   "answers": [
    {
     "id": 1311775,
     "content_html": "Look directly at the client and use a loud voice.",
     "correctness": "0.0"
    },
    {
     "id": 1311774,
     "content_html": "Move on to the next topic if the client does not understand you.",
     "correctness": "0.0"
    },
    {
     "id": 1311773,
     "content_html": "Instruct the client to read your lips.",
     "correctness": "0.0"
    },
    {
     "id": 1311776,
     "content_html": "Avoid interrupting the client with a hearing impairment.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client with a hearing impairment needs the nurse to be patient and provide them with time to communicate."
    }
