 "questions": [
  {
   "id": 647513,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is caring for a client from a different cultural background who refuses a certain medication. How can understanding transcultural models and frameworks help the nurse in this situation?",
   "answers": [
    {
     "id": 1275739,
     "content_html": "By disregarding the client’s cultural beliefs and administering the medication",
     "correctness": "0.0"
    },
    {
     "id": 1275740,
     "content_html": "By respecting the client’s cultural beliefs and finding an alternative medication",
     "correctness": "1.0"
    },
    {
     "id": 1275738,
     "content_html": "By consulting with the health care team to override the client’s choice",
     "correctness": "0.0"
    },
    {
     "id": 1275737,
     "content_html": "By educating the client about the importance of the medication and convincing them to take it",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Understanding transcultural models and frameworks can help the nurse in this situation by guiding them to respect the client’s cultural beliefs and find an alternative medication that aligns with the client’s cultural values. This approach promotes culturally sensitive care and supports the client’s autonomy and decision making in their health care journey."
    }
   ],
   "community_solutions": []
  }
 ],
