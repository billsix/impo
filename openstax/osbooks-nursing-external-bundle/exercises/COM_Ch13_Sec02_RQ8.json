   "id": 647430,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which diagnosis would the nurse anticipate when observing a “bull’s eye” rash on a client’s leg?",
   "answers": [
    {
     "id": 1275407,
     "content_html": "Zika virus",
     "correctness": "0.0"
    },
    {
     "id": 1275406,
     "content_html": "West Nile virus",
     "correctness": "0.0"
    },
    {
     "id": 1275408,
     "content_html": "Lyme disease",
     "correctness": "1.0"
    },
