   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The rash of erythema migrans is erythematous, annular, and homogenous at the site of the actual tick bite, expanding over several days, often to sizes greater than 5 centimeters in diameter with a central clearing that develops as the rash expands, resulting a “bull’s eye” appearance. Erythema migrans occurs in up to 80 percent of those infected with Lyme, but the classic rash is not always present."
    }
   ],
