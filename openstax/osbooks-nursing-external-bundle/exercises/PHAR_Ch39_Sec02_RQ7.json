   "stimulus_html": "",
   "stem_html": "Which adverse effect should the nurse caution the client taking amoxicillin-clavulanate to expect?",
   "answers": [
    {
     "id": 1311791,
     "content_html": "The client could experience ototoxic side effects.",
     "correctness": "0.0"
    },
    {
     "id": 1311790,
     "content_html": "The client should be careful when driving at night.",
     "correctness": "0.0"
    },
    {
     "id": 1311792,
     "content_html": "The client could experience diarrhea.",
     "correctness": "1.0"
    },
    {
