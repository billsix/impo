 "questions": [
  {
   "id": 660382,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client has just been diagnosed with mild Alzheimer’s disease. The health care provider prescribes donepezil oral disintegrating tablet 5 mg daily. What key point should the client be taught about how to take this drug?",
   "answers": [
    {
     "id": 1310643,
     "content_html": "“You may crush the pill and mix with food if you have problems swallowing the whole pill.”",
     "correctness": "0.0"
    },
    {
     "id": 1310642,
     "content_html": "“This medication should only be taken in the morning with your breakfast.”",
     "correctness": "0.0"
    },
    {
     "id": 1310644,
     "content_html": "“Allow the drug to completely dissolve on your tongue. Do not swallow it whole.”",
     "correctness": "1.0"
    },
    {
     "id": 1310641,
     "content_html": "“The drug is soft enough that you can chew it if you are afraid of choking.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The drug was prescribed as a disintegrating tablet, so it must completely dissolve on the tongue. It is not to be chewed, crushed, or swallowed whole."
    }
   ],
   "community_solutions": []
  }
 ],
