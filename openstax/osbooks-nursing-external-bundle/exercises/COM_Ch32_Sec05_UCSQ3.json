   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What action should Juanita complete prior to on-scene triage?",
   "answers": [
    {
     "id": 937088,
     "content_html": "Confirm victim transport has arrived",
     "correctness": "0.0"
    },
    {
     "id": 937089,
     "content_html": "Activate the Incident Command center",
     "correctness": "0.0"
    },
    {
     "id": 937090,
     "content_html": "Ensure the scene is safe",
     "correctness": "1.0"
    },
    {
     "id": 937091,
     "content_html": "Provide report to the emergency room",
     "correctness": "0.0"
    }
   ],
