 "questions": [
  {
   "id": 660681,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is applying silver sulfadiazine to burns on a client’s arm. The client asks that the nurse cover the area with a dressing to protect it and keep the medication from getting on their clothes. What is the best response by the nurse?",
   "answers": [
    {
     "id": 1311840,
     "content_html": "“I will apply a gauze dressing, which will protect the area but still allow air to pass through it.”",
     "correctness": "1.0"
    },
    {
     "id": 1311839,
     "content_html": "“I will apply an occlusive dressing to keep the keep the area sterile.”",
     "correctness": "0.0"
    },
    {
     "id": 1311838,
     "content_html": "“I will apply an occlusive dressing to ensure the medication is fully absorbed.”",
     "correctness": "0.0"
    },
    {
     "id": 1311837,
     "content_html": "“It is best to not apply a dressing and leave this open to the air.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Applying a nonocclusive dressing to protect the area is appropriate, but applying an occlusive dressing is contraindicated because it will increase the systemic effects of the medication."
    }
   ],
   "community_solutions": []
  }
 ],
