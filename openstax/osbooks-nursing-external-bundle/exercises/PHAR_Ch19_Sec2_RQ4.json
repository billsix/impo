 "questions": [
  {
   "id": 660466,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with heart failure who had been taking valsartan recently had the medication switched to sacubitril/valsartan. The client understands how valsartan works but is confused about sacubitril. The nurse explains that sacubitril:",
   "answers": [
    {
     "id": 1310979,
     "content_html": "Lowers heart rate to allow for more oxygen to get to the heart muscle tissue",
     "correctness": "0.0"
    },
    {
     "id": 1310978,
     "content_html": "Inhibits angiotensin-converting enzyme, which lowers blood pressure",
     "correctness": "0.0"
    },
    {
     "id": 1310980,
     "content_html": "Helps BNP stay in the system longer, which lowers blood pressure",
     "correctness": "1.0"
    },
    {
     "id": 1310977,
     "content_html": "Causes nitric oxide to be released in smooth muscles, which lowers blood pressure",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sacubitril inhibits neprilysin, which is an enzyme that breaks down BNP. BNP stimulates vasodilation and sodium and water excretion, which decrease afterload and preload, respectively."
    }
   ],
   "community_solutions": []
  }
 ],
