   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by a community health center demonstrates its commitment to providing a welcoming environment for LGBTQIA+ individuals?",
   "answers": [
    {
     "id": 1275855,
     "content_html": "Clearly marking restrooms for men and women",
     "correctness": "0.0"
    },
    {
     "id": 1275856,
     "content_html": "Including options other than male/female on intake forms",
     "correctness": "1.0"
    },
    {
     "id": 1275854,
     "content_html": "Using pronouns consistent with outward appearance",
     "correctness": "0.0"
    },
    {
     "id": 1275853,
     "content_html": "Avoiding asking about sexual orientation",
     "correctness": "0.0"
    }
   ],
