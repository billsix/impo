  {
   "id": 647395,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is creating a community program to promote outdoor exercise using Bronfenbrenner’s Socio-Ecological Model and is working with town planners to obtain funding and approval for sidewalks and walking and biking trails. Which of Bronfenbrenner’s systems is the nurse utilizing?",
   "answers": [
    {
     "id": 1275267,
     "content_html": "Microsystem",
     "correctness": "0.0"
    },
    {
     "id": 1275266,
     "content_html": "Mesosystem",
     "correctness": "0.0"
    },
    {
     "id": 1275265,
     "content_html": "Chronosystem",
     "correctness": "0.0"
    },
    {
     "id": 1275268,
     "content_html": "Macrosystem",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The Socio-Ecological Model considers how human growth and behavior can accommodate and change given the environment and systems that exist around people and how people interact with such environments and systems. The five systems identified in this model are the microsystem, mesosystem, exosystem, macrosystem, and chronosystem. The macrosystem includes codified laws, regulations, and rules as well as economic, social, educational, and legal systems."
    }
   ],
   "community_solutions": []
  }
