 "questions": [
  {
   "id": 660386,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nursing student is preparing a teaching plan for a client with PD who is being treated with carbidopa/levodopa. Which of the following dietary recommendations is correct?",
   "answers": [
    {
     "id": 1310659,
     "content_html": "Intake of green, leafy vegetables should be limited.",
     "correctness": "0.0"
    },
    {
     "id": 1310660,
     "content_html": "Daily required protein intake should be divided equally among three meals.",
     "correctness": "1.0"
    },
    {
     "id": 1310658,
     "content_html": "A high-fat diet will interfere with the absorption of carbidopa/levodopa.",
     "correctness": "0.0"
    },
    {
     "id": 1310657,
     "content_html": "High-fiber products will cause diarrhea.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "High-protein meals will interfere with levodopa absorption and entrance into the brain."
    }
   ],
   "community_solutions": []
