  {
   "id": 660198,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a primary goal of nutrition therapy for a client with chronic obstructive pulmonary disease (COPD)?",
   "answers": [
    {
     "id": 1309908,
     "content_html": "Maintaining a healthy body weight",
     "correctness": "1.0"
    },
    {
     "id": 1309907,
     "content_html": "Improving oxygenation status",
     "correctness": "0.0"
    },
    {
     "id": 1309906,
     "content_html": "Preventing muscle wasting",
     "correctness": "0.0"
    },
    {
     "id": 1309905,
     "content_html": "Lowering CO<sub>2</sub> levels",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A primary goal of nutrition therapy for pulmonary wellness is to maintain adequate respiratory function to decrease or prevent malnutrition and obesity. Healthy body weight will help preserve muscle strength and help maintain the integrity of the immune system."
    }
   ],
   "community_solutions": []
  }
