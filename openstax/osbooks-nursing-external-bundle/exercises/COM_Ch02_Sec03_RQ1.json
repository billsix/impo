 "questions": [
  {
   "id": 647313,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action must the nurse take after a patient has been diagnosed with hepatitis A?",
   "answers": [
    {
     "id": 1274939,
     "content_html": "Notify the Centers for Disease Control and Prevention",
     "correctness": "0.0"
    },
    {
     "id": 1274940,
     "content_html": "Report the case to the local public health department",
     "correctness": "1.0"
    },
    {
     "id": 1274938,
     "content_html": "Inform the National Institutes of Health",
     "correctness": "0.0"
    },
    {
     "id": 1274937,
     "content_html": "Report the case to the primary care provider",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Notifiable infectious diseases, such as hepatitis A, require health care providers to report the disease to public health officials. Reporting is mandated by law at state and local levels, whereas reporting to the CDC is voluntary."
    }
   ],
   "community_solutions": []
  }
 ],
