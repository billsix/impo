 "questions": [
  {
   "id": 366618,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge teaching for Thomas, who will use low molecular weight heparin (LMWH) injections at home. Which of the following statements about LMWH therapy will the nurse include in the teaching plan?",
   "answers": [
    {
     "id": 888765,
     "content_html": "More frequent lab assessments are required with LMWH therapy.",
     "correctness": "0.0"
    },
    {
     "id": 888766,
     "content_html": "The duration of action is 2–4 times longer than heparin.",
     "correctness": "1.0"
    },
    {
     "id": 888767,
     "content_html": "The risks for bleeding are less.",
     "correctness": "0.0"
    },
    {
     "id": 888768,
     "content_html": "LMWH is more likely to cause thrombocytopenia.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "One of the advantages of LMWH is the longer duration of action, which means that once-daily injections, instead of continuous infusion, are effective."
    }
   ],
   "community_solutions": []
  }
 ],
