   "id": 660124,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 15-year-old client has decided to try a vegetarian diet. Which of the following nutritional deficiencies is this client at risk for developing?",
   "answers": [
    {
     "id": 1309611,
     "content_html": "Vitamin C",
     "correctness": "0.0"
    },
    {
     "id": 1309612,
     "content_html": "Omega-3 fatty acids",
     "correctness": "1.0"
    },
    {
     "id": 1309610,
     "content_html": "Calcium",
     "correctness": "0.0"
    },
    {
     "id": 1309609,
     "content_html": "Potassium",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Nutritional deficiencies, especially of the omega-3 fatty acids, iron, zinc, and B<sub>12</sub>, are more common among vegetarians and vegans."
    }
   ],
   "community_solutions": []
  }
