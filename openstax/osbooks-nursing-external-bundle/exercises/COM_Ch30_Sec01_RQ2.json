   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which condition does the nurse recognize as increasing the risk of a poor outcome during a transition of care?",
   "answers": [
    {
     "id": 1276063,
     "content_html": "A client being discharged from hospital to home",
     "correctness": "0.0",
     "feedback_html": ""
    },
    {
     "id": 1276062,
     "content_html": "A client with an identified social support system",
     "correctness": "0.0"
    },
    {
     "id": 1276064,
     "content_html": "A client with limited health literacy",
     "correctness": "1.0"
    },
    {
     "id": 1276061,
     "content_html": "A client with one provider",
     "correctness": "0.0",
