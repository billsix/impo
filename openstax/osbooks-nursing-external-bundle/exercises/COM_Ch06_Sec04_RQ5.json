   "stimulus_html": "",
   "stem_html": "Which client being seen in the community health clinic does the nurse anticipate is most affected by allostatic load?",
   "answers": [
    {
     "id": 1275115,
     "content_html": "A 52-year-old Native American construction worker with osteoarthritis of the knees",
     "correctness": "0.0"
    },
    {
     "id": 1275116,
     "content_html": "A 24-year-old Black man with persistent hypertension",
     "correctness": "1.0"
    },
    {
     "id": 1275114,
     "content_html": "A 62-year-old White woman with newly diagnosed hypothyroidism",
     "correctness": "0.0"
    },
    {
     "id": 1275113,
     "content_html": "A 38-year-old Hispanic woman concerned about a change in the color of a mole",
