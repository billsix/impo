 "questions": [
  {
   "id": 647428,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which primary prevention strategy will the nurse include in a community program on the prevention of hepatitis C?",
   "answers": [
    {
     "id": 1275399,
     "content_html": "Advising individuals with risky sexual behaviors to be screened for hepatitis C",
     "correctness": "0.0"
    },
    {
     "id": 1275398,
     "content_html": "Stressing that handwashing is important after changing diapers or using the bathroom",
     "correctness": "0.0"
    },
    {
     "id": 1275397,
     "content_html": "Recommending immunizations against the other viral hepatitis infections",
     "correctness": "0.0"
    },
    {
     "id": 1275400,
     "content_html": "Instructing individuals to avoid sharing needles, syringes, or other equipment contaminated with blood",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Since hepatitis C is transmitted by direct contact with infected blood, the primary prevention strategy to reduce the risk of transmission is to avoid sharing contaminated equipment, such as syringes and needles."
    }
   ],
   "community_solutions": []
  }
