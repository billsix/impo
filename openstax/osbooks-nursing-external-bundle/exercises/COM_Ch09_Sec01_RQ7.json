 "questions": [
  {
   "id": 647389,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements by a nursing student would indicate the need for further education?",
   "answers": [
    {
     "id": 1275243,
     "content_html": "“A difference in health status between older adults and the young may indicate a health disparity.”",
     "correctness": "0.0"
    },
    {
     "id": 1275244,
     "content_html": "“Race is not a determinant of health.”",
     "correctness": "1.0"
    },
    {
     "id": 1275242,
     "content_html": "“Individuals who live in high-poverty areas may need assistance accessing health care services.”",
     "correctness": "0.0"
    },
    {
     "id": 1275241,
     "content_html": "“If I don’t have a high school diploma, my risk for chronic disease rises.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Race is a determinant of health that can lead to health disparities. For example, Black people are at a greater risk of developing certain diseases than their non-minority counterparts because they have less access to health care and experience greater levels of poverty."
    }
   ],
   "community_solutions": []
  }
