   "id": 647454,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which activity would the nurse recognize as meeting the Healthy People 2030 goal of civic participation?",
   "answers": [
    {
     "id": 1275504,
     "content_html": "Voting in local, state, and federal elections",
     "correctness": "1.0"
    },
    {
     "id": 1275503,
     "content_html": "Planting a home garden",
     "correctness": "0.0"
    },
    {
     "id": 1275502,
     "content_html": "Running in a 5-mile road race",
     "correctness": "0.0"
    },
    {
     "id": 1275501,
     "content_html": "Keeping vaccinations current",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Healthy People 2030 identifies voting, volunteering, participating in group activities and activities like community gardening, and participating in a recreational sports team as methods of civic participation. Such activities can benefit the health of individuals and populations."
    }
   ],
