   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse has completed medication education for a client prior to their receiving phenelzine. The nurse evaluates the education as effective when the client makes which statement?",
   "answers": [
    {
     "id": 1310735,
     "content_html": "“Eating seafood could cause my blood pressure to become very low.”",
     "correctness": "0.0"
    },
    {
     "id": 1310734,
     "content_html": "“Instead of white bread, I should use whole wheat.”",
     "correctness": "0.0"
    },
    {
     "id": 1310733,
     "content_html": "“I guess I cannot have steak and eggs anymore.”",
     "correctness": "0.0"
    },
    {
     "id": 1310736,
     "content_html": "“I should use almond milk instead of whole milk and need to avoid aged cheeses.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
