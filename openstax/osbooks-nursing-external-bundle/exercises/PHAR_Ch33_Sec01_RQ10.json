   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with renal colic. This finding is most commonly associated with which of the following conditions?",
   "answers": [
    {
     "id": 1311544,
     "content_html": "Renal calculi",
     "correctness": "1.0"
    },
    {
     "id": 1311543,
     "content_html": "Acute tubular necrosis",
     "correctness": "0.0"
    },
    {
     "id": 1311542,
     "content_html": "Renal artery stenosis",
     "correctness": "0.0"
    },
    {
     "id": 1311541,
     "content_html": "Glomerulonephritis",
     "correctness": "0.0"
    }
   ],
