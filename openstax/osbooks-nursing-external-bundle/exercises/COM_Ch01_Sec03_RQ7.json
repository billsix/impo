 "questions": [
  {
   "id": 647309,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which potential barrier of siloed health care should the nurse consider when planning health promotion activities?",
   "answers": [
    {
     "id": 1274923,
     "content_html": "Providers and specialists working closely together to improve outcomes",
     "correctness": "0.0"
    },
    {
     "id": 1274924,
     "content_html": "Treating one disease at a time without evaluating or addressing the full picture of health",
     "correctness": "1.0"
    },
    {
     "id": 1274922,
     "content_html": "Health systems becoming effectively integrated",
     "correctness": "0.0"
    },
    {
     "id": 1274921,
     "content_html": "An emphasis on population health and health promotion",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Siloed health care is also the practice of treating one condition or disease at a time without consideration of other diagnoses or the client’s living environment, education, social situation, and family, among other characteristics."
    }
   ],
