   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which concept should the nurse consider when providing maternal-child health care to immigrants who have newly arrived in the United States from various countries around the world?",
   "answers": [
    {
     "id": 1276191,
     "content_html": "The rate of infant mortality is consistent around the world.",
     "correctness": "0.0"
    },
    {
     "id": 1276190,
     "content_html": "Deaths from eclampsia are lower in Black women than White women.",
     "correctness": "0.0"
    },
    {
     "id": 1276192,
     "content_html": "Black women are more likely to die from pregnancy-related cardiomyopathy.",
     "correctness": "1.0"
    },
    {
     "id": 1276189,
     "content_html": "Global disparities in maternal-child deaths cannot be changed.",
     "correctness": "0.0"
