 "questions": [
  {
   "id": 647501,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by the nurse is an example of community health program sustainability?",
   "answers": [
    {
     "id": 1275692,
     "content_html": "Soliciting another funding source to continue a program",
     "correctness": "1.0"
    },
    {
     "id": 1275691,
     "content_html": "Using the same funding source to offer a program",
     "correctness": "0.0"
    },
    {
     "id": 1275690,
     "content_html": "Decreasing the number of community partners",
     "correctness": "0.0"
    },
    {
     "id": 1275689,
     "content_html": "Discontinuing the program due to lack of interest",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sustainability is defined as the continuation of community health programs by decreasing dependence on one source of funding and shifting to a new funding stream because the program is valued, cost and resource efficient, effective, and supported by the community."
    }
   ],
   "community_solutions": []
  }
