   "id": 660671,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which instruction should the nurse give to a client with diabetes who is taking a decongestant for relief from sinus and ear congestion caused by an upper respiratory infection?",
   "answers": [
    {
     "id": 1311799,
     "content_html": "Increase daily insulin while taking the decongestant.",
     "correctness": "0.0"
    },
    {
     "id": 1311798,
     "content_html": "Decrease daily insulin while taking the decongestant.",
     "correctness": "0.0"
    },
    {
     "id": 1311800,
     "content_html": "Regularly check serum glucose while taking the decongestant.",
     "correctness": "1.0"
    },
    {
     "id": 1311797,
     "content_html": "Taper the decongestant before stopping the medication.",
     "correctness": "0.0"
    }
   ],
