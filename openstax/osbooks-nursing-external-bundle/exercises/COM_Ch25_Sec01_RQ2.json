 "questions": [
  {
   "id": 647544,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What action by a nurse demonstrates cultural humility in client-centered care?",
   "answers": [
    {
     "id": 1275863,
     "content_html": "Using complex medical terminology to show expertise",
     "correctness": "0.0"
    },
    {
     "id": 1275862,
     "content_html": "Assuming that the nurse’s cultural practices are universally applicable",
     "correctness": "0.0"
    },
    {
     "id": 1275864,
     "content_html": "Adapting care practices to align with the client’s cultural preferences",
     "correctness": "1.0"
    },
    {
     "id": 1275861,
     "content_html": "Disregarding the client’s input and family’s opinions in decision making",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Adapting care practices to align with the client’s cultural preferences and needs demonstrates cultural humility. It recognizes the importance of valuing the client’s cultural background and adjusting care to ensure it is respectful and appropriate based on the client’s cultural beliefs and practices."
    }
   ],
   "community_solutions": []
  }
