 "questions": [
  {
   "id": 647397,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which situation is an example of a nurse engaging in the Socio-Ecological Model to guide nursing care?",
   "answers": [
    {
     "id": 1275275,
     "content_html": "Administering insulin to a client with type 2 diabetes who has seen a worsening of their glycemic control despite taking metformin",
     "correctness": "0.0"
    },
    {
     "id": 1275276,
     "content_html": "Evaluating the causative factors of an observed increase in the number of grade-school children with newly diagnosed asthma",
     "correctness": "1.0"
    },
    {
     "id": 1275274,
     "content_html": "Evaluating the impact of lisinopril on a client’s blood pressure 3 months after starting the medication",
     "correctness": "0.0"
    },
    {
     "id": 1275273,
     "content_html": "Planning an education session for a client following surgery with a goal of independently changing the surgical site dressing",
     "correctness": "0.0"
    }
   ],
   "hints": [],
