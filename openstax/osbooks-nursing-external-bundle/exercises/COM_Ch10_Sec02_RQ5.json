    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The Socio-Ecological Model considers how human growth and behavior can accommodate and change given the environment and systems that exist around people. Looking for causative factors for an increase in asthma diagnoses is an example of the environment that may be contributing to rising rates of asthma among grade-school children."
    }
   ],
