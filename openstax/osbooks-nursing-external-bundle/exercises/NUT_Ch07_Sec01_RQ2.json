 "questions": [
  {
   "id": 660134,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing diet instruction to a client with a vitamin D deficiency. Which of the following statements by the client indicates the need for further instruction?",
   "answers": [
    {
     "id": 1309652,
     "content_html": "“I should avoid eating tuna and salmon.”",
     "correctness": "1.0"
    },
    {
     "id": 1309651,
     "content_html": " “I should eat fortified cereal for breakfast.”",
     "correctness": "0.0"
    },
    {
     "id": 1309650,
     "content_html": "“My diet plan may not be enough. I may need to take a vitamin D supplement.”",
     "correctness": "0.0"
    },
    {
     "id": 1309649,
     "content_html": " “I should try to eat more spinach.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Tuna and salmon, and other fatty fish, are good sources of vitamin D. The client should try to incorporate these foods into their diet."
    }
   ],
   "community_solutions": []
  }
