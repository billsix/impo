 "questions": [
  {
   "id": 660345,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client is being prescribed a tetracycline antibiotic for an upper respiratory tract infection. What would be an important educational point for the nurse to teach the client?",
   "answers": [
    {
     "id": 1310495,
     "content_html": "“Stop taking the medication when you begin to feel better.”",
     "correctness": "0.0"
    },
    {
     "id": 1310494,
     "content_html": "“You can take the medication with milk, juice, or water.”",
     "correctness": "0.0"
    },
    {
     "id": 1310493,
     "content_html": "“This medication is effective for bacterial and viral infections.”",
     "correctness": "0.0"
    },
    {
     "id": 1310496,
     "content_html": "“Talk to your health care provider before becoming pregnant.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Tetracyclines should not be used if the client is pregnant."
    }
   ],
   "community_solutions": []
  }
 ],
