   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When providing discharge instructions to a client with COPD, which information should the nurse include?",
   "answers": [
    {
     "id": 1311152,
     "content_html": "“You may be more susceptible to infections.”",
     "correctness": "1.0"
    },
    {
     "id": 1311151,
     "content_html": "“Your disease will be cured with the use of medications.”",
     "correctness": "0.0"
    },
    {
     "id": 1311150,
     "content_html": "“You will need less oxygen over time.”",
     "correctness": "0.0"
    },
    {
     "id": 1311149,
     "content_html": "“You should not exercise because it will aggravate your condition.”",
     "correctness": "0.0"
    }
   ],
