 "questions": [
  {
   "id": 647391,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse educating a group of men on the importance of performing testicular self-exams recognizes that which of the following factors influences the likelihood that they will adhere to this recommendation?",
   "answers": [
    {
     "id": 1275251,
     "content_html": "Low health literacy levels",
     "correctness": "0.0"
    },
    {
     "id": 1275250,
     "content_html": "Poor social support",
     "correctness": "0.0"
    },
    {
     "id": 1275249,
     "content_html": "Gender bias related to health care access",
     "correctness": "0.0"
    },
    {
     "id": 1275252,
     "content_html": "Gender norms related to masculinity",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Gender norms are social and cultural principles that influence ideas on how different genders are supposed to behave in society. Among these factors, social norms related to masculinity are most likely to affect the adherence rates of men performing testicular exams."
    }
   ],
   "community_solutions": []
  }
