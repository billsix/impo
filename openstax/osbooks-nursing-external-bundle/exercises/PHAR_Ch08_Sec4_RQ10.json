   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which premedication order will the nurse anticipate being ordered to administer prior to administering rituximab?",
   "answers": [
    {
     "id": 1310564,
     "content_html": "Diphenhydramine and acetaminophen",
     "correctness": "1.0"
