   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The epidemiological triad includes the host, agent, and environment. The greater the pathogenicity, the greater the ability of the agent to cause disease in a susceptible host. Pathogenicity is dependent upon the infectivity of the agent—its ability to invade the host, destroy host body cells, and produce toxins resulting in virulence, or severity of the infectious disease."
    }
   ],
