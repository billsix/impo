 "questions": [
  {
   "id": 647493,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is planning a community program to decrease youth substance misuse. Which strategy could the nurse implement to promote participant recruitment?",
   "answers": [
    {
     "id": 1275659,
     "content_html": "Hold meetings in evening at a local church",
     "correctness": "0.0"
    },
    {
     "id": 1275660,
     "content_html": "Integrate activities into the regular school schedule",
     "correctness": "1.0"
    },
    {
     "id": 1275658,
     "content_html": "Collaborate with the school principal when developing materials",
     "correctness": "0.0"
    },
    {
     "id": 1275657,
     "content_html": "Assess parent and guardian perceptions of youth substance misuse",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse will see increased participation if activities are scheduled during regular school hours. Youth often have conflicts related to athletics, academics, work, or provision of sibling care after school hours."
    }
   ],
   "community_solutions": []
  }
 ],
