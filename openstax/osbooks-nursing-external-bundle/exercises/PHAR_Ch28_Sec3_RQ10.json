   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse received a health care provider’s order to administer 750 mg of metformin twice daily to a client. Metformin is available in 500 mg tablets. How many tablets will the nurse administer per dose?",
   "answers": [
    {
     "id": 1311364,
     "content_html": "1.5 tablets",
     "correctness": "1.0"
    },
    {
     "id": 1311363,
     "content_html": "2 tablets",
     "correctness": "0.0"
    },
    {
     "id": 1311362,
     "content_html": "3 tablets",
     "correctness": "0.0"
    },
    {
     "id": 1311361,
     "content_html": "4 tablets",
     "correctness": "0.0"
    }
   ],
