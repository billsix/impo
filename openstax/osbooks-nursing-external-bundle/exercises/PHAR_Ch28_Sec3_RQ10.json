    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\frac{750\\;\\mathrm{mg}}{x\\;\\mathrm{tablets}}\"></span> (desired dose) <span data-math=\"=\\frac{500\\;\\mathrm{mg}}{1\\;\\mathrm{tablet}}\"></span> (supply on hand)<br><span data-math=\"\\begin{aligned}500x&amp;=750\\times1\\\\x&amp;=\\frac{750}{500}\\\\x&amp;=\\;1.5\\;\\mathrm{tablets}\\;\\mathrm{per}\\;\\mathrm{dose}.\\end{aligned}\"></span>"
    }
   ],
