 "questions": [
  {
   "id": 660515,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement best describes the action of nasal decongestants?",
   "answers": [
    {
     "id": 1311175,
     "content_html": "Nasal decongestants promote mucus production, leading to easier clearance of nasal passages.",
     "correctness": "0.0"
    },
    {
     "id": 1311174,
     "content_html": "Nasal decongestants inhibit histamine release, reducing nasal congestion and inflammation.",
     "correctness": "0.0"
    },
    {
     "id": 1311176,
     "content_html": "Nasal decongestants exert their effect by constricting blood vessels in the nasal mucosa, relieving congestion.",
     "correctness": "1.0"
    },
    {
     "id": 1311173,
     "content_html": "Nasal decongestants decrease the production of prostaglandins, which results in decreased nasal discharge.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Constricting blood vessels in the nose decreases the amount of fluid draining from the blood vessels into the nasal passage."
    }
   ],
