 "questions": [
  {
   "id": 647539,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is evaluating the effectiveness of a cultural competence training program. Which outcome is the nurse most likely to measure?",
   "answers": [
    {
     "id": 1275843,
     "content_html": "Increase in client acuity levels",
     "correctness": "0.0"
    },
    {
     "id": 1275842,
     "content_html": "Reduction in health care costs",
     "correctness": "0.0"
    },
    {
     "id": 1275844,
     "content_html": "Improvement in client satisfaction scores",
     "correctness": "1.0"
    },
    {
     "id": 1275841,
     "content_html": "Decrease in client wait times",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "When evaluating the effectiveness of a cultural competence training program, a nurse is likely to measure for an improvement in client satisfaction scores because that is an indication if clients feel heard, understood, and respected."
    }
   ],
   "community_solutions": []
  }
