 "questions": [
  {
   "id": 647578,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following actions by a home health nurse can decrease the risk of experiencing unsafe conditions while in a family’s home?",
   "answers": [
    {
     "id": 1275999,
     "content_html": "Research and learn more about the surrounding neighborhood before the visit.",
     "correctness": "0.0"
    },
    {
     "id": 1276000,
     "content_html": "Maintain situational awareness of other people and pets in the home.",
     "correctness": "1.0"
    },
    {
     "id": 1275998,
     "content_html": "Make the visit as brief as possible to minimize time spent in the home.",
     "correctness": "0.0"
    },
    {
     "id": 1275997,
     "content_html": "Maintain an updated visit schedule with the main office.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Home health nurses can face unpredictable and unsafe conditions. They should remain vigilant of their surroundings and recognize potential safety concerns."
    }
   ],
   "community_solutions": []
  }
