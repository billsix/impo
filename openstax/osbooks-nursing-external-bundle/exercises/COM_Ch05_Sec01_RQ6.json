 "questions": [
  {
   "id": 647348,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is working in a community health clinic that serves a large Asian population. Which health factor should the nurse consider when providing care to this population?",
   "answers": [
    {
     "id": 1275080,
     "content_html": "There is a higher rate of hepatitis B than in other ethnic groups.",
     "correctness": "1.0"
    },
    {
     "id": 1275079,
     "content_html": "The rate of tuberculosis is lower than all people diagnosed with this infection.",
     "correctness": "0.0"
    },
    {
     "id": 1275078,
     "content_html": "They are more likely to receive care for mental health issues.",
     "correctness": "0.0"
    },
    {
     "id": 1275077,
     "content_html": "There is a lower genetic risk for developing prediabetes.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Asian/Pacific Islanders experience the highest rate of hepatitis B when compared with other ethnic groups."
    }
   ],
