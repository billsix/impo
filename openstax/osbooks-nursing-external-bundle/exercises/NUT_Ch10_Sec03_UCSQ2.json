   "id": 366592,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following may indicate that Catalina’s iron dosage is not adequate or that the iron is not being fully absorbed?",
   "answers": [
    {
     "id": 888661,
     "content_html": "Constipation",
     "correctness": "0.0"
    },
    {
     "id": 888662,
     "content_html": "Increased appetite",
     "correctness": "0.0"
    },
    {
     "id": 888663,
     "content_html": "Weakness and dizziness",
     "correctness": "1.0"
    },
    {
     "id": 888664,
     "content_html": "Increased menstrual bleeding",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Feeling weak and dizzy may be a sign of low hemoglobin or worsening anemia. This can occur if oral iron is not absorbed sufficiently by the body."
    }
   ],
   "community_solutions": []
  }
