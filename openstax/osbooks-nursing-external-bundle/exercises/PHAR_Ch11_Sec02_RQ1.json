 "questions": [
  {
   "id": 660383,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 68-year-old diagnosed with Parkinson’s disease is taking entacapone in addition to carbidopa/levodopa. Which of the following would be a priority nursing intervention?",
   "answers": [
    {
     "id": 1310647,
     "content_html": "Check the client’s blood pressure twice a day to make sure it is not elevated.",
     "correctness": "0.0"
    },
    {
     "id": 1310648,
     "content_html": "Assess the client’s ability to independently carry out their activities of daily living.",
     "correctness": "1.0"
    },
    {
     "id": 1310646,
     "content_html": "Explain to the client the entacapone should be separated from the carbidopa/levodopa by 2 hours.",
     "correctness": "0.0"
    },
    {
     "id": 1310645,
     "content_html": "Instruct the client to report brownish-orange urine to their health care provider immediately.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse is evaluating the therapeutic effectiveness of the drugs. The client being able to perform more activities of daily living indicates the drugs are working."
    }
   ],
   "community_solutions": []
