 "questions": [
  {
   "id": 447148,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following would be categorized as an enabling factor for addressing opioid misuse?",
   "answers": [
    {
     "id": 936864,
     "content_html": "A drug rehabilitation center is located within the community.",
     "correctness": "1.0"
    },
    {
     "id": 936865,
     "content_html": "Local media promotes community naloxone training.",
     "correctness": "0.0"
    },
    {
     "id": 936866,
     "content_html": "High school students gain knowledge of the consequences of opioid misuse.",
     "correctness": "0.0"
    },
    {
     "id": 936867,
     "content_html": "A cycle of drug misuse is linked to specific families in the community.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A drug rehabilitation center is located in the community. Enabling factors are characteristics of the environment and community that make it easier for community members to change their behavior or their environment. This includes community programs, services, and resources. Media is a reinforcing factor to motivate specific behaviors. Knowledge, beliefs, values, and attitudes of the individual are predisposing factors. Attaining knowledge in high school and values learned from family are predisposing factors."
    }
   ],
   "community_solutions": []
  }
 ],
