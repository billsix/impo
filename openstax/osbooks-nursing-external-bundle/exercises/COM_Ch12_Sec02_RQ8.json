   "stimulus_html": "",
   "stem_html": "Which action highlights Florence Nightingale’s role as an epidemiologist?",
   "answers": [
    {
     "id": 1275367,
     "content_html": "Dressing soldiers’ infected wounds",
     "correctness": "0.0"
    },
    {
     "id": 1275368,
     "content_html": "Connecting poor sanitation with negative health outcomes",
     "correctness": "1.0"
    },
    {
     "id": 1275366,
     "content_html": "Developing training schools for nurses and midwives",
     "correctness": "0.0"
    },
    {
     "id": 1275365,
     "content_html": "Changing linens and frequently bathing clients",
     "correctness": "0.0"
    }
   ],
