   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which information would the nurse give to a 67-year-old female client receiving tamoxifen to treat breast cancer?",
   "answers": [
    {
     "id": 1310555,
     "content_html": "Tamoxifen can cause muscle or joint pain.",
     "correctness": "0.0"
    },
    {
     "id": 1310554,
     "content_html": "This medication is administered intramuscularly.",
     "correctness": "0.0"
    },
    {
     "id": 1310553,
     "content_html": "Liver function tests need to be closely monitored.",
     "correctness": "0.0"
    },
    {
     "id": 1310556,
     "content_html": "Tamoxifen is taken for 5 years.",
     "correctness": "1.0"
    }
   ],
