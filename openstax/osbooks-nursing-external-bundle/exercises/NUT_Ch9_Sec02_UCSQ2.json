   "stimulus_html": "",
   "stem_html": "Which of Ms. Foster’s risk factors for worsening anemia is modifiable?",
   "answers": [
    {
     "id": 898490,
     "content_html": "Hypertension",
     "correctness": "0.0"
    },
    {
     "id": 898491,
