 "questions": [
  {
   "id": 647396,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is working to change negative social beliefs towards breastfeeding in a rural area using the UNICEF Socio-Ecological Model. At which level of this model is the nurse effecting change?",
   "answers": [
    {
     "id": 1275271,
     "content_html": "Individual",
     "correctness": "0.0"
    },
    {
     "id": 1275272,
     "content_html": "Community",
     "correctness": "1.0"
    },
    {
     "id": 1275270,
     "content_html": "Organizational/institutional",
     "correctness": "0.0"
    },
    {
     "id": 1275269,
     "content_html": "Policy/system and enabling environments",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The UNICEF Socio-Ecological Model uses a socio-ecological approach as a conceptual framework for many health-promoting initiatives at the individual/interpersonal, community, organizational/institutional, and policy/system enabling environments levels. The nurse is effecting change at the community level by focusing on social beliefs and norms about breastfeeding."
    }
   ],
   "community_solutions": []
