   "id": 660298,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The health care provider ordered 6 mg of dexamethasone sodium phosphate injection. The pharmacy provided a vial labeled 120 mg/30 mL. How many mL will be administered to the client? (Round to the nearest tenth.)",
   "answers": [
    {
     "id": 1310307,
     "content_html": "0.6 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310308,
     "content_html": "1.5 mL",
     "correctness": "1.0"
    },
    {
     "id": 1310306,
     "content_html": "2.3 mL",
     "correctness": "0.0"
    },
    {
