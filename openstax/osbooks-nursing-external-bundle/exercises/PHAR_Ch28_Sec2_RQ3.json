 "questions": [
  {
   "id": 660556,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is administering regular insulin to a client with diabetes. After administering the correct dose at 6:30 a.m., the nurse should ensure the client receives breakfast at which of the following times?",
   "answers": [
    {
     "id": 1311340,
     "content_html": "7 a.m.",
     "correctness": "1.0"
    },
    {
     "id": 1311339,
     "content_html": "8 a.m.",
     "correctness": "0.0"
    },
    {
     "id": 1311338,
     "content_html": "9 a.m.",
     "correctness": "0.0"
    },
    {
     "id": 1311337,
     "content_html": "10 a.m.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The onset of regular insulin is 30 minutes. Breakfast should be given by 7 a.m. to prevent hypoglycemia."
    }
   ],
   "community_solutions": []
  }
 ],
