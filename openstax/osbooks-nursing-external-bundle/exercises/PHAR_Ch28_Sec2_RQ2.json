 "questions": [
  {
   "id": 660555,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is developing an education plan for a client with diabetes in regard to an insulin pump. Which of the following should the nurse include in the education plan?",
   "answers": [
    {
     "id": 1311335,
     "content_html": "Teach the client to rotate sites for insulin injections",
     "correctness": "0.0"
    },
    {
     "id": 1311336,
     "content_html": "Teach the client to recognize symptoms of hypoglycemia",
     "correctness": "1.0"
    },
    {
     "id": 1311334,
     "content_html": "Teach the client how to administer insulin injections",
     "correctness": "0.0"
    },
    {
     "id": 1311333,
     "content_html": "Teach the client how to obtain a glycosylated hemoglobin once a month",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Clients with diabetes should be taught to recognize signs of hypoglycemia to prevent a hypoglycemic reaction and serious complications."
    }
   ],
   "community_solutions": []
  }
