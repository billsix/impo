  {
   "id": 660246,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client about the nutritional needs of their adolescent child. Which information should be included in the education? ",
   "answers": [
    {
     "id": 1310099,
     "content_html": "Young males need fewer calories than young females do.",
     "correctness": "0.0"
    },
    {
     "id": 1310098,
     "content_html": "Adolescent females require 3000 kcal/day.",
     "correctness": "0.0"
    },
    {
     "id": 1310100,
     "content_html": "Fast foods need to be supplanted with healthier options.",
     "correctness": "1.0"
    },
    {
     "id": 1310097,
     "content_html": "Adolescents need less iron intake daily than other age groups.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Adolescents like to be autonomous, but many tend to prefer convenience foods such as fast food. Parents should be instructed to provide a healthy diet whenever possible rather than simply incorporating healthy items into unhealthy diet."
    }
   ],
   "community_solutions": []
  }
