 "questions": [
  {
   "id": 647365,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is discussing homecare instructions with a client who was treated on a medical unit for an exacerbation of heart failure. The client tells the nurse that follow-up care will be difficult since they live 30 miles away and do not drive. Which intervention by the nurse can best meet the immediate needs of this client for follow-up care?",
   "answers": [
    {
     "id": 1275147,
     "content_html": "Meeting with community leaders about the need for medical facilities in the rural community",
     "correctness": "0.0"
    },
    {
     "id": 1275146,
     "content_html": "Providing the client with agencies that may be able to assist with transportation",
     "correctness": "0.0"
    },
    {
     "id": 1275148,
     "content_html": "Arranging for home monitoring and telehealth follow-up",
     "correctness": "1.0"
    },
    {
     "id": 1275145,
     "content_html": "Reinforce that follow-up is important and that the client needs to find rides to appointments",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The use of telehealth can provide care remotely to individuals who live in care deserts where there is limited access to health care services."
    }
   ],
   "community_solutions": []
  }
 ],
