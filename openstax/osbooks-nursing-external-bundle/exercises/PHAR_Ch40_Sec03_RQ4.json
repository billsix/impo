 "questions": [
  {
   "id": 660677,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client newly diagnosed with plaque psoriasis asks the nurse how this condition will be treated. Which is the correct response by the nurse?",
   "answers": [
    {
     "id": 1311823,
     "content_html": "“You will need surgical intervention to remove these lesions.”",
     "correctness": "0.0"
    },
    {
     "id": 1311824,
     "content_html": "“Combination therapy to exfoliate and reduce cell maturation will be used.”",
     "correctness": "1.0"
    },
    {
     "id": 1311822,
     "content_html": "“A steroidal cream should clear this condition in 2 weeks.”",
     "correctness": "0.0"
    },
    {
     "id": 1311821,
     "content_html": "“You will be given an antibiotic to eliminate bacterial organisms.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Psoriasis treatment requires exfoliation to remove plaque formation and drugs to decrease rapid skin cell growth to prevent plaques."
    }
   ],
   "community_solutions": []
  }
