 "questions": [
  {
   "id": 647627,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The community health nurse has formed a coalition to provide programming and safe meeting spaces for adolescents after school. Which statement best describes the nurse’s purpose for forming a coalition?",
   "answers": [
    {
     "id": 1276196,
     "content_html": "The nurse does not have the time to create this program without help.",
     "correctness": "1.0"
    },
    {
     "id": 1276195,
     "content_html": "There will be shared blame if the program fails.",
     "correctness": "0.0"
    },
    {
     "id": 1276194,
     "content_html": "The nurse does not possess the skills to develop such a program without help.",
     "correctness": "0.0"
    },
    {
     "id": 1276193,
     "content_html": "Resources are shared to increase the likelihood of achieving success.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A coalition is a group of people with shared vision or concerns who collaborate to support a cause. Nurses may form coalitions to maximize resources to improve the chances of successfully achieving these goals."
    }
   ],
   "community_solutions": []
  }
