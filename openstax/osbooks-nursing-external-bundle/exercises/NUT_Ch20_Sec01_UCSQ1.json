 "questions": [
  {
   "id": 366699,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What information might indicate that the baby is at increased risk for musculoskeletal and integumentary issues later in infancy and throughout adulthood?",
   "answers": [
    {
     "id": 889089,
     "content_html": "The baby will be breastfed.",
     "correctness": "0.0"
    },
    {
     "id": 889090,
     "content_html": "The mother did not consume enough whole grains during the pregnancy.",
     "correctness": "0.0"
    },
    {
     "id": 889091,
     "content_html": "The mother did not consume many dairy products during the pregnancy.",
     "correctness": "1.0"
    },
    {
     "id": 889092,
     "content_html": "The baby is male.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Adequate intake of dairy products helps ensure that enough calcium is consumed, which is necessary to support musculoskeletal and integumentary growth and development in the fetus."
    }
   ],
   "community_solutions": []
  }
