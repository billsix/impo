   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which process will the nurse involved in a research study utilize to protect participant autonomy and informed consent?",
   "answers": [
    {
     "id": 1275608,
     "content_html": "Obtaining Institutional Review Board approval",
     "correctness": "1.0"
    },
    {
     "id": 1275607,
     "content_html": "Following Health Insurance Portability and Accountability Act (HIPAA) guidelines",
     "correctness": "0.0"
    },
    {
     "id": 1275606,
     "content_html": "Ensuring Family Educational Rights and Privacy Act (FERPA) protections",
     "correctness": "0.0"
    },
    {
     "id": 1275605,
     "content_html": "Adhering to Affordable Care Act (ACA) regulations",
     "correctness": "0.0"
    }
   ],
