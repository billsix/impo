   "id": 366795,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on the information above, what is the most important question for the nurse to ask Maria?",
   "answers": [
    {
     "id": 889393,
     "content_html": "“How long have you been taking aspirin?”",
     "correctness": "0.0"
    },
    {
     "id": 889394,
     "content_html": "“How many stools have you had today?”",
     "correctness": "0.0"
    },
    {
     "id": 889395,
     "content_html": "“How much ibuprofen do you take each day?”",
     "correctness": "1.0"
    },
    {
     "id": 889396,
     "content_html": "“Have you lost any weight in the last month?”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
