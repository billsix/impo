 "questions": [
  {
   "id": 387432,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on the assessment findings, which of the following clinical findings indicates compliance with the prescribed nutritional plan?",
   "answers": [
    {
     "id": 914661,
     "content_html": "Alcohol intake of 3 glasses wine per day",
     "correctness": "0.0"
    },
    {
     "id": 914662,
     "content_html": "Total cholesterol level remains 240",
     "correctness": "0.0"
    },
    {
     "id": 914663,
     "content_html": "Dietitian appointment scheduled",
     "correctness": "1.0"
    },
    {
     "id": 914664,
     "content_html": "Body mass index &gt; 35",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client’s going to their dietitian appointment shows adherence to the prescribed plan. Signs of nonadherence include alcohol use; increased BMI; increased total cholesterol; increased blood pressure; low intake of fruits, vegetables, and fiber; and high intake of processed sugars."
    }
   ],
