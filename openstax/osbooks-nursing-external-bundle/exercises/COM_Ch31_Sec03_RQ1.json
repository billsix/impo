   "id": 647603,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The community health nurse is performing an admission assessment on a client with a substance use disorder. Which of the following questions is most appropriate for the nurse to use when interviewing the client about their substance use history?",
   "answers": [
    {
     "id": 1276099,
     "content_html": "Why have you waited until now to seek treatment?",
     "correctness": "0.0"
    },
    {
     "id": 1276100,
     "content_html": "What type of substances do you use and how often?",
     "correctness": "1.0"
    },
    {
     "id": 1276098,
     "content_html": "Do you think you can follow through with the treatment plan?",
     "correctness": "0.0"
    },
    {
     "id": 1276097,
     "content_html": "Why did you let yourself get addicted?",
     "correctness": "0.0"
    }
   ],
