  {
   "id": 660132,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge instructions to a client who has been prescribed an antidepressant. What nutritional recommendations are appropriate for this client?",
   "answers": [
    {
     "id": 1309643,
     "content_html": "Drink a glass of orange juice when taking your medication.",
     "correctness": "0.0"
    },
    {
     "id": 1309642,
     "content_html": "Eat a high-fiber meal when taking your medication.",
     "correctness": "0.0"
    },
    {
     "id": 1309641,
     "content_html": "Switch to a high-carbohydrate diet to decrease the risk for weight loss.",
     "correctness": "0.0"
    },
    {
     "id": 1309644,
     "content_html": "Follow a balanced diet to decrease the risk for weight gain.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Follow a balanced diet to decrease the risk for weight gain. Taking antidepressants is associated with weight gain."
    }
   ],
