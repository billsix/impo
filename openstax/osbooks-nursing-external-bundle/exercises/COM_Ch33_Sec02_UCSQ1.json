   "id": 447208,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Tanesha is clearly experiencing a multitude of problems. Of these, your immediate priority of care is managing her:",
   "answers": [
    {
     "id": 937104,
     "content_html": "blood glucose",
     "correctness": "0.0"
    },
    {
     "id": 937105,
     "content_html": "hypertension",
     "correctness": "0.0"
    },
    {
     "id": 937106,
     "content_html": "respiratory status",
     "correctness": "1.0"
    },
    {
     "id": 937107,
     "content_html": "mental health",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Tanesha may be developing a respiratory infection. However, managing her hypertension, blood sugar, and mental health should also be rapidly assessed. When working with communities, it is important to address their most pressing issues first. When there are many issues, it is important to identify and manage the most life-threatening conditions first."
    }
   ],
   "community_solutions": []
