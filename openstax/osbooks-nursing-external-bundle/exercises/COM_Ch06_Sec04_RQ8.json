 "questions": [
  {
   "id": 647360,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is caring for four clients in the medical-surgical inpatient unit. One is a Black woman who has been admitted with pancreatitis, another is a White man who has been admitted with acute low back pain, the third is a Black man with pneumonia, and the fourth is a White woman who has been admitted with cholecystitis. The nurse medicates the Black woman with one oral Percocet tab for 8/10 pain, medicates the White man with two oxycodone tabs for 7/10 pain, does not medicate the Black man as he does not have current pain, and medicates the White woman with 2 mg of IV morphine for 8/10 pain. What is this an example of?",
   "answers": [
    {
     "id": 1275127,
     "content_html": "Explicit racism",
     "correctness": "0.0"
    },
    {
     "id": 1275128,
     "content_html": "Implicit bias",
     "correctness": "1.0"
    },
    {
     "id": 1275126,
     "content_html": "Professional standard of care",
     "correctness": "0.0"
    },
    {
     "id": 1275125,
     "content_html": "Structural racism",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Implicit bias refers to an unconscious bias, or negative attitude against a specific individual or group based on race. It often manifests as nurses administering less pain medication to their BIPOC clients in comparison to their White clients. The nurse is treating the pain and not ignoring it but is letting the unconscious bias that Black individuals experience less pain than White individuals interfere with appropriate and equitable care."
    }
   ],
   "community_solutions": []
  }
 ],
