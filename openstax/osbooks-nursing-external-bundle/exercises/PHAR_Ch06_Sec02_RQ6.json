 "questions": [
  {
   "id": 660334,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nursing student is studying about vaccines and immunizations. The student asks the instructor to clarify the difference between a vaccine and an immunization. How should the instructor respond?",
   "answers": [
    {
     "id": 1310451,
     "content_html": "“A vaccine and an immunization are the same thing and can be used interchangeably to describe the process of protecting individuals from infectious diseases.”",
     "correctness": "0.0"
    },
    {
     "id": 1310450,
     "content_html": "“A vaccine is a preventive measure taken to minimize the risk of developing an infection, while an immunization is the body's natural ability to fight off diseases.”",
     "correctness": "0.0"
    },
    {
     "id": 1310449,
     "content_html": "“A vaccine is a weakened or killed form of a disease-causing microorganism, while an immunization is the actual infection caused by the vaccine.”",
     "correctness": "0.0"
    },
    {
     "id": 1310452,
     "content_html": "“A vaccine is a medication containing weakened or killed pathogens or antigens, given to prevent future infections, while an immunization is the process of administering the vaccine.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A vaccine is a medication containing weakened or killed pathogens or antigens, given to prevent future infections, while an immunization is the process of administering a vaccine."
    }
   ],
