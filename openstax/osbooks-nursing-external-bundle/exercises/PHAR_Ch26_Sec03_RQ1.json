 "questions": [
  {
   "id": 660536,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client is diagnosed with a hypothalamic disorder affecting the production of vasopressin. Which of the following manifestations is the nurse least likely to assess in this client?",
   "answers": [
    {
     "id": 1311260,
     "content_html": "Hypoglycemia",
     "correctness": "1.0"
    },
    {
     "id": 1311259,
     "content_html": "Polydipsia",
     "correctness": "0.0"
    },
    {
     "id": 1311258,
     "content_html": "Polyphagia",
     "correctness": "0.0"
    },
    {
     "id": 1311257,
     "content_html": "Polyuria",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A decrease in vasopressin production leads to normal glucose levels, an increased loss of water in the urine resulting in polyuria, an increased thirst (polydipsia), and an increased hunger (polyphagia)."
    }
   ],
   "community_solutions": []
  }
 ],
