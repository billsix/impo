 "questions": [
  {
   "id": 647314,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an upstream intervention that a nurse may employ to address the high rate of sedentary lifestyles in a community?",
   "answers": [
    {
     "id": 1274943,
     "content_html": "Counseling community members on the negative health effects of being sedentary",
     "correctness": "0.0"
    },
    {
     "id": 1274942,
     "content_html": "Conducting body mass index screenings during a community health fair",
     "correctness": "0.0"
    },
    {
     "id": 1274944,
     "content_html": "Obtaining funding for community walking trails",
     "correctness": "1.0"
    },
    {
     "id": 1274941,
     "content_html": "Sending mailings with exercise tips to community residents",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Upstream interventions target the root causes or sources of health issues instead of focusing on symptom management or consequences of disease. Obtaining funding for a walking trail addresses a deficit in the community that may contribute to sedentary lifestyles."
    }
   ],
   "community_solutions": []
  }
