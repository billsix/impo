   "stimulus_html": "",
   "stem_html": "Which of the following is considered a primary prevention measure to address homelessness?",
   "answers": [
    {
     "id": 1275943,
     "content_html": "Taking clinical medicine to the streets using mobile health vans",
     "correctness": "0.0"
    },
    {
     "id": 1275944,
     "content_html": "Advocating for affordable health care",
     "correctness": "1.0"
    },
    {
     "id": 1275942,
     "content_html": "Referring to social support agencies for housing assistance",
     "correctness": "0.0"
    },
    {
     "id": 1275941,
     "content_html": "Assisting with locating available shelters",
     "correctness": "0.0"
    }
