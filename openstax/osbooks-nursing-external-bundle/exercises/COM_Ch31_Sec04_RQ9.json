 "questions": [
  {
   "id": 647611,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following would alert the nurse that a client may be a victim of human trafficking?",
   "answers": [
    {
     "id": 1276131,
     "content_html": "The client can show their driver’s license.",
     "correctness": "0.0"
    },
    {
     "id": 1276130,
     "content_html": "The client gives a home address.",
     "correctness": "0.0"
    },
    {
     "id": 1276132,
     "content_html": "The adult who brought the client does not want to leave them alone with the health care staff.",
     "correctness": "1.0"
    },
    {
     "id": 1276129,
     "content_html": "The client states she is tired and hungry.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Human traffickers will attempt to keep the victims isolated and try to control their actions."
    }
   ],
   "community_solutions": []
  }
