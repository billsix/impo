 "questions": [
  {
   "id": 647398,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement by a client with a family history of diabetes indicates an understanding of the genetic component of this disorder?",
   "answers": [
    {
     "id": 1275279,
     "content_html": "“Since I have a family history of diabetes, I will also develop diabetes.”",
     "correctness": "0.0"
    },
    {
     "id": 1275280,
     "content_html": "“A family history alone does not mean I will develop diabetes.”",
     "correctness": "1.0"
    },
    {
     "id": 1275278,
     "content_html": "“Eating healthy will not prevent diabetes since it’s in my family.”",
     "correctness": "0.0"
    },
    {
     "id": 1275277,
     "content_html": "“Diabetes skips a generation, so I will not get it.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Family health history helps identify strong risk factors or predictors for acquiring certain conditions and disorders, such as diabetes. However, family history alone does not mean a person will develop a disease. Although genetic associations can be robust, genetics are still only one component in an overall health picture. As heritability and the presence of certain genes or attributes are measurable, scientists can calculate the impact of genetics versus lifestyle, social, and other factors on specific health risks."
    }
   ],
   "community_solutions": []
  }
 ],
