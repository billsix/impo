 "questions": [
  {
   "id": 660504,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which instruction should the nurse give to a client with allergic rhinitis to decrease symptoms?",
   "answers": [
    {
     "id": 1311132,
     "content_html": "“Keep a log of when symptoms occur so that triggers can be identified.”",
     "correctness": "1.0"
    },
    {
     "id": 1311131,
     "content_html": "“Call your provider for antibiotics when symptoms occur.”",
     "correctness": "0.0"
    },
    {
     "id": 1311130,
     "content_html": "“A nasal decongestant will not work for this condition.”",
     "correctness": "0.0"
    },
    {
     "id": 1311129,
     "content_html": "“Stay away from people with bacterial respiratory infections.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
