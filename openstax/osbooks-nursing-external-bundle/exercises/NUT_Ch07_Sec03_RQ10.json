  {
   "id": 660141,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with hyperthyroidism is prescribed a nutritional plan to optimize endocrine wellness. Which of the following food choices align with the recommended diet?",
   "answers": [
    {
     "id": 1309679,
     "content_html": "Canned tuna",
     "correctness": "0.0"
    },
    {
     "id": 1309678,
     "content_html": "Canned meats",
     "correctness": "0.0"
    },
    {
     "id": 1309677,
     "content_html": "Shellfish",
     "correctness": "0.0"
    },
    {
     "id": 1309680,
     "content_html": "Unsalted nuts",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Unsalted nuts do not have iodized salt, making it a low-iodine food choice. Clients with hyperthyroidism need to limit their sources of iodine."
    }
   ],
   "community_solutions": []
  }
