 "questions": [
  {
   "id": 371224,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The provider educates Harold to rinse his mouth after using the inhaler. Why does he need to rinse his mouth?",
   "answers": [
    {
     "id": 897986,
     "content_html": "To help avoid allergic reaction",
     "correctness": "0.0"
    },
    {
     "id": 897987,
     "content_html": "To get rid of the taste",
     "correctness": "0.0"
    },
    {
     "id": 897988,
     "content_html": "To help the medication absorb",
     "correctness": "0.0"
    },
    {
     "id": 897989,
     "content_html": "To help prevent candidiasis",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Corticosteroids can cause the adverse reaction of candidiasis. Rinsing the mouth helps to prevent candidiasis."
    }
   ],
   "community_solutions": []
  }
