 "questions": [
  {
   "id": 660122,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with Parkinson’s disease asks the nurse about possible benefits of intermittent fasting. Which reply would be appropriate?",
   "answers": [
    {
     "id": 1309603,
     "content_html": "“There is no clear evidence of a benefit of intermittent fasting with your condition.”",
     "correctness": "0.0"
    },
    {
     "id": 1309602,
     "content_html": "“Although evidence supports a benefit in people with epilepsy, there is no clear evidence of a benefit with Parkinson disorder.”",
     "correctness": "0.0"
    },
    {
     "id": 1309604,
     "content_html": "“Yes, there is. Let’s talk with your health care provider to see if this is right for you.”",
     "correctness": "1.0"
    },
    {
     "id": 1309601,
     "content_html": "“You will need to discuss this issue with your health care provider.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Evidence supports a cognitive benefit of intermittent fasting in Parkinson’s disease as well as epilepsy, stroke, and Alzheimer’s disease."
    }
   ],
   "community_solutions": []
