 "questions": [
  {
   "id": 660628,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with a history of narrow angle glaucoma has been prescribed solifenacin succinate for overactive bladder. The nurse should take which action regarding the medication?",
   "answers": [
    {
     "id": 1311627,
     "content_html": "Administer the medication as prescribed and monitor the client’s intraocular pressure closely",
     "correctness": "0.0"
    },
    {
     "id": 1311626,
     "content_html": "Administer a reduced dosage of the medication to prevent glaucoma exacerbation",
     "correctness": "0.0"
    },
    {
     "id": 1311628,
     "content_html": "Do not administer the medication, and notify the health care provider",
     "correctness": "1.0"
    },
    {
     "id": 1311625,
     "content_html": "Explain to the client that this medication is contraindicated in glaucoma",
     "correctness": "0.0"
    }
   ],
