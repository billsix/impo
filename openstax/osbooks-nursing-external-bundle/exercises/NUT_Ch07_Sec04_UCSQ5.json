 "questions": [
  {
   "id": 364243,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements would indicate that Meena has successfully incorporated the recommended dietary changes for her endocrine health?",
   "answers": [
    {
     "id": 881344,
     "content_html": "“I've been eating more fruits and vegetables and have reduced my intake of processed foods.”",
     "correctness": "1.0"
    },
    {
     "id": 881345,
     "content_html": "“I've started skipping breakfast to reduce my overall calorie intake.”",
     "correctness": "0.0"
    },
    {
     "id": 881346,
     "content_html": "“I only eat low-fat foods now and have completely eliminated carbohydrates from my diet.”",
     "correctness": "0.0"
    },
    {
     "id": 881347,
     "content_html": "“I drink diet soda instead of regular soda to reduce my sugar intake.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Eating more fruits and vegetables while reducing processed food intake is a positive dietary change that supports the client’s endocrine health. This statement indicates that she has successfully incorporated the recommended changes to her diet to manage her hypothyroidism and type 2 diabetes."
    }
   ],
   "community_solutions": []
  }
