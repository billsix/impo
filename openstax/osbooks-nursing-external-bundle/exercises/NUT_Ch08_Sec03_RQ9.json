 "questions": [
  {
   "id": 660151,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following instructions should the nurse include when teaching a client about levothyroxine?",
   "answers": [
    {
     "id": 1309719,
     "content_html": "“You can take this medication at any time during the day.”",
     "correctness": "0.0"
    },
    {
     "id": 1309718,
     "content_html": " “You can take this medication at the same time you take vitamins and other supplements.”",
     "correctness": "0.0"
    },
    {
     "id": 1309717,
     "content_html": "“Take this medication at the same time every day with meals.”",
     "correctness": "0.0"
    },
    {
     "id": 1309720,
     "content_html": "“Take this medication on an empty stomach.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Levothyroxine should be taken on an empty stomach and timed to avoid interaction with certain foods and supplements that can inhibit absorption."
    }
   ],
   "community_solutions": []
  }
