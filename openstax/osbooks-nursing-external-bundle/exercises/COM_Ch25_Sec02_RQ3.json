 "questions": [
  {
   "id": 647545,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by a nurse represents the practice of decolonization?",
   "answers": [
    {
     "id": 1275867,
     "content_html": "Enforcing Eurocentric ideologies to maintain cultural uniformity",
     "correctness": "0.0"
    },
    {
     "id": 1275866,
     "content_html": "Prioritizing certain cultural perspectives over others",
     "correctness": "0.0"
    },
    {
     "id": 1275868,
     "content_html": "Recognizing and challenging dominating colonial influences",
     "correctness": "1.0"
    },
    {
     "id": 1275865,
     "content_html": "Eliminating all traditional healing practices to standardize care",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Decolonization in nursing practice entails acknowledging and addressing the historical impact of colonial ideologies. It involves challenging privilege, embracing cultural humility, and promoting equitable care that respects diverse perspectives and backgrounds."
    }
   ],
   "community_solutions": []
