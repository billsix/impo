   "id": 660626,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge teaching for a client who has a new prescription for tadalafil. The nurse will caution the client about which of the following side effects?",
   "answers": [
    {
     "id": 1311619,
     "content_html": "Angioedema",
     "correctness": "0.0"
    },
    {
     "id": 1311618,
     "content_html": "Urinary urgency",
     "correctness": "0.0"
    },
    {
     "id": 1311617,
     "content_html": "Hemolytic anemia",
     "correctness": "0.0"
    },
    {
     "id": 1311620,
     "content_html": "Vasomotor response",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The vasomotor response of systemic vasodilation can occur if the client changes position rapidly, resulting in vertigo and syncope."
    }
   ],
