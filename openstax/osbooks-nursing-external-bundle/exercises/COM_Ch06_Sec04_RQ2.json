 "questions": [
  {
   "id": 647354,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of these nurse actions would be considered an example of microaggression?",
   "answers": [
    {
     "id": 1275103,
     "content_html": "Asking a transgender client their pronouns",
     "correctness": "0.0"
    },
    {
     "id": 1275104,
     "content_html": "Telling an Asian client that they speak perfect English",
     "correctness": "1.0"
    },
    {
     "id": 1275102,
     "content_html": "Determining the dietary preferences of a Jewish client",
     "correctness": "0.0"
    },
    {
     "id": 1275101,
     "content_html": "Obtaining a medical interpreter for a client who does not speak English",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Microaggressions are common, everyday slights, snubs, or insults directed toward minorities that may be intentional or not, but they communicate derogatory or negative messages to individuals based upon their minority group status, such as complimenting an Asian client on their English."
    }
   ],
   "community_solutions": []
  }
