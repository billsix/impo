 "questions": [
  {
   "id": 372062,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following strategies would be most effective when providing diet instruction to Catalina?",
   "answers": [
    {
     "id": 898318,
     "content_html": "Ask her to identify her food likes and dislikes.",
     "correctness": "1.0"
    },
    {
     "id": 898319,
     "content_html": "List the foods she must eat each week.",
     "correctness": "0.0"
    },
    {
     "id": 898320,
     "content_html": "Explain that she needs to make these changes on just a short-term basis until her anemia resolves.",
     "correctness": "0.0"
    },
    {
     "id": 898321,
     "content_html": "Explain that the iron supplement has side effects that she will have to tolerate if she is prescribed that medication.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Having the client identify their food likes and dislikes is a collaborative strategy the nurse can use to develop a diet plan. Adolescents are more likely to adhere to diet modifications if they are partners in developing their nutritional plan."
    }
   ],
   "community_solutions": []
  }
