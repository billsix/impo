 "questions": [
  {
   "id": 647441,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which environmental health activity would the nurse perform while engaged in the core public health function of assurance?",
   "answers": [
    {
     "id": 1275452,
     "content_html": "Educating the community about the need to boil contaminated drinking water",
     "correctness": "1.0"
    },
    {
     "id": 1275451,
     "content_html": "Collecting data about health issues related to contaminated drinking water",
     "correctness": "0.0"
    },
    {
     "id": 1275450,
     "content_html": "Developing polices to regulate the discharge of pollutants into the waterways",
     "correctness": "0.0"
    },
    {
     "id": 1275449,
     "content_html": "Assessing measures to reduce exposure to contaminated water",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Public health nurses perform the core functions of assessment, policy development, and assurance to serve as a framework for addressing environmental health issues and promoting healthier communities. While performing the core function of assurance, the nurse monitors and evaluates the implementation and effectiveness of environmental policies and programs and ensures that actions are taken when hazards are identified, such as educating the public about the need to boil contaminated drinking water."
    }
   ],
   "community_solutions": []
