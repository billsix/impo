   "id": 647421,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In which stage of disease progression would the nurse classify a client who has elevated blood pressure but no symptoms?",
   "answers": [
    {
     "id": 1275371,
     "content_html": "Susceptibility stage",
     "correctness": "0.0"
    },
    {
     "id": 1275372,
     "content_html": "Subclinical stage",
     "correctness": "1.0"
    },
    {
     "id": 1275370,
     "content_html": "Clinical stage",
     "correctness": "0.0"
    },
    {
     "id": 1275369,
     "content_html": "Carrier stage",
     "correctness": "0.0"
    }
   ],
   "hints": [],
