 "questions": [
  {
   "id": 647367,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community health nurse provides health care to a marginalized community. Which factor will guide the nurse’s health programming?",
   "answers": [
    {
     "id": 1275155,
     "content_html": "Most members of this community are eligible for Medicaid.",
     "correctness": "0.0"
    },
    {
     "id": 1275154,
     "content_html": "Community members are likely to seek preventative health care.",
     "correctness": "0.0"
    },
    {
     "id": 1275156,
     "content_html": "Barriers to accessing health care may be present.",
     "correctness": "1.0"
    },
    {
     "id": 1275153,
     "content_html": "Laws and policies protect the health of this community.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A marginalized community is one that is excluded from the dominant group’s cultural, economic, educational, or social life. Marginalized communities are likely to face barriers to accessing health care, such as a lack of health insurance or a paucity of health care providers within the community."
    }
   ],
   "community_solutions": []
  }
