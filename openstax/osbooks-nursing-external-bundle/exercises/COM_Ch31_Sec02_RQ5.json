 "questions": [
  {
   "id": 647607,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The community health nurse is working with a group of teenagers as part of an after-school health promotion program. When working with this age group, which of the following risk factors should the nurse be aware of?",
   "answers": [
    {
     "id": 1276115,
     "content_html": "Teenagers are more likely to be uninsured.",
     "correctness": "0.0"
    },
    {
     "id": 1276114,
     "content_html": "Teenagers are less likely to be depressed.",
     "correctness": "0.0"
    },
    {
     "id": 1276113,
     "content_html": "The risk of mental illness is the highest among this age group.",
     "correctness": "0.0"
    },
    {
     "id": 1276116,
     "content_html": "The risk of suicidal ideations is the highest among this age group.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Recent research indicates more than half of this age group experiences suicidal ideations or thoughts of self-harm."
    }
   ],
   "community_solutions": []
  }
