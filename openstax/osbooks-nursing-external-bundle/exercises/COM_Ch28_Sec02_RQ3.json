 "questions": [
  {
   "id": 647575,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to general systems theory, which of the following events represents a change in a family’s subsystem?",
   "answers": [
    {
     "id": 1275988,
     "content_html": "Two parents divorce.",
     "correctness": "1.0"
    },
    {
     "id": 1275987,
     "content_html": "One parent loses their job.",
     "correctness": "0.0"
    },
    {
     "id": 1275986,
     "content_html": "The family moves to another home.",
     "correctness": "0.0"
    },
    {
     "id": 1275985,
     "content_html": "The children start school.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "According to general systems theory, the family is one whole system comprised of subsystems where family members are connected by emotional bonds. The parents’ divorce will alter their subsystem."
    }
   ],
   "community_solutions": []
  }
