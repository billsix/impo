   "stimulus_html": "",
   "stem_html": "Which action should the nurse perform when teaching a client with LEP and who is from a culture different than their own?",
   "answers": [
    {
     "id": 1275819,
     "content_html": "Use accurate medical terms",
     "correctness": "0.0"
    },
    {
     "id": 1275818,
     "content_html": "Assume the client has basic math skills",
     "correctness": "0.0"
    },
    {
     "id": 1275820,
     "content_html": "Perform a health literacy assessment",
     "correctness": "1.0"
    },
    {
