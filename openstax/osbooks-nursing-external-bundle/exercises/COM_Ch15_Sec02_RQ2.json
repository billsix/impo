 "questions": [
  {
   "id": 647444,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Routine bloodwork results indicate that a client has type 2 diabetes. The client does not have any of the symptoms the nurse describes that are common with diabetes. The nurse assesses that this client is in which stage of disease?",
   "answers": [
    {
     "id": 1275463,
     "content_html": "Clinical",
     "correctness": "0.0"
    },
    {
     "id": 1275462,
     "content_html": "Susceptible",
     "correctness": "0.0"
    },
    {
     "id": 1275464,
     "content_html": "Subclinical",
     "correctness": "1.0"
    },
    {
     "id": 1275461,
     "content_html": "Underlying",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The subclinical stage of disease stays below the surface of clinical detection and has no recognizable clinical findings. The client has no symptoms because they are in the subclinical stage of disease."
    }
   ],
   "community_solutions": []
  }
 ],
