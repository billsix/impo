 "questions": [
  {
   "id": 647530,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action should the nurse take when teaching a client with a low health literacy level?",
   "answers": [
    {
     "id": 1275807,
     "content_html": "Use the correct medical terminology.",
     "correctness": "0.0"
    },
    {
     "id": 1275806,
     "content_html": "Speak in a loud voice.",
     "correctness": "0.0"
    },
    {
     "id": 1275808,
     "content_html": "Choose terms that the client uses.",
     "correctness": "1.0"
    },
    {
     "id": 1275805,
     "content_html": "Use verbal instruction only.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse should pay attention to and use the terms the client uses to describe illness or body parts, rather than using medical terminology. Speaking in a louder voice than normal will not help a client understand what the nurse is saying, and the client may construe this behavior as condescending. The nurse should reinforce verbal instruction with the use of pictures, models, or demonstrations."
    }
   ],
   "community_solutions": []
  }
 ],
