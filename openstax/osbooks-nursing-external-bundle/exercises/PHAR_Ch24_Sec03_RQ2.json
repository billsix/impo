 "questions": [
  {
   "id": 660521,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client taking guaifenesin informs the nurse that the medication is not helping with their cough. What further information should the nurse obtain from the client?",
   "answers": [
    {
     "id": 1311200,
     "content_html": "“Is your cough productive or nonproductive?”",
     "correctness": "1.0"
    },
    {
     "id": 1311199,
     "content_html": "“What time of day do you take the drug?”",
     "correctness": "0.0"
    },
    {
     "id": 1311198,
     "content_html": "“Have you increased the dose?”",
     "correctness": "0.0"
    },
    {
     "id": 1311197,
     "content_html": "“Why don’t you take another drug?”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Guaifenesin is indicated for nonproductive coughs. The nurse should reassess the client to determine if the cough is productive and an alternative medication should be considered."
    }
   ],
   "community_solutions": []
  }
 ],
