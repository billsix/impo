   "id": 647436,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by the nurse is an example of engaging in environmental justice?",
   "answers": [
    {
     "id": 1275431,
     "content_html": "Using the environment to assist in client recovery",
     "correctness": "0.0"
    },
    {
     "id": 1275430,
     "content_html": "Encouraging communities to engage in composting",
     "correctness": "0.0"
    },
    {
     "id": 1275432,
     "content_html": "Eliminating lead-based paint in public housing",
     "correctness": "1.0"
    },
    {
     "id": 1275429,
     "content_html": "Educating the community on proper disposal of hazardous materials",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The goals of environmental justice are to offer equal protection from hazards and to ensure equal involvement of communities in making decisions about policies and regulations that impact them. Removing lead-based paint from public housing is an example of providing equal protection regardless of socioeconomic status."
    }
   ],
