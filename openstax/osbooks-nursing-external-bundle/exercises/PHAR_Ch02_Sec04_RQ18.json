   "stimulus_html": "",
   "stem_html": "The provider ordered fluoxetine hydrochloride 60 mg oral solution for a client who has difficulty swallowing. The pharmacy supplied fluoxetine hydrochloride oral solution 20 mg/5 mL in a 120 mL bottle. How many mL should the nurse administer?",
   "answers": [
    {
     "id": 1310316,
     "content_html": "15 mL",
     "correctness": "1.0"
    },
    {
     "id": 1310315,
     "content_html": "20 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310314,
     "content_html": "30 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310313,
     "content_html": "60 mL",
     "correctness": "0.0"
    }
   ],
