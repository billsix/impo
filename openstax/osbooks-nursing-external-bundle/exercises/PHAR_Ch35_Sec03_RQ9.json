 "questions": [
  {
   "id": 660631,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is providing discharge instructions to a client who has been prescribed, concomitantly with fosfomycin, phenazopyridine hydrochloride for symptomatic relief of urinary pain and discomfort. Which statement by the client indicates a need for further education regarding the use of phenazopyridine hydrochloride?",
   "answers": [
    {
     "id": 1311639,
     "content_html": "“I should expect my urine to turn orange or reddish in color.”",
     "correctness": "0.0"
    },
    {
     "id": 1311638,
     "content_html": "“I will take this medication with meals to minimize stomach upset.”",
     "correctness": "0.0"
    },
    {
     "id": 1311637,
     "content_html": "“I understand that this medication may stain my contact lenses.”",
     "correctness": "0.0"
    },
    {
     "id": 1311640,
     "content_html": "“I will continue taking this medication until my symptoms completely resolve.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Phenazopyridine hydrochloride is intended for short-term use to alleviate urinary pain and discomfort and should not be used longer than 2 days."
    }
   ],
   "community_solutions": []
  }
 ],
