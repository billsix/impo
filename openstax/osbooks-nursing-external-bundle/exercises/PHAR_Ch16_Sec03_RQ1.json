  {
   "id": 660437,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is watching a client’s cardiac monitor. The nurse recognizes that the QRS complex represents which phase of the cardiac cycle?",
   "answers": [
    {
     "id": 1310863,
     "content_html": "Atrial depolarization",
     "correctness": "0.0"
    },
    {
     "id": 1310862,
     "content_html": "Atrial repolarization",
     "correctness": "0.0"
    },
    {
     "id": 1310864,
     "content_html": "Ventricular depolarization",
     "correctness": "1.0"
    },
    {
     "id": 1310861,
     "content_html": "Ventricular repolarization",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The QRS complex represents ventricular depolarization, which occurs as the electrical impulse moves through the ventricle to prompt contraction."
    }
   ],
   "community_solutions": []
  }
