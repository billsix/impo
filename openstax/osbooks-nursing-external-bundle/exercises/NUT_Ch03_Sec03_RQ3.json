 "questions": [
  {
   "id": 660100,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client how to read a supplement label. Which of the following statements by the client about what information can be included in a supplement label indicates additional instruction is needed?",
   "answers": [
    {
     "id": 1309515,
     "content_html": "“It will describe how the ingredients can affect my body.”",
     "correctness": "0.0"
    },
    {
     "id": 1309514,
     "content_html": "“It will list the amount of the ingredients in the supplement.”",
     "correctness": "0.0"
    },
    {
     "id": 1309513,
     "content_html": "“It will describe how much of the supplement I should take.”",
     "correctness": "0.0"
    },
    {
     "id": 1309516,
     "content_html": "“It will describe how the supplement will cure my high blood pressure.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Supplement labels are limited in the health claims they can make. They cannot mention a specific health condition."
    }
   ],
   "community_solutions": []
  }
