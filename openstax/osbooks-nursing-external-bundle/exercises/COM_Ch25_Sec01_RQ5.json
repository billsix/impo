 "questions": [
  {
   "id": 647547,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by a nurse demonstrates conscious impermeability in the continuum of developing cultural humility?",
   "answers": [
    {
     "id": 1275875,
     "content_html": "The nurse spontaneously operates from a place of cultural humility.",
     "correctness": "0.0"
    },
    {
     "id": 1275876,
     "content_html": "The nurse is aware of social inequities but struggles to demonstrate cultural humility in practice.",
     "correctness": "1.0"
    },
    {
     "id": 1275874,
     "content_html": "The nurse performs a mindful act of learning how to become culturally humble.",
     "correctness": "0.0"
    },
    {
     "id": 1275873,
     "content_html": "The nurse synergistically combines cultural competence and humility.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Conscious impermeability refers to being aware of the importance of cultural humility but facing challenges in applying it in practice. The nurse recognizes power imbalances but may struggle to demonstrate cultural humility effectively."
    }
   ],
   "community_solutions": []
  }
