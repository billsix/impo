 "questions": [
  {
   "id": 660442,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client is admitted with bradycardia detected by an ECG. Which statement describes bradycardia?",
   "answers": [
    {
     "id": 1310883,
     "content_html": "Heart rate greater than 100 beats per minute",
     "correctness": "0.0"
    },
    {
     "id": 1310882,
     "content_html": "Heart rate greater than 60 beats per minutes",
     "correctness": "0.0"
    },
    {
     "id": 1310881,
     "content_html": "Heart rate less than 100 beats per minute",
     "correctness": "0.0"
    },
    {
     "id": 1310884,
     "content_html": "Heart rate less than 60 beats per minute",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Bradycardia describes a slow heart rate (less than 60 beats per minute), and tachycardia describes a fast heart rate (faster than 100 beats per minute)."
    }
   ],
   "community_solutions": []
  }
