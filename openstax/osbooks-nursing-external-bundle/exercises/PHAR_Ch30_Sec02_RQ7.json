 "questions": [
  {
   "id": 660578,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When assessing a client who has just started taking loperamide after experiencing diarrhea for a week, which of the following findings would be most concerning? ",
   "answers": [
    {
     "id": 1311427,
     "content_html": "Nausea",
     "correctness": "0.0"
    },
    {
     "id": 1311426,
     "content_html": "Decreased appetite",
     "correctness": "0.0"
    },
    {
     "id": 1311425,
     "content_html": "Changes in stool consistency",
     "correctness": "0.0"
    },
    {
     "id": 1311428,
     "content_html": "Decreased blood pressure",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Clients with diarrhea should be assessed for signs and symptoms of dehydration, including decreased blood pressure and increased heart rate."
    }
   ],
   "community_solutions": []
  }
