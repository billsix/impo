  {
   "id": 660276,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing discharge instructions about a client’s home medications. What response should the nurse give when the client asks about the difference between buying generic versus brand-name drugs?",
   "answers": [
    {
     "id": 1310220,
     "content_html": "“Generic drugs have the same active ingredients as brand-name drugs.”",
     "correctness": "1.0"
    },
    {
     "id": 1310219,
     "content_html": "“Generic drugs undergo more rigorous testing than brand-name drugs.”",
     "correctness": "0.0"
    },
    {
     "id": 1310218,
     "content_html": "“Generic drugs are often more expensive than brand-name drugs.”",
     "correctness": "0.0"
    },
    {
     "id": 1310217,
     "content_html": "“Generic drugs are the same as over-the-counter drugs. They are not prescription drugs.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Generic drugs have the same active ingredients but may have different inactive ingredients."
    }
   ],
