   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Cholestyramine is a bile acid sequestrant available as a powder. It must be mixed with fluid prior to administration."
    }
