   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse educator is training new nurses on the cardiac step-down unit about medications administered on the unit. Which statement indicates understanding of the drug cholestyramine?",
   "answers": [
    {
     "id": 1311079,
     "content_html": "It can cause diarrhea as the major adverse effect.",
     "correctness": "0.0"
    },
    {
     "id": 1311078,
     "content_html": "It should be taken in the morning when cholesterol synthesis is highest.",
     "correctness": "0.0"
    },
    {
     "id": 1311080,
     "content_html": "It is available as an oral powder that must be mixed with fluid before taking.",
     "correctness": "1.0"
    },
    {
     "id": 1311077,
     "content_html": "It works primarily to lower triglyceride levels in clients with hypertriglyceridemia.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
