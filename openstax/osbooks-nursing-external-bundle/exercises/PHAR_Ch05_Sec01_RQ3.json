    {
     "id": 1310407,
     "content_html": "Encourage fluid intake",
     "correctness": "0.0"
    },
    {
     "id": 1310408,
     "content_html": "Administer diuretic drugs",
     "correctness": "1.0"
    },
    {
     "id": 1310406,
     "content_html": "Increase dietary sodium intake",
     "correctness": "0.0"
    },
    {
     "id": 1310405,
     "content_html": "Administer intravenous replacement fluids",
     "correctness": "0.0"
    }
