 "questions": [
  {
   "id": 660161,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Assessing a client’s readiness to learn about nutrition-related hematologic illness, utilizing a holistic approach, should include all of the following except:",
   "answers": [
    {
     "id": 1309760,
     "content_html": "Providing written materials regarding vitamin C deficiency to the client immediately before discharge",
     "correctness": "1.0"
    },
    {
     "id": 1309759,
     "content_html": "Determining the client’s preferred language for learning",
     "correctness": "0.0"
    },
    {
     "id": 1309758,
     "content_html": "Discussing the client’s preferred learning style",
     "correctness": "0.0"
    },
    {
     "id": 1309757,
     "content_html": "Delaying discharge education until the client’s significant other is present",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Providing written material before determining the client’s preferred learning style, without assessing their preference and without giving time to ask questions, is not consistent with holistic nursing care."
    }
   ],
   "community_solutions": []
  }
 ],
