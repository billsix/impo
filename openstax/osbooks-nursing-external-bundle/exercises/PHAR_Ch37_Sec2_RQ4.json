   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Hypertension is often treated with ACE inhibitors or angiotensin receptor blockers, which could cause hyperkalemia when given concomitantly with spironolactone."
    }
   ],
