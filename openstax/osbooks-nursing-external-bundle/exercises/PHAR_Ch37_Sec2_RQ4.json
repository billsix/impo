   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is assessing a client who wants to undergo male-to-female transition hormonal therapy with spironolactone. Which client condition should the nurse explore further?",
   "answers": [
    {
     "id": 1311695,
     "content_html": "Overweight",
     "correctness": "0.0"
    },
    {
     "id": 1311694,
     "content_html": "Depression",
     "correctness": "0.0"
    },
    {
     "id": 1311696,
     "content_html": "Hypertension",
     "correctness": "1.0"
    },
    {
     "id": 1311693,
     "content_html": "Asthma",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
