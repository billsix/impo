   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Environmental justice refers to the fair and equitable treatment and meaningful engagement of every individual, irrespective of race, color, national origin, or socioeconomic status, in the development, execution, and enforcement of environmental laws and policies. Nurses play a crucial role in promoting and advocating for environmental justice."
    }
