    {
     "id": 1311716,
     "content_html": "Pregnancy test",
     "correctness": "1.0"
    },
    {
     "id": 1311715,
     "content_html": "Hematocrit",
     "correctness": "0.0"
    },
    {
     "id": 1311714,
     "content_html": "Triglyceride level",
     "correctness": "0.0"
    },
    {
     "id": 1311713,
     "content_html": "Liver enzyme levels",
     "correctness": "0.0"
    }
