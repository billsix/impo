 "questions": [
  {
   "id": 447146,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The team plans to gather qualitative information from key community partners regarding the opioid crisis during the first step. Which of the following data collection strategies would be appropriate?",
   "answers": [
    {
     "id": 936856,
     "content_html": "Collecting survey responses from community members",
     "correctness": "0.0"
    },
    {
     "id": 936857,
     "content_html": "Using GIS to map incidences of opioid overdose deaths",
     "correctness": "0.0"
    },
    {
     "id": 936858,
     "content_html": "Gathering local overdose statistics to compare to national data",
     "correctness": "0.0"
    },
    {
     "id": 936859,
     "content_html": "Conducting a focus group with local emergency responders",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Focus groups gather qualitative data from participants who have experience with the topic. Participants provide their perspectives of the issue in a discussion-based setting. It would be appropriate to gather this information from local emergency responders because they have firsthand experience responding to drug overdoses. Additionally, these data are not consistently reported by methods that the team could easily access in another way."
    }
   ],
   "community_solutions": []
  }
 ],
