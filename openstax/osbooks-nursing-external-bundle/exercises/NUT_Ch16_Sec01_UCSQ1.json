  {
   "id": 372379,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse caring for Kayla is reviewing her nutritional plan, which is based on the highest normal calorie range daily for a preterm infant. How many calories daily should Kayla receive to meet her nutritional needs?",
   "answers": [
    {
     "id": 898446,
     "content_html": "130 calories",
     "correctness": "1.0"
    },
    {
     "id": 898447,
     "content_html": "270 calories",
     "correctness": "0.0"
    },
    {
     "id": 898448,
     "content_html": "2,700 calories",
     "correctness": "0.0"
    },
    {
     "id": 898449,
     "content_html": "4,000 calories",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "130 kcal/kg/day is the highest daily recommended amount for a preterm infant. 130 × 1 kg = 130 calories daily"
    }
   ],
   "community_solutions": []
  }
