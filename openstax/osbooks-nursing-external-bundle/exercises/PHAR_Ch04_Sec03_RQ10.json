 "questions": [
  {
   "id": 660320,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the concept of osmotic equilibrium in the body?",
   "answers": [
    {
     "id": 1310395,
     "content_html": "The balance of water and electrolytes in the body",
     "correctness": "0.0"
    },
    {
     "id": 1310396,
     "content_html": "The balance of water and solutes across a semipermeable membrane",
     "correctness": "1.0"
    },
    {
     "id": 1310394,
     "content_html": "The balance of ions in the body’s extracellular and intracellular fluid compartments",
     "correctness": "0.0"
    },
    {
     "id": 1310393,
     "content_html": "The balance of acids and bases in the body’s fluid",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Osmotic equilibrium is the state in which the concentration of solutes is equal on both sides of a semipermeable membrane and there is no net movement of water across the membrane."
    }
   ],
   "community_solutions": []
