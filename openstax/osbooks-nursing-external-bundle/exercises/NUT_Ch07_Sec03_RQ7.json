 "questions": [
  {
   "id": 660139,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with newly diagnosed diabetes presents for education on dietary modifications. Which of the following is an appropriate method for the nurse to assess the client's readiness to learn?",
   "answers": [
    {
     "id": 1309671,
     "content_html": "Ask the client to recite the appropriate dietary modifications for diabetes.",
     "correctness": "0.0"
    },
    {
     "id": 1309672,
     "content_html": "Ask the client about their prior knowledge of diabetes and dietary modifications.",
     "correctness": "1.0"
    },
    {
     "id": 1309670,
     "content_html": "Provide the client with written materials on diabetes and dietary modifications.",
     "correctness": "0.0"
    },
    {
     "id": 1309669,
     "content_html": "Ask the client to demonstrate how to administer insulin.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Assessing a client's prior knowledge of a condition and associated interventions is an appropriate method to determine their readiness to learn."
    }
   ],
