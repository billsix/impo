 "questions": [
  {
   "id": 647537,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by a nurse working at a community health center is an example of using the ACCESS model of transcultural care?",
   "answers": [
    {
     "id": 1275835,
     "content_html": "Utilizing a standardized plan of care",
     "correctness": "0.0"
    },
    {
     "id": 1275836,
     "content_html": "Developing the plan of care with the client",
     "correctness": "1.0"
    },
    {
     "id": 1275834,
     "content_html": "Using a plan of care developed for a specific cultural group",
     "correctness": "0.0"
    },
    {
     "id": 1275833,
     "content_html": "Collaborating with other nurses to develop the plan of care",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The ACCESS model consists of six key components: assessment, communication, cultural negotiation and compromise, establishing respect and rapport, sensitivity, and safety. In this model, the nurse tailors the plan of care so it is respectful of the client’s beliefs and values. This is accomplished by developing the plan of care with the client."
    }
   ],
   "community_solutions": []
  }
