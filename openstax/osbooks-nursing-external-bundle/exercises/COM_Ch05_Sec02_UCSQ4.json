 "questions": [
  {
   "id": 447074,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on the nurse’s experience working with vulnerable populations, which of the following is the best approach for ensuring that Jose takes the new medication as prescribed?",
   "answers": [
    {
     "id": 936568,
     "content_html": "Explain to Jose and his family the benefits of the new medication.",
     "correctness": "0.0"
    },
    {
     "id": 936569,
     "content_html": "Explain to Jose and his family the risks of not taking the new medication.",
     "correctness": "0.0"
    },
    {
     "id": 936570,
     "content_html": "Develop a plan for Jose to manage any adverse drug effects.",
     "correctness": "0.0"
    },
    {
     "id": 936571,
     "content_html": "Connect Jose with resources so that he can get the medication at minimal to no cost.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Frequently clients do not take medications as prescribed due to costs. In this situation, with a client who has lost his job and has limited financial resources, the most effective strategy to encourage him to take the medication to make sure he can afford it."
    }
   ],
   "community_solutions": []
  }
 ],
