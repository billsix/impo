 "questions": [
  {
   "id": 412179,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How can Jose’s employment status potentially affect his health?",
   "answers": [
    {
     "id": 925699,
     "content_html": "He will be covered by Medicaid, so there should be no long-term effects.",
     "correctness": "0.0"
    },
    {
     "id": 925700,
     "content_html": "He can continue to receive health care in the local emergency department.",
     "correctness": "0.0"
    },
    {
     "id": 925701,
     "content_html": "He is more likely to be affected by a health disparity.",
     "correctness": "1.0"
    },
    {
     "id": 925702,
     "content_html": "His temporary unemployment status should not permanently affect his health.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Jose’s unstable financial situation makes it likely he will experience a health disparity or a preventable difference in disease experienced by members of a vulnerable population."
    }
   ],
   "community_solutions": []
  }
 ],
