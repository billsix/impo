 "questions": [
  {
   "id": 660449,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client is discussing chronic medication options to treat their atrial fibrillation with rapid ventricular response. The client prefers to avoid hospitalization overnight for initiation. Which of the following medications would be the best option?",
   "answers": [
    {
     "id": 1310911,
     "content_html": "Dofetilide",
     "correctness": "0.0"
    },
    {
     "id": 1310912,
     "content_html": "Metoprolol tartrate",
     "correctness": "1.0"
    },
    {
     "id": 1310910,
     "content_html": "Sotalol",
     "correctness": "0.0"
    },
    {
     "id": 1310909,
     "content_html": "Mexiletine",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Metoprolol tartrate does not require inpatient initiation. Dofetilide and sotalol require inpatient initiation. Mexiletine is used for ventricular arrhythmias."
    }
   ],
   "community_solutions": []
  }
