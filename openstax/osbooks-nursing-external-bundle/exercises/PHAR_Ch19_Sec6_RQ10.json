 "questions": [
  {
   "id": 660472,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is providing education to a client who has a new prescription for ivabradine. The nurse knows the client has understood the instructions when the client makes which statement?",
   "answers": [
    {
     "id": 1311003,
     "content_html": "“I will stop eating green, leafy vegetables.”",
     "correctness": "0.0"
    },
    {
     "id": 1311004,
     "content_html": "“I will stop drinking grapefruit juice.”",
     "correctness": "1.0"
    },
    {
     "id": 1311002,
     "content_html": "“I will take my blood pressure right before I take this medication.”",
     "correctness": "0.0"
    },
    {
     "id": 1311001,
     "content_html": "“I will take this medication right before I go to bed.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Ivabradine is an I(f) current inhibitor. Grapefruit juice increases blood levels of ivabradine by inhibiting its metabolism. The excess amount of medication can intensify the medication’s hypotensive effect, placing the client at an increased risk for syncopal episodes."
    }
   ],
   "community_solutions": []
  }
 ],
