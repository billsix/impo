 "questions": [
  {
   "id": 647555,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which health promotion intervention should the community health nurse teach to new parents to reduce the risk of sudden unexpected infant death (SUID)?",
   "answers": [
    {
     "id": 1275908,
     "content_html": "Place the baby on a firm sleep surface",
     "correctness": "1.0"
    },
    {
     "id": 1275907,
     "content_html": "Put the baby in the same bed as the parents",
     "correctness": "0.0"
    },
    {
     "id": 1275906,
     "content_html": "Use extra blankets in the crib during sleep",
     "correctness": "0.0"
    },
    {
     "id": 1275905,
     "content_html": "Position the baby on the stomach",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "To prevent SUID, the nurse teaches parents to place the baby on their back on a firm sleep surface that is free from pillows, blankets, or other soft bedding."
    }
   ],
   "community_solutions": []
  }
 ],
