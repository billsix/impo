 "questions": [
  {
   "id": 660282,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 79-year-old client with hypertension has been prescribed a medication to lower blood pressure. Which action should the nurse take <em>first</em>?",
   "answers": [
    {
     "id": 1310243,
     "content_html": "Ensure the client understands the purpose of each drug, expected effects, and potential adverse effects.",
     "correctness": "0.0"
    },
    {
     "id": 1310244,
     "content_html": "Take a complete drug history and verify compliance.",
     "correctness": "1.0"
    },
    {
     "id": 1310242,
     "content_html": "Check the drugs for potential interactions because the client sees multiple providers.",
     "correctness": "0.0"
    },
    {
     "id": 1310241,
     "content_html": "Inform the client of potential resources to assist them in remembering their medications.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The first action by the nurse should be to assess the client’s medication history and whether or not the client is taking the medications as prescribed. All other actions will be performed, but the assessment should be completed first."
    }
   ],
   "community_solutions": []
  }
 ],
