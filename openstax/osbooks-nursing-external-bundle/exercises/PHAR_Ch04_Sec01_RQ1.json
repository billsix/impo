   "stimulus_html": "",
   "stem_html": "A nurse is preparing to teach a client about temperature regulation and homeostasis. Which statement should the nurse include in the teaching plan?",
   "answers": [
    {
     "id": 1310367,
     "content_html": "Homeostasis makes your blood pressure rise when you experience stress.",
     "correctness": "0.0"
    },
    {
     "id": 1310368,
     "content_html": "Homeostasis allows you to maintain a stable body temperature despite the outside temperature.",
     "correctness": "1.0"
    },
    {
     "id": 1310366,
     "content_html": "Homeostasis is solely under the control of your brain and nervous system.",
     "correctness": "0.0",
     "feedback_html": ""
    },
    {
