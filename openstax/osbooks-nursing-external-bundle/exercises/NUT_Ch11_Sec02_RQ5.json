   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse in the outpatient cardiology clinic is assessing a client who had an acute myocardial infarction 6 months ago and has completed an outpatient cardiac rehabilitation program. Which cholesterol level indicates to the nurse that the client has achieved a desired level?",
   "answers": [
    {
     "id": 1309835,
     "content_html": "Total cholesterol 202 mg/dL",
     "correctness": "0.0"
    },
    {
     "id": 1309834,
     "content_html": "LDL 130 mg/dL",
     "correctness": "0.0"
    },
    {
     "id": 1309836,
     "content_html": "HDL 48 mg/dL",
     "correctness": "1.0"
    },
    {
     "id": 1309833,
     "content_html": "Triglycerides 242 mg/dL",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The HDL level of 48 mg/dL falls within the normal range of greater than 40 mg/dL."
    }
   ],
