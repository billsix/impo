 "questions": [
  {
   "id": 660400,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is caring for a client who is receiving mannitol. Which of the following interventions should the nurse provide for the client?",
   "answers": [
    {
     "id": 1310716,
     "content_html": "Elevate the head of the bed to 30 degrees and keep the client’s head at a neutral position.",
     "correctness": "1.0"
    },
    {
     "id": 1310715,
     "content_html": "Place the client in a supine position with the head turned to the right side.",
     "correctness": "0.0"
    },
    {
     "id": 1310714,
     "content_html": "Elevate the head of the bed 90 degrees and keep the client’s head at a neutral position.",
     "correctness": "0.0"
    },
    {
     "id": 1310713,
     "content_html": "Place the client in a supine position with the head turned to the left side.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Mannitol is administered for cerebral edema and increased intracranial pressure. Elevating the head of the bed to a 30-degree angle and keeping the client’s head in a neutral position helps to decrease intracranial pressure."
    }
   ],
   "community_solutions": []
  }
 ],
