 "questions": [
  {
   "id": 647451,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A densely populated urban area has a high prevalence of obesity among the residents. The local government is partnering with the health department to build parks and recreation centers to promote physical activity. Which of the following is the most likely system-related barrier  the program faces?",
   "answers": [
    {
     "id": 1275491,
     "content_html": "Genetic predisposition to obesity",
     "correctness": "0.0"
    },
    {
     "id": 1275490,
     "content_html": "Lack of community engagement",
     "correctness": "0.0"
    },
    {
     "id": 1275489,
     "content_html": "Individual client attitudes and beliefs",
     "correctness": "0.0"
    },
    {
     "id": 1275492,
     "content_html": "Limited financial resources",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A lack of financial resources is a common barrier that arises from the health care system itself. The other three options are not system-related barriers."
    }
   ],
   "community_solutions": []
  }
 ],
