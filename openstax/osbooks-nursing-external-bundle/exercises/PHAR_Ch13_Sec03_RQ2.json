 "questions": [
  {
   "id": 660409,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with bipolar disorder has a subtherapeutic lithium level. What will the nurse expect to assess in this client?",
   "answers": [
    {
     "id": 1310751,
     "content_html": "A decrease in impulsivity and hyperactivity",
     "correctness": "0.0"
    },
    {
     "id": 1310752,
     "content_html": "Rapid, pressured speech along with interrupting others",
     "correctness": "1.0"
    },
    {
     "id": 1310750,
     "content_html": "Sleeping 6–8 consecutive hours per night",
     "correctness": "0.0"
    },
    {
     "id": 1310749,
     "content_html": "Ability to sit down and eat a well-balanced meal",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Rapid, pressured speech is a classic sign of mania. If the drug level is considered subtherapeutic, this means it is not working favorably. The other options indicate the manic behavior is being well managed."
    }
   ],
   "community_solutions": []
  }
