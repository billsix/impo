   "stimulus_html": "",
   "stem_html": "What information is important for the nurse to recognize about the Health Insurance Portability and Accountability Act (HIPAA)?",
   "answers": [
    {
     "id": 1310327,
     "content_html": "Client outcomes can be improved through the use of quality measures.",
     "correctness": "0.0"
    },
    {
     "id": 1310326,
     "content_html": "Nurses are mandated to use the electronic health record in a meaningful way.",
     "correctness": "0.0"
    },
    {
     "id": 1310328,
     "content_html": "Personal health information (PHI) should not be disclosed except on a need-to-know basis.",
     "correctness": "1.0"
    },
    {
     "id": 1310325,
     "content_html": "This act expanded the Medicaid program by raising the federal poverty level.",
