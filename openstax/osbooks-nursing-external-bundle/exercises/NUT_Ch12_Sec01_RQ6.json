 "questions": [
  {
   "id": 660187,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A teenager comes to the clinic with her parents for concerns about eating disorders. Which long-term complication is associated with eating disorders?",
   "answers": [
    {
     "id": 1309863,
     "content_html": "Aortic stenosis",
     "correctness": "0.0"
    },
    {
     "id": 1309862,
     "content_html": "Diverticulitis",
     "correctness": "0.0"
    },
    {
     "id": 1309864,
     "content_html": "Hypokalemia and hyponatremia",
     "correctness": "1.0"
    },
    {
     "id": 1309861,
     "content_html": "Rheumatoid arthritis",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Long-term complications of eating disorders cause electrolyte imbalances, prolong QT intervals, which can cause arrhythmias, and can eventually lead to heart failure due to the stress on the heart."
    }
   ],
   "community_solutions": []
  }
