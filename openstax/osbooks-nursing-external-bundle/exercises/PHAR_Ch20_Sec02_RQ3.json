 "questions": [
  {
   "id": 660476,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is answering the client’s question about the risk for heparin-induced thrombocytopenia (HIT). Which of the following information should be included in the discussion?",
   "answers": [
    {
     "id": 1311019,
     "content_html": "The condition increases the risk for bleeding.",
     "correctness": "0.0"
    },
    {
     "id": 1311018,
     "content_html": "The platelet count rises above normal initially.",
     "correctness": "0.0"
    },
    {
     "id": 1311020,
     "content_html": "The condition is immune mediated.",
     "correctness": "1.0"
    },
    {
     "id": 1311017,
     "content_html": "The skin rash is the most reliable diagnostic indicator.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The antibodies decrease the platelet count, leaving the client at risk for the development of thrombosis."
    }
   ],
