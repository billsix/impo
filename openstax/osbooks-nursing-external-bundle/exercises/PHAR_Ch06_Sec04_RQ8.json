  {
   "id": 660342,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with gout is prescribed an antigout drug to manage gout attacks. The nurse should advise the client to limit the daily intake of which food while on this medication?",
   "answers": [
    {
     "id": 1310484,
     "content_html": "Red meat",
     "correctness": "1.0"
    },
    {
     "id": 1310483,
     "content_html": "Dairy products",
     "correctness": "0.0"
    },
    {
     "id": 1310482,
     "content_html": "Fresh strawberries",
     "correctness": "0.0"
    },
    {
     "id": 1310481,
     "content_html": "Green, leafy vegetables",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Red meat is high in purines, which can increase uric acid levels and exacerbate gout symptoms."
    }
   ],
   "community_solutions": []
  }
