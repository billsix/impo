   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which goal would a nurse utilize when developing a program to improve care for vulnerable populations based on the Future of Nursing Report 2020–2030?",
   "answers": [
    {
     "id": 1276199,
     "content_html": "Provide scholarships for student nurses to improve diversity",
     "correctness": "0.0"
    },
    {
     "id": 1276198,
     "content_html": "Increase the number and quality of shelters for the homeless",
     "correctness": "0.0"
    },
    {
     "id": 1276200,
     "content_html": "Improve quality of life and prevent disease, injury, disability, and premature death",
     "correctness": "1.0"
    },
    {
     "id": 1276197,
     "content_html": "Increase clinical hours for nurses obtaining advanced degrees",
     "correctness": "0.0"
    }
