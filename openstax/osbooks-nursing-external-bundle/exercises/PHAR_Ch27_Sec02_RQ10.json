   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with hyperthyroidism has an order for methimazole 15 mg orally daily, in three divided doses. How many milligrams will the nurse administer for each dose?",
   "answers": [
    {
     "id": 1311319,
     "content_html": "3 mg",
     "correctness": "0.0"
    },
    {
     "id": 1311320,
     "content_html": "5 mg",
     "correctness": "1.0"
    },
    {
     "id": 1311318,
     "content_html": "7.5 mg",
     "correctness": "0.0"
    },
    {
     "id": 1311317,
     "content_html": "10 mg",
     "correctness": "0.0"
    }
   ],
