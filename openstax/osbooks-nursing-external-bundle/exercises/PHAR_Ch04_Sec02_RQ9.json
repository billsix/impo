  {
   "id": 660318,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with a fluid imbalance. Which statement accurately describes the distribution of intracellular (ICF) and extracellular fluid (ECF) in the body?",
   "answers": [
    {
     "id": 1310388,
     "content_html": "The ICF constitutes approximately 40% of total body fluid, and ECF accounts for 20%.",
     "correctness": "1.0"
    },
    {
     "id": 1310387,
     "content_html": "The ICF constitutes approximately 40% of total body fluid, and ECF accounts for 60%.",
     "correctness": "0.0"
    },
    {
     "id": 1310386,
     "content_html": "The ICF constitutes approximately 20% of total body fluid, and ECF accounts for 80%.",
     "correctness": "0.0"
    },
    {
     "id": 1310385,
     "content_html": "The ICF constitutes approximately 80% of total body fluid, and ECF accounts for 20%.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Approximately 40% of the body’s fluid is distributed within the cells (ICF), and the remaining 20% is distributed in the ECF."
    }
   ],
