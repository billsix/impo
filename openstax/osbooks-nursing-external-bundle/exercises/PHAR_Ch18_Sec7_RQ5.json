 "questions": [
  {
   "id": 660462,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with newly diagnosed stable angina is prescribed transdermal nitroglycerin. Which instruction should the nurse include in client teaching?",
   "answers": [
    {
     "id": 1310963,
     "content_html": "Apply to the same area of the body every day.",
     "correctness": "0.0"
    },
    {
     "id": 1310962,
     "content_html": "Apply a new patch at the onset of chest pain.",
     "correctness": "0.0"
    },
    {
     "id": 1310961,
     "content_html": "Apply a new patch after showering while skin is still moist.",
     "correctness": "0.0"
    },
    {
     "id": 1310964,
     "content_html": "Apply the patch for 12–14 hours and then remove for 10–12 hours.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Transdermal nitroglycerin is prescribed as a maintenance medication for stable angina, which takes 30–60 minutes for therapeutic effects to begin. The patch should be applied around the same time every day and worn for 12–14 hours and then removed for 10–12 hours to avoid client tolerance."
    }
   ],
   "community_solutions": []
  }
 ],
