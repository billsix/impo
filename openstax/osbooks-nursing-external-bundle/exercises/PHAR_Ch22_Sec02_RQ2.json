  {
   "id": 660494,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse has administered sublingual nitroglycerin to a client with chest pain. Which assessment finding does the nurse anticipate for this client?",
   "answers": [
    {
     "id": 1311091,
     "content_html": "An increase in respiratory rate",
     "correctness": "0.0"
    },
    {
     "id": 1311090,
     "content_html": "An increase in heart rate",
     "correctness": "0.0"
    },
    {
     "id": 1311092,
     "content_html": "A decrease in blood pressure",
     "correctness": "1.0"
    },
    {
     "id": 1311089,
     "content_html": "A decrease in oxygen saturation",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Nitroglycerin is a vasodilator, and vasodilation causes the blood pressure to drop."
    }
