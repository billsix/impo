 "questions": [
  {
   "id": 660541,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client is being discharged on a glucocorticosteroid drug for a flare-up of rheumatoid arthritis. Which instruction should the nurse give to the client?",
   "answers": [
    {
     "id": 1311279,
     "content_html": "Stop the medication when symptoms subside.",
     "correctness": "0.0"
    },
    {
     "id": 1311280,
     "content_html": "Taper the medication as directed.",
     "correctness": "1.0"
    },
    {
     "id": 1311278,
     "content_html": "Take the medication, as needed, for joint pain.",
     "correctness": "0.0"
    },
    {
     "id": 1311277,
     "content_html": "Increase the dose each day until pain is relieved.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Glucocorticoid medications require a tapering dose to allow the adrenal glands to resume their normal function."
    }
   ],
