 "questions": [
  {
   "id": 660436,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The left ventricle pumps blood from the heart to the aorta for use by the body. Which of the following processes occurs nearly simultaneously with left ventricular systole?",
   "answers": [
    {
     "id": 1310859,
     "content_html": "Right atrial systole",
     "correctness": "0.0"
    },
    {
     "id": 1310860,
     "content_html": "Right ventricular systole",
     "correctness": "1.0"
    },
    {
     "id": 1310858,
     "content_html": "Right ventricular diastole",
     "correctness": "0.0"
    },
    {
     "id": 1310857,
     "content_html": "Excitation of the sinoatrial node",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Both ventricles pump nearly simultaneously (ventricular systole). While the ventricles are pumping, both of the atria are filling (atrial diastole). The atria do not pump simultaneously with the ventricles."
    }
   ],
   "community_solutions": []
  }
 ],
