 "questions": [
  {
   "id": 647326,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following accurately describes public health nursing practice?",
   "answers": [
    {
     "id": 1274991,
     "content_html": "The scope of practice for public health nurses is broader than that of a registered nurse.",
     "correctness": "0.0"
    },
    {
     "id": 1274992,
     "content_html": "The ANA has identified nine core concepts for public health nursing.",
     "correctness": "1.0"
    },
    {
     "id": 1274990,
     "content_html": "Public health nurses practice using standards developed for medicine.",
     "correctness": "0.0"
    },
    {
     "id": 1274989,
     "content_html": "The ANA has not identified a scope of practice for public health nursing.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The ANA has identified nine core concepts of practice based on the dynamic and complex work of public health nursing: social determinants of health, community collaboration, population health, ecological model of health, culturally congruent practice, levels of prevention, ethics, social justice, and health equity."
    }
   ],
