 "questions": [
  {
   "id": 660212,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is instructing a client on long-term oxygen therapy at home on the role of nutrition in managing the client’s condition. Which of the following statements by the client indicates the client understands the instruction?",
   "answers": [
    {
     "id": 1309964,
     "content_html": "“I know my GI tract is not getting as much oxygen as it used to, so I need to make sure I get enough vitamins and minerals in my body.”",
     "correctness": "1.0"
    },
    {
     "id": 1309963,
     "content_html": "“I need to eat whatever I feel like I can – calories are the most important thing.”",
     "correctness": "0.0"
    },
    {
     "id": 1309962,
     "content_html": "“I need to eat as much protein as possible.”",
     "correctness": "0.0"
    },
    {
     "id": 1309961,
     "content_html": "“I need to try to avoid foods high in calcium as these can affect my condition.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Long-term oxygen therapy in COPD clients causes nutritional deficiencies, because low oxygenation to the gastrointestinal tract decreases its ability to function and absorb nutrients."
    }
   ],
   "community_solutions": []
  }
 ],
