 "questions": [
  {
   "id": 647459,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to the Robert Wood Johnson Foundation’s Culture of Health Action Framework, which action is a driver of change in making health a shared value?",
   "answers": [
    {
     "id": 1275523,
     "content_html": "Increasing partnerships between hospitals",
     "correctness": "0.0"
    },
    {
     "id": 1275522,
     "content_html": "Supporting working parents",
     "correctness": "0.0"
    },
    {
     "id": 1275521,
     "content_html": "Providing access to routine dental and vision care",
     "correctness": "0.0"
    },
    {
     "id": 1275524,
     "content_html": "Changing the mindset and expectations of a community",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Making health a shared value requires society as a whole to commit to developing power structures and social systems that allow access to health for all. The mindset and expectations, sense of community, and civic engagement of a community are all drivers of change toward making health a shared value."
    }
   ],
   "community_solutions": []
