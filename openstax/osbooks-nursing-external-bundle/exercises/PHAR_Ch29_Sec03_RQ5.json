 "questions": [
  {
   "id": 660569,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is preparing a client for discharge following a small bowel resection because of cancer. Which instruction should the nurse include in the discharge education?",
   "answers": [
    {
     "id": 1311392,
     "content_html": "Take daily liquid vitamin and mineral supplements.",
     "correctness": "1.0"
    },
    {
     "id": 1311391,
     "content_html": "Limit daily fluid intake.",
     "correctness": "0.0"
    },
    {
     "id": 1311390,
     "content_html": "Avoid starchy foods.",
     "correctness": "0.0"
    },
    {
     "id": 1311389,
     "content_html": "Take a laxative for constipation.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because the small intestine is responsible for absorbing nutrients, the client will need vitamin and mineral supplements."
    }
   ],
   "community_solutions": []
  }
