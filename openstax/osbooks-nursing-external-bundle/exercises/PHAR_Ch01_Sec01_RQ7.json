 "questions": [
  {
   "id": 660273,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a group of nursing students about the importance of interprofessional (IP) collaboration. What is an advantage of IP teamwork?",
   "answers": [
    {
     "id": 1310207,
     "content_html": "Decreased need for research into the client’s disease process and treatment",
     "correctness": "0.0"
    },
    {
     "id": 1310208,
     "content_html": "Improved client safety due to the use of each discipline’s area of expertise",
     "correctness": "1.0"
    },
    {
     "id": 1310206,
     "content_html": "Increased cost of hospitalization due to the number of hospital workers involved",
     "correctness": "0.0"
    },
    {
     "id": 1310205,
     "content_html": "Decreased responsibility because other team members are assisting with coordinating care",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "IP collaboration has many advantages, including decreased hospitalization costs, improved client safety, and improved communication regarding team goals."
    }
   ],
   "community_solutions": []
  }
