 "questions": [
  {
   "id": 660213,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse provides dietary instruction to a client with kidney disease. The nurse informs the client which nutrient is not directly absorbed by the kidney?",
   "answers": [
    {
     "id": 1309968,
     "content_html": "Calcium",
     "correctness": "1.0"
    },
    {
     "id": 1309967,
     "content_html": "Sodium",
     "correctness": "0.0"
    },
    {
     "id": 1309966,
     "content_html": "Magnesium",
     "correctness": "0.0"
    },
    {
     "id": 1309965,
     "content_html": "Potassium",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Calcium levels are affected by the kidney through its relationship with the parathyroid gland and the production of calcitriol, but not from direct reabsorption."
    }
   ],
   "community_solutions": []
  }
