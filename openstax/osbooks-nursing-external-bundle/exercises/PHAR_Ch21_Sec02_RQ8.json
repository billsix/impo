 "questions": [
  {
   "id": 660486,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is true about pravastatin?",
   "answers": [
    {
     "id": 1311060,
     "content_html": "It is considered a hydrophilic statin, which means it may confer a lower risk of myalgia compared with other statins.",
     "correctness": "1.0"
    },
    {
     "id": 1311059,
     "content_html": "The FDA has issued a statement that doses of 80 mg are no longer appropriate due to myalgia risk.",
     "correctness": "0.0"
    },
    {
     "id": 1311058,
     "content_html": "It is metabolized by CYP3A4 and is subject to many drug interactions.",
     "correctness": "0.0"
    },
    {
     "id": 1311057,
     "content_html": "It is considered a high-intensity statin.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Pravastatin is considered a hydrophilic statin. It can less easily enter the muscle, which may confer a lower risk of myalgia."
    }
