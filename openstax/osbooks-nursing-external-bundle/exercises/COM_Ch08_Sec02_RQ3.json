 "questions": [
  {
   "id": 647375,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following neighborhood factors is considered an adverse childhood experience?",
   "answers": [
    {
     "id": 1275187,
     "content_html": "Absence of sidewalks to walk to school safely",
     "correctness": "0.0"
    },
    {
     "id": 1275186,
     "content_html": "Access to green spaces",
     "correctness": "0.0"
    },
    {
     "id": 1275185,
     "content_html": "Relying on readily accessible public transportation",
     "correctness": "0.0"
    },
    {
     "id": 1275188,
     "content_html": "Exposure to crime and violence",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Exposure to crime and violence is an adverse childhood experience, as it is a traumatic event that undermines a child’s sense of safety, security, and bonding."
    }
   ],
