   "id": 660123,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing dietary instruction to a client who is in the first trimester of pregnancy. Consuming which of the following foods should the client prioritize to facilitate fetal neurological development?",
   "answers": [
    {
     "id": 1309607,
     "content_html": "Apples and grapes",
     "correctness": "0.0"
    },
    {
     "id": 1309606,
     "content_html": "Whole wheat bread",
     "correctness": "0.0"
    },
    {
     "id": 1309605,
     "content_html": "Fruit juice",
     "correctness": "0.0"
    },
    {
     "id": 1309608,
     "content_html": "Chicken and lentils",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Chicken and lentils are two sources of protein; 71 g of protein a day is often recommended during the first trimester of pregnancy to promote fetal neurological development."
    }
   ],
   "community_solutions": []
