   "stimulus_html": "",
   "stem_html": "A client is taking prednisolone drops for uveitis. Which condition that can occur with prolonged use should the nurse warn the client about?",
   "answers": [
    {
     "id": 1311747,
     "content_html": "Blepharitis",
     "correctness": "0.0"
    },
    {
     "id": 1311746,
     "content_html": "Conjunctivitis",
     "correctness": "0.0"
    },
    {
     "id": 1311745,
     "content_html": "Chalazion",
     "correctness": "0.0"
    },
    {
     "id": 1311748,
     "content_html": "Cataracts",
     "correctness": "1.0"
    }
