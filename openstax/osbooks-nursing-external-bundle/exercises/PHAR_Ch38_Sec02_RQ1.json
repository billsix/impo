   "stem_html": "Which teaching point should the nurse include when educating clients about the administration of trifluridine?",
   "answers": [
    {
     "id": 1311736,
     "content_html": "“Wear gloves when handling and instilling this medication.”",
     "correctness": "1.0"
    },
    {
     "id": 1311735,
     "content_html": "“This drug is absorbed into the body and causes many adverse effects.”",
     "correctness": "0.0"
    },
    {
     "id": 1311734,
     "content_html": "“Instill the medication by pulling the upper lid toward the forehead.”",
     "correctness": "0.0"
    },
    {
     "id": 1311733,
     "content_html": "“This drug is effective against both bacterial and viral infections.”",
     "correctness": "0.0"
