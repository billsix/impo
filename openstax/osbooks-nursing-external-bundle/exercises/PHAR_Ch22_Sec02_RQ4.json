 "questions": [
  {
   "id": 660496,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which question should the nurse ask a client before administering nitroglycerin for chest pain?",
   "answers": [
    {
     "id": 1311099,
     "content_html": "Do you have lupus erythematosus?",
     "correctness": "0.0"
    },
    {
     "id": 1311098,
     "content_html": "Do you have a history of asthma?",
     "correctness": "0.0"
    },
    {
     "id": 1311100,
     "content_html": "Do you take any medications for erectile dysfunction?",
     "correctness": "1.0"
    },
    {
     "id": 1311097,
     "content_html": "Do you have Wolff–Parkinson–White syndrome?",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse should ask whether the client is taking any medications for erectile dysfunction because the use of nitroglycerin is contraindicated in clients who are taking a phosphodiesterase inhibitor such as tadalafil or sildenafil."
    }
   ],
   "community_solutions": []
  }
 ],
