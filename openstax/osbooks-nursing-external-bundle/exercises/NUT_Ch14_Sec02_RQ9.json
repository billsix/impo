 "questions": [
  {
   "id": 660210,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the goal of an anti-inflammatory diet for clients with RTI and pneumonia?",
   "answers": [
    {
     "id": 1309955,
     "content_html": "To limit the immune system’s response",
     "correctness": "0.0"
    },
    {
     "id": 1309954,
     "content_html": "To increase the immune system’s response",
     "correctness": "0.0"
    },
    {
     "id": 1309953,
     "content_html": "To decrease lung function and reduce coughing",
     "correctness": "0.0"
    },
    {
     "id": 1309956,
     "content_html": "To minimize the duration of and decrease the risk for infections",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The main goal of an anti-inflammatory diet is to minimize the duration of and decrease the risk for infection. An anti-inflammatory diet supports the immune system and lung function and decreases oxidation."
    }
   ],
   "community_solutions": []
  }
 ],
