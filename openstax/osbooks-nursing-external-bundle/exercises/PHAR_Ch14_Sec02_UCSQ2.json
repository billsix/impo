 "questions": [
  {
   "id": 451010,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse determines that the client is taking 2 or 3 200 mg tablets nine times daily to control her arthritic pain. Which instruction should the nurse give the client?",
   "answers": [
    {
     "id": 943924,
     "content_html": "“This dose is too low to effectively relieve arthritis pain.”",
     "correctness": "0.0"
    },
    {
     "id": 943925,
     "content_html": "“This dose is appropriate for arthritis pain.”",
     "correctness": "0.0"
    },
    {
     "id": 943926,
     "content_html": "“This dose may cause respiratory depression.”",
     "correctness": "0.0"
    },
    {
     "id": 943927,
     "content_html": "“This dose is too high and can cause gastric bleeding.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "This dose exceeds the 3200 mg maximum dose for ibuprofen and, based on the client’s report of black tarry stools, has already caused gastric bleeding."
    }
   ],
   "community_solutions": []
  }
