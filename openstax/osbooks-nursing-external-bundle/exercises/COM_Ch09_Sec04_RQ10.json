 "questions": [
  {
   "id": 647392,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse working in a rural public health clinic recognizes that which of the following risk factors for poor health outcomes is prevalent in the community?",
   "answers": [
    {
     "id": 1275256,
     "content_html": "An increased likelihood of engaging in risky behaviors",
     "correctness": "1.0"
    },
    {
     "id": 1275255,
     "content_html": "A decreased risk of experiencing chronic lung disease",
     "correctness": "0.0"
    },
    {
     "id": 1275254,
     "content_html": "An increased likelihood of wearing seat belts",
     "correctness": "0.0"
    },
    {
     "id": 1275253,
     "content_html": "A decreased risk of cancer",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Rural residents are more likely to engage in riskier health behavior and have poorer health outcomes than residents of urban areas."
    }
   ],
   "community_solutions": []
  }
