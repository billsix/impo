 "questions": [
  {
   "id": 647489,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During a community assessment, the nurse identifies a need for safe after-school space for high school students to socialize, study, and play. Which basic human need does this nurse determine needs to be met?",
   "answers": [
    {
     "id": 1275644,
     "content_html": "Security",
     "correctness": "1.0"
    },
    {
     "id": 1275643,
     "content_html": "Physiological",
     "correctness": "0.0"
    },
    {
     "id": 1275642,
     "content_html": "Esteem",
     "correctness": "0.0"
    },
    {
     "id": 1275641,
     "content_html": "Self-actualization",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Maslow’s hierarchy of needs begins with basic human needs and moves up to higher levels of achievement: physiological, security, social, esteem, and self-actualization. Providing a safe space for teenagers after school addresses the need for security."
    }
   ],
   "community_solutions": []
