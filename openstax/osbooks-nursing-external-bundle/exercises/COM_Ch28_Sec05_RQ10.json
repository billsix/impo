 "questions": [
  {
   "id": 647582,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community nurse is making a visit to an older adult client. The nurse identifies which of the following strategies that can be used in prevention of abuse in this client population?",
   "answers": [
    {
     "id": 1276016,
     "content_html": "Take the time to listen to the client and the family to offer resources and support.",
     "correctness": "1.0"
    },
    {
     "id": 1276015,
     "content_html": "Talk to the caregiver or family member only since older adults are often confused.",
     "correctness": "0.0"
    },
    {
     "id": 1276014,
     "content_html": "Talk to the older client alone without involving family members.",
     "correctness": "0.0"
    },
    {
     "id": 1276013,
     "content_html": "Because it is likely that older adult clients are abused, provide resources to other housing options.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Taking the time to listen to the older adult client and the family is one of the first strategies that can be used to prevent abuse. Providing resources to families can alleviate burdens and reduce the risk of a crisis."
    }
   ],
   "community_solutions": []
  }
