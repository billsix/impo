 "questions": [
  {
   "id": 647650,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following actions would improve health care access for clients?",
   "answers": [
    {
     "id": 1276287,
     "content_html": "Shifting health care reimbursement models to focus on health promotion initiatives",
     "correctness": "0.0"
    },
    {
     "id": 1276286,
     "content_html": "Implementing strategies to address health care provider burnout",
     "correctness": "0.0"
    },
    {
     "id": 1276285,
     "content_html": "Expanding a team-based approach to health care",
     "correctness": "0.0"
    },
    {
     "id": 1276288,
     "content_html": "Allowing advanced practice nurses full practice authority in all 50 states",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The shortage of health care providers hinders health equity and client access to care. Allowing advanced practice nurses full authority to practice expands the capacity of the health care workforce to treat clients."
    }
   ],
