   "id": 660211,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is working with a client who was recently diagnosed with asthma and is using a bronchodilator inhaler. Which of the following foods should the nurse instruct the client to minimize or avoid?",
   "answers": [
    {
     "id": 1309959,
     "content_html": "Steak",
     "correctness": "0.0"
    },
    {
     "id": 1309960,
     "content_html": "Coffee",
     "correctness": "1.0"
    },
    {
     "id": 1309958,
     "content_html": "Grapefruit",
     "correctness": "0.0"
    },
    {
     "id": 1309957,
     "content_html": "Kale",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Foods containing caffeine, like coffee, can potentiate the effects of the bronchodilator leading to tremors, nervousness, anxiety, and heart palpitation."
    }
   ],
   "community_solutions": []
  }
