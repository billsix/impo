     "content_html": "Antioxidant effect",
     "correctness": "1.0"
    },
    {
     "id": 1309635,
     "content_html": "They cross the placental barrier.",
     "correctness": "0.0"
    },
    {
     "id": 1309634,
     "content_html": "They cross the blood-brain barrier.",
     "correctness": "0.0"
    },
