 "questions": [
  {
   "id": 660336,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with rheumatoid arthritis is prescribed a biologic drug to manage the inflammatory condition. Before administering the biologic drug, which of the following is a priority for the nurse to assess to ensure the client’s health and safety?",
   "answers": [
    {
     "id": 1310460,
     "content_html": "Evaluate the client’s tuberculosis (TB) status",
     "correctness": "1.0"
    },
    {
     "id": 1310459,
     "content_html": "Measure the client’s blood glucose level",
     "correctness": "0.0"
    },
    {
     "id": 1310458,
     "content_html": "Check the client’s vision and eye health",
     "correctness": "0.0"
    },
    {
     "id": 1310457,
     "content_html": "Assess the client’s vital signs",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Biologic drugs, particularly tumor necrosis factor-alpha (TNF-alpha) inhibitors, can increase the risk of reactivating latent tuberculosis."
    }
   ],
   "community_solutions": []
  }
