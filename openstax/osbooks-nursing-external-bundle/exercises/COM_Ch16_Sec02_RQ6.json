  {
   "id": 647458,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using the Robert Wood Johnson Foundation’s Culture of Health Action Framework, which action would the nurse take when engaged in cross-sector collaboration to reduce overdose deaths in adolescents?",
   "answers": [
    {
     "id": 1275519,
     "content_html": "Encouraging community members to vote on a referendum for substance misuse education",
     "correctness": "0.0"
    },
    {
     "id": 1275520,
     "content_html": "Working with schools and law enforcement to reduce drug overdoses",
     "correctness": "1.0"
    },
    {
     "id": 1275518,
     "content_html": "Supporting research for substance misuse prevention programs",
     "correctness": "0.0"
    },
    {
     "id": 1275517,
     "content_html": "Creating community-based substance misuse treatment programs",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The RWJF Culture of Health initiative was developed to promote a shared understanding that good health is a fundamental right and essential to well-being and prosperity across the United States. Cross-sector collaboration involves organizations outside of those traditionally or directly associated with health care, such as schools and law enforcement, working together to support better health across communities."
    }
   ],
   "community_solutions": []
  }
