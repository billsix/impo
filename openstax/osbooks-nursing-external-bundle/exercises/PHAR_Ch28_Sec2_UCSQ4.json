   "id": 371187,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on the client’s glycosylated hemoglobin results, which treatment plan does the nurse anticipate the health care provider will prescribe?",
   "answers": [
    {
     "id": 897906,
     "content_html": "No changes to the treatment plan",
     "correctness": "1.0"
    },
    {
     "id": 897907,
     "content_html": "Increase glipizide to 10 mg daily",
     "correctness": "0.0"
    },
    {
     "id": 897908,
     "content_html": "Change to another oral diabetic drug",
     "correctness": "0.0"
    },
    {
     "id": 897909,
     "content_html": "Add insulin lispro 6 units daily",
     "correctness": "0.0"
    }
   ],
   "hints": [],
