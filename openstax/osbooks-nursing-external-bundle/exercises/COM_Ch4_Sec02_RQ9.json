     "id": 1275052,
     "content_html": "SDGs have been impacted by the climate crisis.",
     "correctness": "1.0"
    },
    {
     "id": 1275051,
     "content_html": "The focus of SDGs is on developing nations.",
     "correctness": "0.0"
    },
    {
     "id": 1275050,
     "content_html": "Progress on SDGs is reported every 5 years.",
     "correctness": "0.0"
    },
    {
