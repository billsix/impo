 "questions": [
  {
   "id": 647416,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which description of disease activity in a single area corresponds to endemic levels of disease?",
   "answers": [
    {
     "id": 1275352,
     "content_html": "There are usually 20–30 cases each week, and this past week there were 29 cases.",
     "correctness": "1.0"
    },
    {
     "id": 1275351,
     "content_html": "There are usually fewer than 20 cases per year, and this past week there were 2 cases.",
     "correctness": "0.0"
    },
    {
     "id": 1275350,
     "content_html": "There are usually up to 10 cases per week, and this past week there were 40 cases.",
     "correctness": "0.0"
    },
    {
     "id": 1275349,
     "content_html": "There are usually 100,000 cases worldwide each month, and this past month there were 10 million cases worldwide.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
