   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Endemic refers to the continual and constant presence of a disease within a given geographic area. It may also be referred to as the usual rate of disease at any given time."
    }
   ],
