   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following explains why community health nurses should involve community members in assessment processes?",
   "answers": [
    {
     "id": 1275507,
     "content_html": "To allow the community to make improvements prior to a windshield survey",
     "correctness": "0.0"
    },
    {
     "id": 1275506,
     "content_html": "To share the workload of change with the community members",
     "correctness": "0.0"
    },
    {
     "id": 1275508,
     "content_html": "To increase the likelihood of community participation in interventions and programs",
     "correctness": "1.0"
    },
    {
     "id": 1275505,
     "content_html": "To exert control over the community members",
     "correctness": "0.0"
    }
   ],
