   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is explaining a client’s lipid panel results. Which statement by the client indicates a need for further teaching?",
   "answers": [
    {
     "id": 1311047,
     "content_html": "“LDL-cholesterol is ‘bad cholesterol.’”",
     "correctness": "0.0"
    },
    {
     "id": 1311048,
     "content_html": "“Medications can be used to increase my triglyceride levels.”",
     "correctness": "1.0"
    },
    {
     "id": 1311046,
     "content_html": "“HDL-cholesterol is ‘good cholesterol.’”",
     "correctness": "0.0"
    },
    {
     "id": 1311045,
     "content_html": "“Medications can decrease my cholesterol levels.”",
     "correctness": "0.0"
    }
   ],
