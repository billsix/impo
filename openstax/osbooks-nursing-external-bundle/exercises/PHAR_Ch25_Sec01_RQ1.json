 "questions": [
  {
   "id": 660523,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is caring for a client with acute bronchospasm. The health care provider orders albuterol, a short-acting beta-2 adrenergic agonist. What is the most appropriate rationale for administering albuterol to the client?",
   "answers": [
    {
     "id": 1311207,
     "content_html": "To reduce airway inflammation",
     "correctness": "0.0"
    },
    {
     "id": 1311206,
     "content_html": "To stimulate cholinergic receptors",
     "correctness": "0.0"
    },
    {
     "id": 1311208,
     "content_html": "To induce bronchodilation",
     "correctness": "1.0"
    },
    {
     "id": 1311205,
     "content_html": "To suppress the immune response",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Albuterol is a short-acting beta-agonist that works by stimulating beta-2 adrenergic receptors in the airway smooth muscles."
    }
   ],
   "community_solutions": []
  }
 ],
