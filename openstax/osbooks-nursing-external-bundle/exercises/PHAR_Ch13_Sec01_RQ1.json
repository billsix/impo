 "questions": [
  {
   "id": 660403,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client receiving a tricyclic antidepressant. Which of the following symptoms related to its anticholinergic effects could the client experience?",
   "answers": [
    {
     "id": 1310727,
     "content_html": "Increased appetite, diarrhea, and glaucoma",
     "correctness": "0.0"
    },
    {
     "id": 1310728,
     "content_html": "Xerostomia, constipation, and urinary retention",
     "correctness": "1.0"
    },
    {
     "id": 1310726,
     "content_html": "Excessive salivation, tachycardia, and urinary incontinence",
     "correctness": "0.0"
    },
    {
     "id": 1310725,
     "content_html": "Nightmares, increased libido, and blurred vision",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The drug blocks muscarinic receptors and causes anticholinergic effects. This results in reduced salivation (xerostomia), decreased peristalsis (constipation), and relaxation of the detrusor muscle, causing urinary retention."
    }
   ],
   "community_solutions": []
  }
 ],
