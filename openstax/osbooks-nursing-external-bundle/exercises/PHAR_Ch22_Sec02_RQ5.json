 "questions": [
  {
   "id": 660497,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse in the emergency department is caring for a client who reports chest pain that is relieved at rest. Which diagnosis should the nurse anticipate?",
   "answers": [
    {
     "id": 1311104,
     "content_html": "Stable angina",
     "correctness": "1.0"
    },
    {
     "id": 1311103,
     "content_html": "Unstable angina",
     "correctness": "0.0"
    },
    {
     "id": 1311102,
     "content_html": "Myocardial infarction",
     "correctness": "0.0"
    },
    {
     "id": 1311101,
     "content_html": "Ventricular dysrhythmia",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Stable angina occurs during exercise or exertion and improves with rest. Stable angina presents when the heart needs more oxygen but the supply of oxygen is restricted. Once the heart does not need increased oxygen, the angina subsides."
    }
   ],
   "community_solutions": []
  }
 ],
