 "questions": [
  {
   "id": 647606,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is working with a group of clients that includes assault survivors. Which of the following actions by the nurse best reflects trauma-informed care?",
   "answers": [
    {
     "id": 1276111,
     "content_html": "The nurse places a hand on the client’s shoulder to show support.",
     "correctness": "0.0"
    },
    {
     "id": 1276110,
     "content_html": "The nurse provides instruction using medical terminology relevant to their experiences.",
     "correctness": "0.0"
    },
    {
     "id": 1276112,
     "content_html": "The nurse introduces themself and explains what they will be doing during the session.",
     "correctness": "1.0"
    },
    {
     "id": 1276109,
     "content_html": "The nurse remains standing and walks around the (seated) clients during the session.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "By introducing themself and explaining their role in the session, the nurse is incorporating trauma-informed care into their practice."
    }
   ],
   "community_solutions": []
  }
