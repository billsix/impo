 "questions": [
  {
   "id": 647511,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is discussing risk factor modification with a client diagnosed with hypertension. Which client statement does the nurse recognize as representing an external locus of control?",
   "answers": [
    {
     "id": 1275731,
     "content_html": "“High blood pressure causes blood vessel damage.”",
     "correctness": "0.0"
    },
    {
     "id": 1275732,
     "content_html": "“My fate has already been determined.”",
     "correctness": "1.0"
    },
    {
     "id": 1275730,
     "content_html": "“Eating right can improve my health.”",
     "correctness": "0.0"
    },
    {
     "id": 1275729,
     "content_html": "“I am motivated to make lifestyle changes.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Locus of control refers to an individual’s beliefs about the extent of their control over the environment and what happens to them. An individual with an external locus of control believes that external forces, such as luck or fate, determine outcomes."
    }
   ],
   "community_solutions": []
  }
 ],
