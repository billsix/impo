 "questions": [
  {
   "id": 660635,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client in labor who will be receiving an MgSO<sub>4</sub> infusion for eclampsia. Which provider’s order is most important to implement?",
   "answers": [
    {
     "id": 1311656,
     "content_html": "Continuous cardiac monitoring",
     "correctness": "1.0"
    },
    {
     "id": 1311655,
     "content_html": "Hourly urine output",
     "correctness": "0.0"
    },
    {
     "id": 1311654,
     "content_html": "Nothing by mouth (NPO)",
     "correctness": "0.0"
    },
    {
     "id": 1311653,
     "content_html": "Oxygen saturation monitoring",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "MgSO<sub>4</sub> can cause serious life-threatening cardiac rhythm changes and circulatory collapse. Therefore, continuous cardiac monitoring is the most important order to implement."
    }
   ],
   "community_solutions": []
  }
