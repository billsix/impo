  {
   "id": 375334,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The health care provider prescribes hydromorphone for the client’s ankle pain. Which information will the nurse give the client about this drug?",
   "answers": [
    {
     "id": 900407,
     "content_html": "“Do not drink alcohol while you’re taking this medication.”",
     "correctness": "1.0"
    },
    {
     "id": 900408,
     "content_html": "“Reduce your fiber intake while taking this medication.”",
     "correctness": "0.0"
    },
    {
     "id": 900409,
     "content_html": "“Your heart rate might slow down when you’re taking this medication.”",
     "correctness": "0.0"
    },
    {
     "id": 900410,
     "content_html": "“This medication might lower your blood pressure.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The use of an opioid, such as hydromorphone, with alcohol can result in sedation and respiratory depression."
    }
   ],
