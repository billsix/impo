   "id": 660149,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What should the nurse include in dietary instructions for a client with diabetes regarding alcohol consumption?",
   "answers": [
    {
     "id": 1309712,
     "content_html": "Alcohol consumption can either raise or lower blood glucose levels.",
     "correctness": "1.0"
    },
    {
     "id": 1309711,
     "content_html": "Alcohol consumption does not affect blood glucose levels.",
     "correctness": "0.0"
    },
    {
     "id": 1309710,
     "content_html": "Drinking alcohol is acceptable if low-sugar or sugar-free ingredients are used in mixed drinks.",
     "correctness": "0.0"
    },
    {
     "id": 1309709,
     "content_html": "Drinking alcohol may worsen signs of hypoglycemia when it occurs.",
     "correctness": "0.0"
    }
   ],
