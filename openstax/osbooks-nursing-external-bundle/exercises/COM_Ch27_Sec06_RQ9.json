 "questions": [
  {
   "id": 647571,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is considered an adverse childhood experience?",
   "answers": [
    {
     "id": 1275971,
     "content_html": "Having a family member with a disability",
     "correctness": "0.0"
    },
    {
     "id": 1275972,
     "content_html": "Witnessing gang violence in the community",
     "correctness": "1.0"
    },
    {
     "id": 1275970,
     "content_html": "Arguing with parents over subpar schoolwork",
     "correctness": "0.0"
    },
    {
     "id": 1275969,
     "content_html": "Living in an area with low socioeconomic status",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "ACEs are traumatic events occurring in childhood that can have a lifelong negative impact on health. Traumatic events may include experiencing violence or neglect, witnessing violence in the home or community, or having a family member attempt or die by suicide. Additionally, growing up in an environment that undermines a sense of safety, stability, or bonding also contributes to ACEs."
    }
   ],
   "community_solutions": []
  }
