   "stimulus_html": "",
   "stem_html": "A nurse is reviewing a client’s medication profile and notices that they are taking isoniazid, rifampin, ethambutol, and pyrazinamide for tuberculosis. These drugs can affect the function of which of the following organ systems?",
   "answers": [
    {
     "id": 1310519,
     "content_html": "Heart",
     "correctness": "0.0"
    },
    {
     "id": 1310518,
     "content_html": "Lungs",
     "correctness": "0.0"
    },
    {
     "id": 1310517,
     "content_html": "Muscle",
     "correctness": "0.0"
    },
    {
     "id": 1310520,
     "content_html": "Liver",
     "correctness": "1.0"
    }
   ],
