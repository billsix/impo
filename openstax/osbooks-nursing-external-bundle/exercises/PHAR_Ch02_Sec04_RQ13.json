 "questions": [
  {
   "id": 660295,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The health care provider ordered heparin sodium 4000 units subcutaneously every 12 hours. The pharmacy supplies 5000 units/1 mL in a 10 mL vial. How many mL should the nurse administer to the client?",
   "answers": [
    {
     "id": 1310296,
     "content_html": "0.8 mL",
     "correctness": "1.0"
    },
    {
     "id": 1310295,
     "content_html": "1.2 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310294,
     "content_html": "8 mL",
     "correctness": "0.0"
    },
    {
     "id": 1310293,
     "content_html": "2.5 mL",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse sets up the following equation: <span data-math=\"D\\;÷\\;H\\; \\times \\;Q\\; = \\;A\"></span>. <span data-math=\"D\"></span> represents the desired dose (the dose ordered), <span data-math=\"H\"></span> the amount on hand or available, <span data-math=\"Q\"></span> the quantity or volume of the drug form (tablet, capsule, liquid), and <span data-math=\"A\"></span> the amount calculated to be administered to the client. Therefore, <span data-math=\"4000\\;\\text{units}\\;÷\\;5000\\;\\text{units}\\; \\times \\;1\\;\\text{mL}\\; = \\;0.8\\;\\text{mL}\"></span>."
    }
   ],
