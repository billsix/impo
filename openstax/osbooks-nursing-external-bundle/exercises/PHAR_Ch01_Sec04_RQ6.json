 "questions": [
  {
   "id": 660281,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a 93-year-old client weighing 92 pounds. What is the nurse’s <em>priority</em> concern when monitoring for adverse drug effects in this client?",
   "answers": [
    {
     "id": 1310239,
     "content_html": "Diarrhea",
     "correctness": "0.0"
    },
    {
     "id": 1310238,
     "content_html": "Constipation",
     "correctness": "0.0"
    },
    {
     "id": 1310240,
     "content_html": "Toxicity",
     "correctness": "1.0"
    },
    {
     "id": 1310237,
     "content_html": "Decreased absorption",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Toxicity is the greatest concern in this older client who is also underweight. Therefore, this client may require a lower dose of the drug."
    }
   ],
   "community_solutions": []
  }
