 "questions": [
  {
   "id": 660280,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is preparing to administer a new medication to an older client. The nurse recognizes that drug absorption may be affected by which physiologic factor of aging?",
   "answers": [
    {
     "id": 1310235,
     "content_html": "Increased enzymatic function",
     "correctness": "0.0"
    },
    {
     "id": 1310234,
     "content_html": "Increased liver function",
     "correctness": "0.0"
    },
    {
     "id": 1310233,
     "content_html": "Increased filtration of the kidneys",
     "correctness": "0.0"
    },
    {
     "id": 1310236,
     "content_html": "Decreased gastrointestinal motility",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Decreased GI motility causes increased transit time in the gut, which increases the time for absorption of the drug. Toxicity may result."
    }
   ],
   "community_solutions": []
  }
 ],
