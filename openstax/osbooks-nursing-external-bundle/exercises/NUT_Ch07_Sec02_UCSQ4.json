 "questions": [
  {
   "id": 387519,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following actions would be most appropriate for the nurse to address Meena’s elevated blood pressure?",
   "answers": [
    {
     "id": 914855,
     "content_html": "Initiate a sodium-controlled diet and educate Meena on sodium reduction strategies.",
     "correctness": "1.0"
    },
    {
     "id": 914856,
     "content_html": "Provide instruction on calcium sources in her diet.",
     "correctness": "0.0"
    },
    {
     "id": 914857,
     "content_html": "Encourage her to increase her fluid intake.",
     "correctness": "0.0"
    },
    {
     "id": 914858,
     "content_html": "Initiate a low-carbohydrate diet and instruct Meena on how to obtain adequate protein in her diet.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A low-sodium diet can help manage the client’s elevated blood pressure alongside other lifestyle changes. Educating her on sodium reduction strategies, such as limiting processed foods and using herbs and spices instead of salt, will empower her to make healthier choices."
    }
   ],
   "community_solutions": []
  }
