 "questions": [
  {
   "id": 660477,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is teaching a client about warfarin dietary considerations. Which of the following statements by the client indicates understanding of the restrictions?",
   "answers": [
    {
     "id": 1311023,
     "content_html": "“I should eat a lot of spinach every day due to increased vitamin K needs.”",
     "correctness": "0.0"
    },
    {
     "id": 1311022,
     "content_html": "“I can eat a lot of extra broccoli with a meal as long as it is only occasionally due to decreased vitamin K needs.”",
     "correctness": "0.0"
    },
    {
     "id": 1311021,
     "content_html": "“I should avoid eating fruit like bananas due to excess vitamin K content.”",
     "correctness": "0.0"
    },
    {
     "id": 1311024,
     "content_html": "“I should eat a consistent amount of vitamin K–containing foods in my diet.”",
     "correctness": "1.0"
    }
   ],
