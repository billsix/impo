   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Automaticity is when the tissue is able to spontaneously generate an action potential, leading to spontaneous depolarization. Tissues with automaticity can act as the pacemaker of the heart."
    }
   ],
