   "id": 660439,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following terms describes the ability of cardiac tissue to act as the pacemaker of the heart?",
   "answers": [
    {
     "id": 1310871,
     "content_html": "Membrane potential",
     "correctness": "0.0"
    },
    {
     "id": 1310870,
     "content_html": "Conductivity",
     "correctness": "0.0"
    },
    {
     "id": 1310872,
     "content_html": "Automaticity",
     "correctness": "1.0"
    },
    {
     "id": 1310869,
     "content_html": "Action potential",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
