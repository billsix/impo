  {
   "id": 660121,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 67-year-old woman presents to the urgent care center with a headache and dizziness following a 5-mile running event for charity. Which of the following findings would be most concerning?",
   "answers": [
    {
     "id": 1309599,
     "content_html": "Seizure history",
     "correctness": "0.0"
    },
    {
     "id": 1309600,
     "content_html": "Limited fluid intake",
     "correctness": "1.0"
    },
    {
     "id": 1309598,
     "content_html": "History of kidney stones",
     "correctness": "0.0"
    },
    {
     "id": 1309597,
     "content_html": "Recent vaccination for influenza",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Dehydration is common among older adults because of a diminished sense of thirst; vigorous exercise can cause rapid dehydration, and hydration is the priority to assess."
    }
   ],
   "community_solutions": []
  }
