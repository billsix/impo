 "questions": [
  {
   "id": 660377,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In Alzheimer’s disease, which pharmacologic action within the brain will reduce the symptoms seen with this progressive disease?",
   "answers": [
    {
     "id": 1310623,
     "content_html": "Decreased sensitivity of cholinergic receptors on the postsynaptic neuron",
     "correctness": "0.0"
    },
    {
     "id": 1310624,
     "content_html": "Decreased action of acetylcholinesterase (AChE)",
     "correctness": "1.0"
    },
    {
     "id": 1310622,
     "content_html": "Inhibition of the release of acetylcholine (ACh) from presynaptic neurons",
     "correctness": "0.0"
    },
    {
     "id": 1310621,
     "content_html": "Increased amount of available acetylcholinesterase (AChE)",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because a decreased level of ACh is present in this disease, decreasing the action of AChE can help reduce the symptoms because less ACh will be broken down."
    }
   ],
