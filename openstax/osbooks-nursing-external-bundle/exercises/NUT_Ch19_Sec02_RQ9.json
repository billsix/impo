   "id": 660260,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing nutritional instruction to a client with a surgical wound that is slow to heal. Which of the following statements by the client indicates the client understands the recommended diet strategies?",
   "answers": [
    {
     "id": 1310155,
     "content_html": "“I will eat smaller, more frequent meals.”",
     "correctness": "0.0"
    },
    {
     "id": 1310156,
     "content_html": "“I will drink water throughout the day.”",
     "correctness": "1.0"
    },
    {
     "id": 1310154,
     "content_html": "“I will limit my intake of dairy products.”",
     "correctness": "0.0"
    },
    {
     "id": 1310153,
     "content_html": "“I will eat several servings of fruits and vegetables each day.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client understands hydration, like drinking water throughout the day, promotes skin integrity and wound healing."
    }
   ],
