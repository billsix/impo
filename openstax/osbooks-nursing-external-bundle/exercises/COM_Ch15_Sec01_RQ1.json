   "id": 647443,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A home health nurse has several clients  who live in the same apartment building. In the last week, the nurse has noticed that both elevators in the four-story building are out of order. Two of the clients live on the second floor and use a wheelchair. The nurse \nleaves a message for the building manager describing their concern for the clients. This action describes the role of the nurse as",
   "answers": [
    {
     "id": 1275460,
     "content_html": "advocate",
     "correctness": "1.0"
    },
    {
     "id": 1275459,
     "content_html": "care provider",
     "correctness": "0.0"
    },
    {
     "id": 1275458,
     "content_html": "consultant",
     "correctness": "0.0"
    },
    {
     "id": 1275457,
     "content_html": "educator",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The role of the nurse as advocate involves helping to create environments that support better health. In this scenario, the nurse is advocating not only for their two specific clients, but also the community of the apartment as a whole."
    }
   ],
   "community_solutions": []
