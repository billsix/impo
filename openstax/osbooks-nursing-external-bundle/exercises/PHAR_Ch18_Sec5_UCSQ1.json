   "id": 365719,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which instruction about enalapril will the nurse give Hahn?",
   "answers": [
    {
     "id": 886641,
     "content_html": "Take this medication with a meal.",
     "correctness": "0.0"
    },
    {
     "id": 886642,
     "content_html": "Do not take this medication if your heart rate is less than 60 beats/minute.",
     "correctness": "0.0"
    },
    {
     "id": 886643,
     "content_html": "Avoid salt substitutes that contain potassium while taking this medication.",
     "correctness": "1.0"
    },
    {
     "id": 886644,
     "content_html": "Avoid eating grapefruit while taking this medication.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "ACE inhibitors, such as enalapril, can cause hyperkalemia (an elevated serum potassium level), so the nurse should advise the client not to use potassium-containing salt substitutes."
    }
   ],
