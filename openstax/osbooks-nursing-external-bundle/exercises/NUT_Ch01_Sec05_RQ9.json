   "id": 660081,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is helping an adult, English-speaking client understand a newly prescribed diet. What is the best approach when selecting appropriate educational materials for the client?",
   "answers": [
    {
     "id": 1309440,
     "content_html": "Provide materials designed to accommodate various reading abilities.",
     "correctness": "1.0"
    },
    {
     "id": 1309439,
     "content_html": "Find as many materials as possible related to the diet.",
     "correctness": "0.0"
    },
    {
     "id": 1309438,
     "content_html": "Provide written materials in a variety of languages.",
     "correctness": "0.0"
    },
    {
     "id": 1309437,
     "content_html": "Ask the client whether or not they need supplemental materials.",
     "correctness": "0.0",
     "feedback_html": ""
    }
   ],
