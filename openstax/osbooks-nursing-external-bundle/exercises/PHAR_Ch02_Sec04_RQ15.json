 "questions": [
  {
   "id": 660297,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The health care provider ordered enoxaparin 1.5 mg/kg/day. The client weighs 176 lb. How many milligrams of enoxaparin should the client receive?",
   "answers": [
    {
     "id": 1310303,
     "content_html": "80 mg",
     "correctness": "0.0"
    },
    {
     "id": 1310302,
     "content_html": "100 mg",
     "correctness": "0.0"
    },
    {
     "id": 1310304,
     "content_html": "120 mg",
     "correctness": "1.0"
    },
    {
     "id": 1310301,
     "content_html": "150 mg",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "First, convert the client’s weight from pounds to kilograms (<span data-math=\"2.2\\;\\text{lb}\\; = \\;1\\;\\text{kg}\"></span> therefore, the client weighs <span data-math=\"80\\;\\mathrm{kg}\"></span>). Next, calculate the amount of drug the client should receive: <span data-math=\"1.5\\;\\text{mg/kg}\\; \\times \\;80\\;\\text{kg}\\; = 120\\;\\text{mg}\"></span>."
    }
   ],
   "community_solutions": []
  }
 ],
