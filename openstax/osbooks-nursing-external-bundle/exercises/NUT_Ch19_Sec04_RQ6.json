   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The client has returned to the clinic for a follow-up appointment after being diagnosed with osteoporosis. Which of the following statements by the client indicates they have followed the recommended diet to manage their condition?",
   "answers": [
    {
     "id": 1310163,
     "content_html": "“I have been eating more fruit than I used to.”",
     "correctness": "0.0"
    },
    {
     "id": 1310164,
     "content_html": "“I try to eat several servings of dairy products each day.”",
     "correctness": "1.0"
    },
    {
     "id": 1310162,
     "content_html": "“I don’t like to eat fish.”",
     "correctness": "0.0"
    },
    {
     "id": 1310161,
     "content_html": "“I have switched from eating French fries to baked potatoes.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Foods rich in calcium and vitamin D, such as dairy products, are important for bone health and the treatment of osteoporosis."
    }
   ],
   "community_solutions": []
