 "questions": [
  {
   "id": 660267,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for an adolescent client who participates in sports after school 4 or 5 times a week for 2–4 hours. The adolescent reports fatigue and sore muscles. What should the nurse suggest to this client?",
   "answers": [
    {
     "id": 1310183,
     "content_html": "“Drink a soda to increase your energy level after exercise.”",
     "correctness": "0.0"
    },
    {
     "id": 1310182,
     "content_html": "“Don’t exercise until your symptoms go away.”",
     "correctness": "0.0"
    },
    {
     "id": 1310184,
     "content_html": "“Try to eat a combination of protein and complex carbohydrates.”",
     "correctness": "1.0"
    },
    {
     "id": 1310181,
     "content_html": "“Avoid whole grains, fruits, legumes, and vegetables.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Adolescent athletes have increased nutritional needs and should consume adequate amounts of complex carbohydrates, proteins, and fats while avoiding processed sugars."
    }
   ],
   "community_solutions": []
  }
 ],
