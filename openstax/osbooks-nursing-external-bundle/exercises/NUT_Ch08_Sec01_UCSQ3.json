   "id": 367671,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sarah asks if her diabetes will recur now that she is no longer pregnant. How should the nurse respond?",
   "answers": [
    {
     "id": 891896,
     "content_html": "“You need to be monitored 6 weeks after delivery for the signs of diabetes.”",
     "correctness": "0.0"
    },
    {
     "id": 891897,
     "content_html": "“Now that you are no longer pregnant, your diabetes has resolved and is no longer an issue.”",
     "correctness": "0.0"
    },
    {
     "id": 891898,
     "content_html": "“Having gestational diabetes increases your risk for developing type 1 diabetes later.”",
     "correctness": "0.0"
    },
    {
     "id": 891899,
     "content_html": "“Having gestational diabetes increases your risk for developing type 2 diabetes later.”",
     "correctness": "1.0"
    }
   ],
