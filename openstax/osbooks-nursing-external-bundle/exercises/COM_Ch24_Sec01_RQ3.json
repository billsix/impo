 "questions": [
  {
   "id": 647535,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by a health care organization is an example of a leadership commitment to cultural competence?",
   "answers": [
    {
     "id": 1275828,
     "content_html": "Developing a policy for use of trained interpreters",
     "correctness": "1.0"
    },
    {
     "id": 1275827,
     "content_html": "Enhancing client satisfaction",
     "correctness": "0.0"
    },
    {
     "id": 1275826,
     "content_html": "Improving health care outcomes",
     "correctness": "0.0"
    },
    {
     "id": 1275825,
     "content_html": "Increasing health care access to all individuals",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Leadership commitment refers to the active involvement and support of organizational leadership in promoting cultural competence. This includes developing and implementing policies and practices that prioritize cultural competence and diversity, such as developing policies for the use of trained interpreters."
    }
   ],
