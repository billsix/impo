 "questions": [
  {
   "id": 367486,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Hein asks how Bao has gotten Crohn’s disease because it does not run in their family. Given Bao’s history, what put him at increased risk for developing Crohn’s disease?",
   "answers": [
    {
     "id": 891170,
     "content_html": "Inability to consume lactose",
     "correctness": "0.0"
    },
    {
     "id": 891171,
     "content_html": "Hein’s pregnancy complications",
     "correctness": "1.0"
    },
    {
     "id": 891172,
     "content_html": "Bao had no increased risk",
     "correctness": "0.0"
    },
    {
     "id": 891173,
     "content_html": "Bao’s lack of adherence to the prescribed diet",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The problems that Hein faced in pregnancy drastically altered her microbiome and contributed to her infant’s low birth weight and birth at 37 weeks’ gestation. These complications all increased her infant’s risk for Crohn’s disease."
    }
   ],
   "community_solutions": []
  }
