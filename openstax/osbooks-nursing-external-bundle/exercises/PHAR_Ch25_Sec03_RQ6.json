 "questions": [
  {
   "id": 660532,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is providing education to a client prescribed montelukast, a leukotriene modifier, for the management of asthma. The nurse informs the client about potential side effects of this medication. Which side effect should the nurse include in the client education?",
   "answers": [
    {
     "id": 1311243,
     "content_html": "Dry mouth and blurred vision",
     "correctness": "0.0"
    },
    {
     "id": 1311242,
     "content_html": "Increased heart rate and palpitations",
     "correctness": "0.0"
    },
    {
     "id": 1311244,
     "content_html": "Headache and dizziness",
     "correctness": "1.0"
    },
    {
     "id": 1311241,
     "content_html": "Excessive drowsiness and sedation",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The most commonly reported side effects of montelukast include headache and dizziness."
    }
   ],
   "community_solutions": []
  }
