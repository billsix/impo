   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The provider ordered heparin sodium 1250 units/hour IV infusion. The pharmacy supplied heparin sodium 25,000 units in 500 mL of D<sub>5</sub>W. Calculate the infusion rate in mL/hour.",
   "answers": [
    {
     "id": 1310311,
     "content_html": "6 mL/hour",
     "correctness": "0.0"
    },
    {
     "id": 1310310,
     "content_html": "12 mL/hour",
     "correctness": "0.0"
    },
    {
     "id": 1310309,
     "content_html": "20 mL/hour",
     "correctness": "0.0"
    },
    {
     "id": 1310312,
     "content_html": "25 mL/hour",
     "correctness": "1.0"
    }
   ],
