 "questions": [
  {
   "id": 660559,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is preparing to administer 15 units of regular insulin and 23 units of NPH insulin subcutaneously. What is the total number of units of insulin that the nurse should prepare in the insulin syringe?",
   "answers": [
    {
     "id": 1311351,
     "content_html": "15 units",
     "correctness": "0.0"
    },
    {
     "id": 1311350,
     "content_html": "23 units",
     "correctness": "0.0"
    },
    {
     "id": 1311352,
     "content_html": "38 units",
     "correctness": "1.0"
    },
    {
     "id": 1311349,
     "content_html": "12 units",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The nurse should combine the regular insulin and the NPH in the same syringe so a total of 38 units should be prepared, with regular insulin being drawn up first."
    }
   ],
   "community_solutions": []
  }
