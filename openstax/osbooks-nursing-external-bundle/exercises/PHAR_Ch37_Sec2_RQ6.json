 "questions": [
  {
   "id": 660647,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A male client is on finasteride therapy. He has a teenage daughter who lives with him. Which statement by the client indicates a need for more teaching?",
   "answers": [
    {
     "id": 1311704,
     "content_html": "“It’s OK for my daughter to put this medication in my pill box.”",
     "correctness": "1.0"
    },
    {
     "id": 1311703,
     "content_html": "“This drug won’t cause problems with anything I eat.”",
     "correctness": "0.0"
    },
    {
     "id": 1311702,
     "content_html": "“This medication will help increase my breast size.”",
     "correctness": "0.0"
    },
    {
     "id": 1311701,
     "content_html": "“My sex drive will likely decrease with this medication.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Finasteride is highly toxic to a fetus. Any female who is pregnant or of childbearing age should avoid contact with this medication, especially if the tablet is broken or crushed."
    }
   ],
   "community_solutions": []
  }
