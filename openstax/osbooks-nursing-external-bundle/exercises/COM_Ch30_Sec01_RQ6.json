 "questions": [
  {
   "id": 647598,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using the Transitional Care Model (TCM), which action would the nurse take when preparing an 81-year-old client with diabetes, hypertension, and heart failure for discharge home from the hospital following an exacerbation of heart failure?",
   "answers": [
    {
     "id": 1276079,
     "content_html": "Provide the client with a standardized plan of care to follow",
     "correctness": "0.0"
    },
    {
     "id": 1276078,
     "content_html": "Identify risk factors for readmission and develop an individualized discharge plan",
     "correctness": "0.0"
    },
    {
     "id": 1276077,
     "content_html": "Refer the client to a discharge coach to encourage client self-management",
     "correctness": "0.0"
    },
    {
     "id": 1276080,
     "content_html": "Contact the advanced practice nurse to coordinate the discharge from hospital to home",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The TCM emphasizes the use of advanced practice nurses (APRNs) to coordinate care, educate clients and caregivers, and facilitate communication among various health care providers. It is designed to ensure the health and safety of high-risk older clients. TCM emphasizes client and caregiver education, promoting self-management and improving communication among health care providers."
    }
   ],
   "community_solutions": []
  }
 ],
