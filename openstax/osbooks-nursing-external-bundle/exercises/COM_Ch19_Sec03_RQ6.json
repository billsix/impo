   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "TeamSTEPPS® is an evidence-based program that aims to eliminate preventable medication errors related to unproductive team communication, thus improving client safety. The five key principles in this program are team structure, communication, leadership, situation monitoring, and mutual support. The team structure consists of multiple backgrounds and disciplines."
    }
   ],
