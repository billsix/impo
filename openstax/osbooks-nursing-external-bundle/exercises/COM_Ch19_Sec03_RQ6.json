   "id": 647488,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A health care team is using TeamSTEPPS® to plan and implement community health programs. Which action will the team take using this framework?",
   "answers": [
    {
     "id": 1275639,
     "content_html": "Share leadership responsibilities",
     "correctness": "0.0"
    },
    {
     "id": 1275638,
     "content_html": "Distribute information as needed",
     "correctness": "0.0"
    },
    {
     "id": 1275637,
     "content_html": "Utilize an informal communication format",
     "correctness": "0.0"
    },
    {
     "id": 1275640,
     "content_html": "Employ an interdisciplinary approach",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
