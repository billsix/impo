   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is educating the client on their newly prescribed medication misoprostol. Which of the following statements by the client indicates a priority need for additional follow-up?",
   "answers": [
    {
     "id": 1311480,
     "content_html": "“I recently stopped taking my birth-control pills.”",
     "correctness": "1.0"
    },
    {
     "id": 1311479,
     "content_html": "“I am taking a prescription-strength NSAID 3 times a day for my knee pain.”",
     "correctness": "0.0"
    },
    {
     "id": 1311478,
     "content_html": "“I am worried taking this will cause gas and diarrhea.”",
     "correctness": "0.0"
    },
    {
     "id": 1311477,
     "content_html": "“I need to remember to take this medication with food.”",
     "correctness": "0.0"
    }
