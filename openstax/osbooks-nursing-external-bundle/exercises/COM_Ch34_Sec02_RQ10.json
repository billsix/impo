 "questions": [
  {
   "id": 647642,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by the nurse is an example of influencing social justice at the state level?",
   "answers": [
    {
     "id": 1276255,
     "content_html": "Raising awareness of the need for childhood vaccinations within a community",
     "correctness": "0.0"
    },
    {
     "id": 1276254,
     "content_html": "Providing health information to clients in their choice of language",
     "correctness": "0.0"
    },
    {
     "id": 1276256,
     "content_html": "Educating state senators about social determinants of health",
     "correctness": "1.0"
    },
    {
     "id": 1276253,
     "content_html": "Working with a national organization to advocate for health care for transgender individuals",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Nurses can influence local, state, and national social justice policies. At the state level, the nurse can influence social justice policies by educating members of Congress about the health needs of transgender individuals."
    }
   ],
   "community_solutions": []
