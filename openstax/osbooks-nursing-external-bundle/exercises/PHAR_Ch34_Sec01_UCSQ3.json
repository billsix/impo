   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse provides teaching about the new diet to Gordon. Which of the following statements by Gordon indicates a need for further teaching?",
   "answers": [
    {
     "id": 897786,
     "content_html": "“I will limit my intake of green vegetables.”",
     "correctness": "1.0"
    },
    {
     "id": 897787,
     "content_html": "“I am going to start eating a banana a day to keep the doctor away.”",
     "correctness": "0.0"
    },
    {
     "id": 897788,
     "content_html": "“I have a salt substitute I can use on my food to add flavor.”",
     "correctness": "0.0"
    },
    {
     "id": 897789,
     "content_html": "“I am going to cut back on the number of sandwiches I get from the deli.”",
     "correctness": "0.0"
    }
   ],
