   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Green, leafy vegetables are an important part of a low-sodium diet with potassium-rich foods. This statement indicates a need for further teaching."
    }
