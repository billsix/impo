 "questions": [
  {
   "id": 647345,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement should guide the care a nurse provides to clients in a community health clinic that serves an ethnic minority group?",
   "answers": [
    {
     "id": 1275068,
     "content_html": "Health disparities are preventable differences in health.",
     "correctness": "1.0"
    },
    {
     "id": 1275067,
     "content_html": "Hypertension affects all ethnic groups equally.",
     "correctness": "0.0"
    },
    {
     "id": 1275066,
     "content_html": "Underrepresented populations engage in health-promotion activities.",
     "correctness": "0.0"
    },
    {
     "id": 1275065,
     "content_html": "The population of ethnic minorities in the United States is declining.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Health disparities overwhelmingly affect ethnic minorities and are defined as “preventable differences in the burden of disease, injury, violence, or opportunities to achieve optimal health that are experienced by socially disadvantaged populations” (CDC, 2020, para. 1)."
    }
   ],
   "community_solutions": []
  }
