 "questions": [
  {
   "id": 647369,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action can the community health nurse take to help an unemployed client without health insurance mitigate the high cost of prescription drugs?",
   "answers": [
    {
     "id": 1275163,
     "content_html": "Assist the client to reduce the amount spent on food and other items.",
     "correctness": "0.0"
    },
    {
     "id": 1275162,
     "content_html": "Ask the client which medications they feel are not necessary.",
     "correctness": "0.0"
    },
    {
     "id": 1275164,
     "content_html": "Speak with the provider about lower-cost alternatives.",
     "correctness": "1.0"
    },
    {
     "id": 1275161,
     "content_html": "Explain that all medications must be taken to improve health outcomes.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Community health nurses need to recognize the impact of high drug prices on their clients who may not take their medications if they cannot afford them. Among other options, nurses should contact the prescribers to identify less costly alternatives for the client."
    }
   ],
   "community_solutions": []
  }
