   "id": 660530,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is reviewing the medication regimen of a client with asthma. The client is prescribed theophylline, a xanthine derivative. The nurse understands that theophylline is primarily used for what particular purpose?",
   "answers": [
    {
     "id": 1311235,
     "content_html": "Acute relief of bronchospasm",
     "correctness": "0.0"
    },
    {
     "id": 1311234,
     "content_html": "Prevention of exercise-induced asthma",
     "correctness": "0.0"
    },
    {
     "id": 1311236,
     "content_html": "Long-term control of asthma symptoms",
     "correctness": "1.0"
    },
    {
     "id": 1311233,
     "content_html": "Reduction of airway inflammation",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Theophylline is a xanthine derivative medication used for long-term control of asthma symptoms."
    }
   ],
   "community_solutions": []
  }
