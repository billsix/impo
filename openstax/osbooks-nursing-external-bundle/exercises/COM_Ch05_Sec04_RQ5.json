   "stimulus_html": "",
   "stem_html": "Which statement best describes the impact of COVID-19 on the nursing profession?",
   "answers": [
    {
     "id": 1275075,
     "content_html": "The pandemic highlighted nursing as a desirable profession.",
     "correctness": "0.0"
    },
    {
     "id": 1275074,
