 "questions": [
  {
   "id": 660589,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is preparing to administer a dose of lansoprazole to a client with an ulcer. Which of the following statements by the client indicates the client needs additional instruction on this medication?",
   "answers": [
    {
     "id": 1311472,
     "content_html": "“I know my pain will improve right after taking this.”",
     "correctness": "1.0"
    },
    {
     "id": 1311471,
     "content_html": "“I need to take this every day before a meal.”",
     "correctness": "0.0"
    },
    {
     "id": 1311470,
     "content_html": "“I understand it can take about 6 months to experience the full benefit of this medication.”",
     "correctness": "0.0"
    },
    {
     "id": 1311469,
     "content_html": "“I hate the thought of having to take this for the rest of my life.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Lansoprazole begins to reduce acid after approximately 2 hours, with ulcer symptom relief after about a week of use. The medication should be taken on an empty stomach and is typically used short-term (less than 6 months) for an ulcer."
    }
   ],
   "community_solutions": []
  }
