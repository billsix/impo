 "questions": [
  {
   "id": 647552,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What action can a nurse take to reduce biases in nurse-client interactions?",
   "answers": [
    {
     "id": 1275895,
     "content_html": "Providing care based on past encounters with individuals of the same background",
     "correctness": "0.0"
    },
    {
     "id": 1275894,
     "content_html": "Explaining the nurse’s values and beliefs to the client",
     "correctness": "0.0"
    },
    {
     "id": 1275896,
     "content_html": "Reflecting on how their background influences their perception of others",
     "correctness": "1.0"
    },
    {
     "id": 1275893,
     "content_html": "Limiting interactions with individuals from certain social identity groups",
     "correctness": "0.0"
    }
   ],
