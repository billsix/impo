 "questions": [
  {
   "id": 660638,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An 11-year-old client is undergoing hormone therapy with testosterone for hypogonadism. Which assessment is most important for the nurse to monitor?",
   "answers": [
    {
     "id": 1311668,
     "content_html": "Results of radiographic images of the long bones every 6 months",
     "correctness": "1.0"
    },
    {
     "id": 1311667,
     "content_html": "Serum hemoglobin and hematocrit monthly",
     "correctness": "0.0"
    },
    {
     "id": 1311666,
     "content_html": "Serum electrolytes weekly",
     "correctness": "0.0"
    },
    {
     "id": 1311665,
     "content_html": "Blood pressure and electrocardiogram weekly",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Prepubescent clients on testosterone therapy may develop early closure of epiphyseal growth plates and stunted growth. Testosterone therapy may need to be decreased or stopped."
    }
   ],
   "community_solutions": []
  }
