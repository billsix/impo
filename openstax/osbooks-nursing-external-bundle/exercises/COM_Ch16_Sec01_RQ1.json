 "questions": [
  {
   "id": 647453,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action is an example of the community health nurse engaged in nursing the community as the client?",
   "answers": [
    {
     "id": 1275499,
     "content_html": "Providing individualized care for multiple patients with a specific chronic illness",
     "correctness": "0.0"
    },
    {
     "id": 1275500,
     "content_html": "Conducting health screenings for individuals in a specific town or city",
     "correctness": "1.0"
    },
    {
     "id": 1275498,
     "content_html": "Administering vaccines to individuals at high risk of disease complications",
     "correctness": "0.0"
    },
    {
     "id": 1275497,
     "content_html": "Treating a client’s acute illness in a hospital setting",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "When the community is the client, the nurse addresses the health needs of a community or population instead of one or more individual clients. Conducting health screenings for individuals in a specific town or city would help the nurse assess the health needs in the community."
    }
   ],
   "community_solutions": []
  }
