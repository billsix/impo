   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is evaluating a client in the emergency department who presents with painful urination and urethral discharge. Laboratory tests indicate that the client is positive for gonorrhea. Which medication does the nurse anticipate the health care provider will most likely prescribe?",
   "answers": [
    {
     "id": 1310508,
     "content_html": "Ceftriaxone",
     "correctness": "1.0"
    },
    {
     "id": 1310507,
     "content_html": "Acyclovir",
     "correctness": "0.0"
    },
    {
     "id": 1310506,
     "content_html": "Metronidazole",
     "correctness": "0.0"
    },
    {
     "id": 1310505,
     "content_html": "Permethrin",
     "correctness": "0.0"
    }
   ],
