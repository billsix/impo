     "content_html": "Assisting a new mother with breastfeeding",
     "correctness": "0.0"
    },
    {
     "id": 1275284,
     "content_html": "Treating all clients regardless of their ability to pay",
     "correctness": "1.0"
    },
    {
     "id": 1275281,
     "content_html": "Lobbying to ensure health care for transgender clients",
     "correctness": "0.0"
