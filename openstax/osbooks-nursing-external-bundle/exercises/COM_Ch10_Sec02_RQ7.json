   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Using the UNICEF Socio-Ecological Model, which statement is an example of a community health center working at the organizational level to promote health care?",
   "answers": [
    {
     "id": 1275283,
     "content_html": "Teaching a client how to self-administer insulin injections",
     "correctness": "0.0"
    },
    {
