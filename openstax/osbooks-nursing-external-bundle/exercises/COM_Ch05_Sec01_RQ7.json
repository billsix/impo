 "questions": [
  {
   "id": 647349,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 38-year-old client, who identifies as transgender, presents to a community health center with symptoms of an upper respiratory infection. During the intake assessment, the client tells the nurse that they do not receive regular health care and do not have a primary health care provider. As the nurse performs an assessment of this individual, which finding does the nurse anticipate?",
   "answers": [
    {
     "id": 1275083,
     "content_html": "An absence of preventable diseases",
     "correctness": "0.0"
    },
    {
     "id": 1275084,
     "content_html": "A distrust of the health care system",
     "correctness": "1.0"
    },
    {
     "id": 1275082,
     "content_html": "Positive past health care encounters",
     "correctness": "0.0"
    },
    {
     "id": 1275081,
     "content_html": "Up-to-date cancer screenings",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Vulnerable populations, including transgender individuals, often face discrimination and stigma by health care providers and, therefore, may have a lack of trust in the health care system."
    }
   ],
   "community_solutions": []
  }
 ],
