 "questions": [
  {
   "id": 660384,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client who was recently diagnosed with PD. The provider wanted to begin the client on pramipexole, but the client has difficulty swallowing medications due to a previous stroke. What other medication in the same class would <em>best</em> meet the client’s needs?",
   "answers": [
    {
     "id": 1310651,
     "content_html": "Ropinirole ER",
     "correctness": "0.0"
    },
    {
     "id": 1310652,
     "content_html": "Rotigotine",
     "correctness": "1.0"
    },
    {
     "id": 1310650,
     "content_html": "Apomorphine",
     "correctness": "0.0"
    },
    {
     "id": 1310649,
     "content_html": "Bromocriptine",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because the client cannot swallow well, this drug is the best to meet their needs. It is available in a patch form and is administered transdermally."
    }
   ],
   "community_solutions": []
  }
