 "questions": [
  {
   "id": 660183,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client who has a pre-existing heart condition consults her provider to plan for her next pregnancy. Which statement would the provider need to include in the teaching for a client who has a normal BMI?",
   "answers": [
    {
     "id": 1309847,
     "content_html": "“You are able to gain as much weight as you need.”",
     "correctness": "0.0"
    },
    {
     "id": 1309848,
     "content_html": "“You need to increase your caloric intake by 340 calories daily in the second trimester.”",
     "correctness": "1.0"
    },
    {
     "id": 1309846,
     "content_html": "“You need to drink whole milk to help the fetus’s bones develop.”",
     "correctness": "0.0"
    },
    {
     "id": 1309845,
     "content_html": "“You need to refrain from exercising.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The pregnant client who has a pre-existing heart condition will need to increase calories by 340 calories daily to gain the necessary amount of weight but not an excessive amount that can strain their cardiovascular system."
    }
   ],
   "community_solutions": []
  }
 ],
