 "questions": [
  {
   "id": 647506,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action should the nurse take to communicate with a client from a culture that is different from their own?",
   "answers": [
    {
     "id": 1275711,
     "content_html": "Use touch as a therapeutic tool.",
     "correctness": "0.0"
    },
    {
     "id": 1275710,
     "content_html": "Sit close to the client.",
     "correctness": "0.0"
    },
    {
     "id": 1275712,
     "content_html": "Pay attention to the client’s nonverbal cues.",
     "correctness": "1.0"
    },
    {
     "id": 1275709,
     "content_html": "Maintain eye contact even if the client does not.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Nonverbal communication conveys messages without words. Cultures use different nonverbal cues to convey meaning or express emotion. The nurse should pay attention to the client’s use of nonverbal cues and not force nonverbal communication on the client."
    }
   ],
   "community_solutions": []
  }
 ],
