   "stimulus_html": "",
   "stem_html": "A community health nurse educates a group of families on healthy eating habits to reduce their risk of diabetes. The nurse encourages them to share healthy meal ideas with each other. Which domain and level of influence does this intervention address?",
   "answers": [
    {
     "id": 1275227,
     "content_html": "Behavioral and community",
     "correctness": "0.0"
    },
    {
     "id": 1275226,
     "content_html": "Behavioral and individual",
     "correctness": "0.0"
    },
    {
     "id": 1275228,
     "content_html": "Sociocultural environment and interpersonal",
     "correctness": "1.0"
    },
    {
     "id": 1275225,
     "content_html": "Sociocultural environment and societal",
     "correctness": "0.0"
    }
   ],
   "hints": [],
