   "id": 660579,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is preparing to administer a bisacodyl suppository to a client. Which of the following interventions is appropriate to ensure safe and effective administration? ",
   "answers": [
    {
     "id": 1311431,
     "content_html": "Have the client lie on their right side with their left knee raised to their chest.",
     "correctness": "0.0"
    },
    {
     "id": 1311432,
     "content_html": "Have the client lie on their left side with their right knee raised to their chest.",
     "correctness": "1.0"
    },
    {
     "id": 1311430,
     "content_html": "Remove the suppository from the refrigerator at least 15 minutes before administration to allow it to soften.",
     "correctness": "0.0"
    },
    {
     "id": 1311429,
     "content_html": "Instruct the client to stand and get dressed immediately after administration.",
     "correctness": "0.0"
    }
   ],
