 "questions": [
  {
   "id": 660285,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When administering an oral medication to a client with renal insufficiency, which potential complication is of greatest concern to the nurse?",
   "answers": [
    {
     "id": 1310255,
     "content_html": "Decreased drug absorption",
     "correctness": "0.0"
    },
    {
     "id": 1310256,
     "content_html": "Increased risk of drug toxicity",
     "correctness": "1.0"
    },
    {
     "id": 1310254,
     "content_html": "Increased risk of an allergic reaction",
     "correctness": "0.0"
    },
    {
     "id": 1310253,
     "content_html": "Decreased therapeutic drug effects",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Drugs are excreted through the kidneys, so drug toxicity can develop in the client with renal insufficiency as drug levels rise because they are not properly eliminated from the body."
    }
   ],
   "community_solutions": []
  }
