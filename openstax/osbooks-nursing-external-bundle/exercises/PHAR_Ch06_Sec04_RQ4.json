 "questions": [
  {
   "id": 660340,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client presents to the emergency department with a swollen, painful, and warm right ankle after a recent fall. The nurse observes redness and limited movement in the affected joint. The client’s vital signs are stable. Based on the assessment findings, which conclusion should the nurse draw regarding the client's condition?",
   "answers": [
    {
     "id": 1310475,
     "content_html": "The client is experiencing a localized allergic reaction, leading to inflammation and limited joint movement.",
     "correctness": "0.0"
    },
    {
     "id": 1310474,
     "content_html": "The wound site shows signs of infection, indicated by the presence of redness, swelling, and warmth.",
     "correctness": "0.0"
    },
    {
     "id": 1310476,
     "content_html": "The client is demonstrating the five cardinal signs of inflammation, suggesting the body's response to tissue injury.",
     "correctness": "1.0"
    },
    {
     "id": 1310473,
     "content_html": "The wound may be due to poor blood circulation, causing localized redness and swelling.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The five cardinal signs of inflammation are redness (rubor), swelling (tumor), warmth (calor), pain (dolor), and loss of function (functio laesa)."
    }
   ],
   "community_solutions": []
  }
