 "questions": [
  {
   "id": 660438,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following carries an electrical signal from the atria to the ventricles in the healthy heart?",
   "answers": [
    {
     "id": 1310868,
     "content_html": "Atrioventricular node",
     "correctness": "1.0"
    },
    {
     "id": 1310867,
     "content_html": "Sinoatrial node",
     "correctness": "0.0"
    },
    {
     "id": 1310866,
     "content_html": "Purkinje fibers",
     "correctness": "0.0"
    },
    {
     "id": 1310865,
     "content_html": "Bundle of His",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The signal starts in the sinoatrial node and passes through the atrioventricular node to get to the ventricles. From there, it travels through the bundles of His and Purkinje fibers."
    }
   ],
