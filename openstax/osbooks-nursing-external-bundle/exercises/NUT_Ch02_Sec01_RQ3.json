   "id": 660083,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching the client about the Mediterranean diet. Which instruction will the nurse give the client?",
   "answers": [
    {
     "id": 1309447,
     "content_html": "Decrease consumption of complex carbohydrates.",
     "correctness": "0.0"
    },
    {
     "id": 1309448,
     "content_html": "Increase intake of fish.",
     "correctness": "1.0"
    },
    {
     "id": 1309446,
     "content_html": "Avoid eating legumes.",
     "correctness": "0.0"
    },
    {
     "id": 1309445,
     "content_html": "Increase intake of dairy products.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The Mediterranean diet is high in complex carbohydrates (fruits, vegetables, beans, legumes, nuts, and seeds) as well as fish, seafood, and poultry and includes moderate amounts of dairy products."
    }
   ],
