   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The client’s spouse asks the nurse to explain a little more about tau proteins and why they are an issue. What should the nurse say?",
   "answers": [
    {
     "id": 890894,
     "content_html": "”Jamal has too many tau proteins in his brain.”",
     "correctness": "0.0"
    },
    {
     "id": 890895,
     "content_html": "“Tau proteins are genetic mutations that are causing dysfunction.”",
     "correctness": "0.0"
    },
    {
     "id": 890896,
     "content_html": "“The tau proteins are tangled and accumulate in the brain, causing dysfunction.”",
     "correctness": "1.0"
    },
    {
     "id": 890897,
     "content_html": "“There is no relationship between the tau proteins and Jamal’s symptoms.”",
     "correctness": "0.0"
