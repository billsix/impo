 "questions": [
  {
   "id": 647427,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The community health nurse is conducting a health screening of an immigrant family. Which finding is an indication of the need for T-Spot testing instead of Mantoux TST testing?",
   "answers": [
    {
     "id": 1275396,
     "content_html": "Prior vaccination with BCG",
     "correctness": "1.0"
    },
    {
     "id": 1275395,
     "content_html": "Family member who is 10 years of age",
     "correctness": "0.0"
    },
    {
     "id": 1275394,
     "content_html": "Symptoms of night sweats, fevers, chills, and hemoptysis",
     "correctness": "0.0"
    },
    {
     "id": 1275393,
     "content_html": "A negative chest X-ray and negative sputum testing for MTB",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Mantoux TST testing is the preferred test for children under the age of 5, but prior vaccination with bacilli Calmette-Guérin (BCG) may cause false positive reactions to the Mantoux TB skin test, in which case either QFT-Plus or T-Spot blood testing is recommended."
    }
   ],
   "community_solutions": []
  }
 ],
