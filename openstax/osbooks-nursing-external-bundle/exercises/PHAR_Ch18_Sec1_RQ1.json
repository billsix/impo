   "id": 660453,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client has a blood pressure of 148/96 mm Hg. According to the American Heart Association Guidelines, how should the nurse classify this blood pressure?",
   "answers": [
    {
     "id": 1310927,
     "content_html": "Normal",
     "correctness": "0.0"
    },
    {
     "id": 1310926,
     "content_html": "Elevated",
     "correctness": "0.0"
    },
    {
     "id": 1310925,
     "content_html": "Hypertension stage 1",
     "correctness": "0.0"
    },
    {
     "id": 1310928,
     "content_html": "Hypertension stage 2",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Hypertension stage 2 is classified as a systolic blood pressure of 140 mm Hg or higher or a diastolic blood pressure of 90 mm Hg or higher."
    }
   ],
   "community_solutions": []
  }
