  {
   "id": 660373,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Donepezil is an acetylcholinesterase (AChE) inhibitor. Which of the following is consistent with the action of this drug?",
   "answers": [
    {
     "id": 1310608,
     "content_html": "The drug is used to treat mild and severe forms of Alzheimer’s disease.",
     "correctness": "1.0"
    },
    {
     "id": 1310607,
     "content_html": "The drug cannot cross the blood–brain barrier.",
     "correctness": "0.0"
    },
    {
     "id": 1310606,
     "content_html": "The drug must be taken 30 minutes before meals.",
     "correctness": "0.0"
    },
    {
     "id": 1310605,
     "content_html": "The drug requires twice-daily dosing due to a short half-life.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The drug will cross the blood–brain barrier, has a 70-hour half-life, and is unaffected by oral intake."
    }
   ],
   "community_solutions": []
  }
