   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is discharging a client home with a new prescription for docusate sodium. What information should the nurse include in discharge teaching?",
   "answers": [
    {
     "id": 1311439,
     "content_html": "This medication must be taken at bedtime.",
     "correctness": "0.0"
    },
    {
     "id": 1311440,
     "content_html": "Take the medication with a full glass of water.",
     "correctness": "1.0"
    },
    {
     "id": 1311438,
     "content_html": "This medication must be taken long term for it to be fully effective.",
     "correctness": "0.0"
    },
    {
     "id": 1311437,
     "content_html": "Take the medication on an empty stomach.",
     "correctness": "0.0"
