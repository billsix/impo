  {
   "id": 660172,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with thalassemia is being discharged after receiving a transfusion of packed red blood cells. Which of the following foods should the client be instructed to limit in their diet?",
   "answers": [
    {
     "id": 1309803,
     "content_html": "Nuts",
     "correctness": "0.0"
    },
    {
     "id": 1309802,
     "content_html": "Dairy products",
     "correctness": "0.0"
    },
    {
     "id": 1309801,
     "content_html": "Apples",
     "correctness": "0.0"
    },
    {
     "id": 1309804,
     "content_html": "Iron-fortified breakfast cereals",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Iron-fortified foods such as breakfast cereals should be limited because this client is at risk for iron overload after the transfusion."
    }
   ],
   "community_solutions": []
  }
