 "questions": [
  {
   "id": 660657,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client tells the clinic nurse that after administering timolol drops in their right eye, they noticed that their heart rate decreased to 50 beats per minute. Which question by the nurse best determines the most likely cause of bradycardia?",
   "answers": [
    {
     "id": 1311743,
     "content_html": "“Did you drink alcohol that day?”",
     "correctness": "0.0"
    },
    {
     "id": 1311742,
     "content_html": "“Have you had heart trouble before?”",
     "correctness": "0.0"
    },
    {
     "id": 1311741,
     "content_html": "“How did you take your pulse?”",
     "correctness": "0.0"
    },
    {
     "id": 1311744,
     "content_html": "“How did you instill the medication?”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "If the client does not apply pressure to the nasolacrimal area to reduce drainage of this beta-blocking ocular medication into the systemic circulation, a drop in heart rate can occur."
    }
   ],
   "community_solutions": []
  }
 ],
