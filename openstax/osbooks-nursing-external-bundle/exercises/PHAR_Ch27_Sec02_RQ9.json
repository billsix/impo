   "id": 660550,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The health care provider ordered levothyroxine 0.275 mg once daily for a client with hypothyroidism. Levothyroxine is available as a 137 mcg tablet. How many tablets will the nurse administer to the client?",
   "answers": [
    {
     "id": 1311315,
     "content_html": "1",
     "correctness": "0.0"
    },
    {
     "id": 1311316,
     "content_html": "2",
     "correctness": "1.0"
    },
    {
     "id": 1311314,
     "content_html": "3",
     "correctness": "0.0"
    },
    {
     "id": 1311313,
     "content_html": "4",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "First, convert 0.275 mg to mcg, <span data-math=\"0.275\\;\\mathrm{mg}\\;\\times\\;1000\\;\\mathrm{mcg}/\\mathrm{mg}\\;=\\;275\\;\\mathrm{mcg}\"></span><br><span data-math=\"\\frac{275\\;\\mathrm{mcg}}{x\\;\\mathrm{tablets}}\"></span> (desired dose) <span data-math=\"=\\;\\frac{137\\;\\mathrm{mcg}}{\\;1\\;\\mathrm{tablet}}\"></span> (supply on hand)<br><span data-math=\"\\begin{aligned}137x&amp;=\\;275\\times1\\\\x&amp;=\\frac{275}{137}\\\\x&amp;=\\;2\\;\\mathrm{tablets}.\\end{aligned}\"></span>"
    }
   ],
   "community_solutions": []
  }
