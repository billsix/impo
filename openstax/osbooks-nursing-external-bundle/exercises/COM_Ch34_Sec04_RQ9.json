   "stimulus_html": "",
   "stem_html": "The public health nurse is involved in developing a community health program to improve nutrition using the Centers for Disease Control and Prevention’s Health in All Policies (HiAP) approach. Which action will the nurse take?",
   "answers": [
    {
     "id": 1276252,
     "content_html": "Engage all sectors to produce change",
     "correctness": "1.0"
    },
    {
     "id": 1276251,
     "content_html": "Produce change using the local health department",
     "correctness": "0.0"
    },
    {
     "id": 1276250,
     "content_html": "Present a plan for change to community partners",
     "correctness": "0.0"
    },
    {
     "id": 1276249,
     "content_html": "Develop short-term goals for program development",
     "correctness": "0.0"
    }
