 "questions": [
  {
   "id": 647401,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is counseling a client who is trying to stop smoking. According to the Theory of Planned Behavior, which factor would the nurse recognize as representing risk perception?",
   "answers": [
    {
     "id": 1275291,
     "content_html": "The client’s partner smokes.",
     "correctness": "0.0"
    },
    {
     "id": 1275290,
     "content_html": "The client’s clothes smell of smoke.",
     "correctness": "0.0"
    },
    {
     "id": 1275289,
     "content_html": "The client has tried to quit several times.",
     "correctness": "0.0"
    },
    {
     "id": 1275292,
     "content_html": "The client believes smoking is unhealthy.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The Theory of Planned Behavior explains how intention, attitudes, subjective norms, perceived behavioral control, and risk perception influence behaviors. Risk perception include a person’s thoughts about the benefits and hazards of acting or not acting, such as the belief that smoking is unhealthy."
    }
   ],
   "community_solutions": []
  }
 ],
