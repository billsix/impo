   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is constructing a teaching plan for Kai to address potential complications of COPD. Which of the following conditions will the nurse include in the plan?",
   "answers": [
    {
     "id": 890273,
     "content_html": "Asthma",
     "correctness": "0.0"
    },
    {
     "id": 890274,
     "content_html": "Respiratory syncytial virus",
     "correctness": "0.0"
    },
    {
     "id": 890275,
     "content_html": "Pulmonary fibrosis",
     "correctness": "0.0"
    },
    {
     "id": 890276,
     "content_html": "Pneumonia",
     "correctness": "1.0"
    }
   ],
