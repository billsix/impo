   "stimulus_html": "",
   "stem_html": "Which of the following is a reason why a nurse might contact the Nurses on Boards Coalition (NOBC)?",
   "answers": [
    {
     "id": 1276207,
     "content_html": "To get help in contacting their senator on a health care bill",
     "correctness": "0.0"
    },
    {
     "id": 1276206,
     "content_html": "To develop specialized clinical skills",
     "correctness": "0.0"
    },
    {
     "id": 1276208,
     "content_html": "To gain leadership skills in advocacy",
     "correctness": "1.0",
     "feedback_html": ""
    },
    {
     "id": 1276205,
     "content_html": "To obtain funds for a new community hiking trail",
     "correctness": "0.0"
    }
   ],
