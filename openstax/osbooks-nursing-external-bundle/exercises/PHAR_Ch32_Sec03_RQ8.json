 "questions": [
  {
   "id": 660600,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing client education on the drug orlistat. The nurse explains common adverse effects of orlistat that subside within 4 weeks are:",
   "answers": [
    {
     "id": 1311515,
     "content_html": "Palpitations (tachycardia)",
     "correctness": "0.0"
    },
    {
     "id": 1311514,
     "content_html": "Headache and dizziness",
     "correctness": "0.0"
    },
    {
     "id": 1311516,
     "content_html": "Diarrhea and fatty stool (steatorrhea)",
     "correctness": "1.0"
    },
    {
     "id": 1311513,
     "content_html": "Itchiness and high blood pressure",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Orlistat is not systemically absorbed and does not affect the cardiovascular and neurological systems. Common side effects are specific to the GI system—abdominal discomfort, flatus, nausea, oily rectal discharge, fecal urgency, fatty stool, and diarrhea."
    }
   ],
   "community_solutions": []
  }
