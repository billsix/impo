 "questions": [
  {
   "id": 660398,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is teaching a female client diagnosed with migraine headaches about a new prescription for sumatriptan. Which of the following instructions should the nurse include?",
   "answers": [
    {
     "id": 1310707,
     "content_html": "Take this medication every day to prevent migraine headaches.",
     "correctness": "0.0"
    },
    {
     "id": 1310708,
     "content_html": "Use contraception while taking this medication.",
     "correctness": "1.0"
    },
    {
     "id": 1310706,
     "content_html": "Take the drug every 30 minutes until the migraine headache subsides.",
     "correctness": "0.0"
    },
    {
     "id": 1310705,
     "content_html": "Monitor blood pressure every 2 hours while taking this medication.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sumatriptan is contraindicated in pregnancy, and contraception should be taken while on this drug."
    }
   ],
   "community_solutions": []
  }
