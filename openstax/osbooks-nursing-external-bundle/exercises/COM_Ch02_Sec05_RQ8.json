 "questions": [
  {
   "id": 647320,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which goal by a public health nurse is an example of quaternary prevention?",
   "answers": [
    {
     "id": 1274967,
     "content_html": "Reducing the negative impact of a health condition and preventing complications",
     "correctness": "0.0"
    },
    {
     "id": 1274966,
     "content_html": "Focusing on the early detection and treatment of disease to minimize impact",
     "correctness": "0.0"
    },
    {
     "id": 1274965,
     "content_html": "Implementing policies to address the root cause of health issues and reduce disparities",
     "correctness": "0.0"
    },
    {
     "id": 1274968,
     "content_html": "Protecting individuals from unnecessary interventions that may cause more harm than good",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Quaternary prevention refers to actions taken to protect individuals from health interventions that may be unnecessary or potentially harmful. Clients should not be subjected to tests that will ultimately not change the treatment plan. Similarly, clients should not undergo treatments or procedures that may do more harm than good."
    }
   ],
   "community_solutions": []
  }
