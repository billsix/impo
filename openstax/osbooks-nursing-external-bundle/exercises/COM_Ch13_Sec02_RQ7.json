 "questions": [
  {
   "id": 647429,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which manifestation would the nurse include when teaching about mild to moderate food poisoning at a community health fair?",
   "answers": [
    {
     "id": 1275403,
     "content_html": "Bloody diarrhea",
     "correctness": "0.0"
    },
    {
     "id": 1275402,
     "content_html": "Diarrhea lasting more than 3 days",
     "correctness": "0.0"
    },
    {
     "id": 1275401,
     "content_html": "Dehydration",
     "correctness": "0.0"
    },
    {
     "id": 1275404,
     "content_html": "Fever less than 102°F",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The signs of mild to moderate food poisoning are fever, diarrhea, stomach pain or cramps, and nausea or vomiting. The signs of severe food poisoning include fever higher than 102°F, bloody diarrhea, diarrhea for 3 days or more, frequent vomiting, and evidence of dehydration."
    }
   ],
