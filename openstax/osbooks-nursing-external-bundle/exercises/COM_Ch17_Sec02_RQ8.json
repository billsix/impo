    {
     "id": 1275567,
     "content_html": "Reward positive behaviors toward smoking cessation",
     "correctness": "0.0"
    },
    {
     "id": 1275568,
     "content_html": "Encourage reflection about smoking cessation",
     "correctness": "1.0"
    },
    {
     "id": 1275566,
     "content_html": "Model desired behaviors needed for smoking cessation",
     "correctness": "0.0"
    },
    {
     "id": 1275565,
     "content_html": "Assess knowledge to build upon what is already known about smoking cessation",
     "correctness": "0.0"
