 "questions": [
  {
   "id": 647631,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To meet the health care needs of a community, a public health nurse has been asked to join a coalition. Which characteristic of a coalition should the nurse anticipate?",
   "answers": [
    {
     "id": 1276211,
     "content_html": "An informal group that disbands when its goal is met",
     "correctness": "0.0"
    },
    {
     "id": 1276210,
     "content_html": "A social group set up for networking",
     "correctness": "0.0"
    },
    {
     "id": 1276209,
     "content_html": "A group that focuses on a specific nursing specialty",
     "correctness": "0.0"
    },
    {
     "id": 1276212,
     "content_html": "A formal group with clearly defined positions",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A coalition is a formal group with a defined leadership team, such as a chairperson, facilitator, individual members, staff, a steering committee, a lead agency, and member organizations."
    }
   ],
   "community_solutions": []
  }
 ],
