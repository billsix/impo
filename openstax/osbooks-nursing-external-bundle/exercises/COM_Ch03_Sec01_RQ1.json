 "questions": [
  {
   "id": 647323,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by the nurse demonstrates the application of community health principles to a program aimed at preventing cardiovascular disease through risk-factor modification?",
   "answers": [
    {
     "id": 1274979,
     "content_html": "Providing individual counseling sessions for adults at risk for heart disease",
     "correctness": "0.0"
    },
    {
     "id": 1274980,
     "content_html": "Promoting a weekly farmer’s market for locally grown fruits and vegetables",
     "correctness": "1.0"
    },
    {
     "id": 1274978,
     "content_html": "Assisting an adult with heart disease to develop a medication schedule that fits their lifestyle",
     "correctness": "0.0"
    },
    {
     "id": 1274977,
     "content_html": "Developing a cardiac rehabilitation program for community members with heart failure",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Community health refers to a community’s physical, mental, and social well-being and involves health promotion, risk reduction, and disease prevention efforts to support health. Promoting a weekly farmer’s market of locally grown produce provides the opportunity for the community to engage in healthy eating practices to reduce the risk for heart disease."
    }
   ],
