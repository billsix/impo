   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Harold asks the provider how beclomethasone will help his COPD. Which response by the provider is accurate?",
   "answers": [
    {
     "id": 889033,
     "content_html": "“It will reduce the inflammation in your airways.”",
     "correctness": "1.0"
    },
    {
     "id": 889034,
     "content_html": "“This medication should be used only when you have trouble breathing.”",
     "correctness": "0.0"
    },
    {
     "id": 889035,
     "content_html": "“You can stop using this medication when you feel better.”",
     "correctness": "0.0"
    },
    {
     "id": 889036,
     "content_html": "“This medication will reverse the damage to your lungs.”",
     "correctness": "0.0"
    }
   ],
