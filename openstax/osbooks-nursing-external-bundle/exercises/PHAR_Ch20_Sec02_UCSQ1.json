 "questions": [
  {
   "id": 366617,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After 6 hours, a PTT is checked and the result is 75 seconds. Using the sample algorithm in Table 20.2, how will the nurse adjust the dose?",
   "answers": [
    {
     "id": 888761,
     "content_html": "80 units/kg bolus, then increase rate by 4 units/kg/hr; recheck in 6 hours",
     "correctness": "0.0"
    },
    {
     "id": 888762,
     "content_html": "40 units/kg bolus, then increase rate by 2 units/kg/hr; recheck in 6 hours",
     "correctness": "0.0"
    },
    {
     "id": 888763,
     "content_html": "Decrease infusion rate by 2 units/kg/hr; recheck in 6 hours",
     "correctness": "1.0"
    },
    {
     "id": 888764,
     "content_html": "Interrupt infusion for 1 hour, then decrease infusion rate by 3 units/kg/hr; recheck in 6 hours",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The PTT is 75 seconds. Per the protocol, any PTT between 71 and 90 seconds will require a decrease in the heparin rate by 2 units/kg/hour."
    }
   ],
   "community_solutions": []
  }
