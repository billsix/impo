 "questions": [
  {
   "id": 660133,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client has been diagnosed with Cushing’s syndrome. Which of the following dietary recommendations are appropriate for this client?",
   "answers": [
    {
     "id": 1309647,
     "content_html": "Low-protein diet with added salt",
     "correctness": "0.0"
    },
    {
     "id": 1309646,
     "content_html": "Low-fat diet with added potassium",
     "correctness": "0.0"
    },
    {
     "id": 1309648,
     "content_html": "Low-carbohydrate diet with limited salt",
     "correctness": "1.0"
    },
    {
     "id": 1309645,
     "content_html": "High-carbohydrate diet with limited salt",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Clients with Cushing’s syndrome should limit carbohydrate and salt intake. Increased salt intake can worsen fluid retention and weight gain. Protein intake is recommended to promote structural integrity and wound healing in these clients."
    }
   ],
   "community_solutions": []
  }
