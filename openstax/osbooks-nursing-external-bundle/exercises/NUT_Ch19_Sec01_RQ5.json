 "questions": [
  {
   "id": 660256,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with a stage 2 pressure injury was prescribed protein shakes twice daily. Upon return to the office for a recheck, the pressure ulcer changed to stage 1. Which of the following findings supports the conclusion the client has improved?",
   "answers": [
    {
     "id": 1310139,
     "content_html": "A blister has now formed at the site of the pressure injury.",
     "correctness": "0.0"
    },
    {
     "id": 1310138,
     "content_html": "The site of the pressure injury shows some healthy adipose tissue.",
     "correctness": "0.0"
    },
    {
     "id": 1310140,
     "content_html": "The site of the pressure injury is red but intact.",
     "correctness": "1.0"
    },
    {
     "id": 1310137,
     "content_html": "The pressure injury diameter is smaller but deeper.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The pressure ulcer changed from a stage 2 ulcer to a stage 1 ulcer, which indicates improvement. Stage 1 pressure injuries are reddened, but not open."
    }
   ],
   "community_solutions": []
  }
