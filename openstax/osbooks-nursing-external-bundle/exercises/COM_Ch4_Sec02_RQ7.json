   "id": 647339,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which indicator is the nurse utilizing when considering the effects of diseases that people in a population are living with?",
   "answers": [
    {
     "id": 1275043,
     "content_html": "Morbidity",
     "correctness": "0.0"
    },
    {
     "id": 1275042,
     "content_html": "Mortality",
     "correctness": "0.0"
    },
    {
     "id": 1275044,
     "content_html": "Burden of disease",
     "correctness": "1.0"
    },
    {
