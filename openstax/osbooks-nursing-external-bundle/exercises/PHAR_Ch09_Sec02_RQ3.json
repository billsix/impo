   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client wearing a neck brace. The client reports the provider informed them that their “neck fracture” may cause some nerve disturbances. Which region of the spinal cord is involved?",
   "answers": [
    {
     "id": 1310576,
     "content_html": "Cervical vertebrae",
     "correctness": "1.0"
    },
    {
     "id": 1310575,
     "content_html": "Thoracic vertebrae",
     "correctness": "0.0"
    },
    {
     "id": 1310574,
     "content_html": "Sacral vertebrae",
     "correctness": "0.0"
    },
    {
     "id": 1310573,
     "content_html": "Lumbar vertebrae",
     "correctness": "0.0"
    }
   ],
