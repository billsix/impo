 "questions": [
  {
   "id": 660136,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client presents with symptoms of polycystic ovary syndrome (PCOS). Which nutritional plan would be most likely to optimize endocrine wellness for this client to regulate hormonal imbalances?",
   "answers": [
    {
     "id": 1309659,
     "content_html": "Consuming a diet high in refined carbohydrates",
     "correctness": "0.0"
    },
    {
     "id": 1309658,
     "content_html": "Limiting complex carbohydrates",
     "correctness": "0.0"
    },
    {
     "id": 1309657,
     "content_html": "Consuming a diet low in fiber",
     "correctness": "0.0"
    },
    {
     "id": 1309660,
     "content_html": "Eating a diet low in processed and packaged foods",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Eating a diet low in processed and packaged foods helps to optimize endocrine wellness. PCOS is a condition characterized by hormonal imbalances, and a diet low in processed and packaged foods can help to optimize endocrine wellness by reducing the intake of harmful additives and stabilizing blood glucose levels."
    }
   ],
   "community_solutions": []
  }
