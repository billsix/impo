   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action by a health care organization demonstrates the development of a culturally and linguistically competent plan to meet the needs of diverse populations of the community?",
   "answers": [
    {
     "id": 1275839,
     "content_html": "Informing the community about their cultural needs",
     "correctness": "0.0"
    },
    {
     "id": 1275840,
     "content_html": "Collaborating with community leaders",
     "correctness": "1.0"
    },
    {
     "id": 1275838,
     "content_html": "Developing strategies that have worked at other health care organizations",
     "correctness": "0.0"
    },
    {
     "id": 1275837,
     "content_html": "Developing consistent strategies that will not change over time",
     "correctness": "0.0"
    }
   ],
