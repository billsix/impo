   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following client statements should prompt the nurse to screen the client for food insecurity?",
   "answers": [
    {
     "id": 1309432,
     "content_html": "“I don’t have a steady income.”",
     "correctness": "1.0"
    },
    {
     "id": 1309431,
     "content_html": "“My oven does not work well.”",
     "correctness": "0.0"
    },
    {
     "id": 1309430,
     "content_html": "“Sometimes my food expires before I can eat it.”",
     "correctness": "0.0"
    },
    {
     "id": 1309429,
     "content_html": "“I don’t know any heart-healthy recipes.”",
     "correctness": "0.0"
    }
   ],
