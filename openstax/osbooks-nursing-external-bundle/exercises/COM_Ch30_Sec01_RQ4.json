  {
   "id": 647596,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse, caring for a client who will be transferred from the hospital to a rehabilitation facility following a stroke, is using a care transition model to facilitate the transfer. Which explanation for the use of a care transition model will the nurse provide to the nursing student working the client?",
   "answers": [
    {
     "id": 1276071,
     "content_html": "“Care transition models predict client outcomes during care transitions.”",
     "correctness": "0.0"
    },
    {
     "id": 1276070,
     "content_html": "“Care transition models guide health care providers in the decision-making process.”",
     "correctness": "0.0"
    },
    {
     "id": 1276072,
     "content_html": "“Care transition models support the coordination of care between health care settings.”",
     "correctness": "1.0"
    },
    {
     "id": 1276069,
     "content_html": "“Care transition models focus on client education during care transitions.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Care transition models are designed to support seamless transitions between health care settings. They provide frameworks and guidelines to ensure coordinated and client-centered care during transitions, minimizing disruptions and improving outcomes."
    }
   ],
   "community_solutions": []
