 "questions": [
  {
   "id": 647549,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to Campinha-Bacote’s “Process of Cultural Competemility in the Delivery of Healthcare Services” model, which question by a nurse represents the “E” in the mnemonic “A-S-K-E-D” for self-examination?",
   "answers": [
    {
     "id": 1275883,
     "content_html": "“Am I aware of my prejudices and biases and the presence of racism and other ‘isms’?”",
     "correctness": "0.0"
    },
    {
     "id": 1275882,
     "content_html": "“Do I know how to conduct a culturally specific history, physical, mental health, medication, and spiritual assessment in a culturally sensitive manner?”",
     "correctness": "0.0"
    },
    {
     "id": 1275881,
     "content_html": "“Do I have knowledge regarding different cultures’ worldviews, the field of biocultural ecology, and the importance of addressing social determinants of health?”",
     "correctness": "0.0"
    },
    {
     "id": 1275884,
     "content_html": "“Do I have sacred and unremitting encounters with people from cultures different from mine, and am I committed to resolving cross-cultural conflicts?”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The “E” in the mnemonic stands for encounters. This question prompts the nurse to reflect on their commitment to engaging in meaningful interactions and resolving conflicts with individuals from different cultures."
    }
   ],
   "community_solutions": []
  }
 ],
