   "id": 647492,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse knows which instruction method is most effective for adolescents?",
   "answers": [
    {
     "id": 1275655,
     "content_html": "Providing information in small segments",
     "correctness": "0.0"
    },
    {
     "id": 1275654,
     "content_html": "Including family members in the learning",
     "correctness": "0.0"
    },
    {
     "id": 1275653,
     "content_html": "Connecting material to past experiences",
     "correctness": "0.0"
    },
    {
     "id": 1275656,
     "content_html": "Incorporating peer activities into the learning process",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Nurses should consider how developmental level may affect how the population receives information. Peer influence is stronger as adolescents’ autonomy increases, so nurses may incorporate peer activities into the learning process for this population."
    }
   ],
