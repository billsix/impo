 "questions": [
  {
   "id": 660602,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A nurse is providing education to a client who has been prescribed orlistat (Alli) for weight loss. The client asks the nurse how this medication works to help with weight loss. Which response by the nurse is most accurate?",
   "answers": [
    {
     "id": 1311523,
     "content_html": "“Orlistat suppresses appetite, making you feel less hungry and eat fewer calories.”",
     "correctness": "0.0"
    },
    {
     "id": 1311522,
     "content_html": "“This medication increases your metabolism, helping you burn more calories.”",
     "correctness": "0.0"
    },
    {
     "id": 1311524,
     "content_html": "“Orlistat blocks the absorption of dietary fat, reducing calorie intake from fat and promoting weight loss.”",
     "correctness": "1.0"
    },
    {
     "id": 1311521,
     "content_html": "“It works by reducing water retention in the body, leading to weight loss.”",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Orlistat works by inhibiting the action of pancreatic lipase, an enzyme responsible for breaking down dietary fat in the small intestine. By blocking fat absorption, it reduces the number of calories absorbed from dietary fat, thus promoting weight loss."
    }
   ],
   "community_solutions": []
  }
 ],
