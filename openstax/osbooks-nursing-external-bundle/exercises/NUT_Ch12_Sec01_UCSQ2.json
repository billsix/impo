   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Tara asks about going out to dinner since she has a busy schedule. Which foods would be the best for her to choose for her diet?",
   "answers": [
    {
     "id": 898930,
     "content_html": "Fried chicken fingers and fries",
     "correctness": "0.0"
    },
    {
     "id": 898931,
     "content_html": "Well-grilled chicken salad with full-fat cheddar cheese and ranch dressing",
     "correctness": "0.0"
    },
    {
     "id": 898932,
     "content_html": "Raw sushi and rice",
     "correctness": "0.0"
    },
    {
     "id": 898933,
     "content_html": "Well-grilled steak and steamed broccoli",
     "correctness": "1.0"
    }
   ],
