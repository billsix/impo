   "stimulus_html": "",
   "stem_html": "Which of the following is a proper technique regarding otic antibiotics?",
   "answers": [
    {
     "id": 1311783,
     "content_html": "Warm the drops to above body temperature.",
     "correctness": "0.0"
    },
    {
     "id": 1311782,
     "content_html": "Instill the ear drops while seated comfortably.",
     "correctness": "0.0"
    },
    {
     "id": 1311784,
     "content_html": "Avoid touching the tip of the dropper to any surface.",
     "correctness": "1.0"
    },
    {
     "id": 1311781,
     "content_html": "Store ear drops in the refrigerator.",
     "correctness": "0.0"
    }
   ],
