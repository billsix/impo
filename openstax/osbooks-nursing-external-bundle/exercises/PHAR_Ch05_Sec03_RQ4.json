   "id": 660327,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client who is receiving a blood transfusion. During the transfusion, the client develops itching, hives, and shortness of breath. The nurse recognizes that these symptoms are most likely indicative of which of the following?",
   "answers": [
    {
     "id": 1310423,
     "content_html": "Hemolytic reaction",
     "correctness": "0.0"
    },
    {
     "id": 1310422,
     "content_html": "Febrile reaction",
     "correctness": "0.0"
    },
    {
     "id": 1310424,
     "content_html": "Allergic reaction",
     "correctness": "1.0"
    },
    {
     "id": 1310421,
     "content_html": "Circulatory overload",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Itching, hives, and shortness of breath are common symptoms of an allergic reaction to blood or blood products."
    }
   ],
   "community_solutions": []
  }
