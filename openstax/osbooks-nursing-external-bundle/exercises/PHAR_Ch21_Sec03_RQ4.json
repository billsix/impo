 "questions": [
  {
   "id": 660490,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client calls the nurse because they experienced intolerable flushing after taking over-the-counter niacin. Which intervention might the nurse recommend?",
   "answers": [
    {
     "id": 1311075,
     "content_html": "Take flush-free niacin.",
     "correctness": "0.0"
    },
    {
     "id": 1311074,
     "content_html": "Switch to immediate-release niacin.",
     "correctness": "0.0"
    },
    {
     "id": 1311076,
     "content_html": "Take aspirin 30 minutes before taking niacin.",
     "correctness": "1.0"
    },
    {
     "id": 1311073,
     "content_html": "Take niacin with an alcoholic beverage.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Flushing can be mitigated by taking an NSAID 30 minutes before taking niacin or by switching to an extended-release product."
    }
   ],
   "community_solutions": []
  }
