   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a client about their medications, which include elvitegravir, cobicistat, tenofovir, and lamivudine. Which medication would the nurse tell the client works by inhibiting integration of the HIV DNA into their own DNA?",
   "answers": [
    {
     "id": 1310503,
     "content_html": "Cobicistat",
     "correctness": "0.0"
    },
    {
     "id": 1310504,
     "content_html": "Elvitegravir",
     "correctness": "1.0"
    },
    {
     "id": 1310502,
     "content_html": "Lamivudine",
     "correctness": "0.0"
    },
    {
     "id": 1310501,
     "content_html": "Tenofovir",
     "correctness": "0.0"
    }
   ],
