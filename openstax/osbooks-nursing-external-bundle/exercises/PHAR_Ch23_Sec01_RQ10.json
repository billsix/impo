   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Sinus pain and pressure are common symptoms of sinusitis. Using pain reducers such as acetaminophen or ibuprofen can help with these symptoms."
    }
   ],
