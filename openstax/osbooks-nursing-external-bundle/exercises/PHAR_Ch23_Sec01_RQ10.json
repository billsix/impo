   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client with sinusitis reports facial discomfort and pressure. What can the nurse recommend to the client to help reduce these symptoms?",
   "answers": [
    {
     "id": 1311135,
     "content_html": "Pneumococcal vaccination",
     "correctness": "0.0"
    },
    {
     "id": 1311134,
     "content_html": "Cough drops",
     "correctness": "0.0"
    },
    {
     "id": 1311136,
     "content_html": "Pain reducers",
     "correctness": "1.0"
    },
    {
     "id": 1311133,
     "content_html": "Bronchodilators",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
