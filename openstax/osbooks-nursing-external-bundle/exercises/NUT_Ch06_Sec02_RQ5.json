 "questions": [
  {
   "id": 660127,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The patient care technician is assisting a client with Parkinson’s disease during mealtime and reports the client began to drool and cough while eating. Which action is the most appropriate from the nurse?",
   "answers": [
    {
     "id": 1309624,
     "content_html": "Perform a bedside swallow evaluation.",
     "correctness": "1.0"
    },
    {
     "id": 1309623,
     "content_html": "Tell the patient care technician to watch the client carefully for the rest of the meal.",
     "correctness": "0.0"
    },
    {
     "id": 1309622,
     "content_html": "Show the patient care technician how to suction the mouth orally.",
     "correctness": "0.0"
    },
    {
     "id": 1309621,
     "content_html": "Place a nutrition consult for tomorrow morning to initiate tube feedings.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Drooling and coughing are symptoms of dysphagia, and the client will require a dysphagia screening."
    }
   ],
   "community_solutions": []
  }
 ],
