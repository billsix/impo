   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is caring for a client with stage 3 chronic kidney disease. What is the maximum protein intake for this client who weighs 75 kg?",
   "answers": [
    {
     "id": 1309471,
     "content_html": "40 g",
     "correctness": "0.0"
    },
    {
     "id": 1309472,
     "content_html": "45 g",
     "correctness": "1.0"
    },
    {
     "id": 1309470,
     "content_html": "50 g",
     "correctness": "0.0"
    },
    {
     "id": 1309469,
     "content_html": "55 g",
     "correctness": "0.0"
    }
   ],
   "hints": [],
