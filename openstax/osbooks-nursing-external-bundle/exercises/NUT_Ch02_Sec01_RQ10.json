   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The client with stage 3 chronic kidney disease should consume no more than 0.6 g/kg of body weight daily. Therefore, <span data-math=\"0.6\\;\\text{g/kg}\\;\\times \\;75\\;\\text{kg}\\; = \\;45\\ \\, \\text{g}\"></span> of protein daily."
    }
   ],
