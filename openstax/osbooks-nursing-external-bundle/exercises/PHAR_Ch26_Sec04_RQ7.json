   "id": 660540,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client requires 120 mg of methylprednisolone. The available medication comes in a 125 mg/2 mL vial. How many milliliters should the nurse administer if rounded to the nearest tenth?",
   "answers": [
    {
     "id": 1311276,
     "content_html": "1.9 mL",
     "correctness": "1.0"
    },
    {
     "id": 1311275,
     "content_html": "1.8 mL",
     "correctness": "0.0"
    },
    {
     "id": 1311274,
     "content_html": "2.0 mL",
     "correctness": "0.0"
    },
    {
     "id": 1311273,
     "content_html": "2.1 mL",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<span data-math=\"\\frac{120\\;\\mathrm{mg}}{x\\;\\mathrm{mL}}\"></span> (desired dose) <span data-math=\"=\\;\\frac{125\\;\\mathrm{mg}}{\\;2\\;\\mathrm{mL}}\"></span> (supply on hand)<br><span data-math=\"\\begin{aligned}125x&amp;=120\\times2\\;\\\\x&amp;=\\frac{240}{125}\\;\\\\x&amp;=1.92\\;\\mathrm{mL};\\end{aligned}\"></span><br>therefore, the nurse should administer 1.9 mL per dose."
    }
   ],
   "community_solutions": []
  }
