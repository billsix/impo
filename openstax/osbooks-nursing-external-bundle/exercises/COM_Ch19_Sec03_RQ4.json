   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Members of the health education team are meeting to review the team’s progress. Which factor may adversely affect team communication?",
   "answers": [
    {
     "id": 1275631,
     "content_html": "Frequent brainstorming sessions",
     "correctness": "0.0"
    },
    {
     "id": 1275630,
     "content_html": "High level of team member engagement",
     "correctness": "0.0"
    },
    {
     "id": 1275632,
     "content_html": "Low feelings of trust",
     "correctness": "1.0"
    },
    {
     "id": 1275629,
     "content_html": "Team member roles being clear",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
