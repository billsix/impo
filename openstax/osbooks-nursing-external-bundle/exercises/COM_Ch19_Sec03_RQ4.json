   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A lack of trust among team members can be a barrier to team communication. A lack of trust impedes communication and planning because team members feel like they cannot have an open dialogue."
    }
