   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following dietary recommendations should the nurse make to John?",
   "answers": [
    {
     "id": 890325,
     "content_html": "Limit all carbohydrate intake.",
     "correctness": "0.0"
    },
    {
     "id": 890326,
     "content_html": "Increase intake of complex carbohydrates.",
     "correctness": "1.0"
    },
    {
     "id": 890327,
     "content_html": "Switch to drinking diet beverages with artificial sweeteners.",
     "correctness": "0.0"
    },
    {
     "id": 890328,
     "content_html": "Limit fluid intake and focus on solid food intake.",
     "correctness": "0.0"
    }
   ],
