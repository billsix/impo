 "questions": [
  {
   "id": 660454,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A home health nurse is monitoring a client who has a history of hypertension and is taking benazepril. Which outcome indicates a therapeutic effect of the medication?",
   "answers": [
    {
     "id": 1310931,
     "content_html": "Heart rate of 96 beats/minute",
     "correctness": "0.0"
    },
    {
     "id": 1310932,
     "content_html": "Blood pressure of 126/76 mm Hg",
     "correctness": "1.0"
    },
    {
     "id": 1310930,
     "content_html": "Potassium level of 5.1 mEq/dl",
     "correctness": "0.0"
    },
    {
     "id": 1310929,
     "content_html": "Dry cough and fatigue",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Benazepril is an ACE inhibitor and may be used alone or in combination with other drugs in the management of hypertension and heart failure. A therapeutic effect of the medication is a normal blood pressure reading; 126/76 mm Hg falls within the AHA guidelines for normal blood pressure."
    }
   ],
   "community_solutions": []
  }
