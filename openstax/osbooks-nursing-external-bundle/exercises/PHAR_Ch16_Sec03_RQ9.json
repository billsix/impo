 "questions": [
  {
   "id": 660441,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is teaching a group of cardiac rehab clients about the electrical conduction of the heart. What statement made by a client best indicates the teaching is effective?",
   "answers": [
    {
     "id": 1310879,
     "content_html": "“The sinoatrial node is a specialized bundle of nerve tissue that slows the electrical impulse.”",
     "correctness": "0.0"
    },
    {
     "id": 1310878,
     "content_html": "“The sinoatrial node is a specialized bundle of nerve tissue that causes ventricular contraction.”",
     "correctness": "0.0"
    },
    {
     "id": 1310877,
     "content_html": "“The sinoatrial node is a specialized bundle of nerve tissue that repolarizes the ventricular myocardium.”",
     "correctness": "0.0"
    },
    {
     "id": 1310880,
     "content_html": "“The sinoatrial node is a specialized bundle of nerve tissue in the right atrium called the pacemaker of the heart.”",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The SA node, known as the pacemaker of the heart, has the property of automaticity and sends out electrical impulses 60–100 times/minute."
    }
   ],
   "community_solutions": []
  }
