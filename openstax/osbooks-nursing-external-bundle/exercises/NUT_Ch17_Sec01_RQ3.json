   "id": 660235,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is assessing a client for gastrointestinal wellness. Which finding could indicate a vitamin deficiency?",
   "answers": [
    {
     "id": 1310055,
     "content_html": "Cyanotic lips",
     "correctness": "0.0"
    },
    {
     "id": 1310056,
     "content_html": "Angular cheilitis",
     "correctness": "1.0"
    },
    {
     "id": 1310054,
     "content_html": "Abdominal tenderness",
     "correctness": "0.0"
    },
    {
     "id": 1310053,
     "content_html": "Diaphoretic skin",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Angular cheilitis, or fissures and crusts in the corners of the lips, can indicate vitamin B<sub>1</sub> (thiamine), vitamin B<sub>12</sub>, or iron deficiency."
    }
   ],
