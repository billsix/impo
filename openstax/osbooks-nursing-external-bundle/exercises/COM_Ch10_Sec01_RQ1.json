   "id": 647393,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The nurse is providing education to a client with a family history of hypertension. Which statement by the client does the nurse recognize as requiring further teaching about familial risk?",
   "answers": [
    {
     "id": 1275259,
     "content_html": "“My family history increases my risk for hypertension.”",
     "correctness": "0.0"
    },
    {
     "id": 1275260,
     "content_html": "“Genetics alone predict my own health and diagnoses.”",
     "correctness": "1.0"
    },
    {
     "id": 1275258,
     "content_html": "“The interaction of genetics and environment affects health.”",
     "correctness": "0.0"
    },
    {
     "id": 1275257,
     "content_html": "“Lifestyle factors affect the genetic expression of a disease.”",
     "correctness": "0.0"
    }
   ],
