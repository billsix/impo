   "id": 660640,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A 45-year-old client with prostate cancer is undergoing treatment with bicalutamide. Which problem is a priority for the nurse to address?",
   "answers": [
    {
     "id": 1311676,
     "content_html": "Risk for injury: impaired liver function",
     "correctness": "1.0"
    },
    {
     "id": 1311675,
     "content_html": "Disturbed body image",
     "correctness": "0.0"
    },
    {
     "id": 1311674,
     "content_html": "Chronic pain",
     "correctness": "0.0"
    },
    {
     "id": 1311673,
     "content_html": "Risk for imbalanced nutrition",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
