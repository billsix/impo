   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Impaired liver function is a serious side effect of antiandrogen medications. Clients on bicalutamide have developed liver failure and died. Liver function must be monitored closely."
    }
   ],
