 "questions": [
  {
   "id": 647568,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A community nurse has just started working at a migrant health center. When preparing to work with this population, what information is important for the nurse to remember?",
   "answers": [
    {
     "id": 1275959,
     "content_html": "Only the men work in the fields around pesticides.",
     "correctness": "0.0"
    },
    {
     "id": 1275958,
     "content_html": "Migrant workers are paid the federal minimum wage.",
     "correctness": "0.0"
    },
    {
     "id": 1275957,
     "content_html": "Since they often live in employer-paid housing, housing and food insecurity is not an issue.",
     "correctness": "0.0"
    },
    {
     "id": 1275960,
     "content_html": "Many children of migrant workers are forced to work alongside their parents.",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Many children are required to work alongside their parents to help increase the family’s income. These families often live in poverty and need the extra money to survive."
    }
   ],
   "community_solutions": []
  }
 ],
