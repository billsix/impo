 "questions": [
  {
   "id": 647529,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which action should the nurse take when a client of a different culture than the nurse stares out the window while the nurse is providing preoperative instruction?",
   "answers": [
    {
     "id": 1275803,
     "content_html": "Stare out the window with the client.",
     "correctness": "0.0"
    },
    {
     "id": 1275802,
     "content_html": "Move around the bed to stand in front of the client.",
     "correctness": "0.0"
    },
    {
     "id": 1275804,
     "content_html": "Observe how the client uses eye contact.",
     "correctness": "1.0"
    },
    {
     "id": 1275801,
     "content_html": "Stop the instruction and return later.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Observing how the client uses eye contact demonstrates the nurse’s awareness that clients may have different, culture-related perceptions of eye contact. Some clients consider it rude to make eye contact with a health care professional, whereas others consider eye contact a sign of attention or respect. Following this observation, the nurse may use another method to ensure the client understands the preoperative instruction, such as the teach-back method."
    }
   ],
   "community_solutions": []
  }
 ],
