 "questions": [
  {
   "id": 660445,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A client accidentally took double their dose of metoprolol when confused about the directions. The nurse expects which of the following to occur?",
   "answers": [
    {
     "id": 1310895,
     "content_html": "The client will experience tachycardia.",
     "correctness": "0.0"
    },
    {
     "id": 1310894,
     "content_html": "The client will experience a long QT interval.",
     "correctness": "0.0"
    },
    {
     "id": 1310896,
     "content_html": "The client will experience bradycardia.",
     "correctness": "1.0"
    },
    {
     "id": 1310893,
     "content_html": "The client will experience torsade de pointes.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Metoprolol is a beta-adrenergic blocker that slows the heart rate. If a client takes too much metoprolol, they may experience bradycardia."
    }
   ],
   "community_solutions": []
  }
 ],
