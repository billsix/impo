   "stem_html": "What is the connection between education and health?",
   "answers": [
    {
     "id": 1275191,
     "content_html": "Attending a lower-quality school is associated with health literary",
     "correctness": "0.0"
    },
    {
     "id": 1275192,
     "content_html": "Higher education means higher socioeconomic position",
     "correctness": "1.0"
    },
    {
     "id": 1275190,
     "content_html": "Higher educational attainment is associated with higher health literacy rates",
     "correctness": "0.0"
    },
    {
     "id": 1275189,
     "content_html": "Health is not adversely impacted by the quality of education",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A higher education is associated with higher-paying jobs and therefore a higher socioeconomic position (SEP). SEP is a main driver of better health outcomes. Individuals with higher levels of educational attainment are more likely to live longer and healthier lives."
    }
   ],
