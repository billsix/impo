 "questions": [
  {
   "id": 666687,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">greeting = \"hi Leila\"\nname = greeting[3:]\n</pre>",
   "answers": [
    {
     "id": 1329086,
     "content_html": "<code class=\"python\" data-lang=\"python\">\" Leila\"</code>",
     "correctness": "0.0",
     "feedback_html": "The slice <code class=\"python\" data-lang=\"python\">greeting[3:]</code> starts at index 3 which is character <code class=\"python\" data-lang=\"python\">\"L\"</code>. <code class=\"python\" data-lang=\"python\">\" \"</code> is at index 2."
    },
    {
     "id": 1329087,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"Leila\"</code>",
     "correctness": "1.0",
     "feedback_html": "The string slice of <code class=\"python\" data-lang=\"python\">greeting[3:]</code> is the substring starting from index 3 up to the end of the string, which is <code class=\"python\" data-lang=\"python\">\"Leila\"</code>."
    },
    {
     "id": 1329088,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"ila\"</code>",
     "correctness": "0.0",
     "feedback_html": "Substring <code class=\"python\" data-lang=\"python\">greeting[3:]</code> starts at index 3 and includes all characters after index 3 (up to the end). What is <code class=\"python\" data-lang=\"python\">greeting[3:]</code>?"
    }
   ],
