   "stimulus_html": "",
   "stem_html": "A structure tracing the function calls made as a result of a complex recursive function call is called a _____.",
   "answers": [
    {
     "id": 877988,
     "content_html": "tree",
     "correctness": "0.0",
     "feedback_html": "The structure looks like a tree so it is called a _____ tree."
    },
    {
     "id": 877989,
     "content_html": "recursion tree",
     "correctness": "1.0",
     "feedback_html": "The structure that shows which function calls are made is called a recursion tree. A recursion tree can be used to trace how the final values are computed."
    },
    {
     "id": 877990,
     "content_html": "iteration tree",
