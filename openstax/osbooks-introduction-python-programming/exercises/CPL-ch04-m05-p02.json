 "questions": [
  {
   "id": 666423,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x = 42</code> and <code class=\"python\" data-lang=\"python\">y = 0</code>, what is the final value of <code class=\"python\" data-lang=\"python\">y</code>?\n<pre class=\"python\" data-lang=\"python\">if x &gt; 44:\n&nbsp;&nbsp;y += 2\nelif x &lt; 50:\n&nbsp;&nbsp;y += 5\n</pre>",
   "answers": [
    {
     "id": 1328320,
     "content_html": "<code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "0.0",
     "feedback_html": "42 > 44 is False, so the first branch isn't taken. 42 &lt; 50 is true, so how is y modified?"
    },
    {
     "id": 1328321,
     "content_html": "<code class=\"python\" data-lang=\"python\">5</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">x &gt; 44</code>, <code class=\"python\" data-lang=\"python\">42 &gt; 44</code>, is <code class=\"python\" data-lang=\"python\">False</code>, so <code class=\"python\" data-lang=\"python\">x &lt; 50</code> is evaluated. <code class=\"python\" data-lang=\"python\">42 &lt; 50</code> is <code class=\"python\" data-lang=\"python\">True</code>, so <code class=\"python\" data-lang=\"python\">y = 0 + 5</code>. Only one of the <code class=\"python\" data-lang=\"python\">if</code> and <code class=\"python\" data-lang=\"python\">elif</code> branches is taken."
    },
    {
     "id": 1328322,
     "content_html": "<code class=\"python\" data-lang=\"python\">7</code>",
     "correctness": "0.0",
     "feedback_html": "if and elif are chained, so both branches cannot be taken. Is x > 44 or x &lt; 50 True?"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<code class=\"python\" data-lang=\"python\">x &gt; 44</code>, <code class=\"python\" data-lang=\"python\">42 &gt; 44</code>, is <code class=\"python\" data-lang=\"python\">False</code>, so <code class=\"python\" data-lang=\"python\">x &lt; 50</code> is evaluated. <code class=\"python\" data-lang=\"python\">42 &lt; 50</code> is <code class=\"python\" data-lang=\"python\">True</code>, so <code class=\"python\" data-lang=\"python\">y = 0 + 5</code>. Only one of the <code class=\"python\" data-lang=\"python\">if</code> and <code class=\"python\" data-lang=\"python\">elif</code> branches is taken."
    }
