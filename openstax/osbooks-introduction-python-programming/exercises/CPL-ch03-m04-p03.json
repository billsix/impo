 "questions": [
  {
   "id": 666313,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the correct way to access the 17th element in a list called <code class=\"python\" data-lang=\"python\">cardList</code>?",
   "answers": [
    {
     "id": 1328034,
     "content_html": "<code class=\"python\" data-lang=\"python\">card_list[17]</code>",
     "correctness": "0.0",
     "feedback_html": "List indexes begin at 0. In order to adjust for positions beginning at 0, the index must be changed."
    },
    {
     "id": 1328035,
     "content_html": "<code class=\"python\" data-lang=\"python\">card_list(<span class=\"blue-code\">16</span>)</code>",
     "correctness": "0.0",
     "feedback_html": "List elements are accessed using square brackets."
    },
    {
     "id": 1328036,
     "content_html": "<code class=\"python\" data-lang=\"python\">card_list[16]</code>",
     "correctness": "1.0",
     "feedback_html": "Since indexes start at 0, the required number is one less than the position being accessed."
    }
   ],
