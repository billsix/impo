 "questions": [
  {
   "id": 667033,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which group of classes is hierarchical inheritance appropriate for?",
   "answers": [
    {
     "id": 1330072,
     "content_html": "<code class=\"python\" data-lang=\"python\">Cat</code>, <code class=\"python\" data-lang=\"python\">Dog</code>, <code class=\"python\" data-lang=\"python\">Bird</code>",
     "correctness": "0.0",
     "feedback_html": "There is no clear superclass that the other two classes would inherit from."
    },
    {
     "id": 1330073,
     "content_html": "<code class=\"python\" data-lang=\"python\">Employee</code>, <code class=\"python\" data-lang=\"python\">Developer</code>, <code class=\"python\" data-lang=\"python\">SalesRep</code>",
     "correctness": "1.0",
     "feedback_html": "Employee would be an appropriate superclass for <code class=\"python\" data-lang=\"python\">Developer</code> and <code class=\"python\" data-lang=\"python\">SalesRep</code>. <code class=\"python\" data-lang=\"python\">Developer</code> and <code class=\"python\" data-lang=\"python\">SalesRep</code> are not directly related."
    },
    {
     "id": 1330074,
     "content_html": "<code class=\"python\" data-lang=\"python\">Dessert</code>, <code class=\"python\" data-lang=\"python\">BakedGood</code>, <code class=\"python\" data-lang=\"python\">ApplePie</code>",
     "correctness": "0.0",
     "feedback_html": "ApplePie could inherit from both Dessert and BakedGood, which is a different type of inheritance."
    }
   ],
