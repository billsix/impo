 "questions": [
  {
   "id": 665849,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">number = \"12\"\nnumber_of_digits = len(number)\nprint(\"Number\", number, \"has\", number_of_digits, \"digits.\")\n</pre>\n",
   "answers": [
    {
     "id": 1327510,
     "content_html": "<code class=\"python\" data-lang=\"python\">Number 12 has 12 digits.</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">len()</code> function returns the number of characters in a string. The variable number has 2 characters, therefore, the <code class=\"python\" data-lang=\"python\">number_of_digits</code> will be 2. What is the printed line?"
    },
    {
     "id": 1327511,
     "content_html": "<code class=\"python\" data-lang=\"python\">Number 12 has 2 digits.</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">number_of_digits</code> variable's value is <code class=\"python\" data-lang=\"python\">2</code>, and as such, the output is <code class=\"python\" data-lang=\"python\">\"Number 12 has 2 digits.\"</code>."
    },
    {
     "id": 1327512,
     "content_html": "<code class=\"python\" data-lang=\"python\">Number 12 has number_of_digits digits.</code>",
     "correctness": "0.0",
     "feedback_html": "The value for the <code class=\"python\" data-lang=\"python\">number_of_digits</code> variable must be printed instead of the variable name."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The <code class=\"python\" data-lang=\"python\">number_of_digits</code> variable's value is <code class=\"python\" data-lang=\"python\">2</code>, and as such, the output is <code class=\"python\" data-lang=\"python\">\"Number 12 has 2 digits.\"</code>."
    }
