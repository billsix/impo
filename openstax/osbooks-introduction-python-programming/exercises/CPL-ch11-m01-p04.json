 "questions": [
  {
   "id": 391534,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is a benefit of encapsulation when developing complex programs?",
   "answers": [
    {
     "id": 919601,
     "content_html": "All objects can easily access and modify each other's data.",
     "correctness": "0.0",
     "feedback_html": "If all objects can modify each other's data, the complex program becomes more difficult to organize and debug. Encapsulation involves restricting data access."
    },
    {
     "id": 919602,
     "content_html": "Each object's data is restricted for intentional access.",
     "correctness": "1.0",
     "feedback_html": "Limiting data access prevents accidental changes and makes relationships between objects clearer."
    }
   ],
