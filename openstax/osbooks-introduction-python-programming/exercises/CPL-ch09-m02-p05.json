  {
   "id": 666777,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the final value of i for the following counting for loop?\n<br>\n<code class=\"python\" data-lang=\"python\">for i in range(0, len(my_list)):</code>",
   "answers": [
    {
     "id": 1329352,
     "content_html": "9",
     "correctness": "0.0",
     "feedback_html": "9 is the last element of the list. The values of i are dependent on the range function."
    },
    {
     "id": 1329353,
     "content_html": "4",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">len(my_list)</code> is 5. A counting for loop ends at 1 less than the second value in the range function, so the final value of i would be 1."
    },
    {
     "id": 1329354,
     "content_html": "5",
     "correctness": "0.0",
     "feedback_html": "The length of the list is 5. So what would the final value of i be?"
    }
