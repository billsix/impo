 "questions": [
  {
   "id": 666955,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<pre class=\"python\" data-lang=\"python\">def rec_fact(n):\n&nbsp;&nbsp;if n &lt; 0:\n&nbsp;&nbsp;&nbsp;&nbsp;return -1\n&nbsp;&nbsp;else:\n&nbsp;&nbsp;&nbsp;&nbsp;return n * rec_fact(n - 1)</pre>",
   "answers": [
    {
     "id": 1329860,
     "content_html": "<code class=\"python\" data-lang=\"python\">355687428096000</code>",
     "correctness": "0.0",
     "feedback_html": "The correct base case to stop the function if a positive number is the initial parameter value is not included so the function continues to execute until n == -1, at which case -1 is returned. 0 would have been returned from the previous call, thereby zeroing out all computations."
    },
    {
     "id": 1329861,
     "content_html": "<code class=\"python\" data-lang=\"python\">0</code>",
     "correctness": "1.0",
     "feedback_html": "The base case of <code class=\"python\" data-lang=\"python\">n == 1</code> is not used in the function. When <code class=\"python\" data-lang=\"python\">n</code> is <code class=\"python\" data-lang=\"python\">0</code>, the overall multiplication becomes <code class=\"python\" data-lang=\"python\">0</code>. The recursion begins returning once the <code class=\"python\" data-lang=\"python\">n &lt; 0</code> base case is reached, initially returning <code class=\"python\" data-lang=\"python\">-1</code>. But the previous recursive call would return <code class=\"python\" data-lang=\"python\">0</code>, thereby zeroing out all computations and leaving an overall result of <code class=\"python\" data-lang=\"python\">0</code>."
    },
    {
     "id": 1329862,
     "content_html": "no result / infinite computation",
     "correctness": "0.0",
     "feedback_html": "The correct base case is not included in the function, however there is a different value of n at which the recursion begins returning."
    }
   ],
