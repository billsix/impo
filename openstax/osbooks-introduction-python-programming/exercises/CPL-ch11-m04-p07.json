 "questions": [
  {
   "id": 666931,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many operators are overloaded?",
   "answers": [
    {
     "id": 1329800,
     "content_html": "3",
     "correctness": "1.0",
     "feedback_html": "&lt;, &gt;, and == are overloaded with <code class=\"python\" data-lang=\"python\">__lt__()</code>, <code class=\"python\" data-lang=\"python\">__gt__()</code>, and <code class=\"python\" data-lang=\"python\">__eq__()</code>, respectively."
    },
    {
     "id": 1329801,
     "content_html": "4",
     "correctness": "0.0",
     "feedback_html": "__init__() and __str__() are magic methods but do not represent operators that are overloaded. __lt__(), __gt__(), and __eq__() are overloaded."
    },
    {
     "id": 1329802,
     "content_html": "5",
     "correctness": "0.0",
     "feedback_html": "The class definition has 5 magic methods, but 3 are overloading operators."
    }
   ],
