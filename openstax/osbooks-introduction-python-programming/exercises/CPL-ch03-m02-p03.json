 "questions": [
  {
   "id": 666293,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How can the following code be rewritten using an f-string?\n<pre class=\"python\" data-lang=\"python\">print(x, \"+\", y, \"=\", x + y)\n</pre>",
   "answers": [
    {
     "id": 1327974,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(f\"x + y = {x+y}\")</code>",
     "correctness": "0.0",
     "feedback_html": "The values of x and y should be printed, not the literal text \"x + y\"."
    },
    {
     "id": 1327975,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(f\"{x + y} = {x + y}\")</code>",
     "correctness": "0.0",
     "feedback_html": "This string displays the sum of x and y on the left, rather than the values of x and y."
    },
    {
     "id": 1327976,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(f\"{x} + {y} = {x+y}\")</code>",
     "correctness": "1.0",
     "feedback_html": "Using an f-string allows the entire output to be specified without commas and extra quote marks."
    }
   ],
