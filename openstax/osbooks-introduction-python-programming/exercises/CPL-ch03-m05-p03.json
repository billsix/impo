 "questions": [
  {
   "id": 666321,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which creates a tuple with three elements?",
   "answers": [
    {
     "id": 1328058,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_tuple = 'a', 'b', 'c'</code>",
     "correctness": "1.0",
     "feedback_html": "A tuple must be created using commas. Parentheses are optional but recommended. The three elements are <code class=\"python\" data-lang=\"python\">\"a\"</code>, <code class=\"python\" data-lang=\"python\">\"b\"</code>, and <code class=\"python\" data-lang=\"python\">\"c\"</code>."
    },
    {
     "id": 1328059,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_tuple = ['a', 'b', 'c']</code>",
     "correctness": "0.0",
     "feedback_html": "Square brackets are used to create lists."
    },
    {
     "id": 1328060,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_tuple = ('a', 'b', 'c')</code>",
     "correctness": "0.0",
     "feedback_html": "Tuples can contain different types, including nested tuples. The line creates a tuple with one element: a tuple containing 'a', 'b', 'c'."
    }
