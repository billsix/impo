 "questions": [
  {
   "id": 666337,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose the following is added to the code above:\n<pre class=\"python\" data-lang=\"python\">is_dessert = 0\nprint(type(is_dessert))\n</pre>\nWhat is the output?",
   "answers": [
    {
     "id": 1328106,
     "content_html": "<code class=\"python\" data-lang=\"python\">&lt;class 'bool'&gt;</code>",
     "correctness": "0.0",
     "feedback_html": "is_dessert was of type bool, but assigning the value 0 results in implicit type conversion."
    },
    {
     "id": 1328107,
     "content_html": "<code class=\"python\" data-lang=\"python\">&lt;class 'int'&gt;</code>",
     "correctness": "1.0",
     "feedback_html": "Assigning a bool with an <code class=\"python\" data-lang=\"python\">int</code> results in implicit type conversion. The type conversion can cause issues later in the code if the programmer assumes <code class=\"python\" data-lang=\"python\">is_dessert</code> is still a Boolean."
    },
    {
     "id": 1328108,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "Python allows for and performs implicit type conversion, even if the programmer did not intend to."
    }
   ],
