 "questions": [
  {
   "id": 666721,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">\"school\".index(\"ooo\")</code>?",
   "answers": [
    {
     "id": 1329188,
     "content_html": "<code class=\"python\" data-lang=\"python\">3</code>",
     "correctness": "0.0",
     "feedback_html": "The index of the first occurrence of \"o\" is 3, but the entire substring \"ooo\" does not exist in the string \"ooo\". What happens if a substring does not exist in the given string when checking for the index?"
    },
    {
     "id": 1329189,
     "content_html": "<code class=\"python\" data-lang=\"python\">4</code>",
     "correctness": "0.0",
     "feedback_html": "4 is the index of the last occurrence of \"o\" in the string \"school\". Yet, the entire substring \"ooo\" does not exist in the string \"school\". What must be returned by the <code class=\"python\" data-lang=\"python\">index()</code> function if the substring is not found in the given string?"
    },
    {
     "id": 1329190,
     "content_html": "<code class=\"python\" data-lang=\"python\">ValueError</code>",
     "correctness": "1.0",
     "feedback_html": "Substring <code class=\"python\" data-lang=\"python\">\"ooo\"</code> does not exist in the string <code class=\"python\" data-lang=\"python\">\"ooo\"</code> and hence the <code class=\"python\" data-lang=\"python\">index()</code> method returns a <code class=\"python\" data-lang=\"python\">ValueError</code>."
    }
   ],
