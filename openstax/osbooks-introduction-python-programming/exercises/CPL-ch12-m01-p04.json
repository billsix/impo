   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many total steps does it take to solve two rings?",
   "answers": [
    {
     "id": 919652,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "2 rings cannot be directly solved since only 1 ring can be moved at a time."
    },
    {
     "id": 919653,
     "content_html": "2",
     "correctness": "0.0",
     "feedback_html": "2 moves would move each ring to one tower each. 1 ring from source to middle, 1 ring from source to target."
    },
    {
     "id": 919654,
     "content_html": "3",
     "correctness": "1.0",
     "feedback_html": "The small ring is moved to the middle tower. The bigger ring is moved to the target tower. Then, the small ring is moved from the middle to the target."
    }
