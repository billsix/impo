   "id": 666895,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many times is <code class=\"python inline-code\" data-lang=\"python\">__init__()</code> called?",
   "answers": [
    {
     "id": 1329694,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">room_1 = Rectangle()</code> and <code class=\"python\" data-lang=\"python\">room_3 = Rectangle()</code> both call the constructor to create an instance."
    },
    {
     "id": 1329695,
     "content_html": "2",
     "correctness": "1.0",
     "feedback_html": "Two instances, <code class=\"python\" data-lang=\"python\">room_1</code> and <code class=\"python\" data-lang=\"python\">room_3</code>, are created by calling <code class=\"python\" data-lang=\"python\">Rectangle()</code>, which calls the constructor <code class=\"python\" data-lang=\"python\">__init__()</code>."
    },
    {
     "id": 1329696,
     "content_html": "3",
     "correctness": "0.0",
     "feedback_html": "room_1 and room_3 both call the constructor to create instances. The instance names are arbitrary and do not indicate the count of instances."
    }
