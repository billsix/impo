 "questions": [
  {
   "id": 666855,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(numbers.values())</code>?",
   "answers": [
    {
     "id": 1329576,
     "content_html": "<code class=\"python\" data-lang=\"python\">[1, 2, 3]</code>",
     "correctness": "0.0",
     "feedback_html": "The return type of <code class=\"python\" data-lang=\"python\">values()</code> function is not a list and printing the returned value will also not be a list."
    },
    {
     "id": 1329577,
     "content_html": "<code class=\"python\" data-lang=\"python\">dict_keys([1, 2, 3])</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">numbers.values()</code> returns the dictionary values and the return type is <code class=\"python\" data-lang=\"python\">dict_values</code>, not <code class=\"python\" data-lang=\"python\">dict_keys</code>."
    },
    {
     "id": 1329578,
     "content_html": "<code class=\"python\" data-lang=\"python\">dict_values([1, 2, 3])</code>",
     "correctness": "1.0",
     "feedback_html": "The values in the numbers dictionary are <code class=\"python\" data-lang=\"python\">1</code>, <code class=\"python\" data-lang=\"python\">2</code>, and <code class=\"python\" data-lang=\"python\">3</code>. When printing <code class=\"python\" data-lang=\"python\">numbers.values()</code>, <code class=\"python\" data-lang=\"python\">dict_values([1, 2, 3])</code> is printed."
    }
   ],
