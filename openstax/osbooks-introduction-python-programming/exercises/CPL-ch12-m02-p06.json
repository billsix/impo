   "id": 666951,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<pre class=\"python\" data-lang=\"python\">def rec_fact(n):\n&nbsp;&nbsp;if n &lt; 0:\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"error\")\n&nbsp;&nbsp;elif n == 0:\n&nbsp;&nbsp;&nbsp;&nbsp;return n\n&nbsp;&nbsp;else:\n&nbsp;&nbsp;&nbsp;&nbsp;return n * rec_fact(n - 1)</pre>",
   "answers": [
    {
     "id": 1329848,
     "content_html": "<code class=\"python\" data-lang=\"python\">355687428096000</code>",
     "correctness": "0.0",
     "feedback_html": "17! is 355687428096000. The recursive function as written will not return the correct result."
    },
    {
     "id": 1329849,
     "content_html": "<code class=\"python\" data-lang=\"python\">0</code>",
     "correctness": "1.0",
     "feedback_html": "This definition of <code class=\"python\" data-lang=\"python\">rec_fact()</code> uses a base case of <code class=\"python\" data-lang=\"python\">n == 0</code>, which works because, just like <code class=\"python\" data-lang=\"python\">1!</code>, <code class=\"python\" data-lang=\"python\">0! = 1</code>. However, the base case of <code class=\"python\" data-lang=\"python\">n == 0</code> returns <code class=\"python\" data-lang=\"python\">n</code>, which at this stage is <code class=\"python\" data-lang=\"python\">0</code>, and therefore zeroes out the rest of the computation."
    },
    {
     "id": 1329850,
     "content_html": "no result / infinite computation",
     "correctness": "0.0",
     "feedback_html": "The base case of n == 1 is not used in the function, however a different base case is used."
    }
   ],
