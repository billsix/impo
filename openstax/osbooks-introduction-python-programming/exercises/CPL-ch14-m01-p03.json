   "id": 667057,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the result of the following code?\n<pre class=\"python\" data-lang=\"python\">fileobj = open(\"newfile.txt\")\nprint(fileobj)</pre>",
   "answers": [
    {
     "id": 1330138,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "The code executes without errors."
    },
    {
     "id": 1330139,
     "content_html": "Information about the object <code class=\"python\" data-lang=\"python\">fileobj</code> is printed.",
     "correctness": "1.0",
     "feedback_html": "Python interprets this command as the programmer trying to print the object details. The object details are printed. Ex: <code class=\"python\" data-lang=\"python\">&lt;_io.TextIOWrapper name='newfile.txt' mode='r' encoding='cp1252'&gt;</code>."
    },
    {
     "id": 1330140,
     "content_html": "The contents of <i>newfile.txt</i> are printed.",
     "correctness": "0.0",
     "feedback_html": "Additional programming is required to print the contents of the file opened and associated with the file object."
    }
   ],
