   "stimulus_html": "",
   "stem_html": "Consider the example above. Which accesses <code class=\"python\" data-lang=\"python\">tuple_1'</code>s first element?",
   "answers": [
    {
     "id": 1328046,
     "content_html": "<code class=\"python\" data-lang=\"python\">tuple_1[0]</code>",
     "correctness": "1.0",
     "feedback_html": "The first element, <code class=\"python\" data-lang=\"python\">2</code>, is at index 0."
    },
    {
     "id": 1328047,
     "content_html": "<code class=\"python\" data-lang=\"python\">tuple_1[1]</code>",
     "correctness": "0.0",
     "feedback_html": "Indexing starts at 0, so the first element is at index 0."
    },
    {
     "id": 1328048,
     "content_html": "<code class=\"python\" data-lang=\"python\">tuple_1[2]</code>",
     "correctness": "0.0",
     "feedback_html": "The first element's value is 2, but index 2 refers to the third element, 4."
    }
