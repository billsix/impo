 "questions": [
  {
   "id": 667059,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct way to use the <code class=\"python\" data-lang=\"python\">read()</code> function to read the contents of <i>input.txt</i> into a string <code class=\"python\" data-lang=\"python\">file_str</code>?",
   "answers": [
    {
     "id": 1330144,
     "content_html": "<code class=\"python\" data-lang=\"python\">file_str = read(fileobj)</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">read()</code> function does not take the file object as an argument. A syntax error will result."
    },
    {
     "id": 1330145,
     "content_html": "<code class=\"python\" data-lang=\"python\">file_str = read(\"input.txt\")</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">read()</code> function cannot take a filename as an argument. An error will result."
    },
    {
     "id": 1330146,
     "content_html": "<code class=\"python\" data-lang=\"python\">file_str = fileobj.read()</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">read()</code> function is called on <code class=\"python\" data-lang=\"python\">fileobj</code>. The file's contents will be read into <code class=\"python\" data-lang=\"python\">file_str</code>."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
