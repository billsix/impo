 "questions": [
  {
   "id": 665961,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A program has the line <code class=\"python\" data-lang=\"python\">pounds = ounces // 16</code>. What is likely the next line of code?",
   "answers": [
    {
     "id": 1327812,
     "content_html": "<code class=\"python\" data-lang=\"python\">ounces = ounces % 16</code>",
     "correctness": "1.0",
     "feedback_html": "Programs that use floor division often use modulo on the next line."
    },
    {
     "id": 1327813,
     "content_html": "<code class=\"python\" data-lang=\"python\">pounds = ounces % 16</code>",
     "correctness": "0.0",
     "feedback_html": "The previous line already assigned the pounds variable."
    },
    {
     "id": 1327814,
     "content_html": "<code class=\"python\" data-lang=\"python\">ounces = ounces - pounds * 16</code>",
     "correctness": "0.0",
     "feedback_html": "This approach is less elegant than using the modulo operator, but the result is the same."
    }
   ],
