   "id": 666629,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which line will cause an error?\n<pre class=\"python line-numbering\" data-lang=\"python\">def hello():\n&nbsp;&nbsp;print(\"Hello!\")\n\ndef hello(name):\n&nbsp;&nbsp;print(\"Hello,\", name)\n\nhello()\nhello(\"Chris\")\n</pre>",
   "answers": [
    {
     "id": 1328924,
     "content_html": "line 4",
     "correctness": "0.0",
     "feedback_html": "Redefining a function does not cause an error.\nThe hello() function now requires a name argument.\n"
    },
    {
     "id": 1328925,
     "content_html": "line 7",
     "correctness": "1.0",
     "feedback_html": "The most recent definition of <code class=\"python\" data-lang=\"python\">hello()</code> requires one argument,\nso this line would result in an error."
    },
    {
     "id": 1328926,
     "content_html": "line 8",
     "correctness": "0.0",
     "feedback_html": "The most recent definition of hello() requires one argument,\nso this line would not cause an error."
    }
