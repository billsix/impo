   "id": 666879,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">numbers = [1, 2, 3, 4, 5]\nmy_dict = {x: x**2 for x in numbers if x % 2 == 0}\nprint(my_dict)\n</pre>",
   "answers": [
    {
     "id": 1329646,
     "content_html": "<code class=\"python\" data-lang=\"python\">{1: 1, 3: 9, 5: 25}</code>",
     "correctness": "0.0",
     "feedback_html": "Dictionary <code class=\"python\" data-lang=\"python\">my_dict</code> holds keys that are even, not odd."
    },
    {
     "id": 1329647,
     "content_html": "<code class=\"python\" data-lang=\"python\">{2: 4, 4: 16}</code>",
     "correctness": "1.0",
     "feedback_html": "Keys in the dictionary are even values in the list <code class=\"python\" data-lang=\"python\">numbers</code>, and associated values are the powers of two."
    },
    {
     "id": 1329648,
     "content_html": "<code class=\"python\" data-lang=\"python\">{1: 2, 2: 4, 3: 6, 4: 8, 5: 10}</code>",
     "correctness": "0.0",
     "feedback_html": "The dictionary <code class=\"python\" data-lang=\"python\">my_dict</code> only holds even keys from values in the list <code class=\"python\" data-lang=\"python\">numbers</code> that are even."
    }
   ],
