   "id": 666833,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The <code class=\"python\" data-lang=\"python\">encoding</code> dictionary contains duplicate keys since it has both <code class=\"python\" data-lang=\"python\">\"a\"</code> and <code class=\"python\" data-lang=\"python\">\"A\"</code> as keys.",
   "answers": [
    {
     "id": 1329511,
     "content_html": "true",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"a\"</code> and <code class=\"python\" data-lang=\"python\">\"A\"</code> are different keys. A dictionary cannot have duplicate keys because a key is used to lookup values."
    },
    {
     "id": 1329512,
     "content_html": "false",
     "correctness": "1.0",
     "feedback_html": "A dictionary cannot have duplicate keys, and <code class=\"python\" data-lang=\"python\">\"a\"</code> and <code class=\"python\" data-lang=\"python\">\"A\"</code> are two different keys because <code class=\"python\" data-lang=\"python\">\"a\"</code> and <code class=\"python\" data-lang=\"python\">\"A\"</code> are different characters."
    }
   ],
