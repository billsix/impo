 "questions": [
  {
   "id": 667061,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct way to use the <code class=\"python\" data-lang=\"python\">readlines()</code> function?",
   "answers": [
    {
     "id": 1330149,
     "content_html": "<code class=\"python\" data-lang=\"python\">file_lines = readlines(fileobj)</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">readlines()</code> function does not take a file object as an argument."
    },
    {
     "id": 1330150,
     "content_html": "<code class=\"python\" data-lang=\"python\">file_lines = fileobj.readlines()</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">readlines()</code> function is called on <code class=\"python\" data-lang=\"python\">fileobj</code>. <code class=\"python\" data-lang=\"python\">file_lines</code> is the string list <code class=\"python\" data-lang=\"python\">['Hello world!\\n', 'How are you?\\n']</code>."
    }
   ],
