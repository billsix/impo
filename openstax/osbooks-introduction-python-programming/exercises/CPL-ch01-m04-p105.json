 "questions": [
  {
   "id": 665845,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the return value for <code class=\"python\" data-lang=\"python\">len(\"Hi Ali\")</code>?",
   "answers": [
    {
     "id": 1327498,
     "content_html": "<code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">len()</code> function returns the total number of characters in a string. Whitespace characters do not split the string into multiple parts."
    },
    {
     "id": 1327499,
     "content_html": "<code class=\"python\" data-lang=\"python\">5</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">len()</code> function counts and returns the total number of characters in a string. All characters (including delimiters such as \",\" or \" \") must be counted when calculating the length of the string."
    },
    {
     "id": 1327500,
     "content_html": "<code class=\"python\" data-lang=\"python\">6</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">len()</code> function returns the number of characters in the string. 6 characters exist in <code>\"Hi Ali\"</code> which are \"H\", \"i\", \" \", \"A\", \"l\", and \"i\"."
    }
   ],
