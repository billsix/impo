 "questions": [
  {
   "id": 666533,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Control flow moves to line 12, and <code class=\"python\" data-lang=\"python\">extra_lot()</code> is called. Which line does control flow move to after line 3 is executed?\n<pre class=\"python line-numbering\" data-lang=\"python\">def extra_lot():\n&nbsp;&nbsp;\"\"\"Output extra parking lot info.\"\"\"\n&nbsp;&nbsp;print(\"Take the second right to park.\")\n\ndef park_greet():\n&nbsp;&nbsp;\"\"\"Output greeting.\"\"\"\n&nbsp;&nbsp;print(\"Welcome. Open sunrise to sunset.\")\n\ncar_count = 1\npark_greet()\nif car_count &gt; 50:\n&nbsp;&nbsp;extra_lot()\n</pre>",
   "answers": [
    {
     "id": 1328652,
     "content_html": "5",
     "correctness": "0.0",
     "feedback_html": "After line 3 is executed, control flow does not continue to the next line because extra_lot() has completed. Control flow returns to the line that called extra_lot()."
    },
    {
     "id": 1328653,
     "content_html": "8",
     "correctness": "0.0",
     "feedback_html": "After extra_lot() has been executed, control flow moves back to where the function was called, not the start of the program."
    },
    {
     "id": 1328654,
     "content_html": "12",
     "correctness": "1.0",
     "feedback_html": "Control flow returns to the line that called the function. Line 12 contains the function call to <code class=\"python\" data-lang=\"python\">extra_lot()</code>, so control flow returns to line 12."
    }
   ],
   "hints": [],
