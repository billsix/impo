   "id": 666571,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would be the value of <code class=\"python\" data-lang=\"python\">x2</code> for the function call, <code class=\"python\" data-lang=\"python\">calc_distance(2, 4, 3, 6)</code>?",
   "answers": [
    {
     "id": 1328760,
     "content_html": "<code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "0.0",
     "feedback_html": "2 is the first argument, which corresponds to x1, the first parameter. x2 is the third parameter."
    },
    {
     "id": 1328761,
     "content_html": "<code class=\"python\" data-lang=\"python\">4</code>",
     "correctness": "0.0",
     "feedback_html": "4 is the second argument, which corresponds to y1, the second parameter. x2 is the third parameter."
    },
    {
     "id": 1328762,
     "content_html": "<code class=\"python\" data-lang=\"python\">3</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">3</code> is a literal passed as the third argument, which corresponds to <code class=\"python\" data-lang=\"python\">x2</code>, the third parameter."
    },
    {
     "id": 1328763,
     "content_html": "<code class=\"python\" data-lang=\"python\">6</code>",
     "correctness": "0.0",
     "feedback_html": "6 is the fourth argument, which corresponds to y2, the fourth parameter. x2 is the third parameter."
    },
    {
     "id": 1328764,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "Literals can be passed directly as function arguments. x2 is the third parameter of calc_distance()."
    }
