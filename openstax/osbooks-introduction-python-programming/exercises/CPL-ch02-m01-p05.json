   "stem_html": "What keys would the user press to go back two lines?",
   "answers": [
    {
     "id": 917969,
     "content_html": "press the up arrow twice",
     "correctness": "1.0",
     "feedback_html": "Pressing the up arrow twice moves to the line before the previous line."
    },
    {
     "id": 917970,
     "content_html": "press the down arrow twice",
     "correctness": "0.0",
     "feedback_html": "Pressing the down arrow twice has no effect, because the down arrow would move to the next line."
    },
    {
     "id": 917971,
     "content_html": "press the left arrow twice",
     "correctness": "0.0",
     "feedback_html": "Pressing the left arrow twice has no effect, because the left arrow moves to the beginning of the current line."
    }
