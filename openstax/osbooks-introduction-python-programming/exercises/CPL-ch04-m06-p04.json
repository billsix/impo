 "questions": [
  {
   "id": 666445,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x =118</code>, <code class=\"python\" data-lang=\"python\">y = 300</code>, and <code class=\"python\" data-lang=\"python\">max = 512</code>, which of the following will execute?\n<pre class=\"python\" data-lang=\"python\">if x == y:\n&nbsp;&nbsp;# Body 1\nelif x &lt; y:\n&nbsp;&nbsp;# Body 2\n&nbsp;&nbsp;if y &gt;= max:\n&nbsp;&nbsp;&nbsp;&nbsp;# Body 3\nelse:\n&nbsp;&nbsp;# Body 4\nelse:\n&nbsp;&nbsp;# Body 5\n</pre>",
   "answers": [
    {
     "id": 1328390,
     "content_html": "<code class=\"python\" data-lang=\"python\">Body 2</code>",
     "correctness": "0.0",
     "feedback_html": "Which if statement is the else statement with Body 5 connected to?"
    },
    {
     "id": 1328391,
     "content_html": "<code class=\"python\" data-lang=\"python\">Body 3</code>",
     "correctness": "0.0",
     "feedback_html": "The else with Body 4 is not indented and is connected to the preceding if-elif statement. Thus the else with Body 5 is not connected to a statement."
    },
    {
     "id": 1328392,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "1.0",
     "feedback_html": "The first <code class=\"python\" data-lang=\"python\">else</code> isn't indented and is treated as the <code class=\"python\" data-lang=\"python\">else</code> to the original <code class=\"python\" data-lang=\"python\">if</code>. Thus the second <code class=\"python\" data-lang=\"python\">else</code> is not connected to an <code class=\"python\" data-lang=\"python\">if</code> statement and produces an error."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
