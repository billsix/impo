 "questions": [
  {
   "id": 666325,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why does the following code produce an error?\n<pre class=\"python\" data-lang=\"python\">tuple_1 = ('alpha', 'bravo', 'charlie')\ntuple_1.append('charlie')\n</pre>",
   "answers": [
    {
     "id": 1328070,
     "content_html": "Append isn't allowed.",
     "correctness": "1.0",
     "feedback_html": "Tuples are immutable. No changes, including appending, can be made after the tuple is created."
    },
    {
     "id": 1328071,
     "content_html": "Duplicates aren't allowed.",
     "correctness": "0.0",
     "feedback_html": "Duplicate elements are allowed in tuples. tuple_1 = ('alpha', 'bravo', 'charlie', 'charlie') wouldn't produce an error."
    },
    {
     "id": 1328072,
     "content_html": "Strings aren't allowed",
     "correctness": "0.0",
     "feedback_html": "Tuples can contain many different types, including strings. But tuples are immutable."
    }
   ],
