 "questions": [
  {
   "id": 666619,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which import statement would be needed before running <code class=\"python\" data-lang=\"python\">print(sqrt(25))</code>?",
   "answers": [
    {
     "id": 1328894,
     "content_html": "<code class=\"python\" data-lang=\"python\">from math import sqrt</code>",
     "correctness": "1.0",
     "feedback_html": "This statement imports the <code class=\"python\" data-lang=\"python\">sqrt</code> function defined in the math module."
    },
    {
     "id": 1328895,
     "content_html": "<code class=\"python\" data-lang=\"python\">import sqrt from math</code>",
     "correctness": "0.0",
     "feedback_html": "This statement is a syntax error, because the from keyword must come first."
    },
    {
     "id": 1328896,
     "content_html": "<code class=\"python\" data-lang=\"python\">import math</code>",
     "correctness": "0.0",
     "feedback_html": "This statement imports the math module, but not the sqrt function."
    }
   ],
