  {
   "id": 667043,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the value of <code class=\"python\" data-lang=\"python\">c_inst.c_attr</code>?",
   "answers": [
    {
     "id": 1330102,
     "content_html": "<code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "0.0",
     "feedback_html": "The argument 2 maps to b_attr in C's __init__()."
    },
    {
     "id": 1330103,
     "content_html": "<code class=\"python\" data-lang=\"python\">20</code>",
     "correctness": "1.0",
     "feedback_html": "An argument is not passed to <code class=\"python\" data-lang=\"python\">C'</code>s <code class=\"python\" data-lang=\"python\">__init__()</code> for <code class=\"python\" data-lang=\"python\">c_attr</code>, so <code class=\"python\" data-lang=\"python\">c_attr</code> is assigned with the default value, <code class=\"python\" data-lang=\"python\">20</code>."
    },
    {
     "id": 1330104,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "c_attr is C's instance attribute, so c_inst has access to c_attr."
    }
   ],
