   "id": 666655,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the value of <code class=\"python\" data-lang=\"python\">calendar.SUNDAY?</code>",
   "answers": [
    {
     "id": 1328996,
     "content_html": "<code class=\"python\" data-lang=\"python\">1</code>",
     "correctness": "0.0",
     "feedback_html": "The value 1 is TUESDAY. In the calendar module, SUNDAY is at the end of the week."
    },
    {
     "id": 1328997,
     "content_html": "<code class=\"python\" data-lang=\"python\">6</code>",
     "correctness": "1.0",
     "feedback_html": "As explained in the documentation of the <code class=\"python\" data-lang=\"python\">calendar</code> module, <code class=\"python\" data-lang=\"python\">MONDAY</code> is <code class=\"python\" data-lang=\"python\">0</code> and <code class=\"python\" data-lang=\"python\">SUNDAY</code> is <code class=\"python\" data-lang=\"python\">6</code>."
    },
    {
     "id": 1328998,
     "content_html": "<code class=\"python\" data-lang=\"python\">7</code>",
     "correctness": "0.0",
     "feedback_html": "In the calendar module, day values range from 0 to 6. The value of 7 in invalid."
    }
