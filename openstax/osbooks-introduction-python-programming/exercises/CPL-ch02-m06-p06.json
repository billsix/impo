 "questions": [
  {
   "id": 666014,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is π<i>r</i><sup>2</sup> in Python syntax?",
   "answers": [
    {
     "id": 1327848,
     "content_html": "<code class=\"python\" data-lang=\"python\">pi * r**2</code>",
     "correctness": "0.0",
     "feedback_html": "The constant pi is not built-in and should be written as math.pi."
    },
    {
     "id": 1327849,
     "content_html": "<code class=\"python\" data-lang=\"python\">math.pi * r**2</code>",
     "correctness": "1.0",
     "feedback_html": "This expression is a concise way to write &#960;<i>r</i><sup>2</sup>."
    },
    {
     "id": 1327850,
     "content_html": "<code class=\"python\" data-lang=\"python\">math.pi * r*2</code>",
     "correctness": "0.0",
     "feedback_html": "<span class=\"purple-code\">This expression correctly brings in the value of pi but does not square r as needed.</span>"
    }
   ],
