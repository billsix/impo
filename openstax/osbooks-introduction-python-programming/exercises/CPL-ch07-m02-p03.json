 "questions": [
  {
   "id": 666623,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What error would occur if attempting to call a function that was not imported?",
   "answers": [
    {
     "id": 1328906,
     "content_html": "<code class=\"python\" data-lang=\"python\">ImportError</code>",
     "correctness": "0.0",
     "feedback_html": "An import error occurs when attempting to import an unknown function.<br>\nEx:<code class=\"python\" data-lang=\"python\">from math import hello</code>\n"
    },
    {
     "id": 1328907,
     "content_html": "<code class=\"python\" data-lang=\"python\">NameError</code>",
     "correctness": "1.0",
     "feedback_html": "A name error occurs when a variable name is not found, which might be due to a missing import statement."
    },
    {
     "id": 1328908,
     "content_html": "<code class=\"python\" data-lang=\"python\">SyntaxError</code>",
     "correctness": "0.0",
     "feedback_html": "A syntax error occurs when the structure of the code is incorrect, not when a function name is unknown."
    }
   ],
