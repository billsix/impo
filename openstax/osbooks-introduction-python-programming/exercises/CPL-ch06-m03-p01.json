   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which variables are global?\n<pre class=\"python\" data-lang=\"python\">num = float(input())\nnum_sq = num * num\nprint(num, \"squared is\", num_sq)\n</pre>",
   "answers": [
    {
     "id": 1328676,
     "content_html": "<code class=\"python\" data-lang=\"python\">num</code> only",
     "correctness": "0.0",
     "feedback_html": "num_sq is also created outside of a function."
    },
    {
     "id": 1328677,
     "content_html": "<code class=\"python\" data-lang=\"python\">num_sq</code> only",
     "correctness": "0.0",
     "feedback_html": "num is also created outside of a function."
    },
    {
     "id": 1328678,
     "content_html": "<code class=\"python\" data-lang=\"python\">num</code> and <code class=\"python\" data-lang=\"python\">num_sq</code>",
     "correctness": "1.0",
     "feedback_html": "Both <code class=\"python\" data-lang=\"python\">num</code> and <code class=\"python\" data-lang=\"python\">num_sq</code> are created outside of functions and are global variables."
    }
   ],
