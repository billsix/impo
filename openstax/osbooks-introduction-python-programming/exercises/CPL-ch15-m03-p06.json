 "questions": [
  {
   "id": 667125,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which function generates statistical information of columns with numerical data types?",
   "answers": [
    {
     "id": 1330336,
     "content_html": "<code class=\"python\" data-lang=\"python\">describe()</code>",
     "correctness": "1.0",
     "feedback_html": "When the function <code class=\"python\" data-lang=\"python\">describe()</code> is applied to a DataFrame, summary statistics of numerical columns will be generated."
    },
    {
     "id": 1330337,
     "content_html": "<code class=\"python\" data-lang=\"python\">info()</code>",
     "correctness": "0.0",
     "feedback_html": "The function <code class=\"python\" data-lang=\"python\">info()</code> provides a summary of values in all columns, including the number of non-null values. This function is applied to both categorical and numerical columns."
    },
    {
     "id": 1330338,
     "content_html": "<code class=\"python\" data-lang=\"python\">unique()</code>",
     "correctness": "0.0",
     "feedback_html": "The function <code class=\"python\" data-lang=\"python\">unique()</code> returns the unique values of a column and can be applied to a categorical column too."
    }
   ],
