 "questions": [
  {
   "id": 666585,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the difference between <code class=\"python\" data-lang=\"python\">hw_1()</code> and <code class=\"python\" data-lang=\"python\">hw_2()</code>?\n<pre class=\"python\" data-lang=\"python\">def hw_1():\n&nbsp;&nbsp;print(\"Hello world!\")\n&nbsp;&nbsp;return\n\ndef hw_2():\n&nbsp;&nbsp;print(\"Hello world!\")\n</pre>",
   "answers": [
    {
     "id": 1328796,
     "content_html": "<code class=\"python\" data-lang=\"python\">hw_1()</code> returns a string, <code class=\"python\" data-lang=\"python\">hw_2()</code> does not",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">return</code> is the same as <code class=\"python\" data-lang=\"python\">return None</code>."
    },
    {
     "id": 1328797,
     "content_html": "<code class=\"python\" data-lang=\"python\">hw_1()</code> returns <code class=\"python\" data-lang=\"python\">None</code>, <code class=\"python\" data-lang=\"python\">hw_2()</code> does not",
     "correctness": "0.0",
     "feedback_html": "A Python function without an explicit return statement returns None."
    },
    {
     "id": 1328798,
     "content_html": "no difference",
     "correctness": "1.0",
     "feedback_html": "If the return value or <code class=\"python\" data-lang=\"python\">return</code> statement is not specified, the function returns <code class=\"python\" data-lang=\"python\">None</code>."
    }
   ],
