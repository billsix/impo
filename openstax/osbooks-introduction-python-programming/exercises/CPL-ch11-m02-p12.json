 "questions": [
  {
   "id": 666909,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose the line <code class=\"python\" data-lang=\"python\">self.cls_id = 5</code> is added to the end of <code class=\"python\" data-lang=\"python\">__init__()</code>'s definition. What is the new output?",
   "answers": [
    {
     "id": 1329736,
     "content_html": "<code class=\"python\" data-lang=\"python\">Cafe Coffee Order 5 : 16 oz</code>",
     "correctness": "0.0",
     "feedback_html": "The new line creates a new instance attribute called cls_id. But print_order() still accesses the class attribute cls_id."
    },
    {
     "id": 1329737,
     "content_html": "<code class=\"python\" data-lang=\"python\">Cafe Coffee Order 3 : 16 oz</code>",
     "correctness": "1.0",
     "feedback_html": "Trying to access a class attribute using an instance is unsafe. In <code class=\"python\" data-lang=\"python\">__init__()</code>, trying to access the class attribute creates a new instance attribute called <code class=\"python\" data-lang=\"python\">cls_id</code>. Though possible, programmers should avoid using the same name for class attributes and instance attributes to avoid confusion."
    },
    {
     "id": 1329738,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "The line does not produce an error but also doesn't produce the desired effect of changing the class attribute, which is printed by print_order()."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
