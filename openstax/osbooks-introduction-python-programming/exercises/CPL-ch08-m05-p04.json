 "questions": [
  {
   "id": 666755,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">elements = ['A', 'beautiful', 'day', 'for', 'learning']\n\nprint(\",\".join(elements))\n</pre>",
   "answers": [
    {
     "id": 1329290,
     "content_html": "<code class=\"python\" data-lang=\"python\">'A beautiful day for learning'</code>",
     "correctness": "0.0",
     "feedback_html": "The delimiter between string items is comma, not space."
    },
    {
     "id": 1329291,
     "content_html": "<code class=\"python\" data-lang=\"python\">['A, beautiful, day, for, learning']</code>",
     "correctness": "0.0",
     "feedback_html": "The output of the <code class=\"python\" data-lang=\"python\">join()</code> function is a string which is the result of concatenating items of the list and putting the delimiter in between items."
    },
    {
     "id": 1329292,
     "content_html": "<code class=\"python\" data-lang=\"python\">'A,beautiful,day,for,learning'</code>",
     "correctness": "1.0",
     "feedback_html": "Elements of the list <code class=\"python\" data-lang=\"python\">elements</code> are concatenated together using a comma, so the output is <code class=\"python\" data-lang=\"python\">'A,beautiful,day,for,learning'</code>."
    }
   ],
