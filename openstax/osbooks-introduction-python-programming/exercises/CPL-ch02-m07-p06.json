   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What string is equivalent to <code class=\"python\" data-lang=\"python\">\"Today is\" \"a holiday\"</code>?",
   "answers": [
    {
     "id": 1327890,
     "content_html": "<code class=\"python\" data-lang=\"python\">'Today isa holiday'</code>",
     "correctness": "1.0",
     "feedback_html": "The original strings do not have a space between the words <code class=\"python\" data-lang=\"python\">\"is\"</code> and <code class=\"python\" data-lang=\"python\">\"a\"</code>."
    },
