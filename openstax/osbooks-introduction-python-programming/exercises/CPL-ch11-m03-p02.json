 "questions": [
  {
   "id": 666913,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is a correct call to <code class=\"python\" data-lang=\"python\">__init__()</code> to create an instance with <code class=\"python\" data-lang=\"python\">p_id=5241</code>?",
   "answers": [
    {
     "id": 1329748,
     "content_html": "<code class=\"python\" data-lang=\"python\">patient_10 = Vitals(self, 5241)</code>",
     "correctness": "0.0",
     "feedback_html": "The call will produce an error as self is not defined and should not be used as an argument."
    },
    {
     "id": 1329749,
     "content_html": "<code class=\"python\" data-lang=\"python\">patient_10 = Vitals(5241)</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">self</code> is the first parameter in <code class=\"python\" data-lang=\"python\">__init__()</code> definition, not an explicit argument. <code class=\"python\" data-lang=\"python\">self</code> should not be included in the call."
    },
    {
     "id": 1329750,
     "content_html": "both",
     "correctness": "0.0",
     "feedback_html": "self should not be passed as an explicit argument."
    }
   ],
