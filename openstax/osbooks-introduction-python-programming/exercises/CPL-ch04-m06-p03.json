 "questions": [
  {
   "id": 666443,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x = 256</code>, <code class=\"python\" data-lang=\"python\">y = 513</code>, and <code class=\"python\" data-lang=\"python\">max = 512</code>, which of the following will execute?\n<pre class=\"python\" data-lang=\"python\">if x == y:\n&nbsp;&nbsp;# Body 1\nelif x &lt; y:\n&nbsp;&nbsp;# Body 2\n&nbsp;&nbsp;if y &gt;= max:\n&nbsp;&nbsp;&nbsp;&nbsp;# Body 3\n&nbsp;&nbsp;else:\n&nbsp;&nbsp;&nbsp;&nbsp;# Body 4\nelse:\n&nbsp;&nbsp;# Body 5\n</pre>",
   "answers": [
    {
     "id": 1328384,
     "content_html": "<code class=\"python\" data-lang=\"python\">Body 2</code>",
     "correctness": "0.0",
     "feedback_html": "256 == 513 is False and 256 &lt; 513 is True, so the elif branch is taken. 513 >= 512 is True too."
    },
    {
     "id": 1328385,
     "content_html": "<code class=\"python\" data-lang=\"python\">Body 2</code>, <code class=\"python\" data-lang=\"python\">Body 3</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">256 == 513</code> is <code class=\"python\" data-lang=\"python\">False</code>, and <code class=\"python\" data-lang=\"python\">256 &lt; 513</code> is <code class=\"python\" data-lang=\"python\">True</code>, so the <code class=\"python\" data-lang=\"python\">elif</code> branch is taken and <code class=\"python\" data-lang=\"python\">Body 2</code> executes. <code class=\"python\" data-lang=\"python\">513 &gt;= 512</code> is <code class=\"python\" data-lang=\"python\">True</code>, so <code class=\"python\" data-lang=\"python\">Body 3</code> executes."
    },
    {
     "id": 1328386,
     "content_html": "<code class=\"python\" data-lang=\"python\">Body 2</code>, <code class=\"python\" data-lang=\"python\">Body 5</code>",
     "correctness": "0.0",
     "feedback_html": "The elif branch is taken, so the else branch, containing Body 5, is not taken."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
