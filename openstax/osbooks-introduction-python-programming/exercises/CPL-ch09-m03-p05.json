 "questions": [
  {
   "id": 666789,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct way to reverse the list <code class=\"python\" data-lang=\"python\">board_games</code>?",
   "answers": [
    {
     "id": 1329385,
     "content_html": "<code class=\"python\" data-lang=\"python\">board_games.reverse()</code>",
     "correctness": "1.0",
     "feedback_html": "The correct syntax for the <code class=\"python\" data-lang=\"python\">reverse()</code> function requires the function to be applied to the list."
    },
    {
     "id": 1329386,
     "content_html": "<code class=\"python\" data-lang=\"python\">reverse(board_games)</code>",
     "correctness": "0.0",
     "feedback_html": "Unlike the len() function, the reverse() function must be applied on the list instead of passing the list as a function parameter."
    }
   ],
