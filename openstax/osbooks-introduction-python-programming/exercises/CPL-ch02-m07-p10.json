   "stimulus_html": "",
   "stem_html": "Which example consists of two statements?",
   "answers": [
    {
     "id": 1327914,
     "content_html": "<pre class=\"python\" data-lang=\"python\">print(\"Happy \"\n\"New Year\")</pre>",
     "correctness": "0.0",
     "feedback_html": "The parentheses, required by print, span multiple lines."
    },
    {
     "id": 1327915,
     "content_html": "<pre class=\"python\" data-lang=\"python\">saying = (\"Happy \"\n\"New Year\")</pre>",
     "correctness": "0.0",
     "feedback_html": "The parentheses, which are optional, span multiple lines."
    },
    {
     "id": 1327916,
     "content_html": "<pre class=\"python\" data-lang=\"python\">saying= \"Happy \"\n\"New Year\"</pre>",
     "correctness": "1.0",
     "feedback_html": "The first line assigns <code class=\"python\" data-lang=\"python\">\"Happy \"</code> to the variable saying.\nThe second line has no effect on the program."
    }
