 "questions": [
  {
   "id": 667091,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The line <code class=\"python\" data-lang=\"python\">\"soft drinks\"</code> is changed to <code class=\"python\" data-lang=\"python\">\"3-4 soft drinks\"</code>.",
   "answers": [
    {
     "id": 1330232,
     "content_html": "<code class=\"python\" data-lang=\"python\">FileNotFoundError</code>",
     "correctness": "0.0",
     "feedback_html": "The file is found as before; only the contents of the file have changed."
    },
    {
     "id": 1330233,
     "content_html": "<code class=\"python\" data-lang=\"python\">IndexError</code>",
     "correctness": "0.0",
     "feedback_html": "The code finds the first index of a space. Since \"3-4 soft drinks\" contains a space, IndexError will likely not occur."
    },
    {
     "id": 1330234,
     "content_html": "<code class=\"python\" data-lang=\"python\">ValueError</code>",
     "correctness": "1.0",
     "feedback_html": "The string <code class=\"python\" data-lang=\"python\">\"3-4\"</code> is not an integer, so the <code class=\"python\" data-lang=\"python\">int()</code> function raises a <code class=\"python\" data-lang=\"python\">ValueError</code> like before."
    }
   ],
