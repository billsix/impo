 "questions": [
  {
   "id": 666851,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">members.get(\"jaya\", \"does not exist\")</code>?",
   "answers": [
    {
     "id": 1329564,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"Student\"</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"Jaya\"</code> is a key in the <code class=\"python\" data-lang=\"python\">members</code> dictionary and not <code class=\"python\" data-lang=\"python\">\"jaya\"</code>. What is the return value of <code class=\"python\" data-lang=\"python\">members.get(\"jaya\", \"does not exist\")</code> if the key is not found in the dictionary?"
    },
    {
     "id": 1329565,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"does not exist\"</code>",
     "correctness": "1.0",
     "feedback_html": "The second argument to the <code class=\"python\" data-lang=\"python\">get()</code> function will be returned if the key is not found in the dictionary."
    },
    {
     "id": 1329566,
     "content_html": "<code class=\"python\" data-lang=\"python\">None</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">None</code> is a default return value when a key does not exist in the dictionary. Yet, the second argument is provided in the <code class=\"python\" data-lang=\"python\">get()</code> function and will be returned since the key is not found."
    }
   ],
