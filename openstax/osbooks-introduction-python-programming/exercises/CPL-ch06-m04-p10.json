  {
   "id": 666577,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In <code class=\"python\" data-lang=\"python\">convert_temps()</code>, <code class=\"python\" data-lang=\"python\">wknd_temps</code> and <code class=\"python\" data-lang=\"python\">temps</code> refer to ________ in memory.",
   "answers": [
    {
     "id": 1328775,
     "content_html": "the same object",
     "correctness": "1.0",
     "feedback_html": "A list is mutable, so the object referred to by <code class=\"python\" data-lang=\"python\">wknd_temps</code> and <code class=\"python\" data-lang=\"python\">temps</code> is modified without needing a local copy."
    },
    {
     "id": 1328776,
     "content_html": "different objects",
     "correctness": "0.0",
     "feedback_html": "wknd_temps is a list. temps is assigned with the list in convert_temps() and modifies the list directly."
    }
   ],
