 "questions": [
  {
   "id": 666739,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">template = \"{greeting:&gt;6}\"\nformatted_greeting = template.format(greeting = \"Hello\")\nprint(formatted_greeting[0])\n</pre>",
   "answers": [
    {
     "id": 1329242,
     "content_html": "<code class=\"python\" data-lang=\"python\">H</code>",
     "correctness": "0.0",
     "feedback_html": "The alignment and length specification creates a right-aligned string of length 6. What is the value of <code class=\"python\" data-lang=\"python\">formatted_greeting</code> variable?"
    },
    {
     "id": 1329243,
     "content_html": "<code class=\"python\" data-lang=\"python\">\" Hello\"</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">print()</code> function prints the first character of the <code class=\"python\" data-lang=\"python\">formatted_greeting</code> variable and not the variable."
    },
    {
     "id": 1329244,
     "content_html": "Space character",
     "correctness": "1.0",
     "feedback_html": "The alignment and the field length specifications format the <code class=\"python\" data-lang=\"python\">greeting</code> field to be six characters in length and right-aligned. Therefore, the variable <code class=\"python\" data-lang=\"python\">formatted_greeting</code> will take value <code class=\"python\" data-lang=\"python\">\" Hello\"</code>, and character 0 of the string is a space character."
    }
   ],
