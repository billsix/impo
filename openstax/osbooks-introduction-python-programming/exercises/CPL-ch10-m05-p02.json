 "questions": [
  {
   "id": 391168,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How <span class=\"red-code\">can</span> a value be accessed in a nested dictionary in Python?",
   "answers": [
    {
     "id": 919306,
     "content_html": "by using the key of the outer dictionary",
     "correctness": "0.0",
     "feedback_html": "Using the key of the outer dictionary would return the inner dictionary, not a value in the inner dictionary."
    },
    {
     "id": 919307,
     "content_html": "by using the key of the inner dictionary",
     "correctness": "0.0",
     "feedback_html": "The key of the inner dictionary cannot be used to index at the first level of the hierarchy. For indexing in two layers (outer and inner dictionaries), the outer key and inner key must be used, respectively."
    },
    {
     "id": 919308,
     "content_html": "By using both the keys of the outer and inner dictionaries",
     "correctness": "1.0",
     "feedback_html": "Both outer and inner keys must be used to index into both outer and inner dictionaries, respectively, to obtain an inner value."
    }
   ],
