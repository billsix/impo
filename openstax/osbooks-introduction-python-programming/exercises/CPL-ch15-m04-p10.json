 "questions": [
  {
   "id": 667145,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Assuming that a DataFrame <code class=\"python\" data-lang=\"python\">df</code> is given, what does the expression <code class=\"python inline-code\" data-lang=\"python\">df.isnull().sum()</code> do?",
   "answers": [
    {
     "id": 1330396,
     "content_html": "Calculates sum of the non-<code class=\"python\" data-lang=\"python\">Null</code> values in each column",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python inline-code\" data-lang=\"python\">isnull()</code> function is called first to check the Null entries. What does applying <code class=\"python inline-code\" data-lang=\"python\">sum()</code> on the resulting Boolean DataFrame accomplishes?"
    },
    {
     "id": 1330397,
     "content_html": "Calculates the number of <code class=\"python\" data-lang=\"python\">Null</code> values in the DataFrame",
     "correctness": "0.0",
     "feedback_html": "The function <code class=\"python inline-code\" data-lang=\"python\">sum()</code> is applied to each column separately, and is not applied to the entire DataFrame."
    },
    {
     "id": 1330398,
     "content_html": "Calculates the number of <code class=\"python\" data-lang=\"python\">Null</code> values in each column",
     "correctness": "1.0",
     "feedback_html": "The function <code class=\"python inline-code\" data-lang=\"python\">sum()</code> is applied to each column separately and sums up values in columns. The result is the number of <code class=\"python\" data-lang=\"python\">Null</code> values in each column."
    }
   ],
   "hints": [],
