   "stimulus_html": "",
   "stem_html": "What is the index of the second character in a string?",
   "answers": [
    {
     "id": 872906,
     "content_html": "1",
     "correctness": "1.0",
     "feedback_html": "Since index values start at 0, the index 1 refers to the second character of the string."
    },
    {
     "id": 872907,
     "content_html": "2",
     "correctness": "0.0",
     "feedback_html": "Since index values start at 0, the index 2 refers to the third character of the string."
    },
    {
     "id": 872908,
     "content_html": "-2",
     "correctness": "0.0",
     "feedback_html": "The index -2 refers to the second last character of the string (from the right end)."
