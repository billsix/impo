  {
   "id": 667099,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<pre class=\"python\" data-lang=\"python\">word = \"one\"\ntry:\n&nbsp;&nbsp;number = int(word)\n&nbsp;&nbsp;print(word, \"equals\", number)\nexcept IndexError:\n&nbsp;&nbsp;print(word, \"is not a number\")\n</pre>",
   "answers": [
    {
     "id": 1330256,
     "content_html": "<code class=\"python\" data-lang=\"python\">one equals 1</code>",
     "correctness": "0.0",
     "feedback_html": "The int() function does not automatically convert words to numbers."
    },
    {
     "id": 1330257,
     "content_html": "<code class=\"python\" data-lang=\"python\">one is not a number</code>",
     "correctness": "0.0",
     "feedback_html": "The except clause runs only when IndexError is raised, not ValueError."
    },
    {
     "id": 1330258,
     "content_html": "<code class=\"python\" data-lang=\"python\">ValueError: invalid literal for int() with base 10: 'one'</code>",
     "correctness": "1.0",
     "feedback_html": "The program crashes and displays this error because the except clause does not handle <code class=\"python\" data-lang=\"python\">ValueError</code>."
    }
   ],
