 "questions": [
  {
   "id": 666641,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What line is useful for preventing side effects when importing?",
   "answers": [
    {
     "id": 1328956,
     "content_html": "<code class=\"python\" data-lang=\"python\">if __name__ == \"main\":</code>",
     "correctness": "0.0",
     "feedback_html": "This line has a typo: both name and main need to have double underscores."
    },
    {
     "id": 1328957,
     "content_html": "<code class=\"python\" data-lang=\"python\">if __name__ == __main__:</code>",
     "correctness": "0.0",
     "feedback_html": "This line has a typo: <code class=\"python\" data-lang=\"python\">__name__</code> is a variable, but <code class=\"python\" data-lang=\"python\">\"__main__\"</code> is a string."
    },
    {
     "id": 1328958,
     "content_html": "<code class=\"python\" data-lang=\"python\">if __name__ == \"__main__\":</code>",
     "correctness": "1.0",
     "feedback_html": "This line is found in many Python modules to check if the module\nwas run as the main program."
    }
   ],
