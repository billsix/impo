 "questions": [
  {
   "id": 666381,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">y = 50</code>, which is <i>not</i> a possible final value of <code class=\"python\" data-lang=\"python\">y</code>?\n<pre class=\"python\" data-lang=\"python\">if x &lt; 50:\n&nbsp;&nbsp;y = y / 2\nelse:\n&nbsp;&nbsp;y = y * 2\ny = y + 5\n</pre>",
   "answers": [
    {
     "id": 1328212,
     "content_html": "<code class=\"python\" data-lang=\"python\">30</code>",
     "correctness": "0.0",
     "feedback_html": "If x &lt; 50, y = 50 / 2 = 25. Then y = 25 + 5 = 30."
    },
    {
     "id": 1328213,
     "content_html": "<code class=\"python\" data-lang=\"python\">55</code>",
     "correctness": "1.0",
     "feedback_html": "One of the branches is always taken in an <code class=\"python\" data-lang=\"python\">if-else</code> statement. Depending on <code class=\"python\" data-lang=\"python\">x'</code>s value, <code class=\"python\" data-lang=\"python\">y</code> will either have a final value of <code class=\"python\" data-lang=\"python\">30</code> or <code class=\"python\" data-lang=\"python\">105</code>."
    },
    {
     "id": 1328214,
     "content_html": "<code class=\"python\" data-lang=\"python\">105</code>",
     "correctness": "0.0",
     "feedback_html": "If x >= 50, y = 50 * 2 = 100. Then y = 100 + 5 = 105."
    }
   ],
