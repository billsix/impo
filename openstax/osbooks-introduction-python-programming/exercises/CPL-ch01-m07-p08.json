 "questions": [
  {
   "id": 665889,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a docstring?",
   "answers": [
    {
     "id": 1327628,
     "content_html": "<pre class=\"python\" data-lang=\"python\">\"\"\"Vacations Madlib.\"\"\"</pre>",
     "correctness": "0.0",
     "feedback_html": "A docstring can be any string, including a one-line string that includes only the summary line."
    },
    {
     "id": 1327629,
     "content_html": "<pre class=\"python\" data-lang=\"python\">\"\"\"Vacations Madlib.\nThis program asks the user for two adjectives\nand two nouns, which are then used to print\na funny story about a vacation.\n\"\"\"</pre>",
     "correctness": "0.0",
     "feedback_html": "A docstring can be any string, even if the contents are formatted incorrectly.\nThis example is missing a blank line, but the docstring itself is valid string.\n"
    },
    {
     "id": 1327630,
     "content_html": "<pre class=\"python\" data-lang=\"python\"># Vacations Madlib.\n#\n# This program asks the user for two adjectives\n# and two nouns, which are then used to print\n# a funny story about a vacation.</pre>",
     "correctness": "1.0",
     "feedback_html": "Docstrings must be a valid string, not a multi-line comment. Docstrings are stored in the program's memory, but comments are ignored."
    }
   ],
