   "id": 666547,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which variables are local?\n<pre class=\"python\" data-lang=\"python\">def print_time():\n&nbsp;&nbsp;out_str = \"Time is \" + str(hour) + \":\" + str(min)\n&nbsp;&nbsp;print(out_str)\n\nhour = int(input())\nmin = int(input())\nprint_time()\n</pre>",
   "answers": [
    {
     "id": 1328694,
     "content_html": "<code class=\"python\" data-lang=\"python\">hour</code> and <code class=\"python\" data-lang=\"python\">min</code>",
     "correctness": "0.0",
     "feedback_html": "hour and min are created outside of print_time() and are global."
    },
    {
     "id": 1328695,
     "content_html": "<code class=\"python\" data-lang=\"python\">out_str</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">out_str</code> is the only variable declared in <code class=\"python\" data-lang=\"python\">print_time()</code> and is a local variable."
    },
    {
     "id": 1328696,
     "content_html": "<code class=\"python\" data-lang=\"python\">hour</code>, <code class=\"python\" data-lang=\"python\">min</code>, and <code class=\"python\" data-lang=\"python\">out_str</code>",
     "correctness": "0.0",
     "feedback_html": "out_str is a local variable, but hour and min are declared outside of print_time()."
    }
   ],
