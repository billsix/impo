   "stem_html": "Which function defined in <i>colors.py</i> is not included in the documentation?",
   "answers": [
    {
     "id": 1328990,
     "content_html": "<code class=\"python\" data-lang=\"python\">_tohex</code>",
     "correctness": "1.0",
     "feedback_html": "Functions that begin with an underscore are intended to be used only within a module, not in other modules."
    },
