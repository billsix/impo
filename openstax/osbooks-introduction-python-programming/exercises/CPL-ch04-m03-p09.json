   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x = 18</code>, is <code class=\"python\" data-lang=\"python\">x</code> in the correct range?\n<pre class=\"python\" data-lang=\"python\">if not(x &gt; 15 and x &lt; 20):\n&nbsp;&nbsp;# x in correct range\n</pre>",
   "answers": [
    {
     "id": 1328251,
     "content_html": "yes",
     "correctness": "0.0",
     "feedback_html": "not(18 > 15 and 18 &lt; 20) evaluates to not(True and True), then not(True), and finally False."
    },
    {
     "id": 1328252,
     "content_html": "no",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">not(18 &gt; 15 and 18 &lt; 20)</code> evaluates to <code class=\"python\" data-lang=\"python\">not(True and True)</code>, then <code class=\"python\" data-lang=\"python\">not(True)</code>, and finally, <code class=\"python\" data-lang=\"python\">False</code>."
    }
   ],
