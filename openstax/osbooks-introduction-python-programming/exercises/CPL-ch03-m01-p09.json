 "questions": [
  {
   "id": 666287,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement prints <samp>Enter</samp> and <samp>here</samp> on separate lines?",
   "answers": [
    {
     "id": 1327956,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Enter here\")</code>",
     "correctness": "0.0",
     "feedback_html": "Without the newline escape sequence, \\n, this would print both strings on the same line."
    },
    {
     "id": 1327957,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Enter\" + \\n + \"here\")</code>",
     "correctness": "0.0",
     "feedback_html": "An escape sequence must be enclosed with single (') or double (\") quotes like any string."
    },
    {
     "id": 1327958,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Enter\" + \"\\n\" + \"here\")</code>",
     "correctness": "1.0",
     "feedback_html": "The escape sequence <code>\\n</code> produces a new line. <code>print(\"Enter\\nhere\")</code> produces the same result."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
