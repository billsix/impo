 "questions": [
  {
   "id": 666999,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How is a <code class=\"python\" data-lang=\"python\">Daisy</code> class that inherits from the <code class=\"python\" data-lang=\"python\">Plant</code> class defined?",
   "answers": [
    {
     "id": 1329970,
     "content_html": "<pre class=\"python\" data-lang=\"python\">class Plant(Daisy):</pre>",
     "correctness": "0.0",
     "feedback_html": "The superclass name follows the subclass name."
    },
    {
     "id": 1329971,
     "content_html": "<pre class=\"python\" data-lang=\"python\">class Daisy(Plant):</pre>",
     "correctness": "1.0",
     "feedback_html": "The subclass name is followed by the superclass name in parentheses."
    },
    {
     "id": 1329972,
     "content_html": "<pre class=\"python\" data-lang=\"python\">class Daisy:\nclass Plant:\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The code attempts to redefine the Plant class after an empty Daisy class definition. There should only be one class definition line."
    }
   ],
