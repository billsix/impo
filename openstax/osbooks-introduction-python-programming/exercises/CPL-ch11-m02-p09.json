 "questions": [
  {
   "id": 666903,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is an instance attribute?",
   "answers": [
    {
     "id": 1329718,
     "content_html": "<code class=\"python\" data-lang=\"python\">loc</code>",
     "correctness": "0.0",
     "feedback_html": "loc is a class attribute defined at the start of the class definition. An instance attribute is defined in __init__()."
    },
    {
     "id": 1329719,
     "content_html": "<code class=\"python\" data-lang=\"python\">order_id</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">order_id</code> is an instance attribute defined in <code class=\"python\" data-lang=\"python\">__init__()</code>. The other instance attribute is <code class=\"python\" data-lang=\"python\">cup_size</code>."
    },
    {
     "id": 1329720,
     "content_html": "<code class=\"python\" data-lang=\"python\">order_3</code>",
     "correctness": "0.0",
     "feedback_html": "order_3 is an instance. order_3 has 2 instance attributes: order_id and cup_size."
    }
   ],
