 "questions": [
  {
   "id": 666667,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of (<code class=\"python\" data-lang=\"python\">\"aa\" &lt; \"a\"</code>)?",
   "answers": [
    {
     "id": 1329029,
     "content_html": "<code class=\"python\" data-lang=\"python\">True</code>",
     "correctness": "0.0",
     "feedback_html": "When two strings of different length are compared, the shorter string is compared with the longer string's prefix (of the same length). If the two are equal, then the shorter string is considered smaller than the longer string."
    },
    {
     "id": 1329030,
     "content_html": "<code class=\"python\" data-lang=\"python\">False</code>",
     "correctness": "1.0",
     "feedback_html": "Since<code class=\"python\" data-lang=\"python\">\"a\"</code> is shorter than <code class=\"python\" data-lang=\"python\">\"aa\"</code>, and the prefix <code class=\"python\" data-lang=\"python\">\"aa\"</code> with length 1 equals the second operand (<code class=\"python\" data-lang=\"python\">\"a\"</code>), the shorter string is considered smaller. As such, <code class=\"python\" data-lang=\"python\">\"aa\" &lt; \"a\"</code> evaluates to False."
    }
   ],
