 "questions": [
  {
   "id": 666523,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement calls a function named <code class=\"python\" data-lang=\"python\">print_pc_specs()</code>?",
   "answers": [
    {
     "id": 1328622,
     "content_html": "<code class=\"python\" data-lang=\"python\">print_pc_specs</code>",
     "correctness": "0.0",
     "feedback_html": "The function call is missing parentheses, which indicate print_pc_specs is a function."
    },
    {
     "id": 1328623,
     "content_html": "<code class=\"python\" data-lang=\"python\">print_pc_specs()</code>",
     "correctness": "1.0",
     "feedback_html": "A function call includes the function name and parentheses."
    },
    {
     "id": 1328624,
     "content_html": "<code class=\"python\" data-lang=\"python\">print_pc_specs():</code>",
     "correctness": "0.0",
     "feedback_html": "A colon is used when defining a function but not when calling the function."
    }
