   "stimulus_html": "",
   "stem_html": "What is the updated value of <code class=\"python\" data-lang=\"python\">bill</code>?\n<pre class=\"python\" data-lang=\"python\">def tax(total):\n&nbsp;&nbsp;return .06 * total\n\ndef auto_tip(total):\n&nbsp;&nbsp;return .2 * total\n\nbill = 100.0\nbill += tax(bill) + auto_tip(bill)\n</pre>",
   "answers": [
    {
     "id": 1328813,
     "content_html": "<code class=\"python\" data-lang=\"python\">26.0</code>",
     "correctness": "0.0",
     "feedback_html": "The return values of tax(100) and auto_tip(100) are added to 100 to update the value of bill."
    },
    {
     "id": 1328814,
     "content_html": "<code class=\"python\" data-lang=\"python\">126.0</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">bill += tax(bill) + auto_tip(bill)</code> evaluates to <code class=\"python\" data-lang=\"python\">bill += 6.0 + 20.0</code> to <code class=\"python\" data-lang=\"python\">bill = 100.0 + 6.0 + 20.0</code> to 126.0."
    }
