     "id": 1329932,
     "content_html": "<code class=\"python\" data-lang=\"python\">[5, 2, 7, 1, 8]</code>",
     "correctness": "0.0",
     "feedback_html": "This array is not sorted. Binary search requires a sorted array."
    },
