     "id": 1329933,
     "content_html": "<code class=\"python\" data-lang=\"python\">[9, 8, 7, 6, 5]</code>",
     "correctness": "0.0",
     "feedback_html": "This array is sorted in descending order, but binary search requires ascending order. A binary search algorithm for descending order does exist, but is not presented in this material."
