 "questions": [
  {
   "id": 666769,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the code below?\n<pre class=\"python\" data-lang=\"python\">for i in range(0, len(my_list), 2):\n&nbsp;&nbsp;print(my_list[i], end=' ')\n</pre>",
   "answers": [
    {
     "id": 1329330,
     "content_html": "<code class=\"python\" data-lang=\"python\">2 5 9</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">for</code> loop steps by two each time, so index 0, 2, and 4 are printed. Due to the <code class=\"python\" data-lang=\"python\">\"end=\"</code> in the print statement, all elements are printed on one line."
    },
    {
     "id": 1329331,
     "content_html": "<code class=\"python\" data-lang=\"python\">2 3 5 7 9</code>",
     "correctness": "0.0",
     "feedback_html": "Each element is printed in one line because of the \"end=\" variable, but the for loop moves ahead by 2 each time."
    },
    {
     "id": 1329332,
     "content_html": "<code class=\"python\" data-lang=\"python\">2</code><br>\n<code class=\"python\" data-lang=\"python\">5</code><br>\n<code class=\"python\" data-lang=\"python\">9</code>\n",
     "correctness": "0.0",
     "feedback_html": "The for loop steps by 2, so elements 2, 5, and 9 are printed, but the \"end\" variable changes how the print statement behaves."
    }
   ],
