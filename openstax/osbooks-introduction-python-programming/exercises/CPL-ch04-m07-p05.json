   "id": 666455,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are the possible values of <code class=\"python\" data-lang=\"python\">total</code>?\n<pre class=\"python\" data-lang=\"python\">total = fee + 10 if hours &gt; 12 else 2\n</pre>",
   "answers": [
    {
     "id": 1328418,
     "content_html": "<code class=\"python\" data-lang=\"python\">10</code>, <code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "0.0",
     "feedback_html": "fee + 10 is the expression_if_true."
    },
    {
     "id": 1328419,
     "content_html": "<code class=\"python\" data-lang=\"python\">fee + 10</code>, <code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "1.0",
     "feedback_html": "The expression is evaluated as <code class=\"python\" data-lang=\"python\">(fee + 10) if hours &gt; 12 else 2</code>. So if hours &gt; 12, the result will be fee + 10; otherwise, the result will be 2."
    },
    {
     "id": 1328420,
     "content_html": "<code class=\"python\" data-lang=\"python\">fee + 10</code>, <code class=\"python\" data-lang=\"python\">fee + 2</code>",
     "correctness": "0.0",
     "feedback_html": "2 is the expression_if_false."
    }
   ],
