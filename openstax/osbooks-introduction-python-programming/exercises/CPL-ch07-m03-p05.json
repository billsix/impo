 "questions": [
  {
   "id": 666639,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output when <b>importing</b> the following <i>test.py</i> module?\n<pre class=\"python\" data-lang=\"python\">import math\n\nprint(math.__name__)\nprint(__name__)\n</pre>",
   "answers": [
    {
     "id": 1328950,
     "content_html": "<pre class=\"python\" data-lang=\"python\">math\ntest\n</pre>",
     "correctness": "1.0",
     "feedback_html": "Since <i>test.py</i> was imported, the value of <code class=\"python\" data-lang=\"python\">__name__</code> is <code class=\"python\" data-lang=\"python\">\"test\"</code>."
    },
    {
     "id": 1328951,
     "content_html": "<pre class=\"python\" data-lang=\"python\">__main__\ntest\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The math module was imported, so the <code class=\"python\" data-lang=\"python\">__name__</code> of math is <code class=\"python\" data-lang=\"python\">\"math\"</code>."
    },
    {
     "id": 1328952,
     "content_html": "<pre class=\"python\" data-lang=\"python\">math\n__main__\n</pre>",
     "correctness": "0.0",
     "feedback_html": "In this question, <i>test.py</i> is not the main program.\nWhat is the output when another program imports <i>test.py</i>?"
    }
   ],
