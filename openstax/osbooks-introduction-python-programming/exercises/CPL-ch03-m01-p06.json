   "id": 666281,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does <code class=\"python\" data-lang=\"python\">chr(126)</code> return?",
   "answers": [
    {
     "id": 1327938,
     "content_html": "<code class=\"python\" data-lang=\"python\">~</code>",
     "correctness": "0.0",
     "feedback_html": "Tilde (~) is the correct character for code point 126, but the chr() function returns a string."
    },
    {
     "id": 1327939,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"~\"</code>",
     "correctness": "1.0",
     "feedback_html": "Tilde (~) is the character for code point 126. The <code class=\"python\" data-lang=\"python\">chr()</code> function returns a string of length one."
    },
    {
     "id": 1327940,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "126 is a valid code point. The chr() function returns the character for any code point in the range 0 to 1,114,111."
    }
   ],
