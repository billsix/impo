     "content_html": "<code class=\"python\" data-lang=\"python\">FileNotFoundError</code>",
     "correctness": "0.0",
     "feedback_html": "This code does not include a filename. (The file is already open.)"
    },
    {
     "id": 1330245,
     "content_html": "<code class=\"python\" data-lang=\"python\">IndexError</code>",
     "correctness": "1.0",
     "feedback_html": "If the line has no spaces, then <code class=\"python\" data-lang=\"python\">len(parts)</code> will be only <code class=\"python\" data-lang=\"python\">1,</code> and <code class=\"python\" data-lang=\"python\">parts[1]</code> will be out of range."
    },
    {
     "id": 1330246,
     "content_html": "<code class=\"python\" data-lang=\"python\">ValueError</code>",
     "correctness": "0.0",
     "feedback_html": "The values are correct, but the indexes might not be out of range."
    }
