   "stem_html": "Which creates a valid tuple?",
   "answers": [
    {
     "id": 1328052,
     "content_html": "<code class=\"python\" data-lang=\"python\">tuple_2 = (42, 26, 13)</code>",
     "correctness": "0.0",
     "feedback_html": "tuple_2 is a valid tuple with three integer elements. Tuples can also have elements with different types."
    },
    {
     "id": 1328053,
     "content_html": "<code class=\"python\" data-lang=\"python\">tuple_3 = (42, 26, 13.5)</code>",
     "correctness": "0.0",
     "feedback_html": "tuple_3 is a valid tuple with two integer elements and one float element. Tuples can also have all elements of the same type."
    },
    {
     "id": 1328054,
     "content_html": "both",
     "correctness": "1.0",
     "feedback_html": "Tuples can have elements of the same type as well as elements of different types."
    }
