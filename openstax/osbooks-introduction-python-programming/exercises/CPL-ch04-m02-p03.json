 "questions": [
  {
   "id": 666371,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following (same as above), which lines execute if the condition is False?\n<pre class=\"python line-numbering\" data-lang=\"python\">print(\"Have a great day.\")\nif is_raining:\n&nbsp;&nbsp;print(\"Don't forget an umbrella!\")\nprint(\"See you soon.\")\n</pre>",
   "answers": [
    {
     "id": 1328182,
     "content_html": "1, 2, 3",
     "correctness": "0.0",
     "feedback_html": "Line 3 is only executed if the condition is True."
    },
    {
     "id": 1328183,
     "content_html": "1, 2, 4",
     "correctness": "1.0",
     "feedback_html": "The body, line 3, isn't executed because the condition is false."
    },
    {
     "id": 1328184,
     "content_html": "1, 2, 3, 4",
     "correctness": "0.0",
     "feedback_html": "Lines 1, 2, 3, and 4 execute if the condition is True. "
    }
   ],
