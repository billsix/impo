   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct syntax to create an empty dictionary in Python?",
   "answers": [
    {
     "id": 1329516,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_dict = ()</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">()</code> is used to create an empty tuple. What is the correct syntax to create an empty dictionary?"
    },
    {
     "id": 1329517,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_dict = {}</code>",
     "correctness": "1.0",
     "feedback_html": "Curly braces can be used to create an empty dictionary."
    },
    {
     "id": 1329518,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_dict = []</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">[]</code> creates an empty list. What is the correct syntax to create an empty dictionary?"
    }
