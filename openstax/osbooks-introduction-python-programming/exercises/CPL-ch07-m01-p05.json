 "questions": [
  {
   "id": 666617,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What code would return the area of a circle with a radius of 3 meters?",
   "answers": [
    {
     "id": 1328888,
     "content_html": "<code class=\"python\" data-lang=\"python\">circle(3)</code>",
     "correctness": "0.0",
     "feedback_html": "The circle function is defined in the area module, not the main program."
    },
    {
     "id": 1328889,
     "content_html": "<code class=\"python\" data-lang=\"python\">area.circle(3)</code>",
     "correctness": "1.0",
     "feedback_html": "The circle function must be called using the area variable that refers to the module."
    },
    {
     "id": 1328890,
     "content_html": "<code class=\"python\" data-lang=\"python\">circle.area(3)</code>",
     "correctness": "0.0",
     "feedback_html": "The correct syntax is module_name.function_name, not the other way around."
    }
   ],
