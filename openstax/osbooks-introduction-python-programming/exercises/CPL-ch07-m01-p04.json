 "questions": [
  {
   "id": 666615,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What statement would import a module from a file named <i>secret.py</i>?",
   "answers": [
    {
     "id": 1328882,
     "content_html": "<code class=\"python\" data-lang=\"python\">import secret</code>",
     "correctness": "1.0",
     "feedback_html": "When importing a module from another file, the suffix <i>.py</i> is removed."
    },
    {
     "id": 1328883,
     "content_html": "<code class=\"python\" data-lang=\"python\">import secret.py</code>",
     "correctness": "0.0",
     "feedback_html": "When importing a module from another file, the suffix .py is removed."
    },
    {
     "id": 1328884,
     "content_html": "<code class=\"python\" data-lang=\"python\">import \"secret.py\"</code>",
     "correctness": "0.0",
     "feedback_html": "An import statement should not have quotes. When importing a module from another file, the suffix .py is removed."
    }
   ],
