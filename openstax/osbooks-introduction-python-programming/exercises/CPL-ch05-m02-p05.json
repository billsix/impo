 "questions": [
  {
   "id": 666477,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are the arguments to the <code class=\"python\" data-lang=\"python\">range()</code> function for the decreasing sequence of every integer from 5 to 1 (inclusive of both ends)?",
   "answers": [
    {
     "id": 1328484,
     "content_html": "<code class=\"python\" data-lang=\"python\">range(5, 1, 1)</code>",
     "correctness": "0.0",
     "feedback_html": "Since the step size is a positive number, the sequence will be an increasing sequence. The start of the increasing sequence is 5 and the end of the sequence is defined as 1, making the output an empty range."
    },
    {
     "id": 1328485,
     "content_html": "<code class=\"python\" data-lang=\"python\">range(5, 1, -1)</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">range(start, end, step)</code> is inclusive of start and exclusive of end."
    },
    {
     "id": 1328486,
     "content_html": "<code class=\"python\" data-lang=\"python\">range(5, 0, -1)</code>",
     "correctness": "1.0",
     "feedback_html": "The expression starts a sequence from <code class=\"python\" data-lang=\"python\">5</code>, decreases by 1 at every step, and ends at <code class=\"python\" data-lang=\"python\">1</code>."
    }
   ],
