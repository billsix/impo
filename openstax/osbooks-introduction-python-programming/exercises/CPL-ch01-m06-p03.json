   "stem_html": "What type of error was found?",
   "answers": [
    {
     "id": 1327586,
     "content_html": "missing parentheses",
     "correctness": "0.0",
     "feedback_html": "\"Missing parentheses\" was the reason for this error, but not the type of the error."
    },
    {
     "id": 1327587,
     "content_html": "<code class=\"python\" data-lang=\"python\">SyntaxError</code>",
     "correctness": "1.0",
     "feedback_html": "The type of error is always the first word on the last line of the error message."
    },
    {
     "id": 1327588,
     "content_html": "traceback",
     "correctness": "0.0",
     "feedback_html": "Error messages begin with the word \"Traceback\" to show where the error occurred."
    }
