 "questions": [
  {
   "id": 666283,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an escape sequence?",
   "answers": [
    {
     "id": 1327944,
     "content_html": "<code class=\"python\" data-lang=\"python\">t</code>",
     "correctness": "0.0",
     "feedback_html": "An escape sequence always begins with a backslash (\\) in addition to a second character."
    },
    {
     "id": 1327945,
     "content_html": "<code class=\"python\" data-lang=\"python\">/t</code>",
     "correctness": "0.0",
     "feedback_html": "An escape sequence begins with a backslash (\\) not a forward slash (/)."
    },
    {
     "id": 1327946,
     "content_html": "<code class=\"python\" data-lang=\"python\">\\t</code>",
     "correctness": "1.0",
     "feedback_html": "An escape sequence is two characters long and begins with a backslash (\\)."
    }
