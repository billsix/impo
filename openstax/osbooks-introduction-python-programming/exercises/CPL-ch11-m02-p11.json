 "questions": [
  {
   "id": 666907,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose the line <code class=\"python\" data-lang=\"python\">CoffeeOrder.loc = 'Caffeine Cafe'</code> is added before <code class=\"python\" data-lang=\"python\">order_3.print_order()</code>. What is the new output?",
   "answers": [
    {
     "id": 1329730,
     "content_html": "<code class=\"python\" data-lang=\"python\">Caffeine Cafe Order 3 : 16 oz</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">order_1</code>, <code class=\"python\" data-lang=\"python\">order_2</code>, and <code class=\"python\" data-lang=\"python\">order_3</code> all share the class attribute <code class=\"python\" data-lang=\"python\">CoffeeOrder.loc</code>. Changing <code class=\"python\" data-lang=\"python\">loc</code> affects all instances, so <code class=\"python\" data-lang=\"python\">Caffeine Cafe</code> is printed as the location."
    },
    {
     "id": 1329731,
     "content_html": "<code class=\"python\" data-lang=\"python\">Cafe Coffee Order 3 : 16 oz</code>",
     "correctness": "0.0",
     "feedback_html": "All instances share class attributes, so a change to loc affects all instances."
    },
    {
     "id": 1329732,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "Class attributes can be changed after initialization. A class attribute is shared by all instances, so the output changes."
    }
   ],
