 "questions": [
  {
   "id": 666977,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the GCD of 15 and 35?",
   "answers": [
    {
     "id": 1329914,
     "content_html": "15",
     "correctness": "0.0",
     "feedback_html": "15 is the smaller of the numbers but not the GCD."
    },
    {
     "id": 1329915,
     "content_html": "20",
     "correctness": "0.0",
     "feedback_html": "The first recursive call reduces 35 to 20 because 35 - 15 = 20. What happens after subsequent recursive calls?"
    },
    {
     "id": 1329916,
     "content_html": "5",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">5 * 3 = 15</code> and <code class=\"python\" data-lang=\"python\">5 * 7 = 35</code>, so <code class=\"python\" data-lang=\"python\">5</code> is a the greatest common divisor of <code class=\"python\" data-lang=\"python\">15</code> and <code class=\"python\" data-lang=\"python\">35</code>."
    }
   ],
