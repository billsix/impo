 "questions": [
  {
   "id": 666743,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print('{0:.3f}'.format(3.141592))</code>?",
   "answers": [
    {
     "id": 1329254,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.141592</code>",
     "correctness": "0.0",
     "feedback_html": "The given format specification modifies the precision of the given floating-point number. What must be the precision of the output given the <code class=\"python\" data-lang=\"python\">{0:.3f}</code> format specification?"
    },
    {
     "id": 1329255,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.1</code>",
     "correctness": "0.0",
     "feedback_html": ".3 specifies the precision of the output and not the number of characters in the output."
    },
    {
     "id": 1329256,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.142</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">.3</code> format specification shows that the output precision must be three decimal places."
    }
   ],
