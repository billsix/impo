   "stimulus_html": "",
   "stem_html": "How many function calls are there?\n<pre class=\"python\" data-lang=\"python\"># Use float() to convert input for area calculation\nwidth = float(input(\"Enter width:\"))\nheight = float(input(\"Enter height:\"))\nprint(\"Area is\", width*height)\n</pre>",
   "answers": [
    {
     "id": 1328604,
     "content_html": "3",
     "correctness": "0.0",
     "feedback_html": "Three total functions are called: float(), input(), and print(). But float() and input() are called twice."
    },
    {
     "id": 1328605,
     "content_html": "5",
     "correctness": "1.0",
     "feedback_html": "Line 1 is a comment that is not executed. Lines 2 and 3 each call <code class=\"python\" data-lang=\"python\">float()</code> and <code class=\"python\" data-lang=\"python\">input()</code>. Line 3 calls <code class=\"python\" data-lang=\"python\">print()</code> for a total of five function calls."
    },
