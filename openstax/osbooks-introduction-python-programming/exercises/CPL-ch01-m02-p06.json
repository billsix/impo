  {
   "id": 665811,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output if the user enters \"six\" as the input?\n<pre class=\"python\" data-lang=\"python\">print(\"Please enter a number: \")\nnumber = input()\nprint(\"Value =\", number)\n</pre>",
   "answers": [
    {
     "id": 1327396,
     "content_html": "<code class=\"python\" data-lang=\"python\">Value = six</code>",
     "correctness": "1.0",
     "feedback_html": "The input is stored exactly as the user enters the input. So, the retrieved value is displayed exactly as entered by the user."
    },
    {
     "id": 1327397,
     "content_html": "<code class=\"python\" data-lang=\"python\">Value = 6</code>",
     "correctness": "0.0",
     "feedback_html": "The obtained input data is stored as the user enters it. Python would not convert \"six\" to the number 6, even though the user was prompted to enter a number."
    },
    {
     "id": 1327398,
     "content_html": "<code class=\"python\" data-lang=\"python\">Value = number</code>",
     "correctness": "0.0",
     "feedback_html": "Since the word number is not in double quotes, the input \"six\" replaces number when the print statement is run."
    }
   ],
