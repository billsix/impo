 "questions": [
  {
   "id": 666433,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Where can an <code class=\"python\" data-lang=\"python\">elif</code> statement be added?<pre class=\"python\" data-lang=\"python\">_1_\nif condition:\n&nbsp;&nbsp;# Body\n&nbsp;&nbsp;_2_\nelif condition:\n&nbsp;&nbsp;# Body\n_3_\nelse:\n&nbsp;&nbsp;# Body\n_4_\n</pre>",
   "answers": [
    {
     "id": 1328353,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "An elif cannot precede the if statement the elif is chained to."
    },
    {
     "id": 1328354,
     "content_html": "2",
     "correctness": "0.0",
     "feedback_html": "An elif must be at the same indentation level as the statement the elif is chained to."
    },
    {
     "id": 1328355,
     "content_html": "3",
     "correctness": "1.0",
     "feedback_html": "An <code class=\"python\" data-lang=\"python\">elif</code> can be chained to another <code class=\"python\" data-lang=\"python\">elif</code> to form a longer chained decision."
    },
    {
     "id": 1328356,
     "content_html": "4",
     "correctness": "0.0",
     "feedback_html": "An else statement is always the last statement in the decision."
    }
   ],
