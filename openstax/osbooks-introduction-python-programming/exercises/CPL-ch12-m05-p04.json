 "questions": [
  {
   "id": 666989,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many calls to the <code class=\"python\" data-lang=\"python\">binary_search()</code> function occur in the code example when searching <code class=\"python\" data-lang=\"python\">86</code>?",
   "answers": [
    {
     "id": 1329949,
     "content_html": "4",
     "correctness": "1.0",
     "feedback_html": "The first call results in <code class=\"python\" data-lang=\"python\">mid</code> being <code class=\"python\" data-lang=\"python\">(0 + 13) // 2 = 6</code>. The next call has <code class=\"python\" data-lang=\"python\">mid (7 + 13) // 2 = 10</code>. The next call has <code class=\"python\" data-lang=\"python\">mid (11 + 13) // 2 = 12</code>. At this point, <code class=\"python\" data-lang=\"python\">86 &lt; 99</code>, so the final call is to <code class=\"python\" data-lang=\"python\">mid 11</code>, after which there is nowhere else to go."
    },
    {
     "id": 1329950,
     "content_html": "14",
     "correctness": "0.0",
     "feedback_html": "There are 14 total elements in the list. A simple search would need 14 steps but not binary search."
    }
   ],
