 "questions": [
  {
   "id": 665951,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">round(0.1, 1)</code>?",
   "answers": [
    {
     "id": 1327782,
     "content_html": "<code class=\"python\" data-lang=\"python\">0.1</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">round(0.1, 1)</code> rounds the value <code class=\"python\" data-lang=\"python\">0.1</code> to one decimal place, which is <code class=\"python\" data-lang=\"python\">0.1</code>."
    },
    {
     "id": 1327783,
     "content_html": "<code class=\"python\" data-lang=\"python\">0.10</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">round(0.1, 1)</code> rounds the value 0.1 to one decimal place. 0.10 has two decimal places."
    },
    {
     "id": 1327784,
     "content_html": "<code class=\"python\" data-lang=\"python\">0.1000000000000000055511151231257827021181583404541015625</code>",
     "correctness": "0.0",
     "feedback_html": "The value 0.1 is stored in memory through approximation. The <code class=\"python\" data-lang=\"python\">round()</code> function is used to mitigate round-off error by rounding the value to a given number of decimal places.<code class=\"python\" data-lang=\"python\">round(0.1, 1)</code> has one decimal place in the output."
    }
   ],
