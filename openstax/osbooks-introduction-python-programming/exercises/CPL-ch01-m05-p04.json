 "questions": [
  {
   "id": 665857,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following lines of code, what is the output of the code?\n<pre class=\"python\" data-lang=\"python\">c = 0\nc = x - z\nc = c + 1\nprint(c) </pre>",
   "answers": [
    {
     "id": 1327534,
     "content_html": "<code class=\"python\" data-lang=\"python\">1</code>",
     "correctness": "0.0",
     "feedback_html": "The value of c is modified in line 2, and therefore c will no longer be equal to 0 when we calculate c = c + 1."
    },
    {
     "id": 1327535,
     "content_html": "<code class=\"python\" data-lang=\"python\">5</code>",
     "correctness": "0.0",
     "feedback_html": "With x = 7 and z = 2, x - z equals 5. The given code asks for calculation of c = c + 1 as well."
    },
    {
     "id": 1327536,
     "content_html": "<code class=\"python\" data-lang=\"python\">6</code>",
     "correctness": "1.0",
     "feedback_html": "Line 2 of the code evaluates as follows: <code class=\"python\" data-lang=\"python\">c = x - z = 7 - 2 = 5</code>.  Line 3 increments variable <code class=\"python\" data-lang=\"python\">c</code> by 1, making the total equal to 6."
    }
   ],
