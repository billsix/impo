 "questions": [
  {
   "id": 666459,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the variable <code class=\"python\" data-lang=\"python\">g</code>'s value when the while loop condition evaluates to <code class=\"python\" data-lang=\"python\">False</code>?",
   "answers": [
    {
     "id": 1328430,
     "content_html": "<code class=\"python\" data-lang=\"python\">13</code>",
     "correctness": "0.0",
     "feedback_html": "When <code class=\"python\" data-lang=\"python\">g = 13</code> the condition of <code class=\"python\" data-lang=\"python\">g &lt; 20</code> evaluates to True because 13 is less than 20."
    },
    {
     "id": 1328431,
     "content_html": "<code class=\"python\" data-lang=\"python\">20</code>",
     "correctness": "0.0",
     "feedback_html": "The value 20 is not a Fibonacci number, and therefore cannot be a value that is assigned to the variable <code class=\"python\" data-lang=\"python\">g</code>."
    },
    {
     "id": 1328432,
     "content_html": "<code class=\"python\" data-lang=\"python\">21</code>",
     "correctness": "1.0",
     "feedback_html": "21 is the first Fibonacci number larger than 20, and for <code class=\"python\" data-lang=\"python\">g = 21</code>, the condition will evaluate to <code class=\"python\" data-lang=\"python\">False</code> for the first time."
    }
   ],
