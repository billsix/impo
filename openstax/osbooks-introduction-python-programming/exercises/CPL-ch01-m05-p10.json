 "questions": [
  {
   "id": 665869,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which part of <code class=\"python\" data-lang=\"python\">(1 + 3) ** 2 / 4</code> evaluates first?",
   "answers": [
    {
     "id": 1327570,
     "content_html": "<code class=\"python\" data-lang=\"python\">4 ** 2</code>",
     "correctness": "0.0",
     "feedback_html": "Exponentiation has the highest precedence, but 1 + 3 must be evaluated first in order to compute the value 4."
    },
    {
     "id": 1327571,
     "content_html": "<code class=\"python\" data-lang=\"python\">1 + 3</code>",
     "correctness": "1.0",
     "feedback_html": "Although addition has lower precedence than exponentiation, the parentheses cause <code class=\"python\" data-lang=\"python\">1 + 3</code> to be evaluated first."
    },
    {
     "id": 1327572,
     "content_html": "<code class=\"python\" data-lang=\"python\">2 / 4</code>",
     "correctness": "0.0",
     "feedback_html": "Exponentiation has higher precedence than division. The value 4 ** 2 will be divided by 4 as the last step."
    }
   ],
