 "questions": [
  {
   "id": 666535,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output?\n<pre class=\"python\" data-lang=\"python\">def park_greet():\n&nbsp;&nbsp;\"\"\"Output greeting.\"\"\"\n&nbsp;&nbsp;print(\"Welcome to the park\")\nprint(\"Open sunrise to sunset\")\n\npark_greet()\n</pre>",
   "answers": [
    {
     "id": 1328658,
     "content_html": "<code class=\"python\" data-lang=\"python\">Welcome to the park</code>",
     "correctness": "0.0",
     "feedback_html": "\"Open sunrise to sunset\" is not a part of park_greet() and is printed first. Then \"Welcome to the park\" is printed by park_greet()."
    },
    {
     "id": 1328659,
     "content_html": "<code class=\"python\" data-lang=\"python\">Welcome to the park</code> <br>\n<code class=\"python\" data-lang=\"python\">Open sunrise to sunset</code>",
     "correctness": "0.0",
     "feedback_html": "print(\"Open ...\") is executed first, since the statement is unindented. Then park_greet(), which contains print(\"Welcome ...\"), is called."
    },
    {
     "id": 1328660,
     "content_html": "<code class=\"python\" data-lang=\"python\">Open sunrise to sunset</code> <br>\n<code class=\"python\" data-lang=\"python\">Welcome to the park</code>\n",
     "correctness": "1.0",
     "feedback_html": "The program has an indentation mistake. <code class=\"python\" data-lang=\"python\">print(\"Open ...\")</code> is unindented, so the statement is not a part of <code class=\"python\" data-lang=\"python\">park_greet()</code> and is executed first. Then, <code class=\"python\" data-lang=\"python\">park_greet()</code> is called, and <code class=\"python\" data-lang=\"python\">print(\"Welcome ...\")</code> is executed."
    }
   ],
