   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is an example of hierarchical inheritance?",
   "answers": [
    {
     "id": 1330066,
     "content_html": "Class B inherits from Class A<br>\nClass C inherits from Class A",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">Class A</code> is the superclass for <code class=\"python\" data-lang=\"python\">Class B</code> and <code class=\"python\" data-lang=\"python\">Class C</code>."
    },
    {
     "id": 1330067,
     "content_html": "Class B inherits from Class A<br>\nClass C inherits from Class B",
     "correctness": "0.0",
     "feedback_html": "This is an example of multilevel inheritance. Hierarchical inheritance involves multiple subclasses from the same superclass."
    },
    {
     "id": 1330068,
     "content_html": "Class B inherits from Class A<br>\nClass C inherits from Class D",
     "correctness": "0.0",
     "feedback_html": "This is two instances of single inheritance. Hierarchical inheritance involves multiple subclasses from the same superclass."
    }
