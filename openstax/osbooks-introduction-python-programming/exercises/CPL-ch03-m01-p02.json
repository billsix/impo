  {
   "id": 666234,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If <code class=\"python\" data-lang=\"python\">s = \"Python!\"</code>, what is the value of <code class=\"python\" data-lang=\"python\">s[1] + s[-1]</code>?",
   "answers": [
    {
     "id": 1327920,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"P!\"</code>",
     "correctness": "0.0",
     "feedback_html": "The character at index 1 is not P."
    },
    {
     "id": 1327921,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"y!\"</code>",
     "correctness": "1.0",
     "feedback_html": "The character at index 1 is <code class=\"python\" data-lang=\"python\">y</code>, and the character at index -1 is <code class=\"python\" data-lang=\"python\">!</code>."
    },
    {
     "id": 1327922,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"yn\"</code>",
     "correctness": "0.0",
     "feedback_html": "The character at index -1 is not n."
    }
   ],
