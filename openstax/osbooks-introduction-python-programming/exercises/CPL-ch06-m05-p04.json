 "questions": [
  {
   "id": 666587,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does <code class=\"python\" data-lang=\"python\">yarn_weight(3)</code> return?\n<pre class=\"python\" data-lang=\"python\">def yarn_weight(num):\n&nbsp;&nbsp;if num == 0:\n&nbsp;&nbsp;&nbsp;&nbsp;return \"lace\"\n&nbsp;&nbsp;elif num == 1:\n&nbsp;&nbsp;&nbsp;&nbsp;return \"sock\"\n&nbsp;&nbsp;elif num == 2:\n&nbsp;&nbsp;&nbsp;&nbsp;return \"sport\"\n&nbsp;&nbsp;elif num == 3:\n&nbsp;&nbsp;&nbsp;&nbsp;return \"dk\"\n&nbsp;&nbsp;elif num == 4:\n&nbsp;&nbsp;&nbsp;&nbsp;return \"worsted\"\n&nbsp;&nbsp;elif num == 5:\n&nbsp;&nbsp;&nbsp;&nbsp;return \"bulky\"\n&nbsp;&nbsp;else:\n&nbsp;&nbsp;&nbsp;&nbsp;return \"super bulky\"\n</pre>",
   "answers": [
    {
     "id": 1328802,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"lace\"</code>",
     "correctness": "0.0",
     "feedback_html": "The first return statement doesn't execute because the if condition is False."
    },
    {
     "id": 1328803,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"dk\"</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">num == 3</code> is <code class=\"python\" data-lang=\"python\">True</code>, so the <code class=\"python\" data-lang=\"python\">return \"dk\"</code> statement executes."
    },
    {
     "id": 1328804,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"super bulky\"</code>",
     "correctness": "0.0",
     "feedback_html": "The else statement doesn't execute, because one of the elif conditions is True."
    }
   ],
   "hints": [],
