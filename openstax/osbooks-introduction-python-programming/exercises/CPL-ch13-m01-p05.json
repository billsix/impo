 "questions": [
  {
   "id": 667001,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose a CarryOn class is inherited from a Luggage class. How is a CarryOn instance created?",
   "answers": [
    {
     "id": 1329976,
     "content_html": "<code class=\"python\" data-lang=\"python\">small_bag = CarryOn()</code>",
     "correctness": "1.0",
     "feedback_html": "Deriving <code class=\"python\" data-lang=\"python\">CarryOn</code> from <code class=\"python\" data-lang=\"python\">Luggage</code> is specified in <code class=\"python\" data-lang=\"python\">CarryOn'</code>s class definition. Ex: <code class=\"python\" data-lang=\"python\">class CarryOn(Luggage):</code>. Instances of a subclass, like <code class=\"python\" data-lang=\"python\">CarryOn</code>, are created like other classes and do not require the base class name."
    },
    {
     "id": 1329977,
     "content_html": "<code class=\"python\" data-lang=\"python\">small_bag = Luggage(CarryOn)</code>",
     "correctness": "0.0",
     "feedback_html": "The code attempts to create a Luggage instance. The subclass, CarryOn, has a constructor that must be called to create a CarryOn instance."
    },
    {
     "id": 1329978,
     "content_html": "<code class=\"python\" data-lang=\"python\">small_bag = CarryOn(Luggage)</code>",
     "correctness": "0.0",
     "feedback_html": "The superclass name is included in the subclass definition and is not included in creating subclass instances."
    }
   ],
