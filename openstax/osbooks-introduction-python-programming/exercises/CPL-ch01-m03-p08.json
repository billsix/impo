 "questions": [
  {
   "id": 665827,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the variable name, <code class=\"python\" data-lang=\"python\">DogBreed</code>, which improvement conforms to Python's style guide?",
   "answers": [
    {
     "id": 1327444,
     "content_html": "<code class=\"python\" data-lang=\"python\">dog_breed</code>",
     "correctness": "1.0",
     "feedback_html": "Snake case separates each word with an underscore and uses only lowercase letters."
    },
    {
     "id": 1327445,
     "content_html": "<code class=\"python\" data-lang=\"python\">dogBreed</code>",
     "correctness": "0.0",
     "feedback_html": "dog and Breed should be separated with an underscore, and Breed should start with a lowercase letter."
    },
    {
     "id": 1327446,
     "content_html": "<code class=\"python\" data-lang=\"python\">dog-breed</code>",
     "correctness": "0.0",
     "feedback_html": "dog and breed should be separated with an underscore, not a hyphen. A hyphen is not allowed in a variable name."
    }
   ],
