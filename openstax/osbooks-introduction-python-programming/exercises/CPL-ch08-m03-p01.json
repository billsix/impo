 "questions": [
  {
   "id": 666695,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of (<code class=\"python\" data-lang=\"python\">\"a\" in \"an umbrella\"</code>)? ",
   "answers": [
    {
     "id": 1329111,
     "content_html": "<code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">in</code> operator checks whether a substring exists in another string and if so, returns True. The <code class=\"python\" data-lang=\"python\">in</code> operator does not count the number of occurrences of the substring."
    },
    {
     "id": 1329112,
     "content_html": "<code class=\"python\" data-lang=\"python\">False</code>",
     "correctness": "0.0",
     "feedback_html": "\"a\" is a substring of \"an umbrella\"."
    },
    {
     "id": 1329113,
     "content_html": "<code class=\"python\" data-lang=\"python\">True</code>",
     "correctness": "1.0",
     "feedback_html": "Since <code class=\"python\" data-lang=\"python\">\"a\"</code> is a substring of <code class=\"python\" data-lang=\"python\">\"an umbrella\"</code>, the output of <code class=\"python\" data-lang=\"python\">\"a\"</code> in <code class=\"python\" data-lang=\"python\">\"an umbrella\"</code> is <code class=\"python\" data-lang=\"python\">True</code>."
    },
    {
     "id": 1329114,
     "content_html": "<code class=\"python\" data-lang=\"python\">1</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">in</code> operator's output is a boolean value and is True if the substring exists in the string. While True is equivalent to 1, the output is True."
    }
   ],
