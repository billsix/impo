   "stem_html": "What is the output of (<code class=\"python\" data-lang=\"python\">\"ab\" in \"arbitrary\"</code>)?",
   "answers": [
    {
     "id": 1329117,
     "content_html": "<code class=\"python\" data-lang=\"python\">True</code>",
     "correctness": "0.0",
     "feedback_html": "While \"a\" and \"b\" characters exist in string \"arbitrary\", the substring \"ab\" does not."
    },
    {
     "id": 1329118,
     "content_html": "<code class=\"python\" data-lang=\"python\">False</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"ab\"</code> is not a substring of <code class=\"python\" data-lang=\"python\">\"arbitrary\"</code>; hence, the output is <code class=\"python\" data-lang=\"python\">False</code>."
