   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which operation can be used to add an element to the end of a list?",
   "answers": [
    {
     "id": 877133,
     "content_html": "<code>add()</code>",
     "correctness": "0.0",
     "feedback_html": "An <code>add()</code> operation does not exist for a list."
    },
    {
     "id": 877134,
     "content_html": "<code>append()</code>",
     "correctness": "1.0",
     "feedback_html": "The <code>append()</code> operation adds an element to the end of a list."
    },
    {
     "id": 877135,
     "content_html": "<code>pop()</code>",
     "correctness": "0.0",
     "feedback_html": "The <code>pop()</code> operation is used to remove an item at the end of a list."
    }
