   "id": 666415,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the example above. Why was the evaluation order different from what the programmer wanted?",
   "answers": [
    {
     "id": 1328296,
     "content_html": "Equality has precedence over <code class=\"python\" data-lang=\"python\">and</code>.",
     "correctness": "1.0",
     "feedback_html": "The equality operator, ==, has higher precedence than the logical <code class=\"python\" data-lang=\"python\">and</code>."
    },
    {
     "id": 1328297,
     "content_html": "All operators are evaluated right to left.",
     "correctness": "0.0",
     "feedback_html": "Operator precedence and associativity varies."
    },
    {
     "id": 1328298,
     "content_html": "Order is random when parentheses aren't used.",
     "correctness": "0.0",
     "feedback_html": "The order is based on precedence and associativity."
    }
   ],
