   "stimulus_html": "",
   "stem_html": "Which is an appropriate name for a function that calculates a user's taxes?",
   "answers": [
    {
     "id": 1328628,
     "content_html": "<code class=\"python\" data-lang=\"python\">calc_tax</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">calc_tax</code> is concise, in snake case, and indicates the function's task."
    },
    {
     "id": 1328629,
     "content_html": "<code class=\"python\" data-lang=\"python\">calculate user tax</code>",
