 "questions": [
  {
   "id": 666799,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">my_list = [1, 2, 3]\nlist2 = my_list\nlist2[0] = 13\nprint(sum(my_list))</pre>",
   "answers": [
    {
     "id": 1329414,
     "content_html": "<code class=\"python\" data-lang=\"python\">6</code>",
     "correctness": "0.0",
     "feedback_html": "The initial summation of <code class=\"python\" data-lang=\"python\">my_list</code> is 6. Have any values in the list changed?"
    },
    {
     "id": 1329415,
     "content_html": "<code class=\"python\" data-lang=\"python\">13</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">list2</code> refers to the same list as <code class=\"python\" data-lang=\"python\">my_list</code> so any changes made to list2 also reflect on <code class=\"python\" data-lang=\"python\">my_list</code>. But 13 is the maximum value in the list."
    },
    {
     "id": 1329416,
     "content_html": "<code class=\"python\" data-lang=\"python\">18</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">list2</code> refers to the same list as <code class=\"python\" data-lang=\"python\">my_list</code>, so any changes made to <code class=\"python\" data-lang=\"python\">list2</code> also reflect on <code class=\"python\" data-lang=\"python\">my_list</code>. 18 is the summation of the values in the list."
    }
   ],
