 "questions": [
  {
   "id": 666875,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">fruit_count = {\"apple\": 2, \"orange\": 5, \"banana\": 1}\nfor value in fruit_count.values():\n&nbsp;&nbsp;print(value * 2, end = \" \")</pre>",
   "answers": [
    {
     "id": 1329634,
     "content_html": "<code class=\"python\" data-lang=\"python\">apple orange banana</code>\n",
     "correctness": "0.0",
     "feedback_html": "The loop iterates over values, not keys. What's being printed in the output?"
    },
    {
     "id": 1329635,
     "content_html": "<code class=\"python\" data-lang=\"python\">2 5 1</code>\n",
     "correctness": "0.0",
     "feedback_html": "The loop iterates over values, obtains each value, multiplies the value by 2, and prints in the output. What must be printed?"
    },
    {
     "id": 1329636,
     "content_html": "<code class=\"python\" data-lang=\"python\">4 10 2</code>\n\n",
     "correctness": "1.0",
     "feedback_html": "The loop multiplies all values by 2 and prints the output. So, <code class=\"python\" data-lang=\"python\">4</code>, <code class=\"python\" data-lang=\"python\">10</code>, and <code class=\"python\" data-lang=\"python\">2</code> are printed."
    }
   ],
