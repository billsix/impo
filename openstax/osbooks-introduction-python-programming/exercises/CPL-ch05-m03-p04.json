 "questions": [
  {
   "id": 666491,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following code, how many times does the outer loop execute?\n<pre class=\"python\" data-lang=\"python\">for i in range(3):\n&nbsp;&nbsp;for j in range(4):\n&nbsp;&nbsp;&nbsp;&nbsp;print(i, ' ', j)\n</pre>\n",
   "answers": [
    {
     "id": 1328526,
     "content_html": "3",
     "correctness": "1.0",
     "feedback_html": "The outer loop's execution range is <code class=\"python\" data-lang=\"python\">0</code>, <code class=\"python\" data-lang=\"python\">1</code>, and <code class=\"python\" data-lang=\"python\">2</code>; hence, the outer loop executes three times."
    },
    {
     "id": 1328527,
     "content_html": "4",
     "correctness": "0.0",
     "feedback_html": "The outer loop is the outermost loop construct. In the provided code, the outer loop's range is between 0 and 2 as the range function is exclusive of the upper bound."
    },
    {
     "id": 1328528,
     "content_html": "12",
     "correctness": "0.0",
     "feedback_html": "To calculate the number of times a loop executes, the number of times that the loop expression is evaluated must be counted. The outer loop in the given example executes for <code class=\"python\" data-lang=\"python\">i</code> = 0, 1, and 2."
    }
   ],
