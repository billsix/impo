 "questions": [
  {
   "id": 666793,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct way to get the minimum of a list named <code class=\"python\" data-lang=\"python\">nums_list</code>?",
   "answers": [
    {
     "id": 1329396,
     "content_html": "<code class=\"python\" data-lang=\"python\">min(nums_list)</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">min()</code> function takes a list as a parameter and returns the minimum for the list."
    },
    {
     "id": 1329397,
     "content_html": "<code class=\"python\" data-lang=\"python\">nums_list.min()</code>",
     "correctness": "0.0",
     "feedback_html": "List objects do not have a <code class=\"python\" data-lang=\"python\">min()</code> method. Use the built-in <code class=\"python\" data-lang=\"python\">min()</code> function instead."
    },
    {
     "id": 1329398,
     "content_html": "<code class=\"python\" data-lang=\"python\">minimum(nums_list)</code>",
     "correctness": "0.0",
     "feedback_html": "To find the minimum the function to be used is <code class=\"python\" data-lang=\"python\">min()</code>."
    }
   ],
