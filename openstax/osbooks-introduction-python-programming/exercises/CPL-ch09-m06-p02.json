 "questions": [
  {
   "id": 666815,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would be the contents of <code class=\"python\" data-lang=\"python\">b_list</code> after executing the code below?\n<pre class=\"python\" data-lang=\"python\">a_list = [1, 2, 3, 4, 5]\nb_list = [i+2 for i in a_list]</pre>",
   "answers": [
    {
     "id": 1329458,
     "content_html": "<code class=\"python\" data-lang=\"python\">[1, 2, 3, 4, 5]</code>",
     "correctness": "0.0",
     "feedback_html": "The elements of a_list are <code class=\"python\" data-lang=\"python\">[1, 2, 3, 4, 5]</code>. The list comprehension modifies each element in some way before insertion into b_list."
    },
    {
     "id": 1329459,
     "content_html": "<code class=\"python\" data-lang=\"python\">[0, 1, 2, 3, 4]</code>",
     "correctness": "0.0",
     "feedback_html": "The for loop is not based on a range but on the elements of a_list."
    },
    {
     "id": 1329460,
     "content_html": "<code class=\"python\" data-lang=\"python\">[3, 4, 5, 6, 7]</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">i+2</code> results in adding 2 to each element of <code class=\"python\" data-lang=\"python\">a_list</code> to generate <code class=\"python\" data-lang=\"python\">b_list</code>."
    }
   ],
