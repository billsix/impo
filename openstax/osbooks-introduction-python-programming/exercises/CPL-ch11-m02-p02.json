   "id": 666889,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an instance of the <code class=\"python\" data-lang=\"python\">Cat</code> class?",
   "answers": [
    {
     "id": 1329676,
     "content_html": "<code class=\"python\" data-lang=\"python\">__init__</code>",
     "correctness": "0.0",
     "feedback_html": "__init__() is a method. An instance is created by calling Cat()."
    },
    {
     "id": 1329677,
     "content_html": "<code class=\"python\" data-lang=\"python\">name</code>",
     "correctness": "0.0",
     "feedback_html": "name is an attribute. An instance is created by calling Cat()."
    },
    {
     "id": 1329678,
     "content_html": "<code class=\"python\" data-lang=\"python\">pet_1</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">pet_1</code> is an instance of the <code class=\"python\" data-lang=\"python\">Cat</code> class created by calling <code class=\"python\" data-lang=\"python\">Cat()</code>. The other instance is <code class=\"python\" data-lang=\"python\">pet_2</code>."
    }
