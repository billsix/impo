 "questions": [
  {
   "id": 666367,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following, which part is the condition?\n<pre class=\"python\" data-lang=\"python\">if age &lt; 12:\n&nbsp;&nbsp;print(\"Discount for children available\")\n</pre>",
   "answers": [
    {
     "id": 1328170,
     "content_html": "<code class=\"python\" data-lang=\"python\">age</code>",
     "correctness": "0.0",
     "feedback_html": "The variable age is part of the condition."
    },
    {
     "id": 1328171,
     "content_html": "<code class=\"python\" data-lang=\"python\">age &lt; 12</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">age &lt; 12</code> is between <code class=\"python\" data-lang=\"python\">\"if\"</code> and \":\" and is an expression that evaluates to <code class=\"python\" data-lang=\"python\">True</code> or <code class=\"python\" data-lang=\"python\">False</code>."
    },
    {
     "id": 1328172,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Discount for children available\")</code>",
     "correctness": "0.0",
     "feedback_html": "The print statement is the body of the if statement, not the condition of the if statement. The condition comes before the body."
    }
   ],
