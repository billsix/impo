 "questions": [
  {
   "id": 666447,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the conditional expression version of the following <code class=\"python\" data-lang=\"python\">if-else</code> statement?\n<pre class=\"python\" data-lang=\"python\">if x%2 == 0:\n&nbsp;&nbsp;response = 'even'\nelse:\n&nbsp;&nbsp;response = 'odd'\n</pre>",
   "answers": [
    {
     "id": 1328396,
     "content_html": "<code class=\"python\" data-lang=\"python\">response = if x%2 == 0 \"even\" else \"odd\"</code>",
     "correctness": "0.0",
     "feedback_html": "The expresson_if_true should come before the condition."
    },
    {
     "id": 1328397,
     "content_html": "<code class=\"python\" data-lang=\"python\">response = \"odd\" if x%2 == 0 else \"even\"</code>",
     "correctness": "0.0",
     "feedback_html": "The expression_if_true and expression_if_false are reversed."
    },
    {
     "id": 1328398,
     "content_html": "<code class=\"python\" data-lang=\"python\">response = \"even\" if x%2 == 0 else \"odd\"</code>",
     "correctness": "1.0",
     "feedback_html": "The conditional expression will assign <code class=\"python\" data-lang=\"python\">response</code> with <code class=\"python\" data-lang=\"python\">\"even\"</code> if <code class=\"python\" data-lang=\"python\">x</code> is even. <code class=\"python\" data-lang=\"python\">response</code> is assigned with <code class=\"python\" data-lang=\"python\">\"odd\"</code> if <code class=\"python\" data-lang=\"python\">x</code> is odd."
    }
   ],
