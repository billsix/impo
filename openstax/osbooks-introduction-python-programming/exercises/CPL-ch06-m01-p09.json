 "questions": [
  {
   "id": 666527,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many times can <code class=\"python\" data-lang=\"python\">calc_distance()</code> be called?",
   "answers": [
    {
     "id": 1328634,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "calc_distance() is a reusable group of statements intended to be called multiple times."
    },
    {
     "id": 1328635,
     "content_html": "3",
     "correctness": "0.0",
     "feedback_html": "The program calls calc_distance() 3 times, but the function can be called many more times."
    },
    {
     "id": 1328636,
     "content_html": "many",
     "correctness": "1.0",
     "feedback_html": "The benefits of a function's reusability is highlighted by many function calls that drastically reduce the amount of cluttered, redundant code. Calling <code class=\"python\" data-lang=\"python\">calc_distance()</code> 10 times is equivalent to 60 statements in the original program."
    }
   ],
