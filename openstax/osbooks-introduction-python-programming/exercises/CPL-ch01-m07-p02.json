   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which symbol is used for comments in Python?",
   "answers": [
    {
     "id": 864398,
     "content_html": "#",
     "correctness": "1.0",
     "feedback_html": "The hash character indicates the beginning of a comment."
    },
    {
     "id": 864399,
     "content_html": "/*",
     "correctness": "0.0",
     "feedback_html": "\"Slash star\" is used in other programming languages <span class=\"magenta-code\">like Java and C++, but not Python</span>."
    },
    {
     "id": 864400,
     "content_html": "//",
     "correctness": "0.0",
     "feedback_html": "\"Slash slash\" is used in other programming languages <span class=\"magenta-code\">like Java and C++, but not Python</span>."
    }
   ],
