 "questions": [
  {
   "id": 666961,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would happen if the condition in line 8 <code class=\"python\" data-lang=\"python\">palindrome()</code> is changed to <code>if palindrome(word.strip(word[0]))</code>.",
   "answers": [
    {
     "id": 1329877,
     "content_html": "Nothing. The function would work the same: the first and last letter would be removed.",
     "correctness": "0.0",
     "feedback_html": "The <code>strip()</code> function removes the same letter from the beginning and end of a string, including repeated letters."
    },
    {
     "id": 1329878,
     "content_html": "Some words, such as <code class=\"python\" data-lang=\"python\">\"madamm\"</code>, would be incorrectly recognized as a palindrome.",
     "correctness": "1.0",
     "feedback_html": "The <code>strip()</code> function removes a given letter from the beginning and end of the string, including repeated letters. When <code class=\"python\" data-lang=\"python\">strip('m')</code> is used with <code class=\"python\" data-lang=\"python\">\"madamm\"</code>, the resultant string is <code class=\"python\" data-lang=\"python\">\"ada\"</code>."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
