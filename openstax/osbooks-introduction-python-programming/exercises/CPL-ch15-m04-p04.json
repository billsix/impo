   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following returns the first three rows of column A?",
   "answers": [
    {
     "id": 1330360,
     "content_html": "<code class=\"python\" data-lang=\"python\">df.loc[1:3, \"A\"]</code>",
     "correctness": "0.0",
     "feedback_html": "Row and column indexing in DataFrame starts from 0."
    },
    {
     "id": 1330361,
     "content_html": "<code class=\"python\" data-lang=\"python\">df.loc[0:2, \"A\"]</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">df.loc[0:2, \"A\"]</code> returns rows 0 to 2 (inclusive) of column A."
    },
    {
     "id": 1330362,
     "content_html": "<code class=\"python\" data-lang=\"python\">df.loc[0:3, \"A\"]</code>",
     "correctness": "0.0",
     "feedback_html": "The provided range to the <code class=\"python\" data-lang=\"python\">loc[]</code> method is inclusive of both ends. What is the range that includes the first three rows?"
