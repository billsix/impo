 "questions": [
  {
   "id": 666297,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What statement displays the variable <code class=\"python\" data-lang=\"python\">money</code> rounded to two decimal places?",
   "answers": [
    {
     "id": 1327986,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(f\"{money:2d}\")</code>",
     "correctness": "0.0",
     "feedback_html": "The letter 'd' is used for decimal (base 10) integers, not floating-point numbers."
    },
    {
     "id": 1327987,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(f\"{money:2f}\")</code>",
     "correctness": "0.0",
     "feedback_html": "The format specifier \"2f\" means fixed-point, at least two characters wide."
    },
    {
     "id": 1327988,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(f\"{money:.2f}\")</code>",
     "correctness": "1.0",
     "feedback_html": "The format specifier <code class=\"python\" data-lang=\"python\">\".2f\"</code> (with a period) means fixed-point, rounded to two decimal places."
    }
   ],
