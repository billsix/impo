 "questions": [
  {
   "id": 666295,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What f-string formats a date as <code class=\"python\" data-lang=\"python\">MM/DD/YYYY</code>?",
   "answers": [
    {
     "id": 1327980,
     "content_html": "<code class=\"python\" data-lang=\"python\">f\"{month:02d}/{day:02d}/{year}\"</code>",
     "correctness": "1.0",
     "feedback_html": "The format specifier <code class=\"python\" data-lang=\"python\">02d</code> appends a 0 to the front of the integer when the integer is only one digit."
    },
    {
     "id": 1327981,
     "content_html": "<code class=\"python\" data-lang=\"python\">f\"{month:2d}/{day:2d}/{year}\"</code>",
     "correctness": "0.0",
     "feedback_html": "The format specifier 2d appends a space to the front of the integer when the integer is only one digit."
    },
    {
     "id": 1327982,
     "content_html": "<code class=\"python\" data-lang=\"python\">f\"{month}/{day}/{year}\"</code>",
     "correctness": "0.0",
     "feedback_html": "The f-string includes no format specifiers, so the default integer format is used."
    }
   ],
