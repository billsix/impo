 "questions": [
  {
   "id": 667063,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is printed as a result of executing <code class=\"python\" data-lang=\"python\">print(fileobj.readline())</code>?",
   "answers": [
    {
     "id": 1330154,
     "content_html": "The first line of <i>input.txt</i> is printed.",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">readline()</code> function reads the next line of a file. Since <code class=\"python\" data-lang=\"python\">readline()</code> is called right after opening the file the first line is read. The resulting string <code class=\"python\" data-lang=\"python\">\"Hello world!\"</code> is printed. Note that <code class=\"python\" data-lang=\"python\">readline()</code> includes the <code class=\"python\" data-lang=\"python\">'\\n'</code> character so the print will include an additional newline."
    },
    {
     "id": 1330155,
     "content_html": "The contents of the file <i>input.txt</i> are printed.",
     "correctness": "0.0",
     "feedback_html": "The readline() function does not print the entire file contents."
    },
    {
     "id": 1330156,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "There is no error for the given line of code provided fileobj is associated with a file."
    }
   ],
