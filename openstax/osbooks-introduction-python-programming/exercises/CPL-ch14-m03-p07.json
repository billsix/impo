 "questions": [
  {
   "id": 667089,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code for the <i>books.csv</i> seen above?\n<pre class=\"python\" data-lang=\"python\">file_obj = open(\"books.csv\")\n\ncsv_read = file_obj.readline()\n\nprint(csv_read)</pre>",
   "answers": [
    {
     "id": 1330226,
     "content_html": "<code class=\"python\" data-lang=\"python\">['Title, Author, Pages\\n', '1984, George Orwell, 268\\n', 'Jane Eyre, Charlotte Bronte, 532\\n', 'Walden, Henry David Thoreau, 156\\n', 'Moby Dick, Herman Melville, 538']</code>",
     "correctness": "0.0",
     "feedback_html": "The function <code class=\"python\" data-lang=\"python\">readlines()</code> reads the complete contents of the file books.csv. But line 3 in the code uses <code>readline()</code>."
    },
    {
     "id": 1330227,
     "content_html": "<code class=\"python\" data-lang=\"python\">[['Title', ' Author', ' Pages'], ['1984', ' George Orwell', ' 268'], ['Jane Eyre', ' Charlotte Bronte', ' 532'], ['Walden', ' Henry David Thoreau', ' 156'], ['Moby Dick', ' Herman Melville', ' 538']]</code>",
     "correctness": "0.0",
     "feedback_html": "This is the result of running line 19 in the code example above. But this result occurs after the processing in lines 6-16 of the example."
    },
    {
     "id": 1330228,
     "content_html": "<code class=\"python\" data-lang=\"python\">Title, Author, Pages</code>",
     "correctness": "1.0",
     "feedback_html": "The first line of the <i>books.csv</i> is read into <code class=\"python\" data-lang=\"python\">csv_read</code>. The first line is <code class=\"python\" data-lang=\"python\">'Title, Author, Pages'</code>, which is the same as the first row."
    }
   ],
