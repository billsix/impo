 "questions": [
  {
   "id": 666581,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is returned by <code class=\"python\" data-lang=\"python\">calc_mpg(miles, gallons)</code>?\n<pre class=\"python\" data-lang=\"python\">def calc_mpg(miles, gallons):\n&nbsp;&nbsp;mpg = miles/gallons\n&nbsp;&nbsp;return mpg\n</pre>",
   "answers": [
    {
     "id": 1328784,
     "content_html": "<code class=\"python\" data-lang=\"python\">mpg</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">calc_mpg()</code> specifies <code class=\"python\" data-lang=\"python\">mpg</code> to be returned with the <code class=\"python\" data-lang=\"python\">return</code> statement."
    },
    {
     "id": 1328785,
     "content_html": "<code class=\"python\" data-lang=\"python\">None</code>",
     "correctness": "0.0",
     "feedback_html": "None is a keyword for no value. Functions that don't specify a return value return None, but calc_mpg() specifies a return value."
    },
    {
     "id": 1328786,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "The return statement correctly specifies a value to be returned."
    }
   ],
