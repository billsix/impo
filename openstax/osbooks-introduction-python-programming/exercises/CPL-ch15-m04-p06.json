 "questions": [
  {
   "id": 667137,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following returns the first column?",
   "answers": [
    {
     "id": 1330372,
     "content_html": "<code class=\"python\" data-lang=\"python\">df.loc[0, :]</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">loc[0, :]</code> returns the first row, not the first column."
    },
    {
     "id": 1330373,
     "content_html": "<code class=\"python\" data-lang=\"python\">df.iloc[:, 0]</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">iloc[:, 0]</code> selects all rows corresponding to the column index 0, which equals returning the first column."
    },
    {
     "id": 1330374,
     "content_html": "<code class=\"python\" data-lang=\"python\">df.loc[\"A\"]</code>",
     "correctness": "0.0",
     "feedback_html": "To select columns, row index must be specified or if all rows are being returned, the operator <code class=\"python\" data-lang=\"python\">:</code> has to be passed to <code class=\"python\" data-lang=\"python\">loc[]</code> method."
    }
   ],
