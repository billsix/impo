 "questions": [
  {
   "id": 667069,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A new file called <i>newlog.txt</i> must be created. Which of the following lines of code works best?",
   "answers": [
    {
     "id": 1330172,
     "content_html": "<code class=\"python\" data-lang=\"python\">logfile = open(\"newlog.txt\")</code>",
     "correctness": "0.0",
     "feedback_html": "The default mode for the open() function is read. If the file does not exist an error will occur. If the file exists then read mode will not allow writing to the file."
    },
    {
     "id": 1330173,
     "content_html": "<code class=\"python\" data-lang=\"python\">logfile = open(\"newlog.txt\", 'w')</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">'w'</code> indicates write mode, and <i>newlog.txt</i> will be created or overwritten (if <i>newlog.txt</i> already exists) and will allow writing."
    },
    {
     "id": 1330174,
     "content_html": "<code class=\"python\" data-lang=\"python\">logfile = open(\"newlog.txt\", 'a')</code>",
     "correctness": "0.0",
     "feedback_html": "'a' indicates append mode. If the file doesn't exist then append mode can be used. However, if the file exists then append mode will write changes to the end of the existing file."
    }
   ],
