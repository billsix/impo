   "id": 349036,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to the TIOBE Index, which two languages were most popular from 2001 to 2021?",
   "answers": [
    {
     "id": 864542,
     "content_html": "C and C++",
     "correctness": "0.0",
     "feedback_html": "Although very popular, C++ has never ranked in the top two on the TIOBE Index."
    },
    {
     "id": 864543,
     "content_html": "Java and C",
     "correctness": "1.0",
     "feedback_html": "For 20 years, Java and C traded places as the top language until Python took over in 2021!"
    },
    {
     "id": 864544,
     "content_html": "Python and JavaScript",
     "correctness": "0.0",
     "feedback_html": "JavaScript has been popular on Stack Overflow, but not nearly as high on the TIOBE Index."
    }
