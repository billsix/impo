 "questions": [
  {
   "id": 666981,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many recursive calls are made with <code class=\"python\" data-lang=\"python\">gcd(13, 23)</code>?",
   "answers": [
    {
     "id": 1329926,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "The first call begins a recursion because a != b. How many more calls occur?"
    },
    {
     "id": 1329927,
     "content_html": "8",
     "correctness": "1.0",
     "feedback_html": "The first call <code class=\"python\" data-lang=\"python\">gcd(13, 23)</code> results in <code class=\"python\" data-lang=\"python\">23 - 13 = 10</code>, so the next call is <code class=\"python\" data-lang=\"python\">gcd(13, 10)</code>. Thereafter, other calls are <code class=\"python\" data-lang=\"python\">gcd(10, 3)</code>, <code class=\"python\" data-lang=\"python\">gcd(7, 3)</code>, <code class=\"python\" data-lang=\"python\">gcd (4,3)</code>, <code class=\"python\" data-lang=\"python\">gcd(3,2)</code>, <code class=\"python\" data-lang=\"python\">gcd(2,1)</code>, and <code class=\"python\" data-lang=\"python\">gcd(1,1)</code> for a total of eight calls."
    },
    {
     "id": 1329928,
     "content_html": "13",
     "correctness": "0.0",
     "feedback_html": "Either one of the parameters does not directly indicate how many calls may be needed."
    }
   ],
