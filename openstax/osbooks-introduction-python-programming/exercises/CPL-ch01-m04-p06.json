 "questions": [
  {
   "id": 665839,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which produces the string <code class=\"python\" data-lang=\"python\">\"Awake\"?</code>",
   "answers": [
    {
     "id": 1327480,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"wake\" + \"A\"</code>",
     "correctness": "0.0",
     "feedback_html": "This produces the string \"wakeA\" because strings are concatenated in the order they appear in the concatenation statement."
    },
    {
     "id": 1327481,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"A + wake\"</code>",
     "correctness": "0.0",
     "feedback_html": "Since the + operator is within the enclosed quotes, it is considered to be a part of the string and not the concatenation operator."
    },
    {
     "id": 1327482,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"A\" + \"wake\"</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"A\"</code> and <code class=\"python\" data-lang=\"python\">\"wake\"</code> are valid strings, and the + is not enclosed in quotes, indicating a concatenation operation. Thus the string <code class=\"python\" data-lang=\"python\">\"Awake\"</code> is produced. Note that the concatenation operator does not include any default separator characters like the space character."
    }
   ],
