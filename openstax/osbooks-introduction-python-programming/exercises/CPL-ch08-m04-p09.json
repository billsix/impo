 "questions": [
  {
   "id": 666741,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">template = \"{:5}\"\nprint(template.format(\"123456789\"))\n</pre>",
   "answers": [
    {
     "id": 1329248,
     "content_html": "<code class=\"python\" data-lang=\"python\">56789</code>",
     "correctness": "0.0",
     "feedback_html": "The field length specifies the minimum length of the string and the string is not going to truncate longer string literals by getting a suffix."
    },
    {
     "id": 1329249,
     "content_html": "<code class=\"python\" data-lang=\"python\">123456</code>",
     "correctness": "0.0",
     "feedback_html": "The field length specifies the minimum length of the string and the string is not going to truncate longer string literals by getting a prefix."
    },
    {
     "id": 1329250,
     "content_html": "<code class=\"python\" data-lang=\"python\">123456789</code>",
     "correctness": "1.0",
     "feedback_html": "The field length specification enforces the minimum length of the string. Inputs that are longer than the specified minimum length will not be modified."
    }
   ],
