   "stem_html": "<pre class=\"python\" data-lang=\"python\">z = \"cilantro\"\ncompare_result = (z == \"coriander\")\n</pre>",
   "answers": [
    {
     "id": 1328161,
     "content_html": "<code class=\"python\" data-lang=\"python\">True</code>",
     "correctness": "0.0",
     "feedback_html": "Strings are compared by comparing each character's Unicode values. Letters have ascending Unicode values in alphabetical order (and are case sensitive). \"c\" and \"c\" are equal, so \"i\" is compared to \"o\". \"i\" is not equal to \"o\" so False is produced, though cilantro and coriander come from the same plant. "
    },
