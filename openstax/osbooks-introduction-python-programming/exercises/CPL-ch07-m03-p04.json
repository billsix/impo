    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The variable <code class=\"python\" data-lang=\"python\">__name__</code> is the module's name, unless the module was\nrun as the main program. In that case, <code class=\"python\" data-lang=\"python\">__name__</code> is <code class=\"python\" data-lang=\"python\">\"__main__\"</code>."
    }
