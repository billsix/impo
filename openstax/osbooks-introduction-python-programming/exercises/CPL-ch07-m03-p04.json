 "questions": [
  {
   "id": 666637,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output when <b>running</b> the following <i>test.py</i> module?\n<pre class=\"python\" data-lang=\"python\">import math\n\nprint(math.__name__)\nprint(__name__)\n</pre>",
   "answers": [
    {
     "id": 1328944,
     "content_html": "<pre class=\"python\" data-lang=\"python\">&gt;math\ntest\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The test module was run, so the <code class=\"python\" data-lang=\"python\">__name__</code> of test is <code class=\"python\" data-lang=\"python\">\"__main__\"</code>."
    },
    {
     "id": 1328945,
     "content_html": "<pre class=\"python\" data-lang=\"python\">__main__\ntest\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The test module was run, so the <code class=\"python\" data-lang=\"python\">__name__</code> of math is <code class=\"python\" data-lang=\"python\">\"math\"</code>."
    },
    {
     "id": 1328946,
     "content_html": "<pre class=\"python\" data-lang=\"python\">math\n__main__\n</pre>",
     "correctness": "1.0",
     "feedback_html": "The variable <code class=\"python\" data-lang=\"python\">__name__</code> is the module's name, unless the module was\nrun as the main program. In that case, <code class=\"python\" data-lang=\"python\">__name__</code> is <code class=\"python\" data-lang=\"python\">\"__main__\"</code>."
    }
   ],
   "hints": [],
