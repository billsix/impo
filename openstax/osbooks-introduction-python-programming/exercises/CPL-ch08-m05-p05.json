 "questions": [
  {
   "id": 666757,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the length of the string <code class=\"python\" data-lang=\"python\">\"sss\".join([\"1\",\"2\"])</code>?",
   "answers": [
    {
     "id": 1329296,
     "content_html": "2",
     "correctness": "0.0",
     "feedback_html": "The separator string will be added in between the two elements. What is the length of the string made up of strings <code class=\"python\" data-lang=\"python\">\"1\"</code>, <code class=\"python\" data-lang=\"python\">\"sss\"</code>, and <code class=\"python\" data-lang=\"python\">\"2\"</code>?"
    },
    {
     "id": 1329297,
     "content_html": "5",
     "correctness": "1.0",
     "feedback_html": "The output of <code class=\"python\" data-lang=\"python\">\"sss\".join([\"1\",\"2\"])</code> is <code class=\"python\" data-lang=\"python\">\"1sss2\"</code>, which has a length of 5."
    },
    {
     "id": 1329298,
     "content_html": "8",
     "correctness": "0.0",
     "feedback_html": "The separator <code class=\"python\" data-lang=\"python\">\"sss\"</code> is only going to be placed in between elements. No separator is needed at the end of the string."
    }
   ],
