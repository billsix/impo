 "questions": [
  {
   "id": 389775,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To temporarily prevent a line from being run, one might . . . ",
   "answers": [
    {
     "id": 918175,
     "content_html": "introduce a syntax error in the line.",
     "correctness": "0.0",
     "feedback_html": "Intentionally adding a syntax error is not a good practice.\nThe line will still run, and the resulting error will stop the program.\n"
    },
    {
     "id": 918176,
     "content_html": "remove the line from the program.",
     "correctness": "0.0",
     "feedback_html": "This approach works, but the original line might need to be restored later on."
    },
    {
     "id": 918177,
     "content_html": "insert a # at the beginning of the line.",
     "correctness": "1.0",
     "feedback_html": "The # symbol \"comments out\" the line without removing the line permanently."
    }
   ],
