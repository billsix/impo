   "id": 667121,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following returns the top five rows of a DataFrame?",
   "answers": [
    {
     "id": 1330324,
     "content_html": "<code class=\"python\" data-lang=\"python\">df.head()</code>",
     "correctness": "0.0",
     "feedback_html": "The function <code class=\"python\" data-lang=\"python\">head()</code> returns a DataFrame's top 5 rows if no argument is passed."
    },
    {
     "id": 1330325,
     "content_html": "<code class=\"python\" data-lang=\"python\">df.head(5)</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">df.head(5)</code> returns a DataFrame's top 5 rows."
    },
    {
     "id": 1330326,
     "content_html": "both",
     "correctness": "1.0",
     "feedback_html": "The function <code class=\"python\" data-lang=\"python\">head()</code> returns a DataFrame's top rows. If an argument is not specified, the default number of returned rows is five."
    }
