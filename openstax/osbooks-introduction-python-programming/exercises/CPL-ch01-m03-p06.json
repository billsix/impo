   "id": 665823,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is the name, <code class=\"python\" data-lang=\"python\">2nd_input</code>, not a valid variable name?",
   "answers": [
    {
     "id": 1327432,
     "content_html": "contains an underscore",
     "correctness": "0.0",
     "feedback_html": "Underscores, digits, and letters are allowed in a variable name, but the name cannot start with a digit."
    },
    {
     "id": 1327433,
     "content_html": "starts with a digit",
     "correctness": "1.0",
     "feedback_html": "A variable name can contain, but not start with, a digit."
    },
    {
     "id": 1327434,
     "content_html": "is a keyword",
     "correctness": "0.0",
     "feedback_html": "2nd_input is not a keyword."
    }
