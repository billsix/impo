   "stem_html": "<code class=\"python\" data-lang=\"python\">/users/turtle/files</code> on a Mac for reading",
   "answers": [
    {
     "id": 1330192,
     "content_html": "<code class=\"python\" data-lang=\"python\">fileobj = open(\"out.txt\")</code>",
     "correctness": "0.0",
     "feedback_html": "Since the file is located in a location different from the Python file an error will occur."
    },
    {
     "id": 1330193,
     "content_html": "<code class=\"python\" data-lang=\"python\">fileobj = open(\"/users/turtle/files/out.txt\")</code>",
     "correctness": "1.0",
     "feedback_html": "The path followed by the filename enables the file to be opened correctly and in read mode by default."
    },
    {
     "id": 1330194,
     "content_html": "<code class=\"python\" data-lang=\"python\">fileobj = open(\"/users/turtle/files/out.txt\", 'w')</code>",
     "correctness": "0.0",
     "feedback_html": "The path followed by the filename enables the file to be opened but when reading a file read mode is preferable."
    }
