 "questions": [
  {
   "id": 666901,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose line 2 is changed to <code class=\"python\" data-lang=\"python\">def __init__():</code>. What would <code class=\"python\" data-lang=\"python\">room_1's</code> attributes be initialized to?",
   "answers": [
    {
     "id": 1329712,
     "content_html": "<code class=\"python\" data-lang=\"python\">length = 0</code>, <code class=\"python\" data-lang=\"python\">width = 0</code>",
     "correctness": "0.0",
     "feedback_html": "length and width aren't able to be initialized because __init__() is missing a required parameter."
    },
    {
     "id": 1329713,
     "content_html": "<code class=\"python\" data-lang=\"python\">length = 1</code>, <code class=\"python\" data-lang=\"python\">width = 1</code>",
     "correctness": "0.0",
     "feedback_html": "The self parameter has been removed from the constructor definition, which makes the instance attributes inaccessible."
    },
    {
     "id": 1329714,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">__init__()</code> has one required parameter, conventionally called <code class=\"python\" data-lang=\"python\">self</code>, which allows the constructor to access the instance."
    }
   ],
