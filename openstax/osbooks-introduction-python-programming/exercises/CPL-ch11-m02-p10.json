 "questions": [
  {
   "id": 666905,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose the line <code class=\"python\" data-lang=\"python\">order_1.cup_size = 8</code> is added before <code class=\"python\" data-lang=\"python\">order_3.print_order()</code>. What is the new output?",
   "answers": [
    {
     "id": 1329724,
     "content_html": "<code class=\"python\" data-lang=\"python\">Cafe Coffee Order 3 : 8 oz</code>",
     "correctness": "0.0",
     "feedback_html": "The new line only changes order_1.cup_size and does not affect order_2 and order_3's instance attributes."
    },
    {
     "id": 1329725,
     "content_html": "<code class=\"python\" data-lang=\"python\">Cafe Coffee Order 3 : 16 oz</code>",
     "correctness": "1.0",
     "feedback_html": "Changing <code class=\"python\" data-lang=\"python\">order_1.cup_size</code> does not affect <code class=\"python\" data-lang=\"python\">order_3.cup_size. order_1.cup_size</code> changes to <code class=\"python\" data-lang=\"python\">8</code> and <code class=\"python\" data-lang=\"python\">order_3.cup_size</code> is still <code class=\"python\" data-lang=\"python\">16</code>."
    },
    {
     "id": 1329726,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "order_1 can change the value of instance attributes, but the change doesn't affect other instances' instance attributes."
    }
   ],
