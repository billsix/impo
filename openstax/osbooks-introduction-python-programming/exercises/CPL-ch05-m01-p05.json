 "questions": [
  {
   "id": 666465,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which line is printed as the last line of output?",
   "answers": [
    {
     "id": 1328448,
     "content_html": "<code class=\"python\" data-lang=\"python\">value of n after the loop is -1.</code>",
     "correctness": "0.0",
     "feedback_html": "The loop terminates when n = 0, therefore the value of n after the loop's execution is not equal to -1."
    },
    {
     "id": 1328449,
     "content_html": "<code class=\"python\" data-lang=\"python\">value of n after the loop is 0.</code>",
     "correctness": "1.0",
     "feedback_html": "The loop's termination condition is <code class=\"python\" data-lang=\"python\">n = 0</code>; therefore, the value of <code class=\"python\" data-lang=\"python\">n</code> after the loop equals <code class=\"python\" data-lang=\"python\">0</code>. The last printed line will be: <code class=\"python\" data-lang=\"python\">value of n after the loop is 0</code>."
    },
    {
     "id": 1328450,
     "content_html": "<code class=\"python\" data-lang=\"python\">value of n after the loop is 1.</code>",
     "correctness": "0.0",
     "feedback_html": "During the loop's execution, only the statements in the body will be executed. When loop terminates the first statement after the loop will run."
    }
   ],
