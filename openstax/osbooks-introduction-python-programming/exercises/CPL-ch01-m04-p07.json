 "questions": [
  {
   "id": 665841,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A user enters <code class=\"python\" data-lang=\"python\">\"red\"</code> after the following line of code.\n<pre class=\"python\" data-lang=\"python\">color = input(\"What is your favorite color?\")</pre>\nWhich produces the output <code class=\"python\" data-lang=\"python\">\"Your favorite color is red!\"</code>?",
   "answers": [
    {
     "id": 1327486,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Your favorite color is \" + color + !)</code>",
     "correctness": "0.0",
     "feedback_html": "Punctuation must be enclosed with quotes as well."
    },
    {
     "id": 1327487,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Your favorite color is \" + \"color\" + \"!\")</code>",
     "correctness": "0.0",
     "feedback_html": "The variable color is assigned a string by the input() function, so color does not need to be enclosed with quotes."
    },
    {
     "id": 1327488,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Your favorite color is \" + color + \"!\")</code>",
     "correctness": "1.0",
     "feedback_html": "Note that space characters must be explicitly included when using the concatenation operator."
    }
   ],
