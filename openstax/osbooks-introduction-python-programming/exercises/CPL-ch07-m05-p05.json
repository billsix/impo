 "questions": [
  {
   "id": 666661,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which third-party module is a replacement for the built-in <code class=\"python\" data-lang=\"python\">datetime</code> module?",
   "answers": [
    {
     "id": 1329014,
     "content_html": "<code class=\"python\" data-lang=\"python\">arrow</code>",
     "correctness": "1.0",
     "feedback_html": "According to the \"Features\" section of the documentation, <code class=\"python\" data-lang=\"python\">Arrow</code>'s is a \"fully-implemented, drop-in replacement for <code class=\"python\" data-lang=\"python\">datetime</code>.\""
    },
    {
     "id": 1329015,
     "content_html": "<code class=\"python\" data-lang=\"python\">calendar</code>",
     "correctness": "0.0",
     "feedback_html": "The calendar module is built-in and provides complementary features to the datetime module, not the same features."
    },
    {
     "id": 1329016,
     "content_html": "<code class=\"python\" data-lang=\"python\">time</code>",
     "correctness": "0.0",
     "feedback_html": "The time module is built-in and provides complementary features to the datetime module, not the same features."
    }
