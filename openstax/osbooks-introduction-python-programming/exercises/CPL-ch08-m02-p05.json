 "questions": [
  {
   "id": 666685,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">location = \"classroom\"\nprint(location[-3:-1])\n</pre>",
   "answers": [
    {
     "id": 1329080,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"ro\"</code>",
     "correctness": "0.0",
     "feedback_html": "Character <code class=\"python\" data-lang=\"python\">\"r\"</code> is at index -4 and is not in the range of [-3:-1]. What is the substring <code class=\"python\" data-lang=\"python\">location[-3:-1]</code>?"
    },
    {
     "id": 1329081,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"oo\"</code>",
     "correctness": "1.0",
     "feedback_html": "The slice <code class=\"python\" data-lang=\"python\">[-3:-1]</code> includes characters at index -3 and -2, which are <code class=\"python\" data-lang=\"python\">\"oo\"</code>."
    },
    {
     "id": 1329082,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"oom\"</code>",
     "correctness": "0.0",
     "feedback_html": "The slice [a:b] does not include the character at index b. <code class=\"python\" data-lang=\"python\">location[-3:-1]</code> includes characters at index -3 and -2."
    }
   ],
