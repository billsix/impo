 "questions": [
  {
   "id": 666601,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which function call would produce an error?",
   "answers": [
    {
     "id": 1328840,
     "content_html": "<code class=\"python\" data-lang=\"python\">greeting(\"Morning\", \"Morgan\", count=3)</code>",
     "correctness": "0.0",
     "feedback_html": "Positional arguments \"Morning\" and \"Morgan\" come before the keyword argument, count=3."
    },
    {
     "id": 1328841,
     "content_html": "<code class=\"python\" data-lang=\"python\">greeting(count=1,\"Hi\", \"Bea\")</code>",
     "correctness": "1.0",
     "feedback_html": "The positional arguments, <code class=\"python\" data-lang=\"python\">\"Hi\"</code> and <code class=\"python\" data-lang=\"python\">\"Bea\"</code>, follow the keyword argument <code class=\"python\" data-lang=\"python\">count=1</code>, which produces an error."
    },
    {
     "id": 1328842,
     "content_html": "<code class=\"python\" data-lang=\"python\">greeting(\"Cheers\", \"Colleagues\", 10)</code>",
     "correctness": "0.0",
     "feedback_html": "Using only positional arguments is acceptable. The function call produces a lot of cheers."
    }
   ],
   "hints": [],
