 "questions": [
  {
   "id": 667085,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why does <code class=\"python\" data-lang=\"python\">readlines()</code> work for reading the rows in a CSV file?",
   "answers": [
    {
     "id": 1330214,
     "content_html": "<code class=\"python\" data-lang=\"python\">readlines()</code> reads line by line using the newline <code class=\"python\" data-lang=\"python\">\\n</code> character.",
     "correctness": "1.0",
     "feedback_html": "The newline <code class=\"python\" data-lang=\"python\">\\n</code> character indicates where line breaks are in a file and is used by the <code class=\"python\" data-lang=\"python\">readlines()</code> function to tell lines apart."
    },
    {
     "id": 1330215,
     "content_html": "<code class=\"python\" data-lang=\"python\">readlines()</code> is not appropriate for reading a CSV file.",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">readlines()</code> works well for CSV files. CSV files can also be read with specialized libraries."
    },
    {
     "id": 1330216,
     "content_html": "<code class=\"python\" data-lang=\"python\">readlines()</code> automatically recognizes a CSV file and works accordingly.",
     "correctness": "0.0",
     "feedback_html": "Only specialized libraries recognize a CSV file. The <code class=\"python\" data-lang=\"python\">readlines()</code> function assumes that all files being read in are of the same kind."
    }
   ],
