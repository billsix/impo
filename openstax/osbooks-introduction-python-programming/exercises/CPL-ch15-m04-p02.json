   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(df.iloc[1, 1])</code>?",
   "answers": [
    {
     "id": 1330348,
     "content_html": "<code class=\"python\" data-lang=\"python\">a</code>",
     "correctness": "0.0",
     "feedback_html": "Indexing starts from 0, hence element at index (1, 1) refers to the second row and the second column."
    },
    {
     "id": 1330349,
     "content_html": "<code class=\"python\" data-lang=\"python\">b</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">b</code> is in the second row of the first column. The expression asks for the element at index (1, 1). Which entry would that be?"
    },
    {
     "id": 1330350,
     "content_html": "<code class=\"python\" data-lang=\"python\">20</code>",
     "correctness": "1.0",
     "feedback_html": "The element in the second row and the second column is <code class=\"python\" data-lang=\"python\">20</code>."
    }
