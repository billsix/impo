     "id": 1330263,
     "content_html": "<code class=\"python\" data-lang=\"python\">That didn't work</code>",
     "correctness": "1.0",
     "feedback_html": "If an except clause does not specify a specific error type, then any error type is handled."
    },
    {
     "id": 1330264,
     "content_html": "<code class=\"python\" data-lang=\"python\">IndexError: string index out of range</code>",
     "correctness": "0.0",
