   "stem_html": "<pre class=\"python\" data-lang=\"python\">word = \"one\"\ntry:\n&nbsp;&nbsp;char = word[3]\n&nbsp;&nbsp;print(\"The char is\", char)\nexcept:\n&nbsp;&nbsp;print(\"That didn't work\")\n</pre>",
   "answers": [
    {
     "id": 1330262,
     "content_html": "<code class=\"python\" data-lang=\"python\">The char is e</code>",
     "correctness": "0.0",
     "feedback_html": "The index 3 is out of range."
    },
