   "stimulus_html": "",
   "stem_html": "What is <code class=\"python\" data-lang=\"python\">book_rating'</code>s data type on line 7?",
   "answers": [
    {
     "id": 1327649,
     "content_html": "float",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">book_rating</code> was assigned with <code class=\"python\" data-lang=\"python\">3.5</code> on line 5 and converted from an integer to a float by the interpreter. <code class=\"python\" data-lang=\"python\">book_rating</code> isn't modified after line 5."
    },
