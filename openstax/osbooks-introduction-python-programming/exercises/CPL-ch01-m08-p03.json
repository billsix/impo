   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which sentence best describes the beginning of Python?",
   "answers": [
    {
     "id": 864512,
     "content_html": "CWI hired Guido van Rossum to design a new programming language to compete with C++.",
     "correctness": "0.0",
     "feedback_html": "Python started out as Guido van Rossum's hobby, not his company's official project."
    },
    {
     "id": 864513,
     "content_html": "Python started out as a hobby and became open source after several years of development.",
     "correctness": "0.0",
     "feedback_html": "This statement is partly true. Python did not take several years to become open source."
    },
    {
     "id": 864514,
     "content_html": "van Rossum posted Python's source code online after working on the language for one year.",
     "correctness": "1.0",
     "feedback_html": "Making Python open source early on allowed for many programmers to provide feedback."
    }
   ],
