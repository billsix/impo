  {
   "id": 666419,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x = 8</code> and <code class=\"python\" data-lang=\"python\">y = 9</code>, what is the result of the following? <br>\n<code class=\"python\" data-lang=\"python\">(x+3) * (y-5)</code>",
   "answers": [
    {
     "id": 1328308,
     "content_html": "<code class=\"python\" data-lang=\"python\">30</code>",
     "correctness": "0.0",
     "feedback_html": "Without parentheses, the expression evaluates to 30."
    },
    {
     "id": 1328309,
     "content_html": "<code class=\"python\" data-lang=\"python\">44</code>",
     "correctness": "1.0",
     "feedback_html": "The expressions in parentheses are evaluated first. <code class=\"python\" data-lang=\"python\">(8+3) * (9-5) = 11 * 4 = 44</code>."
    },
    {
     "id": 1328310,
     "content_html": "<code class=\"python\" data-lang=\"python\">94</code>",
     "correctness": "0.0",
     "feedback_html": "The expressions in parentheses are evaluated and multiplied."
    }
   ],
