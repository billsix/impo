 "questions": [
  {
   "id": 666825,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are the keys in the <code class=\"python\" data-lang=\"python\">days</code> dictionary object?",
   "answers": [
    {
     "id": 1329488,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"Sunday\", \"Monday\", \"Tuesday\"</code>",
     "correctness": "1.0",
     "feedback_html": "The first item in each key-value pair is the key. Hence <code class=\"python\" data-lang=\"python\">\"Sunday\", \"Monday\", \"Tuesday\"</code> are key items."
    },
    {
     "id": 1329489,
     "content_html": "<code class=\"python\" data-lang=\"python\">1, 2, 3</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">1, 2, 3</code> are values in the dictionary object. What are the keys in the days dictionary?"
    },
    {
     "id": 1329490,
     "content_html": "<code class=\"python\" data-lang=\"python\">0, 1, 2</code>",
     "correctness": "0.0",
     "feedback_html": "Keys in a dictionary are different from the index in a list. A key item is the first item in each key-value pair."
    }
   ],
