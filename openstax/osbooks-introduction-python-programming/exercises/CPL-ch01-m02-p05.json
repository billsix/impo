 "questions": [
  {
   "id": 665809,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Someone named Sophia enters their name when prompted with\n<pre class=\"python\" data-lang=\"python\">print(\"Please enter your name: \")\nname = input()\n</pre>\n\nWhat is displayed by <code class=\"python\" data-lang=\"python\">print(\"You entered:\", name)</code>?",
   "answers": [
    {
     "id": 1327390,
     "content_html": "<code class=\"python\" data-lang=\"python\">You entered: name</code>",
     "correctness": "0.0",
     "feedback_html": "The print() function will replace the variable, name, with the input data, Sophia, stored in memory."
    },
    {
     "id": 1327391,
     "content_html": "<code class=\"python\" data-lang=\"python\">You entered: Sophia</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">print()</code> function outputs <code class=\"python\" data-lang=\"python\">\"You entered:\"</code> followed by a space character, followed by the input data, <code class=\"python\" data-lang=\"python\">Sophia</code>, which is referenced by the variable name."
    },
    {
     "id": 1327392,
     "content_html": "<code class=\"python\" data-lang=\"python\">You entered:, Sophia</code>",
     "correctness": "0.0",
     "feedback_html": "The print() function automatically puts a space between successive output items. However, the comma that separates output items is not printed."
    }
   ],
