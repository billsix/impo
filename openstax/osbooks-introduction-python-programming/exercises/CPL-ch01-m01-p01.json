   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many types of programs were described in the animation?",
   "answers": [
    {
     "id": 863803,
     "content_html": "3",
     "correctness": "0.0",
     "feedback_html": "The word \"programs\" is in the animation three times, but \"apps\" are programs too."
    },
    {
     "id": 863804,
     "content_html": "4",
     "correctness": "1.0",
     "feedback_html": "Each image in the animation represents a different type of computer program."
    },
    {
     "id": 863805,
     "content_html": "5",
     "correctness": "0.0",
     "feedback_html": "One could argue that music streaming involves many types of programs, but the animation showed only four."
    }
