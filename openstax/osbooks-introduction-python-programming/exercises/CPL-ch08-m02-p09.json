 "questions": [
  {
   "id": 666693,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">str = \"morning\"\nstr = str[1]\nprint(str)\n</pre>\n",
   "answers": [
    {
     "id": 1329104,
     "content_html": "<code class=\"python\" data-lang=\"python\">TypeError</code>",
     "correctness": "0.0",
     "feedback_html": "TypeError is raised when an attempt is made to modify part of a string. In this example, <code class=\"python\" data-lang=\"python\">str</code> variable is being reassigned in the entirety. "
    },
    {
     "id": 1329105,
     "content_html": "<code class=\"python\" data-lang=\"python\">m</code>",
     "correctness": "0.0",
     "feedback_html": "m is the character at index 0. What is the character at index 1?"
    },
    {
     "id": 1329106,
     "content_html": "<code class=\"python\" data-lang=\"python\">o</code>",
     "correctness": "1.0",
     "feedback_html": "The character at index 1, <code class=\"python\" data-lang=\"python\">\"o\"</code>, is replacing the content of variable <code class=\"python\" data-lang=\"python\">str</code>. As such, the print statement prints <code class=\"python\" data-lang=\"python\">\"o\"</code>."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
