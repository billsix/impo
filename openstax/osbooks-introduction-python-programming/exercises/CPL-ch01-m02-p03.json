 "questions": [
  {
   "id": 665805,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What output is produced by the following statement?<br>\n<pre class=\"python\" data-lang=\"python\">print(\"555\", \"0123\", sep=\"-\")</pre>\n\n",
   "answers": [
    {
     "id": 1327378,
     "content_html": "<code class=\"python\" data-lang=\"python\">555 0123</code>",
     "correctness": "0.0",
     "feedback_html": "Multiple items are normally separated by a space, but this code includes the <code>sep=</code> option."
    },
    {
     "id": 1327379,
     "content_html": "<code class=\"python\" data-lang=\"python\">5550123-</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">sep=</code> option changes what is printed between items, not what is printed at the end of the line."
    },
    {
     "id": 1327380,
     "content_html": "<code class=\"python\" data-lang=\"python\">555-0123</code>",
     "correctness": "1.0",
     "feedback_html": "The default space character that separates multiple items has been replaced with the dash character."
    }
   ],
