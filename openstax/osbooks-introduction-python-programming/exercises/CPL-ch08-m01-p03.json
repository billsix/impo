 "questions": [
  {
   "id": 666669,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of (<code class=\"python\" data-lang=\"python\">\"aples\" in \"apples\"</code>)?",
   "answers": [
    {
     "id": 1329034,
     "content_html": "<code class=\"python\" data-lang=\"python\">undefined</code>",
     "correctness": "0.0",
     "feedback_html": "The output of a membership operator (<code class=\"python\" data-lang=\"python\">in</code> or <code class=\"python\" data-lang=\"python\">not in</code>) is a boolean value."
    },
    {
     "id": 1329035,
     "content_html": "<code class=\"python\" data-lang=\"python\">True</code>",
     "correctness": "0.0",
     "feedback_html": "While all characters in <code class=\"python\" data-lang=\"python\">\"aples\"</code> exist in <code class=\"python\" data-lang=\"python\">\"apples\"</code>, but since these characters are not sequential, the string <code class=\"python\" data-lang=\"python\">\"aples\"</code> is not a substring of <code class=\"python\" data-lang=\"python\">\"apples\"</code>."
    },
    {
     "id": 1329036,
     "content_html": "<code class=\"python\" data-lang=\"python\">False</code>",
     "correctness": "1.0",
     "feedback_html": "While all characters in <code class=\"python\" data-lang=\"python\">\"aples\"</code> exist in <code class=\"python\" data-lang=\"python\">\"apples\"</code>, the characters are not sequential, so the string <code class=\"python\" data-lang=\"python\">\"aples\"</code> is not a substring of <code class=\"python\" data-lang=\"python\">\"apples\"</code>. Therefore, <code class=\"python\" data-lang=\"python\">\"aples\"</code> in <code class=\"python\" data-lang=\"python\">\"apples\"</code> returns False."
    }
   ],
