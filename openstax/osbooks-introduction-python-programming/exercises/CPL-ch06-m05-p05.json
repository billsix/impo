   "id": 666589,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output?\n<pre class=\"python\" data-lang=\"python\">def inc_volume(level, max):\n&nbsp;&nbsp;if level &lt; max:\n&nbsp;&nbsp;&nbsp;&nbsp;return level\n&nbsp;&nbsp;&nbsp;&nbsp;level += 1\n&nbsp;&nbsp;else:\n&nbsp;&nbsp;&nbsp;&nbsp;return level\n\nvol1 = inc_volume(9, 10)\nprint(vol1)\nvol2 = inc_volume(10, 10)\nprint(vol2)\n</pre>",
   "answers": [
    {
     "id": 1328808,
     "content_html": "<pre class=\"python\" data-lang=\"python\">9\n10\n</pre>",
     "correctness": "1.0",
     "feedback_html": "For <code class=\"python\" data-lang=\"python\">inc_volume(9,10)</code>, <code class=\"python\" data-lang=\"python\">return level</code> returns <code class=\"python\" data-lang=\"python\">9</code>, and <code class=\"python\" data-lang=\"python\">level += 1</code> is never reached."
    },
    {
     "id": 1328809,
     "content_html": "<pre class=\"python\" data-lang=\"python\">10\n10\n</pre>\n",
     "correctness": "0.0",
     "feedback_html": "This is the intended output, but when level &lt; max, the value of level is returned unchanged."
    },
    {
     "id": 1328810,
     "content_html": "<pre class=\"python\" data-lang=\"python\">10\n11\n</pre>",
     "correctness": "0.0",
     "feedback_html": "inc_volume() doesn't return a value past the max, 10."
    }
