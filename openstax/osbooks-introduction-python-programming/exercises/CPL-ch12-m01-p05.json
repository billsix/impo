 "questions": [
  {
   "id": 391612,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many total steps does it take to solve three rings?",
   "answers": [
    {
     "id": 919738,
     "content_html": "3",
     "correctness": "0.0",
     "feedback_html": "3 steps are needed to move the 2 smaller rings to the middle tower."
    },
    {
     "id": 919739,
     "content_html": "4",
     "correctness": "0.0",
     "feedback_html": "3 steps are needed to move the 2 smaller rings to the middle tower. Another step moves the biggest ring from source to target. The 2 smaller rings have to be moved to target."
    },
    {
     "id": 919740,
     "content_html": "7",
     "correctness": "1.0",
     "feedback_html": "To solve, the two-ring solution is used twice, and there is one extra step to move the biggest ring from the source to the target. Each solution of two rings requires three steps each. So 3 + 1 + 3 = 7 steps total."
    }
   ],
