 "questions": [
  {
   "id": 665835,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is a valid string?",
   "answers": [
    {
     "id": 1327468,
     "content_html": "<code class=\"python\" data-lang=\"python\">You say \"Please\" to be polite</code>",
     "correctness": "0.0",
     "feedback_html": "The string is missing enclosing quotes. A valid string must be enclosed in matching single (or double) quotes. Additionally, since this string contains double quotes, single quotes must be used."
    },
    {
     "id": 1327469,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"You say \"Please\" to be polite\"</code>",
     "correctness": "0.0",
     "feedback_html": "The string is enclosed with matching double quotes. Since double quotes are part of this string, single quotes must be used to enclose the string."
    },
    {
     "id": 1327470,
     "content_html": "<code class=\"python\" data-lang=\"python\">'You say \"Please\" to be polite'</code>",
     "correctness": "1.0",
     "feedback_html": "Note that the enclosing single quotes (') are not part of the string but the double quotes (\") are."
    }
   ],
