 "questions": [
  {
   "id": 666677,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which character is at index 1 in the string <code class=\"python\" data-lang=\"python\">\"hello\"</code>?",
   "answers": [
    {
     "id": 1329058,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"h\"</code>",
     "correctness": "0.0",
     "feedback_html": "Indexing starts from 0. Hence, \"h\" is the character at index 0. Which character is at index 1?"
    },
    {
     "id": 1329059,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"e\"</code>",
     "correctness": "1.0",
     "feedback_html": "Since indexing starts from 0, the character at index 1 is the second character in the string, which is <code class=\"python\" data-lang=\"python\">\"e\"</code>."
    },
    {
     "id": 1329060,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"o\"</code>",
     "correctness": "0.0",
     "feedback_html": "Positive indexing starts from the left to the right. As such, \"o\" is the character at index 4."
    }
   ],
