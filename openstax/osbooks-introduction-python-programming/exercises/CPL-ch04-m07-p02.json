 "questions": [
  {
   "id": 666449,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x = 100</code> and <code class=\"python\" data-lang=\"python\">offset = 10</code>, what is the value of <code class=\"python\" data-lang=\"python\">result</code>?\n<pre class=\"python\" data-lang=\"python\">result = x + offset if x &lt; 100 else x - offset\n</pre>",
   "answers": [
    {
     "id": 1328402,
     "content_html": "<code class=\"python\" data-lang=\"python\">90</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">100 &lt; 100</code> is <code class=\"python\" data-lang=\"python\">False</code> so <code class=\"python\" data-lang=\"python\">result</code> is assigned with <code class=\"python\" data-lang=\"python\">x - offset = 100 - 10 = 90</code>."
    },
    {
     "id": 1328403,
     "content_html": "<code class=\"python\" data-lang=\"python\">100</code>",
     "correctness": "0.0",
     "feedback_html": "100 &lt; 100 is False so result is assigned with x - offset."
    },
    {
     "id": 1328404,
     "content_html": "<code class=\"python\" data-lang=\"python\">110</code>",
     "correctness": "0.0",
     "feedback_html": "100 &lt; 100 is False so result is assigned with x - offset, not x + offset."
    }
   ],
