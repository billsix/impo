 "questions": [
  {
   "id": 665949,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">round(12)</code>?",
   "answers": [
    {
     "id": 1327776,
     "content_html": "<code class=\"python\" data-lang=\"python\">12.0</code>",
     "correctness": "0.0",
     "feedback_html": "When a second argument is not provided to the <code class=\"python\" data-lang=\"python\">round()</code> function, the number of decimal places in the output is zero. 12.0 has one decimal place."
    },
    {
     "id": 1327777,
     "content_html": "<code class=\"python\" data-lang=\"python\">12</code>",
     "correctness": "1.0",
     "feedback_html": "When <code class=\"python\" data-lang=\"python\">round()</code> is applied to an integer value without specifying the number of decimal places, there will be no change to the value."
    },
    {
     "id": 1327778,
     "content_html": "<code class=\"python\" data-lang=\"python\">12.00</code>",
     "correctness": "0.0",
     "feedback_html": "When a second argument is not provided to the <code class=\"python\" data-lang=\"python\">round()</code> function, the number of decimal places in the output is zero. 12.00 has two decimal places."
    }
   ],
