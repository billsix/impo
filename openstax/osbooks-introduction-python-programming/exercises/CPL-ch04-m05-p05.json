 "questions": [
  {
   "id": 666429,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">attendees = 350</code>, what is the final value of <code class=\"python\" data-lang=\"python\">rooms</code>?\n<pre class=\"python\" data-lang=\"python\">rooms = 1\nif attendees &gt;= 100:\n&nbsp;&nbsp;rooms += 3\nif attendees &lt;= 200:\n&nbsp;&nbsp;rooms += 7\nelif attendees &lt;= 400:\n&nbsp;&nbsp;rooms += 14\n</pre>",
   "answers": [
    {
     "id": 1328338,
     "content_html": "<code class=\"python\" data-lang=\"python\">4</code>",
     "correctness": "0.0",
     "feedback_html": "350 >= 100 is True so rooms = 1 + 3 = 4. The next if statement is not chained. 350 &lt;= 200 is False and 350 &lt;= 400 is True, so rooms += 14."
    },
    {
     "id": 1328339,
     "content_html": "<code class=\"python\" data-lang=\"python\">15</code>",
     "correctness": "0.0",
     "feedback_html": "350 >= 100 is True, so rooms = 1 + 3 = 4. Then the if-elif is evaluated and rooms += 14 executes."
    },
    {
     "id": 1328340,
     "content_html": "<code class=\"python\" data-lang=\"python\">18</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">if</code> and <code class=\"python\" data-lang=\"python\">if-elif</code> statements are not chained. The first <code class=\"python\" data-lang=\"python\">if</code> evaluates to <code class=\"python\" data-lang=\"python\">True</code> and executes. Then the <code class=\"python\" data-lang=\"python\">if-elif</code> is evaluated and the <code class=\"python\" data-lang=\"python\">elif</code> branch executes."
    }
   ],
