 "questions": [
  {
   "id": 665803,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which lines of code prints <code class=\"python\" data-lang=\"python\">Hello world!</code> as one line of output?",
   "answers": [
    {
     "id": 1327372,
     "content_html": "<pre class=\"python\" data-lang=\"python\">print(\"Hello\")\nprint(\" world!\")\n</pre>",
     "correctness": "0.0",
     "feedback_html": "This code would produce the output on two separate lines. By default, each print() ends with a newline."
    },
    {
     "id": 1327373,
     "content_html": "<pre class=\"python\" data-lang=\"python\">print(\"Hello\")\nprint(\" world!\", end=\"\")\n</pre>",
     "correctness": "0.0",
     "feedback_html": "This code would produce the output on two separate lines. The <code class=\"python\" data-lang=\"python\">end=\"\"</code> option removes the newline after world, but hello still ends with a newline."
    },
    {
     "id": 1327374,
     "content_html": "<pre class=\"python\" data-lang=\"python\">print(\"Hello\", end=\"\")\nprint(\" world!\")\n</pre>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">end=\"\"</code> option removes the newline character after hello, producing <code class=\"python\" data-lang=\"python\">Hello world!</code> on the same line."
    }
   ],
