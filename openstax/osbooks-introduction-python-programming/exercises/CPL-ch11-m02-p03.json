   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an attribute?",
   "answers": [
    {
     "id": 1329682,
     "content_html": "<code class=\"python\" data-lang=\"python\">breed</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">breed</code> is an instance attribute defined <code class=\"python\" data-lang=\"python\">in __init__()</code>. The other instance attributes are <code class=\"python\" data-lang=\"python\">name</code> and <code class=\"python\" data-lang=\"python\">age</code>."
    },
    {
     "id": 1329683,
     "content_html": "<code class=\"python\" data-lang=\"python\">pet_2</code>",
     "correctness": "0.0",
     "feedback_html": "pet_2 is an instance. An instance attribute is defined in __init__()."
    },
    {
     "id": 1329684,
     "content_html": "<code class=\"python\" data-lang=\"python\">print_info</code>",
     "correctness": "0.0",
     "feedback_html": "print_info() is a method. An instance attribute is defined in the __init__()."
    }
   ],
