 "questions": [
  {
   "id": 665905,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How could line 3 be changed to improve the program overall?",
   "answers": [
    {
     "id": 1327668,
     "content_html": "Use <code class=\"python\" data-lang=\"python\">float()</code> instead of <code class=\"python\" data-lang=\"python\">int()</code>.",
     "correctness": "0.0",
     "feedback_html": "A pizza order should be a whole number, but a fractional part is still important. For a calculation of 7.5, should 7 or 8 pizzas be ordered?"
    },
    {
     "id": 1327669,
     "content_html": "Add <code class=\"python\" data-lang=\"python\">1</code> to the result of <code class=\"python\" data-lang=\"python\">int()</code>.",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">int()</code> removes any fractional part. Many calculations will produce a fractional part. Ex: 46 people with 3.0 slices per person will need 138 slices or <span class=\"blue-code\">17.25</span> pizzas. <code class=\"python\" data-lang=\"python\">int(17.25)</code> is <code class=\"python\" data-lang=\"python\">17</code>, so adding <code class=\"python\" data-lang=\"python\">1</code> produces <code class=\"python\" data-lang=\"python\">18</code> pizzas, a better estimate to ensure enough pizza is ordered."
    },
    {
     "id": 1327670,
     "content_html": "Add <code class=\"python\" data-lang=\"python\">str()</code> around <code class=\"python\" data-lang=\"python\">int()</code>.",
     "correctness": "0.0",
     "feedback_html": "Adding str() around int() doesn't change the calculation or output. Will enough pizza be ordered if the calculation produces a fractional part?"
    }
   ],
