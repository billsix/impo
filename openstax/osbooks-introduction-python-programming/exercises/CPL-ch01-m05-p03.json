 "questions": [
  {
   "id": 665855,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the type of the following value?\n<pre class=\"python\" data-lang=\"python\">\"12.0\"</pre>",
   "answers": [
    {
     "id": 1327528,
     "content_html": "<code class=\"python\" data-lang=\"python\">string</code>",
     "correctness": "1.0",
     "feedback_html": "Any value defined within quotation marks is a string value regardless of the content."
    },
    {
     "id": 1327529,
     "content_html": "<code class=\"python\" data-lang=\"python\">int</code>",
     "correctness": "0.0",
     "feedback_html": "12.0 contains a fraction part, but the value is contained within quotation marks."
    },
    {
     "id": 1327530,
     "content_html": "<code class=\"python\" data-lang=\"python\">float</code>",
     "correctness": "0.0",
     "feedback_html": "While 12.0 is a floating-point value, when placed within quotation marks the type will no longer be a float."
    }
   ],
