 "questions": [
  {
   "id": 666627,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A program begins with <code class=\"python\" data-lang=\"python\">import area</code>.\nWhat code causes a name collision?\n",
   "answers": [
    {
     "id": 1328918,
     "content_html": "<pre class=\"python\" data-lang=\"python\">area = 51\n</pre>",
     "correctness": "1.0",
     "feedback_html": "Assigning the area variable replaces the previously imported module with the integer <code class=\"python\" data-lang=\"python\">51</code>.\nThe variable can no longer be used to call functions in the area module."
    },
    {
     "id": 1328919,
     "content_html": "<pre class=\"python\" data-lang=\"python\">import cylinder from volume\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The name cylinder does not collide with the name area,\neven though the area module has a function named cylinder."
    },
    {
     "id": 1328920,
     "content_html": "<pre class=\"python\" data-lang=\"python\">def cube(size):\n&nbsp;&nbsp;\"\"\"Generates a \"size X size\" rubik's cube.\"\"\"\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The name cube does not collide with the name area,\neven though the area module has a function named cube."
    }
   ],
