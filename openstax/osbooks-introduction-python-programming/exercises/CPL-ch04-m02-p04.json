 "questions": [
  {
   "id": 666373,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">num = -10</code>, what is the final value of <code class=\"python\" data-lang=\"python\">num</code>?\n<pre class=\"python\" data-lang=\"python\">if num &lt; 0:\n&nbsp;&nbsp;num = 25\nif num &lt; 100:\n&nbsp;&nbsp;num = num + 50\n</pre>",
   "answers": [
    {
     "id": 1328188,
     "content_html": "<code class=\"python\" data-lang=\"python\">-10</code>",
     "correctness": "0.0",
     "feedback_html": "-10 &lt; 0 is True so the first if statement is executed and num is assigned with 25. What happens next?"
    },
    {
     "id": 1328189,
     "content_html": "<code class=\"python\" data-lang=\"python\">40</code>",
     "correctness": "0.0",
     "feedback_html": "-10 &lt; 0 is True, so num is assigned with 25. If 25 &lt; 100, 50 is added to num."
    },
    {
     "id": 1328190,
     "content_html": "<code class=\"python\" data-lang=\"python\">75</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">-10 &lt; 0</code> is true, so <code class=\"python\" data-lang=\"python\">num</code> is assigned with <code class=\"python\" data-lang=\"python\">25</code>. Then <code class=\"python\" data-lang=\"python\">25 &lt; 100</code>, so <code class=\"python\" data-lang=\"python\">num</code> is assigned with <code class=\"python\" data-lang=\"python\">25 + 50</code>, which is <code class=\"python\" data-lang=\"python\">75</code>."
    }
   ],
