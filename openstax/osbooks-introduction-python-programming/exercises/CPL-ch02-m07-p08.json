 "questions": [
  {
   "id": 666184,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which character is used for explicit line joining?",
   "answers": [
    {
     "id": 1327902,
     "content_html": "<code class=\"python\" data-lang=\"python\">/</code>",
     "correctness": "0.0",
     "feedback_html": "The forward slash is used for division.\nEx: <code class=\"python\" data-lang=\"python\">2 / 4</code> is <code class=\"python\" data-lang=\"python\">0.5</code>.\n"
    },
    {
     "id": 1327903,
     "content_html": "<code class=\"python\" data-lang=\"python\">\\</code>",
     "correctness": "1.0",
     "feedback_html": "The backslash, when used at the end of a line, indicates a multi-line statement."
    },
    {
     "id": 1327904,
     "content_html": "<code class=\"python\" data-lang=\"python\">|</code>",
     "correctness": "0.0",
     "feedback_html": "The vertical bar is used for performing logic with binary numbers."
    }
   ],
