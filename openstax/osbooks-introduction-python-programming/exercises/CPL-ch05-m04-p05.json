 "questions": [
  {
   "id": 666505,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the following code's output?\n<pre class=\"python\" data-lang=\"python\">for c in \"hi Ali\":\n&nbsp;&nbsp;if c == \" \":\n&nbsp;&nbsp;&nbsp;&nbsp;continue\n&nbsp;&nbsp;print(c)\n</pre>\n",
   "answers": [
    {
     "id": 1328568,
     "content_html": "<pre class=\"python\" data-lang=\"python\">h\ni\n\nA\nl\ni</pre>\n",
     "correctness": "0.0",
     "feedback_html": "When <code class=\"python\" data-lang=\"python\">c == \" \"</code>, the <code class=\"python\" data-lang=\"python\">continue</code> control statement is executed, and hence the space character will not be printed."
    },
    {
     "id": 1328569,
     "content_html": "<pre class=\"python\" data-lang=\"python\">h\ni\nA\nl\ni</pre>\n",
     "correctness": "1.0",
     "feedback_html": "The loop checks whether the character being evaluated is a space character or not. If so, the remainder of the loop will be skipped and the space character will not be printed."
    },
    {
     "id": 1328570,
     "content_html": "<pre class=\"python\" data-lang=\"python\">hi\nAli</pre>\n",
     "correctness": "0.0",
     "feedback_html": "When using a <code class=\"python\" data-lang=\"python\">for</code> loop to iterate over a string value, the characters in the string will be visited one at a time."
    }
   ],
