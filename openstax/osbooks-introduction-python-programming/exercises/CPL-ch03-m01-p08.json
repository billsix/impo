 "questions": [
  {
   "id": 666285,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement prints a backslash (\\) to the screen?",
   "answers": [
    {
     "id": 1327950,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\\\\)</code>",
     "correctness": "0.0",
     "feedback_html": "An escape sequence must be enclosed with single (') or double (\") quotes like any string."
    },
    {
     "id": 1327951,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\\\"\\\")</code>",
     "correctness": "0.0",
     "feedback_html": "The backslash (\\) that indicates an escape sequence must be within the enclosing quotes of the string."
    },
    {
     "id": 1327952,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"\\\\\")</code>",
     "correctness": "1.0",
     "feedback_html": "The first backslash indicates an escape sequence, and the second backslash indicates the character."
    }
   ],
