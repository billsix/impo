   "stimulus_html": "",
   "stem_html": "<span class=\"red-code\">In the above example,</span> when evaluating math, why did the interpreter raise a <code class=\"python\" data-lang=\"python\">NameError</code>?",
   "answers": [
    {
     "id": 1327818,
     "content_html": "The math module was not available.",
     "correctness": "0.0",
     "feedback_html": "The math module is part of the standard library and is always available."
    },
    {
     "id": 1327819,
     "content_html": "The variable pie was spelled incorrectly.",
     "correctness": "0.0",
     "feedback_html": "The Greek letter pi is spelled without an 'e' at the end."
    },
    {
     "id": 1327820,
     "content_html": "The math module was not imported.",
     "correctness": "1.0",
     "feedback_html": "The import statement defines the math variable needed to access the module."
    }
   ],
