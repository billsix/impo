 "questions": [
  {
   "id": 666801,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">my_list = [1, 2, 3]\nlist2 = my_list.copy()\nlist2[0] = 13\nprint(max(my_list))</pre>",
   "answers": [
    {
     "id": 1329420,
     "content_html": "<code class=\"python\" data-lang=\"python\">3</code>",
     "correctness": "1.0",
     "feedback_html": "3 is the maximum value in the list <code class=\"python\" data-lang=\"python\">my_list</code>. Line 3 changes the value of the first element in <code class=\"python\" data-lang=\"python\">list2</code>."
    },
    {
     "id": 1329421,
     "content_html": "<code class=\"python\" data-lang=\"python\">13</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">list2</code> is initially a copy of <code class=\"python\" data-lang=\"python\">my_list</code>. The first element of <code class=\"python\" data-lang=\"python\">list2</code> is changed to 13, which is also the maximum of <code class=\"python\" data-lang=\"python\">list2</code>. However, <code class=\"python\" data-lang=\"python\">my_list</code> remains unchanged."
    },
    {
     "id": 1329422,
     "content_html": "<code class=\"python\" data-lang=\"python\">18</code>",
     "correctness": "0.0",
     "feedback_html": "18 is the summation of the items in <code class=\"python\" data-lang=\"python\">list2</code> not the maximum."
    }
   ],
