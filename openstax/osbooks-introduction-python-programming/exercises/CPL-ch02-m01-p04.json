   "stem_html": "Which arrow keys were needed to edit the typo?",
   "answers": [
    {
     "id": 917963,
     "content_html": "only the up arrow key",
     "correctness": "0.0",
     "feedback_html": "The up arrow displays the previous line without making any changes."
    },
    {
     "id": 917964,
     "content_html": "the up and down arrows",
     "correctness": "0.0",
     "feedback_html": "The up arrow displays the previous line, and the down arrow displays the next line."
    },
    {
     "id": 917965,
     "content_html": "the up and left arrows",
     "correctness": "1.0",
     "feedback_html": "The up arrow displays the previous line, and the left arrow moves within that line."
    }
