   "id": 665829,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a string?",
   "answers": [
    {
     "id": 1327450,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hello!</code>",
     "correctness": "0.0",
     "feedback_html": "A string is a sequence of characters enclosed with matching single (') or double (\") quotes."
    },
    {
     "id": 1327451,
     "content_html": "<code class=\"python\" data-lang=\"python\">29</code>",
     "correctness": "0.0",
     "feedback_html": "A string is a sequence of characters enclosed with matching single (') or double (\") quotes."
    },
    {
     "id": 1327452,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"7 days\"</code>",
     "correctness": "1.0",
     "feedback_html": "A string that is enclosed by matching double quotes is a valid string. Note that <code class=\"python\" data-lang=\"python\">'7 days'</code> is also a string."
    }
