   "stimulus_html": "",
   "stem_html": "Which edit is appropriate?",
   "answers": [
    {
     "id": 1330113,
     "content_html": "Move <code class=\"python\" data-lang=\"python\">eat()</code> to a different class.",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">eat()</code> only applies to carnivorous plants, which <code class=\"python\" data-lang=\"python\">Pitcher</code> and <code class=\"python\" data-lang=\"python\">VenusFlyTrap</code> represent."
    },
    {
     "id": 1330114,
     "content_html": "Remove <code class=\"python\" data-lang=\"python\">Plant</code> as a superclass.",
     "correctness": "0.0",
     "feedback_html": "Rose, Pitcher, and VenusFlyTrap represent plants that photosynthesize. So Rose, Pitcher, and VenusFlyTrap should inherit from Plant."
    }
   ],
