 "questions": [
  {
   "id": 666731,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(\"Hey {name}!\".format(name = \"Bengio\"))</code>?",
   "answers": [
    {
     "id": 1329218,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hey name!</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">name</code> is a named replacement field that must be replaced with the value of the name variable."
    },
    {
     "id": 1329219,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hey Bengio</code>",
     "correctness": "0.0",
     "feedback_html": "The replacement field is the only part of the string template that is changed by the <code class=\"python\" data-lang=\"python\">format()</code> function. The rest of the string remains the same. The given template has an exclamation mark after the replacement field that must be added to the output."
    },
    {
     "id": 1329220,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hey Bengio!</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"Bengio\"</code> is substituted in the named replacement field associated with the tag <code class=\"python\" data-lang=\"python\">name</code>; hence, the output is <code class=\"python\" data-lang=\"python\">\"Hey Bengio!\"</code>. "
    }
   ],
