 "questions": [
  {
   "id": 389721,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the example programs above, what syntax required by Java is not required by Python?",
   "answers": [
    {
     "id": 918089,
     "content_html": "semicolons",
     "correctness": "1.0",
     "feedback_html": "Python does not require a semicolon at the end of each line. Braces are also not required."
    },
    {
     "id": 918090,
     "content_html": "parentheses",
     "correctness": "0.0",
     "feedback_html": "Both languages require parentheses when using the print function."
    },
    {
     "id": 918091,
     "content_html": "quote marks",
     "correctness": "0.0",
     "feedback_html": "Both languages require quote marks around the message \"Hello, World!\""
    }
   ],
