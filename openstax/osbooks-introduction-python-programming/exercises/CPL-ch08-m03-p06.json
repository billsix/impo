 "questions": [
  {
   "id": 666705,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">word = \"cab\"\nfor i in word:\n&nbsp;&nbsp;if i == \"a\":\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"A\", end = \"\")\n&nbsp;&nbsp;if i == \"b\":\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"B\", end = \"\")\n&nbsp;&nbsp;if i == \"c\":\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"C\", end = \"\") </pre>",
   "answers": [
    {
     "id": 1329139,
     "content_html": "<code class=\"python\" data-lang=\"python\">cab</code>",
     "correctness": "0.0",
     "feedback_html": "The for loop converts each character to uppercase equivalent using the if statements. What is the uppercase equivalent for \"cab\"?"
    },
    {
     "id": 1329140,
     "content_html": "<code class=\"python\" data-lang=\"python\">abc</code>",
     "correctness": "0.0",
     "feedback_html": "The for loop preserves the order of characters when iterating over characters."
    },
    {
     "id": 1329141,
     "content_html": "<code class=\"python\" data-lang=\"python\">CAB</code>",
     "correctness": "1.0",
     "feedback_html": "The code iterates over the characters in <code class=\"python\" data-lang=\"python\">\"cab\"</code> and prints each character's uppercase equivalent. Therefore, the output is <code class=\"python\" data-lang=\"python\">\"CAB\"</code>."
    },
    {
     "id": 1329142,
     "content_html": "<code class=\"python\" data-lang=\"python\">ABC</code>",
     "correctness": "0.0",
     "feedback_html": "The for loop preserves the order of characters in the \"cab\" and converts each character to the uppercase equivalent."
    }
