 "questions": [
  {
   "id": 667039,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which attributes does <code class=\"python\" data-lang=\"python\">d_inst</code> have access to?",
   "answers": [
    {
     "id": 1330090,
     "content_html": "<code class=\"python\" data-lang=\"python\">b_attr</code>, <code class=\"python\" data-lang=\"python\">d_attr</code>",
     "correctness": "0.0",
     "feedback_html": "D inherits from B, but B also inherits from A."
    },
    {
     "id": 1330091,
     "content_html": "<code class=\"python\" data-lang=\"python\">a_attr</code>, <code class=\"python\" data-lang=\"python\">b_attr</code>, <code class=\"python\" data-lang=\"python\">d_attr</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">D</code>, which inherits from <code class=\"python\" data-lang=\"python\">B</code>, so <code class=\"python\" data-lang=\"python\">d_inst</code> inherits <code class=\"python\" data-lang=\"python\">b_attr</code>. <code class=\"python\" data-lang=\"python\">B</code> also inherits from <code class=\"python\" data-lang=\"python\">A</code>, so <code class=\"python\" data-lang=\"python\">d_inst</code> inherits <code class=\"python\" data-lang=\"python\">d_attr</code>."
    },
    {
     "id": 1330092,
     "content_html": "<code class=\"python\" data-lang=\"python\">d_attr</code>",
     "correctness": "0.0",
     "feedback_html": "d_inst inherits attributes from both B and A."
    }
   ],
