  {
   "id": 665813,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which line of code correctly retrieves the value of the variable, <code class=\"python\" data-lang=\"python\">city</code>, after the following assignment?<br>\n<pre class=\"python\" data-lang=\"python\">city = \"Chicago\"</pre>",
   "answers": [
    {
     "id": 1327402,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"In which city do you live?\")</code>",
     "correctness": "0.0",
     "feedback_html": "Here, city is part of the output string and not a reference to the variable, city."
    },
    {
     "id": 1327403,
     "content_html": "<code class=\"python\" data-lang=\"python\">city = \"London\"</code>",
     "correctness": "0.0",
     "feedback_html": "This is another assignment statement that replaces the value \"Chicago\" with the value \"London\"."
    },
    {
     "id": 1327404,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"The city where you live is\", city)</code>",
     "correctness": "1.0",
     "feedback_html": "This would produce the output string, <code class=\"python\" data-lang=\"python\">\"The city where you live is Chicago\"</code>."
    }
   ],
