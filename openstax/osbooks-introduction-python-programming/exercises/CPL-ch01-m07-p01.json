   "stem_html": "The main purpose of writing comments is to <span class=\"magenta-code\">_____</span>.",
   "answers": [
    {
     "id": 918306,
     "content_html": "avoid writing syntax errors",
     "correctness": "0.0",
     "feedback_html": "Comments have no impact on the code's correctness<span class=\"magenta-code\">, but comments can make the code easier to understand</span>."
    },
    {
     "id": 918307,
     "content_html": "explain what the code does",
     "correctness": "1.0",
     "feedback_html": "Comments help explain the purpose of code so that other programmers understand what the code intends."
    },
