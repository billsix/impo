 "questions": [
  {
   "id": 666125,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which line prints the word <code class=\"python\" data-lang=\"python\">\"grandmother\"</code>?",
   "answers": [
    {
     "id": 1327884,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(grandmother)</code>",
     "correctness": "0.0",
     "feedback_html": "Quote marks are required; in this example, grandmother is an undefined variable."
    },
    {
     "id": 1327885,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"grand\" \"mother\")</code>",
     "correctness": "1.0",
     "feedback_html": "The two consecutive strings are automatically combined into one string before printing."
    },
    {
     "id": 1327886,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"grand\", \"mother\")</code>",
     "correctness": "0.0",
     "feedback_html": "The print function adds a space when given multiple values separated by commas."
    }
   ],
