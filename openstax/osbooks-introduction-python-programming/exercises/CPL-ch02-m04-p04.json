   "id": 665947,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">round(3.5, 2)</code>?",
   "answers": [
    {
     "id": 1327770,
     "content_html": "<code class=\"python\" data-lang=\"python\">3</code>",
     "correctness": "0.0",
     "feedback_html": "The second argument in the <code class=\"python\" data-lang=\"python\">round()</code> function indicates the number of decimal places to which the input is rounded. The value 3 has zero decimal place."
    },
    {
     "id": 1327771,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.5</code>",
     "correctness": "0.0",
     "feedback_html": "The second argument in the <code class=\"python\" data-lang=\"python\">round()</code> function indicates the number of decimal places to which the input is rounded. The value 3.5 has one decimal place."
    },
    {
     "id": 1327772,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.50</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">round(3.5, 2) = 3.50</code> as the input is rounded to two decimal places."
    }
   ],
