   "id": 665859,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the value of <code class=\"python\" data-lang=\"python\">a</code>?\n<pre class=\"python\" data-lang=\"python\">a = 3.5 - 1.5</pre>",
   "answers": [
    {
     "id": 1327540,
     "content_html": "<code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "0.0",
     "feedback_html": "The output of an arithmetic operation on a floating-point operand is always a floating-point number. 2 is an integer."
    },
    {
     "id": 1327541,
     "content_html": "<code class=\"python\" data-lang=\"python\">2.0</code>",
     "correctness": "1.0",
     "feedback_html": "The output of <code class=\"python\" data-lang=\"python\">3.5-1.5</code> equals <code class=\"python\" data-lang=\"python\">2.0</code>, which is a floating-point number."
    },
    {
     "id": 1327542,
     "content_html": "<code class=\"python\" data-lang=\"python\">2.5</code>",
     "correctness": "0.0",
     "feedback_html": "The result of subtracting 1.5 from 3.5 is smaller than 2.5."
    }
   ],
