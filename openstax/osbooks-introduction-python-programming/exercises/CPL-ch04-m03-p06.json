   "id": 666393,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "For what values of <code class=\"python\" data-lang=\"python\">age</code> is there no discount?\n<pre class=\"python\" data-lang=\"python\">if (age &lt; 12) or (age &gt; 65):\n&nbsp;&nbsp;# Apply student/senior discount\n</pre>",
   "answers": [
    {
     "id": 1328238,
     "content_html": "<code class=\"python\" data-lang=\"python\">age &gt;= 12</code>",
     "correctness": "0.0",
     "feedback_html": "Some ages 12 and over get a discount"
    },
    {
     "id": 1328239,
     "content_html": "<code class=\"python\" data-lang=\"python\">age &lt;= 65</code>",
     "correctness": "0.0",
     "feedback_html": "Some ages 65 and under get a discount."
    },
    {
     "id": 1328240,
     "content_html": "<code class=\"python\" data-lang=\"python\">(age &gt;= 12)</code> and <code class=\"python\" data-lang=\"python\">(age &lt;= 65)</code>",
     "correctness": "1.0",
     "feedback_html": "The discount does not apply for ages between 12 and 65 inclusive."
    }
   ],
