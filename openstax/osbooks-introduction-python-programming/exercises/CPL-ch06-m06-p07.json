   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">greeting(count=0, msg=\"Hello\")</code>?",
   "answers": [
    {
     "id": 1328858,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hello Friend</code>",
     "correctness": "0.0",
     "feedback_html": "count is 0, so the function executes but does not print anything."
    },
    {
     "id": 1328859,
     "content_html": "nothing",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">msg=\"Hello\"</code>, <code class=\"python\" data-lang=\"python\">name=\"Friend\"</code>, and <code class=\"python\" data-lang=\"python\">count=0</code>, so the call is valid. The function executes but doesn't enter the <code class=\"python\" data-lang=\"python\">for</code> loop because <code class=\"python\" data-lang=\"python\">count=0</code>."
    },
