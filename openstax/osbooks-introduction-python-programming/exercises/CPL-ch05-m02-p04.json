 "questions": [
  {
   "id": 666475,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are the arguments to the <code class=\"python\" data-lang=\"python\">range()</code> function for the increasing sequence of every 3rd integer from 10 to 22 (inclusive of both ends)?",
   "answers": [
    {
     "id": 1328478,
     "content_html": "<code class=\"python\" data-lang=\"python\">range(10, 23, 3)</code>",
     "correctness": "1.0",
     "feedback_html": "The output will be an increasing sequence between <code class=\"python\" data-lang=\"python\">10</code> and <code class=\"python\" data-lang=\"python\">22</code> (inclusive of both): <code class=\"python\" data-lang=\"python\">10</code>, <code class=\"python\" data-lang=\"python\">13</code>, <code class=\"python\" data-lang=\"python\">16</code>, <code class=\"python\" data-lang=\"python\">19</code>, and <code class=\"python\" data-lang=\"python\">22</code>."
    },
    {
     "id": 1328479,
     "content_html": "<code class=\"python\" data-lang=\"python\">range(10, 22, 3)</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">range(start, end, step)</code> is inclusive of start and exclusive of end. "
    },
    {
     "id": 1328480,
     "content_html": "<code class=\"python\" data-lang=\"python\">range(22, 10, -3)</code>",
     "correctness": "0.0",
     "feedback_html": "When the step size is negative, the generated sequence will be decreasing. The question asks for an increasing sequence between 10 and 22."
    }
   ],
