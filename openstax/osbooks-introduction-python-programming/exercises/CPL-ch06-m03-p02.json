 "questions": [
  {
   "id": 666543,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which variables have global scope?\n<pre class=\"python\" data-lang=\"python\">def print_square():\n&nbsp;&nbsp;num_sq = num * num\n&nbsp;&nbsp;print(num, \"squared is\", num_sq)\n\nnum = float(input())\nprint_square()\n</pre>",
   "answers": [
    {
     "id": 1328682,
     "content_html": "<code class=\"python\" data-lang=\"python\">num</code> only",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">num</code> is created outside of a function and is global. <code class=\"python\" data-lang=\"python\">num_sq</code> is created in <code class=\"python\" data-lang=\"python\">print_square()</code> and is not global."
    },
    {
     "id": 1328683,
     "content_html": "<code class=\"python\" data-lang=\"python\">num_sq</code> only",
     "correctness": "0.0",
     "feedback_html": "num_sq is created in a function, but num is not."
    },
    {
     "id": 1328684,
     "content_html": "<code class=\"python\" data-lang=\"python\">num</code> and <code class=\"python\" data-lang=\"python\">num_sq</code>",
     "correctness": "0.0",
     "feedback_html": "num_sq is created in print_square()."
    }
   ],
