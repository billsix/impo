 "questions": [
  {
   "id": 665819,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is a valid assignment?",
   "answers": [
    {
     "id": 1327420,
     "content_html": "<code class=\"python\" data-lang=\"python\">temperature = 98.5</code>",
     "correctness": "1.0",
     "feedback_html": "An assignment statement has the variable name on the left side and the value on the right side of the assignment statement."
    },
    {
     "id": 1327421,
     "content_html": "<code class=\"python\" data-lang=\"python\">98.5 = temperature</code>",
     "correctness": "0.0",
     "feedback_html": "To assign <code class=\"python\" data-lang=\"python\">temperature</code> with 98.5, <code class=\"python\" data-lang=\"python\">temperature</code> must be on the left side of the assignment statement, not the right side."
    },
    {
     "id": 1327422,
     "content_html": "<code class=\"python\" data-lang=\"python\">temperature - 23.2</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">temperature - 23.2</code> is an expression, not an assignment. The expression doesn't assign <code class=\"python\" data-lang=\"python\">temperature</code> with a value."
    }
   ],
