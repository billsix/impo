 "questions": [
  {
   "id": 665825,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which would be a good name for a variable storing a zip code?",
   "answers": [
    {
     "id": 1327438,
     "content_html": "<code class=\"python\" data-lang=\"python\">z</code>",
     "correctness": "0.0",
     "feedback_html": "A single letter is not descriptive. A descriptive name indicates the value being stored."
    },
    {
     "id": 1327439,
     "content_html": "<code class=\"python\" data-lang=\"python\">var_2</code>",
     "correctness": "0.0",
     "feedback_html": "Naming variables with numbers does not provide actual information about the stored value. Keeping track of variables like var_1, var_2, and var_3 can be difficult."
    },
    {
     "id": 1327440,
     "content_html": "<code class=\"python\" data-lang=\"python\">zip_code</code>",
     "correctness": "1.0",
     "feedback_html": "The name clearly indicates the value being stored is a zip code."
    }
   ],
