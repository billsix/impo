 "questions": [
  {
   "id": 666166,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If name is <code class=\"python\" data-lang=\"python\">\"Ada\"</code>, what does <code class=\"python\" data-lang=\"python\">print(\"Hello,\" name)</code> output?",
   "answers": [
    {
     "id": 1327896,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hello,Ada</code>",
     "correctness": "0.0",
     "feedback_html": "String literals are not automatically concatenated with variables.\nThis output would be correct if the code had a <code class=\"python\" data-lang=\"python\">+</code> operator:\n<pre class=\"python\" data-lang=\"python\">print(\"Hello,\" + name)</pre>\n"
    },
    {
     "id": 1327897,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hello, Ada</code>",
     "correctness": "0.0",
     "feedback_html": "String literals are not automatically concatenated with variables.\nThis output would be correct if the code had a comma: \n<pre class=\"python\" data-lang=\"python\">print(\"Hello,\", name)</pre>"
    },
    {
     "id": 1327898,
     "content_html": "<code class=\"python\" data-lang=\"python\">SyntaxError</code>",
     "correctness": "1.0",
     "feedback_html": "The literal <code class=\"python\" data-lang=\"python\">\"Hello,\"</code> and the variable <code class=\"python\" data-lang=\"python\">name</code>\ncannot be concatenated without using a <code class=\"python\" data-lang=\"python\">+</code> operator.\nAlternatively, the two values could be separated by a comma in the print function."
    }
   ],
