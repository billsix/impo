 "questions": [
  {
   "id": 667067,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Additions are to be made to <i>logfile.txt</i>. Which of the following lines of code works best?",
   "answers": [
    {
     "id": 1330166,
     "content_html": "<code class=\"python\" data-lang=\"python\">infile = open(\"logfile.txt\")</code>",
     "correctness": "0.0",
     "feedback_html": "The default mode for the open() function is read, no changes can be made to the file so the additions will not be allowed."
    },
    {
     "id": 1330167,
     "content_html": "<code class=\"python\" data-lang=\"python\">infile = open(\"logfile.txt\", 'w')</code>",
     "correctness": "0.0",
     "feedback_html": "'w' indicates write mode. The existing file will be overwritten and is not applicable when one wants to add content to an existing file."
    },
    {
     "id": 1330168,
     "content_html": "<code class=\"python\" data-lang=\"python\">infile = open(\"logfile.txt\", 'a')</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">'a'</code> indicates append mode allowing additions to the file."
    }
   ],
