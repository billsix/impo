   "stem_html": "What is 255 in hexadecimal?",
   "answers": [
    {
     "id": 875913,
     "content_html": "00",
     "correctness": "0.0",
     "feedback_html": "00 in hexadecimal is 0, the minimum amount of red, green, or blue in a color."
    },
    {
     "id": 875914,
     "content_html": "80",
     "correctness": "0.0",
     "feedback_html": "80 in hexadecimal is 128, which is in the middle of the range 0 to 255."
    },
    {
     "id": 875915,
     "content_html": "FF",
     "correctness": "1.0",
     "feedback_html": "FF in hexadecimal is 255, the maximum amount of red, green, or blue in a color."
