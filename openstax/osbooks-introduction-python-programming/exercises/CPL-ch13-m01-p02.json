 "questions": [
  {
   "id": 666995,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the relationship between a <code class=\"python\" data-lang=\"python\">Kitchen</code> class and a <code class=\"python\" data-lang=\"python\">Freezer</code> class?",
   "answers": [
    {
     "id": 1329961,
     "content_html": "is-a",
     "correctness": "0.0",
     "feedback_html": "A kitchen isn't a freezer (or vice versa). A kitchen contains a freezer."
    },
    {
     "id": 1329962,
     "content_html": "has-a",
     "correctness": "1.0",
     "feedback_html": "A kitchen has a freezer, so a <code class=\"python\" data-lang=\"python\">Kitchen</code> class would contain a <code class=\"python\" data-lang=\"python\">Freezer</code> instance. A has-a relationship is also called a composition."
    }
   ],
