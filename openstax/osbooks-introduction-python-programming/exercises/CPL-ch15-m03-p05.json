  {
   "id": 667123,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does the <code class=\"python\" data-lang=\"python\">unique()</code> function do in a DataFrame when applied to a column?",
   "answers": [
    {
     "id": 1330330,
     "content_html": "returns the number of unique columns",
     "correctness": "0.0",
     "feedback_html": "When the <code class=\"python\" data-lang=\"python\">unique()</code> function is applied to one column, it only processes values in the specific column."
    },
    {
     "id": 1330331,
     "content_html": "returns the number of unique values in the given column",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">unique()</code> function returns unique values not the number of unique values."
    },
    {
     "id": 1330332,
     "content_html": "returns the unique values in the given column",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">unique()</code> function when applied to a column returns the unique values (rows) in the given column."
    }
   ],
