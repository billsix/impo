 "questions": [
  {
   "id": 667113,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the benefit of using an<code class=\"python\" data-lang=\"python\">ndarray</code> object compared to a list?",
   "answers": [
    {
     "id": 1330299,
     "content_html": "computational efficiency",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">ndarray</code> is designed for efficient numerical operations on large arrays but <code class=\"python\" data-lang=\"python\">ndarray</code> has other benefits as well."
    },
    {
     "id": 1330300,
     "content_html": "array-oriented computing",
     "correctness": "0.0",
     "feedback_html": "NumPy implements collection of functions and methods optimized for array operations but <code class=\"python\" data-lang=\"python\">ndarray</code> has other benefits as well."
    },
    {
     "id": 1330301,
     "content_html": "memory efficiency",
     "correctness": "0.0",
     "feedback_html": "NumPy arrays occupy less memory compared to Python lists, especially when dealing with large datasets. But, <code class=\"python\" data-lang=\"python\">ndarray</code> has other benefits as well."
    },
    {
     "id": 1330302,
     "content_html": "all the above",
     "correctness": "1.0",
     "feedback_html": "NumPy array is optimized for computational and memory efficiency while also offering array-oriented computation."
    }
