   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following fields use Python to support their work?",
   "answers": [
    {
     "id": 918014,
     "content_html": "geography",
     "correctness": "0.0",
     "feedback_html": "In geography, Python helps manage, analyze, and visualize very large geographic data sets.\nBut Python is used in many other fields too.\n"
    },
    {
     "id": 918015,
     "content_html": "health care",
     "correctness": "0.0",
     "feedback_html": "In health care, Python supports drug discovery, medical imaging, and hospital management.\nBut Python is used in many other fields too.\n"
    },
    {
     "id": 918016,
     "content_html": "political science",
     "correctness": "0.0",
     "feedback_html": "In political science, Python is used to gather online data and predict election outcomes.\nBut Python is used in many other fields too.\n"
    },
    {
     "id": 918017,
     "content_html": "all of the above",
     "correctness": "1.0",
     "feedback_html": "Python is one of the most-used programming languages in the world, especially in fields outside of CS and IT."
    }
