   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which modules can be used to edit pictures and videos?",
   "answers": [
    {
     "id": 1329008,
     "content_html": "<code class=\"python\" data-lang=\"python\">BeautifulSoup</code> and <code class=\"python\" data-lang=\"python\">Scrapy</code>",
     "correctness": "0.0",
     "feedback_html": "These modules can be used to extract text data from websites, but not edit pictures and videos."
    },
    {
     "id": 1329009,
     "content_html": "<code class=\"python\" data-lang=\"python\">Bokeh</code> and <code class=\"python\" data-lang=\"python\">Matplotlib</code>",
     "correctness": "0.0",
     "feedback_html": "These modules can be used to create new plots and charts, not edit existing pictures and videos."
    },
    {
     "id": 1329010,
     "content_html": "<code class=\"python\" data-lang=\"python\">MoviePy</code> and <code class=\"python\" data-lang=\"python\">Pillow</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">MoviePy</code> is a module for video editing, and <code class=\"python\" data-lang=\"python\">Pillow</code> is a module for image processing."
    }
   ],
