 "questions": [
  {
   "id": 666377,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following code, the <code class=\"python\" data-lang=\"python\">else</code> branch is taken for which range of <code class=\"python\" data-lang=\"python\">x</code>?\n<pre class=\"python\" data-lang=\"python\">if x &gt;= 15:\n&nbsp;&nbsp;# Do something\nelse:\n&nbsp;&nbsp;# Do something else\n</pre>",
   "answers": [
    {
     "id": 1328200,
     "content_html": "<code class=\"python\" data-lang=\"python\">x &gt;= 15</code>",
     "correctness": "0.0",
     "feedback_html": "The else branch is for values of x not in the range x >= 15."
    },
    {
     "id": 1328201,
     "content_html": "<code class=\"python\" data-lang=\"python\">x &lt;= 15</code>",
     "correctness": "0.0",
     "feedback_html": "Although x &lt; 15 does not meet the if condition, when x is 15 the if branch is taken."
    },
    {
     "id": 1328202,
     "content_html": "<code class=\"python\" data-lang=\"python\">x &lt; 15</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">if</code> branch is taken when <code class=\"python\" data-lang=\"python\">x &gt;= 15</code>, so the <code class=\"python\" data-lang=\"python\">else</code> branch is taken when <code class=\"python\" data-lang=\"python\">x</code> is not greater than or equal to <code class=\"python\" data-lang=\"python\">15</code>."
    }
   ],
   "hints": [],
