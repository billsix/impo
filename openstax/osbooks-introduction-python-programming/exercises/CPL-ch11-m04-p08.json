 "questions": [
  {
   "id": 666933,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which code appropriately overloads the &lt;= operator?",
   "answers": [
    {
     "id": 1329806,
     "content_html": "<pre class=\"python\" data-lang=\"python\">&nbsp;&nbsp;def __le__(other):\n&nbsp;&nbsp;&nbsp;&nbsp;return self.amount &lt;= other.amount\n</pre>",
     "correctness": "0.0",
     "feedback_html": "&lt;= is a binary operator that has a left and right operand. The definition is missing the parameter self."
    },
    {
     "id": 1329807,
     "content_html": "<pre class=\"python\" data-lang=\"python\">&nbsp;&nbsp;def __le__(self, other):\n&nbsp;&nbsp;&nbsp;&nbsp;return self.amount &lt;= other.amount\n</pre>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">__le__()</code> is the magic method for the &lt;= operator. <code class=\"python\" data-lang=\"python\">__le__()</code> takes two parameters for the left and right operand, and returns the correct comparison of the two amount values."
    },
    {
     "id": 1329808,
     "content_html": "<pre class=\"python\" data-lang=\"python\">&nbsp;&nbsp;def __le__(self, other):\n&nbsp;&nbsp;&nbsp;&nbsp;return other.amount &lt;= self.amount\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The code reverses the order of the operands in the return statement and returns the incorrect value."
    }
   ],
