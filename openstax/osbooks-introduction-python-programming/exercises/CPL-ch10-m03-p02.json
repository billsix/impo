   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">members.get(\"jaya\")</code>?",
   "answers": [
    {
     "id": 1329558,
     "content_html": "<code class=\"python\" data-lang=\"python\">0</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"jaya\"</code> is not a key in the dictionary. What must be returned if a key is not found in the dictionary?"
    },
    {
     "id": 1329559,
     "content_html": "<code class=\"python\" data-lang=\"python\">None</code>",
     "correctness": "1.0",
     "feedback_html": "When a key does not exist in a dictionary, <code class=\"python\" data-lang=\"python\">None</code> is returned by default."
    },
    {
     "id": 1329560,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"Student\"</code>",
