 "questions": [
  {
   "id": 665887,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Where should a blank line be inserted?\n<pre class=\"python line-numbering\" data-lang=\"python\">name = input(\"Whose birthday is today? \")\nprint(\"Happy birthday to\", name)\nprint(\"Everyone cheer for\", name)</pre>",
   "answers": [
    {
     "id": 1327622,
     "content_html": "After line 1",
     "correctness": "1.0",
     "feedback_html": "A blank line separates the input from the output.<br/>\nThen again, inserting a blank line in a three-line program is generally unnecessary."
    },
    {
     "id": 1327623,
     "content_html": "After line 2",
     "correctness": "0.0",
     "feedback_html": "Lines 2 and 3 have a similar purpose (print the output).<br/>\nTherefore, lines 2 and 3 should not be separated from each other.\n"
    },
    {
     "id": 1327624,
     "content_html": "After line 3",
     "correctness": "0.0",
     "feedback_html": "Blank lines at the end of a program do not improve the code's quality.<br/>\nBlank lines should be inserted to show the structure of a program.\n"
    }
   ],
