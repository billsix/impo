 "questions": [
  {
   "id": 666767,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the final value of <code class=\"python\" data-lang=\"python\">i</code> for the following counting <code class=\"python\" data-lang=\"python\">for</code> loop?\n<br>\n<code class=\"python\" data-lang=\"python\">for i in range(0, len(my_list)):</code>",
   "answers": [
    {
     "id": 1329324,
     "content_html": "<code class=\"python\" data-lang=\"python\">9</code>",
     "correctness": "0.0",
     "feedback_html": "9 is the last element of the list. The values of i are dependent on the range function."
    },
    {
     "id": 1329325,
     "content_html": "<code class=\"python\" data-lang=\"python\">4</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">len(my_list)</code> is 5. A counting <code class=\"python\" data-lang=\"python\">for</code> loop ends at 1 less than the second value in the range function, so the final value of <code class=\"python\" data-lang=\"python\">i</code> is <code class=\"python\" data-lang=\"python\">4</code>."
    },
    {
     "id": 1329326,
     "content_html": "<code class=\"python\" data-lang=\"python\">5</code>",
     "correctness": "0.0",
     "feedback_html": "The length of the list is 5. So what would the final value of i be?"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<code class=\"python\" data-lang=\"python\">len(my_list)</code> is 5. A counting <code class=\"python\" data-lang=\"python\">for</code> loop ends at 1 less than the second value in the range function, so the final value of <code class=\"python\" data-lang=\"python\">i</code> is <code class=\"python\" data-lang=\"python\">4</code>."
    }
   ],
