   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the value of <code class=\"python\" data-lang=\"python\">math.tau/2</code>?",
   "answers": [
    {
     "id": 1327836,
     "content_html": "approximately <code class=\"python\" data-lang=\"python\">2.718</code>",
     "correctness": "0.0",
     "feedback_html": "This value is close to math.e, which is unrelated to math.tau."
    },
    {
     "id": 1327837,
     "content_html": "approximately <code class=\"python\" data-lang=\"python\">3.142</code>",
     "correctness": "1.0",
     "feedback_html": "Tau is equal to 2&#x03C0;, so tau divided by 2 is &#x03C0;."
    },
    {
     "id": 1327838,
     "content_html": "approximately <code class=\"python\" data-lang=\"python\">6.283</code>",
     "correctness": "0.0",
     "feedback_html": "6.283 is math.tau, not math.tau divided by 2."
    }
   ],
