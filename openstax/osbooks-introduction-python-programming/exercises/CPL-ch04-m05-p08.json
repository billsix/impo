 "questions": [
  {
   "id": 666435,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x = -1</code> and <code class=\"python\" data-lang=\"python\">y = -2</code>, what is the final value of <code class=\"python\" data-lang=\"python\">y</code>?\n<pre class=\"python\" data-lang=\"python\">if x &lt; 0 and y &lt; 0:\n&nbsp;&nbsp;y = 10\nelif x &lt; 0 and y &gt; 0:\n&nbsp;&nbsp;y = 20\nelse:\n&nbsp;&nbsp;y = 30\n</pre>",
   "answers": [
    {
     "id": 1328360,
     "content_html": "<code class=\"python\" data-lang=\"python\">10</code>",
     "correctness": "1.0",
     "feedback_html": "Only one branch is executed in a chained decision statement. <code class=\"python\" data-lang=\"python\">-1 &lt; 0 and -2 &lt; 0</code> is <code class=\"python\" data-lang=\"python\">True</code>, so <code class=\"python\" data-lang=\"python\">y = 10</code>."
    },
    {
     "id": 1328361,
     "content_html": "<code class=\"python\" data-lang=\"python\">20</code>",
     "correctness": "0.0",
     "feedback_html": "-1 &lt; 0 and -2 &lt; 0 is True, so the first branch executes. The elif and else branches do not. "
    },
    {
     "id": 1328362,
     "content_html": "<code class=\"python\" data-lang=\"python\">30</code>",
     "correctness": "0.0",
     "feedback_html": "-1 &lt; 0 and -2 &lt; 0 is True, so the first branch executes. The elif and else branches do not."
    }
   ],
