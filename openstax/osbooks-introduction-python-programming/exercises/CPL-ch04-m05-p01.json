 "questions": [
  {
   "id": 666421,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Fill in the blank to execute <code class=\"python\" data-lang=\"python\">Body 2</code> when <code class=\"python\" data-lang=\"python\">condition_1</code> is false and <code class=\"python\" data-lang=\"python\">condition_2</code> is true.\n<pre class=\"python\" data-lang=\"python\">if condition_1:\n&nbsp;&nbsp;# Body 1\n__ condition_2:\n&nbsp;&nbsp;# Body 2\n</pre>",
   "answers": [
    {
     "id": 1328314,
     "content_html": "<code class=\"python\" data-lang=\"python\">if</code>",
     "correctness": "0.0",
     "feedback_html": "Using if here allows Body 2 to execute regardless of condition_1 being True or False."
    },
    {
     "id": 1328315,
     "content_html": "<code class=\"python\" data-lang=\"python\">elif</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">elif</code> will evaluate <code class=\"python\" data-lang=\"python\">condition_2</code> if <code class=\"python\" data-lang=\"python\">condition_1</code> is <code class=\"python\" data-lang=\"python\">False</code> and execute <code class=\"python\" data-lang=\"python\">Body 2</code> if <code class=\"python\" data-lang=\"python\">condition_2</code> is <code class=\"python\" data-lang=\"python\">True</code>."
    },
    {
     "id": 1328316,
     "content_html": "<code class=\"python\" data-lang=\"python\">else</code>",
     "correctness": "0.0",
     "feedback_html": "Using else here will produce an error. An else can't have a condition."
    }
   ],
