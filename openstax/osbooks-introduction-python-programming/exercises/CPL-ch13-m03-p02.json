 "questions": [
  {
   "id": 667021,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the error in the program that attempts to override <code class=\"python\" data-lang=\"python\">calc_tax()</code> for <code class=\"python\" data-lang=\"python\">ContractTaxDE</code>?\n<pre class=\"python\" data-lang=\"python\">class Tax:\n&nbsp;&nbsp;def calc_tax(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print('Calculating tax')\n\nclass ContractTax(Tax):\n&nbsp;&nbsp;def calc_tax(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print('Calculating contract tax')\n\nclass ContractTaxDE(ContractTax):\n&nbsp;&nbsp;def calc_tax():\n&nbsp;&nbsp;&nbsp;&nbsp;print('Calculating German contract tax')\n\nmy_tax = ContractTaxDE()\nmy_tax.calc_tax()\n</pre>",
   "answers": [
    {
     "id": 1330036,
     "content_html": "<code class=\"python\" data-lang=\"python\">ContractTaxDE</code> must inherit from <code class=\"python\" data-lang=\"python\">Tax</code>, not <code class=\"python\" data-lang=\"python\">ContractTax</code>.",
     "correctness": "0.0",
     "feedback_html": "ContractTaxDE can inherit from ContractTax and still override calc_tax(). calc_tax() is inherited from superclass ContractTax."
    },
    {
     "id": 1330037,
     "content_html": "<code class=\"python\" data-lang=\"python\">ContractTaxDE's</code> definition of <code class=\"python\" data-lang=\"python\">calc_tax()</code> is missing a parameter.",
     "correctness": "1.0",
     "feedback_html": "The self parameter is missing from the overridden method's definition."
    },
    {
     "id": 1330038,
     "content_html": "<code class=\"python\" data-lang=\"python\">ContractTaxDE</code> can't override <code class=\"python\" data-lang=\"python\">calc_tax()</code> since <code class=\"python\" data-lang=\"python\">ContractTax</code> already has.",
     "correctness": "0.0",
     "feedback_html": "A method can be overridden across multiple levels of inheritance."
    }
   ],
