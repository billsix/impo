 "questions": [
  {
   "id": 667111,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a NumPy data type?",
   "answers": [
    {
     "id": 1330292,
     "content_html": "<code class=\"python\" data-lang=\"python\">ndarray</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">ndarray</code> is a data type supported by NumPy. When printing the type of an <code class=\"python\" data-lang=\"python\">ndarray</code> object, <code class=\"python\" data-lang=\"python\">&lt;'numpy.ndarray'&gt;</code> is printed."
    },
    {
     "id": 1330293,
     "content_html": "<code class=\"python\" data-lang=\"python\">list</code>",
     "correctness": "0.0",
     "feedback_html": "List is a primitive Python data type."
    },
    {
     "id": 1330294,
     "content_html": "<code class=\"python\" data-lang=\"python\">array</code>",
     "correctness": "0.0",
     "feedback_html": "Array is not a data type. The data type that implements an array-like object in Python is <code class=\"python\" data-lang=\"python\">ndarray</code>."
    }
   ],
