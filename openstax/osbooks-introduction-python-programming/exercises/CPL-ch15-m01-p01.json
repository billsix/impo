   "stimulus_html": "",
   "stem_html": "What is the first stage of any data science life cycle?",
   "answers": [
    {
     "id": 919972,
     "content_html": "data visualization",
     "correctness": "0.0",
     "feedback_html": "Data visualization is part of the data exploration stage which is the second stage of the life-cycle. Data visualization can also be used in the final stage of the project for reporting insights."
    },
    {
     "id": 919973,
     "content_html": "data cleanup",
     "correctness": "0.0",
     "feedback_html": "Data cleanup is part of the data exploration stage which is the second stage of the life-cycle."
    },
    {
     "id": 919974,
     "content_html": "data acquisition",
     "correctness": "1.0",
     "feedback_html": "Data acquisition is the first stage of the data science life cycle. Data can be collected by the data scientist or gathered previously and provided to the data scientist."
    }
