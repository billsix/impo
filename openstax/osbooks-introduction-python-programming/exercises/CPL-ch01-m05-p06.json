   "id": 665861,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(x / z)</code>?",
   "answers": [
    {
     "id": 1327546,
     "content_html": "<code class=\"python\" data-lang=\"python\">3</code>",
     "correctness": "0.0",
     "feedback_html": "The output of the division operator is always a floating-point number. 3 is an integer."
    },
    {
     "id": 1327547,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.0</code>",
     "correctness": "0.0",
     "feedback_html": "The output of dividing 7 by 2 is larger than 3.0."
    },
    {
     "id": 1327548,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.5</code>",
     "correctness": "1.0",
     "feedback_html": "The result of the division operation is a floating-point number that isn't rounded down. <code class=\"python\" data-lang=\"python\">7/2 = 3.5</code>."
    }
   ],
