   "id": 667025,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<code class=\"python\" data-lang=\"python\">Square'</code>s <code class=\"python\" data-lang=\"python\">__init__()</code> returns and control flow moves to line 17. What is the output?",
   "answers": [
    {
     "id": 1330048,
     "content_html": "<code class=\"python\" data-lang=\"python\">3</code>",
     "correctness": "0.0",
     "feedback_html": "3 is the default value of num_sides, but a value was passed to Polygon's __init__() on line 7."
    },
    {
     "id": 1330049,
     "content_html": "<code class=\"python\" data-lang=\"python\">4</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">Rectangle'</code>s <code class=\"python\" data-lang=\"python\">__init__()</code> always calls <code class=\"python\" data-lang=\"python\">Polygon'</code>s <code class=\"python\" data-lang=\"python\">__init__()</code> with <code class=\"python\" data-lang=\"python\">num_sides=4</code>."
    },
    {
     "id": 1330050,
     "content_html": "<code class=\"python\" data-lang=\"python\">5</code>",
     "correctness": "0.0",
     "feedback_html": "Square's side attribute has the value 5. num_sides is a different attribute inherited from Polygon."
    }
