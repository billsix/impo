 "questions": [
  {
   "id": 665843,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following assigns <code class=\"python\" data-lang=\"python\">\"one-sided\"</code> to the variable <code class=\"python\" data-lang=\"python\">holiday</code>?",
   "answers": [
    {
     "id": 1327492,
     "content_html": "<code class=\"python\" data-lang=\"python\">holiday = \"one\" + \"sided\"</code>",
     "correctness": "0.0",
     "feedback_html": "Since the concatenation operator does not include a default character separator, this would produce the string \"onesided\" with no dash (-)."
    },
    {
     "id": 1327493,
     "content_html": "<code class=\"python\" data-lang=\"python\">holiday = one-sided</code>",
     "correctness": "0.0",
     "feedback_html": "Matching quotes must enclose the string to assign it to a variable."
    },
    {
     "id": 1327494,
     "content_html": "<code class=\"python\" data-lang=\"python\">holiday = \"one-\" + \"sided\"</code>",
     "correctness": "1.0",
     "feedback_html": "A concatenation of the two strings is assigned to the variable <code class=\"python\" data-lang=\"python\">holiday</code>. Note that <code class=\"python\" data-lang=\"python\">\"one-sided\"</code> would assign the same string to <code class=\"python\" data-lang=\"python\">holiday</code>."
    }
   ],
