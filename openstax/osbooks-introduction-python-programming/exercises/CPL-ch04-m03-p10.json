  {
   "id": 666401,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">is_turn = False</code> and <code class=\"python\" data-lang=\"python\">timer = 65</code>, what is the final value of <code class=\"python\" data-lang=\"python\">is_turn</code>?\n<pre class=\"python\" data-lang=\"python\">if timer &gt; 60:\n&nbsp;&nbsp;is_turn = not is_turn\n</pre>",
   "answers": [
    {
     "id": 1328255,
     "content_html": "<code class=\"python\" data-lang=\"python\">True</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">65 &gt; 60</code> is <code class=\"python\" data-lang=\"python\">True</code>, so <code class=\"python\" data-lang=\"python\">is_turn</code> is assigned with <code class=\"python\" data-lang=\"python\">not(False)</code>, which is <code class=\"python\" data-lang=\"python\">True</code>."
    },
    {
     "id": 1328256,
     "content_html": "<code class=\"python\" data-lang=\"python\">False</code>",
     "correctness": "0.0",
     "feedback_html": "65 > 60 is True, so is_turn is assigned with not(False), which is True."
    }
   ],
