 "questions": [
  {
   "id": 666863,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the content of the <code class=\"python\" data-lang=\"python\">food</code> dictionary after calling <code class=\"python\" data-lang=\"python\">food.update({\"Kabob\": \"$22\", \"Sushi\": \"$16\"})</code>?",
   "answers": [
    {
     "id": 1329600,
     "content_html": "<code class=\"python\" data-lang=\"python\">{\"Coconut soup\": \"$15\", \"Butter Chicken\": \"$18\", \"Kabob\": \"$22\", \"Sushi\": \"$16\"}</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">update()</code> function modifies the value associated with the key <code class=\"python\" data-lang=\"python\">\"Kabob\"</code> and adds a new item, <code class=\"python\" data-lang=\"python\">\"Sushi\": \"$16\"</code>."
    },
    {
     "id": 1329601,
     "content_html": "<code class=\"python\" data-lang=\"python\">{\"Coconut soup\": \"$15\", \"Butter Chicken\": \"$18\", \"Kabob\": \"$20\", \"Sushi\": \"$16\"}</code>",
     "correctness": "0.0",
     "feedback_html": "The value of the key <code class=\"python\" data-lang=\"python\">\"Kabob\"</code> must be updated to <code class=\"python\" data-lang=\"python\">\"$22\"</code>."
    },
    {
     "id": 1329602,
     "content_html": "<code class=\"python\" data-lang=\"python\">{ \"Sushi\": \"$16\", \"Coconut soup\": \"$15\", \"Butter Chicken\": \"$18\", \"Kabob\": \"$20\"}</code>",
     "correctness": "0.0",
     "feedback_html": "In Python 3.7, the order of items in the dictionary is based on the order added to the dictionary. Hence, <code class=\"python\" data-lang=\"python\">\"Sushi\"</code> must be the last key in the dictionary."
    }
   ],
