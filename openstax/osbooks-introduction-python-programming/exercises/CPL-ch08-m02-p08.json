 "questions": [
  {
   "id": 666691,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What type of error will result from the following code?\n<pre class=\"python\" data-lang=\"python\">string_variable = \"example\"\nstring_variable[-1] = \"\"\n</pre>",
   "answers": [
    {
     "id": 1329098,
     "content_html": "<code class=\"python\" data-lang=\"python\">TypeError</code>",
     "correctness": "1.0",
     "feedback_html": "Attempting to assign a value to an index or range of indexes in a string results in <code class=\"python\" data-lang=\"python\">TypeError: 'str' object does not support item assignment</code>."
    },
    {
     "id": 1329099,
     "content_html": "<code class=\"python\" data-lang=\"python\">IndexError</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">IndexError</code> is raised when an index is out of the possible range. -1 is the index of the last character in the string."
    },
    {
     "id": 1329100,
     "content_html": "<code class=\"python\" data-lang=\"python\">NameError</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">NameError</code> is raised when a variable is not defined before using. The example has one variable which is also defined in the first line."
    }
   ],
