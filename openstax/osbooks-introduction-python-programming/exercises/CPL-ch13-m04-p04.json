 "questions": [
  {
   "id": 667037,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which attributes does <code class=\"python\" data-lang=\"python\">c_inst</code> have access to?",
   "answers": [
    {
     "id": 1330084,
     "content_html": "<code class=\"python\" data-lang=\"python\">a_attr</code>",
     "correctness": "0.0",
     "feedback_html": "C has an instance attribute specific to the class."
    },
    {
     "id": 1330085,
     "content_html": "<code class=\"python\" data-lang=\"python\">a_attr</code>, <code class=\"python\" data-lang=\"python\">c_attr</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">c_inst</code> has access to <code class=\"python\" data-lang=\"python\">C'</code>s instance attribute, <code class=\"python\" data-lang=\"python\">c_attr</code>, as well the inherited attribute from <code class=\"python\" data-lang=\"python\">A</code>, <code class=\"python\" data-lang=\"python\">a_attr</code>."
    },
    {
     "id": 1330086,
     "content_html": "<code class=\"python\" data-lang=\"python\">c_attr</code>",
     "correctness": "0.0",
     "feedback_html": "C inherits from A, so c_inst inherits A's attributes."
    }
   ],
