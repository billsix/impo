 "questions": [
  {
   "id": 666893,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose the programmer wanted to change the class to represent a pet cat. Which is the appropriate name that follows PEP 8 recommendations?",
   "answers": [
    {
     "id": 1329688,
     "content_html": "<code class=\"python\" data-lang=\"python\">petcat</code>",
     "correctness": "0.0",
     "feedback_html": "CapWords style, with all words capitalized and nothing in between, is recommended for class names. pet and cat are separate words and should be capitalized."
    },
    {
     "id": 1329689,
     "content_html": "<code class=\"python\" data-lang=\"python\">pet_cat</code>",
     "correctness": "0.0",
     "feedback_html": "CapWords style, with all words capitalized and nothing in between, is recommended for class names. pet and cat are separate words and shoudn't have a character in between."
    },
    {
     "id": 1329690,
     "content_html": "<code class=\"python\" data-lang=\"python\">PetCat</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">CapWords</code> style, with all words capitalized and no spaces between words, is recommended for class names. \"Pet\" and \"cat\"  are separate words, so each is capitalized and one directly follows the other."
    }
   ],
