 "questions": [
  {
   "id": 666805,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would be the correct way to represent <code class=\"python\" data-lang=\"python\">matA</code> in Python?",
   "answers": [
    {
     "id": 1329430,
     "content_html": "<pre class=\"python\" data-lang=\"python\">[[7, 4, 5], [3, 9, 6], [1, 2, 8]]</pre>",
     "correctness": "1.0",
     "feedback_html": "Each row of the matrix is represented as a list in the larger list-of-lists, <code class=\"python\" data-lang=\"python\">matA</code>. <code class=\"python\" data-lang=\"python\">matA</code> represents the complete matrix."
    },
    {
     "id": 1329431,
     "content_html": "<pre class=\"python\" data-lang=\"python\">[7, 4, 5\n3, 9, 6\n1, 2, 8]</pre>",
     "correctness": "0.0",
     "feedback_html": "A syntax error would result as this is not correct syntax for assigning values to a list."
    },
    {
     "id": 1329432,
     "content_html": "<pre class=\"python\" data-lang=\"python\">[[7, 3, 1], [4, 9, 2], [1, 2, 8]</pre>",
     "correctness": "0.0",
     "feedback_html": "Each column is represented as a list here, which can work, but indexing by row followed by column is more conventional."
    }
   ],
