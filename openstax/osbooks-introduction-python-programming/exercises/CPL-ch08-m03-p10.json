  {
   "id": 666713,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">\"banana\".find(\"a\")</code>?",
   "answers": [
    {
     "id": 1329164,
     "content_html": "<code class=\"python\" data-lang=\"python\">1</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">find()</code> method returns the index for the first occurrence of the substring in the given string. The index for the first occurrence of <code class=\"python\" data-lang=\"python\">\"a\"</code> is 1."
    },
    {
     "id": 1329165,
     "content_html": "<code class=\"python\" data-lang=\"python\">3</code>",
     "correctness": "0.0",
     "feedback_html": "3 is the index of the second occurrence of character \"a\" in the string \"banana\". What is the index of the first occurrence of \"a\"?"
    },
    {
     "id": 1329166,
     "content_html": "<code class=\"python\" data-lang=\"python\">5</code>",
     "correctness": "0.0",
     "feedback_html": "5 is the index of the last occurrence of \"a\" in the string \"banana\". The <code class=\"python\" data-lang=\"python\">find()</code> function returns the index of the substring's first occurrence in the given string."
    }
   ],
