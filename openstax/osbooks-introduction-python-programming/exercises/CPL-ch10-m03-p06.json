   "id": 666857,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(list(numbers.keys()))</code>?",
   "answers": [
    {
     "id": 1329582,
     "content_html": "<code class=\"python\" data-lang=\"python\">[\"three\", \"two\", \"one\"]</code>",
     "correctness": "0.0",
     "feedback_html": "In Python 3.7, the order of keys will be preserved. What is the order of keys in the dictionary?"
    },
    {
     "id": 1329583,
     "content_html": "<code class=\"python\" data-lang=\"python\">[\"one\", \"two\", \"three\"]</code>",
     "correctness": "1.0",
     "feedback_html": "Keys in the dictionary are <code class=\"python\" data-lang=\"python\">\"one\", \"two\", \"three\"</code>. Using the <code class=\"python\" data-lang=\"python\">list()</code> constructor, a list object containing all keys is returned."
    },
    {
     "id": 1329584,
     "content_html": "<code class=\"python\" data-lang=\"python\">dict_keys([\"one\", \"two\", \"three\"])</code>",
     "correctness": "0.0",
     "feedback_html": "The list constructor converts a <code class=\"python\" data-lang=\"python\">dict_keys</code> object to a list and the printed output is a list."
    }
