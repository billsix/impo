   "stimulus_html": "",
   "stem_html": "The next line executes. Which line does control flow move to next?",
   "answers": [
    {
     "id": 925894,
     "content_html": "2",
     "correctness": "1.0",
     "feedback_html": "<code>super()</code>.<code>__init__(4)</code> calls the <code>__init__()</code> of <code>Rectangle'</code>s superclass, <code>Polygon</code>. Control moves to line 3, and <code>num_sides</code> is initialized with <code>4</code>."
    },
    {
