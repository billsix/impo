   "id": 666873,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">fruit_count = {\"apple\": 2, \"orange\": 5, \"banana\": 1}\nfor key in fruit_count.keys():\n&nbsp;&nbsp;print(key, end = \" \")</pre>\n",
   "answers": [
    {
     "id": 1329628,
     "content_html": "<code class=\"python\" data-lang=\"python\">apple orange banana </code>",
     "correctness": "1.0",
     "feedback_html": "The loop iterates over the keys <code class=\"python\" data-lang=\"python\">\"apple\"</code>, <code class=\"python\" data-lang=\"python\">\"orange\"</code>, and <code class=\"python\" data-lang=\"python\">\"banana\"</code>, and prints the keys space-separated."
    },
    {
     "id": 1329629,
     "content_html": "<code class=\"python\" data-lang=\"python\">2 5 1</code>",
     "correctness": "0.0",
     "feedback_html": "The loop iterates over only the keys, and not values. What is the output of the code if keys are being printed?"
    },
    {
     "id": 1329630,
     "content_html": "<code class=\"python\" data-lang=\"python\">(\"apple\", 2) (\"orange\", 5) (\"banana\", 1)</code>",
     "correctness": "0.0",
     "feedback_html": "The loop iterates over only the keys and prints keys in one line. What is the output of the code if keys are being printed?"
    }
