   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does <code class=\"python\" data-lang=\"python\">order_1</code> represent at the end of the program?",
   "answers": [
    {
     "id": 1329760,
     "content_html": "8 oz coffee",
     "correctness": "0.0",
     "feedback_html": "order_1 is originally a coffee without milk or sugar, but the call to change() changes one of the boolean instance attributes."
    },
    {
     "id": 1329761,
     "content_html": "8 oz coffee with milk",
     "correctness": "0.0",
     "feedback_html": "order_1 is originally a plain coffee without milk or sugar, but the call to change() assigns the sugar parameter with True."
    },
    {
     "id": 1329762,
     "content_html": "8 oz coffee with sugar",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">order_1</code> is originally a coffee without milk or sugar, but the call to <code class=\"python\" data-lang=\"python\">change()</code> adds sugar to the order by assigning <code class=\"python\" data-lang=\"python\">order_1.with_sugar</code> with <code class=\"python\" data-lang=\"python\">True</code>."
    }
