 "questions": [
  {
   "id": 666725,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(\"Hello {}!\".format(\"Ana\"))</code>?",
   "answers": [
    {
     "id": 1329200,
     "content_html": "<code class=\"python\" data-lang=\"python\">Ana</code>",
     "correctness": "0.0",
     "feedback_html": "The argument passed to the format function will replace the replacement field in the template. What is the output if \"Ana\" is substituted for the replacement field?"
    },
    {
     "id": 1329201,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hello Ana</code>",
     "correctness": "0.0",
     "feedback_html": "The string template will only change at the replacement field locations and replacement fields will be substituted with the given arguments. "
    },
    {
     "id": 1329202,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hello Ana!</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"Ana\"</code> is substituted for the replacement field {} in the template and hence the output is <code class=\"python\" data-lang=\"python\">\"Hello Ana!\"</code>."
    }
   ],
