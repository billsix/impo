 "questions": [
  {
   "id": 667029,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is an example of polymorphism for the multiplication operator?",
   "answers": [
    {
     "id": 1330060,
     "content_html": "<pre class=\"python\" data-lang=\"python\">x = 3 * 4\ny = 3 * \"la\"\n</pre>",
     "correctness": "1.0",
     "feedback_html": "The * operator can be used with integer operands as well as strings and other types."
    },
    {
     "id": 1330061,
     "content_html": "<pre class=\"python\" data-lang=\"python\">x = 3 * 4\ny = str(x)\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The * operator can be used with different operand types."
    },
    {
     "id": 1330062,
     "content_html": "<pre class=\"python\" data-lang=\"python\">x = 3 * 4\ny = x * x\n</pre>",
     "correctness": "0.0",
     "feedback_html": "In both statements, the * operator is used with integer operands, but other operand types can be used."
    }
   ],
