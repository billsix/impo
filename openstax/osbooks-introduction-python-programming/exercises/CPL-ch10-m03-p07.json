 "questions": [
  {
   "id": 666859,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which option modifies the value for the key <code class=\"python\" data-lang=\"python\">\"Coconut soup\"</code> to <code class=\"python\" data-lang=\"python\">\"$11\"</code> while keeping other items the same?",
   "answers": [
    {
     "id": 1329588,
     "content_html": "<code class=\"python\" data-lang=\"python\">food = {\"\"Coconut soup\": \"$15\"\"}</code>",
     "correctness": "0.0",
     "feedback_html": "Reassigning the value of the <code class=\"python\" data-lang=\"python\">food</code> dictionary to <code class=\"python\" data-lang=\"python\">{\"\"Coconut soup\": \"$15\"\"}</code> erases the content of the dictionary and replaces the content with only one item."
    },
    {
     "id": 1329589,
     "content_html": "<code class=\"python\" data-lang=\"python\">food[\"Coconut soup\"] = 11</code>",
     "correctness": "0.0",
     "feedback_html": "The new value for the key <code class=\"python\" data-lang=\"python\">\"coconut soup\"</code>is <code class=\"python\" data-lang=\"python\">\"$11\"</code>, not <code class=\"python\" data-lang=\"python\">11</code>."
    },
    {
     "id": 1329590,
     "content_html": "<code class=\"python\" data-lang=\"python\">food[\"Coconut soup\"] = \"$11\"</code>",
     "correctness": "1.0",
     "feedback_html": "When accessing a dictionary key and assigning a new value, the associated value for the key will be updated."
    }
   ],
