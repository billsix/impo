   "id": 665867,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the value of <code class=\"python\" data-lang=\"python\">4 * 3 ** 2 + 1</code>?",
   "answers": [
    {
     "id": 1327564,
     "content_html": "<code class=\"python\" data-lang=\"python\">37</code>",
     "correctness": "1.0",
     "feedback_html": "3 raised to the power 2 is 9, times 4 is 36, plus 1 is 37."
    },
    {
     "id": 1327565,
     "content_html": "<code class=\"python\" data-lang=\"python\">40</code>",
     "correctness": "0.0",
     "feedback_html": "3 raised to the power 2 is 9, plus 1 is 10, times 4 is 40. But multiplying should happen before adding."
    },
    {
     "id": 1327566,
     "content_html": "<code class=\"python\" data-lang=\"python\">145</code>",
     "correctness": "0.0",
     "feedback_html": "4 times 3 is 12, raised to the power 2 is 144, plus 1 is 145. But exponentiation should happen before multiplying."
    }
