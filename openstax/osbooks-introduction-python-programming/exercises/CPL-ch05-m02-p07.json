 "questions": [
  {
   "id": 666481,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the <code class=\"python\" data-lang=\"python\">range(1, 2, -1)</code>?",
   "answers": [
    {
     "id": 1328496,
     "content_html": "<code class=\"python\" data-lang=\"python\">1</code>",
     "correctness": "0.0",
     "feedback_html": "Since step size is -1, the output range must be in descending order. Hence, the range starts at 1 and with a step size of -1, the next number is 0, but the end is 2. To generate a descending sequence start has to be greater than end."
    },
    {
     "id": 1328497,
     "content_html": "<code class=\"python\" data-lang=\"python\">1, 2</code>",
     "correctness": "0.0",
     "feedback_html": "Since step size is -1, the output range must be in descending order. 1, 2 is in ascending order."
    },
    {
     "id": 1328498,
     "content_html": "empty sequence",
     "correctness": "1.0",
     "feedback_html": "When the step size is negative, the generated sequence will be in descending order. Hence, <code class=\"python\" data-lang=\"python\">start</code> must be larger than <code class=\"python\" data-lang=\"python\">end</code>; otherwise, no sequence will be generated."
    }
   ],
