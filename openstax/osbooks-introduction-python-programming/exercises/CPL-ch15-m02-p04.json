   "id": 667115,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">import numpy as np\n\narr = np.array([[1, 2], [3, 4]])\nout = 2 * arr\nprint(out)\n</pre>",
   "answers": [
    {
     "id": 1330306,
     "content_html": "<pre class=\"python\" data-lang=\"python\">[[2 4]\n[8 16]]</pre>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">2 * arr</code> multiplies all elements of the array by 2. What is the output?"
    },
    {
     "id": 1330307,
     "content_html": "<pre class=\"python\" data-lang=\"python\">[[2 4]\n[6 8]]</pre>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">2 * arr</code> multiplies all elements by 2 resulting in:\n<pre class=\"python\" data-lang=\"python\">[[2 4]\n[6 8]]</pre>"
    },
    {
     "id": 1330308,
     "content_html": "<pre class=\"python\" data-lang=\"python\">[[1 2]\n[3 4]]</pre>",
     "correctness": "0.0",
     "feedback_html": "The expression <code class=\"python\" data-lang=\"python\">2 * arr</code> is applied to the <code class=\"python\" data-lang=\"python\">arr</code> variable. What is the value stored in the variable out?"
    }
   ],
