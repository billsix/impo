   "stimulus_html": "",
   "stem_html": "What is the name of the class?",
   "answers": [
    {
     "id": 1329670,
     "content_html": "<code class=\"python\" data-lang=\"python\">Cat</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">Cat</code> follows the class keyword at the top of the class definition and is the name of the class."
    },
    {
     "id": 1329671,
     "content_html": "<code class=\"python\" data-lang=\"python\">class Cat</code>",
     "correctness": "0.0",
     "feedback_html": "The class keyword begins a class definition but is not part of the name. The class name follows the keyword."
    },
    {
     "id": 1329672,
     "content_html": "<code class=\"python\" data-lang=\"python\">self</code>",
     "correctness": "0.0",
     "feedback_html": "self is used to refer to the instance of the class. The class name follows the class keyword."
    }
