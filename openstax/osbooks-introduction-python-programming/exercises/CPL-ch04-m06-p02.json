 "questions": [
  {
   "id": 666441,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">num_dancers = 49</code>, what is printed?\n<pre class=\"python\" data-lang=\"python\">if num_dancers &lt; 0:\n&nbsp;&nbsp;print(\"Error: num_dancers is negative\")\nelse:\n&nbsp;&nbsp;if num_dancers % 2 == 1:\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"Error: num_dancers is odd\")\n&nbsp;&nbsp;print(num_dancers, \"dancers\")\n</pre>",
   "answers": [
    {
     "id": 1328378,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error: num_dancers is odd</code>",
     "correctness": "0.0",
     "feedback_html": "The error is printed, and then the program continues after the nested if statement."
    },
    {
     "id": 1328379,
     "content_html": "<code class=\"python\" data-lang=\"python\">49 dancers</code>",
     "correctness": "0.0",
     "feedback_html": "49 % 2 == 1 is True, so the nested if statement executes before the number of dancers is printed."
    },
    {
     "id": 1328380,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error: num_dancers is odd</code><br><code class=\"python\" data-lang=\"python\">49 dancers</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">num_dancers</code> is positive, so the <code class=\"python\" data-lang=\"python\">else</code> branch is taken. <code class=\"python\" data-lang=\"python\">num_dancers</code> is odd, so the error is printed before the program continues after the nested <code class=\"python\" data-lang=\"python\">if</code> and prints <code class=\"python\" data-lang=\"python\">num_dancers</code>."
    }
   ],
