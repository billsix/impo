 "questions": [
  {
   "id": 667023,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The following program doesn't override <code class=\"python\" data-lang=\"python\">calc_tax()</code>. Why?\n<pre class=\"python\" data-lang=\"python\">class Tax:\n&nbsp;&nbsp;def calc_tax(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print('Calculating tax')\n&nbsp;&nbsp;&nbsp;&nbsp;total = 0 # To replace with calculation\n&nbsp;&nbsp;&nbsp;&nbsp;return total\n\nclass ContractTax:\n&nbsp;&nbsp;def calc_tax(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print('Calculating contract tax')\n&nbsp;&nbsp;&nbsp;&nbsp;total = 0 # To replace with calculation\n&nbsp;&nbsp;&nbsp;&nbsp;return total\n\nmy_tax = ContractTax()\nmy_tax.calc_tax()\n</pre>",
   "answers": [
    {
     "id": 1330042,
     "content_html": "An overridden method cannot return a value.",
     "correctness": "0.0",
     "feedback_html": "Overridden methods can return values and have multiple parameters."
    },
    {
     "id": 1330043,
     "content_html": "<code class=\"python\" data-lang=\"python\">Tax</code> doesn't specify <code class=\"python\" data-lang=\"python\">calc_tax()</code> can be overridden.",
     "correctness": "0.0",
     "feedback_html": "A superclass doesn't need to specify that a method can be overridden. A subclass can override any inherited method."
    },
    {
     "id": 1330044,
     "content_html": "<code class=\"python\" data-lang=\"python\">ContractTax</code> isn't inherited from <code class=\"python\" data-lang=\"python\">Tax</code>.",
     "correctness": "1.0",
     "feedback_html": "The class definition doesn't indicate inheritance. The definition should be <code>class ContractTax(Tax):</code>."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The class definition doesn't indicate inheritance. The definition should be <code>class ContractTax(Tax):</code>."
    }
   ],
