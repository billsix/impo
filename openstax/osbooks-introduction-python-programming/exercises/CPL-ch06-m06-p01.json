 "questions": [
  {
   "id": 666595,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the positional argument in <code class=\"python\" data-lang=\"python\">greeting(count=1, name=\"Ash\", msg=\"Hiya\")</code>?\n",
   "answers": [
    {
     "id": 1328823,
     "content_html": "<code class=\"python\" data-lang=\"python\">count=1</code>",
     "correctness": "0.0",
     "feedback_html": "count=1 is a keyword argument that assigns 1 to the parameter, count."
    },
    {
     "id": 1328824,
     "content_html": "<code class=\"python\" data-lang=\"python\">name=\"Ash\"</code>",
     "correctness": "0.0",
     "feedback_html": "name=\"Ash\" is a keyword argument that assigns \"Ash\" to the parameter, name."
    },
    {
     "id": 1328825,
     "content_html": "<code class=\"python\" data-lang=\"python\">msg=\"Hiya\"</code>",
     "correctness": "0.0",
     "feedback_html": "msg=\"Hiya\" is a keyword argument that assigns \"Hiya\" to the parameter, msg."
    },
    {
     "id": 1328826,
     "content_html": "None",
     "correctness": "1.0",
     "feedback_html": "The function call uses all keyword arguments to assign values to the named parameters."
    }
   ],
