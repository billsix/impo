 "questions": [
  {
   "id": 665885,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which comment is most useful for the following code?\n<pre class=\"python\" data-lang=\"python\">print(\"You said:\", adj1 + \" \" + noun1)</pre>\n",
   "answers": [
    {
     "id": 1327616,
     "content_html": "<code class=\"python\" data-lang=\"python\"># Append adj1 and noun1</code>",
     "correctness": "0.0",
     "feedback_html": "This comment is not useful, because the comment simply repeats the code in English."
    },
    {
     "id": 1327617,
     "content_html": "<code class=\"python\" data-lang=\"python\"># Print out a bunch of stuff</code>",
     "correctness": "0.0",
     "feedback_html": "This comment is not useful, because words like \"bunch\" and \"stuff\" are too vague."
    },
    {
     "id": 1327618,
     "content_html": "<code class=\"python\" data-lang=\"python\"># Show the resulting phrase</code>",
     "correctness": "1.0",
     "feedback_html": "This comment explains the intent of the code. If the code had a mistake, the programmer reading the comment might notice the mistake more easily."
    }
   ],
