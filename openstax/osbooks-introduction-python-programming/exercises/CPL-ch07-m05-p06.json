 "questions": [
  {
   "id": 666663,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Search for the webcolors module on PyPI. What function provided by webcolors looks up the color name for a hex code?",
   "answers": [
    {
     "id": 1329020,
     "content_html": "<code class=\"python\" data-lang=\"python\">hex_to_name</code>",
     "correctness": "1.0",
     "feedback_html": "This function converts a color code to a color name. Ex: <code class=\"python\" data-lang=\"python\">hex_to_name(\"#daa520\")</code> returns <code class=\"python\" data-lang=\"python\">\"goldenrod\"</code>."
    },
    {
     "id": 1329021,
     "content_html": "<code class=\"python\" data-lang=\"python\">name_to_hex</code>",
     "correctness": "0.0",
     "feedback_html": "This function converts a color name to a color code. Ex: name_to_hex(\"white\") returns \"#ffffff\"."
    },
    {
     "id": 1329022,
     "content_html": "<code class=\"python\" data-lang=\"python\">normalize_hex</code>",
     "correctness": "0.0",
     "feedback_html": "This function returns color codes in a standard 6-digit format. Ex: normalize_hex(\"#09C\") returns \"#0099cc\"."
    }
   ],
