   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many times is the two-ring solution used with three rings?",
   "answers": [
    {
     "id": 919732,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "Using the 2 rings solution once moves 2 rings from 1 tower to another, so from source to middle."
    },
    {
     "id": 919733,
     "content_html": "2",
     "correctness": "1.0",
     "feedback_html": "Once to move two rings to the middle tower following the rules, then to move two rings to the target tower."
    },
    {
     "id": 919734,
     "content_html": "0",
     "correctness": "0.0",
     "feedback_html": "Without using 2 rings solution the 3 rings solution becomes chaotic and can have many useless steps."
    }
