  {
   "id": 666515,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many times is print() called?\n<pre class=\"python\" data-lang=\"python\">print(\"Please log in\")\nusername = input(\"Username:\")\npassword = input(\"Password:\")\nprint(\"Login successful\")\nprint(\"Welcome,\", username)\n</pre>",
   "answers": [
    {
     "id": 1328598,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "Each instance of print() is a function call. Lines 1, 4, and 5 call print()."
    },
    {
     "id": 1328599,
     "content_html": "3",
     "correctness": "1.0",
     "feedback_html": "Lines 1, 4, and 5 each call <code class=\"python\" data-lang=\"python\">print()</code> once. Lines 2 and 3 call a different function, <code class=\"python\" data-lang=\"python\">input()</code>."
    },
    {
     "id": 1328600,
     "content_html": "5",
     "correctness": "0.0",
     "feedback_html": "Lines 2 and 3 call input(), not print()."
    }
   ],
