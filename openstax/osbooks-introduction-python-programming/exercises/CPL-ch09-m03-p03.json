 "questions": [
  {
   "id": 666785,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How are the words <code class=\"python\" data-lang=\"python\">\"flask\"</code> and <code class=\"python\" data-lang=\"python\">\"flash\"</code> related in Python?",
   "answers": [
    {
     "id": 1329374,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"flask\" &lt; \"flash\"</code>",
     "correctness": "0.0",
     "feedback_html": "The less than sign indicates which word comes earlier in dictionary order. Flash would be before flask."
    },
    {
     "id": 1329375,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"flask\" == \"flash\"</code>",
     "correctness": "0.0",
     "feedback_html": "The first 4 characters are the same, so how the words relate depends on the last character."
    },
    {
     "id": 1329376,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"flask\" &gt; \"flash\"</code>",
     "correctness": "1.0",
     "feedback_html": "In alphabetical order, \"h\" comes before \"k\". The first four characters are the same, so <code class=\"python\" data-lang=\"python\">\"flash\"</code> comes before <code class=\"python\" data-lang=\"python\">\"flask\"</code>."
    }
   ],
   "hints": [],
