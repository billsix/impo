 "questions": [
  {
   "id": 666379,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x = 40</code>, what is the final value of <code class=\"python\" data-lang=\"python\">y</code>?\n<pre class=\"python\" data-lang=\"python\">if x &gt; 30:\n&nbsp;&nbsp;y = x - 10\nelse:\n&nbsp;&nbsp;y = x + 10\n</pre>",
   "answers": [
    {
     "id": 1328206,
     "content_html": "<code class=\"python\" data-lang=\"python\">30</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">40 &gt; 30</code>, so the body of the <code class=\"python\" data-lang=\"python\">if</code> statement is executed. <code class=\"python\" data-lang=\"python\">y = 40 - 10 = 30</code>."
    },
    {
     "id": 1328207,
     "content_html": "<code class=\"python\" data-lang=\"python\">40</code>",
     "correctness": "0.0",
     "feedback_html": "In an if-else statement, one of the branches is taken, so y's value is changed."
    },
    {
     "id": 1328208,
     "content_html": "<code class=\"python\" data-lang=\"python\">50</code>",
     "correctness": "0.0",
     "feedback_html": "40 > 30, so the body of the if statement is executed."
    }
   ],
