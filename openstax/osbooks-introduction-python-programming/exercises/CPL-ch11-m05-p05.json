 "questions": [
  {
   "id": 666943,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which code creates a name collision?",
   "answers": [
    {
     "id": 1329836,
     "content_html": "<code class=\"python\" data-lang=\"python\">character = 'Ranger'</code>",
     "correctness": "0.0",
     "feedback_html": "character is not defined in the program, since the alias game_char refers to the module. character can be assigned with a string, and game_char can still be used to access the module."
    },
    {
     "id": 1329837,
     "content_html": "<code class=\"python\" data-lang=\"python\">Game_char = 'Ranger'</code>",
     "correctness": "0.0",
     "feedback_html": "Python is case-sensitive so capitalization results in a different variable name. Game_char does not cause a name collision with game_char, but too similar variable names should be changed to avoid confusion."
    },
    {
     "id": 1329838,
     "content_html": "<code class=\"python\" data-lang=\"python\">game_char = 'Ranger'</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">game_char</code> referred to the imported module, but assigning <code class=\"python\" data-lang=\"python\">game_char</code> replaces the imported module with the string <code class=\"python\" data-lang=\"python\">'Ranger'</code>. <code class=\"python\" data-lang=\"python\">game_char</code> can no longer be used to access classes."
    }
   ],
