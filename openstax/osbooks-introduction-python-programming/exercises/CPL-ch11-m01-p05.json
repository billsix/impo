 "questions": [
  {
   "id": 391512,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the car example in the paragraph above. Suppose the designer decided to remove the engine temperature indicator. Would this be a good use of abstraction?",
   "answers": [
    {
     "id": 919543,
     "content_html": "yes",
     "correctness": "0.0",
     "feedback_html": "Correct abstraction does not make necessary information invisible."
    },
    {
     "id": 919544,
     "content_html": "no",
     "correctness": "1.0",
     "feedback_html": "Correct abstraction makes only necessary information visible. An overheated engine can cause irreparable damage, so an indicator is necessary for the driver."
    }
   ],
