 "questions": [
  {
   "id": 665837,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which produces the string <code class=\"python\" data-lang=\"python\">\"10\"</code>?",
   "answers": [
    {
     "id": 1327474,
     "content_html": "<code class=\"python\" data-lang=\"python\">1 + 0</code>",
     "correctness": "0.0",
     "feedback_html": "Without enclosing quotes around the operands, the + operator performs arithmetic addition."
    },
    {
     "id": 1327475,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"1 + 0\"</code>",
     "correctness": "0.0",
     "feedback_html": "Since the + operator is within the enclosed quotes, it is considered to be a part of the string and not the concatenation operator."
    },
    {
     "id": 1327476,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"1\" + \"0\"</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">1</code> and <code class=\"python\" data-lang=\"python\">0</code> are enclosed in quotes indicating valid strings, and the + is not, indicating a concatenation operation. Thus, the string <code class=\"python\" data-lang=\"python\">\"10\"</code> is produced. Note that concatenation operator does not include any default separator characters like the space character."
    }
   ],
