 "questions": [
  {
   "id": 666651,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What symbol indicates that a function is not intended to be called by other modules?",
   "answers": [
    {
     "id": 1328984,
     "content_html": "underscore (<code class=\"python\" data-lang=\"python\">_</code>)",
     "correctness": "1.0",
     "feedback_html": "Function names that begin with an underscore are intended to be used only within the current module."
    },
    {
     "id": 1328985,
     "content_html": "number sign (<code class=\"python\" data-lang=\"python\">#</code>)",
     "correctness": "0.0",
     "feedback_html": "In Python, # is used for comments. In HTML, # is used for hexadecimal color codes."
    },
    {
     "id": 1328986,
     "content_html": "colon (<code class=\"python\" data-lang=\"python\">:</code>)",
     "correctness": "0.0",
     "feedback_html": "A colon is required, for every function, at the end of a <code class=\"python\" data-lang=\"python\">def</code> statement."
    }
   ],
