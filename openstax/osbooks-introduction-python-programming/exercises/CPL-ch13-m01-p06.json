 "questions": [
  {
   "id": 667003,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following <code class=\"python\" data-lang=\"python\">SuperClass</code> and <code class=\"python\" data-lang=\"python\">SubClass</code>, which of the following can an instance of <code class=\"python\" data-lang=\"python\">SubClass</code> access?\n<pre class=\"python\" data-lang=\"python\">class SuperClass():\n&nbsp;&nbsp;def func_1(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print('Superclass function')\n\nclass SubClass(SuperClass):\n&nbsp;&nbsp;def func_2(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print('Subclass function')\n</pre>",
   "answers": [
    {
     "id": 1329982,
     "content_html": "<code class=\"python\" data-lang=\"python\">func_1()</code> only",
     "correctness": "0.0",
     "feedback_html": "func_2() is a SubClass method, so a SubClass instance can access func_2()."
    },
    {
     "id": 1329983,
     "content_html": "<code class=\"python\" data-lang=\"python\">func_2()</code> only",
     "correctness": "0.0",
     "feedback_html": "A SubClass instance has access to inherited methods as well as SubClass methods."
    },
    {
     "id": 1329984,
     "content_html": "<code class=\"python\" data-lang=\"python\">func_1()</code> and <code class=\"python\" data-lang=\"python\">func_2()</code>",
     "correctness": "1.0",
     "feedback_html": "A <code class=\"python\" data-lang=\"python\">SubClass</code> instance has access to <code class=\"python\" data-lang=\"python\">func_1()</code>, inherited from <code class=\"python\" data-lang=\"python\">SuperClass</code>, as well as to <code class=\"python\" data-lang=\"python\">func_2()</code>, a <code class=\"python\" data-lang=\"python\">SubClass</code> method."
    }
   ],
