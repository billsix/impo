   "stimulus_html": "",
   "stem_html": "What symbol is used to show a variable's current value?",
   "answers": [
    {
     "id": 918057,
     "content_html": "<span class=\"blue-code\">a</span>n arrow",
     "correctness": "1.0",
     "feedback_html": "An arrow show<span class=\"blue-code\">s</span> which object a variable currently refers to."
    },
    {
     "id": 918058,
     "content_html": "<span class=\"blue-code\">a</span> small black box",
     "correctness": "0.0",
     "feedback_html": "A small black box represents the variable in memory, not the variable's value."
    },
    {
     "id": 918059,
     "content_html": "<span class=\"blue-code\">a</span> rounded box",
     "correctness": "0.0",
     "feedback_html": "A rounded box represents an object in memory, which can be referred to by multiple var<span class=\"blue-code\">ia</span>bles."
    }
