   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">print(y, type(y))</pre>",
   "answers": [
    {
     "id": 1327522,
     "content_html": "<code class=\"python\" data-lang=\"python\">2.0 &lt;class 'int'&gt;</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">y = 2.0</code> is a floating-point number despite having a 0 fractional part."
    },
    {
     "id": 1327523,
     "content_html": "<code class=\"python\" data-lang=\"python\">2.0 &lt;class 'float'&gt;</code>",
