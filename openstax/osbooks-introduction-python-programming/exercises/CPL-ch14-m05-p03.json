  {
   "id": 667107,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<code class=\"python\" data-lang=\"python\">raise ValueError</code>",
   "answers": [
    {
     "id": 1330280,
     "content_html": "<code class=\"python\" data-lang=\"python\">ValueError</code>",
     "correctness": "1.0",
     "feedback_html": "An exception can be raised without providing an error message. In this case, the error message is empty, but the exception name is still printed."
    },
    {
     "id": 1330281,
     "content_html": "<code class=\"python\" data-lang=\"python\">NameError: name 'ValueError' is not defined</code>",
     "correctness": "0.0",
     "feedback_html": "ValueError is one of Python's built-in exceptions."
    },
    {
     "id": 1330282,
     "content_html": "<code class=\"python\" data-lang=\"python\">SyntaxError: Missing parenthesis in call to 'ValueError'</code>",
     "correctness": "0.0",
     "feedback_html": "If an exception is raised without parenthesis, the exception class's constructor will be called without arguments."
    }
   ],
