 "questions": [
  {
   "id": 666451,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which part of the conditional expression is incorrect?\n<pre class=\"python\" data-lang=\"python\">min_num = x if x &lt; y else min_num = y\n</pre>",
   "answers": [
    {
     "id": 1328408,
     "content_html": "<code class=\"python\" data-lang=\"python\">min_num = x</code>",
     "correctness": "0.0",
     "feedback_html": "The variable min_num will be assigned with x if x &lt; y."
    },
    {
     "id": 1328409,
     "content_html": "<code class=\"python\" data-lang=\"python\">x &lt; y</code>",
     "correctness": "0.0",
     "feedback_html": "x &lt; y is the condition of the conditional expression."
    },
    {
     "id": 1328410,
     "content_html": "<code class=\"python\" data-lang=\"python\">min_num = y</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">min_num</code> cannot be assigned with <code class=\"python\" data-lang=\"python\">min_num = y</code>. The correct expression is <code>min_num = x if x &lt; y else y</code>\""
    }
   ],
   "hints": [],
