 "questions": [
  {
   "id": 666703,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">count = 0\nfor c in \"abca\":\n&nbsp;&nbsp;if c == \"a\":\n&nbsp;&nbsp;&nbsp;&nbsp;count += 1\nprint(count)</pre>",
   "answers": [
    {
     "id": 1329132,
     "content_html": "<code class=\"python\" data-lang=\"python\">0</code>",
     "correctness": "0.0",
     "feedback_html": "The count's initial value is 0. But, the loop increments count's value by 1 each time that \"a\" is observed."
    },
    {
     "id": 1329133,
     "content_html": "<code class=\"python\" data-lang=\"python\">1</code>",
     "correctness": "0.0",
     "feedback_html": "The count variable increases each time character \"a\" is observed. How many \"a\"'s exist in \"abca\"?"
    },
    {
     "id": 1329134,
     "content_html": "<code class=\"python\" data-lang=\"python\">2</code>",
     "correctness": "1.0",
     "feedback_html": "The given code iterates over characters in string <code class=\"python\" data-lang=\"python\">\"abca\"</code>, and each time character <code class=\"python\" data-lang=\"python\">\"a\"</code> is observed, a counter variable is increased by 1. Since <code class=\"python\" data-lang=\"python\">\"a\"</code> appears twice in <code class=\"python\" data-lang=\"python\">\"abca\"</code>, the output will be <code class=\"python\" data-lang=\"python\">2</code>."
    }
   ],
