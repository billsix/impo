   "id": 666593,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the value of <code class=\"python\" data-lang=\"python\">val2</code>?\n<pre class=\"python\" data-lang=\"python\">def sq(num):\n&nbsp;&nbsp;return num * num\n\ndef offset(num):\n&nbsp;&nbsp;return num - 2\n\nval = 5\nval2 = sq(offset(val))\n</pre>",
   "answers": [
    {
     "id": 1328817,
     "content_html": "<code class=\"python\" data-lang=\"python\">9</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">val2 = sq(offset(5))</code> evaluates to <code class=\"python\" data-lang=\"python\">val2 = sq(3)</code> to 9."
    },
    {
     "id": 1328818,
     "content_html": "<code class=\"python\" data-lang=\"python\">23</code>",
     "correctness": "0.0",
     "feedback_html": "5 is offset to 3, which is then passed to sq()."
    }
   ],
