  {
   "id": 665941,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The statement <code class=\"python\" data-lang=\"python\">result = 2.0 * (10.0 ** 500)</code> assigns the variable result with too large of a value.",
   "answers": [
    {
     "id": 1327755,
     "content_html": "round-off",
     "correctness": "0.0",
     "feedback_html": "A round-off error would be caused by inaccurate approximation. An overflow error occurs because the value is outside of the floating-point range."
    },
    {
     "id": 1327756,
     "content_html": "overflow",
     "correctness": "1.0",
     "feedback_html": "An overflow error occurs because the value is larger than the upper limit of the floating-point range."
    }
   ],
