   "id": 392046,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following plot types is best suited for visualizing outliers and quartiles of a continuous variable?",
   "answers": [
    {
     "id": 920121,
     "content_html": "histogram plot",
     "correctness": "0.0",
     "feedback_html": "A histogram visualizes the distribution of the data but does not provide information about quartiles."
    },
    {
     "id": 920122,
     "content_html": "bar plot",
     "correctness": "0.0",
     "feedback_html": "Bar plot is used to visualize a categorical variable."
    },
    {
     "id": 920123,
     "content_html": "box plot",
     "correctness": "1.0",
     "feedback_html": "A box plot is used to show the distribution of a continuous variable, along with visualizing outliers, minimum, maximum, and quartiles."
    }
