 "questions": [
  {
   "id": 666737,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">template = \"{name:12}\"\nformatted_name = template.format(name = \"Alice\")\nprint(len(formatted_name))\n</pre>",
   "answers": [
    {
     "id": 1329236,
     "content_html": "<code class=\"python\" data-lang=\"python\">5</code>",
     "correctness": "0.0",
     "feedback_html": "The string template specifies the minimum length for the <code class=\"python\" data-lang=\"python\">name</code> field to be 12, hence, the length of the <code class=\"python\" data-lang=\"python\">formatted_name</code> variable is 12. What is the code's output?"
    },
    {
     "id": 1329237,
     "content_html": "<code class=\"python\" data-lang=\"python\">12</code>",
     "correctness": "1.0",
     "feedback_html": "The template specifies the minimum length for the <code class=\"python\" data-lang=\"python\">name</code> field to be 12, so  <code class=\"python\" data-lang=\"python\">len(formatted_name)</code> is <code class=\"python\" data-lang=\"python\">12</code>."
    },
    {
     "id": 1329238,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"Alice\"</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">print()</code> function prints <code class=\"python\" data-lang=\"python\">len(formatted_name))</code> and not the variable's value."
    }
   ],
