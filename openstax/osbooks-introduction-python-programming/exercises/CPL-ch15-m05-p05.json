   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is being plotted using the code below?\n<pre class=\"python\" data-lang=\"python\">import matplotlib.pyplot as plt\n\n# Data\ncategories = ['A', 'B', 'C', 'D']\nvalues = [10, 15, 12, 18]\nplt.bar(categories, values)\n</pre>",
   "answers": [
    {
     "id": 1330408,
     "content_html": "a histogram plot",
     "correctness": "0.0",
     "feedback_html": "A histogram plot can be created by passing a quantitative variable to the <code class=\"python\" data-lang=\"python\">hist()</code> function."
    },
    {
     "id": 1330409,
     "content_html": "a bar plot",
     "correctness": "1.0",
     "feedback_html": "The given code plots a bar plot with four bars representing the given categories. The height of the bars corresponds to the values stored in the <code class=\"python\" data-lang=\"python\">values</code> variable."
    },
    {
     "id": 1330410,
     "content_html": "a line plot",
     "correctness": "0.0",
     "feedback_html": "A line plot can be created by passing two quantitative variables to the function <code class=\"python\" data-lang=\"python\">plot()</code>."
    }
