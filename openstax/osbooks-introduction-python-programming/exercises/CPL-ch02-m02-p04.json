  {
   "id": 665903,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which function converts the input number of slices to a data type that can be used in the calculation?",
   "answers": [
    {
     "id": 1327662,
     "content_html": "<code class=\"python\" data-lang=\"python\">float()</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">float()</code> converts the input number of slices from a string to a float for the pizza order calculation."
    },
    {
     "id": 1327663,
     "content_html": "<code class=\"python\" data-lang=\"python\">input()</code>",
     "correctness": "0.0",
     "feedback_html": "input() reads in the number of slices as a string. Another function is needed to convert the string to a numeric data type."
    },
    {
     "id": 1327664,
     "content_html": "<code class=\"python\" data-lang=\"python\">int()</code>",
     "correctness": "0.0",
     "feedback_html": "int() is not used, since the average number of slices per person may be a decimal number. Another function is used to convert the input number of slices to a numeric data type."
    }
   ],
