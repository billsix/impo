   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many function calls occur during the execution of the program?",
   "answers": [
    {
     "id": 1328664,
     "content_html": "2",
     "correctness": "0.0",
     "feedback_html": "The program includes 2 functions, print_book_club() and print_conf(), that are called once for each iteration of the for loop."
    },
    {
     "id": 1328665,
     "content_html": "3",
     "correctness": "0.0",
     "feedback_html": "The for loop calls print_book_club() each iteration for a total of 3 print_book_club() calls. Each time print_book_club() executes, print_conf() is called."
    },
    {
     "id": 1328666,
     "content_html": "6",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">for</code> loop has three iterations. Each iteration calls <code class=\"python\" data-lang=\"python\">print_book_club()</code>, which calls <code class=\"python\" data-lang=\"python\">print_conf()</code>. So the program calls <code class=\"python\" data-lang=\"python\">print_book_club()</code> three times and <code class=\"python\" data-lang=\"python\">print_conf()</code> three times."
    }
   ],
