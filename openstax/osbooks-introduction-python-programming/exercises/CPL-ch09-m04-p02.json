 "questions": [
  {
   "id": 666795,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the minimum of the following list?\n<br>\n<code class=\"python\" data-lang=\"python\">[\"Lollapalooza\", \"Coachella\", \"Newport Jazz festival\", \"Hardly Strictly Bluegrass\", \"Austin City Limits\"]</code>",
   "answers": [
    {
     "id": 1329402,
     "content_html": "<code class=\"python\" data-lang=\"python\">Coachella</code>",
     "correctness": "0.0",
     "feedback_html": "\"Coachella\" is the shortest string, but the minimum of a list of strings is the one that appears earliest in dictionary order."
    },
    {
     "id": 1329403,
     "content_html": "<code class=\"python\" data-lang=\"python\">Austin City Limits</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"Austin City Limits\"</code> is the first string in dictionary order. "
    },
    {
     "id": 1329404,
     "content_html": "The minimum doesn't exist.",
     "correctness": "0.0",
     "feedback_html": "Although a numerical minimum does not exist, the minimum is the first string in dictionary order."
    }
   ],
