 "questions": [
  {
   "id": 666771,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the correct way to access the 17th element in a list called <code class=\"python\" data-lang=\"python\">cardList</code>?",
   "answers": [
    {
     "id": 1329336,
     "content_html": "<code class=\"python\" data-lang=\"python\">cardList[17]</code>",
     "correctness": "0.0",
     "feedback_html": "List positions begin at 0. In order to adjust for positions beginning at 0, the index must be changed."
    },
    {
     "id": 1329337,
     "content_html": "<code class=\"python\" data-lang=\"python\">cardList(17)</code>",
     "correctness": "0.0",
     "feedback_html": "List elements are accessed using square brackets. "
    },
    {
     "id": 1329338,
     "content_html": "<code class=\"python\" data-lang=\"python\">cardList[16]</code>",
     "correctness": "1.0",
     "feedback_html": "Since element positions start at 0, the required number is one less than the position being accessed."
    }
   ],
