 "questions": [
  {
   "id": 666761,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct syntax to remove the element <code class=\"python\" data-lang=\"python\">23</code> from a list called <code class=\"python\" data-lang=\"python\">number_list</code>?",
   "answers": [
    {
     "id": 1329308,
     "content_html": "<code class=\"python\" data-lang=\"python\">remove()</code>",
     "correctness": "0.0",
     "feedback_html": "The remove operation must be called on a specific list."
    },
    {
     "id": 1329309,
     "content_html": "<code class=\"python\" data-lang=\"python\">number_list.remove()</code>",
     "correctness": "0.0",
     "feedback_html": "The remove operation must be performed on a specific list and the parameter indicates which element is to be removed. "
    },
    {
     "id": 1329310,
     "content_html": "<code class=\"python\" data-lang=\"python\">number_list.remove(23)</code>",
     "correctness": "1.0",
     "feedback_html": "The element to be removed is passed as a parameter to the remove operation. The remove is performed on the specified list."
    }
   ],
