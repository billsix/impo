 "questions": [
  {
   "id": 666599,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the positional argument in <code class=\"python\" data-lang=\"python\">greeting(\"Welcome\", count=1, name=\"Anita\")</code>?",
   "answers": [
    {
     "id": 1328834,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"Welcome\"</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">\"Welcome\"</code> is unnamed and assigned correctly to count. Positional arguments must come before keyword arguments."
    },
    {
     "id": 1328835,
     "content_html": "<code class=\"python\" data-lang=\"python\">count=1</code>",
     "correctness": "0.0",
     "feedback_html": "count=1 uses a name to assign value and is a keyword argument. \"Welcome\" does not."
    },
    {
     "id": 1328836,
     "content_html": "<code class=\"python\" data-lang=\"python\">name=\"Anita\"</code>",
     "correctness": "0.0",
     "feedback_html": "name=\"Anita\" uses a name to assign value and is a keyword argument. \"Welcome\" does not."
    }
   ],
