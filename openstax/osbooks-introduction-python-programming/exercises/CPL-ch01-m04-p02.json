 "questions": [
  {
   "id": 665831,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which line of code assigns a string to the variable <code class=\"python\" data-lang=\"python\">email?</code>",
   "answers": [
    {
     "id": 1327456,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"fred78@gmail.com\"</code>",
     "correctness": "0.0",
     "feedback_html": "This is a string (sometimes referred to as a string literal) but it is not assigned to any variable."
    },
    {
     "id": 1327457,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"email = fred78@gmail.com\"</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">email = fred78@gmail.com</code> is a variable assignment statement. But because the statement is enclosed with quotes, <code class=\"python\" data-lang=\"python\">email = fred78@gmail.com</code> is interpreted as a string and not a variable assignment."
    },
    {
     "id": 1327458,
     "content_html": "<code class=\"python\" data-lang=\"python\">email = \"fred78@gmail.com\"</code>",
     "correctness": "1.0",
     "feedback_html": "The string, <code class=\"python\" data-lang=\"python\">fred78@gmail.com</code>, is enclosed in matching double quotes, and is assigned to the variable <code class=\"python\" data-lang=\"python\">email</code>. A string can contain characters such as \"@\" or \".\" in addition to letters and numbers."
    }
   ],
