 "questions": [
  {
   "id": 666479,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the sequence generated from <code class=\"python\" data-lang=\"python\">range(-1, -2, -1)</code>?",
   "answers": [
    {
     "id": 1328490,
     "content_html": "<code class=\"python\" data-lang=\"python\">1</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">range()</code> function generates a descending sequence, beginning from <code class=\"python\" data-lang=\"python\">-1</code> until <code class=\"python\" data-lang=\"python\">-2</code>. Hence, the output is <code class=\"python\" data-lang=\"python\">-1</code>."
    },
    {
     "id": 1328491,
     "content_html": "<code class=\"python\" data-lang=\"python\">-1, -2</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">range()</code> function is inclusive of the start,-1, and exclusive of the end, -2. Hence, the output cannot include -2."
    },
    {
     "id": 1328492,
     "content_html": "<code class=\"python\" data-lang=\"python\">-2</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">range()</code> function generates a sequence beginning from the starting integer, -1, and until the end of the sequence, -2. Hence, the output must include -1 and cannot include -2."
    }
   ],
