   "stimulus_html": "",
   "stem_html": "<code class=\"python\" data-lang=\"python\">c:\\documents\\</code> on a Windows computer for reading",
   "answers": [
    {
     "id": 1330198,
     "content_html": "<code class=\"python\" data-lang=\"python\">fileobj = open(\"out.txt\")</code>",
     "correctness": "0.0",
     "feedback_html": "Since the file is located in a location different from the Python file an error will occur."
    },
    {
     "id": 1330199,
     "content_html": "<code class=\"python\" data-lang=\"python\">fileobj = open(\"c:/documents/out.txt\", 'a')</code>",
     "correctness": "0.0",
     "feedback_html": "The use of forward slashes / replacing the Windows standard backslashes \\ enables the path to be read correctly. The path followed by the filename enables the file to be opened but when reading a file read mode is preferable."
    },
    {
