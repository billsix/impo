 "questions": [
  {
   "id": 666897,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When line 11 executes, execution flow moves to line 5. What does <code class=\"python\" data-lang=\"python\">self</code> represent on line 5?",
   "answers": [
    {
     "id": 1329700,
     "content_html": "the area of <code class=\"python\" data-lang=\"python\">room_1</code>",
     "correctness": "0.0",
     "feedback_html": "room_1's area is the return value of area(). self is a parameter that refers to a specific instance."
    },
    {
     "id": 1329701,
     "content_html": "the instance <code class=\"python\" data-lang=\"python\">room_1</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">room_1</code> is the instance that called the method <code class=\"python\" data-lang=\"python\">area()</code>, so <code class=\"python\" data-lang=\"python\">self</code> represents the specific instance."
    },
    {
     "id": 1329702,
     "content_html": "the <code class=\"python\" data-lang=\"python\">Rectangle</code> class",
     "correctness": "0.0",
     "feedback_html": "self represents an instance of a class, not the class."
    }
   ],
