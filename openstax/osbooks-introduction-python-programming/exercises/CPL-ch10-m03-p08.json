 "questions": [
  {
   "id": 666861,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which option removes the item <code class=\"python\" data-lang=\"python\">\"Butter Chicken\": \"$18\"</code> from the <code class=\"python\" data-lang=\"python\">food</code> dictionary?",
   "answers": [
    {
     "id": 1329594,
     "content_html": "<code class=\"python\" data-lang=\"python\">food.remove(\"Butter Chicken\")</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">remove()</code> is not an attribute for a dictionary. To delete an item from a dictionary, <code class=\"python\" data-lang=\"python\">del</code> keyword or <code class=\"python\" data-lang=\"python\">pop()</code> method can be used."
    },
    {
     "id": 1329595,
     "content_html": "<code class=\"python\" data-lang=\"python\">del food[\"Butter Chicken\"]</code>",
     "correctness": "1.0",
     "feedback_html": "Using the <code class=\"python\" data-lang=\"python\">del</code> keyword, items can be deleted from a dictionary using the key."
    },
    {
     "id": 1329596,
     "content_html": "<code class=\"python\" data-lang=\"python\">del food.del(\"Butter Chicken\")</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">del</code> is not a function and is a keyword. The syntax for deleting an item using del is <code class=\"python\" data-lang=\"python\">del dictionary[key]</code>."
    }
   ],
