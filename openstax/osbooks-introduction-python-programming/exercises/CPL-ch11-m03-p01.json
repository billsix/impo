  {
   "id": 666911,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Suppose the programmer wanted to make blood pressure a required parameter in <code class=\"python\" data-lang=\"python\">__init__()</code>. Which is the correct <code class=\"python\" data-lang=\"python\">__init__()</code> method header?",
   "answers": [
    {
     "id": 1329742,
     "content_html": "<code class=\"python\" data-lang=\"python\">def __init__(p_id, bp, self, tmp=-1.0, hr=-1, rr=-1):</code>",
     "correctness": "0.0",
     "feedback_html": "self must be __init__()'s first parameter."
    },
    {
     "id": 1329743,
     "content_html": "<code class=\"python\" data-lang=\"python\">def __init__(self, p_id, bp, tmp=-1.0, hr=-1, rr=-1):</code>",
     "correctness": "1.0",
     "feedback_html": "Removing the default parameter value makes <code class=\"python\" data-lang=\"python\">bp</code> a required parameter."
    },
    {
     "id": 1329744,
     "content_html": "<code class=\"python\" data-lang=\"python\">def __init__(self, p_id, bp=[-1,-1], tmp=-1.0, hr=-1, rr=-1):</code>",
     "correctness": "0.0",
     "feedback_html": "bp has a default parameter value, so a call to __init__() doesn't require a bp value."
    }
   ],
