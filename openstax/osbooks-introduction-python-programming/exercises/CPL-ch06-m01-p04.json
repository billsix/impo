 "questions": [
  {
   "id": 666519,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What's wrong with the first line of the function definition?\n<pre class=\"python\" data-lang=\"python\">def water_plant:\n</pre>",
   "answers": [
    {
     "id": 1328610,
     "content_html": "A docstring should go after the colon.",
     "correctness": "0.0",
     "feedback_html": "The docstring is the first line of the indented body under <code class=\"python\" data-lang=\"python\">def water_plant():</code>."
    },
    {
     "id": 1328611,
     "content_html": "Parentheses should go after <code class=\"python\" data-lang=\"python\">water_plant</code>.",
     "correctness": "1.0",
     "feedback_html": "The corrected line is <code class=\"python\" data-lang=\"python\">def water_plant():</code>."
    },
    {
     "id": 1328612,
     "content_html": "<code class=\"python\" data-lang=\"python\">def</code> should be <code class=\"python\" data-lang=\"python\">define</code> before <code class=\"python\" data-lang=\"python\">water_plant</code>.",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">def</code> is the keyword used to define a function, followed by the function name and parentheses."
    }
   ],
