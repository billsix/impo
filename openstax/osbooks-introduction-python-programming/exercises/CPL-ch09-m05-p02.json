 "questions": [
  {
   "id": 666807,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would be the correct index for the number <code class=\"python\" data-lang=\"python\">6</code> in the above list?",
   "answers": [
    {
     "id": 1329436,
     "content_html": "<code class=\"python\" data-lang=\"python\">[5]</code>",
     "correctness": "0.0",
     "feedback_html": "In a two-dimensional list a single number within the list-of-lists is addressed using both dimensions."
    },
    {
     "id": 1329437,
     "content_html": "<code class=\"python\" data-lang=\"python\">[2][1]</code>",
     "correctness": "0.0",
     "feedback_html": "6 is in the 2nd row and 3rd column. Conventional indexing names the row number first. "
    },
    {
     "id": 1329438,
     "content_html": "<code class=\"python\" data-lang=\"python\">[1][2]</code>",
     "correctness": "1.0",
     "feedback_html": "6 is in the 2nd row and 3rd column. Using zero-indexing results in index 1 for the row and 2 for the column."
    }
   ],
