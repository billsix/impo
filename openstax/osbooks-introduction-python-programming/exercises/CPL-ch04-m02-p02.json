   "id": 666369,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following, which lines execute if the condition is true?\n<pre class=\"python line-numbering\" data-lang=\"python\">print(\"Have a great day.\")\nif is_raining:\n&nbsp;&nbsp;print(\"Don't forget an umbrella!\")\nprint(\"See you soon.\")\n</pre>",
   "answers": [
    {
     "id": 1328176,
     "content_html": "1, 2, 3",
     "correctness": "0.0",
     "feedback_html": "Once the body is executed, the program continues after the if statement."
    },
    {
     "id": 1328177,
     "content_html": "1, 2, 4",
     "correctness": "0.0",
     "feedback_html": "When the condition is True, the body is executed."
    },
    {
     "id": 1328178,
     "content_html": "1, 2, 3, 4",
     "correctness": "1.0",
     "feedback_html": "The program executes the body when the condition is true."
    }
