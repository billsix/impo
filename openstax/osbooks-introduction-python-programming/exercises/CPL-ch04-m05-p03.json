 "questions": [
  {
   "id": 666425,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which conditions complete the code such that if <code class=\"python\" data-lang=\"python\">x</code> is less than 0, <code class=\"python\" data-lang=\"python\">Body 1</code> executes, else if <code class=\"python\" data-lang=\"python\">x</code> equals 0, <code class=\"python\" data-lang=\"python\">Body 2</code> executes. \n<pre class=\"python\" data-lang=\"python\">if _________:\n&nbsp;&nbsp;# Body 1\nelif _________:\n&nbsp;&nbsp;# Body 2\n</pre>",
   "answers": [
    {
     "id": 1328326,
     "content_html": "<code class=\"python\" data-lang=\"python\">x &lt; 0</code> <br>\n<code class=\"python\" data-lang=\"python\">x == 0</code>\n",
     "correctness": "1.0",
     "feedback_html": "If <code class=\"python\" data-lang=\"python\">x &lt; 0</code>, <code class=\"python\" data-lang=\"python\">Body 1</code> executes. Else if <code class=\"python\" data-lang=\"python\">x == 0</code>, <code class=\"python\" data-lang=\"python\">Body 2</code> executes."
    },
    {
     "id": 1328327,
     "content_html": "<code class=\"python\" data-lang=\"python\">x == 0</code> <br>\n<code class=\"python\" data-lang=\"python\">x &lt; 0</code>\n",
     "correctness": "0.0",
     "feedback_html": "If x == 0, Body 2 should execute, not Body 1."
    },
    {
     "id": 1328328,
     "content_html": "<code class=\"python\" data-lang=\"python\">x &lt;= 0</code> <br>\n[no condition]\n",
     "correctness": "0.0",
     "feedback_html": "x &lt;= 0 covers both x &lt; 0 and x == 0, which should execute different statements. Also, elif must have a condition."
    }
   ],
