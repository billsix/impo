 "questions": [
  {
   "id": 666845,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which option creates a dictionary with two key-value pairs, <code class=\"python\" data-lang=\"python\">\"a\": \"A\"</code> and <code class=\"python\" data-lang=\"python\">\"b\": \"B\"</code>?",
   "answers": [
    {
     "id": 1329546,
     "content_html": "<code class=\"python\" data-lang=\"python\">dict(a: A, b: B)</code>",
     "correctness": "0.0",
     "feedback_html": "Keys and values are not passed as string literals."
    },
    {
     "id": 1329547,
     "content_html": "<code class=\"python\" data-lang=\"python\">dict([(\"a\", \"A\"), (\"b\", \"B\")])</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">dict()</code> function can create a dictionary object from a list of tuples. The first element of each tuple acts as the key, and the second element is the value."
    },
    {
     "id": 1329548,
     "content_html": "<code class=\"python\" data-lang=\"python\">dict({\"a\" = \"A\", \"b\" = \"B\"})</code>",
     "correctness": "0.0",
     "feedback_html": "When creating a dictionary object using curly brackets, key-values pairs must be separated using a colon."
    }
   ],
