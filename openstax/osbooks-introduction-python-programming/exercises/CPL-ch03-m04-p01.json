 "questions": [
  {
   "id": 666309,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the correct way to make a list of the numbers 3, 4, and 5?",
   "answers": [
    {
     "id": 1328022,
     "content_html": "<code class=\"python\" data-lang=\"python\">new_list == [3, 4, 5]</code>",
     "correctness": "0.0",
     "feedback_html": "== is the comparison operator and cannot be used to define a list."
    },
    {
     "id": 1328023,
     "content_html": "<code class=\"python\" data-lang=\"python\">new_list = [3, 4, 5]</code>",
     "correctness": "1.0",
     "feedback_html": "A list of numbers can be set up using an assignment operator."
    },
    {
     "id": 1328024,
     "content_html": "<code class=\"python\" data-lang=\"python\">new_list = (3, 4, 5)</code>",
     "correctness": "0.0",
     "feedback_html": "The statement is not the valid syntax for setting up a list."
    }
   ],
