   "id": 666409,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<code class=\"python\" data-lang=\"python\">10 + 3 * 2 / 4</code>",
   "answers": [
    {
     "id": 1328278,
     "content_html": "<code class=\"python\" data-lang=\"python\">10 + (3 * (2 / 4))</code>",
     "correctness": "0.0",
     "feedback_html": "Multiplication and division are left, not right, associative."
    },
    {
     "id": 1328279,
     "content_html": "<code class=\"python\" data-lang=\"python\">10 + ((3 * 2) / 4)</code>",
     "correctness": "1.0",
     "feedback_html": "Multiplication and division have the highest precedence, are left associative, and have higher precedence than addition."
    },
    {
     "id": 1328280,
     "content_html": "<code class=\"python\" data-lang=\"python\">(10 + 3) * (2 / 4)</code>",
     "correctness": "0.0",
     "feedback_html": "Addition has lower precedence than multiplication."
    }
