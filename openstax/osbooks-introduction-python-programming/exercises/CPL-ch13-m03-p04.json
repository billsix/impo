   "stimulus_html": "",
   "stem_html": "Line 16 executes and <code>Square</code>'s <code>__init__()</code> is called on line 12. Line 13 executes and the superclass's <code>__init__()</code> is called. Which line does control flow move to next?",
   "answers": [
    {
     "id": 925888,
     "content_html": "2",
     "correctness": "0.0",
     "feedback_html": "Square's immediate superclass is Rectangle, not Polygon."
    },
    {
     "id": 925889,
     "content_html": "6",
     "correctness": "1.0",
     "feedback_html": "<code>Square</code>'s superclass is <code >Rectangle</code>. <code>Rectangle</code>'s <code>__init__()</code> is called on line 6."
    },
    {
     "id": 925890,
     "content_html": "14",
     "correctness": "0.0",
     "feedback_html": "Control flow moves to a different method before returning and moving on to line 14."
    }
