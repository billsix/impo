   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<p>What is the output of the following dictionary comprehension?</p>\n<pre class=\"python\" data-lang=\"python\">my_dict = {i: i**2 for i in range(4)}\nprint(my_dict)\n</pre>",
   "answers": [
    {
     "id": 1329658,
     "content_html": "<code class=\"python\" data-lang=\"python\">{0: 0, 1: 1, 2: 4, 3: 9}</code>",
     "correctness": "1.0",
     "feedback_html": "The dictionary is created from key values from 0 up to and including 3. The associated values are powers of two of the keys."
    },
    {
     "id": 1329659,
     "content_html": "<code class=\"python\" data-lang=\"python\">{0: 0, 1: 1, 2: 4}</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">range(4)</code> starts from 0 up to and including 3. There must be another key-value pair with key = 3."
    },
    {
     "id": 1329660,
     "content_html": "<code class=\"python\" data-lang=\"python\">{1: 1, 2: 4, 3: 9}</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">range(4)</code> starts from 0 up to and including 3. There must be another key-value pair with key = 0."
    }
