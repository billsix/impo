   "stimulus_html": "",
   "stem_html": "Which variables are local?\n<pre class=\"python\" data-lang=\"python\">def print_greeting():\n&nbsp;&nbsp;print(out_str)\n\nhour = int(input())\nmin = int(input())\nif hour &lt; 12:\n&nbsp;&nbsp;out_str = \"Good morning\"\nelse:\n&nbsp;&nbsp;out_str = \"Good day\"\nprint_greeting()\n</pre>",
   "answers": [
    {
     "id": 1328700,
     "content_html": "<code class=\"python\" data-lang=\"python\">hour</code> and <code class=\"python\" data-lang=\"python\">min</code>",
     "correctness": "0.0",
     "feedback_html": "hour, min, and out_str aren't created in print_greeting()."
    },
    {
     "id": 1328701,
     "content_html": "<code class=\"python\" data-lang=\"python\">out_str</code>",
     "correctness": "0.0",
     "feedback_html": "out_str is created outside of print_greeting()."
    },
    {
     "id": 1328702,
     "content_html": "none",
