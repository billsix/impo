 "questions": [
  {
   "id": 363107,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A programmer explicitly defining the modulo operator for their user-defined class is ___________ the operator.",
   "answers": [
    {
     "id": 877832,
     "content_html": "overloading",
     "correctness": "1.0",
     "feedback_html": "A programmer can overload an operator to customize the built-in operator's function."
    },
    {
     "id": 877833,
     "content_html": "rewriting",
     "correctness": "0.0",
     "feedback_html": "The correct term for customizing built-in operator functions is overloading."
    },
    {
     "id": 877834,
     "content_html": "implementing",
     "correctness": "0.0",
     "feedback_html": "Though implementing can be used, overloading is the most appropriate term."
    }
