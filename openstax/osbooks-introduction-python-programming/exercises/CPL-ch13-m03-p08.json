 "questions": [
  {
   "id": 667027,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Consider the example. What is the output?\n<pre class=\"python\" data-lang=\"python\">class Polygon:\n&nbsp;&nbsp;def print_type(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"Polygon type\")\n\nclass Rectangle(Polygon):\n&nbsp;&nbsp;def print_type(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"Rectangle type\")\n\nclass Square(Rectangle):\n&nbsp;&nbsp;def print_type(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"Square type\")\n\nsq_1 = Square()\nsq_1.print_type()\n</pre>",
   "answers": [
    {
     "id": 1330054,
     "content_html": "<code class=\"python\" data-lang=\"python\">Polygon type</code>",
     "correctness": "0.0",
     "feedback_html": "Polygon's print_type() is overwritten in the subclasses Rectangle and Square."
    },
    {
     "id": 1330055,
     "content_html": "<code class=\"python\" data-lang=\"python\">Rectangle type</code>",
     "correctness": "0.0",
     "feedback_html": "Square overwrites print_type(), which was inherited directly from superclass Rectangle."
    },
    {
     "id": 1330056,
     "content_html": "<code class=\"python\" data-lang=\"python\">Square type</code>",
     "correctness": "1.0",
     "feedback_html": "Polymorphism allows <code class=\"python\" data-lang=\"python\">print_type()</code> to be overridden in subclasses of <code class=\"python\" data-lang=\"python\">Polygon</code>."
    }
   ],
