   "id": 666973,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<code class=\"python\" data-lang=\"python\">fib(9)</code> results in _____.",
   "answers": [
    {
     "id": 1329902,
     "content_html": "<code class=\"python\" data-lang=\"python\">13</code>",
     "correctness": "0.0",
     "feedback_html": "13 is <code class=\"python\" data-lang=\"python\">fib(7)</code>."
    },
    {
     "id": 1329903,
     "content_html": "<code class=\"python\" data-lang=\"python\">21</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">fib(8)</code> is <code class=\"python\" data-lang=\"python\">fib(7)</code> + <code class=\"python\" data-lang=\"python\">fib(6)</code>. <br><code class=\"python\" data-lang=\"python\">fib(8)</code> = 13 + 8 = 21. What is <code class=\"python\" data-lang=\"python\">fib(9)</code>?"
    },
    {
     "id": 1329904,
     "content_html": "<code class=\"python\" data-lang=\"python\">34</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">fib(9)</code> = <code class=\"python\" data-lang=\"python\">fib(8)</code> +<code class=\"python\" data-lang=\"python\"> fib(7)</code>. <code class=\"python\" data-lang=\"python\">fib(9)</code> <code class=\"python\" data-lang=\"python\">= fib(8) + fib(7) = 21 + 13 = 34</code>."
    }
   ],
