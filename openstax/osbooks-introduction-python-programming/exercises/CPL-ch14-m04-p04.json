 "questions": [
  {
   "id": 667097,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "<pre class=\"python\" data-lang=\"python\">word = \"one\"\ntry:\n&nbsp;&nbsp;number = int(word)\n&nbsp;&nbsp;print(word, \"equals\", number)\nexcept ValueError:\n&nbsp;&nbsp;print(word, \"is not a number\")\n</pre>",
   "answers": [
    {
     "id": 1330250,
     "content_html": "<code class=\"python\" data-lang=\"python\">one equals 1</code>",
     "correctness": "0.0",
     "feedback_html": "The int() function does not automatically convert words to numbers."
    },
    {
     "id": 1330251,
     "content_html": "<code class=\"python\" data-lang=\"python\">one is not a number</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">int()</code> function raises a <code class=\"python\" data-lang=\"python\">ValueError</code> when trying to convert <code class=\"python\" data-lang=\"python\">\"one\"</code> to an integer, so the program jumps to the except clause."
    },
    {
     "id": 1330252,
     "content_html": "<code class=\"python\" data-lang=\"python\">ValueError: invalid literal for int() with base 10: 'one'</code>",
     "correctness": "0.0",
     "feedback_html": "The int() function raises a ValueError, but the error is handled by the except clause."
    }
   ],
