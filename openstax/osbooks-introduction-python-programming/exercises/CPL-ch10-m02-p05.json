 "questions": [
  {
   "id": 666843,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">my_dict = dict({\"a\": 1})\nprint(my_dict)</pre>",
   "answers": [
    {
     "id": 1329540,
     "content_html": "<pre class=\"python\" data-lang=\"python\">{\"a\": 1}</pre>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">my_dict</code> is a dictionary with one key-value pair, <code class=\"python\" data-lang=\"python\">\"a\": 1</code>."
    },
    {
     "id": 1329541,
     "content_html": "<pre class=\"python\" data-lang=\"python\">&lt;class, 'dict'&gt;</pre>",
     "correctness": "0.0",
     "feedback_html": "Printing a dictionary object results in printing the content of the dictionary, not the type. What's the content of the <code class=\"python\" data-lang=\"python\">my_dict</code> object?"
    },
    {
     "id": 1329542,
     "content_html": "<pre class=\"python\" data-lang=\"python\">\"a\"\n1</pre>\n",
     "correctness": "0.0",
     "feedback_html": "When printing the content of a dictionary, elements will be enclosed in <code class=\"python\" data-lang=\"python\">{}</code> and key-value pairs are separated with a colon."
    }
