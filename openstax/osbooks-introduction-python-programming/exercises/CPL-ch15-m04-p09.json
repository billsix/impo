  {
   "id": 667143,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Assuming that a DataFrame <code class=\"python\" data-lang=\"python\">df</code> is given, which of the following replaces <code class=\"python\" data-lang=\"python\">Null</code> values with zeros?",
   "answers": [
    {
     "id": 1330390,
     "content_html": "<code class=\"python inline-code\" data-lang=\"python\">df.fillna(0)</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python inline-code\" data-lang=\"python\">fillna()</code> replaces all <code class=\"python\" data-lang=\"python\">Null</code> values with the provided value passed as an argument."
    },
    {
     "id": 1330391,
     "content_html": "<code class=\"python inline-code\" data-lang=\"python\">df.replacena(0)</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python inline-code\" data-lang=\"python\">replacena()</code> is not a Pandas method. What function replaces Null values?"
    },
    {
     "id": 1330392,
     "content_html": "<code class=\"python inline-code\" data-lang=\"python\">df.fill(0)</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python inline-code\" data-lang=\"python\">fill()</code> is not a Pandas method. What function replaces Null values?"
    }
   ],
