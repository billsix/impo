 "questions": [
  {
   "id": 666273,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What value does <code class=\"python\" data-lang=\"python\">ord(\"0\")</code> return?",
   "answers": [
    {
     "id": 1327932,
     "content_html": "<code class=\"python\" data-lang=\"python\">0</code>",
     "correctness": "0.0",
     "feedback_html": "The code point 0 was used for telecommunications, not for the character '0'."
    },
    {
     "id": 1327933,
     "content_html": "<code class=\"python\" data-lang=\"python\">48</code>",
     "correctness": "1.0",
     "feedback_html": "The code point for the character \"0\" is 48."
    },
    {
     "id": 1327934,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "'0' is a valid character. The ord() function returns the code point for any string of length one."
    }
   ],
