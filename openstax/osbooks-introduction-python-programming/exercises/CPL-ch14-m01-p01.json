 "questions": [
  {
   "id": 667053,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct way to open a file named <i>firstfile.txt</i> so that the file's contents can be read into a Python program?",
   "answers": [
    {
     "id": 1330126,
     "content_html": "<code class=\"python\" data-lang=\"python\">open(\"firstfile\")</code>",
     "correctness": "0.0",
     "feedback_html": "The full filename including the \".txt\" part must be used."
    },
    {
     "id": 1330127,
     "content_html": "<code class=\"python\" data-lang=\"python\">open(\"firstfile.txt\")</code>",
     "correctness": "0.0",
     "feedback_html": "This will open the file, but since there is no object associated, the file's contents cannot be read."
    },
    {
     "id": 1330128,
     "content_html": "<code class=\"python\" data-lang=\"python\">fileobj = open(\"firstfile.txt\")</code>",
     "correctness": "1.0",
     "feedback_html": "The file is opened and is associated with the fileobj object. Reading from the file will be possible using fileobj."
    }
   ],
