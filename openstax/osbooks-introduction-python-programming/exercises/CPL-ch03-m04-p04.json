 "questions": [
  {
   "id": 666315,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct way to modify the element <code class=\"python\" data-lang=\"python\">\"Tom\"</code> to <code class=\"python\" data-lang=\"python\">\"Tim\"</code> in the following list?\n<pre class=\"python\">name_list = [\"Carla\", \"Monique\", \"Westin\", \"Tom\"]\n</pre>",
   "answers": [
    {
     "id": 1328040,
     "content_html": "<code class=\"python\" data-lang=\"python\">name_list[-1] = \"Tim\"</code>",
     "correctness": "1.0",
     "feedback_html": "The index -1 always refers to the last element of a list. The expression <code class=\"python\" data-lang=\"python\">len(name_list)-1</code>, which evaluates to <code class=\"python\" data-lang=\"python\">3</code> and refers to the last element in a list of 4 elements, can also be used in place of -1 here."
    },
    {
     "id": 1328041,
     "content_html": "<code class=\"python\" data-lang=\"python\">name_list[4] = \"Tim\"</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">nameList</code> has 4 elements, so the last element in the list is at index 3."
    },
    {
     "id": 1328042,
     "content_html": "<code class=\"python\" data-lang=\"python\">name_list[end] = \"Tim\"</code>",
     "correctness": "0.0",
     "feedback_html": "Not valid syntax. A number or expression must be used within the square brackets."
    }
   ],
