 "questions": [
  {
   "id": 665883,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which comment is formatted correctly?",
   "answers": [
    {
     "id": 1327610,
     "content_html": "0 spaces:<br>\n<code class=\"python\" data-lang=\"python\">#Get the user input</code>\n",
     "correctness": "0.0",
     "feedback_html": "Without a space, <code class=\"python\" data-lang=\"python\">#Get</code> looks more like a hashtag than a comment."
    },
    {
     "id": 1327611,
     "content_html": "1 space:<br>\n<code class=\"python\" data-lang=\"python\"># Get the user input</code>",
     "correctness": "1.0",
     "feedback_html": "Having one space after the # is the community standard."
    },
    {
     "id": 1327612,
     "content_html": "2 spaces:<br>\n<code class=\"python\" data-lang=\"python\">#&nbsp; Get the user input</code>\n",
     "correctness": "0.0",
     "feedback_html": "Having more than one space after the # is unnecessary."
    }
   ],
