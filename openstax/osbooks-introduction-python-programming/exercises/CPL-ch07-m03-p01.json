 "questions": [
  {
   "id": 666631,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which line would cause a side effect when imported?\n<pre class=\"python line-numbering\" data-lang=\"python\">import math\n\nprint(\"Defining sphere function\")\n\ndef sphere(radius):\n&nbsp;&nbsp;\"\"\"Gets the volume of a sphere.\"\"\"\n&nbsp;&nbsp;return 4/3 * math.pi * radius**3\n</pre>",
   "answers": [
    {
     "id": 1328930,
     "content_html": "line 1",
     "correctness": "0.0",
     "feedback_html": "This module uses <code class=\"python\" data-lang=\"python\">math.pi</code> to calculate sphere volume.\nImporting <code class=\"python\" data-lang=\"python\">math</code> is necessary, not a side effect."
    },
    {
     "id": 1328931,
     "content_html": "line 3",
     "correctness": "1.0",
     "feedback_html": "Whenever this module is imported, Python will output <code class=\"python\" data-lang=\"python\">\"Defining sphere\nfunction\"</code> as a side effect."
    },
    {
     "id": 1328932,
     "content_html": "line 5",
     "correctness": "0.0",
     "feedback_html": "Defining functions is the main purpose of importing a module.\nTherefore, function definitions are generally not side effects."
    }
   ],
