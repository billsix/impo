 "questions": [
  {
   "id": 391584,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How is the problem of moving two rings solved using recursion?",
   "answers": [
    {
     "id": 919714,
     "content_html": "Move the small ring to the middle tower, move the bigger ring to the target tower, and move the small ring to the target tower.",
     "correctness": "1.0",
     "feedback_html": "The move of the smaller ring, which is a smaller problem, is done twice on the way to solving for the two rings overall. The task of moving all three rings is broken down into smaller tasks of moving one ring at a time."
    },
    {
     "id": 919715,
     "content_html": "Move two rings from the source tower to the target tower.",
     "correctness": "0.0",
     "feedback_html": "How is this accomplished step by step?"
    },
    {
     "id": 919716,
     "content_html": "Cannot be solved with recursion.",
     "correctness": "0.0",
     "feedback_html": "Recursion is necessary to come up with a systematic solution for 3 towers game."
    }
   ],
