   "stem_html": "Which docstring is most useful for this program?",
   "answers": [
    {
     "id": 1327634,
     "content_html": "<pre class=\"python\" data-lang=\"python\">\"\"\"Vacations Madlib.\"\"\"</pre>",
     "correctness": "0.0",
     "feedback_html": "This docstring, although better than nothing, is missing a description."
    },
    {
     "id": 1327635,
     "content_html": "<pre class=\"python\" data-lang=\"python\">\"\"\"Vacations Madlib. \n\nThis program asks the user for two adjectives\nand two nouns, which are then used to print\na funny story about a vacation.\n\"\"\"</pre>",
     "correctness": "1.0",
     "feedback_html": "The amount of information in this docstring is just right. In most cases, the docstring should not be longer than the code.\n"
    },
    {
     "id": 1327636,
     "content_html": "<pre class=\"python\" data-lang=\"python\">\"\"\"Vacations Madlib.\n\nThis program asks the user for two adjectives\nand two nouns, which are then used to print\na funny story about a vacation. The code uses\nfour variables to store the user input: two for\nthe adjectives, and two for the nouns. The\noutput is displayed on seven lines, beginning\nwith a blank line after the input.\n\"\"\"</pre>\n",
     "correctness": "0.0",
     "feedback_html": "This docstring contains redundant and unnecessary information, including details about variables."
    }
