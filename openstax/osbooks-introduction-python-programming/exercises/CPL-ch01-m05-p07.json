   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(y / z)</code>?",
   "answers": [
    {
     "id": 1327552,
     "content_html": "<code class=\"python\" data-lang=\"python\">0</code>",
     "correctness": "0.0",
     "feedback_html": "20/2 is greater than 0."
    },
    {
     "id": 1327553,
     "content_html": "<code class=\"python\" data-lang=\"python\">10</code>",
     "correctness": "0.0",
     "feedback_html": "The result of applying the division operator is a floating-point number."
    },
    {
     "id": 1327554,
     "content_html": "<code class=\"python\" data-lang=\"python\">10.0</code>",
     "correctness": "1.0",
     "feedback_html": "The output of the <code class=\"python\" data-lang=\"python\">20/2</code> equals <code class=\"python\" data-lang=\"python\">10.0</code> because the division operation results in a float."
