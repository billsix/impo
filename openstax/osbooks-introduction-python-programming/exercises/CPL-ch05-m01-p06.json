 "questions": [
  {
   "id": 666467,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What happens if the code is changed as follows?\n<pre class=\"python\" data-lang=\"python\">n = 4\nwhile n &gt; 0:\n&nbsp;&nbsp;print(n)\n&nbsp;&nbsp;# Modified line\n&nbsp;&nbsp;n = n + 1\n\nprint(\"value of n after the loop is\", n)\n</pre>",
   "answers": [
    {
     "id": 1328454,
     "content_html": "The code will not run.",
     "correctness": "0.0",
     "feedback_html": "The code will execute, but the loop has an error in the logic. When will the loop condition evaluate to False?"
    },
    {
     "id": 1328455,
     "content_html": "The code will run for one additional iteration.",
     "correctness": "0.0",
     "feedback_html": "The increment in n's value happens in every iteration and therefore, the code will run for more than 5 iterations."
    },
    {
     "id": 1328456,
     "content_html": "The code will never terminate.",
     "correctness": "1.0",
     "feedback_html": "Since the initialization value for <code class=\"python\" data-lang=\"python\">n</code> equals <code class=\"python\" data-lang=\"python\">4</code> and the value of <code class=\"python\" data-lang=\"python\">n</code> is only increasing, the loop condition will always remain true. The loop will never terminate."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
