 "questions": [
  {
   "id": 666733,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(\"Hey {name}!\".format(\"Bengio\"))</code>?",
   "answers": [
    {
     "id": 1329224,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hey name!</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">name</code> replacement field must be replaced with the value passed to the format function. The <code class=\"python\" data-lang=\"python\">name</code> is not a string literal but is the key identifier for the named replacement field."
    },
    {
     "id": 1329225,
     "content_html": "<code class=\"python\" data-lang=\"python\">KeyError</code>",
     "correctness": "1.0",
     "feedback_html": "Since the string template uses a named argument, inputs are only accepted through the corresponding keys. Hence, the code generates <code class=\"python\" data-lang=\"python\">KeyError: 'name'</code>."
    },
    {
     "id": 1329226,
     "content_html": "<code class=\"python\" data-lang=\"python\">Hey Bengio!</code>",
     "correctness": "0.0",
     "feedback_html": "The string value <code class=\"python\" data-lang=\"python\">\"Bengio\"</code> is passed to the <code class=\"python\" data-lang=\"python\">format()</code> function without the name key. Python will not be able to locate the string value corresponding to the key <code class=\"python\" data-lang=\"python\">'name'</code> and results in an error."
    }
   ],
