 "questions": [
  {
   "id": 666927,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the code below, which argument maps to the parameter <code class=\"python\" data-lang=\"python\">other</code> in the call to <code class=\"python\" data-lang=\"python\">Account.__add__()</code>?\n<pre class=\"python\" data-lang=\"python\">acct_a = Account(\"Ashe\", 6492)\nacct_b = Account(\"Bevins\", 5210)\n\nacct_ab = acct_a + acct_b\n</pre>",
   "answers": [
    {
     "id": 1329788,
     "content_html": "<code class=\"python\" data-lang=\"python\">acct_a</code>",
     "correctness": "0.0",
     "feedback_html": "acct_a maps to the parameter self for the addition operation. acct_b maps to __add__'s second parameter."
    },
    {
     "id": 1329789,
     "content_html": "<code class=\"python\" data-lang=\"python\">acct_b</code>",
     "correctness": "1.0",
     "feedback_html": "The addition operation maps the left operand, <code class=\"python\" data-lang=\"python\">acct_a</code>, to the parameter <code class=\"python\" data-lang=\"python\">self</code> and the right operand, <code class=\"python\" data-lang=\"python\">acct_b</code>, to the parameter <code class=\"python\" data-lang=\"python\">other</code>."
    },
    {
     "id": 1329790,
     "content_html": "<code class=\"python\" data-lang=\"python\">acct_ab</code>",
     "correctness": "0.0",
     "feedback_html": "acct_ab is not an argument to __add__() but is assigned with the result of the call."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The addition operation maps the left operand, <code class=\"python\" data-lang=\"python\">acct_a</code>, to the parameter <code class=\"python\" data-lang=\"python\">self</code> and the right operand, <code class=\"python\" data-lang=\"python\">acct_b</code>, to the parameter <code class=\"python\" data-lang=\"python\">other</code>."
