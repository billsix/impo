 "questions": [
  {
   "id": 667049,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The programmer edits the code as follows. How can the program be improved?\n<pre class=\"python\" data-lang=\"python\">class Plant:\n&nbsp;&nbsp;def photosynth(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"Photosynthesizing\")\n\nclass Rose(Plant):\n&nbsp;&nbsp;pass\n\nclass Pitcher(Plant):\n&nbsp;&nbsp;def eat(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"Eating\")\n\nclass VenusFlyTrap(Plant)\n&nbsp;&nbsp;def eat(self):\n&nbsp;&nbsp;&nbsp;&nbsp;print(\"Eating\")\n</pre>",
   "answers": [
    {
     "id": 1330117,
     "content_html": "Move <code class=\"python\" data-lang=\"python\">photosynth()</code> into <code class=\"python\" data-lang=\"python\">Rose</code>.",
     "correctness": "0.0",
     "feedback_html": "Pitcher and VenusFlyTrap also need the photosynth() method."
    },
    {
     "id": 1330118,
     "content_html": "Remove redundancy of <code class=\"python\" data-lang=\"python\">eat()</code>.",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">eat()</code> can be moved into a mixin class included in <code class=\"python\" data-lang=\"python\">Pitcher'</code>s and <code class=\"python\" data-lang=\"python\">VenusFlyTrap'</code>s inheritance list."
    }
   ],
   "hints": [],
