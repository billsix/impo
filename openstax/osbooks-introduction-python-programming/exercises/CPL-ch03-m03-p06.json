   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What expression returns the value of an object?",
   "answers": [
    {
     "id": 1328016,
     "content_html": "<code class=\"python\" data-lang=\"python\">value(rating)</code>",
     "correctness": "0.0",
     "feedback_html": "Python does not have a built-in value() function."
    },
    {
     "id": 1328017,
     "content_html": "<code class=\"python\" data-lang=\"python\">rating</code>",
     "correctness": "1.0",
     "feedback_html": "A variable refers to an object, so the variable's value is the object's value."
    },
    {
     "id": 1328018,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"rating\"</code>",
     "correctness": "0.0",
     "feedback_html": "Putting quotes around a variable name creates a string object."
    }
