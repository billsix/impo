 "questions": [
  {
   "id": 666473,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is printed if the code is changed as follows?\n<pre class=\"python\" data-lang=\"python\">str_var = \"A string\"\n\ncount = 0\nfor c in str_var:\n&nbsp;&nbsp;count += 1\n&nbsp;&nbsp;# New line\n&nbsp;&nbsp;print(c, end = '*')\n\nprint(count)\n</pre>\n",
   "answers": [
    {
     "id": 1328472,
     "content_html": "<code class=\"python\" data-lang=\"python\">A string*</code>",
     "correctness": "0.0",
     "feedback_html": "The variable <code class=\"python\" data-lang=\"python\">c</code> will be assigned to all individual characters within the <code class=\"python\" data-lang=\"python\">str_var</code>. The print statement prints the variable <code class=\"python\" data-lang=\"python\">c</code> and a * character in each iteration. "
    },
    {
     "id": 1328473,
     "content_html": "<code class=\"python\" data-lang=\"python\">A*s*t*r*i*n*g*</code>",
     "correctness": "0.0",
     "feedback_html": "White space characters like space are considered as characters and need to be printed."
    },
    {
     "id": 1328474,
     "content_html": "<code class=\"python\" data-lang=\"python\">A* *s*t*r*i*n*g*</code>",
     "correctness": "1.0",
     "feedback_html": "The added line prints each character that is looped on (character <code class=\"python\" c< code data-lang=\"python\">), and prints an additional * after the character.</code>"
    }
   ],
