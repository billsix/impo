 "questions": [
  {
   "id": 666959,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would happen if the condition on line 4 of <code class=\"python\" data-lang=\"python\">palindrome()</code> is changed to <code class=\"python\" data-lang=\"python\">if len(word) == 1:</code>",
   "answers": [
    {
     "id": 1329872,
     "content_html": "Only palindromes with an odd number of letters would be recognized correctly.",
     "correctness": "1.0",
     "feedback_html": "When a palindrome has an even number of letters, eventually an empty string is left as pairs of letters are removed. Thus, the base case should include <code class=\"python\" data-lang=\"python\">len(word) == 0</code>, which is resolved with the condition <code class=\"python\" data-lang=\"python\">len(word) &lt;= 1</code>."
    },
    {
     "id": 1329873,
     "content_html": "Nothing. The function would work the same.",
     "correctness": "0.0",
     "feedback_html": "Changing the condition changes the base case. What would be the impact of the change?"
    },
    {
     "id": 1329874,
     "content_html": "The function would not recognize any palindromes.",
     "correctness": "0.0",
     "feedback_html": "Some palindromes will still be recognized."
    }
   ],
