 "questions": [
  {
   "id": 666483,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">range(5, 2)</code>?",
   "answers": [
    {
     "id": 1328502,
     "content_html": "<code class=\"python\" data-lang=\"python\">0, 2, 4</code>",
     "correctness": "0.0",
     "feedback_html": "When two arguments are provided to the <code class=\"python\" data-lang=\"python\">range()</code> function, the first one is the sequence's start and the second one is the sequence's end. In the given example, 5 is the start and 2 is the sequence's end, hence the sequence cannot start with a 0."
    },
    {
     "id": 1328503,
     "content_html": "<code class=\"python\" data-lang=\"python\">2, 3, 4</code>",
     "correctness": "0.0",
     "feedback_html": "The order of range arguments are important. The first argument, 5, is the sequence's start and the second, 2, is the sequence's end. Hence, the sequence cannot start with a 2."
    },
    {
     "id": 1328504,
     "content_html": "empty sequence",
     "correctness": "1.0",
     "feedback_html": "When two arguments are provided to the <code class=\"python\" data-lang=\"python\">range()</code> function, arguments are considered as <code class=\"python\" data-lang=\"python\">start</code> and <code class=\"python\" data-lang=\"python\">end</code> of the sequence, and the step size will be <code class=\"python\" data-lang=\"python\">1</code>. When step size is positive, the generated sequence will be in ascending order, and hence, <code class=\"python\" data-lang=\"python\">start</code> must be less than <code class=\"python\" data-lang=\"python\">end</code>. Otherwise, no sequence will be generated."
    }
   ],
