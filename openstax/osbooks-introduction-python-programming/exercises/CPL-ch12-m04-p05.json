 "questions": [
  {
   "id": 666979,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many recursive calls are made with <code class=\"python\" data-lang=\"python\">gcd(24, 30)</code>?",
   "answers": [
    {
     "id": 1329920,
     "content_html": "4",
     "correctness": "1.0",
     "feedback_html": "The first call <code class=\"python\" data-lang=\"python\">gcd(24, 30)</code> results in <code class=\"python\" data-lang=\"python\">30 - 24 = 6</code>, so the next call is <code class=\"python\" data-lang=\"python\">gcd(24, 6)</code>. Thereafter, other calls are <code class=\"python\" data-lang=\"python\">gcd(18, 6)</code>, <code class=\"python\" data-lang=\"python\">gcd(12, 6)</code>, and <code class=\"python\" data-lang=\"python\">gcd (6,6)</code> for a total of four recursive calls after the initial function call."
    },
    {
     "id": 1329921,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "The first call begins a recursion because a != b. How many more calls occur?"
    },
    {
     "id": 1329922,
     "content_html": "24",
     "correctness": "0.0",
     "feedback_html": "Either one of the parameters does not directly indicate how many calls may be needed."
    }
   ],
