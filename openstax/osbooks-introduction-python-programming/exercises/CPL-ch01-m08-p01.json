   "stimulus_html": "",
   "stem_html": "The Python programming language was named after a _____.",
   "answers": [
    {
     "id": 864536,
     "content_html": "British comedy group",
     "correctness": "1.0",
     "feedback_html": "The language was named after Monty Python. Just for fun, the official documentation makes subtle references to Monty Python comedy sketches."
    },
    {
     "id": 864537,
     "content_html": "Dutch programmer",
     "correctness": "0.0",
     "feedback_html": "Guido van Rossum was the creator of Python, but the programming language was not named after him."
    },
    {
     "id": 864538,
     "content_html": "non-venomous snake",
     "correctness": "0.0",
     "feedback_html": "Python's logo is based on ancient Mayan snake drawings, but the language itself was not named after snakes."
    }
