 "questions": [
  {
   "id": 666437,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How could the following statements be rewritten as a chained statement?\n<pre class=\"python\" data-lang=\"python\">if price &lt; 9.99:\n&nbsp;&nbsp;order = 50\nif 9.99 &lt;= price &lt; 19.99:\n&nbsp;&nbsp;order = 30\nif price &gt;= 19.99:\n&nbsp;&nbsp;order = 10\n</pre>",
   "answers": [
    {
     "id": 1328366,
     "content_html": "<pre class=\"python\" data-lang=\"python\">if price &lt; 9.99:\n&nbsp;&nbsp;order = 50\nelse:\n&nbsp;&nbsp;order = 30\norder = 10\n</pre>",
     "correctness": "0.0",
     "feedback_html": "Regardless of price, order is assigned with 10 after the if-else statement."
    },
    {
     "id": 1328367,
     "content_html": "<pre class=\"python\" data-lang=\"python\">if price &lt; 9.99:\n&nbsp;&nbsp;order = 50\nelif price &lt; 19.99:\n&nbsp;&nbsp;order = 30\nelif price == 19.99:\n&nbsp;&nbsp;order = 10\n</pre>",
     "correctness": "0.0",
     "feedback_html": "If price > 19.99, order should be assigned with 10, but here order is not assigned with a value."
    },
    {
     "id": 1328368,
     "content_html": "<pre class=\"python\" data-lang=\"python\">if price &lt; 9.99:\n&nbsp;&nbsp;order = 50\nelif price &lt; 19.99:\n&nbsp;&nbsp;order = 30\nelse:\n&nbsp;&nbsp;order = 10\n</pre>",
     "correctness": "1.0",
     "feedback_html": "The first branch executes if <code class=\"python\" data-lang=\"python\">price &lt; 9.99</code>. The second branch executes if <code class=\"python\" data-lang=\"python\">price &lt; 19.99</code> and the first condition fails: that is, <code class=\"python\" data-lang=\"python\">price &gt;= 9.99</code>. The third branch executes if the first and second conditions fail: that is, <code class=\"python\" data-lang=\"python\">price &gt;= 19.99</code>. Chaining can simplify decision statements."
    }
   ],
