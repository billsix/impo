 "questions": [
  {
   "id": 666683,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">a_string = \"Hello world\"\nprint(a_string[2:4])\n</pre>",
   "answers": [
    {
     "id": 1329074,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"el\"</code>",
     "correctness": "0.0",
     "feedback_html": "A slice of <code class=\"python\" data-lang=\"python\">a_string[2:4]</code> starts from character at index 2 up to and not including character at index 4. What are characters at index 2 and 3?"
    },
    {
     "id": 1329075,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"ll\"</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">a_string[2:4]</code> is a slice including the third and fourth characters, which is <code class=\"python\" data-lang=\"python\">\"ll\"</code>."
    },
    {
     "id": 1329076,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"llo\"</code>",
     "correctness": "0.0",
     "feedback_html": "A slice of <code class=\"python\" data-lang=\"python\">a_string[2:4]</code> starts from character at index 2 up to and not including character at index 4. Character <code class=\"python\" data-lang=\"python\">\"o\"</code> is at index 4."
    }
   ],
