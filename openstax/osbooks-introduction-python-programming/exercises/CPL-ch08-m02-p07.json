 "questions": [
  {
   "id": 666689,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct way of replacing the first character in a string to character \"*\" in a new string?",
   "answers": [
    {
     "id": 1329092,
     "content_html": "<pre class=\"python\" data-lang=\"python\">x = \"string\"\nx[0] = \"*\"\n</pre>",
     "correctness": "0.0",
     "feedback_html": "Since strings are immutable, modifying a character is not allowed and will result in a <code class=\"python\" data-lang=\"python\">TypeError</code>. "
    },
    {
     "id": 1329093,
     "content_html": "<pre class=\"python\" data-lang=\"python\">x = \"string\"\nx = \"*\" + x[1:]\n</pre>",
     "correctness": "1.0",
     "feedback_html": "To modify string content, a new variable must be created with desired modifications."
    },
    {
     "id": 1329094,
     "content_html": "<pre class=\"python\" data-lang=\"python\">x = \"string\"\nx = \"*\" + x\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The variable <code class=\"python\" data-lang=\"python\">x</code> equals <code class=\"python\" data-lang=\"python\">*string</code>. The question asks for replacing the first character in string variable <code class=\"python\" data-lang=\"python\">x</code> with \"*\"."
    }
   ],
