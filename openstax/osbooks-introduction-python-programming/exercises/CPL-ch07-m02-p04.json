 "questions": [
  {
   "id": 666625,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A program begins with <code class=\"python\" data-lang=\"python\">from area import square, circle</code>.\nWhat code causes a name collision?\n",
   "answers": [
    {
     "id": 1328912,
     "content_html": "<pre class=\"python\" data-lang=\"python\">def area(phone):\n&nbsp;&nbsp;\"\"\"Gets the area code of a phone number.\"\"\"\n</pre>",
     "correctness": "0.0",
     "feedback_html": "This statement defines a function that does not collide with the area module.\nThe import statement defined only square and circle."
    },
    {
     "id": 1328913,
     "content_html": "<pre class=\"python\" data-lang=\"python\">def circle(x, y, size):\n&nbsp;&nbsp;\"\"\"Draws a circle centered at (x, y).\"\"\"\n</pre>",
     "correctness": "1.0",
     "feedback_html": "This statement replaces the previously imported circle function,\neven though <code class=\"python\" data-lang=\"python\">circle()</code> and <code class=\"python\" data-lang=\"python\">area.circle()</code> have different parameters."
    },
    {
     "id": 1328914,
     "content_html": "<pre class=\"python\" data-lang=\"python\">def is_square(length, width):\n&nbsp;&nbsp;\"\"\"Returns True if length and width are equal.\"\"\"\n</pre>",
     "correctness": "0.0",
     "feedback_html": "The is_square function has a unique name.\nThe import statement did not define the name is_square."
    }
   ],
   "hints": [],
