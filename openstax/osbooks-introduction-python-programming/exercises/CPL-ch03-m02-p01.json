   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">animal = \"dog\"\nsays = \"bark\"\nprint(f\"My {animal} says {says} {says} {says}\")\n</pre>",
   "answers": [
    {
     "id": 1327962,
     "content_html": "<code class=\"python\" data-lang=\"python\">My dog bark bark bark bark</code>",
     "correctness": "0.0",
     "feedback_html": "The first instance of \"says\" in the f-string is a literal word, not a replacement field."
    },
    {
     "id": 1327963,
     "content_html": "<code class=\"python\" data-lang=\"python\">My dog says bark bark bark</code>",
     "correctness": "1.0",
     "feedback_html": "The same variable, <code class=\"python\" data-lang=\"python\">says</code>, is used in three replacement fields."
