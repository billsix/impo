   "id": 666649,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What code would return a darker shade of blue?",
   "answers": [
    {
     "id": 1328978,
     "content_html": "<code class=\"python\" data-lang=\"python\">darken(BLUE)</code>",
     "correctness": "0.0",
     "feedback_html": "The darken function is defined in the colors module, not the main program."
    },
    {
     "id": 1328979,
     "content_html": "<code class=\"python\" data-lang=\"python\">colors.darken(BLUE)</code>",
     "correctness": "0.0",
     "feedback_html": "The BLUE variable is defined in the colors module, not the main program."
    },
    {
     "id": 1328980,
     "content_html": "<code class=\"python\" data-lang=\"python\">colors.darken(colors.BLUE)</code>",
     "correctness": "1.0",
     "feedback_html": "Both the <code class=\"python\" data-lang=\"python\">darken</code> function and the <code class=\"python\" data-lang=\"python\">BLUE</code> variable must be accessed via the <code class=\"python\" data-lang=\"python\">colors</code> variable."
    }
   ],
