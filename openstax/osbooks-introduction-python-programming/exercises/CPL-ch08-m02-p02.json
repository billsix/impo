 "questions": [
  {
   "id": 666679,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the character at index -2 in the string <code class=\"python\" data-lang=\"python\">\"Blue\"</code>?",
   "answers": [
    {
     "id": 1329064,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"e\"</code>",
     "correctness": "0.0",
     "feedback_html": "Negative indexing starts from right to left starting from -1. As such, \"e\" is at index -1. What is the character at index -2?"
    },
    {
     "id": 1329065,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"u\"</code>",
     "correctness": "1.0",
     "feedback_html": "Since negative indexing starts from -1 from the right of the string to the left, <code class=\"python\" data-lang=\"python\">\"u\"</code> is at index -2."
    },
    {
     "id": 1329066,
     "content_html": "<code class=\"python\" data-lang=\"python\">\"l\"</code>",
     "correctness": "0.0",
     "feedback_html": "Negative indexing starts from the right to the left of the string. The last character (\"e\") is indexed as -1, \"u\" is indexed as -2, and \"l\" is indexed as -3."
    }
   ],
