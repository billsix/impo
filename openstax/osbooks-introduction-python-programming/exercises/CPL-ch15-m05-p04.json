 "questions": [
  {
   "id": 667147,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following code, which of the function calls is appropriate in showing association between <code class=\"python\" data-lang=\"python\">x</code> and <code class=\"python\" data-lang=\"python\">y</code>?\n<pre class=\"python\" data-lang=\"python\">import matplotlib.pyplot as plt\n\n# Data\nx = [1, 2, 3, 4, 5]\ny = [10, 15, 12, 18, 20]\n</pre>",
   "answers": [
    {
     "id": 1330402,
     "content_html": "<code class=\"python\" data-lang=\"python\">plt.boxplot(x)</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">plt.boxplot(x)</code> visualizes the distribution of the variable <code class=\"python\" data-lang=\"python\">x</code> and does not visualize the relationship between the two variables <code class=\"python\" data-lang=\"python\">x</code> and <code>y</code>."
    },
    {
     "id": 1330403,
     "content_html": "<code class=\"python\" data-lang=\"python\">plt.hist(y)</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">plt.hist(y)</code> visualizes the distribution of the variable <code class=\"python\" data-lang=\"python\">y</code> and does not visualize the relationship between the two variables <code class=\"python\" data-lang=\"python\">x</code> and <code class=\"python\" data-lang=\"python\">y</code>."
    },
    {
     "id": 1330404,
     "content_html": "<code class=\"python\" data-lang=\"python\">plt.scatter(x, y)</code>",
     "correctness": "1.0",
     "feedback_html": "The function call <code class=\"python\" data-lang=\"python\">plt.scatter(x, y)</code> creates a scatter plot based on the data stored in the variables <code class=\"python\" data-lang=\"python\">x</code> and <code class=\"python\" data-lang=\"python\">y</code>."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
