 "questions": [
  {
   "id": 666034,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which expression returns the integer <span class=\"purple-code\">27</span>?",
   "answers": [
    {
     "id": 1327854,
     "content_html": "<code class=\"python\" data-lang=\"python\">3 ** 3</code>",
     "correctness": "1.0",
     "feedback_html": "When given integers, the ** operator returns an integer result."
    },
    {
     "id": 1327855,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.0 ** 3</code>",
     "correctness": "0.0",
     "feedback_html": "When given a float, the ** operator returns a float result. So 3.0 ** 3 returns <span class=\"purple-code\">27.0</span>, not the integer <span class=\"purple-code\">27</span>."
    },
    {
     "id": 1327856,
     "content_html": "<code class=\"python\" data-lang=\"python\">math.pow(3, 3)</code>",
     "correctness": "0.0",
     "feedback_html": "The math.pow() function converts the numbers to floats. So math.pow(3, 3) returns <span class=\"purple-code\">27.0</span>, not the integer <span class=\"purple-code\">27</span>."
    }
   ],
