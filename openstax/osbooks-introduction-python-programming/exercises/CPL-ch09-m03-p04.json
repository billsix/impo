 "questions": [
  {
   "id": 666787,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct way to sort the list <code class=\"python\" data-lang=\"python\">board_games</code> in ascending order?",
   "answers": [
    {
     "id": 1329380,
     "content_html": "<code class=\"python\" data-lang=\"python\">sort(board_games)</code>",
     "correctness": "0.0",
     "feedback_html": "The sort() function must be applied on the list."
    },
    {
     "id": 1329381,
     "content_html": "<code class=\"python\" data-lang=\"python\">board_games.sort()</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">sort()</code> function must be applied on the list. The default for the <code class=\"python\" data-lang=\"python\">sort()</code> function is to arrange elements in ascending order."
    },
    {
     "id": 1329382,
     "content_html": "<code class=\"python\" data-lang=\"python\">board_games.sort('ascending')</code>",
     "correctness": "0.0",
     "feedback_html": "The sort() function arranges elements in a specific order by default."
    }
   ],
