   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would be the output of <code class=\"python\" data-lang=\"python\">emp_1.dev_display()</code>?",
   "answers": [
    {
     "id": 1330018,
     "content_html": "<code class=\"python\" data-lang=\"python\">Employee 1 hired in 2023</code>",
     "correctness": "0.0",
     "feedback_html": "This is the output of emp_1.emp_display(). dev_display() is a Developer method, and emp_1 is not a Developer instance."
    },
    {
     "id": 1330019,
     "content_html": "<code class=\"python\" data-lang=\"python\">Proficient in ['Python', 'C++', 'Java']</code>",
     "correctness": "0.0",
     "feedback_html": "emp_1 is an Employee instance not a Developer instance. Can emp_1 access dev_display()?"
    },
    {
     "id": 1330020,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">dev_display()</code> is a <code class=\"python\" data-lang=\"python\">Developer</code> method. <code class=\"python\" data-lang=\"python\">emp_1</code> is not a <code class=\"python\" data-lang=\"python\">Developer</code> instance, so <code class=\"python\" data-lang=\"python\">emp_1</code> cannot access <code class=\"python\" data-lang=\"python\">dev_display()</code>."
    }
