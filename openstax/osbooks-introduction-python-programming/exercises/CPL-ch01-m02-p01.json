 "questions": [
  {
   "id": 665775,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which line of code prints <code>Hello world!</code> as one line of output?",
   "answers": [
    {
     "id": 1327366,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(Hello world!)</code>",
     "correctness": "0.0",
     "feedback_html": "The output must be enclosed in quote marks."
    },
    {
     "id": 1327367,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Hello\", \"world\", \"!\")</code>",
     "correctness": "0.0",
     "feedback_html": "Multiple items are automatically separated by spaces. So, this code would output <code>Hello world !</code> with a space before the exclamation point."
    },
    {
     "id": 1327368,
     "content_html": "<code class=\"python\" data-lang=\"python\">print(\"Hello world!\")</code>",
     "correctness": "1.0",
     "feedback_html": "The hello world program is just one line of code."
    }
