 "questions": [
  {
   "id": 666869,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which conditional statement checks if the value associated with the key <code class=\"python\" data-lang=\"python\">\"pomegranate\"</code> is greater than <code class=\"python\" data-lang=\"python\">0</code>?",
   "answers": [
    {
     "id": 1329616,
     "content_html": "<code class=\"python\" data-lang=\"python\">fruit_count(\"pomegranate\") &gt; 0</code>",
     "correctness": "0.0",
     "feedback_html": "Accessing values in a dictionary can be done through the square bracket notation or <code class=\"python\" data-lang=\"python\">get()</code> method."
    },
    {
     "id": 1329617,
     "content_html": "<code class=\"python\" data-lang=\"python\">fruit_count[\"pomegranate\"] &gt; 0</code>",
     "correctness": "1.0",
     "feedback_html": "Conditional statements can be written to examine keys and values."
    },
    {
     "id": 1329618,
     "content_html": "<code class=\"python\" data-lang=\"python\">fruit_count.get(\"pomegranate\" &gt; 0)</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">get()</code> method only accepts a key and an optional value that is returned if the key is not found. The return value of the <code class=\"python\" data-lang=\"python\">get()</code> method is the value associated with the key and conditionals can be applied to the returned value."
    }
   ],
