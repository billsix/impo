 "questions": [
  {
   "id": 666202,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the best way to print a very long string?",
   "answers": [
    {
     "id": 1327908,
     "content_html": "Break up the string into multiple smaller strings.\n<pre class=\"python\" data-lang=\"python\">print(\"...\" # first part of string\n\"...\" # next part of string\n\"...\")</pre>",
     "correctness": "1.0",
     "feedback_html": "Using one print statement with parentheses joins the lines implicitly and does not increase the number of statements."
    },
    {
     "id": 1327909,
     "content_html": "Print the string using multiple print statements.\n<pre class=\"python\" data-lang=\"python\">print(\"...\") # first part of string\nprint(\"...\") # next part of string\nprint(\"...\")</pre>",
     "correctness": "0.0",
     "feedback_html": "This is one way to print a long string, but is less efficient, because print needs to run multiple times."
    },
    {
     "id": 1327910,
     "content_html": "Assign the string to a variable and print the variable.\n<pre class=\"python\" data-lang=\"python\">text = \"...\" # the entire string\nprint(text)\n</pre>",
     "correctness": "0.0",
     "feedback_html": "Assigning the string to a variable still results in a very long line of code."
    }
   ],
