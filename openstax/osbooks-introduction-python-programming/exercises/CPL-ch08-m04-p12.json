 "questions": [
  {
   "id": 666747,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print('{:+d}'.format(123))</code>?",
   "answers": [
    {
     "id": 1329266,
     "content_html": "<code class=\"python\" data-lang=\"python\">123</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">{:+d}</code> modifies the decimal number and adds the positive sign. What is the output of <code class=\"python\" data-lang=\"python\">'{:+d}'.format(123)</code>?"
    },
    {
     "id": 1329267,
     "content_html": "<code class=\"python\" data-lang=\"python\">+123</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">{:+d}</code> formats the decimal number by adding the positive sign."
    },
    {
     "id": 1329268,
     "content_html": "<code class=\"python\" data-lang=\"python\">:+123</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">':'</code> character is used to separate the replacement field identifier and format specification, and <code class=\"python\" data-lang=\"python\">':'</code> will not be a part of the output."
    }
   ],
