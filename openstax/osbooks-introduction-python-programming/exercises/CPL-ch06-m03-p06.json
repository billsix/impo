 "questions": [
  {
   "id": 666551,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which functions directly access <code class=\"python\" data-lang=\"python\">out_str</code>?\n<pre class=\"python\" data-lang=\"python\">def print_greeting():\n&nbsp;&nbsp;print(\"Good day,\")\n&nbsp;&nbsp;print_time()\n\ndef print_time():\n&nbsp;&nbsp;out_str = \"Time is \" + str(hour) + \":\" + str(min)\n&nbsp;&nbsp;print(out_str)\n\nhour = int(input())\nmin = int(input())\nprint_greeting()\n</pre>",
   "answers": [
    {
     "id": 1328706,
     "content_html": "<code class=\"python\" data-lang=\"python\">print_greeting()</code>",
     "correctness": "0.0",
     "feedback_html": "print_time() creates out_str. out_str is out of scope in print_greeting() and cannot be accessed directly."
    },
    {
     "id": 1328707,
     "content_html": "<code class=\"python\" data-lang=\"python\">print_time()</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">print_time()</code> creates <code class=\"python\" data-lang=\"python\">out_str</code> as a local variable. <code class=\"python\" data-lang=\"python\">out_str</code> is only in scope in <code class=\"python\" data-lang=\"python\">print_time()</code> and cannot be accessed elsewhere."
    },
    {
     "id": 1328708,
     "content_html": "<code class=\"python\" data-lang=\"python\">print_greeting()</code> and <code class=\"python\" data-lang=\"python\">print_time()</code>",
     "correctness": "0.0",
     "feedback_html": "out_str is local to print_time(), so print_greeting() cannot access out_str directly."
    }
   ],
   "hints": [],
