 "questions": [
  {
   "id": 666417,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given <code class=\"python\" data-lang=\"python\">x = 8</code> and <code class=\"python\" data-lang=\"python\">y = 9</code>, what is the result of the following? <br>\n<code class=\"python\" data-lang=\"python\">x + 3 * y - 5</code>\n",
   "answers": [
    {
     "id": 1328302,
     "content_html": "<code class=\"python\" data-lang=\"python\">30</code>",
     "correctness": "1.0",
     "feedback_html": "The expression is evaluated as <code class=\"python\" data-lang=\"python\">x + (3*y) - 5. 8 + (3*9) - 5 = 30</code>."
    },
    {
     "id": 1328303,
     "content_html": "<code class=\"python\" data-lang=\"python\">44</code>",
     "correctness": "0.0",
     "feedback_html": "Addition and subtraction have lower precedence than multiplication."
    },
    {
     "id": 1328304,
     "content_html": "<code class=\"python\" data-lang=\"python\">94</code>",
     "correctness": "0.0",
     "feedback_html": "94 is the result of ((x+3) * y) - 5. But multiplication has the highest precedence in the expression."
    }
   ],
