   "id": 666993,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the relationship between a <code class=\"python\" data-lang=\"python\">Doughnut</code> class and a <code class=\"python\" data-lang=\"python\">Pastry</code> class?",
   "answers": [
    {
     "id": 1329957,
     "content_html": "is-a",
     "correctness": "1.0",
     "feedback_html": "A doughnut is a type of pastry, so <code class=\"python\" data-lang=\"python\">Doughnut</code> inherits from <code class=\"python\" data-lang=\"python\">Pastry</code>."
    },
    {
     "id": 1329958,
     "content_html": "has-a",
     "correctness": "0.0",
     "feedback_html": "A doughnut does not have a pastry. Pastry is the superclass for a Doughnut class."
    }
   ],
