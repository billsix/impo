 "questions": [
  {
   "id": 361787,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the points were changed from floats to integers, how many statements would need to be changed in the original and revised programs respectively?",
   "answers": [
    {
     "id": 874002,
     "content_html": "3, 1",
     "correctness": "0.0",
     "feedback_html": "The original code reads in three pairs of points, and each point has an x and y coordinate. So 3*4 changes would be needed. The revised has code reads in each pair in a loop, so only 2*2 changes would be needed."
    },
    {
     "id": 874003,
     "content_html": "4, 4",
     "correctness": "0.0",
     "feedback_html": "The original program repeats four input statements for a total of 12 statements to read in pairs of points. The revised program has four input statements that are reused with function calls."
    },
    {
     "id": 874004,
     "content_html": "12, 4",
     "correctness": "1.0",
     "feedback_html": "Each calculation uses four statements to read in the x,y values of a pair of points. The original program performs three calculations by repeating code for a total of 12 input statements. The revised program performs three calculations by executing the four input statements multiple times with function calls."
    }
   ],
