 "questions": [
  {
   "id": 392020,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are the benefits of Pandas over NumPy?",
   "answers": [
    {
     "id": 920082,
     "content_html": "Pandas provides integration with other libraries.",
     "correctness": "0.0",
     "feedback_html": "NumPy also provides integration with other data science libraries."
    },
    {
     "id": 920083,
     "content_html": "Pandas supports heterogeneous data whereas NumPy supports homogenous numerical data.",
     "correctness": "1.0",
     "feedback_html": "The Pandas DataFrame can store columns of varying data types, while NumPy only supports numeric data types."
    },
    {
     "id": 920084,
     "content_html": "Pandas supports both one-dimensional and two-dimensional data structures.",
     "correctness": "0.0",
     "feedback_html": "NumPy array can be 1-dimensional or multidimensional."
    }
   ],
