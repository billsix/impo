   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How many classes can be in a module?",
   "answers": [
    {
     "id": 919588,
     "content_html": "none",
     "correctness": "0.0",
     "feedback_html": "Classes exist in modules and can be imported easily to other programs."
    },
    {
     "id": 919589,
     "content_html": "only 1",
     "correctness": "0.0",
     "feedback_html": "A module can contain multiple classes, and the classes can be imported individually or all together."
    },
    {
     "id": 919590,
     "content_html": "any number",
     "correctness": "1.0",
     "feedback_html": "The number of classes in a module is unlimited, but classes should be grouped in modules to maximize reusability."
    }
