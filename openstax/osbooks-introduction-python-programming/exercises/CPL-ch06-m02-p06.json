 "questions": [
  {
   "id": 666539,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When line 3 is reached and executed, which line does control flow return to?",
   "answers": [
    {
     "id": 1328670,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "print_conf() finishes and does not repeat until called again. Control flow returns to the line in print_book_club() that called print_conf()."
    },
    {
     "id": 1328671,
     "content_html": "11",
     "correctness": "1.0",
     "feedback_html": "Control flow returns to line 11, which called <code class=\"python\" data-lang=\"python\">print_conf()</code>. Then <code class=\"python\" data-lang=\"python\">print_book_club()</code> finishes, and control flow returns to line 16, which called <code class=\"python\" data-lang=\"python\">print_book_club()</code>."
    },
    {
     "id": 1328672,
     "content_html": "16",
     "correctness": "0.0",
     "feedback_html": "print_conf() was called by print_book_club(), so control flow returns to the line in print_book_club() that called print_conf()."
    }
   ],
