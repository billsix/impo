   "stem_html": "Which expression results in an error?",
   "answers": [
    {
     "id": 1327830,
     "content_html": "<code class=\"python\" data-lang=\"python\">math.abs(1)</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">abs()</code> is a built-in function. The math module does not have an <code class=\"python\" data-lang=\"python\">abs()</code> function."
    },
    {
     "id": 1327831,
     "content_html": "<code class=\"python\" data-lang=\"python\">math.log(1)</code>",
     "correctness": "0.0",
     "feedback_html": "The value of math.log(1) is 0.0, not an error."
    },
