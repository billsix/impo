   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the assignment operator?",
   "answers": [
    {
     "id": 1327414,
     "content_html": "<code class=\"python\" data-lang=\"python\">:</code>",
     "correctness": "0.0",
     "feedback_html": "The colon is not used as the assignment operator."
    },
    {
     "id": 1327415,
     "content_html": "<code class=\"python\" data-lang=\"python\">==</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">==</code> is the equality operator, not the assignment operator."
    },
    {
     "id": 1327416,
     "content_html": "<code class=\"python\" data-lang=\"python\">=</code>",
     "correctness": "1.0",
     "feedback_html": "The single <code class=\"python\" data-lang=\"python\">=</code> character is the assignment operator."
    }
