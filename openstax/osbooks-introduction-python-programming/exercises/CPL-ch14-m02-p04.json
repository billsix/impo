   "stimulus_html": "",
   "stem_html": "<pre class=\"python\" data-lang=\"python\">outfile = open(\"resources.txt\", 'w')\noutfile.write(\"new content\")</pre>",
   "answers": [
    {
     "id": 1330178,
     "content_html": "nothing",
     "correctness": "0.0",
     "feedback_html": "The open() statement in write mode will overwrite the existing resources.txt file."
    },
    {
     "id": 1330179,
     "content_html": "The contents of the <i>resources.txt file</i> is overwritten with the line <code class=\"python\" data-lang=\"python\">\"new content\"</code>.",
     "correctness": "0.0",
     "feedback_html": "Until close() is used the state of the file is uncertain."
    },
    {
     "id": 1330180,
     "content_html": "The <i>resources.txt</i> file is overwritten, but the contents of <i>resources.txt</i> are uncertain.",
     "correctness": "1.0",
     "feedback_html": "<i>resources.txt</i> is likely empty, but the state of <i>resources.txt</i> is uncertain. To ensure the contents are saved correctly, the <code class=\"python\" data-lang=\"python\">close()</code> function must be used."
    }
