 "questions": [
  {
   "id": 666529,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which line is executed first?\n<pre class=\"python line-numbering\" data-lang=\"python\">def park_greet():\n&nbsp;&nbsp;\"\"\"Output greeting.\"\"\"\n&nbsp;&nbsp;print(\"Welcome. Open sunrise to sunset.\")\n\ncar_count = 1\npark_greet()\nif car_count &gt; 50:\n&nbsp;&nbsp;# Direct to extra parking lot\n</pre>",
   "answers": [
    {
     "id": 1328640,
     "content_html": "1",
     "correctness": "0.0",
     "feedback_html": "Execution does not always start at line 1. park_greet() is not executed until called, so control flow begins at the main program, which is not indented."
    },
    {
     "id": 1328641,
     "content_html": "3",
     "correctness": "0.0",
     "feedback_html": "Line 3 is the first statement of park_greet(), which is not executed until called. Control flow begins at the main program, which is not indented."
    },
    {
     "id": 1328642,
     "content_html": "5",
     "correctness": "1.0",
     "feedback_html": "Line 5 is the start of the main program, which is not indented. <code class=\"python\" data-lang=\"python\">park_greet()</code> is called on line 6 and executed."
    }
   ],
