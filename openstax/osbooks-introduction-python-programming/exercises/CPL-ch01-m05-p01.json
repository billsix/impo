  {
   "id": 665851,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">print(x, type(x))</pre>",
   "answers": [
    {
     "id": 1327516,
     "content_html": "<code class=\"python\" data-lang=\"python\">1 'int'</code>.",
     "correctness": "0.0",
     "feedback_html": "When printing the type of an integer value, the output is <code class=\"python\" data-lang=\"python\">&lt;class 'int'&gt;</code>."
    },
    {
     "id": 1327517,
     "content_html": "<code class=\"python\" data-lang=\"python\">1.0 &lt;class 'float'&gt;</code>.",
     "correctness": "0.0",
     "feedback_html": "x = 1 is a whole number and therefore is an integer type."
    },
    {
     "id": 1327518,
     "content_html": "<code class=\"python\" data-lang=\"python\">1 &lt;class 'int'&gt;</code>.",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">x = 1</code> is an integer, and when printing the type of an integer variable, the output is <code class=\"python\" data-lang=\"python\">&lt;class 'int'&gt;</code>."
    }
   ],
