   "stem_html": "What are the components of the color YELLOW?",
   "answers": [
    {
     "id": 1328972,
     "content_html": "red=0, green=255, blue=255",
     "correctness": "0.0",
     "feedback_html": "In hexadecimal, these values are #00FFFF, which is Aqua or Cyan (not defined in colors.py)."
