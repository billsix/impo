 "questions": [
  {
   "id": 667139,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following results in selecting the second and fourth rows of the DataFrame?",
   "answers": [
    {
     "id": 1330378,
     "content_html": "<code class=\"python\" data-lang=\"python\">df[df.loc[:, \"A\"] % 2 == 0]</code>",
     "correctness": "1.0",
     "feedback_html": "The condition returns all rows where the value in the column with label A is divisible by 2."
    },
    {
     "id": 1330379,
     "content_html": "<code class=\"python\" data-lang=\"python\">df[df[:, \"A\"] % 2 == 0]</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">df[:, \"A\"]</code> is an invalid indexing. How do we select all rows in column with label A?"
    },
    {
     "id": 1330380,
     "content_html": "<code class=\"python\" data-lang=\"python\">df[df.loc[\"A\"] % 2 == 0]</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">df.loc[\"A\"]</code> is an invalid indexing. To select columns, row index must be specified or the operator <code>:</code> is passed."
    }
   ],
