 "questions": [
  {
   "id": 667065,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To read <i>logfile.txt</i>, which of the following lines of code works best?",
   "answers": [
    {
     "id": 1330160,
     "content_html": "<code class=\"python\" data-lang=\"python\">logfile = open(\"logfile.txt\")</code>",
     "correctness": "1.0",
     "feedback_html": "The default mode for the <code class=\"python\" data-lang=\"python\">open()</code> function is read."
    },
    {
     "id": 1330161,
     "content_html": "<code class=\"python\" data-lang=\"python\">logfile = open(\"logfile.txt\", 'w')</code>",
     "correctness": "0.0",
     "feedback_html": "'w' indicates write mode. The existing file will be overwritten and is not applicable when one wants to review a file."
    },
    {
     "id": 1330162,
     "content_html": "<code class=\"python\" data-lang=\"python\">logfile = open(\"logfile.txt\", 'a')</code>",
     "correctness": "0.0",
     "feedback_html": "'a' indicates append mode. The existing file can be read from but this mode is used when someone is seeking to add content to a file."
    }
   ],
