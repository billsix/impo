 "questions": [
  {
   "id": 666717,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">\"b\".find(\"banana\")</code>?",
   "answers": [
    {
     "id": 1329176,
     "content_html": "<code class=\"python\" data-lang=\"python\">-1</code>",
     "correctness": "1.0",
     "feedback_html": "Since <code class=\"python\" data-lang=\"python\">\"banana\"</code> is not a substring of <code class=\"python\" data-lang=\"python\">\"b\"</code>, <code class=\"python\" data-lang=\"python\">-1</code> is returned."
    },
    {
     "id": 1329177,
     "content_html": "<code class=\"python\" data-lang=\"python\">0</code>",
     "correctness": "0.0",
     "feedback_html": "In the expression <code class=\"python\" data-lang=\"python\">X.find(Y)</code>, the index for the first occurrence of Y in X is returned. In the given expression, \"banana\" is not a substring of \"b\". "
    },
    {
     "id": 1329178,
     "content_html": "<code class=\"python\" data-lang=\"python\">ValueError</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">find()</code> function does not return a ValueError when the substring is not found in the given string. Instead, the function returns -1."
    }
   ],
