 "questions": [
  {
   "id": 666727,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(\"{}:{}\".format(\"One\", \"1\"))</code>?",
   "answers": [
    {
     "id": 1329206,
     "content_html": "<code class=\"python\" data-lang=\"python\">One1</code>",
     "correctness": "0.0",
     "feedback_html": "The string template is only changed at the replacement fields. Other characters in the string must remain the same. In the given template the colon between the two replacement fields must remain in the final string output."
    },
    {
     "id": 1329207,
     "content_html": "<code class=\"python\" data-lang=\"python\">One:1</code>",
     "correctness": "1.0",
     "feedback_html": "The two arguments are passed to the template <code class=\"python\" data-lang=\"python\">\"{}:{}\"</code> that outputs <code class=\"python\" data-lang=\"python\">\"One:1\"</code>."
    },
    {
     "id": 1329208,
     "content_html": "<code class=\"python\" data-lang=\"python\">1:One</code>",
     "correctness": "0.0",
     "feedback_html": "The arguments to the <code class=\"python\" data-lang=\"python\">format()</code> function are passed in the same order to the template. Hence, the first replacement field must take <code class=\"python\" data-lang=\"python\">\"One\"</code> and the second takes <code class=\"python\" data-lang=\"python\">\"1\"</code>. What is the output?"
    }
   ],
   "hints": [],
