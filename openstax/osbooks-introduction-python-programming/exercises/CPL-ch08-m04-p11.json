 "questions": [
  {
   "id": 666745,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print('{:1&gt;3d}'.format(3))</code>?",
   "answers": [
    {
     "id": 1329260,
     "content_html": "<code class=\"python\" data-lang=\"python\">113</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">{:1&gt;3d}</code> specification outputs a 3-digit number in the output, and if the given argument does not have three digits, the number will be padded with 1's from the left side."
    },
    {
     "id": 1329261,
     "content_html": "<code class=\"python\" data-lang=\"python\">311</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">{:1&gt;3d}</code> specification outputs a 3-digit number in the output. The <code class=\"python\" data-lang=\"python\">\"&gt;\"</code> specifier pads the decimal number from the left side, and not the right side."
    },
    {
     "id": 1329262,
     "content_html": "<code class=\"python\" data-lang=\"python\">3.000</code>",
     "correctness": "0.0",
     "feedback_html": "The decimal number formatting does not add decimal places."
    }
   ],
