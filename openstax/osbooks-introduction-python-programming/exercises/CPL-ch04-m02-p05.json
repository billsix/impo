  {
   "id": 666375,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given input <code class=\"python\" data-lang=\"python\">10</code>, what is the final value of <code class=\"python\" data-lang=\"python\">positive_num</code>?\n<pre class=\"python\" data-lang=\"python\">positive_num = int(input(\"Enter a positive number:\"))\nif positive_num &lt; 0:\n&nbsp;&nbsp;print(\"Negative input set to 0\")\npositive_num = 0\n</pre>",
   "answers": [
    {
     "id": 1328194,
     "content_html": "<code class=\"python\" data-lang=\"python\">10</code>",
     "correctness": "0.0",
     "feedback_html": "Line 4 is meant to be in the body but isn't indented. positive_num = 0 is executed even though 10 &lt; 0 is False."
    },
    {
     "id": 1328195,
     "content_html": "<code class=\"python\" data-lang=\"python\">0</code>",
     "correctness": "1.0",
     "feedback_html": "Line 4 is not indented, so <code class=\"python\" data-lang=\"python\">positive_num</code> is always assigned with <code class=\"python\" data-lang=\"python\">0</code>. The positive input value is lost."
    },
    {
     "id": 1328196,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "Lines 3 and 4 are supposed to be in the body, but only line 3 is indented. The body is not empty though, so the program does not produce an error."
    }
   ],
