 "questions": [
  {
   "id": 666109,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which expression is formatted properly?",
   "answers": [
    {
     "id": 1327878,
     "content_html": "<code class=\"python\" data-lang=\"python\">b**2 - 4*a*c</code>",
     "correctness": "1.0",
     "feedback_html": "The expressions <code class=\"python\" data-lang=\"python\">b**2</code> and <code class=\"python\" data-lang=\"python\">4*a*c</code> are evaluated first. Adding space around the <code>-</code> operator makes the order of operations more readable."
    },
    {
     "id": 1327879,
     "content_html": "<code class=\"python\" data-lang=\"python\">b ** 2 - 4 * a * c</code>",
     "correctness": "0.0",
     "feedback_html": "The spacing looks consistent, but the order of operations is difficult to read. PEP 8 recommends removing spaces around operators with higher precedence."
    },
    {
     "id": 1327880,
     "content_html": "<code class=\"python\" data-lang=\"python\">b**2 - 4*a * c</code>",
     "correctness": "0.0",
     "feedback_html": "The spacing of <code class=\"python\" data-lang=\"python\">4*a * c</code> is inconsistent. Both of the <code class=\"python\" data-lang=\"python\">*</code> operators should have the same spacing. Furthermore, <code class=\"python\" data-lang=\"python\">-</code> and <code class=\"python\" data-lang=\"python\">*</code> should have different spacing."
    }
   ],
