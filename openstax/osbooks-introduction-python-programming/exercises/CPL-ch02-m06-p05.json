  {
   "id": 665994,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the value of <code class=\"python\" data-lang=\"python\">math.sqrt(100)</code>?",
   "answers": [
    {
     "id": 1327842,
     "content_html": "the float <code class=\"python\" data-lang=\"python\">10.0</code>",
     "correctness": "1.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">math.sqrt()</code> function returns a float, even when given an integer."
    },
    {
     "id": 1327843,
     "content_html": "the integer <code class=\"python\" data-lang=\"python\">10</code>",
     "correctness": "0.0",
     "feedback_html": "The math.sqrt() function returns a float, even when given an integer."
    },
    {
     "id": 1327844,
     "content_html": "<code class=\"python\" data-lang=\"python\">ValueError: math domain error</code>",
     "correctness": "0.0",
     "feedback_html": "The square root of 100 is 10, not a math domain error. In contrast, <code class=\"python\" data-lang=\"python\">math.sqrt(-100)</code> would be a math domain error."
    }
   ],
