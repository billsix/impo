 "questions": [
  {
   "id": 389719,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A programmer wants to create a sequence of constants for easy reference that can't be changed anywhere in the program. Which sequence would be the most appropriate?",
   "answers": [
    {
     "id": 918084,
     "content_html": "list",
     "correctness": "0.0",
     "feedback_html": "Lists are mutable and can be changed without errors. Using a list would allow accidental changes to the constants and make mistakes harder to find."
    },
    {
     "id": 918085,
     "content_html": "tuple",
     "correctness": "1.0",
     "feedback_html": "Tuples are immutable, so attempted changes produce errors. Using a tuple would protect the constants from accidental changes."
    }
   ],
   "hints": [],
