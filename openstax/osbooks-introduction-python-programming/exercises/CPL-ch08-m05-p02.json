 "questions": [
  {
   "id": 666751,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of <code class=\"python\" data-lang=\"python\">print(\"a year includes 12 months\".split())</code>?",
   "answers": [
    {
     "id": 1329278,
     "content_html": "<code class=\"python\" data-lang=\"python\">[\"a year includes 12 months\"]</code>",
     "correctness": "0.0",
     "feedback_html": "When no argument is passed to the <code class=\"python\" data-lang=\"python\">split()</code> function, the default delimiters will be all white space characters. What should be the output of splitting <code class=\"python\" data-lang=\"python\">\"a year includes 12 months\"</code> using white space characters?"
    },
    {
     "id": 1329279,
     "content_html": "<code class=\"python\" data-lang=\"python\">[\"a\", \"year\", \"includes\", 12, \"months\"]</code>",
     "correctness": "0.0",
     "feedback_html": "The output for the <code class=\"python\" data-lang=\"python\">split()</code> function is a list of string values. <code class=\"python\" data-lang=\"python\">12</code> is an integer type."
    },
    {
     "id": 1329280,
     "content_html": "<code class=\"python\" data-lang=\"python\">[\"a\", \"year\", \"includes\", \"12\", \"months\"]</code>",
     "correctness": "1.0",
     "feedback_html": "When <code class=\"python\" data-lang=\"python\">\"a year includes 12 months\"</code> is broken into substrings using blank space characters, the list <code class=\"python\" data-lang=\"python\">[\"a\", \"year\", \"includes\", \"12\", \"months\"]</code> is created."
    }
   ],
