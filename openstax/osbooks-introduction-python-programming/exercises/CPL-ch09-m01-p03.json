 "questions": [
  {
   "id": 666763,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which operation can be used to remove an element from the end of a list?",
   "answers": [
    {
     "id": 1329314,
     "content_html": "only <code class=\"python\" data-lang=\"python\">pop()</code>",
     "correctness": "0.0",
     "feedback_html": "Pop can be used to remove an element from the end of a list but <code class=\"python\" data-lang=\"python\">pop()</code> is not the only way. "
    },
    {
     "id": 1329315,
     "content_html": "only <code class=\"python\" data-lang=\"python\">remove()</code>",
     "correctness": "0.0",
     "feedback_html": "The <code class=\"python\" data-lang=\"python\">remove()</code> operation with the last element as a parameter can be used to remove the last element but remove() is not the only way."
    },
    {
     "id": 1329316,
     "content_html": "either <code class=\"python\" data-lang=\"python\">pop()</code> or <code class=\"python\" data-lang=\"python\">remove()</code>",
     "correctness": "1.0",
     "feedback_html": "Both <code class=\"python\" data-lang=\"python\">pop()</code> and <code class=\"python\" data-lang=\"python\">remove()</code> can be used to remove the last element of a list. <code class=\"python\" data-lang=\"python\">pop()</code> automatically removes the last element, whereas <code class=\"python\" data-lang=\"python\">remove()</code> requires the last element be specified."
    }
   ],
