 "questions": [
  {
   "id": 666837,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the correct syntax to create a dictionary with one item <code class=\"python\" data-lang=\"python\">\"one\": 1</code>?",
   "answers": [
    {
     "id": 1329522,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_dict = (\"one\": 1)</code>",
     "correctness": "0.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">(\"one\": 1)</code> is an invalid syntax. Python dictionaries can be created using curly braces or <code class=\"python\" data-lang=\"python\">dict()</code> function."
    },
    {
     "id": 1329523,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_dict = (\"one\", 1)</code>",
     "correctness": "0.0",
     "feedback_html": "Using <code class=\"python\" data-lang=\"python\">()</code> and comma creates a tuple object with two elements. What is the syntax to create a dictionary object with the same values?"
    },
    {
     "id": 1329524,
     "content_html": "<code class=\"python\" data-lang=\"python\">my_dict = {\"one\": 1}</code>",
     "correctness": "1.0",
     "feedback_html": "<code class=\"python\" data-lang=\"python\">{\"one\": 1}</code> creates a dictionary object with one item <code class=\"python\" data-lang=\"python\">\"one\": 1</code>."
    }
   ],
