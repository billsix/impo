 "questions": [
  {
   "id": 666877,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the syntax for creating a nested dictionary in Python?",
   "answers": [
    {
     "id": 1329640,
     "content_html": "<code class=\"python\" data-lang=\"python\">{key: value}</code>",
     "correctness": "0.0",
     "feedback_html": "Having one layer of key-value pairs creates a one-layer dictionary, not a nested dictionary. For a nested dictionary, a dictionary must be the value of the outer dictionary."
    },
    {
     "id": 1329641,
     "content_html": "<code class=\"python\" data-lang=\"python\">{key1: {key2: value}}</code>",
     "correctness": "1.0",
     "feedback_html": "A nested dictionary is a value of another dictionary, representing the data in a two-layer structure."
    },
    {
     "id": 1329642,
     "content_html": "<code class=\"python\" data-lang=\"python\">{key: {value: key2}}</code>",
     "correctness": "0.0",
     "feedback_html": "The inner dictionary must follow the template for a dictionary and be in the <code class=\"python\" data-lang=\"python\">key:value</code> structure, not <code class=\"python\" data-lang=\"python\">value:key</code> structure."
    }
   ],
