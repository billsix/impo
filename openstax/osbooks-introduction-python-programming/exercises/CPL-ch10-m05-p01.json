   "id": 362987,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a nested dictionary in Python?",
   "answers": [
    {
     "id": 877491,
     "content_html": "A dictionary that contains only integers as keys and values.",
     "correctness": "0.0",
     "feedback_html": "A nested dictionary is a dictionary that contains another dictionary as a value. Nested dictionary is a way to represent hierarchical data and does not depend on a specific key or value type."
    },
    {
     "id": 877492,
     "content_html": "A dictionary that contains another dictionary as a value.",
     "correctness": "1.0",
     "feedback_html": "A nested dictionary contains another dictionary."
    },
    {
     "id": 877493,
     "content_html": "A dictionary that contains only strings as keys and values.",
     "correctness": "0.0",
     "feedback_html": "A dictionary must contain a dictionary as a value <span class=\"red-code\">, not a string</span> to be called a nested dictionary."
    },
    {
     "id": 877494,
     "content_html": "A dictionary that contains only lists as keys and values.",
     "correctness": "0.0",
     "feedback_html": "While a list may contain multiple values, the definition of nested dictionary requires two dictionaries to be nested in one another."
    }
   ],
