   "id": 666753,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the output of the following code?\n<pre class=\"python\" data-lang=\"python\">s = \"\"\"This\nis a\ntest\"\"\"\n\nout = s.split()\nprint(out)\n</pre>",
   "answers": [
    {
     "id": 1329284,
     "content_html": "<code class=\"python\" data-lang=\"python\">Error</code>",
     "correctness": "0.0",
     "feedback_html": "The code does not throw an error. The string <code class=\"python\" data-lang=\"python\">s</code> is created as a multi-line string literal and the <code class=\"python\" data-lang=\"python\">split()</code> function is called on the string."
    },
    {
     "id": 1329285,
     "content_html": "<code class=\"python\" data-lang=\"python\">['This', 'is', 'a', 'test']</code>",
     "correctness": "1.0",
     "feedback_html": "When splitting the multi-line string, the output is <code class=\"python\" data-lang=\"python\">['This', 'is', 'a', 'test']</code>."
    },
    {
     "id": 1329286,
     "content_html": "<code class=\"python\" data-lang=\"python\">&gt;['This', 'is a', 'test']</code>",
     "correctness": "0.0",
     "feedback_html": "When the delimiter is not defined, any white space character can act as a delimiter. Hence <code class=\"python\" data-lang=\"python\">'is a'</code> must be divided into two substrings."
    }
   ],
