 "questions": [
  {
   "id": 666299,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What format specifier displays a floating-point number with comma separators and rounded to two decimal places?",
   "answers": [
    {
     "id": 1327992,
     "content_html": "<code class=\"python\" data-lang=\"python\">.2,f</code>",
     "correctness": "0.0",
     "feedback_html": "The comma option must be specified before the number of decimal places."
    },
    {
     "id": 1327993,
     "content_html": "<code class=\"python\" data-lang=\"python\">,.2f</code>",
     "correctness": "1.0",
     "feedback_html": "This format specifier is useful for displaying large amounts of money."
    },
    {
     "id": 1327994,
     "content_html": "<code class=\"python\" data-lang=\"python\">,d.2f</code>",
     "correctness": "0.0",
     "feedback_html": "The letter 'd' is used for decimal (base 10) integers, not floating-point numbers."
    }
   ],
