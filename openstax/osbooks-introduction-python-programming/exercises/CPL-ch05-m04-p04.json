 "questions": [
  {
   "id": 666503,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given the following code, how many times does the print statement get executed?\n<pre class=\"python\" data-lang=\"python\">i = 10\nwhile i &gt;= 0:\n&nbsp;&nbsp;i -= 1\n&nbsp;&nbsp;if i%3 != 0:\n&nbsp;&nbsp;&nbsp;&nbsp;continue\n&nbsp;&nbsp;print(i)\n</pre>\n",
   "answers": [
    {
     "id": 1328562,
     "content_html": "3",
     "correctness": "0.0",
     "feedback_html": "The print statement is executed for numbers within the range of 0 and 10 (inclusive) that are divisible by 3. How many numbers meet the described condition?"
    },
    {
     "id": 1328563,
     "content_html": "4",
     "correctness": "1.0",
     "feedback_html": "The print statement is executed for numbers within the range of 0 and 10 (inclusive) that are divisible by 3. The printed output is:\n<pre class=\"python\" data-lang=\"python\">\n9\n6\n3\n0\n</pre>\n"
    },
    {
     "id": 1328564,
     "content_html": "11",
     "correctness": "0.0",
     "feedback_html": "When the remainder of <code class=\"python\" data-lang=\"python\">i</code> divided by 3 is not equal to 0, the continue statement is executed and hence the print statement will not be executed. How many numbers between 0 and 10 are divisible by 3?"
    }
   ],
