   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To gain trade secret protection, what must the owner do with confidential information?",
   "answers": [
    {
     "id": 922729,
     "content_html": "Publicize it as widely as possible.",
     "correctness": "0.0"
    },
    {
     "id": 922728,
     "content_html": "Not disclose it.\n",
     "correctness": "0.0"
    },
    {
     "id": 922730,
     "content_html": "Take active steps to keep the information secret.",
     "correctness": "1.0"
