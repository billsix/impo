  {
   "id": 399633,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What impact did the Uniform Trade Secrets Act (UTSA) of 1979 have on trade secret protection in the United States?",
   "answers": [
    {
     "id": 922712,
     "content_html": "It was the first trade secret law binding on every state.",
     "correctness": "0.0"
    },
    {
     "id": 922713,
     "content_html": "It served as a model that was adopted by 48 of the 50 U.S. states.",
     "correctness": "1.0"
    },
    {
     "id": 922711,
     "content_html": "It served as a model that was adopted by every state.\n",
