   "id": 399583,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "On December 16, 2015, the Copyright Royalty Board changed the royalty rates paid by music services like Pandora. What change was made?",
   "answers": [
    {
     "id": 922565,
     "content_html": "The board reduced the rate from 14 cents per 100 songs played to 11 cents.",
     "correctness": "0.0"
    },
    {
     "id": 922566,
     "content_html": "The board raised the rate to 17 cents per 100 songs played.",
     "correctness": "1.0"
    },
    {
     "id": 922564,
     "content_html": "The board raised the rate to 20 cents per 100 songs played.",
     "correctness": "0.0"
    }
