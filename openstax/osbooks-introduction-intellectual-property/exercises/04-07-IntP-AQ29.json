 "questions": [
  {
   "id": 399614,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "If geographic marks that are deceptively misdescriptive are ineligible for trademark protection, then why was Amazon able to gain trademark protection for its name, which refers to a geographic area of South America?",
   "answers": [
    {
     "id": 922659,
     "content_html": "The name “Amazon” is not indicative of the geographic source of the retailer’s goods, nor do consumers think those goods come from the Amazonian region.",
     "correctness": "0.0"
    },
    {
     "id": 922658,
     "content_html": "The name “Amazon” is not a factor in whether or not consumers decide to purchase books, clothing,\nelectronics, or anything else from the company.",
     "correctness": "0.0"
    },
    {
     "id": 922657,
     "content_html": "Amazon’s brand stands for low prices and great customer service, not for anything of a geographic nature.",
     "correctness": "0.0"
    },
    {
     "id": 922660,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
