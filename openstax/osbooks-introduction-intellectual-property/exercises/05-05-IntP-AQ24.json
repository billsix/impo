 "questions": [
  {
   "id": 399646,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The burden of proof in a threatened trade secret misappropriation case lies with whom?",
   "answers": [
    {
     "id": 922751,
     "content_html": "The trade secret owner.",
     "correctness": "1.0"
    },
    {
     "id": 922750,
     "content_html": "The former employee who leaves to go work for a competitor.",
     "correctness": "0.0"
    },
    {
     "id": 922749,
     "content_html": "The competitor, who must prove he did no wrong by hiring the ex-employee.",
     "correctness": "0.0"
    }
   ],
