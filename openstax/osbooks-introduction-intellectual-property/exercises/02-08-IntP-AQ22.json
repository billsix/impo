 "questions": [
  {
   "id": 399529,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following explain why patent infringement verdicts are almost always appealed?",
   "answers": [
    {
     "id": 922412,
     "content_html": "The cost of an appeal is orders of magnitude less than the cost of the trial itself.",
     "correctness": "0.0"
    },
    {
     "id": 922411,
     "content_html": "Legal issues such as claim construction are reviewed <b>de novo</b> - meaning, without regard to the previous trial’s rulings.\n",
     "correctness": "0.0"
    },
    {
     "id": 922410,
     "content_html": "The U.S. Court for the Federal Circuit, the appeals court, affirms in full less than 60 percent of the patent cases it decides on the merits.",
     "correctness": "0.0"
    },
    {
     "id": 922413,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
