 "questions": [
  {
   "id": 399629,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did the Supreme Court note in the case of <i>Bonito Boats v. Thunder Craft Boats</i>?\n",
   "answers": [
    {
     "id": 922702,
     "content_html": "One cannot legally misappropriate trade secrets.",
     "correctness": "0.0"
    },
    {
     "id": 922701,
     "content_html": "Nobody is above the law, not even a trade secret owner.\n",
     "correctness": "0.0"
    },
    {
     "id": 922703,
     "content_html": "The holder of a trade secret does not have protection against reverse engineering.",
     "correctness": "1.0"
    }
   ],
