 "questions": [
  {
   "id": 399473,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following was NOT a unique feature of the U.S. patent system?",
   "answers": [
    {
     "id": 922237,
     "content_html": "It was affordable by the common person.\n",
     "correctness": "0.0"
    },
    {
     "id": 922236,
     "content_html": "It had an examination system to determine patent validity.",
     "correctness": "0.0"
    },
    {
     "id": 922238,
     "content_html": "Patentees were required to make or sell products based on their inventions.\n",
     "correctness": "1.0"
    },
    {
     "id": 922235,
     "content_html": "It had simplified application procedures.\n",
     "correctness": "0.0"
    },
    {
     "id": 922234,
     "content_html": "It required full disclosure of the details of the invention.\n",
     "correctness": "0.0"
    },
    {
     "id": 922233,
     "content_html": "It allowed for the sale and licensing of patent rights.",
     "correctness": "0.0"
    }
   ],
