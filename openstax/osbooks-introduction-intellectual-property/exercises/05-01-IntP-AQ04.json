 "questions": [
  {
   "id": 399626,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are the two main requirements for information to be protectable as a trade secret?",
   "answers": [
    {
     "id": 922694,
     "content_html": "It must be novel and non-obvious.\n",
     "correctness": "0.0"
    },
    {
     "id": 922693,
     "content_html": "It must be original and expressed in a tangible form that can be seen or copied.",
     "correctness": "0.0"
    },
    {
     "id": 922695,
     "content_html": "It must be not generally known by others, and it must have been subject to reasonable efforts to avoid public disclosure.",
     "correctness": "1.0"
    }
   ],
