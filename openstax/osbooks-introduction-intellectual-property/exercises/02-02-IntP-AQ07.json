 "questions": [
  {
   "id": 399514,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Patent infringement suits can take years and cost millions of dollars. Which of the following is another option patent owners have in seeking redress for infringement?",
   "answers": [
    {
     "id": 922365,
     "content_html": "Litigation financing in exchange for a share of any damages.",
     "correctness": "0.0"
    },
    {
     "id": 922364,
     "content_html": "Out-of-court license and royalty settlements.",
     "correctness": "0.0"
    },
    {
     "id": 922363,
     "content_html": "Contingency lawyers take the case for a share of any damages.\n",
     "correctness": "0.0"
    },
    {
     "id": 922366,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
