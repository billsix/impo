 "questions": [
  {
   "id": 399528,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is often the most serious damage that a court can impose upon an infringer?",
   "answers": [
    {
     "id": 922408,
     "content_html": "A very large award for monetary damages.\n",
     "correctness": "0.0"
    },
    {
     "id": 922407,
     "content_html": "Pre- and post judgment interest payments on the damage award.\n",
     "correctness": "0.0"
    },
    {
     "id": 922409,
     "content_html": "Injunctive relief barring further sales of the infringer’s products.",
     "correctness": "1.0"
    }
   ],
