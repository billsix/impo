 "questions": [
  {
   "id": 399618,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How does trademark infringement harm consumers?",
   "answers": [
    {
     "id": 922673,
     "content_html": "By confusing consumers about the source of goods or services.",
     "correctness": "0.0"
    },
    {
     "id": 922672,
     "content_html": "By allowing others to “palm off” lower-quality knockoffs in place of the high-quality goods they are seeking to buy.",
     "correctness": "0.0"
    },
    {
     "id": 922671,
     "content_html": "By damaging trust between consumers and providers of goods and services.",
     "correctness": "0.0"
    },
    {
     "id": 922674,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
