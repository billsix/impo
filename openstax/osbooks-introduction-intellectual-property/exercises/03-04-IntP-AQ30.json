 "questions": [
  {
   "id": 399561,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is computer software eligible for copyright?",
   "answers": [
    {
     "id": 922499,
     "content_html": "It cannot be patented.\n",
     "correctness": "0.0"
    },
    {
     "id": 922500,
     "content_html": "It is considered to be a literary work, which the Copyright Act defines as a work expressed in words, numbers, or other symbols that is creatively compiled.",
     "correctness": "1.0"
    },
    {
     "id": 922498,
     "content_html": "It is able to display artistic or literary work on a TV or in an e-book.",
     "correctness": "0.0"
    }
   ],
