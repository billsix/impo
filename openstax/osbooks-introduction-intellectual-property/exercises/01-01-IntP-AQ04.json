 "questions": [
  {
   "id": 399467,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Through which of the following means do patents also promote knowledge sharing?",
   "answers": [
    {
     "id": 922211,
     "content_html": "To get a patent, inventors must disclose the secrets of their inventions.\n",
     "correctness": "0.0"
    },
    {
     "id": 922210,
     "content_html": "Patents represent the world’s greatest library of technical knowledge.",
     "correctness": "0.0"
    },
    {
     "id": 922209,
     "content_html": "Innovators keep up with technical trends by reading other inventors’ patents.",
     "correctness": "0.0"
    },
    {
     "id": 922212,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
