 "questions": [
  {
   "id": 399501,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "By what percentage are filing fees reduced if the applicant is on of the following:\n<ol style=\"list-style-type:upper-alpha\">\n<li>Universities, non-profits, and small businesses with fewer than 500 employees.</li>\n<li>Those with gross income less than three times U.S. median household income or meet other certain criteria.</li>\n</ol>\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A. These are called small entities, and receive a 50% discount in application fees.; B. These are micro-entities, and receive a 75% discount in filing fees."
    }
   ],
   "community_solutions": []
  }
