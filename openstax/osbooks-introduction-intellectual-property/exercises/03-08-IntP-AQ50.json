 "questions": [
  {
   "id": 399581,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The Digital Millennium Copyright Act of 1998 made it a crime to circumvent digital rights management (DRM) measures that control access to digital music and ebooks as a means of preventing piracy. So why are so many listeners, readers, and book and music publishers voluntarily abandoning DRM measures?",
   "answers": [
    {
     "id": 922559,
     "content_html": "It prevents people from sharing their digital music and e-books with friends and family, like they can with regular music CDs and printed books.",
     "correctness": "0.0"
    },
    {
     "id": 922558,
     "content_html": "DRM measures alienate consumers and limit their choices.",
     "correctness": "0.0"
    },
    {
     "id": 922557,
     "content_html": "The elimination of DRM measures will grow the market for digital books and music much more rapidly.",
     "correctness": "0.0"
    },
    {
     "id": 922560,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
