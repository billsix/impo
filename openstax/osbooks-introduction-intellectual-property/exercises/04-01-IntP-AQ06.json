 "questions": [
  {
   "id": 399591,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How are trademarks different from patents and copyrights?",
   "answers": [
    {
     "id": 922594,
     "content_html": "They are not limited in duration.\n",
     "correctness": "0.0"
    },
    {
     "id": 922593,
     "content_html": "They do not hinder the sale of similar products and services by others.",
     "correctness": "0.0"
    },
    {
     "id": 922592,
     "content_html": "They cannot be obtained by mere adoption, but only through commercial use.",
     "correctness": "0.0"
    },
    {
     "id": 922595,
     "content_html": "All of the above are true statements.",
     "correctness": "1.0"
    }
   ],
