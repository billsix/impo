 "questions": [
  {
   "id": 399535,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When is a work considered copyrighted?",
   "answers": [
    {
     "id": 922427,
     "content_html": "Once it is officially registered with the U.S. Copyright Office.",
     "correctness": "0.0"
    },
    {
     "id": 922426,
     "content_html": "Once the U.S. Copyright Office grants an official copyright.\n",
     "correctness": "0.0"
    },
    {
     "id": 922428,
     "content_html": "Once it is expressed in a tangible form that allows it to be seen or copied.",
     "correctness": "1.0"
    }
   ],
