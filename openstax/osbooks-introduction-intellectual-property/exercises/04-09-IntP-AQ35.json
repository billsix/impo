 "questions": [
  {
   "id": 399620,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is trademark dilution as opposed to trademark infringement?",
   "answers": [
    {
     "id": 922678,
     "content_html": "Dilution occurs when a mark famous to the general American public is blurred or tarnished by a similar mark, regardless of whether that mark is used on similar goods or services.",
     "correctness": "1.0"
    },
    {
     "id": 922677,
     "content_html": "Dilution occurs when a trademark grows weaker in the minds of consumers as a result of its owner not advertising or featuring it prominently enough on products.",
     "correctness": "0.0"
    }
   ],
