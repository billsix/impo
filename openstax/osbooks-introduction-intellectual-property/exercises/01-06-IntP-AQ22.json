 "questions": [
  {
   "id": 399485,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "When might a software be patentable?",
   "answers": [
    {
     "id": 922271,
     "content_html": "If it contains a new, non-obvious, and useful algorithm.\n",
     "correctness": "0.0"
    },
    {
     "id": 922272,
     "content_html": "If it takes a genuinely-inventive step to either trigger an action, employ a device, or in some other way produce a tangible transformative result.",
     "correctness": "1.0"
    },
    {
     "id": 922270,
     "content_html": "If it records the sale of T-shirts over the Internet.\n",
     "correctness": "0.0"
    },
    {
     "id": 922269,
     "content_html": "None of the above.",
     "correctness": "0.0"
    }
   ],
