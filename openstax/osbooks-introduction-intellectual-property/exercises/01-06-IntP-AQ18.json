 "questions": [
  {
   "id": 399481,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A patentable invention is a new, novel, and non-obvious machine, manufacture, process, or composition of matter. Which of the four types of inventions categories do these hypothetical mousetrap inventions represent?\n<ol style=\"list-style-type:upper-alpha\">\n<li>A mouse ray gun.</li>\n<li>Exploding mouse glue.</li>\n<li>A new way to catch mice using sound waves.</li>\n<li>A mouse-destroying missile.</li>\n</ol>\n\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A. A machine—a tool with moving parts and uses energy.; B. A composition of matter—a synthesized chemical compound or molecule.; C. A process—a way to do something new or a new way to do something old.; D. A manufacture—a part or product produced according to design."
    }
   ],
   "community_solutions": []
  }
 ],
