 "questions": [
  {
   "id": 399538,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How were copyrights viewed very differently from patent rights in terms of the interests of the general public?\n",
   "answers": [
    {
     "id": 922434,
     "content_html": "Copyrights were thought to be in less conflict with the public interest.",
     "correctness": "0.0"
    },
    {
     "id": 922433,
     "content_html": "Copyrights were enforced with the same diligence as patent rights.\n",
     "correctness": "0.0"
    },
    {
     "id": 922435,
     "content_html": "Patent rights were seen as more beneficial to the public than copyrights.",
     "correctness": "1.0"
    }
   ],
