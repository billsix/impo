 "questions": [
  {
   "id": 399521,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What role does discovery play in an infringement case?",
   "answers": [
    {
     "id": 922388,
     "content_html": "Through production of documents and interrogatories, either side may discover information that may be decisive in confirming or rebutting infringement claims.",
     "correctness": "0.0"
    },
    {
     "id": 922387,
     "content_html": "Discovery is often an endless fishing expedition that escalates the costs to both parties exponentially.",
     "correctness": "0.0"
    },
    {
     "id": 922389,
     "content_html": "Both of these describe the role of discovery in an infringement case.\n",
     "correctness": "1.0"
    }
   ],
