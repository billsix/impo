 "questions": [
  {
   "id": 399615,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As with copyrights, trademarks do not have to be registered with the federal government, but doing so gives their owners all of the following additional rights EXCEPT for which one?",
   "answers": [
    {
     "id": 922664,
     "content_html": "The exclusive right to use the mark in their geographic area of business.",
     "correctness": "1.0"
    },
    {
     "id": 922663,
     "content_html": "The ability to seek assistance from the U.S. Customs and Border Protection Service in preventing the importation of infringing foreign goods.",
     "correctness": "0.0"
    },
    {
     "id": 922662,
     "content_html": "The exclusive right to use the mark nationwide.",
     "correctness": "0.0"
    },
    {
     "id": 922661,
     "content_html": "The right to use the federal registration symbol ® instead of the ™ symbol.",
     "correctness": "0.0"
    }
   ],
