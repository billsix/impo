   "id": 399586,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the purpose of the intellectual property right we call a trademark?",
   "answers": [
    {
     "id": 922576,
     "content_html": "To protect the inventions of businesses.\n",
     "correctness": "0.0"
    },
    {
     "id": 922577,
     "content_html": "To indicate the origin of goods or services.\n",
     "correctness": "1.0"
    },
    {
     "id": 922575,
     "content_html": "To reward businesses for their creative works.",
     "correctness": "0.0"
    }
