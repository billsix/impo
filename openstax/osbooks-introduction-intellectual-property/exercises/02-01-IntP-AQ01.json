   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Responsibility for legally enforcing patents rests with which of the following bodies?",
   "answers": [
    {
     "id": 922346,
     "content_html": "The U.S. Patent and Trademark Office (USPTO)."
    },
    {
     "id": 922345,
     "content_html": "The U.S. Department of Justice."
    },
    {
     "id": 922347,
     "content_html": "The owner of the patent, suing in a federal civil lawsuit."
    }
