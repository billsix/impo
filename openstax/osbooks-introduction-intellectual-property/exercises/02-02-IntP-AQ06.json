 "questions": [
  {
   "id": 399513,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you believe your patent is being infringed, you have how many options for recourse?",
   "answers": [
    {
     "id": 922361,
     "content_html": "Two. You can sue the infringer in federal court, or ignore the infringement.",
     "correctness": "0.0"
    },
    {
     "id": 922360,
     "content_html": "Three. Besides the two above, you can simply demand he stop infringing.",
     "correctness": "0.0"
    },
    {
     "id": 922362,
     "content_html": "Four. You can sue the infringer, demand he stop infringing and pay monetary damages, offer the infringer a license in return for royalties, or ignore it.",
     "correctness": "1.0"
    }
   ],
