  {
   "id": 399556,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What were some of the costs of America’s rampant piracy of foreign books?\n",
   "answers": [
    {
     "id": 922482,
     "content_html": "The U.S. was regarded as an publishing outlaw by other countries.",
     "correctness": "0.0"
    },
    {
     "id": 922481,
     "content_html": "American works cost a lot more than pirated foreign works.",
     "correctness": "0.0"
    },
    {
     "id": 922480,
     "content_html": "Domestic American authorship was stunted and delayed as a result.",
     "correctness": "0.0"
    },
    {
     "id": 922483,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
