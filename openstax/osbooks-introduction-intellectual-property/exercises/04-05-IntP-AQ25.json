 "questions": [
  {
   "id": 399610,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which kind of mark is owned by the following companies?\n<ol style=\"list-style-type:upper-alpha\">\n<li>Apple.</li>\n<li>Xerox.</li>\n<li>Coppertone.</li>\n<li>Windows.</li>\n</ol>\n\n",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A. Arbitrary. “Apple” is an example of a real word in common usage that has absolutely no relationship to the product or service being sold.; B. Fanciful. “Xerox” is a completely invented word that has no meaning except to indicate the source of a copier manufacturer. Fanciful marks are the strongest type of mark you can have.; C. Suggestive. Again, “Coppertone” suggests the quality or color of the tan you’ll get, while indicating which company is selling it.; D. Descriptive. “Windows” is one of the rare marks that describe the nature of a distinctive product (computer software) from a unique manufacturer"
    }
   ],
   "community_solutions": []
  }
 ],
