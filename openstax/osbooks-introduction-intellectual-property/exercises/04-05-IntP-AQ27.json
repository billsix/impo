   "id": 399612,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why did “Cellophane” and “Aspirin” lose their trademarks?",
   "answers": [
    {
     "id": 922651,
     "content_html": "The original companies making these products went out of business.",
     "correctness": "0.0"
    },
    {
     "id": 922652,
     "content_html": "The public came to associate the name with an entire category of similar products.",
     "correctness": "1.0"
    }
