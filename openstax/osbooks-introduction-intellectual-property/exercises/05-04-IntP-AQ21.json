  {
   "id": 399643,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is one way to guard against the active disclosure of trade secret information?",
   "answers": [
    {
     "id": 922741,
     "content_html": "Prevent employee attendance at trade shows and seminars.",
     "correctness": "0.0"
    },
    {
     "id": 922742,
     "content_html": "Appoint a trade secret committee to approve publications, speeches, and marketing collateral prior to disclosure.",
     "correctness": "1.0"
    },
    {
     "id": 922740,
     "content_html": "Avoid meeting with prospective buyers, customers, or licensees.",
     "correctness": "0.0"
    }
   ],
