 "questions": [
  {
   "id": 399511,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is the legal definition of patent infringement?",
   "answers": [
    {
     "id": 922356,
     "content_html": "One or more of a patent’s claims match (or “read on”) the features and functions of a device or process.",
     "correctness": "1.0"
    },
    {
     "id": 922355,
     "content_html": "A device or process that performs a “substantially similar” functions to those described in a patent’s claims.",
     "correctness": "0.0"
    },
    {
     "id": 922354,
     "content_html": "Both of the above are correct.",
     "correctness": "0.0"
    }
   ],
