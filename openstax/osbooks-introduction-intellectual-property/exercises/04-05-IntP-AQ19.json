  {
   "id": 399604,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A trademark may be a word (or phrase), name, symbol, or device. Which of these do the following trademarks represent?\n<ol style=\"list-style-type:upper-alpha\">\n<li>Chanel handbags.</li>\n<li>The MGM lion’s roar.</li>\n<li>Tiffany’s blue color.</li>\n<li>The power-on chime in Apple’s Mac computers.</li>\n</ol>",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A. Name (Chanel); B. Device (a sound).; C. Device (the distinctive blue color).; D. Device (a sound).\n"
    }
   ],
   "community_solutions": []
  }
 ],
