 "questions": [
  {
   "id": 399539,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The policy of strong patent rights and weaker copyrights also reflected what differences in the motivations of inventors compared with authors?",
   "answers": [
    {
     "id": 922437,
     "content_html": "Authors were not generally interested in economic gain.",
     "correctness": "0.0"
    },
    {
     "id": 922436,
     "content_html": "Authors were motivated only by the prospect of economic gain.",
     "correctness": "0.0"
    },
    {
     "id": 922438,
     "content_html": "Both artists and inventors sought economic gain, but authors also tended to be rewarded by celebrity and reputational gain as well.\n",
     "correctness": "1.0"
    }
   ],
