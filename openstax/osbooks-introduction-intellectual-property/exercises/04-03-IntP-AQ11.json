 "questions": [
  {
   "id": 399596,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What caused U.S. trademark laws to evolve from a patchwork of state laws into a unitary federal\ntrademark system?",
   "answers": [
    {
     "id": 922611,
     "content_html": "The Industrial Revolution transformed America’s many local and regional markets into a unified national economy.\n",
     "correctness": "0.0"
    },
    {
     "id": 922610,
     "content_html": "Producers of goods and services began to grow into national entities.",
     "correctness": "0.0"
    },
    {
     "id": 922609,
     "content_html": "State laws often conflicted with each other.\n",
     "correctness": "0.0"
    },
    {
     "id": 922612,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
