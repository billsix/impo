 "questions": [
  {
   "id": 399600,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When does federal law create a presumption of trademark abandonment?\n",
   "answers": [
    {
     "id": 922624,
     "content_html": "When its owner ceases to use it in commerce.\n",
     "correctness": "0.0"
    },
    {
     "id": 922623,
     "content_html": "When its owner ceases to employ it throughout the national territory of the United States.",
     "correctness": "0.0"
    },
    {
     "id": 922625,
     "content_html": "When its owner ceases to use the trademark in commerce for three or more years.",
     "correctness": "1.0"
    }
   ],
