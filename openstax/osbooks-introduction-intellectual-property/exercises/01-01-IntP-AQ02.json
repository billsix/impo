 "questions": [
  {
   "id": 399465,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The “bargain” theory, a theoretical justification for patents, argues which of the following?",
   "answers": [
    {
     "id": 922208,
     "content_html": "In exchange for inventing something useful, society gives the inventor the exclusive right to their invention for a limited time.\n",
     "correctness": "1.0"
    },
    {
     "id": 922207,
     "content_html": "The product of mental labor should be the property of its creator.",
     "correctness": "0.0"
    },
    {
     "id": 922206,
     "content_html": "Government negotiates with inventors to determine the value of an invention.",
     "correctness": "0.0"
    },
    {
     "id": 922205,
     "content_html": "None of the above.",
     "correctness": "0.0"
    }
   ],
