  {
   "id": 399634,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the problem with the current lack of uniform federal protection of trade secrets?",
   "answers": [
    {
     "id": 922715,
     "content_html": "There is no real protection against misappropriation of trade secrets.\n",
     "correctness": "0.0"
    },
    {
     "id": 922716,
     "content_html": "The protections against trade secret theft are very uneven.",
     "correctness": "1.0"
    },
    {
     "id": 922714,
     "content_html": "A federal trade secret law would merely replicate state protections.",
     "correctness": "0.0"
    }
