 "questions": [
  {
   "id": 399494,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "To meet the requirement for utility, which of the following must an invention do?\n",
   "answers": [
    {
     "id": 922303,
     "content_html": "Work or function as intended.",
     "correctness": "1.0"
    },
    {
     "id": 922302,
     "content_html": "Be of some benefit to society.\n",
     "correctness": "0.0"
    },
    {
     "id": 922301,
     "content_html": "Be a worthwhile product, process, or composition of matter.",
     "correctness": "0.0"
    },
    {
     "id": 922300,
     "content_html": "All of the above.",
     "correctness": "0.0"
    }
   ],
