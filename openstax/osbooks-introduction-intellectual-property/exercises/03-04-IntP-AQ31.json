 "questions": [
  {
   "id": 399562,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the difference between ideas and their expression under copyright law?",
   "answers": [
    {
     "id": 922502,
     "content_html": "You can’t copyright an idea for a movie, but you can patent it.",
     "correctness": "0.0"
    },
    {
     "id": 922501,
     "content_html": "Ideas are just thoughts, not matter how creative. You can’t copyright thoughts.",
     "correctness": "0.0"
    },
    {
     "id": 922503,
     "content_html": "You cannot copyright an idea for a space opera, but you can copyright Star Wars—the original expression of a space opera idea put to paper or film.",
     "correctness": "1.0"
    }
   ],
