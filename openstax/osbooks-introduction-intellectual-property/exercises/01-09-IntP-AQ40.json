 "questions": [
  {
   "id": 399503,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the main disadvantage of a provisional patent application?",
   "answers": [
    {
     "id": 922329,
     "content_html": "It reserves an early filing date for a later, nonprovisional application.",
     "correctness": "0.0"
    },
    {
     "id": 922330,
     "content_html": "The claims in a later, nonprovisional application must be completely consistent with the early description contained in the provisional application.",
     "correctness": "1.0"
    },
    {
     "id": 922328,
     "content_html": "The provisional patent only contains the specifications, and drawings, if any.\n",
     "correctness": "0.0"
    },
    {
     "id": 922327,
     "content_html": "All of the above.",
     "correctness": "0.0"
    }
   ],
