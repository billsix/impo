   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What are design patents granted for?",
   "answers": [
    {
     "id": 922318,
     "content_html": "Functional designs for manufactured items, like the shape of a chair.",
     "correctness": "0.0"
    },
    {
     "id": 922319,
     "content_html": "Ornamental designs for items of manufacture, like the fabric design of a chair.",
     "correctness": "1.0"
    },
    {
     "id": 922317,
     "content_html": "All of the above.",
     "correctness": "0.0"
    }
