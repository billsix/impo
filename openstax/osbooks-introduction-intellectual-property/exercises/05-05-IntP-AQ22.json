   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT an example of misappropriation of a trade secret?",
   "answers": [
    {
     "id": 922744,
     "content_html": "Acquisition of a trade secret through improper means.",
     "correctness": "0.0"
    },
    {
     "id": 922745,
     "content_html": "Deliberate disclosure of a trade secret by the trade secret owner.\n",
     "correctness": "1.0"
    },
    {
     "id": 922743,
     "content_html": "Disclosure of a trade secret without consent.\n",
     "correctness": "0.0"
