   "id": 399598,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the chief weakness of the Trade Mark Act of 1881?",
   "answers": [
    {
     "id": 922618,
     "content_html": "It only regulated the trademarks used in commerce with other nations and with Indian tribes.\n",
     "correctness": "1.0"
    },
    {
     "id": 922617,
     "content_html": "It only regulated the trademarks used in commerce with other nations and with Indian tribes.\n",
     "correctness": "0.0"
    },
    {
     "id": 922616,
     "content_html": "It derived its authority from the Commerce Clause of the U.S. Constitution.\n",
     "correctness": "0.0"
    }
