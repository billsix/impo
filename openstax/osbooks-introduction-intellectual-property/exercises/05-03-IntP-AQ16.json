 "questions": [
  {
   "id": 399638,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Can a mere idea be considered a trade secret?",
   "answers": [
    {
     "id": 922727,
     "content_html": "No. Just as you cannot patent or copyright a mere idea, you cannot protect a mere idea with a trade secret.",
     "correctness": "1.0"
    },
    {
     "id": 922726,
     "content_html": "Yes. Under the Uniform Trade Secrets Act, even an idea can sometimes be considered a trade secret.\n",
     "correctness": "0.0"
    }
   ],
