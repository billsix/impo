   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT true of trademarks?",
   "answers": [
    {
     "id": 922580,
     "content_html": "They protect the public by preventing confusion or deception about the source of goods and services.",
     "correctness": "0.0"
    },
    {
     "id": 922579,
     "content_html": "They protect the market reputation and goodwill of the producers of goods.",
     "correctness": "0.0"
    },
    {
     "id": 922581,
     "content_html": "They are granted at the moment of creation.",
     "correctness": "1.0"
    },
    {
     "id": 922578,
     "content_html": "They are excellent marketing and advertising tools.\n",
