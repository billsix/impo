 "questions": [
  {
   "id": 399520,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why have defendants increasingly turned to post-grant review proceedings at the PTO, such as <i>inter partes review</i>, since the America Invents Act was passed in 2011?",
   "answers": [
    {
     "id": 922385,
     "content_html": "The PTO is less likely to judge that a patent has been infringed.\n",
     "correctness": "0.0"
    },
    {
     "id": 922384,
     "content_html": "It's quicker than waiting for a trial.",
     "correctness": "0.0"
    },
    {
     "id": 922386,
     "content_html": "The PTO has shown a strong likelihood of finding challenged patents invalid.",
     "correctness": "1.0"
    }
   ],
