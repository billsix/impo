 "questions": [
  {
   "id": 399516,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Should you alert an infringer beforehand that you intend to file suit?",
   "answers": [
    {
     "id": 922371,
     "content_html": "Always. This gives them the opportunity to settle prior to you filing a costly suit.\n",
     "correctness": "0.0"
    },
    {
     "id": 922370,
     "content_html": "Never. They can then sue you preemptively, giving them the vital initiative in seeking a venue of their choice and a declaratory judgement of noninfringement.",
     "correctness": "0.0"
    },
    {
     "id": 922372,
     "content_html": "Yes, but only if you file suit simultaneously or shortly afterwards.\n",
     "correctness": "1.0"
    }
   ],
