 "questions": [
  {
   "id": 399597,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why were the first two national trademark laws ruled unconstitutional by the Supreme Court?",
   "answers": [
    {
     "id": 922614,
     "content_html": "The court ruled that they infringed on non-trademark owners’ first amendment rights to free speech.\n",
     "correctness": "0.0"
    },
    {
     "id": 922615,
     "content_html": "The court ruled in 1879 that the patent and copyright clauses of the Constitution gave Congress no authority to regulate trademarks.",
     "correctness": "1.0"
    },
    {
     "id": 922613,
     "content_html": "The court ruled that they were too vaguely written.",
     "correctness": "0.0"
    }
   ],
