 "questions": [
  {
   "id": 399645,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The UTSA not only prohibits the actual disclosure or use of a trade secret, it also protects against the “threatened” disclosure of trade secrets. When might a court intervene to stop a “threatened” disclosure before the actual disclosure takes place?",
   "answers": [
    {
     "id": 922747,
     "content_html": "An employee goes to work for another company in a different industry.",
     "correctness": "0.0"
    },
    {
     "id": 922746,
     "content_html": "An employee caught embezzling is fired and the employer believes the same lack of morals will lead to the fired employee disclosing trade secrets.",
     "correctness": "0.0"
    },
    {
     "id": 922748,
     "content_html": "An employee goes to work for an arch competitor in a comparable job position.",
     "correctness": "1.0"
    }
   ],
