 "questions": [
  {
   "id": 399605,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why has no company been able to gain trademark protection for “87 Octane” as a brand of gasoline?",
   "answers": [
    {
     "id": 922634,
     "content_html": "It’s a number.",
     "correctness": "0.0"
    },
    {
     "id": 922633,
     "content_html": "It’s not trade dress.",
     "correctness": "0.0"
    },
    {
     "id": 922635,
     "content_html": "It doesn’t indicate the origin of the gas—whether Exxon, Shell, or another company.",
     "correctness": "1.0"
    }
