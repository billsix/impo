   "id": 399549,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Given America’s more utilitarian focus in publishing, what was the emphasis placed in the drafting of our first copyright laws?",
   "answers": [
    {
     "id": 922460,
     "content_html": "To guarantee the rights of authors.",
     "correctness": "0.0"
    },
    {
     "id": 922459,
     "content_html": "To guarantee the rights of publishers and printers.",
     "correctness": "0.0"
    },
    {
     "id": 922461,
     "content_html": "To ensure widespread public access to knowledge and information.\n",
     "correctness": "1.0"
    }
