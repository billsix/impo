 "questions": [
  {
   "id": 399576,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If someone willfully infringes your copyrighted work for commercial advantage or private financial gain, what may he or she also face?",
   "answers": [
    {
     "id": 922544,
     "content_html": "Treble damages.\n",
     "correctness": "0.0"
    },
    {
     "id": 922545,
     "content_html": "Criminal penalties of up to five years in prison for a first offense, and ten years for a second offense.",
     "correctness": "1.0"
    },
    {
     "id": 922543,
     "content_html": "An order to publicly apologize for the infringement.",
     "correctness": "0.0"
    }
   ],
