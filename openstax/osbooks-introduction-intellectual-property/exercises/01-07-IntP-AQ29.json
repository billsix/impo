 "questions": [
  {
   "id": 399492,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What does the term “prior art” refer to?",
   "answers": [
    {
     "id": 922296,
     "content_html": "Any previous private discussions of an invention or its components.\n",
     "correctness": "0.0"
    },
    {
     "id": 922297,
     "content_html": "Any previous patent, publication, or public use of an invention.",
     "correctness": "1.0"
    },
    {
     "id": 922295,
     "content_html": "Any previous speculation about an invention.\n",
     "correctness": "0.0"
    },
    {
     "id": 922294,
     "content_html": "None of the above.",
     "correctness": "0.0"
    }
