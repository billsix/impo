 "questions": [
  {
   "id": 399474,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT true of the U.S. patent system?",
   "answers": [
    {
     "id": 922241,
     "content_html": "Novelty, non-obviousness, and utility determine patent validity, not the identity or business model of the inventor.",
     "correctness": "0.0"
    },
    {
     "id": 922240,
     "content_html": "Patents are freely transferable and tradable property rights.\n",
     "correctness": "0.0"
    },
    {
     "id": 922242,
     "content_html": "You can’t infringe a patent if you honestly don’t know that it exists.",
     "correctness": "1.0"
    },
    {
     "id": 922239,
     "content_html": "Patent holders are not required to make or sell products based on their inventions.",
     "correctness": "0.0"
    }
   ],
