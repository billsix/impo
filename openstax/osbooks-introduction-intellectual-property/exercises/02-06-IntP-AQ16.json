 "questions": [
  {
   "id": 399523,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why do courts usually seat seven to nine jurors rather than six or twelve in most patent cases?",
   "answers": [
    {
     "id": 922394,
     "content_html": "You need an odd number of jurors to break a tie vote on the verdict.",
     "correctness": "0.0"
    },
    {
     "id": 922395,
     "content_html": "Six jurors won’t be enough for a legal verdict if one is excused during trial, and twelve jurors will likely take too long to decide the case.\n",
     "correctness": "1.0"
    }
   ],
