 "questions": [
  {
   "id": 399599,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Lanham Act is the principal federal law on trademarks in the United States. Which of the following was NOT a feature of trademark law enacted by the act?\n",
   "answers": [
    {
     "id": 922621,
     "content_html": "It broadened the national system of trademark registration.",
     "correctness": "0.0"
    },
    {
     "id": 922620,
     "content_html": "It set the trademark renewal period.",
     "correctness": "0.0"
    },
    {
     "id": 922622,
     "content_html": "It required registration of trademarks before owners could gain access to the federal courts for redress.",
     "correctness": "1.0"
    },
    {
     "id": 922619,
     "content_html": "It established remedies in the case of infringement.",
     "correctness": "0.0"
    }
   ],
