 "questions": [
  {
   "id": 399502,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the advantage of a provisional patent application, which lasts only one year?",
   "answers": [
    {
     "id": 922325,
     "content_html": "It is less expensive.",
     "correctness": "0.0"
    },
    {
     "id": 922324,
     "content_html": "It is not subject to examination.\n",
     "correctness": "0.0"
    },
    {
     "id": 922323,
     "content_html": "It grants an early filing date while the inventor continues working on the invention.\n",
     "correctness": "0.0"
    },
    {
     "id": 922326,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
