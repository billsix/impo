 "questions": [
  {
   "id": 399470,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Early patent systems tended to have which of the following effects on the overall economy?",
   "answers": [
    {
     "id": 922223,
     "content_html": "Innovation was limited to a small sector of the population.",
     "correctness": "0.0"
    },
    {
     "id": 922222,
     "content_html": "Biased toward incumbent industries, early patent systems did not encourage disruptive change.",
     "correctness": "0.0"
    },
    {
     "id": 922221,
     "content_html": "Early patent systems reinforced the wealth of elites, not the productive capacity of society.",
     "correctness": "0.0"
    },
    {
     "id": 922224,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
