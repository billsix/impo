 "questions": [
  {
   "id": 399573,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The jury’s decision also drew criticism from many copyright and music experts. Why?\n",
   "answers": [
    {
     "id": 922535,
     "content_html": "The $5.3 million award was thought to be outrageously large.\n",
     "correctness": "0.0"
    },
    {
     "id": 922536,
     "content_html": "Critics said that although Marvin Gaye may have been the Prince of Soul, he didn’t own a copyright to the whole genre.",
     "correctness": "1.0"
    },
    {
     "id": 922534,
     "content_html": "Not a single word, melody, or beat from Gaye’s song was actually copied.\n",
     "correctness": "0.0"
    }
   ],
