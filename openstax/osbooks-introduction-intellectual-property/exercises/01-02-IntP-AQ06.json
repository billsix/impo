 "questions": [
  {
   "id": 399469,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following practices were common in early patent systems?",
   "answers": [
    {
     "id": 922219,
     "content_html": "Exorbitantly high patent fees.\n",
     "correctness": "0.0"
    },
    {
     "id": 922218,
     "content_html": "Limited or no disclosure of the details of the invention.",
     "correctness": "0.0"
    },
    {
     "id": 922217,
     "content_html": "No examination for patent validity.\n",
     "correctness": "0.0"
    },
    {
     "id": 922220,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
