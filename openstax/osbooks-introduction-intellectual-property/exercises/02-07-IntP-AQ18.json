   "stimulus_html": "",
   "stem_html": "Which of the following is the definition of inequitable conduct?",
   "answers": [
    {
     "id": 922401,
     "content_html": "Deceiving or misleading the patent office to grant a patent.",
     "correctness": "1.0"
    },
    {
