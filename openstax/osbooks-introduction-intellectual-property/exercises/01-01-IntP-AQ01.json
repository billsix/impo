 "questions": [
  {
   "id": 399464,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A patent gives an inventor the exclusive right to which of the following?",
   "answers": [
    {
     "id": 922203,
     "content_html": "The ability to profit from their invention.",
     "correctness": "0.0"
    },
    {
     "id": 922204,
     "content_html": "The ability to prevent others from making, using, offering for sale, or selling the invention.",
     "correctness": "1.0"
    },
    {
     "id": 922202,
     "content_html": "The ability to prevent others from learning the secrets of the invention.",
     "correctness": "0.0"
    },
    {
     "id": 922201,
     "content_html": "All of the above.",
     "correctness": "0.0"
    }
   ],
