 "questions": [
  {
   "id": 399509,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Patent owners have which of the following rights under the law?",
   "answers": [
    {
     "id": 922349,
     "content_html": "The exclusive right to “practice” the patent—meaning the exclusive right to make or sell products based on the patent.",
     "correctness": "0.0"
    },
    {
     "id": 922350,
     "content_html": "The right to exclude others from making, using, offering for sale, selling, or importing the invention covered by the patent throughout the United States.\n",
     "correctness": "1.0"
    },
    {
     "id": 922348,
     "content_html": "Both of these.\n",
     "correctness": "0.0"
    }
   ],
