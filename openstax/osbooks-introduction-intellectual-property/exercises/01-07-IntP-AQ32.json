 "questions": [
  {
   "id": 399495,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why would combining a camera with a cell phone in a smartphone pass the test for non-obviousness, whereas putting wheels from a chair onto an office cart would not?\n",
   "answers": [
    {
     "id": 922305,
     "content_html": "The technology in a smartphone is much more complicated.",
     "correctness": "0.0"
    },
    {
     "id": 922304,
     "content_html": "Putting wheels from a chair onto a cart is less difficult.",
     "correctness": "0.0"
    },
    {
     "id": 922306,
     "content_html": "Combining a camera and a cell phone produced an unexpected result.\n",
     "correctness": "1.0"
    }
