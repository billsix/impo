 "questions": [
  {
   "id": 399564,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Other than being one of the eight broad categories of creative content, which is NOT one of the other four things a copyrighted work must be.",
   "answers": [
    {
     "id": 922510,
     "content_html": "Original.\n",
     "correctness": "0.0"
    },
    {
     "id": 922509,
     "content_html": "Expressed or fixed on a tangible medium that can be seen or copied.",
     "correctness": "0.0"
    },
    {
     "id": 922508,
     "content_html": "Authored or creatively compiled.",
     "correctness": "0.0"
    },
    {
     "id": 922507,
     "content_html": "Not a fact or abstract idea.",
     "correctness": "0.0"
    },
    {
     "id": 922511,
     "content_html": "Culturally worthwhile.",
     "correctness": "1.0"
    }
