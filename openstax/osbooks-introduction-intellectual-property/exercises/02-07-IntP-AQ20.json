 "questions": [
  {
   "id": 399527,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the standard for imposing attorneys’ fees on the losing party to a patent suit?",
   "answers": [
    {
     "id": 922405,
     "content_html": "Convincing evidence of bad faith or gross negligence by the losing party.",
     "correctness": "0.0"
    },
    {
     "id": 922406,
     "content_html": "A case that “stands out from others” in the weakness of the plaintiff’s case or the unreasonable or abusive manner in which it was litigated.",
     "correctness": "1.0"
    }
   ],
