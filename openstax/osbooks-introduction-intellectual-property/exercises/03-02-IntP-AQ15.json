 "questions": [
  {
   "id": 399546,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What was the significance of the landmark <i>Donaldson v. Beckett</i> case in England?",
   "answers": [
    {
     "id": 922454,
     "content_html": "It established that copyright was the common law right of publishers."
    },
    {
     "id": 922455,
     "content_html": "It treated copyright as a limited right of authors for the first time anywhere."
    },
    {
     "id": 922453,
     "content_html": "It gave Thomas Beckett the right to his own work in perpetuity."
    }
   ],
