 "questions": [
  {
   "id": 399507,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In a second or subsequent examination, if the examiner finally rejects some or all of the claims, what can the applicant do at that point?",
   "answers": [
    {
     "id": 922343,
     "content_html": "Cancel the rejected claims, leaving only allowed claims.",
     "correctness": "0.0"
    },
    {
     "id": 922342,
     "content_html": "File what’s called a “continuation application.”",
     "correctness": "0.0"
    },
    {
     "id": 922341,
     "content_html": "Appeal to the Patent Trial and Appeal Board.\n",
     "correctness": "0.0"
    },
    {
     "id": 922344,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
