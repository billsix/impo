  {
   "id": 399532,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A copyright gives authors, artists, dramatists, architects, and other artistic creators the exclusive right to control what?",
   "answers": [
    {
     "id": 922422,
     "content_html": "How their work is published, reproduced, performed, or displayed.",
     "correctness": "1.0"
    },
    {
     "id": 922421,
     "content_html": "The price at which their work is sold, performed, or displayed.",
     "correctness": "0.0"
    },
    {
     "id": 922420,
     "content_html": "Whether or not the work becomes a classic on art, theater, or literature.\n",
     "correctness": "0.0"
    }
   ],
