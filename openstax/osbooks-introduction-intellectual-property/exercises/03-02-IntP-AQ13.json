 "questions": [
  {
   "id": 399544,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did the 1709 Statute of Anne do to copyright practices?",
   "answers": [
    {
     "id": 922448,
     "content_html": "It required that copyrights be given to multiple printers, not just one monopoly.",
     "correctness": "0.0"
    },
    {
     "id": 922447,
     "content_html": "It enabled copyrights to last as long as 150 years.",
     "correctness": "0.0"
    },
    {
     "id": 922449,
     "content_html": "It enabled anyone to get a copyright lasting 14 years with the right to renew.",
     "correctness": "1.0"
    }
   ],
