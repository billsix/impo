 "questions": [
  {
   "id": 399593,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Besides indicating the source of a good or service, how did trademarks change with the emergence of guilds in the Middle Ages?",
   "answers": [
    {
     "id": 922600,
     "content_html": "The guilds issued trademarks only to their own members.\n",
     "correctness": "0.0"
    },
    {
     "id": 922601,
     "content_html": "They became a means by which guilds could ensure the quality of work done by guild members.\n",
     "correctness": "1.0"
    },
    {
     "id": 922599,
     "content_html": "The guilds started charging money to issue a trademark.",
     "correctness": "0.0"
    }
   ],
