 "questions": [
  {
   "id": 399624,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes a trade secret?",
   "answers": [
    {
     "id": 922688,
     "content_html": "Information that many people do not know about how a product like a smartphone is made.\n",
     "correctness": "0.0"
    },
    {
     "id": 922689,
     "content_html": "Virtually any information that is of value as a result of not being generally known.\n",
     "correctness": "1.0"
    },
    {
     "id": 922687,
     "content_html": "Any information relating to the finances of a publicly held company.",
     "correctness": "0.0"
    }
   ],
