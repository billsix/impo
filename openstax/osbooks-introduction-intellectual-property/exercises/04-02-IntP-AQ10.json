 "questions": [
  {
   "id": 399595,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the significance of an old lawsuit known as <i>Sanforth’s Case</i>?",
   "answers": [
    {
     "id": 922607,
     "content_html": "It proves that 250 years before the Industrial Revolution, trademark infringement was viewed as deceit and a violation of laws against unfair competition.",
     "correctness": "0.0"
    },
    {
     "id": 922606,
     "content_html": "It is the first trademark infringement case known to be recorded.",
     "correctness": "0.0"
    },
    {
     "id": 922605,
     "content_html": "It serves as the foundation for modern trademark laws and policies.\n",
     "correctness": "0.0"
    },
    {
     "id": 922608,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
   ],
