 "questions": [
  {
   "id": 399621,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is true about trademark remedies?\n",
   "answers": [
    {
     "id": 922681,
     "content_html": "Damages can be significantly increased if trademark infringement is deemed willful.\n",
     "correctness": "1.0"
    },
    {
     "id": 922680,
     "content_html": "Courts frequently use injunctions based on trademark law to stop the importation of products that once carried infringing marks even after those marks have been removed.\n",
     "correctness": "0.0"
    },
    {
     "id": 922679,
     "content_html": "Federal trademark law also provides for punitive damages for trademark infringement.\n",
     "correctness": "0.0"
    }
   ],
