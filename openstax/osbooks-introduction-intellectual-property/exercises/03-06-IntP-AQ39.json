   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If attorneys could demonstrate in court that Kanye West “sampled” or used pieces of Sly Johnson’s song “Different Strokes” in a song called “The Joy,” this would be evidence of what kind of copyright infringement?",
   "answers": [
    {
     "id": 922527,
     "content_html": "Comprehensive nonliteral similarity.",
     "correctness": "0.0"
    },
    {
     "id": 922528,
     "content_html": "Fragmented literal similarity.\n",
     "correctness": "1.0"
    }
