 "questions": [
  {
   "id": 399622,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A party may be permitted the fair use of another’s trademark under two conditions, known as <b>nominative fair use<b> and <b>classic fair use<b>. Which of the following is an example of nominative fair use?</b></b></b></b>",
   "answers": [
    {
     "id": 922683,
     "content_html": "When a business compares its products with those of a competitor, with no intent to confuse customers as to the source of the competitor’s goods.",
     "correctness": "0.0"
    },
    {
     "id": 922684,
     "content_html": "When a trademark of another is used to refer to that other’s goods or services in legitimate\nconnection with one’s own, such as a notice on the packaging of a small company’s graphic design program that it can run on the Microsoft Windows operating system.",
     "correctness": "1.0"
    },
    {
     "id": 922682,
     "content_html": "Both of the above are correct.",
     "correctness": "0.0"
    }
   ],
