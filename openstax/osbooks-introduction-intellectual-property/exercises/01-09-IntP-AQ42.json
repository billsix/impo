 "questions": [
  {
   "id": 399505,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is the best strategy in drafting claims in a patent application?",
   "answers": [
    {
     "id": 922336,
     "content_html": "Draft them as broadly as possible, to cover every possible use of the invention.",
     "correctness": "0.0"
    },
    {
     "id": 922335,
     "content_html": "Draft them as narrowly as possible, so the examiner won’t reject them.\n",
     "correctness": "0.0"
    },
    {
     "id": 922337,
     "content_html": "Draft them as broadly as the specifications and the prior art allows, then back up those broad claims with successively narrower claims as backup.",
     "correctness": "1.0"
    }
   ],
