 "questions": [
  {
   "id": 399512,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following illustrates the “doctrine of equivalents”?",
   "answers": [
    {
     "id": 922358,
     "content_html": "If a device performs substantially the same function in substantially the same way as your patent claim, infringement exists if any differences are insignificant.",
     "correctness": "0.0"
    },
    {
     "id": 922357,
     "content_html": "A patent calling for an “adhesive” connection (describing glue as the preferred adhesive) may be infringed by a device using a Velcro® fastener.",
     "correctness": "0.0"
    },
    {
     "id": 922359,
     "content_html": "Both of the above are correct.\n",
     "correctness": "1.0"
    }
   ],
