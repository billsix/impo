 "questions": [
  {
   "id": 399531,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is the definition of a “patent troll”?",
   "answers": [
    {
     "id": 922418,
     "content_html": "A patent owner who licenses their patents rather than makes or sells products."
    },
    {
     "id": 922417,
     "content_html": "A patent owner whose main source of revenue is patent litigation."
    },
    {
     "id": 922419,
     "content_html": "A patent owner whose main source of revenue is “nuisance settlements” for less than the cost of litigation."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": []
  }
 ],
