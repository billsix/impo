 "questions": [
  {
   "id": 399579,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One of the four factors considered in whether the copying or use of a copyrighted work is considered to be fair use is “the purpose and character of the use, including whether such use is of a commercial nature or is for nonprofit educational purposes.” Which of the following would likely be considered fair use?",
   "answers": [
    {
     "id": 922553,
     "content_html": "A profit-making magazine like <i>Vanity Fair</i> publishes a book review that quotes several thousand words of the copyrighted book being reviewed.",
     "correctness": "1.0"
    },
    {
     "id": 922552,
     "content_html": "A nonprofit university distributes copies of two chapters of a copyrighted textbook to its students so they don’t have to buy the textbook itself.",
     "correctness": "0.0"
    }
   ],
