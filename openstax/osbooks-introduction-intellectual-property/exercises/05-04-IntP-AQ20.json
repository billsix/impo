   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of these is an example of “passive disclosure” of a trade secret?",
   "answers": [
    {
     "id": 922739,
     "content_html": "Leaving confidential documents lying around for anyone to see.",
     "correctness": "1.0"
    },
    {
     "id": 922738,
     "content_html": "Inadvertently disseminating information at trade shows or conferences.",
     "correctness": "0.0"
    },
    {
     "id": 922737,
     "content_html": "Disclosing confidential information in press releases, newspaper articles, or marketing collateral.",
     "correctness": "0.0"
    }
