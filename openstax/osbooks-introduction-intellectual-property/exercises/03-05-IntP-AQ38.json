 "questions": [
  {
   "id": 399569,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Registration used to be required for a copyright. When did that requirement end?",
   "answers": [
    {
     "id": 922525,
     "content_html": "1976, with the passage of the Copyright Act.\n",
     "correctness": "0.0"
    },
    {
     "id": 922524,
     "content_html": "1909, when Congress passed the Copyright Act of 1909.",
     "correctness": "0.0"
    },
    {
     "id": 922526,
     "content_html": "1989, after the United States joined the international Berne Convention.",
     "correctness": "1.0"
    }
   ],
