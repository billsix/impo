 "questions": [
  {
   "id": 399582,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why was the Sonny Bono Copyright Term Extension Act of 1998 so controversial?",
   "answers": [
    {
     "id": 922562,
     "content_html": "It put all of Sonny and Cher’s formerly copyrighted music into the public domain.\n",
     "correctness": "0.0"
    },
    {
     "id": 922561,
     "content_html": "It reduced the copyright term to that favored by the Founding Fathers—28 years.",
     "correctness": "0.0"
    },
    {
     "id": 922563,
     "content_html": "It extended copyright an additional 20 years to the life of the author plus 70 years.\n",
     "correctness": "1.0"
    }
   ],
