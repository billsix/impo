 "questions": [
  {
   "id": 399530,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "As an alternative to litigation, mediation is different from arbitration in what way?",
   "answers": [
    {
     "id": 922415,
     "content_html": "Mediations result in settlements only if both parties agree."
    },
    {
     "id": 922414,
     "content_html": "In arbitrations, the parties are bound by the decision of the arbitrator."
    },
    {
     "id": 922416,
     "content_html": "Both of these are accurate."
    }
   ],
