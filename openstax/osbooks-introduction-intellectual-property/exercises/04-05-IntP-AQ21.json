 "questions": [
  {
   "id": 399606,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What’s the difference between a design protected as a trademark and trade dress?\n",
   "answers": [
    {
     "id": 922637,
     "content_html": "A trademark-protected design consists of a discrete symbol or logo on the product or service, whereas trade dress is its overall “look and feel.”\n",
     "correctness": "0.0"
    },
    {
     "id": 922636,
     "content_html": "A trademarked trade dress covers a product or service’s overall features like its size, shape, and color combinations rather than a particular symbol or design.",
     "correctness": "0.0"
    },
    {
     "id": 922638,
     "content_html": "Both of these.",
     "correctness": "1.0"
    }
   ],
