 "questions": [
  {
   "id": 399637,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Would a customer list always be considered a trade secret?",
   "answers": [
    {
     "id": 922724,
     "content_html": "It depends on whether the customers want to be identified or not.",
     "correctness": "0.0"
    },
    {
     "id": 922725,
     "content_html": "To be considered a trade secret, the names of customers must not be available or discernable through public sources.",
     "correctness": "1.0"
    }
   ],
