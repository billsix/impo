   "id": 399589,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What value do trademarks provide society?",
   "answers": [
    {
     "id": 922587,
     "content_html": "They encourage and reward creative enterprise.",
     "correctness": "0.0"
    },
    {
     "id": 922586,
     "content_html": "They marshal the benefits of this creativity to the public good.",
     "correctness": "0.0"
    },
    {
     "id": 922585,
     "content_html": "They protect the consumer from deception.\n",
     "correctness": "0.0"
    },
    {
     "id": 922588,
     "content_html": "All of the above.",
     "correctness": "1.0"
    }
