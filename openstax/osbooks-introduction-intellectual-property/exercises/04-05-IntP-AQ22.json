 "questions": [
  {
   "id": 399607,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In what way are trademarked designs and trade dress similar to design patents?",
   "answers": [
    {
     "id": 922640,
     "content_html": "All three protect the unique look of a company’s products from being infringed.",
     "correctness": "0.0"
    },
    {
     "id": 922639,
     "content_html": "All three protect only the nonfunctional elements of the product’s appearance.",
     "correctness": "0.0"
    },
    {
     "id": 922641,
     "content_html": "Both of these.\n",
     "correctness": "1.0"
    }
   ],
