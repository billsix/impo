 "questions": [
  {
   "id": 399627,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is one key advantage of trade secret protection versus patent protection?",
   "answers": [
    {
     "id": 922698,
     "content_html": "It protects the information to be kept secret indefinitely.",
     "correctness": "1.0"
    },
    {
     "id": 922697,
     "content_html": "It prevents others from ever independently deriving the same information.",
     "correctness": "0.0"
    },
    {
     "id": 922696,
     "content_html": "Both of the above are correct.",
     "correctness": "0.0"
    }
   ],
