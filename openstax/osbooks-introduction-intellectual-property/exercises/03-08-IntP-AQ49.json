   "id": 399580,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What major change in copyright law was NOT made in the Copyright Act of 1976?",
   "answers": [
    {
     "id": 922555,
     "content_html": "It extended copyright to performances via cable television.",
     "correctness": "0.0"
    },
    {
     "id": 922556,
     "content_html": "It prohibited the unauthorized rental or lease of computer software programs.",
     "correctness": "1.0"
    },
    {
     "id": 922554,
     "content_html": "It codified fair use into the statutes.",
     "correctness": "0.0"
    }
