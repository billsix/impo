 "questions": [
  {
   "id": 399526,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What’s the standard for proving willful infringement, leading to enhanced damages?",
   "answers": [
    {
     "id": 922403,
     "content_html": "Selling a product despite knowing that a patent exists that the product might be infringing.",
     "correctness": "0.0"
    },
    {
     "id": 922404,
     "content_html": "Selling a product despite an objectively high likelihood that it infringed a valid patent and that this risk was known or should have been known to the infringer.",
     "correctness": "1.0"
    },
    {
     "id": 922402,
     "content_html": "Deliberately not conducting a prior art search to determine if a patent exists that your product might be infringing.",
     "correctness": "0.0"
    }
   ],
