  {
   "id": 480163,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes a type of sex difference in brain circuits?",
   "answers": [
    {
     "id": 970988,
     "content_html": "The same neural circuit always drives identical behaviors in both males and females.",
     "correctness": "0.0"
    },
    {
     "id": 970989,
     "content_html": "Some neural circuits are more sensitive to changes in one sex, leading to differences in the strength or duration of the response.",
     "correctness": "1.0"
    },
    {
     "id": 970990,
     "content_html": "All neural circuits respond equally to environmental changes in both sexes.",
     "correctness": "0.0"
    },
    {
     "id": 970991,
     "content_html": "Oxytocin has the same effect on social behaviors in both males and females.",
     "correctness": "0.0"
    }
