   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following will cause an on-center bipolar cell to depolarize the most?",
   "answers": [
    {
     "id": 1176255,
     "content_html": "Light in the center of its receptive field"
    },
    {
     "id": 1176254,
     "content_html": "Light in the surround of its receptive field"
    },
    {
     "id": 1176253,
     "content_html": "Light in both the center and surround of its receptive field"
    },
    {
     "id": 1176252,
     "content_html": "Dark in the center of its receptive field"
    }
