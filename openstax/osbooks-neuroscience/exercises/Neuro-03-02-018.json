 "questions": [
  {
   "id": 389626,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The function of any neurotransmitter depends on:",
   "answers": [
    {
     "id": 917940,
     "content_html": "the function of the structures in which they are located."
    },
    {
     "id": 917941,
     "content_html": "whether the transmitter is lipid or water soluble."
    },
    {
     "id": 917942,
     "content_html": "the number of amine and carboxyl groups that are on the carbon chain backbone."
    },
    {
     "id": 917943,
     "content_html": "whether they bind to an ion channel or a G-protein linked receptor."
    }
   ],
