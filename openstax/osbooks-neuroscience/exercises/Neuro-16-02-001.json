   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How does the medullary respiratory control center (MRCC) indirectly sense blood oxygenation levels?",
   "answers": [
    {
     "id": 935548,
     "content_html": "By measuring the concentration of carbon dioxide"
    },
    {
     "id": 935549,
     "content_html": "By directly sensing oxygen in the lungs"
    },
    {
     "id": 935550,
     "content_html": "By detecting changes in heart rate"
    },
    {
     "id": 935551,
     "content_html": "By measuring the pH (acidity) of the blood"
    }
