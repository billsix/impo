 "questions": [
  {
   "id": 438172,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is the best description of a difference between someone with hemianopia and spatial neglect?",
   "answers": [
    {
     "id": 933522,
     "content_html": "Neglect patients are typically anosagnosic, but hemianopic patients are typically not",
     "correctness": "1.0"
    },
    {
     "id": 933523,
     "content_html": "Hemianopic patients are typically anosagnosic, but neglect patients are typically not",
     "correctness": "0.0"
    },
    {
     "id": 933524,
     "content_html": "Hemianopia typically results from right parietal lobe damage, whereas neglect typically results from left parietal damage",
     "correctness": "0.0"
    },
    {
     "id": 933525,
     "content_html": "Hemianopia can occur in different frames of reference, whereas neglect can only occur in one frame of reference",
     "correctness": "0.0"
    }
   ],
