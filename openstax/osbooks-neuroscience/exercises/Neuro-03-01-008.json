   "id": 389613,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The fusion of a synaptic vesicle at the axonal terminal requires:",
   "answers": [
    {
     "id": 917900,
     "content_html": "the action of voltage-dependent sodium channels."
    },
    {
     "id": 917901,
     "content_html": "the inhibition of potassium channels."
    },
    {
     "id": 917902,
     "content_html": "the opening of voltage-dependent calcium channels."
    },
    {
     "id": 917903,
     "content_html": "an elevation in the intracellular concentration of potassium ions."
    }
   ],
