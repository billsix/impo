 "questions": [
  {
   "id": 386107,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the Gate Control Theory of pain, why does touch sensation reduce pain sensation?",
   "answers": [
    {
     "id": 912923,
     "content_html": "Because the brain centers for interpreting pain can only handle limited input and adding touch information overwhelms pain processing."
    },
    {
     "id": 912924,
     "content_html": "Because A-beta fibers have inhibitory connections to pain projection neurons."
    },
    {
     "id": 912925,
     "content_html": "Because C fibers have touch receptors that are inhibitory."
    },
    {
     "id": 912926,
     "content_html": "Because C fibers are unmyelinated and slow."
    }
   ],
