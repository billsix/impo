 "questions": [
  {
   "id": 461198,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a major reason that early researchers thought the brain had no immune system?",
   "answers": [
    {
     "id": 960230,
     "content_html": "The BBB kept most innate and adaptive immune cells out of the brain"
    },
    {
     "id": 960231,
     "content_html": "There were no diseases that affected the brain"
    },
    {
     "id": 960232,
     "content_html": "Transplants in the brain were not generally immune rejected"
    },
    {
     "id": 960233,
     "content_html": "MHC expression levels were very low under healthy conditions"
    }
   ],
