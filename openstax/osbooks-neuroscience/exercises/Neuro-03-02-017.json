   "stimulus_html": "",
   "stem_html": "The function of any receptor: ",
   "answers": [
    {
     "id": 917936,
     "content_html": "depends upon the region of the brain the receptor is located.",
     "correctness": "1.0"
    },
    {
     "id": 917937,
     "content_html": "is largely independent of the nature of its second messenger.",
     "correctness": "0.0"
    },
    {
     "id": 917938,
     "content_html": "is determined by the water solubility of its components.",
     "correctness": "0.0"
    },
    {
     "id": 917939,
     "content_html": "is related to the identity of its receptor, e.g., dopamine will always close sodium channels.",
     "correctness": "0.0"
    }
