 "questions": [
  {
   "id": 430012,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is the best description of the hippocampus?",
   "answers": [
    {
     "id": 929826,
     "content_html": "A three-layered structure in the temporal lobe that encodes episodic and spatial memories"
    },
    {
     "id": 929827,
     "content_html": "A six-layered structure in the neocortex that stores all learned information"
    },
    {
     "id": 929828,
     "content_html": "A nucleus in the basal ganglia that encodes procedural skills"
    },
    {
     "id": 929829,
     "content_html": "A small gland in the hypothalamus that secretes memory-promoting hormones"
    }
   ],
