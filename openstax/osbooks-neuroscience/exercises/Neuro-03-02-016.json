   "stimulus_html": "",
   "stem_html": "The purpose of ascorbic acid inside of the synaptic vesicles is to:",
   "answers": [
    {
     "id": 917932,
     "content_html": "act as a co-factor for dopamine-beta-hydroxylase."
    },
    {
     "id": 917933,
     "content_html": "act as an anti-oxidizing agent."
    },
    {
     "id": 917934,
     "content_html": "act as an anti-reducing agent."
    },
    {
     "id": 917935,
     "content_html": "keep the pH of the vesicle acidic."
    }
