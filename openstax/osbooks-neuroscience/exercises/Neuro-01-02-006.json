   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The brain requires large amounts of blood to maintain its functions. This blood derives from 2 main arteries. The more ventral artery is called ________ while the more dorsal artery is ________. ",
   "answers": [
    {
     "id": 959822,
     "content_html": "carotid artery / vertebral artery "
    },
    {
     "id": 959823,
     "content_html": "cerebral arteries / vertebral artery"
    },
    {
     "id": 959824,
     "content_html": "ventral cerebral artery / dorsal cerebral artery"
    },
    {
     "id": 959825,
     "content_html": "vertebral artery / carotid artery"
    }
   ],
