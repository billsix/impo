 "questions": [
  {
   "id": 480138,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is the concept of natural selection crucial to understanding sexual dimorphism?",
   "answers": [
    {
     "id": 970904,
     "content_html": "It explains why traits develop independently of reproductive success"
    },
    {
     "id": 970905,
     "content_html": "It shows how traits beneficial for survival are unrelated to reproduction"
    },
    {
     "id": 970906,
     "content_html": "It highlights how traits beneficial for mating increase reproductive success"
    },
    {
     "id": 970907,
     "content_html": "It negates the importance of sexual selection"
    }
   ],
