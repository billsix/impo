   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Neurons that make up the hypoglossal cranial nerve (#12), and a motoneuron from the ventrolateral spine, are both <b><i>lower</i></b> motoneurons because (by definition) they:",
   "answers": [
    {
     "id": 933090,
     "content_html": "are involved in motor control.",
     "correctness": "0.0"
    },
    {
     "id": 933091,
     "content_html": "reside in motoric-associated regions of the nervous system.",
     "correctness": "0.0"
    },
    {
     "id": 933092,
     "content_html": "project directly to muscles.",
     "correctness": "1.0"
    },
    {
     "id": 933093,
     "content_html": "release acetylcholine as their neurotransmitter.",
     "correctness": "0.0"
    }
