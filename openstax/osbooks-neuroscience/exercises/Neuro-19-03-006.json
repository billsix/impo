 "questions": [
  {
   "id": 438164,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One example of the cocktail party effect is when you are at a crowded party, you might hear someone across the room say the name of your high school even if you weren’t paying attention to their conversation.  Which of the following predictions would be true about this effect based on the perceptual load theory?",
   "answers": [
    {
     "id": 933494,
     "content_html": "If the conversation that you’re currently in is boring, then you’ll be less likely to hear the name of your high school because fewer attentional resources will be available"
    },
    {
     "id": 933495,
     "content_html": "If the conversation that you’re listening to is especially interesting, then you’ll be more likely to hear the name of your high school, because additional attentional resources will be devoted to the current conversation"
    },
    {
     "id": 933496,
     "content_html": "If the conversation that you’re listening to is especially interesting, then you’ll be less likely to hear the name of your high school, because additional attentional resources will be devoted to the background conversations"
    },
    {
     "id": 933497,
     "content_html": "If the conversation that you’re currently in is boring, then you’ll be more likely to hear the name of your high school because more attentional resources will be available"
    }
   ],
