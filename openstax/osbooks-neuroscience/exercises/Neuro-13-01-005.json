   "id": 422894,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Cannon-Bard position was strengthened by their observation that cats display species typical emotional reactions to threatening stimuli, even when:",
   "answers": [
    {
     "id": 926925,
     "content_html": "the flow of information from the viscera to the brain is interrupted by severing visceral and spinal nerves.",
     "correctness": "1.0"
    },
    {
     "id": 926926,
     "content_html": "body to brain communication is blocked by removing the vagus nerve.",
     "correctness": "0.0"
    },
    {
     "id": 926927,
     "content_html": "the hypothalamus is damaged.",
     "correctness": "0.0"
    },
    {
     "id": 926928,
     "content_html": "they are placed in direct opposition to an angry dog.",
     "correctness": "0.0"
    }
