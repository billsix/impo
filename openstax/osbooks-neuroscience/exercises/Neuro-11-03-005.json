   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What role do dendritic spines in the hippocampus play in response to ovarian hormones?",
   "answers": [
    {
     "id": 970972,
     "content_html": "They undergo rapid and reversible changes in response to hormone levels",
     "correctness": "1.0"
    },
    {
     "id": 970973,
     "content_html": "They remain unchanged regardless of hormone fluctuations",
     "correctness": "0.0"
    },
    {
     "id": 970974,
     "content_html": "They are involved in regulating stress hormones",
     "correctness": "0.0"
    },
    {
     "id": 970975,
     "content_html": "They decrease in number as hormone levels rise",
     "correctness": "0.0"
    }
