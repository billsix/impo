 "questions": [
  {
   "id": 386161,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the function of the inner hair cells in the cochlea?",
   "answers": [
    {
     "id": 913057,
     "content_html": "To convert the physical energy of acoustic waves into neural signals."
    },
    {
     "id": 913058,
     "content_html": "To protect the cochlea from overstimulation."
    },
    {
     "id": 913059,
     "content_html": "To amplify low-intensity sounds."
    },
    {
     "id": 913060,
     "content_html": "To regulate the pressure within the cochlea."
    }
   ],
