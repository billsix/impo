  {
   "id": 464589,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Imagine a rodent has a small stroke that destroys their bilateral SCN. What would happen to their activity rhythm?",
   "answers": [
    {
     "id": 965925,
     "content_html": "Their activity rhythm would shift earlier a bit",
     "correctness": "0.0"
    },
    {
     "id": 965926,
     "content_html": "Their rhythm would continue but would no longer entrain to changes in external light cues",
     "correctness": "0.0"
    },
    {
     "id": 965927,
     "content_html": "Not much would happen",
     "correctness": "0.0"
    },
    {
     "id": 965928,
     "content_html": "Their rhythm would become disorganized",
     "correctness": "1.0"
    }
   ],
