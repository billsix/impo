  {
   "id": 396457,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Birds lack distinct grey and white matter in their telencephalon:",
   "answers": [
    {
     "id": 921321,
     "content_html": "because they don’t have myelin."
    },
    {
     "id": 921322,
     "content_html": "because they don’t have neurons."
    },
    {
     "id": 921323,
     "content_html": "because their neurons are organized in nuclei instead of layers."
    },
    {
     "id": 921324,
     "content_html": "because the axons in birds are interspersed through among cell bodies and are not bundled together in large, distinct groups."
    }
   ],
