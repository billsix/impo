   "id": 439291,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about the neurotrophic model is true?",
   "answers": [
    {
     "id": 933802,
     "content_html": "It proposes that reduced levels of BDNF in the brain contribute to the development of depression"
    },
    {
     "id": 933803,
     "content_html": "It proposes that increased levels of neurotrophins contributes to the development of depression"
    },
    {
     "id": 933804,
     "content_html": "It proposes that depression is primarily caused by chemical imbalances in the brain"
    },
    {
     "id": 933805,
     "content_html": "It proposes that genetics play a minimal role in depression"
    }
