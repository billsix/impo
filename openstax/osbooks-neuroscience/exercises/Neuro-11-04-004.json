  {
   "id": 480164,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements best describes the role of gonadal steroid hormones in sex differences in stress hormone responses?",
   "answers": [
    {
     "id": 970992,
     "content_html": "Removal of the testes in males decreases activation of stress responses."
    },
    {
     "id": 970993,
     "content_html": "Androgen replacement in castrated males normalizes stress hormone levels, suggesting activational effects of androgens."
    },
    {
     "id": 970994,
     "content_html": "Early developmental testosterone treatment reduces stress responses in female mice."
    },
    {
     "id": 970995,
     "content_html": "Ovariectomy in females increases the activation of stress systems."
    }
   ],
