 "questions": [
  {
   "id": 413887,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement about papillae is false?",
   "answers": [
    {
     "id": 925924,
     "content_html": "Filiform papillae are cone-shaped, lack taste buds, and are found on the top surface of the tongue. "
    },
    {
     "id": 925925,
     "content_html": "Fungiform papillae are mushroom-shaped and can be found scattered over the surface on the tongue; taste buds are located on top of their smooth domes."
    },
    {
     "id": 925926,
     "content_html": "Foliate papillae are found in the pharynx and lack in taste buds."
    },
    {
     "id": 925927,
     "content_html": "Circumvallate papillae are found lining the anterior surface of the tongue."
    }
   ],
