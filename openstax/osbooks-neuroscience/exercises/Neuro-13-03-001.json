   "stimulus_html": "",
   "stem_html": "Skin conductance response (SCR) is a reliable indicator of physiological changes since this type of measurement:",
   "answers": [
    {
     "id": 927013,
     "content_html": "is accurate in identifying the source of the arousal from changes in heart rate, blood pressure or respiration."
    },
    {
     "id": 927014,
     "content_html": "can detect general elevations in sympathetic nervous system activity."
    },
    {
     "id": 927015,
     "content_html": "is useful in denoting when parasympathetic activity dominates over sympathetic nervous system activity."
    },
    {
     "id": 927016,
     "content_html": "None of the above"
    }
