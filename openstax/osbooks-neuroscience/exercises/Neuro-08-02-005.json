 "questions": [
  {
   "id": 413891,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement about olfactory coding is false?",
   "answers": [
    {
     "id": 925940,
     "content_html": "Cross-fiber pattern coding allows for a few receptors or lines to encode many modalities (as in the olfactory system), while labeled line coding requires a discrete circuit or line for each possible modality."
    },
    {
     "id": 925941,
     "content_html": "In labeled line coding a stimulus triggers the most efficient response through a discrete pathway or circuit starting from a specific type of receptor cells to specific neurons that pass to higher and higher brain regions where a single sensory modality is represented by activity in this “line” of cells."
    },
    {
     "id": 925942,
     "content_html": "In cross-fiber pattern coding, there is no overlap between the neurons activated by both stimuli"
    },
    {
     "id": 925943,
     "content_html": "In cross-fiber pattern coding a stimulus triggers activity in multiple circuits or “lines” which together encodes for a particular sensory modality."
    }
   ],
