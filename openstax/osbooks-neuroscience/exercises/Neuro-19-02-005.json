 "questions": [
  {
   "id": 438157,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Imagine that you are closely watching a computer monitor at the Department of Motor Vehicles that will cue you whether you should go to the customer service agent just to the left or to the right of the monitor for your appointment.  Which brain network would most likely be engaged by the computer monitor in this situation?",
   "answers": [
    {
     "id": 933470,
     "content_html": "The default mode network"
    },
    {
     "id": 933471,
     "content_html": "The fusiform face area"
    },
    {
     "id": 933472,
     "content_html": "The dorsal attentional network"
    },
    {
     "id": 933473,
     "content_html": "The ventral attentional network"
    }
   ],
