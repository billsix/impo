   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Selective serotonin reuptake inhibitors have been shown to reduce chronic pain in some cases. Where could these drugs be acting to have this effect?",
   "answers": [
    {
     "id": 913003,
     "content_html": "At the terminals of dorsal raphe serotonergic neurons in the limbic system\n",
     "correctness": "0.0"
    },
    {
     "id": 913004,
     "content_html": "In the spinal cord terminals of dorsal raphe serotonergic neurons\n",
     "correctness": "0.0"
    },
    {
     "id": 913005,
     "content_html": "Both A and B",
     "correctness": "1.0"
