   "stimulus_html": "",
   "stem_html": "What role does aromatase play in the masculinization of the brain?",
   "answers": [
    {
     "id": 970944,
     "content_html": "It converts testosterone into estrogen"
    },
    {
     "id": 970945,
     "content_html": "It degrades testosterone"
    },
    {
     "id": 970946,
     "content_html": "It inhibits androgen receptors"
    },
    {
     "id": 970947,
     "content_html": "It promotes the secretion of anti-Müllerian hormone"
    }
