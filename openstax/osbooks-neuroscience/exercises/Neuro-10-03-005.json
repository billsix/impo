 "questions": [
  {
   "id": 438032,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Dopamine is a(n) ________ neurotransmitter that ________.",
   "answers": [
    {
     "id": 933346,
     "content_html": "ionotropic / excites neurons that it influences like all excitatory neurotransmitters"
    },
    {
     "id": 933347,
     "content_html": "modulatory / acts as movement juice and biases all movement neuronal systems towards activation of movement"
    },
    {
     "id": 933348,
     "content_html": "modulatory / largely adjusts the way neurons within the caudate and putamen targets respond to more rapid ionotropic stimulation"
    },
    {
     "id": 933349,
     "content_html": "ionotropic / inhibits neurons that it influences like all inhibitory neurotransmitters"
    }
   ],
