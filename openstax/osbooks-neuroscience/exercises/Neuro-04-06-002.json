   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Brain organoids mimic many steps of neural development in real brains. If you gave a birth-date marker very early in organoid development then looked for that marker much later, where would you find it?",
   "answers": [
    {
     "id": 924703,
     "content_html": "In the inner layers of the organoid",
     "correctness": "1.0"
    },
    {
     "id": 924704,
     "content_html": "In the outer layers of the organoid",
     "correctness": "0.0"
    },
    {
     "id": 924705,
     "content_html": "Spread throughout the organoid",
     "correctness": "0.0"
