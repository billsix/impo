 "questions": [
  {
   "id": 446491,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During an immediate threat to survival, what does allostasis allow an organism to do?",
   "answers": [
    {
     "id": 935536,
     "content_html": "Maintain internal physiological conditions within the normal range",
     "correctness": "0.0",
     "feedback_html": ""
    },
    {
     "id": 935537,
     "content_html": "Increase the speed by which control and effector systems counteract deviations from a set point",
     "correctness": "0.0"
    },
    {
     "id": 935538,
     "content_html": "Persevere against short-term challenges by temporarily adjusting set points",
     "correctness": "1.0"
    },
    {
     "id": 935539,
     "content_html": "Ignore environmental challenges for a brief period",
     "correctness": "0.0"
    }
   ],
