   "id": 422947,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The experimental procedures Paul Eckman used to generate his initial findings on <i>emotion identification</i> were also applied to three separate groups of non-English speaking natives in New Guinea. It was necessary for Eckman to conduct this study to:",
   "answers": [
    {
     "id": 927001,
     "content_html": "verify the ability to perceive emotions in previous studies was not the result of exposure to Western cultural influences such as television, magazines, or movies.",
     "correctness": "1.0"
    },
    {
     "id": 927002,
     "content_html": "determine if separate non-Western cultures experienced all of the 6 basic emotions.",
     "correctness": "0.0"
    },
    {
     "id": 927003,
     "content_html": "prove that nomadic cultures exposed to environmental dangers on a daily basis are less skilled at identifying emotional responses of fear and surprise.",
     "correctness": "0.0"
    },
    {
     "id": 927004,
     "content_html": "Only b and c",
     "correctness": "0.0"
    }
   ],
