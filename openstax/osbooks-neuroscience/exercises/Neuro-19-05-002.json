   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to the hemispheric rivalry hypothesis, how does neglect arise after damage to one hemisphere?",
   "answers": [
    {
     "id": 933514,
     "content_html": "Damage allows for the revival of the hemisphere drawing attention",
     "correctness": "0.0"
    },
    {
     "id": 933515,
     "content_html": "Attention is drawn disproportionately to the contralesional side",
     "correctness": "0.0"
    },
    {
     "id": 933516,
     "content_html": "Attention is drawn disproportionately to the ipsilesional side",
     "correctness": "1.0"
    },
    {
     "id": 933517,
     "content_html": "Neglect rivals perception in terms of attentional detail",
     "correctness": "0.0"
