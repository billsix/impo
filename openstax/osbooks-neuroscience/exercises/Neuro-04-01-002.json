   "stimulus_html": "",
   "stem_html": "IACUC review of proposed animal studies focuses on:\n\n",
   "answers": [
    {
     "id": 921297,
     "content_html": "ensuring that the animals do not feel pain and/or that measures are taken to minimize pain."
    },
    {
     "id": 921298,
     "content_html": "keeping costs low for the researchers."
    },
    {
     "id": 921299,
     "content_html": "checking that the researchers have sufficient funding to perform the research."
    },
    {
     "id": 921300,
     "content_html": "All the above."
