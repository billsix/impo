     "content_html": "Because they have the widest diameter."
    },
    {
     "id": 912908,
     "content_html": "Because they have the most myelination."
    },
    {
     "id": 912909,
     "content_html": "Both A and B."
    },
    {
     "id": 912910,
     "content_html": "Neither A nor B."
