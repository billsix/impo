 "questions": [
  {
   "id": 438169,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the context of spatial neglect, to what does the term “contralesional” refer? ",
   "answers": [
    {
     "id": 933510,
     "content_html": "Brain damage that contradicts a medical diagnosis"
    },
    {
     "id": 933511,
     "content_html": "Brain damage that results in problems with the opposite side of space"
    },
    {
     "id": 933512,
     "content_html": "Brain damage that, contradictorily, results in problems with the same side of space"
    },
    {
     "id": 933513,
     "content_html": "A medical diagnosis that is contraindicated"
    }
   ],
