   "stimulus_html": "",
   "stem_html": "Which of the following is a characteristic of vestibular reflexes?",
   "answers": [
    {
     "id": 913121,
     "content_html": "They are among the slowest in the body."
    },
    {
     "id": 913122,
     "content_html": "They are among the fastest in the body."
    },
    {
     "id": 913123,
     "content_html": "They are complex and involve a large number of synapses."
    },
    {
     "id": 913124,
     "content_html": "They are only found in primitive mammals."
    }
