 "questions": [
  {
   "id": 403075,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the partner preference assay, a male vole spends more time near a female previously mated with than near a new female. What is most likely true about this male vole?",
   "answers": [
    {
     "id": 924691,
     "content_html": "The male vole is a member of a monogamous pair-bonding species."
    },
    {
     "id": 924692,
     "content_html": "The male vole is a member of a polygamous species."
    },
    {
     "id": 924693,
     "content_html": "The male vole is an odd exception to the rule; rodents usually prefer novel partners."
    },
    {
     "id": 924694,
     "content_html": "It is a mystery what is going on here."
    }
   ],
