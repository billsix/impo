   "stimulus_html": "",
   "stem_html": "A motor unit consists of:",
   "answers": [
    {
     "id": 959388,
     "content_html": "a muscle cell/fiber."
    },
    {
     "id": 959389,
     "content_html": "a motoneuron and all the muscle cells/fibers with which it synapses."
    },
    {
     "id": 959390,
     "content_html": "an anatomically defined muscle bundle such as the triceps muscle."
    },
    {
     "id": 959391,
     "content_html": "all motoneurons that connect to muscle cells/fibers pulling a limb in the same direction."
    }
   ],
