 "questions": [
  {
   "id": 480140,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the key difference between mitosis and meiosis?",
   "answers": [
    {
     "id": 970912,
     "content_html": "Mitosis results in haploid cells, meiosis in diploid cells"
    },
    {
     "id": 970913,
     "content_html": "Mitosis occurs only in gametes, meiosis in somatic cells"
    },
    {
     "id": 970914,
     "content_html": "Mitosis creates two identical cells, meiosis produces four genetically unique cells"
    },
    {
     "id": 970915,
     "content_html": "Mitosis is a form of sexual reproduction, meiosis is asexual"
    }
   ],
