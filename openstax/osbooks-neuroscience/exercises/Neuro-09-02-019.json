  {
   "id": 364478,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You have encountered a patient in a clinic reporting widespread loss of <b>pain and sensation</b> on her <b>left side</b> after a recent fall. Where would her injury most likely be to cause these symptoms?\n\n\n",
   "answers": [
    {
     "id": 881992,
     "content_html": "In her right cortex\n",
     "correctness": "1.0"
    },
    {
     "id": 881993,
     "content_html": "In her left cortex\n",
     "correctness": "0.0"
    },
    {
     "id": 881994,
     "content_html": "In her right thoracic spine\n",
     "correctness": "0.0"
    },
    {
     "id": 881995,
     "content_html": "In her left thoracic spine",
     "correctness": "0.0"
    }
