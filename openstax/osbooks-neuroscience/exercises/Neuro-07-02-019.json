 "questions": [
  {
   "id": 386171,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the role of the medial geniculate body in the ascending auditory pathway?",
   "answers": [
    {
     "id": 913097,
     "content_html": "It is the primary gateway for auditory information to reach the cortex.",
     "correctness": "1.0"
    },
    {
     "id": 913098,
     "content_html": "It forms synapses with the outer hair cells of the cochlea.",
     "correctness": "0.0"
    },
    {
     "id": 913099,
     "content_html": "It determines the location of sound sources using differences in timing and level of stimuli.",
     "correctness": "0.0"
    },
    {
     "id": 913100,
     "content_html": "It integrates auditory, visual, and somatosensory input to create a unified map of space relative to head location.",
     "correctness": "0.0"
    }
   ],
