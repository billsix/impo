  {
   "id": 480150,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the primary difference between organizational and activational effects of hormones?",
   "answers": [
    {
     "id": 970948,
     "content_html": "Organizational effects are temporary, while activational effects are permanent",
     "correctness": "0.0"
    },
    {
     "id": 970949,
     "content_html": "Organizational effects occur during adulthood, while activational effects occur during early development",
     "correctness": "0.0"
    },
    {
     "id": 970950,
     "content_html": "Organizational effects are permanent and shape developmental pathways, while activational effects are reversible and occur throughout life",
     "correctness": "1.0"
    },
    {
     "id": 970951,
     "content_html": "Organizational effects involve the secretion of hormones, while activational effects do not",
     "correctness": "0.0"
    }
