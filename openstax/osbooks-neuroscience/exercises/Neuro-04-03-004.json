   "stimulus_html": "",
   "stem_html": "The “grade shift” in cortical volume proportion in the brain among primates means:",
   "answers": [
    {
     "id": 924660,
     "content_html": "the primate cortex is larger than would be predicted just based on the primate’s total brain size."
    },
    {
     "id": 924661,
     "content_html": "the primate cortex is smaller than would be predicted just based on the primate’s total brain size."
    },
    {
     "id": 924662,
     "content_html": "the primate cortex is sized just as would be predicted just based on the primate’s total brain size."
    },
    {
     "id": 924663,
     "content_html": "the primate cortex is homologous across species."
    }
