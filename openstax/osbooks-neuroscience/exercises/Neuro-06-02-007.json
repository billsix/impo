   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What would the vision of someone who did not have red cones be like?",
   "answers": [
    {
     "id": 1176246,
     "content_html": "They would not see anything red; red objects would be mostly invisible"
    },
    {
     "id": 1176247,
     "content_html": "Red light would look similar to green light"
    },
    {
     "id": 1176245,
     "content_html": "Red light would look similar to blue light"
    },
    {
     "id": 1176244,
     "content_html": "They would have poor vision in the dark"
    }
