   "stimulus_html": "",
   "stem_html": "Why do neurons have a resting potential?",
   "answers": [
    {
     "id": 927169,
     "content_html": "Because they have leak K+ channels that allow K+ to pull the neuron towards a negative potential",
     "correctness": "1.0"
    },
    {
     "id": 927170,
     "content_html": "Because they have leak K+ channels that allow K+ to pull the neuron towards a positive potential",
     "correctness": "0.0"
    },
    {
     "id": 927171,
     "content_html": "Because they have leak Na+ channels that allow K+ to pull the neuron towards a negative potential",
     "correctness": "0.0"
    },
    {
