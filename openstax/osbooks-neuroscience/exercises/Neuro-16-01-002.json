 "questions": [
  {
   "id": 446488,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the purpose of negative feedback mechanisms in homeostasis?",
   "answers": [
    {
     "id": 935524,
     "content_html": "To amplify deviations from set points"
    },
    {
     "id": 935525,
     "content_html": "To reduce the need for optimal values of a life-sustaining factor"
    },
    {
     "id": 935526,
     "content_html": "To counteract deviations and restore optimal set point values"
    },
    {
     "id": 935527,
     "content_html": "To maintain physiological conditions outside a normal range"
    }
   ],
