   "stem_html": "What is a resting potential?",
   "answers": [
    {
     "id": 927165,
     "content_html": "A wave of positive electrical potential that sweeps through a neuron"
    },
    {
     "id": 927166,
     "content_html": "An overall positive electrical potential neurons maintain while at rest"
    },
    {
     "id": 927167,
     "content_html": "An overall negative electrical potential neurons maintain while at rest"
    },
    {
     "id": 927168,
     "content_html": "A small, local change in potential caused when transmitter is received from a partner neuron"
    }
