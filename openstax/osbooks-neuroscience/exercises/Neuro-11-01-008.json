 "questions": [
  {
   "id": 480144,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements best reflects the current understanding of sexual behavior in the animal kingdom?",
   "answers": [
    {
     "id": 970928,
     "content_html": "Sexual behavior is exclusively a mechanism for reproduction between individuals of different sexes."
    },
    {
     "id": 970929,
     "content_html": "Same-sex sexual behavior is rare and occurs only in a few species."
    },
    {
     "id": 970930,
     "content_html": "Sexual behavior, including same-sex interactions, can serve roles beyond reproduction, such as enhancing social bonds and mitigating conflict within groups."
    },
    {
     "id": 970931,
     "content_html": "Sexual behavior is only observed during the fertile period in most species."
    }
   ],
