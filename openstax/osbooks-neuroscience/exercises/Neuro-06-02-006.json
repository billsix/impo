   "stem_html": "Color blindness:",
   "answers": [
    {
     "id": 1176242,
     "content_html": "is caused by mutations that make one of the cone types less functional.",
     "correctness": "0.0"
    },
    {
     "id": 1176241,
     "content_html": "is more common in males than females.",
     "correctness": "0.0"
    },
    {
     "id": 1176240,
     "content_html": "does not make a person actually blind to a wavelength of light but just makes some colors look more similar than they do for non-color blind individuals.",
     "correctness": "0.0"
    },
    {
     "id": 1176243,
     "content_html": "All of these are true",
     "correctness": "1.0"
    }
