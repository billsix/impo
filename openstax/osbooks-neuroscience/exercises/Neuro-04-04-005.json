   "id": 403063,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a limit to using tract-tracers to define neural circuits?",
   "answers": [
    {
     "id": 924680,
     "content_html": "They cannot be ethically used in humans.",
     "correctness": "0.0"
    },
    {
     "id": 924681,
     "content_html": "They are labor intensive and therefore studies using them take a long time to do.",
     "correctness": "0.0"
    },
    {
     "id": 924682,
     "content_html": "They can only be used in live animals.",
     "correctness": "0.0"
    },
    {
     "id": 924683,
     "content_html": "All of these are limits to tract-tracers.",
     "correctness": "1.0"
    }
