  {
   "id": 365983,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is the sense of hearing especially valuable for communication?",
   "answers": [
    {
     "id": 887169,
     "content_html": "Because sound is only detected at short distances."
    },
    {
     "id": 887170,
     "content_html": "Because sound can travel long distances and around obstacles."
    },
    {
     "id": 887171,
     "content_html": "Because hearing is more reliable than other senses."
    },
    {
     "id": 887172,
     "content_html": "Because only sound can carry information about the identity of individuals."
    }
   ],
