   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Lipopolysaccharide (LPS) is frequently used by neuroimmunologists to study sickness and inflammation responses. What is LPS?",
   "answers": [
    {
     "id": 929687,
     "content_html": "A live bacterium that causes infection and fever"
    },
    {
     "id": 929688,
     "content_html": "A piece of a bacterial cell component that causes an immune response but no actual infection"
    },
    {
     "id": 929689,
     "content_html": "A vaccine that stimulates B cells"
    },
    {
     "id": 929690,
     "content_html": "An antibody"
    }
