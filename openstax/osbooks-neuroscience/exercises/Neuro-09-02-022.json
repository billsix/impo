 "questions": [
  {
   "id": 386115,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In S1, the cortical surface area dedicated to receiving sensory information from a particular body part is:\n\n\n",
   "answers": [
    {
     "id": 912955,
     "content_html": "proportional to the surface area of the skin on that body part.\n"
    },
    {
     "id": 912956,
     "content_html": "proportional to the amount of sensory innervation that area receives.\n"
    },
    {
     "id": 912957,
     "content_html": "similar for all body parts.\n"
    },
    {
     "id": 912958,
     "content_html": "not organized in any particular way."
    }
   ],
