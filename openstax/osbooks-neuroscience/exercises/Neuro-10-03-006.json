   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Parkinson’s disease treatment called <i>deep brain stimulation</i> targets either the ________ or select regions within the ________ or ________ thalamus for continuous rapid electrical stimulation in a manner that reversibly diminishes the distorted contributions of these structures to the symptoms of Parkinson’s disease.",
   "answers": [
    {
     "id": 933350,
     "content_html": "caudate / ventral posterolateral / ventral posteromedial",
     "correctness": "0.0"
    },
    {
     "id": 933351,
     "content_html": "globus pallidus external / ventral anterior / ventrolateral",
     "correctness": "0.0"
    },
    {
     "id": 933352,
     "content_html": "internal globus pallidus / ventral posterolateral / ventral posteromedial",
     "correctness": "0.0"
    },
