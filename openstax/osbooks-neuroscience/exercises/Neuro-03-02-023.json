   "id": 390486,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Most of the serotonin released from the axonal terminal is:",
   "answers": [
    {
     "id": 918380,
     "content_html": "re-absorbed by the axonal terminal, repackaged into synaptic vesicles, and re-released again.",
     "correctness": "1.0"
    },
    {
     "id": 918381,
     "content_html": "catabolized by the enzyme monoamine oxidase.",
     "correctness": "0.0"
    },
    {
     "id": 918382,
     "content_html": "converted into 5-Hydroxyindole acetic acid.",
     "correctness": "0.0"
    },
    {
     "id": 918383,
     "content_html": "removed from the brain.",
     "correctness": "0.0"
    }
   ],
