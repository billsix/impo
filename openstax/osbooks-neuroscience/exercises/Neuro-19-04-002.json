 "questions": [
  {
   "id": 438167,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is true concerning the premotor theory?",
   "answers": [
    {
     "id": 933502,
     "content_html": "The motor cortex is primarily responsible for deploying attention"
    },
    {
     "id": 933503,
     "content_html": "Attentional systems develop prior to motor systems"
    },
    {
     "id": 933504,
     "content_html": "There is a link between covert attention and some aspects of motor programming in the brain"
    },
    {
     "id": 933505,
     "content_html": "The premotor cortex is associated specifically with the arousal component of attention"
    }
