 "questions": [
  {
   "id": 438159,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does the phenomenon of inattentional blindness suggest about the influence of top-down attentional goals on our perception?",
   "answers": [
    {
     "id": 933474,
     "content_html": "Top-down attentional goals have no impact on blindness",
     "correctness": "0.0"
    },
    {
     "id": 933475,
     "content_html": "Little of the sensory information in our visual world escapes our conscious awareness",
     "correctness": "0.0"
    },
    {
     "id": 933476,
     "content_html": "Bottom-up information is immune to intentional blindness",
     "correctness": "0.0"
    },
    {
     "id": 933477,
     "content_html": "Much of the sensory information in our visual world escapes our conscious awareness",
     "correctness": "1.0"
    }
