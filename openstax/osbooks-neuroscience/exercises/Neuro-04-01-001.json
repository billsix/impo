   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "We do we study model organisms?\n\n",
   "answers": [
    {
     "id": 921289,
     "content_html": "Humans are not interesting to study.\n\n",
     "correctness": "0.0"
    },
    {
     "id": 921290,
     "content_html": "They are computational approximations of real neural systems.\n\n",
     "correctness": "0.0"
    },
    {
     "id": 921291,
     "content_html": "What we learn can apply across species.\n\n",
     "correctness": "1.0"
    },
    {
     "id": 921292,
     "content_html": "We can conduct work in them without any regulatory approval.\n\n",
     "correctness": "0.0"
    }
