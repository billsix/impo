  {
   "id": 430018,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You are performing an LTP experiment and delivering high frequency stimulation to Schaffer collaterals.  Which treatment when applied to the hippocampal slice would NOT interfere with LTP induction at these CA3-CA1 synapses?",
   "answers": [
    {
     "id": 929850,
     "content_html": "Application of NMDA receptor inhibitors"
    },
    {
     "id": 929851,
     "content_html": "Removal of Mg2+ from the extracellular bath"
    },
    {
     "id": 929852,
     "content_html": "Application of CaMKII inhibitors"
    },
    {
     "id": 929853,
     "content_html": "Application of AMPA receptor inhibitors"
    }
