   "stimulus_html": "",
   "stem_html": "What is the function of a coincidence detector in the auditory system?",
   "answers": [
    {
     "id": 887685,
     "content_html": "To determine the distance of a sound source.",
     "correctness": "0.0"
    },
    {
     "id": 887686,
     "content_html": "To compare the timing difference between inputs from the two ears.",
     "correctness": "1.0"
    },
    {
     "id": 887687,
     "content_html": "To compare the difference in level of inputs from the two ears.",
     "correctness": "0.0"
    },
    {
     "id": 887688,
     "content_html": "To identify whether a sound source is periodic or aperiodic.",
     "correctness": "0.0"
