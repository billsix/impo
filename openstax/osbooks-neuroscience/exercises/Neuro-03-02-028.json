 "questions": [
  {
   "id": 390491,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Most neurons spontaneously fire off action potentials due to their tendency to constantly leak potassium ions. The brain takes advantage of this tendency and processes information primarily:",
   "answers": [
    {
     "id": 918400,
     "content_html": "via the control of intracellular calcium-ion levels."
    },
    {
     "id": 918401,
     "content_html": "via the balance of ion-channel and G-protein linked channels."
    },
    {
     "id": 918402,
     "content_html": "via the actions of glutamate-induced excitation."
    },
    {
     "id": 918403,
     "content_html": "via the actions of GABA-induced inhibition."
    }
   ],
