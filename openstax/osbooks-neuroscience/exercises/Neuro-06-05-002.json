 "questions": [
  {
   "id": 618131,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The ventral stream in visual processing:",
   "answers": [
    {
     "id": 1176303,
     "content_html": "is composed of multiple brain regions with connections that send information forward and backwards (feedback)."
    },
    {
     "id": 1176302,
     "content_html": "is composed primarily of inferotemporal cortex."
    },
    {
     "id": 1176301,
     "content_html": "has information flow only in the forward direction, from V1 into dorsal cortical areas."
    },
    {
     "id": 1176300,
     "content_html": "mediates motion perception."
    }
   ],
