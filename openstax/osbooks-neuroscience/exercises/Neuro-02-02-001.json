 "questions": [
  {
   "id": 422996,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Imagine a sensory neuron that does not fire unless stimulated.  With light touch the neuron generates an action potential.  What would happen with strong touch?",
   "answers": [
    {
     "id": 927089,
     "content_html": "Action potentials would occur more frequently"
    },
    {
     "id": 927090,
     "content_html": "Action potentials would not occur"
    },
    {
     "id": 927091,
     "content_html": "There would be no change in the frequency of action potentials, but the magnitude of each spike would increase"
    },
    {
     "id": 927092,
     "content_html": "Action potential frequency and magnitude would increase"
    }
   ],
