   "stimulus_html": "",
   "stem_html": "Cerebral spinal fluid:",
   "answers": [
    {
     "id": 927053,
     "content_html": "sloshes back and forth in the ventricular system."
    },
    {
     "id": 927054,
     "content_html": "flows in one direction through the ventricles, into to central canal and subarachnoid space."
    },
    {
     "id": 927055,
     "content_html": "flows in one direction from the subarachnoid space into the ventricles and then into to central canal."
    },
    {
     "id": 927056,
     "content_html": "is still, like a lake or pool."
    }
