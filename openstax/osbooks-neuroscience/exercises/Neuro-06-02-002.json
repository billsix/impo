 "questions": [
  {
   "id": 618108,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Imagine you are recording from a photoreceptor. You start recording in the dark then shine bright light on the photoreceptor. What will happen?",
   "answers": [
    {
     "id": 1176226,
     "content_html": "The photoreceptor will fire action potentials. The brighter the light, the more action potentials it will fire.",
     "correctness": "0.0"
    },
    {
     "id": 1176225,
     "content_html": "The photoreceptor will stop firing action potentials. The brighter the light, the fewer action potentials it will fire.",
     "correctness": "0.0"
    },
    {
     "id": 1176227,
     "content_html": "The photoreceptor will hyperpolarize. The brighter the light, the more it will hyperpolarize.",
     "correctness": "1.0"
    },
    {
     "id": 1176224,
     "content_html": "The photoreceptor will depolarize. The brighter the light, the more it will depolarize.",
     "correctness": "0.0"
    }
   ],
