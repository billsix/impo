   "stem_html": "What is the feed-forward mechanism in the context of osmotic balance?",
   "answers": [
    {
     "id": 935604,
     "content_html": "A response that occurs after water is absorbed into the bloodstream"
    },
    {
     "id": 935605,
     "content_html": "A response that occurs independent of neural activity"
    },
    {
     "id": 935606,
     "content_html": "A response that occurs before a change in blood osmolarity actually occurs"
    },
    {
     "id": 935607,
     "content_html": "An osmotic response caused by external stimuli"
    }
