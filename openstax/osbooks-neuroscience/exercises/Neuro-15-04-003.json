  {
   "id": 464604,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are things in common between people suffering from narcolepsy and delayed sleep-wake phase disorder?",
   "answers": [
    {
     "id": 965973,
     "content_html": "Excessive daytime sleepiness",
     "correctness": "1.0"
    },
    {
     "id": 965974,
     "content_html": "Both suffer primarily from too little sleep",
     "correctness": "0.0"
    },
    {
     "id": 965975,
     "content_html": "Both suffer primarily from disorganized sleep phase progression, falling into REM sleep too rapidly",
     "correctness": "0.0"
    },
    {
     "id": 965976,
     "content_html": "All of these",
     "correctness": "0.0"
    }
