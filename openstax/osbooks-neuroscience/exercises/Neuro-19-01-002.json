 "questions": [
  {
   "id": 438143,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a characteristic of endogenous attention?\n\n",
   "answers": [
    {
     "id": 933422,
     "content_html": "It requires conscious awareness and deliberation"
    },
    {
     "id": 933423,
     "content_html": "It involves the automatic capture of attention by novel stimuli"
    },
    {
     "id": 933424,
     "content_html": "It refers to the phenomenon of bottom-up attentional control"
    },
    {
     "id": 933425,
     "content_html": "It is the process of focusing on external stimuli effortlessly"
    }
   ],
