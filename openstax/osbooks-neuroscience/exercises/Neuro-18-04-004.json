 "questions": [
  {
   "id": 430016,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is the NMDA receptor considered a molecular coincidence detector?",
   "answers": [
    {
     "id": 929842,
     "content_html": "Its activation only requires postsynaptic depolarization."
    },
    {
     "id": 929843,
     "content_html": "Its activation only requires glutamate."
    },
    {
     "id": 929844,
     "content_html": "Its activation requires both glutamate and postsynaptic depolarization."
    },
    {
     "id": 929845,
     "content_html": "Its activation requires silencing of AMPA receptors."
    }
   ],
