 "questions": [
  {
   "id": 464592,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Among the Clock genes, high levels of Per and Cry will do what to CLOCK and BMAL1?",
   "answers": [
    {
     "id": 965937,
     "content_html": "High Per/Cry will suppress expression of CLOCK and BMAL1"
    },
    {
     "id": 965938,
     "content_html": "High Per/Cry will prevent CLOCK/BMAL1 from binding to Per/Cry promoters"
    },
    {
     "id": 965939,
     "content_html": "High Per/Cry will promote expression of CLOCK and BMAL1"
    },
    {
     "id": 965940,
     "content_html": "High Per/Cry will facilitate CLOCK/BMAL1 binding to Per/Cry promoters"
    }
   ],
