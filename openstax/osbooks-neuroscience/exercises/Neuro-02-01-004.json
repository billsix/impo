   "id": 422991,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which event occurs last in the process of chemical synaptic transmission?",
   "answers": [
    {
     "id": 927077,
     "content_html": "Released neurotransmitter is broken down or removed from the cleft"
    },
    {
     "id": 927078,
     "content_html": "The presynaptic neuron stores transmitter in vesicles"
    },
    {
     "id": 927079,
     "content_html": "The released neurotransmitter binds to postsynaptic receptors"
    },
    {
     "id": 927080,
     "content_html": "An action potential arrives at the presynaptic terminal leading to release of neurotransmitter"
    }
