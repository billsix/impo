   "stem_html": "What is the role of macrophages?",
   "answers": [
    {
     "id": 929671,
     "content_html": "To make antibodies"
    },
    {
     "id": 929672,
     "content_html": "To directly kill infected cells"
    },
    {
     "id": 929673,
     "content_html": "To phagocytose pathogens"
    },
    {
     "id": 929674,
     "content_html": "Spit their DNA out in nets to draw pathogens in"
    }
