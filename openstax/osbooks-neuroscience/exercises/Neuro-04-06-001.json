 "questions": [
  {
   "id": 403090,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are reason(s) we use organoids to study brain development?",
   "answers": [
    {
     "id": 924699,
     "content_html": "We can make them from many species, including those that are hard to study, like humans."
    },
    {
     "id": 924700,
     "content_html": "They show many structural and gene expression similarities to the developing nervous system."
    },
    {
     "id": 924701,
     "content_html": "They can be derived from individual human patients."
    },
    {
     "id": 924702,
     "content_html": "All of these"
    }
   ],
