  {
   "id": 422948,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ekman and Cordaro (2011) provided a list of forms of overt emotional expression that are common across the human species. Which of the following is not included in this list:",
   "answers": [
    {
     "id": 927005,
     "content_html": "changes in verbalizations (i.e. tone, speed, and pitch)."
    },
    {
     "id": 927006,
     "content_html": "alternations in facial expressions."
    },
    {
     "id": 927007,
     "content_html": "fluctuations in body posture and physical responses."
    },
    {
     "id": 927008,
     "content_html": "flushing or increased redness in the skin."
    }
   ],
