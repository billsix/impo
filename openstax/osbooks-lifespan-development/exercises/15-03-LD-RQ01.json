   "id": 662414,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a characteristic of autobiographical memories?",
   "answers": [
    {
     "id": 1316843,
     "content_html": "They include episodic memories only."
    },
    {
     "id": 1316844,
     "content_html": "They tend to get more positive with age."
    },
    {
     "id": 1316842,
     "content_html": "They include semantic memories only."
    },
    {
     "id": 1316841,
     "content_html": "They are very high in accuracy."
    }
