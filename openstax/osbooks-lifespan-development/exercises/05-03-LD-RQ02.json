   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Children at the beginning of Piaget’s second stage of cognitive development children are thought to ________.",
   "answers": [
    {
     "id": 1316095,
     "content_html": "engage in sophisticated abstract thought",
     "correctness": "0.0"
    },
    {
     "id": 1316094,
     "content_html": "rely on sensory information and motor movement to learn about the world",
     "correctness": "0.0"
    },
    {
     "id": 1316093,
     "content_html": "think in an increasingly logical way that emphasizes tangible objects",
     "correctness": "0.0"
    },
    {
     "id": 1316096,
     "content_html": "lack logical and reversible mental actions known as operations",
     "correctness": "1.0"
