   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sandeep has faced many challenges recently, including the death of his spouse, a serious medical scare, and some financial stress. He still functions at a very high level, has just secured a part-time job to help with finances, is active with friends and family, and has a positive outlook on life. What does Sandeep clearly have a lot of?",
   "answers": [
    {
     "id": 1316943,
     "content_html": "locus of control"
    },
    {
     "id": 1316944,
     "content_html": "resilience"
    },
    {
     "id": 1316942,
     "content_html": "caregivers"
    },
    {
     "id": 1316941,
     "content_html": "selection, optimization, and compensation"
    }
