 "questions": [
  {
   "id": 662350,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Based on Marcia’s identity status, what is the typical direction of identity development in middle adulthood?",
   "answers": [
    {
     "id": 1316755,
     "content_html": "Identity is achieved as we transition out of middle adulthood into the later years."
    },
    {
     "id": 1316754,
     "content_html": "Adult identity becomes diffused amid the demands of multiple roles and responsibilities."
    },
    {
     "id": 1316756,
     "content_html": "Identity status generally progresses toward achievement during middle adulthood."
    },
    {
     "id": 1316753,
     "content_html": "Most adults experience a midlife identity crisis, with confusion over where their life is “supposed” to go."
    }
   ],
