 "questions": [
  {
   "id": 662446,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why might residents of countries with low socioeconomic status and a large population of older adults have negative views of aging?",
   "answers": [
    {
     "id": 1316904,
     "content_html": "They view older adults as competitors for limited resources."
    },
    {
     "id": 1316903,
     "content_html": "Older adults run the government and make unpopular decisions."
    },
    {
     "id": 1316902,
     "content_html": "Older adults are grouchy and difficult to get along with."
    },
    {
     "id": 1316901,
     "content_html": "They have to spend time caring for older adults when they’d rather be doing other things."
    }
   ],
