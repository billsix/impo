 "questions": [
  {
   "id": 661842,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In what important way does Erikson's psychosocial theory differ from Freud’s psychosexual theory?",
   "answers": [
    {
     "id": 1316019,
     "content_html": "Erikson focuses on biological satisfaction; Freud does not."
    },
    {
     "id": 1316018,
     "content_html": "Erikson examines development only in infancy; Freud examines the entire lifespan."
    },
    {
     "id": 1316020,
     "content_html": "Erikson discusses both psychological and social bonds; Freud only looks at social bonds."
    },
    {
     "id": 1316017,
     "content_html": "Erikson states that earlier dilemmas cannot be revisited; Freud says that they can."
    }
   ],
