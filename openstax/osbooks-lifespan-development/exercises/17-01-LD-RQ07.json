  {
   "id": 662496,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In many African countries, AIDS is often not reported as an official cause of death due to what reason?",
   "answers": [
    {
     "id": 1316980,
     "content_html": "the stigma associated with AIDS",
     "correctness": "1.0"
    },
    {
     "id": 1316979,
     "content_html": "fear of angering the deceased",
     "correctness": "0.0"
    },
    {
     "id": 1316978,
     "content_html": "the collectivistic nature of the culture",
     "correctness": "0.0"
    },
    {
     "id": 1316977,
     "content_html": "the fear of government intervention in communities with higher rates of AIDS",
     "correctness": "0.0"
    }
