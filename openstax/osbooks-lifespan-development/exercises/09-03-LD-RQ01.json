 "questions": [
  {
   "id": 662109,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a property of formal operational thought?",
   "answers": [
    {
     "id": 1316399,
     "content_html": "believing that inanimate objects are alive and can have humanlike thoughts and feelings"
    },
    {
     "id": 1316400,
     "content_html": "the ability to use abstract, hypothetical, and deductive reasoning skills"
    },
    {
     "id": 1316398,
     "content_html": "the recognition that only physical appearance represents reality"
    },
    {
     "id": 1316397,
     "content_html": "the ability to consider multiple perspectives at the same time"
    }
   ],
