   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What do the theories of Erikson and Vygotsky have in common?",
   "answers": [
    {
     "id": 1315796,
     "content_html": "Both emphasize the social aspect of development.",
     "correctness": "1.0"
    },
    {
     "id": 1315795,
     "content_html": "Both study children’s responses to questions.",
     "correctness": "0.0"
    },
    {
     "id": 1315794,
     "content_html": "Both are stage theories based on continuous development.",
     "correctness": "0.0"
    },
    {
     "id": 1315793,
     "content_html": "Both focus on cognitive development.",
     "correctness": "0.0"
    }
