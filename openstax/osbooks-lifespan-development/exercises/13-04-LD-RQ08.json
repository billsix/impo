   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What do most employees who currently work from home say when asked if they would like to continue working from home?",
   "answers": [
    {
     "id": 1316739,
     "content_html": "They would prefer to return to the workplace."
    },
    {
     "id": 1316738,
     "content_html": "They are unsure."
    },
    {
     "id": 1316740,
     "content_html": "They would prefer to remain working from home in some capacity."
    },
    {
     "id": 1316737,
     "content_html": "Their decision depends on the kind of work."
