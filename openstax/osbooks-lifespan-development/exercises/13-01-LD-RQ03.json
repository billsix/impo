   "stimulus_html": "",
   "stem_html": "Compared to younger adults, how does cortical activation relate to processing speed for middle-aged adults?",
   "answers": [
    {
     "id": 1316664,
     "content_html": "Middle-aged adults have slower processing speed due to activation of larger areas of the cortex.",
     "correctness": "1.0"
    },
