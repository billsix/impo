   "id": 662126,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statement is most accurate with regard to rites of passage that are experienced during the adolescent years?",
   "answers": [
    {
     "id": 1316435,
     "content_html": "They denote that a person has reached adulthood."
    },
    {
     "id": 1316434,
     "content_html": "They are found only in cultures from developed nations."
    },
    {
     "id": 1316436,
     "content_html": "There is considerable variation between different cultures."
    },
    {
     "id": 1316433,
     "content_html": "They are universal to virtually all cultures."
    }
   ],
