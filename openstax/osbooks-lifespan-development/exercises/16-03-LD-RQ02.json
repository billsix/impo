   "id": 662464,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Amalfi recently graduated from college and was excited to start his new career. During the orientation period at his new job, he learned that his employer would match his retirement contributions up to 5 percent of his income, and that he was responsible for deciding how to invest the money. What type of retirement plan does Amalfi likely have?",
   "answers": [
    {
     "id": 1316924,
     "content_html": "401(k)",
     "correctness": "1.0"
    },
    {
     "id": 1316923,
     "content_html": "pension",
     "correctness": "0.0"
    },
    {
     "id": 1316922,
     "content_html": "vested pension",
     "correctness": "0.0"
    },
    {
     "id": 1316921,
     "content_html": "flexible health retirement account (FHRA)",
     "correctness": "0.0"
    }
   ],
