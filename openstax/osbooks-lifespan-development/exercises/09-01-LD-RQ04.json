 "questions": [
  {
   "id": 662087,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "By the end of adolescence, what is true of the human brain?",
   "answers": [
    {
     "id": 1316376,
     "content_html": "It will be at its adult weight and size."
    },
    {
     "id": 1316375,
     "content_html": "It will not have grown much since the midteens."
    },
    {
     "id": 1316374,
     "content_html": "It will be at 60 to 70 percent of its final dimensions."
    },
    {
     "id": 1316373,
     "content_html": "It will be thinner and lighter, but more lateralized, than it was prior to puberty."
    }
   ],
