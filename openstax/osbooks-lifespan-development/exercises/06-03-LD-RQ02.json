 "questions": [
  {
   "id": 661944,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Children whose parents divorce are more likely to have negative outcomes in which situation?",
   "answers": [
    {
     "id": 1316175,
     "content_html": "The separation happens when they are infants."
    },
    {
     "id": 1316174,
     "content_html": "Both parents remain active in their lives."
    },
    {
     "id": 1316176,
     "content_html": "Children are asked to relay messages between parents."
    },
    {
     "id": 1316173,
     "content_html": "The parents continue to demonstrate a friendship."
    }
   ],
