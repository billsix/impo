   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One recommendation made to parents about their children's consumption of media is that the parent should",
   "answers": [
    {
     "id": 1316195,
     "content_html": "allow children to watch television in privacy."
    },
    {
     "id": 1316194,
     "content_html": "allow children to watch television for up to three hours per day."
    },
    {
     "id": 1316193,
     "content_html": "discourage video chatting with extended family."
    },
    {
     "id": 1316196,
     "content_html": "offer guidance on what children are viewing."
    }
