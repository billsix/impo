 "questions": [
  {
   "id": 662300,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why might some adults with hearing loss choose not to use a hearing aid?",
   "answers": [
    {
     "id": 1316671,
     "content_html": "They do not believe that hearing aids are effective.",
     "correctness": "0.0"
    },
    {
     "id": 1316670,
     "content_html": "Modern hearing aids are too bulky and noticeable.",
     "correctness": "0.0"
    },
    {
     "id": 1316672,
     "content_html": "They deprioritize their hearing compared to other issues due to health-care costs.",
     "correctness": "1.0"
    },
    {
     "id": 1316669,
     "content_html": "They do not want others to shout at them due to the assumption that they cannot hear.",
     "correctness": "0.0"
    }
   ],
