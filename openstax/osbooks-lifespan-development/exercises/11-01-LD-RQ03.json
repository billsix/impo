 "questions": [
  {
   "id": 662190,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Emerging adulthood is a developmental period that is",
   "answers": [
    {
     "id": 1316515,
     "content_html": "a time where irresponsible decisions and “experience one’s wild side” are regarded as normal and healthy",
     "correctness": "0.0"
    },
    {
     "id": 1316514,
     "content_html": "rejected as a concept in most collectivistic countries, but is embraced in individualistic cultures",
     "correctness": "0.0"
    },
    {
     "id": 1316513,
     "content_html": "bound by specific neurological changes rather than specific ages where the period begins and ends",
     "correctness": "0.0"
    },
    {
     "id": 1316516,
     "content_html": "recognized in some countries as a “buffer” between adolescence and full adulthood",
     "correctness": "1.0"
    }
   ],
