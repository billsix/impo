 "questions": [
  {
   "id": 662286,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which  trend with regard to cohabiting with a romantic partner to whom one is not married is true?",
   "answers": [
    {
     "id": 1316652,
     "content_html": "More young adults now live with a cohabiting romantic partner than live with a spouse.",
     "correctness": "1.0"
    },
    {
     "id": 1316651,
     "content_html": "Cohabitation is far more common among the LGBTQ+ population than among those who identify as heterosexual.",
     "correctness": "0.0"
    },
    {
     "id": 1316650,
     "content_html": "Cohabitation becomes less common as people increase in their financial income and socioeconomic status.",
     "correctness": "0.0"
    },
    {
     "id": 1316649,
     "content_html": "People who are very religious are more likely to cohabit as a “test for marriage and hedge against divorce” than those who are not.",
     "correctness": "0.0"
    }
   ],
