   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What can be said of the current status of the wage gap between men and women?",
   "answers": [
    {
     "id": 1316731,
     "content_html": "The wage gap no longer exists in the modern workplace."
    },
    {
     "id": 1316732,
     "content_html": "The wage gap is narrowest for young adults."
    },
    {
     "id": 1316730,
     "content_html": "The wage gap is consistent throughout life."
    },
    {
     "id": 1316729,
     "content_html": "The wage gap is narrowest in middle adulthood."
    }
