   "id": 661897,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a new kindergarten teacher, you have a classroom full of children between five and six years of age. What similarities or difference ranges should you expect from the children's cognitive milestones?",
   "answers": [
    {
     "id": 1316091,
     "content_html": "low achievements in math and a wider range of language abilities"
    },
    {
     "id": 1316092,
     "content_html": "a wide range of skills in all cognitive areas"
    },
    {
     "id": 1316090,
     "content_html": "high achievement in all areas"
    },
    {
     "id": 1316089,
     "content_html": "similar achievements in language and a wider range of math abilities"
    }
