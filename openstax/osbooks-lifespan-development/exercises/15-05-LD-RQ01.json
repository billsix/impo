 "questions": [
  {
   "id": 662433,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How can we best describe the declines associated with normative cognitive aging?",
   "answers": [
    {
     "id": 1316875,
     "content_html": "large global declines that make it difficult for older adults to function without help"
    },
    {
     "id": 1316874,
     "content_html": "arising only after dementia symptoms become obvious"
    },
    {
     "id": 1316876,
     "content_html": "subtle and typically not interfering with the ability to live independently"
    },
    {
     "id": 1316873,
     "content_html": "abrupt transitions from high functioning to low functioning"
    }
   ],
