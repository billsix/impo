 "questions": [
  {
   "id": 662407,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the relationship between age and the likelihood of experiencing anxiety and depression?",
   "answers": [
    {
     "id": 1316835,
     "content_html": "Anxiety and depression are both more common and more devastating for older adults."
    },
    {
     "id": 1316834,
     "content_html": "Older adults are at increased risk of depression but less likely to experience anxiety."
    },
    {
     "id": 1316833,
     "content_html": "Older adults are at increased risk of anxiety but less likely to experience depression."
    },
    {
     "id": 1316836,
     "content_html": "Both depression and anxiety become less common in older age."
    }
