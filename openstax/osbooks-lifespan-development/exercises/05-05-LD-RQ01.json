 "questions": [
  {
   "id": 661917,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What play differences should be recommended for children based on their gender identity or sex assigned at birth?",
   "answers": [
    {
     "id": 1316132,
     "content_html": "None; all genders and sexes benefit from play in similar ways."
    },
    {
     "id": 1316131,
     "content_html": "More physical play should be recommended to boys than to girls."
    },
    {
     "id": 1316130,
     "content_html": "More imagination play should be recommended to girls than to boys."
    },
    {
     "id": 1316129,
     "content_html": "Children should only play in same-gender or same-sex groups until adolescence."
    }
   ],
