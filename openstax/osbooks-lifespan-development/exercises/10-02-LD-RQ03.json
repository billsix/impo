  {
   "id": 662137,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which best describes self-regulation in adolescents?",
   "answers": [
    {
     "id": 1316447,
     "content_html": "The ability to act impulsively and follow immediate desires without considering consequences.",
     "correctness": "0.0"
    },
    {
     "id": 1316446,
     "content_html": "The tendency to avoid all forms of external assistance in any situation, regardless of complexity.",
     "correctness": "0.0"
    },
    {
     "id": 1316445,
     "content_html": "The capacity to rely entirely on parental guidance for behavioral control and decision-making.",
     "correctness": "0.0"
    },
    {
     "id": 1316448,
     "content_html": "The skill to manage behavior and emotions to achieve better outcomes, influenced by brain developments and social factors.",
     "correctness": "1.0"
    }
   ],
