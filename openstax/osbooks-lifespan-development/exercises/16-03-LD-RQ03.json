 "questions": [
  {
   "id": 662465,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How do most working adults with low income save for retirement?",
   "answers": [
    {
     "id": 1316927,
     "content_html": "They tend to start saving earlier and more consistently."
    },
    {
     "id": 1316928,
     "content_html": "Their income is not enough to cover basic needs, leaving nothing saved for retirement."
    },
    {
     "id": 1316926,
     "content_html": "They tend to spread their savings across different types of investments."
    },
    {
     "id": 1316925,
     "content_html": "They get matched contributions from employers so any personal savings can be doubled."
    }
   ],
