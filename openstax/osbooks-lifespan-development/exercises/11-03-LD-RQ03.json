 "questions": [
  {
   "id": 662207,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the best way to describe the process of “coming out” for people in the LGBTQ+ community?",
   "answers": [
    {
     "id": 1316547,
     "content_html": "It cannot happen until one feels that they will be accepted by their family of origin.",
     "correctness": "0.0"
    },
    {
     "id": 1316548,
     "content_html": "It involves several tasks that are often experienced sequentially.",
     "correctness": "1.0"
    },
    {
     "id": 1316546,
     "content_html": "It is the only way an LGBTQ+ person can find inner peace with their sexuality.",
     "correctness": "0.0"
    },
    {
     "id": 1316545,
     "content_html": "It typically happens after a feeling psychological pressure has built up and must be released all at once.",
     "correctness": "0.0"
    }
   ],
