   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an example of a cohort?",
   "answers": [
    {
     "id": 1315807,
     "content_html": "Many commuters get stuck in terrible traffic during a downpour in their city."
    },
    {
     "id": 1315806,
     "content_html": "When both parents have blue eyes, there is a great chance of their offspring having blue eyes."
    },
    {
     "id": 1315805,
     "content_html": "People going to a grocery store tend to look for sales and special offers."
    },
    {
     "id": 1315808,
     "content_html": "Many people remember the explosion of the space shuttle Columbia in 2003."
    }
