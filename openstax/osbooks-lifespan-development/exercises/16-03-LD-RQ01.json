   "stimulus_html": "",
   "stem_html": "Ryan recently retired from a high-stress job as an attorney but isn’t quite ready to leave paid work entirely. They decide to take a full-time job with a nonprofit organization and apply their legal training to help others. What is the best way to describe Ryan’s approach to retirement?",
   "answers": [
    {
     "id": 1316919,
     "content_html": "phased retirement"
    },
    {
     "id": 1316920,
     "content_html": "bridge employment"
    },
    {
     "id": 1316918,
     "content_html": "vested retirement"
    },
    {
     "id": 1316917,
     "content_html": "transformative employment"
    }
