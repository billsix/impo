   "id": 662497,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Christianity and Islam both regard God as sovereign. In these religions, how are end-of-life treatments and euthanasia generally regarded, and why?",
   "answers": [
    {
     "id": 1316983,
     "content_html": "positively, because they represent man-made miracles"
    },
    {
     "id": 1316982,
     "content_html": "positively, because they relieve pain and suffering"
    },
    {
     "id": 1316981,
     "content_html": "negatively, because they produce more pain and suffering"
    },
    {
     "id": 1316984,
     "content_html": "negatively, because they go against “God’s will”"
    }
   ],
