  {
   "id": 662473,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Monique is acting as a caregiver for her husband, who has Alzheimer’s disease and wants to live at home as long as possible. She has decided she needs to take a break from this role a couple of days a week and also find time to do the shopping and run errands. What would be the most appropriate means to assist Monique in caring for her husband?",
   "answers": [
    {
     "id": 1316935,
     "content_html": "assisted living"
    },
    {
     "id": 1316934,
     "content_html": "congregate housing"
    },
    {
     "id": 1316933,
     "content_html": "nursing home"
    },
    {
     "id": 1316936,
     "content_html": "adult daycare"
    }
   ],
