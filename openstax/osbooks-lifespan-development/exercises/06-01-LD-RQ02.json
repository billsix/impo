   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What self-regulation technique would be expected from a typical five-year-old?",
   "answers": [
    {
     "id": 1316151,
     "content_html": "crawling on the floor and distracting themselves with toys"
    },
    {
     "id": 1316150,
     "content_html": "demanding to be held for several minutes"
    },
    {
     "id": 1316152,
     "content_html": "breathing deeply and closing their eyes"
    },
    {
     "id": 1316149,
     "content_html": "calmly discussing their opinion"
    }
