   "stimulus_html": "",
   "stem_html": "Mothers are more likely than fathers to interact with their children in what way?",
   "answers": [
    {
     "id": 1316167,
     "content_html": "encourage daughters to disregard lessons learned from schoolteachers"
    },
    {
     "id": 1316168,
     "content_html": "interact with children based on their personalities"
    },
    {
     "id": 1316166,
     "content_html": "encourage sons to be assertive and brave"
    },
    {
     "id": 1316165,
     "content_html": "engage in physical or \"rough-and-tumble\" play"
    }
