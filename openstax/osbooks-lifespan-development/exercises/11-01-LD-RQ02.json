 "questions": [
  {
   "id": 662185,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What has been the impact of globalization on cultural values such as collectivism and individualism?",
   "answers": [
    {
     "id": 1316511,
     "content_html": "They have caused intracultural strife, as younger generations seek to maintain the values of their predecessors."
    },
    {
     "id": 1316510,
     "content_html": "It has caused many cultures to become wary of and unwelcoming of outsiders to their communities."
    },
    {
     "id": 1316512,
     "content_html": "The lines between these cultural values have become less distinct and may, in fact, be outdated."
    },
    {
     "id": 1316509,
     "content_html": "It has led to more and more legislation that governs which behaviors are unacceptable within a given culture."
    }
   ],
