   "id": 662495,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jason knows that he does not take care of his teeth very well. He does not brush them as much as he should and rarely uses dental floss. He occasionally has minor tooth pain but tries to ignore it until it goes away. Jason ignores the letters from his dentist that he is due for a cleaning and check-up, and keeps delaying the task of scheduling an appointment. What coping style is he using?",
   "answers": [
    {
     "id": 1316975,
     "content_html": "monitoring"
    },
    {
     "id": 1316976,
     "content_html": "blunting"
    },
    {
     "id": 1316974,
     "content_html": "terror management"
    },
    {
     "id": 1316973,
     "content_html": "rationing of care"
    }
   ],
