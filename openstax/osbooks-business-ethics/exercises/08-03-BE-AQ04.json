 "questions": [
  {
   "id": 672097,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Though federal law does not mandate it, do some companies nevertheless allow LGBTQ employees to extend insurance coverage to partners?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "If no federal law exists, the states may implement laws that only apply within their borders. Some states have passed laws extending benefits to LGBTQ partners, and some have not."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes. The law does not mandate or prohibit extending benefits to LGBTQ partners; it is up to the company."
    }
   ],
   "community_solutions": []
  }
 ],
