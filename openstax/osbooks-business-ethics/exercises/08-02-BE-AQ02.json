 "questions": [
  {
   "id": 647244,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If an ADA accommodation is significantly expensive, ________.",
   "answers": [
    {
     "id": 1274782,
     "content_html": "the courts may rule that it is not reasonable",
     "correctness": "1.0"
    },
    {
     "id": 1274781,
     "content_html": "the courts may rule that it must be provided anyway",
     "correctness": "0.0"
    },
    {
     "id": 1274780,
     "content_html": "the EEOC guidelines do not apply",
     "correctness": "0.0"
    },
    {
     "id": 1274779,
     "content_html": "the federal government must subsidize the expense",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "ADA accommodations must not cause an undue hardship, which may include accommodations that are overly extensive or disruptive, or which could impact the actual running of the business."
    }
   ],
   "community_solutions": []
  }
 ],
