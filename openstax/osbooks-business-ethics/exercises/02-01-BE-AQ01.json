   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Aristotle’s virtue ethics are based on the philosophy that as humans we have the quest to understand and live a life of moral character, which includes knowledge, wisdom, and prudence. The basic order of life is not a trait that humans strive to understand."
    }
