   "id": 672063,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is earth jurisprudence?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Some corporations believe in protecting Earth’s resources as if Earth is a person. They want to reduce their carbon footprint, regardless of government regulations, because they feel responsible for other people and the planet."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Earth jurisprudence is an interpretation of law and governance based on the belief that society will be sustainable only if we recognize the legal rights of Earth as if it were a person."
    }
   ],
   "community_solutions": []
  }
 ],
