   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Deliberative prudence is the habit of deciding what is right and wrong for one’s own self. In other words, it is the actions we choose that affect the long-term outcomes. “Encourage prodigality” is incorrect in this situation as that would cause us to use a large number of resources, such as time and energy, without care or restraint. In that instance, we choose actions that are wasteful."
    }
   ],
