   "stimulus_html": "",
   "stem_html": "Deliberative prudence does all the following except ________.",
   "answers": [
    {
     "id": 1274535,
     "content_html": "align ends and means",
     "correctness": "0.0"
    },
    {
     "id": 1274536,
     "content_html": "encourage prodigality",
     "correctness": "1.0"
    },
    {
     "id": 1274534,
     "content_html": "avoid conflict",
     "correctness": "0.0"
    },
    {
     "id": 1274533,
     "content_html": "prevent rash behavior",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
