 "questions": [
  {
   "id": 672103,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Premium rates for insurance coverage are based on statistical calculations of the historical rate of incidence of certain kinds of accidents, disasters, and theft, among other calamities against which we insure ourselves. Is this the most equitable way to assign these rates? Why or why not?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Statistically, this makes sense, but it often plays out unfairly for those insured individuals who absolutely do not contribute to the higher incidence of claims in certain areas. For example, suppose you are a very safe driver in a neighborhood of dangerous drivers. Your premiums for auto insurance will reflect not so much your own safety record as the overall rate of claims in your community."
    }
   ],
   "community_solutions": []
  }
 ],
