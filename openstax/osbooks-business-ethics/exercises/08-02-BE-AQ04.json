 "questions": [
  {
   "id": 672094,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The primary law prohibiting discrimination against disabled workers is the ADA. What is its main requirement?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The only issue is the accommodations must not cause undue hardship, meaning they cannot be overly extensive or disruptive."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The ADA's main requirement is that employers make reasonable accommodations for applicants and workers with disabilities to allow them to perform the essential functions of the job."
    }
   ],
   "community_solutions": []
  }
 ],
