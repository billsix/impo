   "stimulus_html": "",
   "stem_html": "Why have some states raised minimum wages above the federal minimum?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Some areas have a high cost of living due to the type of jobs located there. For example, California has a high cost of living due to the tech companies and various regulations that make items more expensive."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Cost of living variations and concern about a shrinking middle class are possible motives for a state to enact its own above-federal minimum wage."
    }
   ],
   "community_solutions": []
  }
