 "questions": [
  {
   "id": 647248,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Are individual states allowed to have laws protecting LGBTQ applicant or employee rights?",
   "answers": [
    {
     "id": 1274787,
     "content_html": "Yes, but it is not really necessary because federal law already protects them.",
     "correctness": "0.0"
    },
    {
     "id": 1274786,
     "content_html": "No, because it would violate federal law, which prohibits it.",
     "correctness": "0.0"
    },
    {
     "id": 1274788,
     "content_html": "Yes, some states extend this protection because there is no law at the federal level.",
     "correctness": "1.0"
    },
    {
     "id": 1274785,
     "content_html": "No, because the Supreme Court ruling in <i>Obergefell v. Hodges</i> now protects these rights.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Federal law only takes precedence over conflicting state laws when such laws exist. However, if no federal law exists, the states may implement laws that only apply within the borders of that state."
    }
   ],
   "community_solutions": []
  }
 ],
