 "questions": [
  {
   "id": 647280,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is not a prospective benefit to the firm of implementing a telecommuting program?",
   "answers": [
    {
     "id": 1274855,
     "content_html": "higher productivity of telecommuting workers",
     "correctness": "0.0"
    },
    {
     "id": 1274856,
     "content_html": "greater connectivity and collaboration among employees",
     "correctness": "1.0"
    },
    {
     "id": 1274854,
     "content_html": "lower operating costs",
     "correctness": "0.0"
    },
    {
     "id": 1274853,
     "content_html": "more satisfied workers",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Telecommuting positions tend to have less social interaction and employee engagement in the workplace. Because employees are located in different areas, it is sometimes harder to collaborate despite technological advances. This is due to reduced face-to face-engagement from what you would normally have in an office setting."
    }
   ],
