   "id": 672108,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you were designing an office building for a mid-size advertising firm, what ideas could you incorporate from this section to enhance collaboration?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Flexible space allows people to roam, which makes them connect easier with customers and employees."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Any new office building could incorporate shared and flexible work space to allow for greater\ncollaboration among employees. Less space would be dedicated to individual offices. A manager would also want to include collaborative technology that allows employees to easily contact customers, vendors, and other suppliers."
    }
