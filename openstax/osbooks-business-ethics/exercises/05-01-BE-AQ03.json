 "questions": [
  {
   "id": 672066,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How might consumerism be at odds with the growing concern for business ethics?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A good example would be any trendy product that influencers promote on social media. Each influencer is trying to push a product to make money, and both the young and old are trying to purchase it. However, some people may not want to participate due to concerns about animal testing or other issues."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "As an extreme preoccupation with buying and owning, consumerism runs counter to the new sensitivity to ethics and human flourishing in business, because it defines people not by their humanity but by their purchasing power."
    }
   ],
   "community_solutions": []
  }
 ],
