 "questions": [
  {
   "id": 672088,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "List the factors that help establish the ethics (and legality) of gift giving and receiving.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Gifts should be what the IRS calls “de minimis.” These are gestures that thank someone for an act or service provided. They should be small to convey gratitude but not influence the recipient."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Factors that help establish the ethics and legality of gift giving include the value of the gift, its purpose, the circumstances under which it is given, the position of the person receiving it, company policy, and the law."
    }
   ],
   "community_solutions": []
  }
 ],
