   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How does humanities in ethics differ from a humanistic business model?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Everyone has different things that motivate them. Some business models try to focus on what will motivate most people, such as benefits and perks."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A humanistic business model focuses on leadership development and the data of social science about how to motivate people. Humanities in ethics looks to case methods, novels, short stories, and plays to gain insight into human behavior."
    }
   ],
