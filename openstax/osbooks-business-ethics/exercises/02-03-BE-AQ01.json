 "questions": [
  {
   "id": 647129,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "\"Control\" as used in this section does not refer to which of the following?",
   "answers": [
    {
     "id": 1274556,
     "content_html": "reverence",
     "correctness": "1.0"
    },
    {
     "id": 1274555,
     "content_html": "<i>phrónēsis</i>",
     "correctness": "0.0"
    },
    {
     "id": 1274554,
     "content_html": "temperance",
     "correctness": "0.0"
    },
    {
     "id": 1274553,
     "content_html": "Confucian self-regulation",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Reverence is not considered one of the characteristics of control in Aristotle’s teachings or Confucius’s teachings. Aristotle’s characteristics of control include phronesis, self-restraint, and temperance, whereas Confucius’s characteristics of control include self-regulation, ability, and courage."
    }
   ],
   "community_solutions": []
  }
