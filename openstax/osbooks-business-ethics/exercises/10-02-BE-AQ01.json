 "questions": [
  {
   "id": 647286,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When considering the issue of work-life balance, which of the following points does not apply?",
   "answers": [
    {
     "id": 1274867,
     "content_html": "Each employee probably assesses this differently.",
     "correctness": "0.0"
    },
    {
     "id": 1274866,
     "content_html": "Managers and workers as cohorts often have different perspectives on it.",
     "correctness": "0.0"
    },
    {
     "id": 1274868,
     "content_html": "Workers with families at home should be entitled to a \"better\" balance.",
     "correctness": "1.0"
    },
    {
     "id": 1274865,
     "content_html": "All employees have a right to pursue this.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Every worker needs a balance, not just those with families. For example, large accounting firms manage the work life balance of new college graduates to prevent burnout and turnover. The lack of a work-life balance could be determinantal to a business."
    }
   ],
   "community_solutions": []
  }
 ],
