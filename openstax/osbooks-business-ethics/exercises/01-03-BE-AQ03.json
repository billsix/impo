 "questions": [
  {
   "id": 672049,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Describe the benefits of having a single ethical standard.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "It is like the saying “treat others the way you want to be treated.” This means to conduct yourself toward other people according to how you want them to conduct themselves toward you. There is no need to have different standards based on whom you are interacting with."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Having a single ethical standard maximizes ethical behavior no matter who the other party is and supports an internally consistent rule of behavior toward all family, friends, customers, clients, and others with whom we interact."
    }
   ],
   "community_solutions": []
  }
 ],
