   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Amenities are additional resources made available to employees above and beyond wages, salary, or other standard benefits or obligations."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Amenities include perks, such as a gym, free parking, and in some states vacation time, as these are not required by federal law. Health insurance is another benefit that can be considered an amenity."
    }
   ],
