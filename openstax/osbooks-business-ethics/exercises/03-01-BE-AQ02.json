   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Companies are required to provide amenities to their employees to fulfill the social contract\nbetween management and employees as stakeholders.",
   "answers": [
    {
     "id": 1274599,
     "content_html": "True",
