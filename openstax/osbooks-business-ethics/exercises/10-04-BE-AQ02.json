   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Artificial intelligence and robotics in the United States are thus far largely unregulated. Do you see more regulations coming? Why or why not?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Without regulation, AI will go unchecked. If that happens, we might not be able to determine what is real and what isn’t."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Likely yes, for example in the area of self-driving cars, where we have already (in 2018) experienced a pedestrian’s death caused by a self-driving car."
