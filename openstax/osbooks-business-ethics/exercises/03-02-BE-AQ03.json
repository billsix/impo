 "questions": [
  {
   "id": 672058,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Explain how the normative approach to stakeholder theory informs the instrumental aspect and the descriptive approach.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The normative approach is the fundamental basis of stakeholder theory and argues that stakeholders are ends unto themselves rather than means to an end. Thus, they have inherent value and cannot be looked at merely as instruments or as functional parts in an economic engine intended solely to generate profit for stockowners. That said, the instrumental and descriptive approaches also have their role in helping us to understand stakeholders and are mutually supportive of the normative approach."
    }
   ],
   "community_solutions": []
  }
 ],
