   "stimulus_html": "",
   "stem_html": "Why should employees care about the way they treat customers?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Think about how you felt the last time you were at a restaurant or store. How did your interaction with the employee make you feel about your trip?"
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Customers' perceptions are formed by the employees with whom they have contact, and these perceptions affect not only the company but all the employees who depend on its success for their livelihood."
    }
   ],
