 "questions": [
  {
   "id": 672096,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Federal law does not currently protect LGBTQ applicants from discrimination in hiring. Are there any applicable state laws that do so?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "If no federal law exists, the states may implement laws that only apply within their borders."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Yes. Approximately half of U.S. states have local laws that provide protection even though federal law does not; however, some of those states prohibit sexual orientation discrimination only in public workplaces, not private ones."
    }
   ],
   "community_solutions": []
  }
