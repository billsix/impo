 "questions": [
  {
   "id": 672101,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Should insurance coverage be mandatory for in some U.S. areas, such as hurricane coverage in the Southeast, tornado coverage in the Midwest, earthquake coverage on the Pacific Coast? Why or why not? Should government subsidies help underwrite the cost of this coverage? Why or why not?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Arguably, yes. Residences and businesses in these catastrophe-prone areas certainly would benefit from coverage. The difficulty comes in paying for it; it can be very expensive given the potential for cataclysmic loss. So an apparatus that would combine payment on the part of the insured but supplemented with tax subsidies might be most fair."
    }
   ],
   "community_solutions": []
  }
 ],
