     "images": [],
     "solution_type": "summary",
     "content_html": "John Rawls believed that every person should be treated with fairness and receive equal basic liberties and opportunities, which would bring the highest possible benefit to the less advantaged members of society. He considered this our “social contract” with each other."
    }
