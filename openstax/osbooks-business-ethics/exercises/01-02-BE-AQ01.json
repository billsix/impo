   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is not a stakeholder?",
   "answers": [
    {
     "id": 1274519,
     "content_html": "the media",
     "correctness": "0.0"
    },
    {
     "id": 1274520,
     "content_html": "corporate culture",
     "correctness": "1.0"
    },
    {
     "id": 1274518,
     "content_html": "the environment",
     "correctness": "0.0"
    },
    {
     "id": 1274517,
     "content_html": "customers",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Corporate culture is what leaders of the company build; it is not a stakeholder. Corporate culture describes how the company operates and what employees see as they enter the workplace every day. A bad corporate culture can affect the morale and the customers of the company."
    }
   ],
