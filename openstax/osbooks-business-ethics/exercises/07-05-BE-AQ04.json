 "questions": [
  {
   "id": 672089,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What kind of information can employees post online under the protection of federal statute?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Most employers have bulletin boards or documents with mandated items from both state and federal statutes. In addition, there is no rule that prohibits an employer from posting salary information to job boards or career sites for prospective employees."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Employees can post information online about wages, hours, and working conditions, and that speech is protected by federal statute."
    }
   ],
   "community_solutions": []
  }
 ],
