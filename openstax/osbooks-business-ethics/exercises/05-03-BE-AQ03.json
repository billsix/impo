   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Define localization and name at least three items that might be included as part of a localization effort.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "McDonald’s is located around the globe. Although they sell many items found in the U.S., they will also carry items that are local to the culture they are located in."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Localization is the process of adapting a product for use or sale in other nations and cultures. This might include language translation, adapting content to the tastes and consumption habits of the local market, and converting measurements."
    }
   ],
   "community_solutions": []
  }
