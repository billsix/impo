 "questions": [
  {
   "id": 647287,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is not a potential downside of a corporate campus?",
   "answers": [
    {
     "id": 1274872,
     "content_html": "Impaired productivity",
     "correctness": "1.0"
    },
    {
     "id": 1274871,
     "content_html": "Reduced ability of labor markets to adjust to changing conditions",
     "correctness": "0.0"
    },
    {
     "id": 1274870,
     "content_html": "Adverse impact on local businesses",
     "correctness": "0.0"
    },
    {
     "id": 1274869,
     "content_html": "Increased fiscal burden on local government",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Although productivity can be higher for some employees who telecommute, their productivity is not much greater compared to employees who work exclusively at an office site. Sometimes, very high-tech positions have better productivity in a campus-style setting due to the high collaboration needed among employees."
    }
   ],
