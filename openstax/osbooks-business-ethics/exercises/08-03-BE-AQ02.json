   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Title VII of the Civil Rights Act does not address sexual orientation and federal law does not prohibit discrimination based on this characteristic."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "There may be individual state laws that protect sexual orientation within that state’s boarder, but that protection is not included in Title VII."
    }
   ],
   "community_solutions": []
  }
