   "id": 672055,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How does Kantian ethics work in a business setting?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Most businesses today are focused on creating value for shareholders. One of the main reasons for this is executive compensation, which is largely based on stock options. Creating value focuses on the individuals rather than the whole, which would be the employees of the company. This would require businesses to ensure that employees, customers, and suppliers are not exploited for their own gain. Business should aim to create fair and just relationships with everyone."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because Kantian ethics is about treating people not as means but as ends, this philosophy can influence nearly every aspect of business, from research and development to production, manufacturing, marketing, and consumption. It may be difficult to implement, however, because many businesses are focused on efficiency and production to the near-exclusion of other factors."
    }
   ],
   "community_solutions": []
  }
 ],
