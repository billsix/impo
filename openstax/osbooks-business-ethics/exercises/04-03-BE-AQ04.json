   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The Commerce Clause states that the United States Congress shall have the power “to regulate Commerce with foreign Nations, and among the several States, and with the Indian Tribes.” Over the years, courts have expanded that definition to include the rules and regulations for intrastate and interstate commerce."
    }
