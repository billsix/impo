   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following constitutional provisions gives regulatory power to the federal government?",
   "answers": [
    {
     "id": 1274657,
     "content_html": "First Amendment",
     "correctness": "0.0"
    },
    {
     "id": 1274656,
