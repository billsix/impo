 "questions": [
  {
   "id": 647164,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Industries like to be in control of their own destiny and as a result prefer self-regulation to laws imposed by governments. Self-regulation is often ________.",
   "answers": [
    {
     "id": 1274631,
     "content_html": "based on external codes of conduct",
     "correctness": "0.0"
    },
    {
     "id": 1274630,
     "content_html": "enforced by the courts",
     "correctness": "0.0"
    },
    {
     "id": 1274629,
     "content_html": "in conflict with common law",
     "correctness": "0.0"
    },
    {
     "id": 1274632,
     "content_html": "less costly for firms than government regulation",
     "correctness": "1.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Self-regulation is less costly because companies are allowed to police themselves. For example, a coffee producer can decide to have their coffee certified as rainforest certified, which has standards that ensure water is used efficiently, farmers enhance on-farm biodiversity, and no deforestation occurs in the growth of the coffee bean."
    }
   ],
   "community_solutions": []
  }
