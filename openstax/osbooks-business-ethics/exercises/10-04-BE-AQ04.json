 "questions": [
  {
   "id": 647301,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Worker displacement is a problem that companies have a legal duty to address when\nimplementing the use of robots.",
   "answers": [
    {
     "id": 1274891,
     "content_html": "True",
     "correctness": "0.0",
     "feedback_html": ""
    },
    {
     "id": 1274892,
     "content_html": "False",
     "correctness": "1.0",
     "feedback_html": ""
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Companies have no such duty."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Automation has been happening for a long time. Consider the number of self-checkout machines at retail stores. Companies don’t have any duty when six self-checkout stations may eliminate five cashier positions. Another example is that manufacturing has eliminated thousands of jobs with the use of robots."
    }
   ],
   "community_solutions": []
  }
