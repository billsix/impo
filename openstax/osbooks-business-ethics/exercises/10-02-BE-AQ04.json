 "questions": [
  {
   "id": 672107,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why do some companies provide free or inexpensive meals for their employees? Are they behaving ethically by doing so?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "It also is a perk that many people enjoy and is a nice morale builder for employees who may commute long hours for work."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Making free or inexpensive food available in the workplace is a recruiting and retention tool. The employer may also hope that if food is available on the premises, employees will spend less time getting meals and more time working. It might be considered unethical to try to control employees' time and limit social interactions away from work."
    }
   ],
   "community_solutions": []
  }
