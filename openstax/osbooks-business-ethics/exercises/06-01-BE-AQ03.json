 "questions": [
  {
   "id": 672073,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are examples of benefits or perks that women usually value more than men?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "These items will change individually depending on what phase of life the person is in. Early in their career, a person might value wages and position, but if they start a family, they may place more value on childcare and health benefits to ensure their family is taken care of."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Surveys show that women value benefits related to childcare and health care more highly than do men, although the benefit mix any employee values most is an individual one."
    }
   ],
   "community_solutions": []
  }
 ],
