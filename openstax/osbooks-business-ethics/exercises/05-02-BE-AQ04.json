 "questions": [
  {
   "id": 672067,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What did the decision in <i>Shlensky v. Wrigley</i> (1968) establish in ethical terms? How does it compare to the decision in <i>Dodge v. Ford Motor Company</i> (1919)?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The board of directors are there to ensure the CEO is working in the best interest of the company. The board is voted by the shareholders to carry out the fiduciary duty to ensure the company is working in all stakeholders’ best interests."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "<i>Shlensky v. Wrigley</i> gave boards of directors and management more latitude in determining how to balance the interests of stakeholders. This was in contrast to <i>Dodge v. Ford Motor Company</i>, which validated the rule of shareholder primacy."
    }
   ],
   "community_solutions": []
  }
 ],
