 "questions": [
  {
   "id": 647167,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the tragedy of the commons?",
   "answers": [
    {
     "id": 1274635,
     "content_html": "People are always willing to sacrifice for the good of society.",
     "correctness": "0.0"
    },
    {
     "id": 1274636,
     "content_html": "People are likely to use all the natural resources they want without regard to others.",
     "correctness": "1.0"
    },
    {
     "id": 1274634,
     "content_html": "The common good of the people is a popular corporate goal.",
     "correctness": "0.0"
    },
    {
     "id": 1274633,
     "content_html": "Tragedies occur when there is too much government regulation.",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Tragedy of the commons is a type of self-centered thinking. This happens when supply becomes limited, and people will hoard all the resources they can obtain. For example, people hoarded toilet paper and paper towels during the early stages of the COVID-19 pandemic."
    }
   ],
   "community_solutions": []
  }
