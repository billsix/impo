 "questions": [
  {
   "id": 672110,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Participating in the gig economy often means working for a company as a part-time worker with no guarantee the job will last. Why would someone do it?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Gig workers set their own schedule. They decide how much money they want to earn per week, month, or year. They can also start and stop as they please."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Gig work allows flexible scheduling, the ability to work for more than one company at a time, and the ability to work more or fewer hours each week, as desired."
    }
   ],
   "community_solutions": []
  }
 ],
