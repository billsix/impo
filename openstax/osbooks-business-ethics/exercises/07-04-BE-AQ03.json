     "solution_type": "detailed",
     "content_html": "Despite legal and cultural differences that may allow bribes in other countries, U.S. firms and their employees are prohibited from paying them."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The U.S. Foreign Corrupt Practices Act is the law that prevents U.S. firms and employees from paying bribes."
    }
