 "questions": [
  {
   "id": 672081,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Should drug testing of employees be allowed?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "An example is Home Depot’s policy for checking potential drug use by forklift drivers. This is to ensure the safety of the employee but also the consumer. Another example would be drug screening for school bus drivers to ensure the safety of the children."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The answer is yes, as long as a company is responsible for what its employees do. Then businesses need to check for drugs due to reasons such as workplace safety and protection of property."
    }
   ],
   "community_solutions": []
  }
 ],
