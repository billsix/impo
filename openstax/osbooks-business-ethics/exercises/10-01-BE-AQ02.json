 "questions": [
  {
   "id": 647281,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A successful telecommuting program would include which of the following?",
   "answers": [
    {
     "id": 1274860,
     "content_html": "a written policy that spells out expectations",
     "correctness": "1.0"
    },
    {
     "id": 1274859,
     "content_html": "an oral policy the manager can change at will",
     "correctness": "0.0"
    },
    {
     "id": 1274858,
     "content_html": "subjective criteria for each individual worker",
     "correctness": "0.0"
    },
    {
     "id": 1274857,
     "content_html": "preference for some people to telecommute over others",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Each company should have written policies that dictate what they expect of telecommuting workers. This ensures the work gets done and holds employees accountable so that productivity doesn’t suffer."
    }
   ],
   "community_solutions": []
  }
 ],
