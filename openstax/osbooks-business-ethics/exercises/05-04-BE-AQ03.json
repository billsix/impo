 "questions": [
  {
   "id": 672070,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why is conscience the locus or center of ethical behavior in business?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This is where having a strong culture comes in. Despite employees coming from all different backgrounds and cultures, if the company’s corporate culture is strong, they will all work toward the same goal despite having different views."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Conscience is the locus of ethical behavior in business because individuals acting in free association make up the business or organization. They are motivated by their inner voice to act responsibly toward each other and their stakeholders—or not."
    }
   ],
   "community_solutions": []
  }
 ],
