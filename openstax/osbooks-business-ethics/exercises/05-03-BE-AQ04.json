 "questions": [
  {
   "id": 672069,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How would you reconcile cultural differences between so-called contact and noncontact cultures in the context of business negotiations?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Managers need to be aware how different cultures interact to accomplish business goals."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "This can be a matter of managing expectations. Managers must do the work required for any business deal but deliver it in a way that is culturally sensitive, even if that means negotiating details like project deadlines and the conduct of meetings and agreeing to have different expectations of those in a different cultural context."
    }
   ],
   "community_solutions": []
  }
