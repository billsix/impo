    {
     "id": 1274750,
     "content_html": "insider trading",
     "correctness": "1.0"
    },
    {
     "id": 1274749,
     "content_html": "bribery",
     "correctness": "0.0"
    },
    {
     "id": 1274748,
     "content_html": "illegal transaction",
     "correctness": "0.0"
    },
    {
     "id": 1274747,
     "content_html": "manipulation",
     "correctness": "0.0"
    }
