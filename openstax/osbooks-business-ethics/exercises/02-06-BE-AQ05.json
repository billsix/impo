 "questions": [
  {
   "id": 672056,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What challenges does Rawlsian justice theory present when it comes to the redistribution of goods and services in society?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "His theory is based upon two principles that can be reached in an agreement of fairness. The first is equality, where each person is to have an equal right to basic liberties, and social and economic inequalities are to be arranged to everyone’s advantage and position. In other words, no matter their job title, all should be able to receive the same pay despite the complexity of the position or training required. This differs from a capitalist view, where you are paid more based on training and experience."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Rawls’s theory has been called radical because it redistributes goods and services without regard for extenuating circumstances or historical context. It also has been accused of stifling enterprise, innovation, and investment."
    }
   ],
   "community_solutions": []
  }
