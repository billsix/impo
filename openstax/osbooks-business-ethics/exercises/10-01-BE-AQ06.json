   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In what ways does telecommuting help companies recruit and retain employees?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Telecommuting has become a perk and a way to entice candidates who had not previously considered a position to apply. It increases the talent pool from which to choose."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Companies can use telecommuting to recruit and retain employees who wish to facilitate work-life balance, or employees from locations that are not within daily travel distance to the facility."
    }
   ],
