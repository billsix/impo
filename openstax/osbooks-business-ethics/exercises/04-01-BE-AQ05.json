 "questions": [
  {
   "id": 672062,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Identify two benefits for a company following a policy of corporate social responsibility (CSR).",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Some consumers will only do business with corporations that align with their beliefs. Also, people tend to support those businesses that publicly appear to be moral or ethical."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "One benefit is that consumers may prefer to purchase products from a socially responsible company. A second benefit is that CSR may attract more investors, or shareholders, who are interested in investing in the company."
    }
   ],
   "community_solutions": []
  }
 ],
