   "stem_html": "A stakeholder claim ________.",
   "answers": [
    {
     "id": 1274607,
     "content_html": "is usually a complaint",
     "correctness": "0.0"
    },
    {
     "id": 1274606,
     "content_html": "is always financial",
     "correctness": "0.0"
    },
    {
     "id": 1274608,
     "content_html": "is any matter of concern for the corporation or company",
     "correctness": "1.0"
    },
    {
     "id": 1274605,
     "content_html": "is the same as a lawsuit",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
