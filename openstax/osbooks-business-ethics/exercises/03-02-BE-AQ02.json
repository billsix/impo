   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "A stakeholder claim is a concern of the business as it can take many forms. Depending upon the priority of the stakeholder’s interests, it can affect the decision-making process. A vendor’s priority may differ from the employees’ priorities. In addition, those stakeholders will have varying levels of influence on how the business will run."
    }
   ],
