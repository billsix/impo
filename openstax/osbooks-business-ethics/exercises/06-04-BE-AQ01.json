     "images": [],
     "solution_type": "detailed",
     "content_html": "If an employer is monitoring any device owned by the company, such as a telephone or computer, no advance notice is required."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Most companies do have policies that inform employees they can be monitored on company-owned assets."
    }
