 "questions": [
  {
   "id": 672111,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What advantages does a company gain from hiring gig workers?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Gig workers allow the company to better manage demand. If there is little or no demand, companies don’t incur costs during slow times."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Advantages include reduced payroll taxes, reduced cost of benefits, and the ability to use and, hence, pay for workers only when they are needed."
    }
   ],
   "community_solutions": []
  }
 ],
