   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Explain why ethical responsibilities go beyond legal compliance.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Behaving ethically requires that we meet the mandatory standards of the law and then go above and beyond them to recognize that an action may be legal but we personally may consider it unacceptable. Ethical reasoning often is more topical than law and reflects the changes in consciousness that individuals and society undergo. Often, ethical thought precedes and sets the stage for changes in the law."
    }
   ],
   "community_solutions": []
  }
