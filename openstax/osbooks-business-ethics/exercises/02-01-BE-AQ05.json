   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How might virtue ethics apply to contemporary business?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "This ties into having a positive culture that creates a positive morale for employees. You may have heard of the phrase “tone at the top.” When the organization promotes a positive culture, that culture will be promoted by all employees and benefit not only the morale of the employees but also customers of that organization."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Because virtue ethics emphasizes individual character and conscience, it can have a tremendous influence on organizational culture by encouraging individuals to stand up for sound, ethical, and responsible business practices."
    }
   ],
   "community_solutions": []
  }
 ],
