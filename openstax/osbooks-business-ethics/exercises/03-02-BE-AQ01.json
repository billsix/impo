 "questions": [
  {
   "id": 647151,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A shareholder is a stakeholder who ________.",
   "answers": [
    {
     "id": 1274604,
     "content_html": "holds stock for investment",
     "correctness": "1.0"
    },
    {
     "id": 1274603,
     "content_html": "has a general interest in the fate of all publicly traded companies",
     "correctness": "0.0"
    },
    {
     "id": 1274602,
     "content_html": "focuses on the means by which firms get their products to market",
     "correctness": "0.0"
    },
    {
     "id": 1274601,
     "content_html": "always purchases the product or service of a particular company",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Shareholders purchase stock in the company, which is their investment in the organization. Some share types grant voting rights and/or pay dividends, but a shareholder’s investment is limited to the number of shares they purchase."
    }
   ],
