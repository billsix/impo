 "questions": [
  {
   "id": 647292,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The primary reason small-business entrepreneurs might want to hire mostly contract labor is that ________.",
   "answers": [
    {
     "id": 1274882,
     "content_html": "the cost of fringe benefits is reduced",
     "correctness": "1.0"
    },
    {
     "id": 1274881,
     "content_html": "only contract workers can be part-time but employees must be full-time",
     "correctness": "0.0"
    },
    {
     "id": 1274880,
     "content_html": "only employees can file workers compensation claims",
     "correctness": "0.0"
    },
    {
     "id": 1274879,
     "content_html": "it improves the company's stock price",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "free-response",
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Small businesses have very small margins. If they have contract labor, they can avoid employment costs such as employment taxes, worker’s comp, and healthcare, which aids their bottom line."
    }
   ],
   "community_solutions": []
  }
