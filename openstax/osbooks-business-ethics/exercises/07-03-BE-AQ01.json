 "questions": [
  {
   "id": 647222,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A patient becomes violent on hospital premises after being turned down for the clinical trial of a new drug therapy. This scenario fits which of the following workplace violence categories?",
   "answers": [
    {
     "id": 1274739,
     "content_html": "traditional criminal intent",
     "correctness": "0.0"
    },
    {
     "id": 1274738,
     "content_html": "violence by one worker against another",
     "correctness": "0.0"
    },
    {
     "id": 1274737,
     "content_html": "violence stemming from a personal relationship",
     "correctness": "0.0"
    },
    {
     "id": 1274740,
     "content_html": "violence by a customer",
     "correctness": "1.0",
     "feedback_html": ""
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Violence by a customer occurs when the violent person has a legitimate relationship with the business, perhaps as a customer or patient."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The physical altercation between the patient and the hospital is an example of a violence by the customer as the patient is a customer of a hospital. One way to diffuse the situation is by employing the HEAT method. The HEAT method is as follows: H – Hear them out (let them talk or vent), E – Empathize (show the customer you understand the concern), A – Apologize (does not mean you did something wrong), T- Take Ownership (work on a solution)."
    }
   ],
   "community_solutions": []
  }
 ],
