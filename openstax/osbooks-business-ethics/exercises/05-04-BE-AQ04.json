 "questions": [
  {
   "id": 672071,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Describe the challenge of identifying a universal set of ethics.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Each person will have a different view of morality. Ethics are the rules that the company has set, and most people will follow them. Issues may arise when those rules conflict with the individual’s morals."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Although many agree on the importance of goals like acting with honesty and fairness and treating people as ends rather than means, their implementation is extremely complex, because people have different understandings of what is honest, fair, or an end in itself. The result may be a series of diverse rules rather than one set."
    }
   ],
   "community_solutions": []
  }
 ],
