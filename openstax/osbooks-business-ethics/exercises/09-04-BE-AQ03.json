   "id": 647277,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the European tradition, the main responsibility for supplying workers with health care lies with which of these groups?",
   "answers": [
    {
     "id": 1274848,
     "content_html": "the government and labor unions",
     "correctness": "1.0"
    },
    {
     "id": 1274847,
     "content_html": "labor unions",
     "correctness": "0.0"
    },
    {
     "id": 1274846,
     "content_html": "nonprofit agencies and private companies",
     "correctness": "0.0"
    },
    {
     "id": 1274845,
     "content_html": "individual workers",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Most industrialized counties, not including the U.S., provide health insurance through a government program, similar to the Medicare model in the U.S., or through a worker’s labor union. The labor union’s plan is also similar to the Medicare model in the U.S."
    }
