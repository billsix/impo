   "stem_html": "Worker retraining programs for employees who lose their jobs to robots ________.",
   "answers": [
    {
     "id": 1274895,
     "content_html": "are a \"Band-Aid\" solution most of the time",
     "correctness": "0.0"
    },
    {
     "id": 1274894,
     "content_html": "will be needed only for a small minority of the workers who lose their jobs",
     "correctness": "0.0"
    },
    {
     "id": 1274893,
     "content_html": "are offered and funded by the employers only if a sufficient number of workers are displaced",
     "correctness": "0.0"
    },
    {
     "id": 1274896,
     "content_html": "are an obligation taken on by ethical companies",
     "correctness": "1.0"
    }
