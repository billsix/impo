   "stimulus_html": "",
   "stem_html": "Alternatives to animal testing for cancer drugs ________.",
   "answers": [
    {
     "id": 1274807,
     "content_html": "do not exist",
     "correctness": "0.0"
    },
    {
     "id": 1274806,
     "content_html": "exist but are prohibitively expensive",
     "correctness": "0.0"
    },
    {
     "id": 1274808,
     "content_html": "exist and are not any more expensive than animal testing",
     "correctness": "1.0"
    },
    {
     "id": 1274805,
     "content_html": "exist and are far cheaper than animal testing",
     "correctness": "0.0"
    }
   ],
   "hints": [],
   "formats": [
