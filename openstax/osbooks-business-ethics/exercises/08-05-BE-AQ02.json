   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "All cancer drugs must be approved by the FDA and have specific regulations that all manufacturers must follow. The cost of testing on animals vs. other means is not any less expensive."
    }
