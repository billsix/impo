 "questions": [
  {
   "id": 647171,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The law prohibits all executives from serving in senior government posts and then leaving to\ngo back to work for the same company in the private sector.",
   "answers": [
    {
     "id": 1274647,
     "content_html": "True",
     "correctness": "0.0",
     "feedback_html": ""
    },
    {
     "id": 1274648,
     "content_html": "False",
     "correctness": "1.0",
     "feedback_html": ""
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Legal restrictions exist to limit the revolving door effect, but most relate only to direct government contracting and/or lobbying."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "There are some federal and state laws that prevent executives from lobbying against the U.S. and/or state for an issue they worked on, but usually the period is short. However, these laws do not stop executives from working for the firm or on other projects."
    }
   ],
   "community_solutions": []
  }
