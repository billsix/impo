 "questions": [
  {
   "id": 672098,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Hiring a worker as an independent contractor saves an employer about 30 percent of the cost of an employee in benefits. Identify one or two of these benefits.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Independent contractors are not employees but in business for themselves and must pay for their own benefits, unless the independent contractor is an employee of a subcontractor."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Independent contractors are not covered by workers' compensation or unemployment insurance or health insurance coverage."
    }
   ],
   "community_solutions": []
  }
 ],
