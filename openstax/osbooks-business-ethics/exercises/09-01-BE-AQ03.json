   "stem_html": "Corporate culture comes from ________.",
   "answers": [
    {
     "id": 1274821,
     "content_html": "the commitment of the company's employees",
     "correctness": "0.0"
    },
    {
     "id": 1274822,
     "content_html": "the founder's idea of what the work environment should be like",
     "correctness": "1.0"
    },
    {
     "id": 1274820,
     "content_html": "government regulations about labor relations",
     "correctness": "0.0"
    },
    {
     "id": 1274819,
     "content_html": "the nature of the company’s product or service",
     "correctness": "0.0"
    }
