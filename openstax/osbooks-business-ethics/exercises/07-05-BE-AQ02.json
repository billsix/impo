   "id": 647233,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Most U.S. companies prohibit employees from disclosing or discussing salaries among\nthemselves.",
   "answers": [
    {
     "id": 1274761,
     "content_html": "True",
     "correctness": "0.0",
     "feedback_html": ""
    },
    {
     "id": 1274762,
     "content_html": "False",
     "correctness": "1.0",
     "feedback_html": ""
    }
   ],
   "hints": [],
   "formats": [
    "true-false"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Generally speaking, labor law gives workers the right to discuss among themselves the specifics of their individual employment agreements, including matters of salary."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Employees are allowed to speak among themselves. However, if it becomes disruptive, an employer may take action, especially in right-to-work states."
    }
   ],
   "community_solutions": []
  }
