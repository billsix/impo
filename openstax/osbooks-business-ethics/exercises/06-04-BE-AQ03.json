 "questions": [
  {
   "id": 672079,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why would a company want to monitor Internet use at work?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Inappropriate usage of the Internet could be considered time theft or could get a business in trouble if the wrong site is visited or information gets hacked."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "There are at least two reasons a company might want to monitor Internet use at work: productivity and electronic security. Managers do not want employees wasting time or exposing the company to breaches of data security, identity theft, or the legal ramifications of inappropriate or offensive behavior."
    }
   ],
   "community_solutions": []
  }
 ],
