   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Minimum wages have not kept up with inflation; in fact, they have fallen far behind."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Minimum wages in some areas have not been updated in years. Unlike social security, there is no mechanism to increase the wage yearly; rather, it must be done by an act of Congress at the federal level and by state or local lawmakers."
    }
   ],
