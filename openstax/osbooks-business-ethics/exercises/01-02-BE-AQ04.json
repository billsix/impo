 "questions": [
  {
   "id": 672047,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Describe a practical way to prioritize the claims of stakeholders.",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "The first step is identifying key internal and external stakeholders of the business. Your stakeholders will be different depending upon the environment in which your business is located. Your second step would then be to analyze those stakeholders found in step 1 based on their ability to influence change and how they are impacted by changes made. You can align them on a bar graph or table by the level of impact (high or low) and the ability to influence change (low to high). Finally, once that analysis is complete, you would prioritize the stakeholder from highest to lowest based on their ability to influence change outcomes, the extent to which they are impacted, their awareness of the business model, and how much support they provide."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "In three columns, list stakeholders in order of perceived priority, their perceived interests, and the likely impact of the business decision on them. This will aid comprehension of the decision’s impacts as well as provide justification for the course of conduct ultimately chosen."
    }
   ],
   "community_solutions": []
  }
 ],
