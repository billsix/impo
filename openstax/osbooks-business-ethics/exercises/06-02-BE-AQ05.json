   "stimulus_html": "",
   "stem_html": "What are some of the reasons that have contributed to women making less than men in similar jobs?",
   "answers": [],
   "hints": [],
   "formats": [
    "free-response"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Another reason is that a woman may take time off to start a family, which could lead to others being promoted to fill the gap."
    },
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Among the factors are discrimination, historical wage rates, and artificially manipulated job titles."
    }
   ],
