   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "In Confucian ethics, the locus of ethics and moral decision making was the family rather than the individual. The most important value was the development of humanity and putting an end to anarchy, and this was done best in the context of the family."
    },
    {
     "images": [],
     "solution_type": "summary",
     "content_html": "Confucius’s theories were based on the family, which included friends, workers, and children. The only way to make society better was to focus on everyone, not just one."
    }
   ],
   "community_solutions": []
  }
