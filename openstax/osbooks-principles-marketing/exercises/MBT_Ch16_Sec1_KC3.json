 "questions": [
  {
   "id": 677114,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which type of marketing involves creating and distributing content that is valuable and relevant to a company’s target customers?",
   "answers": [
    {
     "id": 1345707,
     "content_html": "Website marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Websites serve a variety of purposes, and although they certainly house content, they are strictly a distribution channel for content."
    },
    {
     "id": 1345706,
     "content_html": "Blog marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Blogs are a type of content and therefore part of the larger content marketing strategy."
    },
    {
     "id": 1345705,
     "content_html": "Email marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Email marketing is a type of direct marketing that is highly personal and designed to build relationships with consumers, but it does not rely on creating and distributing valuable and relevant content."
    },
    {
     "id": 1345708,
     "content_html": "Content marketing",
     "correctness": "1.0",
     "feedback_html": "Content marketing involves creating and distributing content that consumers find meaningful and valuable. With content marketing, marketers must anticipate what type of content their audience wants and tell their story in a way that the audience can relate to."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
