 "questions": [
  {
   "id": 677038,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "One of the promotional mix methods is advertising. Advertising may be defined as any ________.",
   "answers": [
    {
     "id": 1345403,
     "content_html": "communications about a good, service, or company",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. General communication from a company to a target market could happen through any of the promotional mix methods."
    },
    {
     "id": 1345404,
     "content_html": "paid forms of nonpersonal communication about a good, service, or company",
     "correctness": "1.0",
     "feedback_html": "The promotional mix method of advertising is a paid form of nonpersonal communication."
    },
    {
     "id": 1345402,
     "content_html": "communication that moves the product from the wholesaler to the retailer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Communication between the channel members is not typically done through advertising."
    },
    {
     "id": 1345401,
     "content_html": "communication from a company sales representative to a company buyer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Communication from a company sales representative to a company buyer is personal selling."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The promotional mix method of advertising is a paid form of nonpersonal communication."
    }
