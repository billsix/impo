   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Tomas is selling his bottled sodas for $2.00 each at the vendor fair. His fixed costs are $100. He estimates that his variable costs are $0.25 per bottle. How many bottles of soda must Tomas sell to break even?",
   "answers": [
    {
     "id": 1345368,
     "content_html": "57",
     "correctness": "1.0",
     "feedback_html": "<span data-math=\"Break\\;Even\\;in\\;Units = Fixed\\;Costs/(Unit\\;Price-Variable\\;Unit\\;Cost) = 100/(2.00 - 0.25)\"></span>"
    },
    {
     "id": 1345367,
     "content_html": "2",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Please refer to the formula and check your math."
    },
