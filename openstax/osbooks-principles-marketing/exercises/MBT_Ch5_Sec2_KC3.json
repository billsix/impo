 "questions": [
  {
   "id": 676849,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which form of B2B market segmentation differentiates customers according to their “transactional worth”?",
   "answers": [
    {
     "id": 1344647,
     "content_html": "Behavioral",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Behavioral segmentation looks at the behavior of an organization&#8217;s customers toward its products or services."
    },
    {
     "id": 1344646,
     "content_html": "Firmographics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Firmographics segments customers based on sets of characteristics such as industry, location, size, legal structure, and performance."
    },
    {
     "id": 1344648,
     "content_html": "Value based",
     "correctness": "1.0",
     "feedback_html": "Value-based segmentation (sometimes called tiering or profitability segmentation) groups customers according to the potential value they may bring to a business."
    },
    {
     "id": 1344645,
     "content_html": "Needs based",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Needs-based segmentation clusters groups of customers on the basis of what they normally look for in a product."
    }
   ],
