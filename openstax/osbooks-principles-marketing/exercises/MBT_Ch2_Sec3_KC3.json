 "questions": [
  {
   "id": 676799,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a perceptual map, and how is it used?",
   "answers": [
    {
     "id": 1344447,
     "content_html": "A perceptual map indicates the relative strength of competitors in the market segment.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A perceptual map does not suggest the relative strength of competitors in the market segment."
    },
    {
     "id": 1344446,
     "content_html": "A perceptual map indicates the relative market share and market growth of a product portfolio.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A perceptual map does not indicate the relative market share and market growth of a product portfolio. That is a BCG matrix."
    },
    {
     "id": 1344448,
     "content_html": "A perceptual map illustrates product positioning vis-à-vis the competitors.",
     "correctness": "1.0",
     "feedback_html": "A perceptual map suggests where your product or service stands in relation to the competition."
    },
    {
     "id": 1344445,
     "content_html": "A perceptual map displays the product, pricing, promotion, and distribution strategy of the product or service.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product, pricing, promotion, and distribution strategy are not displayed on a perceptual map."
    }
   ],
