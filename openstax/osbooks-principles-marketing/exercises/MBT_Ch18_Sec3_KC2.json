 "questions": [
  {
   "id": 677168,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A superstore chain is planning to open an establishment in the town Levi lives in. Which of the following would be the most likely location for this superstore?",
   "answers": [
    {
     "id": 1345923,
     "content_html": "Central business district",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Central business districts tend to have smaller spaces available than needed for a superstore."
    },
    {
     "id": 1345922,
     "content_html": "Strip mall",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Strip malls consist of smaller retailers."
    },
    {
     "id": 1345924,
     "content_html": "Freestanding location",
     "correctness": "1.0",
     "feedback_html": "Superstores generally choose a freestanding location."
    },
    {
     "id": 1345921,
     "content_html": "Regional shopping district",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Regional shopping districts, also called malls, often do not house superstores."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
