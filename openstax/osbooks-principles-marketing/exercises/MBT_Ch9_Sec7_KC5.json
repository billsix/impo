 "questions": [
  {
   "id": 676966,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The brand team at a technology company created product packaging that was enjoyable to unbox. This is an example of packaging used as a marketing tool for ________.",
   "answers": [
    {
     "id": 1345115,
     "content_html": "brand differentiation ",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Packaging that makes a brand unique is brand differentiation. "
    },
    {
     "id": 1345116,
     "content_html": "creating customer experience ",
     "correctness": "1.0",
     "feedback_html": "Customer experience is created when the package adds to the experience of consuming the brand. "
    },
    {
     "id": 1345114,
     "content_html": "displaying value",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Packaging in this case is not about displaying value. "
    },
    {
     "id": 1345113,
     "content_html": "encouraging people to purchase",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A package may encourage purchase, but that is not one of the ways that packaging is used as a marketing tool. "
    }
   ],
