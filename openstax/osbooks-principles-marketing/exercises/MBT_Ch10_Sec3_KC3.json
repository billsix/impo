   "stimulus_html": "",
   "stem_html": "To calculate this metric, the return of the investment is divided by its cost.",
   "answers": [
    {
     "id": 1345187,
     "content_html": "Time to value (TTV)",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Time to value is how long it takes new users to recognize the value of your product."
    },
    {
     "id": 1345186,
     "content_html": "R&amp;D spending as a percentage of sales",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. R&#38;D spending as a percentage of sales is a metric used to compare the effectiveness of R&#38;D expenditures between companies in the same industry."
    },
    {
     "id": 1345188,
     "content_html": "ROI",
     "correctness": "1.0",
     "feedback_html": "Return on investment (ROI) is a performance measure used to evaluate the profitability of new product development."
    },
    {
     "id": 1345185,
     "content_html": "Revenue growth rate",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Revenue growth rate measures the percentage increase in revenue."
    }
