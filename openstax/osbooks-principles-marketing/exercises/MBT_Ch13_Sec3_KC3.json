 "questions": [
  {
   "id": 677049,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When Sally is able to quickly recall the Taco Bell ad and think about purchasing a Grilled Steak Burrito from Taco Bell when she is hungry, it indicates which of the following benefits of an integrated marketing communications approach?",
   "answers": [
    {
     "id": 1345447,
     "content_html": "Increased efficiency",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Increased efficiency helps Taco Bell to better create and distribute its messaging."
    },
    {
     "id": 1345446,
     "content_html": "Customer satisfaction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. From this scenario, we do not know if Sally is satisfied with Taco Bell."
    },
    {
     "id": 1345448,
     "content_html": "Improved brand awareness",
     "correctness": "1.0",
     "feedback_html": "Sally&#8217;s ability to recall and think of Taco Bell to fulfill her needs is a benefit of improved brand awareness."
    },
    {
     "id": 1345445,
     "content_html": "Expense",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Expense is not a benefit of integrated marketing communications."
    }
   ],
