 "questions": [
  {
   "id": 676934,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A package of gum at the checkout of a grocery store is considered a(n) ________ product.",
   "answers": [
    {
     "id": 1344988,
     "content_html": "convenience",
     "correctness": "1.0",
     "feedback_html": "A convenience product is widely available, has a low cost, and does not require a lot of consideration."
    },
    {
     "id": 1344987,
     "content_html": "shopping",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A shopping product has a higher cost than a package of gum and typically involves comparison shopping. "
    },
    {
     "id": 1344986,
     "content_html": "specialty",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A specialty product is one that is unique and higher cost than a package of gum. "
    },
    {
     "id": 1344985,
     "content_html": "unsought",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. An unsought product is one that customers typically do not intend to buy or do not know much about."
    }
   ],
   "hints": [],
