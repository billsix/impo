 "questions": [
  {
   "id": 677122,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes why online marketing metrics are important?",
   "answers": [
    {
     "id": 1345739,
     "content_html": "Online marketing metrics help marketers understand whether or not their products and services create value for consumers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Online marketing metrics do not really help marketers understand how their product and service provide value to consumers."
    },
    {
     "id": 1345738,
     "content_html": "Online marketing metrics are an important part of understanding the factors that influence consumer behavior.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Online marketing metrics so not help marketers understand consumer behavior."
    },
    {
     "id": 1345737,
     "content_html": "Online marketing metrics help marketers measure the effectiveness of marketing managers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Online marketing metrics do not measure the effectiveness of marketing managers."
    },
    {
     "id": 1345740,
     "content_html": "Online marketing metrics help marketers measure the performance of their online marketing campaigns.",
     "correctness": "1.0",
     "feedback_html": "Online marketing metrics help marketers measure the performance of their online marketing campaigns."
    }
   ],
