 "questions": [
  {
   "id": 676834,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Shane’s company has been experiencing a downturn in sales, and cash is tight right now. This has caused Shane to look only at suppliers who offer credit to the company. Which factor appears to be influencing the B2B purchase?",
   "answers": [
    {
     "id": 1344587,
     "content_html": "External factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. External factors include economic conditions, the political/legal environment, competition, and the social environment."
    },
    {
     "id": 1344586,
     "content_html": "Internal factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Internal factors include business objectives and goals, technology, and workforce skills."
    },
    {
     "id": 1344585,
     "content_html": "Interpersonal factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Interpersonal factors include formal/informal authority, technical expertise, influence, and organizational politics and culture."
    },
    {
     "id": 1344588,
     "content_html": "Conditional factors",
     "correctness": "1.0",
     "feedback_html": "Conditional factors include the present financial condition of the organization, as well as product/service availability."
    }
   ],
