  {
   "id": 677055,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When Nestlé shows an advertisement that has children coming down the stairs on Christmas morning to the smell of freshly baked Nestlé Tollhouse chocolate chip cookies, this is an example of which method of message appeal?",
   "answers": [
    {
     "id": 1345471,
     "content_html": "Rational",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Nestl&#233; Tollhouse is not working to rationalize the use of its product."
    },
    {
     "id": 1345472,
     "content_html": "Emotional",
     "correctness": "1.0",
     "feedback_html": "Nestl&#233; Tollhouse is working to create an emotional connection with the consumer."
    },
    {
     "id": 1345470,
     "content_html": "Fear",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Nestl&#233; Tollhouse does not want to create fear as an association with their product."
    },
    {
     "id": 1345469,
     "content_html": "Moral",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Using Nestl&#233; Tollhouse products is not a moral decision."
    }
   ],
