   "stem_html": "During the societal marketing concept, ________.",
   "answers": [
    {
     "id": 1344355,
     "content_html": "customers’ wants and needs were first identified as essential",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customers&#8217; wants and needs became the focus during the marketing era."
    },
    {
     "id": 1344356,
     "content_html": "trustfulness, honesty, and transparency became most important",
     "correctness": "1.0",
     "feedback_html": "During the societal era, it was recognized that society as a whole, had to be considered in all activities."
    },
    {
     "id": 1344354,
     "content_html": "promotional efforts to move inventory were essential",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The focus on promotional activities to move inventory occurred during the sales era."
    },
    {
     "id": 1344353,
     "content_html": "the customer was the focus",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The customers became the focus during the marketing era."
    }
