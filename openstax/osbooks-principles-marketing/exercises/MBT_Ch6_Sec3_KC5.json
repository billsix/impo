 "questions": [
  {
   "id": 676886,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Why would a researcher want to use a cross tabulation?",
   "answers": [
    {
     "id": 1344796,
     "content_html": "It shows how respondents answered two variables in relation to each other and can help determine patterns by different groups of respondents.",
     "correctness": "1.0",
     "feedback_html": "A cross tabulation shows the relationship of two different variables, so the researcher can see if there is correlation between the two."
    },
    {
     "id": 1344795,
     "content_html": "By presenting the data in the form of a picture, the information is easier for the reader to understand.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An infographic is best for presenting information in a visual and easily digestible format."
    },
    {
     "id": 1344794,
     "content_html": "It is an easy way to see how often one answer is selected by the respondents.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. When you look at only one variable, it is impossible to complete a cross tabulation, which requires two."
    },
    {
     "id": 1344793,
     "content_html": "This analysis can used to present interview or focus group data.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Focus group or interview data is qualitative and cannot be analyzed using cross tabulation."
    }
   ],
