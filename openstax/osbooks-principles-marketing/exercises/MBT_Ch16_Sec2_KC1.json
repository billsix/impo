 "questions": [
  {
   "id": 677117,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an advantage of social media marketing?",
   "answers": [
    {
     "id": 1345720,
     "content_html": "Social media is highly targeted in its ability to reach segments of consumers who share common interests and demographics.",
     "correctness": "1.0",
     "feedback_html": "An advantage of social media marketing is that companies can concentrate their promotional efforts on very specific groups of consumers who share common interests and demographics."
    },
    {
     "id": 1345719,
     "content_html": "With social media, marketers have complete control of the message.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketers do not have control over the message on social media. Consumers have the power to react and respond to companies&#8217; messages as they see fit."
    },
    {
     "id": 1345718,
     "content_html": "Social media is very easy to manage and requires few resources.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social media requires dedicated resources, particularly people who can monitor and respond to social media comments."
    },
    {
     "id": 1345717,
     "content_html": "Social media is the best channel for the B2B market.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While social media sites like LinkedIn are great a channel for engaging customers, the effectiveness of the channel depends on a number of factors, such as type of business, type of industry, and what is being offered."
    }
   ],
