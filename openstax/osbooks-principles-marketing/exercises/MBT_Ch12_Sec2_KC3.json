 "questions": [
  {
   "id": 677019,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Kevin is a marketing intern at a large corporation. They are tasked with presenting a price for a new service the company will be offering. Which of the following would you recommend Kevin do first?",
   "answers": [
    {
     "id": 1345328,
     "content_html": "Analyze the critical Cs of pricing",
     "correctness": "1.0",
     "feedback_html": "Analyzing the critical Cs of pricing will help ensure the pricing strategies are set appropriately."
    },
    {
     "id": 1345327,
     "content_html": "Choose a pricing strategy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Choosing a pricing strategy should not be done before analyzing the critical Cs of pricing."
    },
    {
     "id": 1345326,
     "content_html": "Create an advertisement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Creating an advertisement for the new service should be done well after pricing is determined."
    },
    {
     "id": 1345325,
     "content_html": "Ask his friends what price they would be willing to pay",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Asking their friends what a fair price would be will not yield appropriate data that Kevin needs for determining pricing."
    }
   ],
