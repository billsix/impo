 "questions": [
  {
   "id": 677178,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Your friend Jesus wants to start a retailing business but doesn’t think he can afford space, nor does he wish to travel and make sales calls to retailers. Which of the following might be the best warehousing option for Jesus?",
   "answers": [
    {
     "id": 1345963,
     "content_html": "Rack jobber",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Rack jobbers sell, display, and maintain products in retail establishments."
    },
    {
     "id": 1345962,
     "content_html": "Specialty wholesaler",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Specialty wholesalers buy in bulk from specialty product lines and sell to retailers, who in turn sell to consumers."
    },
    {
     "id": 1345961,
     "content_html": "Cash-and-carry wholesaler",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cash-and-carry wholesalers allow retailers to purchase fast-moving products with cash."
    },
    {
     "id": 1345964,
     "content_html": "Drop shipper",
     "correctness": "1.0",
     "feedback_html": "Retailers use drop shippers to ship products directly to the end consumer."
    }
   ],
   "hints": [],
