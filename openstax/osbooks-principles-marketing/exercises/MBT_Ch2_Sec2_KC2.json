 "questions": [
  {
   "id": 676793,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What key metrics does the BCG matrix use to show the relative attractiveness of different offerings?",
   "answers": [
    {
     "id": 1344424,
     "content_html": "Market share and market growth rate",
     "correctness": "1.0",
     "feedback_html": "The BCG matrix captures the market share and market growth of products in a portfolio of offerings."
    },
    {
     "id": 1344423,
     "content_html": "Market size and market share",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The BCG matrix does not capture market size."
    },
    {
     "id": 1344422,
     "content_html": "The ratio of dogs to cash cows in the product portfolio",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The BCG matrix does not show the ratio of dogs to cash cows in the product portfolio."
    },
    {
     "id": 1344421,
     "content_html": "The potential for question marks to cross over and become stars",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The BCG matrix does not show the potential for question marks to cross over and become stars."
    }
   ],
