 "questions": [
  {
   "id": 676946,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": " Which of the following is a reason that brands may not follow the product life cycle sequentially? ",
   "answers": [
    {
     "id": 1345035,
     "content_html": "Brands can grow rapidly.",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. While brands can grow rapidly, they still may follow the linear process of the product life cycle. "
    },
    {
     "id": 1345034,
     "content_html": "Brands can skip the product life cycle all together.",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Brands always follow some elements of the product life cycle. "
    },
    {
     "id": 1345036,
     "content_html": "Brands can be a fad.",
     "correctness": "1.0",
     "feedback_html": "Brands that are a fad are typically introduced, grow rapidly, and decline quickly."
    },
    {
     "id": 1345033,
     "content_html": "Brands can skip to maturity right away.",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Brands always start with the introduction stage. "
    }
   ],
