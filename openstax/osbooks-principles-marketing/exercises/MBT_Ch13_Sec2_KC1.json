 "questions": [
  {
   "id": 677042,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When a message is created and the company chooses to have a celebrity as the spokesperson, what does the celebrity represent in the communication process?",
   "answers": [
    {
     "id": 1345420,
     "content_html": "Sender",
     "correctness": "1.0",
     "feedback_html": "The celebrity is the paid spokesperson of the company, and they are the sender of the message."
    },
    {
     "id": 1345419,
     "content_html": "Feedback loop",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The feedback loop is the part of the communication process that allows the sender to know the message was received."
    },
    {
     "id": 1345418,
     "content_html": "Medium",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The medium is the channel through which the message is sent."
    },
    {
     "id": 1345417,
     "content_html": "Noise",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Noise is any distraction that gets in the way of the sender and the receiver."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The celebrity is the paid spokesperson of the company, and they are the sender of the message."
    }
   ],
