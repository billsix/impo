 "questions": [
  {
   "id": 676786,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A program that offers discounts and special incentives designed to attract and retain customers is called a ________.",
   "answers": [
    {
     "id": 1344396,
     "content_html": "customer loyalty program",
     "correctness": "1.0",
     "feedback_html": "A customer loyalty program offers rewards, discounts, and other special incentives designed to attract and retain customers."
    },
    {
     "id": 1344395,
     "content_html": "sweepstakes",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A sweepstakes is a promotional program."
    },
    {
     "id": 1344394,
     "content_html": "discount plan",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A discount plan is an arrangement or contract in which a consumer pays less than another."
    },
    {
     "id": 1344393,
     "content_html": "CRM software",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer relationship management (CRM) software is the means through which companies track, manage, and analyze customer interactions."
    }
   ],
