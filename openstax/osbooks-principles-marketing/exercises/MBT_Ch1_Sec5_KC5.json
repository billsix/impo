 "questions": [
  {
   "id": 676781,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes a satisfactory exchange process?",
   "answers": [
    {
     "id": 1344375,
     "content_html": "One that allows the seller to incur the highest profit possible",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Profit is important, but it cannot be attained at the cost of the customer."
    },
    {
     "id": 1344374,
     "content_html": "One that allows the buyer to pay the lowest price possible",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The seller&#8217;s satisfaction with price is important, but it cannot occur at the cost of the seller; otherwise, the business would fail and not allow for future sales."
    },
    {
     "id": 1344376,
     "content_html": "One that fairly addresses the needs of both the seller and buyer",
     "correctness": "1.0",
     "feedback_html": "The exchange process is designed to allow for the transaction to occur without either party feeling like the other has benefitted at its own cost."
    },
    {
     "id": 1344373,
     "content_html": "One that is most convenient without regard for either the seller or buyer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. For an exchange process to be effective, both the seller and buyer must benefit."
    }
   ],
