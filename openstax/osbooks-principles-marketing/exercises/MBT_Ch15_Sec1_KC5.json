 "questions": [
  {
   "id": 677086,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jasmine works for a Honda dealership. Jasmine has spent considerable time listening to a potential customer talk about what features they are looking for in a new car. Jasmine is able to identify the best Honda automobile to meet the needs of the customer. What feature of sales is Jasmine demonstrating?",
   "answers": [
    {
     "id": 1345595,
     "content_html": "One-on-one interaction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. One-on-one interaction is only one aspect that Jasmine has demonstrated. She has also demonstrated others."
    },
    {
     "id": 1345594,
     "content_html": "Meeting the needs and wants",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Meeting a customer&#8217;s needs and wants is only one aspect that Jasmine has demonstrated. She has also demonstrated others."
    },
    {
     "id": 1345593,
     "content_html": "Personal communication",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal communication is only one aspect that Jasmine has demonstrated. She has also demonstrated others."
    },
    {
     "id": 1345596,
     "content_html": "All of these features are correct.",
     "correctness": "1.0",
     "feedback_html": "Jasmine has effectively demonstrated the personal selling skills of one-on-one interaction with the customer, meeting the needs and wants of the customer, and having personal communication with the customer to satisfy their needs and wants."
    }
   ],
   "hints": [],
