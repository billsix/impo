 "questions": [
  {
   "id": 676947,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Mohammad's Shoe Company is expanding distribution for its most popular shoe line. The shoe line is in the ________ stage of the product life cycle.",
   "answers": [
    {
     "id": 1345039,
     "content_html": "introduction",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Pricing strategies are most common during the introduction stage of the product life cycle. "
    },
    {
     "id": 1345040,
     "content_html": "growth",
     "correctness": "1.0",
     "feedback_html": "The growth stage of the product life cycle is characterized by increasing distribution channels."
    },
    {
     "id": 1345038,
     "content_html": "maturity",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Product and market modification are most common during the maturity stage of the product life cycle. "
    },
    {
     "id": 1345037,
     "content_html": "decline",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Harvesting and divesture are most common during the decline stage of the product life cycle. "
    }
   ],
