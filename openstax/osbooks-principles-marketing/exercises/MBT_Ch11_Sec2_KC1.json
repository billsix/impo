 "questions": [
  {
   "id": 677002,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to the service-profit chain model, what drives organizational profitability and growth?",
   "answers": [
    {
     "id": 1345259,
     "content_html": "Internal service quality",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. According to the service-profit chain model, internal service quality drives employee satisfaction."
    },
    {
     "id": 1345258,
     "content_html": "Employee satisfaction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. According to the service-profit chain model, employee satisfaction drives loyalty and productivity and creates value."
    },
    {
     "id": 1345260,
     "content_html": "Customer loyalty",
     "correctness": "1.0",
     "feedback_html": "According to the service-profit chain model, customer loyalty drives profitability and growth."
    },
    {
     "id": 1345257,
     "content_html": "Value",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. According to the service-profit chain model, value drives customer satisfaction, which in turn drives customer loyalty."
    }
   ],
