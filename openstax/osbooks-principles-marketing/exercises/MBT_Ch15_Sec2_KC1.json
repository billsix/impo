  {
   "id": 677087,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The practice of using call centers, where employees receive calls from customers and provide service by taking orders and answering queries, is called ________.",
   "answers": [
    {
     "id": 1345599,
     "content_html": "customer response marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer response marketing is not a strategy."
    },
    {
     "id": 1345598,
     "content_html": "guerilla marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Guerilla marketing is a set of unconventional market strategies used by companies to get noticed quickly in the marketplace."
    },
    {
     "id": 1345597,
     "content_html": "reactive marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Reactive marketing is used in response to something done by another company in the market."
    },
    {
     "id": 1345600,
     "content_html": "inside order taking",
     "correctness": "1.0",
     "feedback_html": "When customers call into a company to place an order an inside order taker is the person answering and taking the order."
    }
   ],
