 "questions": [
  {
   "id": 677024,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Decreases in prices are most often associated with which stage of the product life cycle?",
   "answers": [
    {
     "id": 1345347,
     "content_html": "Introduction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While a company may choose an initially low price for a new product, there is no initial price for it to be lowered from."
    },
    {
     "id": 1345346,
     "content_html": "Growth",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Prices are not generally lowered when a company is experiencing growth in a product&#8217;s demand."
    },
    {
     "id": 1345345,
     "content_html": "Maturity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. During maturity, demand begins to flatten out; companies will typically leave prices the same to maximize profits."
    },
    {
     "id": 1345348,
     "content_html": "Decline",
     "correctness": "1.0",
     "feedback_html": "As demand declines for a product, it is generally expected that prices will also decrease."
    }
   ],
