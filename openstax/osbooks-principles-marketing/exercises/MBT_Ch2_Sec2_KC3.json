   "id": 676794,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Hoffman Enterprises has a portfolio of businesses in a wide variety of unrelated industries. One of its strategic business units (SBUs) has high market share in a low-growth industry. How would this SBU be characterized in terms of the BCG matrix?",
   "answers": [
    {
     "id": 1344427,
     "content_html": "Star",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A star has high market share in a high-growth industry."
    },
    {
     "id": 1344426,
     "content_html": "Dog",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A dog has low market share in a low-growth industry."
    },
    {
     "id": 1344428,
     "content_html": "Cash cow",
     "correctness": "1.0",
     "feedback_html": "A cash cow has high market share in a low-growth industry."
    },
    {
     "id": 1344425,
     "content_html": "Question mark",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A question mark has low market share in a high-growth industry."
    }
   ],
