 "questions": [
  {
   "id": 677181,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ are companies that agree with retailers to display and sell products in-store.",
   "answers": [
    {
     "id": 1345976,
     "content_html": "Rack jobbers",
     "correctness": "1.0",
     "feedback_html": "Rack jobbers are companies that agree with retailers to display and sell products in-store."
    },
    {
     "id": 1345975,
     "content_html": "Cash-and-carry wholesalers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cash and carry wholesalers offer limited lines at discounted prices for cash"
    },
    {
     "id": 1345974,
     "content_html": "Drop shippers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Drop shippers ship products directly to the end consumer but the consumer purchases the product through the retailer."
    },
    {
     "id": 1345973,
     "content_html": "Truck jobbers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Truck jobbers are wholesalers who make calls to retailers with goods on their truck to sell immediately."
    }
   ],
