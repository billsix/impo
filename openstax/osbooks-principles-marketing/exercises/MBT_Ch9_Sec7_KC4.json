 "questions": [
  {
   "id": 676965,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Maria purchased a Louis Vuitton purse for her mom because of the dust cover that protects the purse from wear and tear. This is an example of packaging used as a marketing tool for ________.",
   "answers": [
    {
     "id": 1345111,
     "content_html": "brand differentiation ",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Packaging that makes a brand unique is brand differentiation. "
    },
    {
     "id": 1345110,
     "content_html": "creating customer experience ",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Customer experience is created when the package adds to the experience of consuming the brand. "
    },
    {
     "id": 1345112,
     "content_html": "displaying value",
     "correctness": "1.0",
     "feedback_html": "The package displayed value to the consumer."
    },
    {
     "id": 1345109,
     "content_html": "encouraging people to purchase",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A package may encourage purchase, but that is not one of the ways that packaging is used as a marketing tool. "
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "The package displayed value to the consumer."
    }
   ],
