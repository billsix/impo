 "questions": [
  {
   "id": 677124,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Warton Hotel is running an online marketing campaign and would like to measure the percentage of people who only visit its site one time. Which online marketing metric would be most helpful to the hotel in this situation?",
   "answers": [
    {
     "id": 1345747,
     "content_html": "Counting new and returning customers who visit the site",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Counting new and returning users gives online marketers the opportunity to assess how effective their campaigns are in driving new customers to their website."
    },
    {
     "id": 1345746,
     "content_html": "Counting page views",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Counting page views helps marketers assess which of their pages are most popular and which need revision."
    },
    {
     "id": 1345748,
     "content_html": "Examining the bounce rate",
     "correctness": "1.0",
     "feedback_html": "The bounce rate measures the percentage of times visitors leave your site after visiting only one page."
    },
    {
     "id": 1345745,
     "content_html": "Counting unique users",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Counting unique visitors is the same as counting new users. Unique or new visitors indicate the success of online marketing campaigns in driving traffic to the company&#8217;s website."
    }
   ],
