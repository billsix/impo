 "questions": [
  {
   "id": 676936,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At the beginning of this chapter, we learned about the Peloton brand. Peloton users use not only the physical bike also but online classes with an instructor to stay fit within their own homes. This need represents the ________ product.",
   "answers": [
    {
     "id": 1344995,
     "content_html": "core",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. The core product is the bike."
    },
    {
     "id": 1344994,
     "content_html": "actual",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. The actual product includes the product features, brand, level of quality, packaging, and design. "
    },
    {
     "id": 1344996,
     "content_html": "augmented ",
     "correctness": "1.0",
     "feedback_html": "The customer seeks both the core product (the bike) and the online classes, warranty, customer service, and support (the augmented product) in order to stay fit. "
    },
    {
     "id": 1344993,
     "content_html": "valued",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Valued products are not a marketing concept. "
    }
   ],
