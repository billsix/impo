 "questions": [
  {
   "id": 677113,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best summarizes the cause for the emergence of online direct marketing as a promotion tool?",
   "answers": [
    {
     "id": 1345704,
     "content_html": "The explosion of internet usage, online shopping, and smartphone usage and the advancement of digital marketing technologies best explains the emergence of online direct marketing.",
     "correctness": "1.0",
     "feedback_html": "As consumers are more connected to the internet via their mobile devices and digital technologies have evolved, online direct marketing has emerged as a practical promotion tool for reaching consumers."
    },
    {
     "id": 1345703,
     "content_html": "Consumers are spending less time watching movies and shows.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Consumers&#8217; viewing habits related to movies and shows have actually increased with the birth of Netflix, Amazon Prime Video, and other streaming services."
    },
    {
     "id": 1345702,
     "content_html": "Traditional direct marketing tools have gotten too expensive and are no longer effective at engaging customers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although traditional direct marketing tools are more expensive, some tools, such as catalogs, have seen an increase in usage because of their effectiveness in standing out."
    },
    {
     "id": 1345701,
     "content_html": "Traditional direct marketing doesn’t offer the same degree of message relevance that online direct marketing does.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Traditional direct marketing has the capability of offering consumers relevant messages and can be tailored to individual consumers."
    }
   ],
