   "stimulus_html": "",
   "stem_html": "Which of the following Coca-Cola slogans is used in New Zealand?",
   "answers": [
    {
     "id": 1344868,
     "content_html": "“Real Magic”",
     "correctness": "1.0",
     "feedback_html": "&#8220;Real Magic&#8221; is Coca-Cola&#8217;s slogan in New Zealand."
    },
    {
     "id": 1344867,
     "content_html": "“Always the Real Thing”",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. &#8220;Always the Real Thing&#8221; is Coca-Cola&#8217;s slogan in India."
    },
    {
     "id": 1344866,
     "content_html": "“Feel the Flavor”",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. &#8220;Feel the Flavor&#8221; is Coca-Cola&#8217;s slogan in Spain."
    },
    {
     "id": 1344865,
     "content_html": "“Feel the Magic”",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. &#8220;Feel the Magic&#8221; is Coca-Cola&#8217;s slogan in Indonesia."
    }
