 "questions": [
  {
   "id": 676879,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is not a source of marketing information?",
   "answers": [
    {
     "id": 1344767,
     "content_html": "Journal articles",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Journal articles are a source of marketing information data, specifically secondary data."
    },
    {
     "id": 1344766,
     "content_html": "Social media posts",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social media posts are a source of marketing information data, specifically secondary data."
    },
    {
     "id": 1344765,
     "content_html": "Experiments",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Experiments are a source of primary marketing research data."
    },
    {
     "id": 1344768,
     "content_html": "Marketing information systems",
     "correctness": "1.0",
     "feedback_html": "A marketing information system is not a source of information&#8212;it is where the information is stored within a business."
    }
   ],
