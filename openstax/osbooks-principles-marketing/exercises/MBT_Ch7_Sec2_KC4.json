 "questions": [
  {
   "id": 676895,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the Russian invasion of Ukraine in 2022, United States President Joe Biden halted all imports of Russian oil. This action is known as a(n) ________.",
   "answers": [
    {
     "id": 1344831,
     "content_html": "tariff",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A tariff is a tax imposed on imports."
    },
    {
     "id": 1344830,
     "content_html": "quota",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A quota is a maximum number of units a country will import of a particular good."
    },
    {
     "id": 1344829,
     "content_html": "trade bloc",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A trade bloc is an agreement among a group of countries to decrease barriers to trade."
    },
    {
     "id": 1344832,
     "content_html": "embargo",
     "correctness": "1.0",
     "feedback_html": "An embargo is a complete halt of trading with a specific country or of a specific good."
    }
   ],
