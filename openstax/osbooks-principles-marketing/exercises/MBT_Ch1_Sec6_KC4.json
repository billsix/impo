 "questions": [
  {
   "id": 676785,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which type of customer relationship management (CRM) system would pool data from outside companies and organizations in order to create even better experiences for their customers?",
   "answers": [
    {
     "id": 1344391,
     "content_html": "Customer loyalty programs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer loyalty programs are reward programs geared toward frequent purchasers of a brand or product."
    },
    {
     "id": 1344390,
     "content_html": "Operational CRM",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Operational CRM deals with three types of operations&#8212;marketing, sales, and service&#8212;and is often used for lead generation."
    },
    {
     "id": 1344389,
     "content_html": "Analytical CRM",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An analytical CRM is designed to collect, organize, and analyze the inputted data, providing management with insights needed to better understand market trends, understand customer needs and wants, and make data-driven strategic decisions."
    },
    {
     "id": 1344392,
     "content_html": "Collaborative CRM",
     "correctness": "1.0",
     "feedback_html": "Collaborative CRM is sharing customer data with outside companies. It can give the company a fuller perspective on customers by collaborating with other companies in order to obtain data to which it would not otherwise have access."
    }
   ],
