   "id": 676783,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What do you call the process of managing customer information in order to maximize brand loyalty?",
   "answers": [
    {
     "id": 1344383,
     "content_html": "Marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. CRM is a subset of marketing."
    },
    {
     "id": 1344384,
     "content_html": "Customer relationship management",
     "correctness": "1.0",
     "feedback_html": "Customer relationship management (CRM) is the means through which companies track, manage, and analyze customer interactions."
    },
    {
     "id": 1344382,
     "content_html": "Consumer retention management",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer retention management is not a defined marketing concept."
    },
    {
     "id": 1344381,
     "content_html": "Branding",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Branding refers to the practice of shaping your brand&#8217;s perception."
    }
