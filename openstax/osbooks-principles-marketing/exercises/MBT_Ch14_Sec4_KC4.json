 "questions": [
  {
   "id": 677075,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a marketer, you are responsible for creating and maintaining positive relationships with the press. Which part of public relations are you responsible for?",
   "answers": [
    {
     "id": 1345551,
     "content_html": "Lobbying",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Lobbying involves an attempt at influencing public policy or laws."
    },
    {
     "id": 1345550,
     "content_html": "Publicity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Publicity is increasing brand awareness and image with the public."
    },
    {
     "id": 1345549,
     "content_html": "Public affairs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Public affairs involves creating relationships with public officials."
    },
    {
     "id": 1345552,
     "content_html": "Press relations",
     "correctness": "1.0",
     "feedback_html": "Press relations is the part of public relations that creates and maintains positive relationships with the press."
    }
   ],
