 "questions": [
  {
   "id": 676789,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What do you call the plans, actions, objectives, and goals that outline how a business will compete in its chosen markets?",
   "answers": [
    {
     "id": 1344407,
     "content_html": "Mission statement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A mission statement is an action-based statement declaring the purpose of an organization."
    },
    {
     "id": 1344406,
     "content_html": "Vision statement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A vision statement is an aspirational statement that articulates what an organization aims to achieve."
    },
    {
     "id": 1344405,
     "content_html": "Gap analysis",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A gap analysis is an internal analysis of the company or organization to identify and review its deficiencies."
    },
    {
     "id": 1344408,
     "content_html": "Strategy",
     "correctness": "1.0",
     "feedback_html": "A business&#8217;s overall strategy encompasses the plans, actions, objectives, and goals that outline how the business will compete in its chosen markets given its portfolio of products or services."
    }
   ],
