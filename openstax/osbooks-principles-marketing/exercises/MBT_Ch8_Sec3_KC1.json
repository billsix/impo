   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Culture is described as which of the following?",
   "answers": [
    {
     "id": 1344919,
     "content_html": "Social norms, beliefs, and accomplishments of particular individuals",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social norms, beliefs, and accomplishments of particular individuals is only a partial description."
    },
    {
     "id": 1344918,
     "content_html": "Elements taught or passed down from one generation to the next",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Elements taught or passed down from one generation to the next is only a partial description."
    },
    {
     "id": 1344917,
     "content_html": "Something that influences consumers’ decision-making processes and purchasing behaviors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Something that influences consumers&#8217; decision-making processes and purchasing behaviors is only part of the description."
    },
    {
     "id": 1344920,
     "content_html": "All of these",
     "correctness": "1.0",
     "feedback_html": "Culture is described as all of these statements."
    }
   ],
