 "questions": [
  {
   "id": 677184,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT an advantage of product traceability?",
   "answers": [
    {
     "id": 1345987,
     "content_html": "It makes it easier to trace counterfeit goods.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product traceability makes it easier to trace counterfeit goods."
    },
    {
     "id": 1345986,
     "content_html": "It makes it easier to trace tainted food.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product traceability makes it easier to trace tainted food."
    },
    {
     "id": 1345988,
     "content_html": "It creates less work for distribution channel members.",
     "correctness": "1.0",
     "feedback_html": "Product traceability does not make less work for distribution channel members."
    },
    {
     "id": 1345985,
     "content_html": "It makes it easier for consumers to know where products come from.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product traceability does make it easier for consumer to know where their products come from."
    }
   ],
   "hints": [],
