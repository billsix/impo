 "questions": [
  {
   "id": 676808,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the buyer’s black box, external stimuli that are planned and created by the producer and/or seller are known as ________ stimuli.",
   "answers": [
    {
     "id": 1344483,
     "content_html": "economic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Economic stimuli would involve factors such as the financial position of the consumer."
    },
    {
     "id": 1344484,
     "content_html": "marketing",
     "correctness": "1.0",
     "feedback_html": "Marketing stimuli are those generated by the marketer and are comprised of the 4Ps of marketing&#8212;product, promotion, price, and place."
    },
    {
     "id": 1344482,
     "content_html": "technological",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Technological stimuli would involve factors such as social media, online opinions, etc."
    },
    {
     "id": 1344481,
     "content_html": "social",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social stimuli would involve the opinions of friends and family, your reference groups, and societal roles and status."
    }
   ],
