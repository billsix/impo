 "questions": [
  {
   "id": 676842,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In China, Starbucks offers tea-based drinks featuring regional ingredients. On what basis has Starbucks segmented its market?",
   "answers": [
    {
     "id": 1344619,
     "content_html": "Demographic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Demographic segmentation groups consumers by focusing on traits such as age, gender, income, etc."
    },
    {
     "id": 1344618,
     "content_html": "Behavioral",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Behavioral segmentation is a method of grouping consumers by their behavior patterns."
    },
    {
     "id": 1344620,
     "content_html": "Geographic",
     "correctness": "1.0",
     "feedback_html": "Starbucks researches the culture of the countries in which it operates so that beverages appeal to local tastes."
    },
    {
     "id": 1344617,
     "content_html": "Psychographic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Psychographic segmentation divides consumers into different groups based on internal characteristics like personality, values, and beliefs."
    }
   ],
