 "questions": [
  {
   "id": 676916,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which is not an example of a diversity marketing consumer segment?",
   "answers": [
    {
     "id": 1344915,
     "content_html": "Multicultural segments like Hispanic, Black, and Asian people",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Hispanic, Black, and Asian people are among multicultural segments of diversity marketing."
    },
    {
     "id": 1344916,
     "content_html": "Sociodemographic segments like tech-savvy and digital natives",
     "correctness": "1.0",
     "feedback_html": "Tech-savvy and digital natives are not a sociodemographic segment; they are behavioral segments. Hispanic, Black, Asian, American Indian, and Alaskan Native people are among multicultural segments. Gen Xers, Zoomers, and consumers with disabilities are among sociodemographic segments."
    },
    {
     "id": 1344914,
     "content_html": "Multicultural segments like American Indian and Alaskan Native people",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. American Indian and Alaskan Native people are among multicultural segments of diversity marketing."
    },
    {
     "id": 1344913,
     "content_html": "Sociodemographic segments like Gen Xers, Zoomers, and consumers with disabilities",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Gen Xers, Zoomers, and consumers with disabilities are among sociodemographic segments of diversity marketing."
    }
   ],
