 "questions": [
  {
   "id": 677040,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Dunkin’ includes coupons in its print magazine advertisements. This is an example of ________.",
   "answers": [
    {
     "id": 1345412,
     "content_html": "sales promotion",
     "correctness": "1.0",
     "feedback_html": "Sales promotion includes coupons that help to induce sales in the short term."
    },
    {
     "id": 1345411,
     "content_html": "public relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Public relations is a nonpaid form of communication. It does not come from the company but is usually produced by a third party."
    },
    {
     "id": 1345410,
     "content_html": "personal selling",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is a one-on-one activity focused on building relationships for products that have variability and a relatively high price point."
    },
    {
     "id": 1345409,
     "content_html": "Internet/digital promotion",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Internet/digital promotion is not done through a print magazine."
    }
   ],
