 "questions": [
  {
   "id": 677112,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes the difference between traditional direct marketing and online direct marketing?",
   "answers": [
    {
     "id": 1345700,
     "content_html": "Online direct marketing uses digital tools to individually engage with consumers and call them to take some desired action. Traditional direct marketing does not allow a quick call to action.",
     "correctness": "1.0",
     "feedback_html": "Online direct marketing includes digital tools such as email, websites, online videos, and blogs to communicate and engage with individual consumers and elicit a desired consumer response or action."
    },
    {
     "id": 1345699,
     "content_html": "Traditional direct marketing is more effective than online direct marketing.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. There are a number of factors that influence the effectiveness of various marketing tools. Each tool has its advantages and disadvantages. Online direct marketing includes digital tools such as email, websites, online videos, and blogs to communicate and engage with individual consumers and elicit a desired consumer response or action."
    },
    {
     "id": 1345698,
     "content_html": "Online direct marketing allows marketers to target consumers based on factors such as their location, age, and income. Traditional direct marketing can also be based on demographic factors.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Both online direct marketing and traditional direct marketing allow for targeting based on demographics such as location, age, and income."
    },
    {
     "id": 1345697,
     "content_html": "Traditional direct marketing channels do not include a call to action, and online direct marketing channels do.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Both traditional direct marketing and online direct marketing include a call to action where the company provides a website or a phone number that the consumer can use to learn more information or place an order."
    }
   ],
