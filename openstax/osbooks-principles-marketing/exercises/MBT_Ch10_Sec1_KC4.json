 "questions": [
  {
   "id": 676975,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Hoffman Enterprises has introduced a new product to the market that has undergone only marginal changes and doesn’t alter consumer use habits. What type of product has Hoffman Enterprises introduced?",
   "answers": [
    {
     "id": 1345151,
     "content_html": "Discontinuous innovation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Discontinuous innovations are new-to-the-world products that are so different from existing products on the market that they create an entirely new market."
    },
    {
     "id": 1345152,
     "content_html": "Continuous innovation",
     "correctness": "1.0",
     "feedback_html": "With continuous innovation, the existing product undergoes only marginal changes and doesn&#8217;t alter consumer habits."
    },
    {
     "id": 1345150,
     "content_html": "Intermittent innovation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Intermittent innovation isn&#8217;t a type of newness."
    },
    {
     "id": 1345149,
     "content_html": "Dynamically continuous innovation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Dynamically continuous innovations are fundamentally different from other products on the market, so they require a change in consumer habits."
    }
   ],
