 "questions": [
  {
   "id": 677149,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Companies that manufacture goods rely on raw materials to produce the products they sell. This describes the function of ________.",
   "answers": [
    {
     "id": 1345847,
     "content_html": "inventory management",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inventory management is a function that involves identifying the type of inventory and how much a company has on hand at any given time."
    },
    {
     "id": 1345846,
     "content_html": "supply chain management",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Supply chain management entails managing all the members and activities from the procurement and transformation of raw materials into finished goods through their distribution to targeted consumers."
    },
    {
     "id": 1345845,
     "content_html": "transportation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Transportation involves the transfer or movement of goods from origin to destination."
    },
    {
     "id": 1345848,
     "content_html": "purchasing",
     "correctness": "1.0",
     "feedback_html": "Companies that manufacture goods rely on raw materials to produce the products they sell. They purchase the required materials from suppliers, who must be able to deliver them in accordance with the manufacturer&#8217;s timeline."
    }
   ],
