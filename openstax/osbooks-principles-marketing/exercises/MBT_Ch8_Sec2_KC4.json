 "questions": [
  {
   "id": 676915,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Diversity in market research is a good idea because it can ________.",
   "answers": [
    {
     "id": 1344911,
     "content_html": "help companies win over people from different population segments",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Diversity in market research is a good idea for multiple reasons, not simply because it can help companies win over people from different segments of the population."
    },
    {
     "id": 1344910,
     "content_html": "provide information to better understand cultural and social differences",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Diversity in market research is a good idea for multiple reasons, not simply because it can provide information to better understand cultural and social differences."
    },
    {
     "id": 1344909,
     "content_html": "reduce wrong assumptions and avert public relations missteps",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Diversity in market research is a good idea for multiple reasons, not simply because it can reduce wrong assumptions and avert public relations missteps."
    },
    {
     "id": 1344912,
     "content_html": "All of these statements are true.",
     "correctness": "1.0",
     "feedback_html": "Diversity in market research is a good idea because it can help companies win over people from different segments of the population by providing better cultural and social information. This can reduce wrong assumptions and avert public relations missteps."
    }
   ],
