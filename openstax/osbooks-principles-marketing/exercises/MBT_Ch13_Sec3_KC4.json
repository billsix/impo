 "questions": [
  {
   "id": 677050,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Tina knows that when she goes to Walgreens, she can use coupons and her reward points. She is thrilled with the way she saves money at Walgreens, and she is happy to be able to use so many of the great promotional opportunities. She tells many of her family and friends about her savings and her experience. Which of the following integrated marketing communications benefits is Tina demonstrating?",
   "answers": [
    {
     "id": 1345451,
     "content_html": "Better results",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Better results would include other methods of determining that the message reached the audience."
    },
    {
     "id": 1345450,
     "content_html": "Increased efficiency",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Increased efficiency indicates that the message is delivered through multiple forms of communication."
    },
    {
     "id": 1345449,
     "content_html": "Improved brand awareness",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An example of improved brand awareness would be for Tina to demonstrate that she recognizes the logo and the brand promise from Walgreens."
    },
    {
     "id": 1345452,
     "content_html": "Customer satisfaction",
     "correctness": "1.0",
     "feedback_html": "Because Tina is satisfied and educated on all the ways to shop at Walgreens, she is exhibiting customer satisfaction."
    }
   ],
   "hints": [],
