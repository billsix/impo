 "questions": [
  {
   "id": 676973,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Coca-Cola, a behemoth in the soft drink market, decides that it is going to develop and market Coca-Cola popsicles. What type of new product would this constitute?",
   "answers": [
    {
     "id": 1345143,
     "content_html": "New-to-the-world",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. New-to-the-world products are inventions that create a new market."
    },
    {
     "id": 1345144,
     "content_html": "New-to-the-firm",
     "correctness": "1.0",
     "feedback_html": "Remember, new-to-the-firm products aren&#8217;t new to the world, but they are a new product venture for the firm."
    },
    {
     "id": 1345142,
     "content_html": "Improvements and revision to existing products",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Improvements to existing products are current products made better."
    },
    {
     "id": 1345141,
     "content_html": "Repositioned product",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Repositioned products are those that are retargeted for a new use or application."
    }
   ],
   "hints": [],
