 "questions": [
  {
   "id": 676847,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Hoffman Enterprises, a manufacturer of electronic controls for appliances, has segmented its customers based upon the size of the company in terms of revenue and its geographic location. What method of segmenting B2B markets is Hoffman Enterprises using?",
   "answers": [
    {
     "id": 1344639,
     "content_html": "Technographics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Technographic segmentation is based on the various hardware and software used by B2B customers."
    },
    {
     "id": 1344638,
     "content_html": "Behavioral",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Behavioral segmentation is a method of grouping consumers by their behavior patterns&#8212;how they interact with the company and its products or services."
    },
    {
     "id": 1344640,
     "content_html": "Firmographics",
     "correctness": "1.0",
     "feedback_html": "Firmographics segments customers based on sets of characteristics such as industry, location, size, legal structure, and performance."
    },
    {
     "id": 1344637,
     "content_html": "Needs Based",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Needs-based segmentation clusters groups of customers on the basis of what they normally look for in a product."
    }
   ],
