 "questions": [
  {
   "id": 676790,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes a gap analysis?",
   "answers": [
    {
     "id": 1344411,
     "content_html": "A statement that answers the question, Where do we see the business going?",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A statement that answers the question, Where do we see the business going? is a mission statement."
    },
    {
     "id": 1344412,
     "content_html": "An internal analysis of the company to identify inherent deficiencies that may hinder its ability to meet its goals",
     "correctness": "1.0",
     "feedback_html": "A gap analysis is an internal analysis of a company or business unit used to identify deficiencies that may hinder its abilities to meet its goals."
    },
    {
     "id": 1344410,
     "content_html": "A statement that answers the question, Why does the business exist?",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A statement that answers the question, Why does the business exist? is known as a vision statement."
    },
    {
     "id": 1344409,
     "content_html": "A strategic plan created for a single business or operating unit",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A strategic plan created for a single business or operating unit is known as business-level strategy."
    }
   ],
