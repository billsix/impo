  {
   "id": 677193,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ uses media as the lead for awareness building.",
   "answers": [
    {
     "id": 1346023,
     "content_html": "Consumer-oriented marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Consumer-oriented marketing seeks to solve consumers&#8217; problems."
    },
    {
     "id": 1346022,
     "content_html": "Customer-value marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer-value marketing seeks to demonstrate value for the offering."
    },
    {
     "id": 1346024,
     "content_html": "Innovative marketing",
     "correctness": "1.0",
     "feedback_html": "Innovative marketing uses the media to spur awareness and convert prospects into customers."
    },
    {
     "id": 1346021,
     "content_html": "Mission marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Mission marketing puts purpose at the center of marketing."
    }
