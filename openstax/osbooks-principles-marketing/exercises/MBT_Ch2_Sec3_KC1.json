 "questions": [
  {
   "id": 676797,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In which section of the executive summary of a marketing plan would you describe the current marketplace and industry sectors within which you sell your products or services and the innovations currently taking place within the market?",
   "answers": [
    {
     "id": 1344439,
     "content_html": "Description of products or services being marketed",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. This paragraph would describe the key features and benefits of the new product/service being introduced and outline its unique selling proposition."
    },
    {
     "id": 1344438,
     "content_html": "Description of customer base and related marketing activities",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. This paragraph would describe the key aspects of the target audience for the product/service."
    },
    {
     "id": 1344437,
     "content_html": "Description of company and team",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. This paragraph describes the business and the key players involved in the business."
    },
    {
     "id": 1344440,
     "content_html": "Description of market factors and trends",
     "correctness": "1.0",
     "feedback_html": "In this paragraph of the executive summary, you would describe the current marketplace and industry sectors in which you sell your products and/or services, the trends affecting and influencing them, and the innovations currently taking place within the market."
    }
   ],
