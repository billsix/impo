   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If a brand develops a diversity, equity, and inclusion initiative, which pillar of sustainability is addressed?",
   "answers": [
    {
     "id": 1345999,
     "content_html": "Environmental",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The environmental pillar focuses on the planet."
    },
    {
     "id": 1346000,
     "content_html": "Social",
     "correctness": "1.0",
     "feedback_html": "Diversity, equity, and inclusion support people, which makes it a social initiative."
    },
    {
     "id": 1345998,
     "content_html": "Economic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The economic pillar focuses on profits."
    },
    {
     "id": 1345997,
     "content_html": "All of the above are correct.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Diversity, equity, and inclusion support people, which makes it a social initiative."
    }
   ],
