 "questions": [
  {
   "id": 677152,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ makes the most sense for companies who need to transport products quickly.",
   "answers": [
    {
     "id": 1345859,
     "content_html": "Trucking",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Trucking is a great option for transporting products inexpensively, but it&#8217;s not as speedy as air transportation."
    },
    {
     "id": 1345860,
     "content_html": "Air transportation",
     "correctness": "1.0",
     "feedback_html": "Air transportation provides the fastest delivery speed over trucking, rail, and water transportation."
    },
    {
     "id": 1345858,
     "content_html": "Rail transportation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Rail transportation is a great option for transporting products where speed of delivery is not important."
    },
    {
     "id": 1345857,
     "content_html": "Water transportation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Water transportation makes the most sense for companies who need to transport large, bulky items."
    }
   ],
