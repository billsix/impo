 "questions": [
  {
   "id": 676913,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is true regarding why diversity marketing is important?",
   "answers": [
    {
     "id": 1344904,
     "content_html": "Today’s marketplace is changing dramatically everywhere.",
     "correctness": "1.0",
     "feedback_html": "Diversity marketing is important because today&#8217;s marketplace is changing dramatically everywhere."
    },
    {
     "id": 1344903,
     "content_html": "Buyers, households, and communities are staying the same.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Buyers, households, and communities are changing."
    },
    {
     "id": 1344902,
     "content_html": "Consumers don’t believe that diversity in advertising is important.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Studies show that consumers believe that diversity in advertising is important."
    },
    {
     "id": 1344901,
     "content_html": "Diversity marketing has no impact on brand loyalty.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Studies show that diversity marketing has an impact on brand loyalty."
    }
   ],
