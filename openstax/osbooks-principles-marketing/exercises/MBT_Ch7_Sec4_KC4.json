   "id": 676905,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is part of the whole channel?",
   "answers": [
    {
     "id": 1344871,
     "content_html": "Promotions",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Promotions are not part of the whole channel distribution chain."
    },
    {
     "id": 1344870,
     "content_html": "Communications",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Communication is not considered part of the whole channel distribution chain."
    },
    {
     "id": 1344869,
     "content_html": "Price",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Price is not considered part of the whole channel distribution chain."
    },
    {
     "id": 1344872,
     "content_html": "Distribution channel members",
     "correctness": "1.0",
     "feedback_html": "The whole channel refers to all distribution channel members, including manufacturers, retailers, transportation, and wholesalers."
    }
