  {
   "id": 677157,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Channel members that generally do not manufacture goods but rather buy them from another channel member and sell them to the consumer are said to be practicing ________.",
   "answers": [
    {
     "id": 1345879,
     "content_html": "manufacturing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Manufacturing is the process of producing goods and services."
    },
    {
     "id": 1345878,
     "content_html": "wholesaling",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Wholesaling is the process of buying goods in bulk and selling them to retailers or other wholesalers."
    },
    {
     "id": 1345880,
     "content_html": "retailing",
     "correctness": "1.0",
     "feedback_html": "Retailing is the process of selling goods and services to the consumer."
    },
    {
     "id": 1345877,
     "content_html": "inventory",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inventory is the merchandise a business holds until ready for sale."
    }
   ],
