   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ally is a new marketer trying to determine the return on ad spend that her first marketing campaign netted. She spent $20 on a Facebook advertisement, and the ad brought in $500 of revenue. Which of the following would be the return on ad spend (ROAS)?",
   "answers": [
    {
     "id": 1345520,
     "content_html": "$25",
     "correctness": "1.0",
     "feedback_html": "ROAS &#61; &#36;500/&#36;20 &#61; &#36;25"
    },
    {
     "id": 1345519,
     "content_html": "5:1",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. ROAS &#61; &#36;500/&#36;20 &#61; &#36;25."
    },
    {
     "id": 1345518,
     "content_html": "10,000",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. ROAS &#61; &#36;500/&#36;20 &#61; &#36;25."
    },
    {
     "id": 1345517,
     "content_html": "$2.50",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. ROAS &#61; &#36;500/&#36;20 &#61; &#36;25."
    }
   ],
