   "stimulus_html": "",
   "stem_html": "When conditions are favorable for a company to expand globally, the company is experiencing ________.",
   "answers": [
    {
     "id": 1344800,
     "content_html": "global market opportunities",
     "correctness": "1.0",
     "feedback_html": "Global market opportunities refer to the favorable conditions that allow companies to choose to expand globally."
    },
    {
     "id": 1344799,
     "content_html": "international trade",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. International trade is the practice of entering global markets."
    },
