 "questions": [
  {
   "id": 677048,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The goal of integrated marketing communications is to ________.",
   "answers": [
    {
     "id": 1345444,
     "content_html": "have all marketing and promotional activities project a consistent unified image",
     "correctness": "1.0",
     "feedback_html": "Integrated marketing communications seeks to have all of the promotions send a consistent and unified image to the customer."
    },
    {
     "id": 1345443,
     "content_html": "gain control of the distribution process",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The distribution process is not part of integrated marketing communications."
    },
    {
     "id": 1345442,
     "content_html": "use only paid methods of promotion",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Paid methods of promotion are only a small part of the total promotional mix method that encompasses integrated marketing communications. IMC seeks to use a variety of promotional methods to reach the consumer."
    },
    {
     "id": 1345441,
     "content_html": "develop a competitive pricing structure",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Pricing is not part of integrated marketing communications."
    }
   ],
