 "questions": [
  {
   "id": 677100,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Johnny has worked for Nestlé for 15 years. He is paid based on the sales he makes. What type of compensation is Johnny most likely making?",
   "answers": [
    {
     "id": 1345651,
     "content_html": "Base salary",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A base salary is not typically figured based on the number of sales made."
    },
    {
     "id": 1345650,
     "content_html": "Bonus",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. When a sales professional gets a bonus, it is usually based on achieving a specific goal."
    },
    {
     "id": 1345652,
     "content_html": "Commission",
     "correctness": "1.0",
     "feedback_html": "Nestle is most likely paying Johnny a commission on the sales he makes."
    },
    {
     "id": 1345649,
     "content_html": "Salary and commission",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Salary and commission means the sales professional is paid a base salary and then a percent of the sales they have made."
    }
   ],
