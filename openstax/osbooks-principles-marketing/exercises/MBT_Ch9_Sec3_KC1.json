 "questions": [
  {
   "id": 676942,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a stage of the product life cycle? ",
   "answers": [
    {
     "id": 1345019,
     "content_html": "Introduction ",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Introduction is the first stage of the product life cycle. "
    },
    {
     "id": 1345018,
     "content_html": "Growth",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Growth is the second stage of the product life cycle. "
    },
    {
     "id": 1345017,
     "content_html": "Maturity",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Maturity is the third stage of the product life cycle. "
    },
    {
     "id": 1345020,
     "content_html": "Profitability",
     "correctness": "1.0",
     "feedback_html": "While profitability is measured along the product life cycle, it is not a stage of the product life cycle."
    }
   ],
