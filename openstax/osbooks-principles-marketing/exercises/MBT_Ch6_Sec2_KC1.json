   "id": 676877,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a source for external information?",
   "answers": [
    {
     "id": 1344759,
     "content_html": "Sales receipts of your company’s most popular product",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sales receipts would be internal data."
    },
    {
     "id": 1344758,
     "content_html": "Employee salaries",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Employee salaries would be internal data."
    },
    {
     "id": 1344760,
     "content_html": "Comments received from a customer service survey",
     "correctness": "1.0",
     "feedback_html": "A response to a customer service survey by a customer would be external information."
    },
    {
     "id": 1344757,
     "content_html": "Company’s website content",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A company&#8217;s website content is internal to the company."
    }
