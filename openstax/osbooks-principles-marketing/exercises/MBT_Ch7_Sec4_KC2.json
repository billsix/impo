 "questions": [
  {
   "id": 676903,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is correct regarding the promotion strategy of global markets?",
   "answers": [
    {
     "id": 1344863,
     "content_html": "All promotion strategies should remain the same across markets.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Nearly all promotion strategies will need to adapt to the global market."
    },
    {
     "id": 1344862,
     "content_html": "Promotion strategies of global markets should deviate only slightly from the home market.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The degree to which a promotion strategy should change depends on the market."
    },
    {
     "id": 1344864,
     "content_html": "Promotion strategies should reflect the market, some to different degrees.",
     "correctness": "1.0",
     "feedback_html": "The degree to which a promotion strategy should change depends on the market."
    },
    {
     "id": 1344861,
     "content_html": "Promotion strategies of global markets should always be completely different from the home market.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The degree to which a promotion strategy should change depends on the local market."
    }
   ],
