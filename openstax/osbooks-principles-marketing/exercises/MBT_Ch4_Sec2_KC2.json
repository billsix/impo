 "questions": [
  {
   "id": 676828,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jenae, a purchasing agent for an electronics firm, places an order with a local office supply company for several dozen reams of copy paper. He has ordered the same brand of paper from the company several times before. This is an example of ________.",
   "answers": [
    {
     "id": 1344564,
     "content_html": "a straight rebuy",
     "correctness": "1.0",
     "feedback_html": "A straight rebuy is making a routine purchase of a standard product or products with no modifications from a familiar supplier."
    },
    {
     "id": 1344563,
     "content_html": "a modified rebuy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In a modified rebuy, the purchaser is buying goods that have been purchased previously but changes either the supplier or certain elements of the previous order."
    },
    {
     "id": 1344562,
     "content_html": "a new-task buy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In a new-task buy, the customer has no previous experience with the purchase."
    },
    {
     "id": 1344561,
     "content_html": "systems selling",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Systems selling involves selling a single, complete solution to a need or problem rather than purchasing several component parts."
    }
   ],
