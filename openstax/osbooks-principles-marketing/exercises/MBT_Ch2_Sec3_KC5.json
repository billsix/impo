 "questions": [
  {
   "id": 676801,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In which section of the marketing plan would you include a competitive analysis and discussion of the company’s top competitors?",
   "answers": [
    {
     "id": 1344455,
     "content_html": "Positioning",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Positioning defines where your product or service fits into the marketplace and why it is better than alternative solutions."
    },
    {
     "id": 1344454,
     "content_html": "Target market",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A company&#8217;s target market is the group(s) upon which it intends to focus its marketing efforts and resources."
    },
    {
     "id": 1344453,
     "content_html": "Mission statement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A mission statement is an action statement that declares the purpose of the organization and how it serves its customers."
    },
    {
     "id": 1344456,
     "content_html": "Current marketing situation",
     "correctness": "1.0",
     "feedback_html": "Within the current marketing situation of your marketing plan, you should include a competitive analysis and a discussion of how competitors fare in the marketplace."
    }
   ],
