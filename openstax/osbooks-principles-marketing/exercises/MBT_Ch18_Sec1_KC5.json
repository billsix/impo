   "id": 677161,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Schwan’s Company prepares frozen foods to be delivered to the door of the consumer. Which of the following is the most likely distribution channel for Schwan’s?",
   "answers": [
    {
     "id": 1345895,
     "content_html": "Manufacturer – Agent – Wholesaler – Retailer – Consumer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In this example, Schwan&#8217;s does not utilize agents, wholesalers, or retailers."
    },
    {
     "id": 1345894,
     "content_html": "Manufacturer – Retailer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In this example, Schwan&#8217;s does not utilize retailers."
    },
    {
     "id": 1345896,
     "content_html": "Manufacturer – Consumer",
     "correctness": "1.0",
     "feedback_html": "Schwan&#8217;s eliminates the intermediaries and sells directly to the consumers."
    },
    {
     "id": 1345893,
     "content_html": "Manufacturer – Wholesaler – Retailer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In this example, Schwan&#8217;s does not utilize wholesalers or retailers."
    }
   ],
