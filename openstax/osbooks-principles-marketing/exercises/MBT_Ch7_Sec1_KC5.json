 "questions": [
  {
   "id": 676891,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is true regarding business politics?",
   "answers": [
    {
     "id": 1344815,
     "content_html": "They do not vary from culture to culture.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Business politics do vary across cultures."
    },
    {
     "id": 1344816,
     "content_html": "Business politics can vary greatly across cultures, and businesspeople should decide what is within their own ethical compass before deciding to conduct international business.",
     "correctness": "1.0",
     "feedback_html": "Business politics vary greatly across cultures. Businesspeople must decide how far they are willing to adapt to the local expectations."
    },
    {
     "id": 1344814,
     "content_html": "Business ethics are the same across every culture.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Business ethics are not the same across cultures."
    },
    {
     "id": 1344813,
     "content_html": "When conducting business in a foreign market, you should always do what is asked of you, even if it’s unethical or illegal in your home country.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Business people must decide the degree to which they are comfortable applying local ethics."
    }
   ],
