 "questions": [
  {
   "id": 676804,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You’ve emailed a customer satisfaction survey to 20,000 customers and received 1,825 responses. Of those 1,825 responses, the ratings came back as:\n<ul style=\"padding-left:1.5em;margin-left:1.5em;\">\n<li>500 very satisfied</li>\n<li>300 satisfied</li>\n<li>1,025 neutral or dissatisfied or very dissatisfied</li>\n</ul>\n<p>What is the customer satisfaction score?</p>",
   "answers": [
    {
     "id": 1344468,
     "content_html": "44 percent",
     "correctness": "1.0",
     "feedback_html": "To calculate the CSAT score, take the total number of satisfied customers and divide that by the total number of responses. Then multiply that number by 100 to obtain the percentage. In this scenario, you add 500 and 300 to get 800. Then divide that by 1,825 to get .438. Multiple that by 100 for 44&#37;."
    },
    {
     "id": 1344467,
     "content_html": "27 percent",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The CSAT score is calculated by taking the total number of satisfied customers and dividing that by the total number of responses, then multiplying that number by 100."
    },
    {
     "id": 1344466,
     "content_html": "9 percent",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The CSAT score is calculated by taking the total number of satisfied customers and dividing that by the total number of responses, then multiplying that number by 100."
    },
    {
     "id": 1344465,
     "content_html": "11 percent",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The CSAT score is calculated by taking the total number of satisfied customers and dividing that by the total number of responses, then multiplying that number by 100.\n"
    }
   ],
