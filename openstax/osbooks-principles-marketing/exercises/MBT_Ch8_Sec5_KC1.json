 "questions": [
  {
   "id": 676927,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sociodemographic marketing is a subcategory of diversity marketing, and it targets audiences based on ________.",
   "answers": [
    {
     "id": 1344959,
     "content_html": "psychological distinguishing factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Psychological factors could be a variable, but by itself this is an insufficient definition of sociodemographic marketing."
    },
    {
     "id": 1344958,
     "content_html": "political affiliation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Political affiliation is not a factor in targeting audiences in sociodemographic marketing."
    },
    {
     "id": 1344957,
     "content_html": "geographical and governmental boundaries",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sociodemographic marketing does not focus on geography or governing structures."
    },
    {
     "id": 1344960,
     "content_html": "shared social and demographic variables",
     "correctness": "1.0",
     "feedback_html": "Sociodemographic marketing is a subcategory of diversity marketing. It intentionally targets certain audiences with attractive advertising and promotions based on shared social and demographic variables. Overlaying these two factors has several worthwhile benefits for marketers."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
