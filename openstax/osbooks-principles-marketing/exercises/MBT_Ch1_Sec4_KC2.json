 "questions": [
  {
   "id": 676773,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the marketing eras or concepts is most closely related to sustainability and environmental consciousness?",
   "answers": [
    {
     "id": 1344343,
     "content_html": "Production concept",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The production concept is most concerned with the operations of manufacturing the product a company intends to sell."
    },
    {
     "id": 1344342,
     "content_html": "Marketing concept",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The marketing concept is the philosophy that firms should first analyze the needs of their customers and then&#8212;and only then&#8212; make product development decisions to satisfy those needs."
    },
    {
     "id": 1344344,
     "content_html": "Societal marketing concept",
     "correctness": "1.0",
     "feedback_html": "The societal marketing concept involves meeting consumers&#8217; and businesses&#8217; current needs while simultaneously being aware of the environmental impact of marketing decisions on future generations&#8217; ability to meet their needs."
    },
    {
     "id": 1344341,
     "content_html": "Sales concept",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The sales concept is concerned with the selling strategies a company will use to sell the product."
    }
   ],
   "hints": [],
