 "questions": [
  {
   "id": 677004,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which two steps in the service-profit chain model are related and directly linked?",
   "answers": [
    {
     "id": 1345267,
     "content_html": "Internal service quality and value",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Internal service quality (Step 1) and value (Step 4) are not related and directly linked in the service-profit chain model."
    },
    {
     "id": 1345266,
     "content_html": "Value and customer satisfaction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Value (Step 4) and customer satisfaction (Step 5) are not related and directly linked in the service-profit chain model."
    },
    {
     "id": 1345268,
     "content_html": "Customer satisfaction and customer loyalty",
     "correctness": "1.0",
     "feedback_html": "According to the model, customer satisfaction (Step 5) and customer loyalty (Step 6) are related and directly linked."
    },
    {
     "id": 1345265,
     "content_html": "Internal service quality and increased productivity and growth",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Internal service quality (Step 1) and increased profitability and growth (Step 6) are not related and directly linked in the service-profit chain model."
    }
   ],
