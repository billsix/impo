 "questions": [
  {
   "id": 677104,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Rolex calls itself the “Official Timekeeper” of the Wimbledon and Australian Open tennis championships, by virtue of its sponsorships of the marquee events. What is the most likely objective for Rolex’s sponsorship deal with these events?",
   "answers": [
    {
     "id": 1345667,
     "content_html": "Lose money",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The focus is to spread information and not to lose money."
    },
    {
     "id": 1345666,
     "content_html": "Stimulate demand",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The event sponsorship will not necessarily stimulate demand although it might happen as a result of the positive association."
    },
    {
     "id": 1345668,
     "content_html": "Spread information",
     "correctness": "1.0",
     "feedback_html": "Rolex wants to spread information about its products to the target market of customers that will be present at the events."
    },
    {
     "id": 1345665,
     "content_html": "Increase customer satisfaction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While customers might be satisfied knowing Rolex has sponsored the event, the goal of the sales promotion is not to increase customer satisfaction."
    }
   ],
   "hints": [],
