   "id": 676976,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sources through which a business earns income from the sales of goods or services are known as ________.",
   "answers": [
    {
     "id": 1345155,
     "content_html": "capital gains",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Gain is a term used when a company experiences an economic benefit."
    },
    {
     "id": 1345154,
     "content_html": "incremental income",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Income is the money that businesses receive in exchange for producing a product or service."
    },
    {
     "id": 1345153,
     "content_html": "profits",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Profits are the difference between the amount earned and the amount spent in producing something."
    },
    {
     "id": 1345156,
     "content_html": "revenue streams",
     "correctness": "1.0",
     "feedback_html": "Revenue streams are the different sources from which a business earns money from the sale of its goods or services."
    }
   ],
