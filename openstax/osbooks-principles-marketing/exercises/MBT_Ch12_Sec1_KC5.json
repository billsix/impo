 "questions": [
  {
   "id": 677016,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The perception of a buyer’s value includes which of the following?",
   "answers": [
    {
     "id": 1345315,
     "content_html": "Profit a company can expect from sales",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Profit is included in the value received by the company in an exchange process."
    },
    {
     "id": 1345316,
     "content_html": "Perceived benefits less the perceived costs associated with a purchase",
     "correctness": "1.0",
     "feedback_html": "The value that a buyer receives from an exchange takes into account the perceived benefits and costs of making the purchase."
    },
    {
     "id": 1345314,
     "content_html": "Revenue expected from a sale",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Revenue is what a company receives from the exchange process."
    },
    {
     "id": 1345313,
     "content_html": "Costs of manufacturing the product",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The costs of manufacturing the product are part of the company&#8217;s expenses."
    }
   ],
