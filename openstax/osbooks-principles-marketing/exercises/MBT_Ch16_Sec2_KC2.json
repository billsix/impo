 "questions": [
  {
   "id": 677118,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a challenge that marketers face when using social media marketing?",
   "answers": [
    {
     "id": 1345723,
     "content_html": "Social media marketing does not allow companies to target multiple audiences at the same time.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social media does allow companies to target multiple audiences."
    },
    {
     "id": 1345722,
     "content_html": "Social media use is unpredictable, with users only logging in once or twice per week.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social media usage is predictable. With billions of users accessing social media platforms daily, marketers can expect to reach their target audience."
    },
    {
     "id": 1345724,
     "content_html": "Companies do not have control over the message.",
     "correctness": "1.0",
     "feedback_html": "Lack of control over the message is a challenge for social media marketers. Consumers who are dissatisfied with the company can use social media to make negative comments that could hurt brand reputation."
    },
    {
     "id": 1345721,
     "content_html": "Social media does a poor job of driving traffic to websites.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. If executed well, social media marketing can be an effective tool to drive traffic to a company&#8217;s website."
    }
   ],
