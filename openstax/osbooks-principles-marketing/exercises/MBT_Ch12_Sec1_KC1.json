   "id": 677012,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You receive an email from your favorite clothing store. It is having a one-day sale where everything is 50 percent off. The retailer is using a form of psychology known as ________.",
   "answers": [
    {
     "id": 1345300,
     "content_html": "artificial time constraint",
     "correctness": "1.0",
     "feedback_html": "Artificial time constraints tell the consumer they will miss out if they don&#8217;t purchase right now."
    },
    {
     "id": 1345299,
     "content_html": "price appearance",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Price appearance is the length of the price."
    },
    {
     "id": 1345298,
     "content_html": "profit",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Profit is the financial gain of a company."
    },
    {
     "id": 1345297,
     "content_html": "fixed costs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Fixed costs are those that do not change based on the number of units produced."
    }
   ],
