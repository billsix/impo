 "questions": [
  {
   "id": 677081,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When Taco Bell was hit with a lawsuit that claimed its seasoned beef was only 35 percent beef, the company utilized social media to show its ingredients, a campaign that was wildly successful. Which of the following was Taco Bell hoping for?",
   "answers": [
    {
     "id": 1345575,
     "content_html": "Guaranteed results",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The company&#8217;s marketers likely knew there was no guarantee its campaign would be successful."
    },
    {
     "id": 1345576,
     "content_html": "Improved brand image",
     "correctness": "1.0",
     "feedback_html": "Taco Bell was hoping that the campaign would outweigh the negative brand image caused by the lawsuit (and it worked)."
    },
    {
     "id": 1345574,
     "content_html": "Direct control of the message",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While Taco Bell controlled the original message in social media, it had no control over how people would respond to or even spin it."
    },
    {
     "id": 1345573,
     "content_html": "Increase sales and leads",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The company&#8217;s campaign likely was to help prevent a decrease in sales; its main goal was not to increase sales."
    }
   ],
   "hints": [],
