 "questions": [
  {
   "id": 677099,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Terra Cotta Landscape Supply is currently developing a two-day session for all sales professionals within the organization. During this two-day meeting, the sales professionals will be learning about new products and applications for their clients. This is an example of what element of managing a sales force?",
   "answers": [
    {
     "id": 1345647,
     "content_html": "Compensating",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Compensating the sales professional deals with how they will get paid for the work they are doing."
    },
    {
     "id": 1345648,
     "content_html": "Training",
     "correctness": "1.0",
     "feedback_html": "Companies regularly need to inform and educate their sales professionals about the products they are selling."
    },
    {
     "id": 1345646,
     "content_html": "Recruiting",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Recruiting is the effort the sales manager must take to find the right sales professionals to fit with the job and work that they must do."
    },
    {
     "id": 1345645,
     "content_html": "Evaluating",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Evaluating the sales force is the effort to make sure the sales professionals are doing an effective job for the company."
    }
   ],
