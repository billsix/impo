 "questions": [
  {
   "id": 677135,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In a(n) ________, one member of the distribution channel owns the other members.",
   "answers": [
    {
     "id": 1345791,
     "content_html": "administered vertical marketing system",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Administered vertical marketing systems exist when one large and powerful channel member controls but does not own other channel members."
    },
    {
     "id": 1345792,
     "content_html": "corporate vertical marketing system",
     "correctness": "1.0",
     "feedback_html": "In a corporate vertical marketing system, one channel member owns one or more other channel members."
    },
    {
     "id": 1345790,
     "content_html": "horizontal marketing system",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A horizontal marketing system exists when two unrelated companies partner to distribute their products and services."
    },
    {
     "id": 1345789,
     "content_html": "multichannel marketing system",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A multichannel marketing system exists when a company uses a variety of channels, such as stores and online, to distribute products and services."
    }
   ],
