 "questions": [
  {
   "id": 676899,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ryana owns a T-shirt company in Japan. With her T-shirts, she applies Disney characters and pays Disney royalties based on each shirt sold and an agreement the two companies entered into. Which of the following is Ryana most likely involved in?",
   "answers": [
    {
     "id": 1344848,
     "content_html": "Licensing",
     "correctness": "1.0",
     "feedback_html": "Licensing is an agreement whereby one company can legally use the copyrighted material of another for a royalty fee."
    },
    {
     "id": 1344847,
     "content_html": "Unethical behavior",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Because there is an agreement between the two companies, there is nothing unethical in this scenario."
    },
    {
     "id": 1344846,
     "content_html": "Trademark fraud",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Because there is an agreement between the two companies, there is no fraud occurring."
    },
    {
     "id": 1344845,
     "content_html": "Franchising",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Franchising is a business strategy in which the owner (the franchisor) allows another person or entity (the franchisee) to operate a business using the franchisor&#8217;s products, branding, and knowledge in exchange for a fee."
    }
   ],
