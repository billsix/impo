 "questions": [
  {
   "id": 676841,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Donita has determined that the current payroll software system is no longer adequate to handle the growing number of employees in the company. Which stage of the B2B buying process does this illustrate?",
   "answers": [
    {
     "id": 1344616,
     "content_html": "Stage 1: Problem recognition",
     "correctness": "1.0",
     "feedback_html": "Similar to consumer buying, the first stage in the B2B buying decision process occurs when someone identifies a problem that can be resolved through a purchase."
    },
    {
     "id": 1344615,
     "content_html": "Stage 2: Need description",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 2 of the B2B buying decision process is need description, in which the buying center works to put some parameters around what needs to be purchased."
    },
    {
     "id": 1344614,
     "content_html": "Stage 5: Proposal solicitation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 5 of the B2B buying decision process is proposal solicitation, in which qualified vendors are asked to submit proposals."
    },
    {
     "id": 1344613,
     "content_html": "Stage 8: Performance review",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 8 of the B2B buying decision process is performance review, in which the B2B buyer reviews the performance of the selected supplier to assess whether the performance of the product and supplier is living up to expectations."
    }
   ],
