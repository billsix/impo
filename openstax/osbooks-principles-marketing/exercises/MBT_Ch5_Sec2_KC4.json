 "questions": [
  {
   "id": 676850,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which form of B2B market segmentation groups customers based on sets of characteristics such as industry, location, size, legal structure, and performance?",
   "answers": [
    {
     "id": 1344651,
     "content_html": "Technographics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Technographic segmentation allows a marketer to organize prospects by their technology ownership and usage and narrow the market to those prospects that may be willing to invest in new technological solutions."
    },
    {
     "id": 1344650,
     "content_html": "Psychographics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Psychographic segmentation divides B2C consumers into different groups based on internal characteristics like personality, values, and beliefs."
    },
    {
     "id": 1344652,
     "content_html": "Firmographics",
     "correctness": "1.0",
     "feedback_html": "Firmographics segments customers based on sets of characteristics such as industry, location, size, legal structure, and performance."
    },
    {
     "id": 1344649,
     "content_html": "Demographics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Demographic segmentation groups B2C consumers by focusing on traits such as age, gender, income, etc."
    }
   ],
