 "questions": [
  {
   "id": 677009,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the Gap Model of Service Quality, which dimension is the difference between the customer’s expectation of the service and their perception of the experience?",
   "answers": [
    {
     "id": 1345287,
     "content_html": "Communication gap",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The communication gap is the difference between the delivery of the customer experience and what is communicated to the customer."
    },
    {
     "id": 1345286,
     "content_html": "Delivery gap",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The delivery gap is the difference between experience or service specification and the actual delivery of the service."
    },
    {
     "id": 1345288,
     "content_html": "Customer gap",
     "correctness": "1.0",
     "feedback_html": "The customer gap is the difference between the customer&#8217;s expectations of the service and their perception of the experience itself."
    },
    {
     "id": 1345285,
     "content_html": "Knowledge gap",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The knowledge gap is the difference between what customers expect and what the company thinks they expect."
    }
   ],
   "hints": [],
