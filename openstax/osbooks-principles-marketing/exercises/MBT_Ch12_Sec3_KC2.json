   "id": 677023,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Each month you pay your rent. It is $800 and does not change based on the number of hours you work. This is known as a ________.",
   "answers": [
    {
     "id": 1345343,
     "content_html": "variable cost",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Variable costs change based upon the number of units produced."
    },
    {
     "id": 1345344,
     "content_html": "fixed cost",
     "correctness": "1.0",
     "feedback_html": "Fixed costs do not change based on the number of units produced."
    },
    {
     "id": 1345342,
     "content_html": "changing cost",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A changing cost is also a variable cost, one that changes based on the units produced."
    },
    {
     "id": 1345341,
     "content_html": "profit",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Profit is the financial gain of a company."
    }
   ],
