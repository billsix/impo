 "questions": [
  {
   "id": 676831,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Metro Corp. wants to acquire a new IT system, and Aliyah has been charged with selecting potential new vendors. Within the buying center, what is Aliyah’s role?",
   "answers": [
    {
     "id": 1344575,
     "content_html": "Gatekeeper",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The gatekeeper is the person the marketer has to negotiate their way through in order to reach the decision makers."
    },
    {
     "id": 1344574,
     "content_html": "Influencer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Influencers are those within the organization who help define specifications and/or provide information to be used in the evaluation process."
    },
    {
     "id": 1344573,
     "content_html": "Initiator",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The initiator is the individual within the buying center who first suggests the idea of purchasing a new product or service."
    },
    {
     "id": 1344576,
     "content_html": "Buyer",
     "correctness": "1.0",
     "feedback_html": "Buyers are those who have authority within the organization to select suppliers and negotiate and arrange the purchase terms."
    }
   ],
   "hints": [],
