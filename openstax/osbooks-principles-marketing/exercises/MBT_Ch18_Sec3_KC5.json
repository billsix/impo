 "questions": [
  {
   "id": 677171,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following has had the most impact on a customer’s access to product, brand visibility, and personalization?",
   "answers": [
    {
     "id": 1345936,
     "content_html": "Omnichannel marketing",
     "correctness": "1.0",
     "feedback_html": "Omnichannel marketing increases customer&#8217;s access to product, brand visibility, and personalization because it utilizes multiple channels to reach the customer."
    },
    {
     "id": 1345935,
     "content_html": "Freestanding retail locations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Freestanding retail locations have decreased over the past decades and does not increase a customer&#8217;s access to product or personalization."
    },
    {
     "id": 1345934,
     "content_html": "Retail communication",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Retail communication is an important aspect of the omnichannel, but by itself will not increase a customer&#8217;s access to products or personalization."
    },
    {
     "id": 1345933,
     "content_html": "Strip malls",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Strip malls do not increase a customer&#8217;s access to product or allow for personalization."
    }
   ],
