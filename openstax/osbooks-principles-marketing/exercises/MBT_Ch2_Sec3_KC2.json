   "stem_html": "In a SWOT analysis, which factors are internal to the organization?",
   "answers": [
    {
     "id": 1344443,
     "content_html": "Strengths and opportunities",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Strengths are factors that are internal to the organization, but opportunities are external factors."
    },
    {
     "id": 1344442,
     "content_html": "Weaknesses and threats",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Weaknesses are factors that are internal to the organization, but threats are external factors."
    },
    {
     "id": 1344444,
     "content_html": "Strengths and weaknesses",
     "correctness": "1.0",
     "feedback_html": "In a SWOT analysis, strengths and weaknesses are factors that are internal to the organization."
