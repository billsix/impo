   "id": 676897,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Janai is considering opening a McDonald’s in her home country of Nicaragua. Which type of market entry strategy would she use?",
   "answers": [
    {
     "id": 1344840,
     "content_html": "Franchise",
     "correctness": "1.0",
     "feedback_html": "McDonald&#8217;s is a franchise."
    },
    {
     "id": 1344839,
     "content_html": "Joint venture",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A joint venture is when two or more companies create a single enterprise or project."
    },
    {
     "id": 1344838,
     "content_html": "Strategic alliance",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A strategic alliance is when two companies agree to invest resources in a mutually beneficial way."
    },
    {
     "id": 1344837,
     "content_html": "Exporting",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Exporting is when a firm makes a product in one country and sells it in one or more other countries."
    }
   ],
