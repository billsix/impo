 "questions": [
  {
   "id": 676908,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a reason to implement a standardized marketing strategy?",
   "answers": [
    {
     "id": 1344883,
     "content_html": "To increase sales and reduce costs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Increasing business sales and reducing costs is a reason to implement a standardized strategy."
    },
    {
     "id": 1344882,
     "content_html": "To maximize a company’s manufacturing or production efficiencies",
     "correctness": "0.0",
     "feedback_html": "That is not correct. Maximizing efficiencies is a reason to implement a standardized strategy."
    },
    {
     "id": 1344881,
     "content_html": "To improve competitiveness and increase customer base",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Improved competitiveness and increased customer base support are reasons to implement a standardized strategy."
    },
    {
     "id": 1344884,
     "content_html": "To increase flexibility with constrained standards",
     "correctness": "1.0",
     "feedback_html": "Constrained standards do not increase flexibility. Constraints, instead, limit options for companies and consumers."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
