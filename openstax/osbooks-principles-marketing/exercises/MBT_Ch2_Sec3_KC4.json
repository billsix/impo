 "questions": [
  {
   "id": 676800,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In which section of the marketing plan would you identify key internal and external influences on the company’s current position?",
   "answers": [
    {
     "id": 1344451,
     "content_html": "Objectives and issues",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In the objectives and issues section of a marketing plan, objectives communicate what needs to be achieved and who is responsible for each activity."
    },
    {
     "id": 1344452,
     "content_html": "SWOT analysis",
     "correctness": "1.0",
     "feedback_html": "A SWOT analysis identifies key internal influences (strengths and weaknesses) and external influences (threats and opportunities)."
    },
    {
     "id": 1344450,
     "content_html": "Buyer personas",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A buyer person is a semi-fictional representation of a company&#8217;s ideal customer."
    },
    {
     "id": 1344449,
     "content_html": "Current marketing situation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The current marketing situation portion of a marketing plan provides the reader with a clear description of the current marketplace."
    }
   ],
