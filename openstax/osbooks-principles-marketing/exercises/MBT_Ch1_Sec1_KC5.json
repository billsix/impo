 "questions": [
  {
   "id": 676761,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At which step in the marketing process would the lifetime values to a company’s customers be considered?",
   "answers": [
    {
     "id": 1344295,
     "content_html": "Developing a customer-driven marketing strategy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Developing a customer-driven marketing strategy focuses on customers and their needs."
    },
    {
     "id": 1344294,
     "content_html": "Delivering high customer value",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Delivering high customer value entails giving customers value for their money&#8212;i.e., the difference between the perceived benefits and the costs incurred by the customer."
    },
    {
     "id": 1344293,
     "content_html": "Growing profitable customer relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Growing profitable customer relations is when marketers focus on building strong relationships and place an emphasis on customer relationship management."
    },
    {
     "id": 1344296,
     "content_html": "Capturing value from customers",
     "correctness": "1.0",
     "feedback_html": "The aim of successful customer relationship management is to produce high customer equity."
    }
   ],
