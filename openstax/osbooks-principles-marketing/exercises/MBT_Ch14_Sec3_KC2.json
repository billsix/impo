  {
   "id": 677068,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You show your friend the Adidas logo and ask them which brand it identifies. This is an example of ________.",
   "answers": [
    {
     "id": 1345523,
     "content_html": "brand impression",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Impressions is a metric used to determine how many times an audience views an advertisement."
    },
    {
     "id": 1345522,
     "content_html": "brand awareness",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Brand awareness is a metric used to determine what information is recalled about a brand."
    },
    {
     "id": 1345524,
     "content_html": "brand recognition",
     "correctness": "1.0",
     "feedback_html": "Brand recognition involves recognizing a brand based on a picture or logo."
    },
    {
     "id": 1345521,
     "content_html": "conversion rate",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The conversion rate is a metric used to determine how many viewers in an audience do something intended by an advertisement."
    }
   ],
