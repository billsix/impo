 "questions": [
  {
   "id": 676865,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A running shoe company specializes in designing sustainable sneakers from recycled and renewable materials for athletes who care about the environment, as well as performance models of running shoes with less cushioning for runners who are concerned with speed. What target marketing strategy does the running company use?",
   "answers": [
    {
     "id": 1344711,
     "content_html": "Concentrated marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A niche market (or concentrated marketing) channels all marketing actions toward one well-defined segment of the market."
    },
    {
     "id": 1344710,
     "content_html": "Undifferentiated marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Undifferentiated marketing treats all buyers or potential buyers as a homogenous group and creates one message for an entire audience."
    },
    {
     "id": 1344712,
     "content_html": "Differentiated marketing",
     "correctness": "1.0",
     "feedback_html": "A differentiated marketing strategy focuses on the differences between segments and designs a specific marketing mix for each segment."
    },
    {
     "id": 1344709,
     "content_html": "Micromarketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Micromarketing targets a specific group of individuals within a niche market based on specific information that has been collected about them."
    }
   ],
