 "questions": [
  {
   "id": 676830,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The human resources manager submits a request to upper management for a new software package that will manage payroll, benefits, compliance, and information technology. Within the buying center, what role is illustrated by this scenario?",
   "answers": [
    {
     "id": 1344571,
     "content_html": "Influencer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Influencers are those within the organization who help define specifications and/or provide information to be used in the evaluation process."
    },
    {
     "id": 1344570,
     "content_html": "Buyer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Buyers are those who have authority within the organization to select suppliers and negotiate and arrange the purchase terms of the purchase."
    },
    {
     "id": 1344572,
     "content_html": "Initiator",
     "correctness": "1.0",
     "feedback_html": "The initiator is the individual within the buying center who first suggests the idea of purchasing a new product or service."
    },
    {
     "id": 1344569,
     "content_html": "Decider",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Deciders are the people within the organization who have the authority to select or approve the final suppliers."
    }
   ],
