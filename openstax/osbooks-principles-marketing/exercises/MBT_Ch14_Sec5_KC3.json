 "questions": [
  {
   "id": 677079,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When Story Land, a children’s museum in New Hampshire, reopened, it utilized public relations. Numerous local television stations picked up and reported the story, providing free marketing to potential customers. The company bet on the positive virality of its press release, which worked in its favor. Which of the following disadvantages explains why Story Land “bet on the positive virality”? ",
   "answers": [
    {
     "id": 1345568,
     "content_html": "No direct control",
     "correctness": "1.0",
     "feedback_html": "The company had no direct control over whether the press release would be picked up by news stations."
    },
    {
     "id": 1345567,
     "content_html": "Increased brand recognition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Increased brand recognition is an advantage of public relations."
    },
    {
     "id": 1345566,
     "content_html": "Increased sales",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Increased sales is an advantage of public relations."
    },
    {
     "id": 1345565,
     "content_html": "Guarantee of results",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although the news stations picked up the story, there was still no guarantee of results."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
