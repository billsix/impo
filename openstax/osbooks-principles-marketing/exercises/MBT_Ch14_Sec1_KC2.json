   "id": 677058,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You see a television advertisement from Ford thanking frontline heroes during the pandemic. Which term best describes this advertisement?",
   "answers": [
    {
     "id": 1345483,
     "content_html": "Product advertising",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product advertising focuses on one product in the organization&#8217;s product mix"
    },
    {
     "id": 1345482,
     "content_html": "Public relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Public relations is a nonpaid form of promotion."
    },
    {
     "id": 1345484,
     "content_html": "Institutional advertising",
     "correctness": "1.0",
     "feedback_html": "This is an example of institutional advertising."
    },
    {
     "id": 1345481,
     "content_html": "Press relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Press relations is a form of public relations."
    }
