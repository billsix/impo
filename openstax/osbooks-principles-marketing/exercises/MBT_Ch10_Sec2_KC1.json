   "id": 676977,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A physical version of the product concept that is developed during the new product development process is called a ________.",
   "answers": [
    {
     "id": 1345159,
     "content_html": "mock-up",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A mock-up is not the term used in the product development stage of the new product development process."
    },
    {
     "id": 1345158,
     "content_html": "model",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A model is not the term used in the product development stage of the new product development process."
    },
    {
     "id": 1345160,
     "content_html": "prototype",
     "correctness": "1.0",
     "feedback_html": "A prototype is an early model of a new product that R&#38;D develops in order to be able to test the design."
    },
    {
     "id": 1345157,
     "content_html": "precedent",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A precedent is not the term used in the product development stage of the new product development process."
    }
   ],
