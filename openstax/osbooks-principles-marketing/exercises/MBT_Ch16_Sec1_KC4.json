   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Email marketing is permission-based marketing. Consumers must opt in to receive messages from companies. This typically occurs when a consumer purchases a product or service and asserts that they would like to receive messages from the company from which they’ve purchased."
    }
