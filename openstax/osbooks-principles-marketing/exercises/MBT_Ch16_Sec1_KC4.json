 "questions": [
  {
   "id": 677115,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which form of online marketing is permission-based, meaning that consumers must consent to receiving online messages?",
   "answers": [
    {
     "id": 1345711,
     "content_html": "Website marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Website marketing does not require visitors to grant permission in order for visitors to view content on the website."
    },
    {
     "id": 1345710,
     "content_html": "Blog marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Blog marketing involves creating content that is tailored to the interests of the audience. Reading and commenting on a blog does not require the visitor&#8217;s permission. Visitors may be required to create and sign into an account to leave a comment, but there is not permission required on the part of the visitor."
    },
    {
     "id": 1345709,
     "content_html": "Content marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Content marketing involves creating and distributing relevant content such as blogs, articles, and online videos to target audiences. Consumers of the content are not required to grant permission to marketers."
    },
    {
     "id": 1345712,
     "content_html": "Email marketing",
     "correctness": "1.0",
     "feedback_html": "Email marketing is permission-based marketing. Consumers must opt in to receive messages from companies. This typically occurs when a consumer purchases a product or service and asserts that they would like to receive messages from the company from which they&#8217;ve purchased."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
