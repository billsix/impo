 "questions": [
  {
   "id": 676995,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Bob refuses to get “on board” with smartphones. He insists on having a landline in his apartment. In terms of the new product adopter categories, Bob would be considered a(n) ________.",
   "answers": [
    {
     "id": 1345231,
     "content_html": "early adopter",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Early adopters are actually the best target market for new innovations."
    },
    {
     "id": 1345230,
     "content_html": "innovator",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Innovators are the first to buy new products as soon as they hit the market."
    },
    {
     "id": 1345232,
     "content_html": "laggard",
     "correctness": "1.0",
     "feedback_html": "Laggards are more in tune with the past than the future, and they are skeptical of new ideas."
    },
    {
     "id": 1345229,
     "content_html": "late adopter",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Late adopters are slow to catch on to the popularity of new products or services until the majority of consumers has adopted the innovation."
    }
   ],
