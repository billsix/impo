 "questions": [
  {
   "id": 677011,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which dimension in the RATER model represents the physical facilities, employees’ appearance, equipment, machinery, and information systems?",
   "answers": [
    {
     "id": 1345295,
     "content_html": "Assurance",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Assurance is the degree to which the organization inspires trust in its customers."
    },
    {
     "id": 1345294,
     "content_html": "Responsiveness",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Responsiveness refers to the eagerness of service staff to assist customers with respect and provide quick service to satisfy."
    },
    {
     "id": 1345293,
     "content_html": "Transparency",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Transparency is not one of the factors in the RATER model."
    },
    {
     "id": 1345296,
     "content_html": "Tangibles",
     "correctness": "1.0",
     "feedback_html": "Tangibles represent the physical facilities, employees&#8217; appearance, equipment, machinery, and information systems."
    }
   ],
