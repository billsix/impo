 "questions": [
  {
   "id": 676885,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which statistic can be used to show how many people responded to a survey question with “strongly agree”?",
   "answers": [
    {
     "id": 1344791,
     "content_html": "Mean",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The mean is an arithmetic average of quantitative answers."
    },
    {
     "id": 1344790,
     "content_html": "Median",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Median is the answer that is in the middle of all responses that have been placed in order."
    },
    {
     "id": 1344789,
     "content_html": "Mode",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although mode does identify the most common answer, it does not report the number of times respondents chose the answer, just the most common response."
    },
    {
     "id": 1344792,
     "content_html": "Frequency",
     "correctness": "1.0",
     "feedback_html": "A frequency analysis shows how many people reported each answer on a survey."
    }
   ],
