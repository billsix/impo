 "questions": [
  {
   "id": 676876,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following would not be considered marketing research?",
   "answers": [
    {
     "id": 1344755,
     "content_html": "Analyzing the product purchases of current customers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Understanding a customer&#8217;s purchase habits is valuable marketing research. This data can tell a company what is or is not working with its product offering or promotional campaign."
    },
    {
     "id": 1344754,
     "content_html": "Measuring the number of reactions to a social media post",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social media reactions or mentions are valuable marketing research as companies want to know their reach on individual social media platforms."
    },
    {
     "id": 1344756,
     "content_html": "Examining a competitor’s database of information",
     "correctness": "1.0",
     "feedback_html": "Although a competitor&#8217;s information is interesting, your company would not have access to it, and therefore it would not be considered marketing research."
    },
    {
     "id": 1344753,
     "content_html": "Surveying potential employees about why they are interested in working for a company",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Surveying potential employees about what is interesting about the company is valuable marketing research so that companies can continue to enhance the good features about working there."
    }
   ],
