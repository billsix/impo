 "questions": [
  {
   "id": 677132,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A(n) ________ marketing channel does not use intermediaries but rather involves the manufacturer distributing its market offering directly to consumers.",
   "answers": [
    {
     "id": 1345779,
     "content_html": "indirect",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An indirect marketing channel is when a company sells and distributes its products through a partnership with intermediaries who can assist with the distribution."
    },
    {
     "id": 1345780,
     "content_html": "direct",
     "correctness": "1.0",
     "feedback_html": "A direct marketing channel sells and distributes directly to the consumer without the use of intermediaries."
    },
    {
     "id": 1345778,
     "content_html": "omnichannel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An omnichannel marketing system is a multichannel approach whereby companies give consumers a variety of ways to purchase, receive, and return products."
    },
    {
     "id": 1345777,
     "content_html": "multichannel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A multichannel distribution system is where a single company sets up multiple distribution channels to reach customers."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A direct marketing channel sells and distributes directly to the consumer without the use of intermediaries."
    }
   ],
