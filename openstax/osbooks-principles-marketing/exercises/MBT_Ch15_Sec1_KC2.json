 "questions": [
  {
   "id": 677083,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Personal selling is ________.",
   "answers": [
    {
     "id": 1345583,
     "content_html": "unpaid advertising to consumers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is not unpaid."
    },
    {
     "id": 1345582,
     "content_html": "a method of increasing sales in the short term",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Because it is based on relationships, personal selling can take months and years to achieve a sale."
    },
    {
     "id": 1345584,
     "content_html": "one-on-one interaction between a sales professional and a potential buyer/customer",
     "correctness": "1.0",
     "feedback_html": "Personal selling is the one-on-one interaction between a sales professional and the potential customer."
    },
    {
     "id": 1345581,
     "content_html": "used for handling routine purchases",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is used for complex sales that are higher in price, require explanation and education, and typically can be varied according to the customer."
    }
   ],
