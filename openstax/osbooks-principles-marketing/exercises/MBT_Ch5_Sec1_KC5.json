 "questions": [
  {
   "id": 676846,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Peloton’s main products are Internet-connected stationary bikes and treadmills that enable subscribers to remotely participate in live classes via streaming media. This enables subscribers to have a “spin class” experience without going to the gym. On what basis has Peloton segmented the market?",
   "answers": [
    {
     "id": 1344635,
     "content_html": "Demographic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Demographic segmentation groups consumers by focusing on traits such as age, gender, income, etc."
    },
    {
     "id": 1344634,
     "content_html": "Behavioral",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Behavioral segmentation is a method of grouping consumers by their behavior patterns."
    },
    {
     "id": 1344633,
     "content_html": "Geographic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Geographic segmentation divides a market according to geographic areas such as regions, cities, states, countries, etc."
    },
    {
     "id": 1344636,
     "content_html": "Psychographic",
     "correctness": "1.0",
     "feedback_html": "Just like our in-text example of Mirror, Peloton speaks to the personality of people who want to work out but can&#8217;t find the time to go to the gym."
    }
   ],
