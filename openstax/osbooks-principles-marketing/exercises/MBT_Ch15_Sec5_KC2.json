 "questions": [
  {
   "id": 677103,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When Starbucks has a happy hour special from 2:00 to 4:00 and drinks are half price, what is the purpose of the sales promotion?",
   "answers": [
    {
     "id": 1345663,
     "content_html": "Lose money",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The focus is to increase sales volume and not to lose money."
    },
    {
     "id": 1345664,
     "content_html": "Stimulate demand",
     "correctness": "1.0",
     "feedback_html": "The sales promotion is structured to stimulate demand for more product."
    },
    {
     "id": 1345662,
     "content_html": "Spread information",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The focus of this sales promotion is not to spread information about the products."
    },
    {
     "id": 1345661,
     "content_html": "Increase customer satisfaction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While customers might be satisfied to receive the discounts on drinks, the sales promotion is not structured to increase customer satisfaction."
    }
   ],
   "hints": [],
