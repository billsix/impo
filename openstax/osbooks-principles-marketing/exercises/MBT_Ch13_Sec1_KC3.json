 "questions": [
  {
   "id": 677039,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you have a new brand and you want to reach a large consumer audience, which promotional mix element would probably be used?",
   "answers": [
    {
     "id": 1345407,
     "content_html": "Sales promotion",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sales promotion is used to induce short-term purchase of a product. It is not typically used to introduce a new brand or create brand awareness."
    },
    {
     "id": 1345406,
     "content_html": "Personal selling",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is a one-on-one communication meant to build relationships."
    },
    {
     "id": 1345408,
     "content_html": "Advertising",
     "correctness": "1.0",
     "feedback_html": "Advertising is a paid form of nonpersonal communications meant to reach a large audience."
    },
    {
     "id": 1345405,
     "content_html": "Public relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Public relations cannot be controlled and is not guaranteed to reach a large audience."
    }
   ],
