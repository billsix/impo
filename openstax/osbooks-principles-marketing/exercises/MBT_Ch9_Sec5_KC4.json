 "questions": [
  {
   "id": 676955,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Whole Foods 365 brand is an example of a ________.",
   "answers": [
    {
     "id": 1345071,
     "content_html": "national brand",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A national brand consists of products and services under a corporate name and identity. "
    },
    {
     "id": 1345072,
     "content_html": "private brand",
     "correctness": "1.0",
     "feedback_html": "Whole Foods uses the 365 brand as a private label for its products."
    },
    {
     "id": 1345070,
     "content_html": "licensed brand",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Licensed brands use the brand name for equity on a product manufactured by a different company "
    },
    {
     "id": 1345069,
     "content_html": "co-brand",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Co-branding involves two or more brands collaborating on a product or service. "
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Whole Foods uses the 365 brand as a private label for its products."
    }
