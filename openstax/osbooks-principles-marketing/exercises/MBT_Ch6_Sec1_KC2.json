 "questions": [
  {
   "id": 676873,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The collection of data the company has gathered over time and used to make marketing decisions on a regular basis is called its ________.",
   "answers": [
    {
     "id": 1344743,
     "content_html": "big data",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Big data is data that is collected from a lot of different sources, mostly external data."
    },
    {
     "id": 1344744,
     "content_html": "marketing information system",
     "correctness": "1.0",
     "feedback_html": "A marketing information system is a collection of data that an organization uses to make marketing decisions."
    },
    {
     "id": 1344742,
     "content_html": "marketing research",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing research is the act of collecting, analyzing, and presenting about data."
    },
    {
     "id": 1344741,
     "content_html": "survey data",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although surveys are a popular method of collecting primary data and would be helpful in making marketing decisions, survey data is not the collection of data over time."
    }
   ],
