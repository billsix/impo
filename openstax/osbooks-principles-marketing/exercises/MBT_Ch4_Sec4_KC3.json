 "questions": [
  {
   "id": 676839,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During which stage of the B2B buying process will members of the buying center be called upon to develop a bill of materials?",
   "answers": [
    {
     "id": 1344607,
     "content_html": "Stage 1: Problem recognition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 1 of the B2B buying process is problem recognition, during which phase someone identifies a problem that can be resolved through a purchase."
    },
    {
     "id": 1344608,
     "content_html": "Stage 2: Need description",
     "correctness": "1.0",
     "feedback_html": "In Stage 2: Need description, the buying center will work to put some parameters around what needs to be purchased and develop a bill of materials."
    },
    {
     "id": 1344606,
     "content_html": "Stage 3: Product specification",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In Stage 3: Product specification, B2B buyers often develop product specifications, a blueprint that outlines the product, what it will look like, and its specific requirements and functions."
    },
    {
     "id": 1344605,
     "content_html": "Stage 4: Supplier search",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In Stage 4: Supplier search, those in the buying center will seek out information on the products they are looking for and the vendors that can supply them."
    }
   ],
