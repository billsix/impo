   "stem_html": "How can a brand capture attention with packaging? ",
   "answers": [
    {
     "id": 1345099,
     "content_html": "Location in store",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. The location in store is important but is not a part of packaging. "
