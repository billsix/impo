 "questions": [
  {
   "id": 676923,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which ethnic term can be used for a person from Puerto Rico or of Puerto Rican descent?",
   "answers": [
    {
     "id": 1344943,
     "content_html": "Only Hispanic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A person from Puerto Rico or of Puerto Rican descent is not considered only Hispanic."
    },
    {
     "id": 1344944,
     "content_html": "Both Hispanic and Latino/Latina",
     "correctness": "1.0",
     "feedback_html": "A person from Puerto Rico or of Puerto Rican descent is both Hispanic and Latino/Latina. <i>Hispanic</i> is a language-based term describing somebody from a Spanish-speaking place, while Latino/Latina is a location-based term that identifies gendered individuals whose families originate in Latin America."
    },
    {
     "id": 1344942,
     "content_html": "Only Latino/Latina",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A person from Puerto Rico or of Puerto Rican descent is not considered only Latino/Latina."
    },
    {
     "id": 1344941,
     "content_html": "None of these terms are correct.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A person from Puerto Rico or of Puerto Rican descent is classified by an ethnic term."
    }
   ],
