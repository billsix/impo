 "questions": [
  {
   "id": 676863,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A ________ is a semi-fictional representation of your ideal customer that helps you understand and relate to the audience to which you want to market your product and/or services.",
   "answers": [
    {
     "id": 1344704,
     "content_html": "buyer persona",
     "correctness": "1.0",
     "feedback_html": "A buyer persona is a semi-fictional representation of your ideal customer based on market research and real data about your existing customers."
    },
    {
     "id": 1344703,
     "content_html": "target market",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A target market is a group of people with shared characteristics that a company has identified as potential customers for its products or services."
    },
    {
     "id": 1344702,
     "content_html": "niche market",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A niche market channels all marketing actions toward one well-defined segment of the market."
    },
    {
     "id": 1344701,
     "content_html": "brand affinity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Brand affinity is an individual&#8217;s brand preference given a product category."
    }
   ],
