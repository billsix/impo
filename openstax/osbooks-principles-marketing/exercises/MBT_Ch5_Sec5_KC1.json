 "questions": [
  {
   "id": 676862,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "M&amp;M’s addresses people of all ages and appeals to everyone looking for sweets (that melt in your mouth, not in your hand). What target marketing strategy does M&amp;M’s use?",
   "answers": [
    {
     "id": 1344699,
     "content_html": "Differentiated marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A differentiated marketing strategy focuses on the differences between segments and designs a specific marketing mix for each segment."
    },
    {
     "id": 1344698,
     "content_html": "Concentrated marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Concentrated marketing focuses on just one target market with a single marketing mix."
    },
    {
     "id": 1344700,
     "content_html": "Undifferentiated marketing",
     "correctness": "1.0",
     "feedback_html": "Undifferentiated marketing treats all buyers or potential buyers as a homogenous group and creates one message for an entire audience."
    },
    {
     "id": 1344697,
     "content_html": "Micromarketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Micromarketing targets a specific group of individuals within a niche market based on specific information that has been collected about them."
    }
   ],
