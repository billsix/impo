 "questions": [
  {
   "id": 677188,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How does sustainable marketing differentiate from other types of marketing?",
   "answers": [
    {
     "id": 1346003,
     "content_html": "It is more expensive.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Ultimately, sustainable marketing is oftentimes a cost savings."
    },
    {
     "id": 1346002,
     "content_html": "It is only for people who care about the environment.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While the environment is one aspect of sustainable marketing, economic viability and social initiatives are essential as well."
    },
    {
     "id": 1346001,
     "content_html": "It is a business imperative.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sustainable marketing is important, but it&#8217;s not what differentiates it."
    },
    {
     "id": 1346004,
     "content_html": "It is rooted in purpose.",
     "correctness": "1.0",
     "feedback_html": "Sustainable marketing is rooted in purpose, based on mission, and seeks to align people, planet, and profits."
    }
   ],
