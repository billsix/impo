 "questions": [
  {
   "id": 677153,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ is the planning, organizing, and controlling of the movement of raw materials and ultimately finished goods to end consumers.",
   "answers": [
    {
     "id": 1345863,
     "content_html": "Supply chain management",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Supply chain management involves managing all the members and activities from the procurement and transformation of raw materials into finished goods through their distribution to targeted consumers."
    },
    {
     "id": 1345864,
     "content_html": "Logistics",
     "correctness": "1.0",
     "feedback_html": "Logistics is the planning, organizing, and controlling the movement of raw materials and ultimately finished goods to end consumers"
    },
    {
     "id": 1345862,
     "content_html": "A marketing channel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing channels are the intermediaries who help distribute products to consumers."
    },
    {
     "id": 1345861,
     "content_html": "Transportation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Transportation is just one aspect of moving raw materials."
    }
   ],
