 "questions": [
  {
   "id": 676871,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A visual technique designed to show how the average target market consumer perceives the positioning of competing products in the market place is known as ________.",
   "answers": [
    {
     "id": 1344735,
     "content_html": "a positioning statement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A positioning statement is a brief description of your offering, how it meets the needs of a consumer, and why it is superior to your competitor&#8217;s offerings."
    },
    {
     "id": 1344734,
     "content_html": "head-to-head positioning",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Head-to-head positioning involves directly competing on similar product attributes in the market."
    },
    {
     "id": 1344733,
     "content_html": "differentiation positioning",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Differentiation positioning is based on the differentiating characteristics or qualities that make your product/service/brand better than those of your competitors."
    },
    {
     "id": 1344736,
     "content_html": "a perceptual map",
     "correctness": "1.0",
     "feedback_html": "A perceptual map is a visual diagram that shows how the average target market consumer perceives your product versus those of your competitors."
    }
   ],
   "hints": [],
