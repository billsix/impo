 "questions": [
  {
   "id": 676838,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jackson has asked several qualified vendors to submit proposals. Which stage of the B2B buying process does this illustrate?",
   "answers": [
    {
     "id": 1344603,
     "content_html": "Stage 2: Need description",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 2 of the B2B buying process is need description, in which the buying center works to put some parameters around what needs to be purchased."
    },
    {
     "id": 1344602,
     "content_html": "Stage 3: Product specification",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 3 of the B2B buying process is product specification, in which the B2B buyer develops a blueprint that outlines the product, what it will look like, and its specific requirements and functions."
    },
    {
     "id": 1344601,
     "content_html": "Stage 4: Supplier search",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 4 of the B2B buying process is supplier search, in which those involved in the buying center seek out information on the products they are looking for and the vendors that can supply them."
    },
    {
     "id": 1344604,
     "content_html": "Stage 5: Proposal solicitation",
     "correctness": "1.0",
     "feedback_html": "Stage 5 of the B2B buying process is proposal solicitation, in which qualified vendors are asked to submit proposals."
    }
   ],
