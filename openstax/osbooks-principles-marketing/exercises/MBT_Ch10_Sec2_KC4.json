 "questions": [
  {
   "id": 676980,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The least costly method of test-marketing is known as ________.",
   "answers": [
    {
     "id": 1345171,
     "content_html": "controlled test-marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Controlled test-marketing involves managing a group of stores that have agreed to carry the new product for a fee and then measuring sales at checkout."
    },
    {
     "id": 1345172,
     "content_html": "sales-wave research",
     "correctness": "1.0",
     "feedback_html": "In sales-wave research, consumers are initially allowed to try the product at no cost. They are then reoffered the product (or a competitor&#8217;s product) at a reduced price a number of times (i.e., sales waves). The point of this research is to see how many consumers select the new product and record their reported levels of satisfaction with the product."
    },
    {
     "id": 1345170,
     "content_html": "simulated test-marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Simulated test-marketing exposes customers to simulated market situations in order to gauge their reactions to a new product or service."
    },
    {
     "id": 1345169,
     "content_html": "crowdsourcing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Crowdsourcing is the practice of turning to a large body of people to obtain needed knowledge."
    }
   ],
