 "questions": [
  {
   "id": 676867,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following BEST describes a positioning statement?",
   "answers": [
    {
     "id": 1344719,
     "content_html": "It is a brief description of your offering, how it meets the needs of a consumer, and why it is superior to your competitor’s offerings.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. That is market segmentation."
    },
    {
     "id": 1344718,
     "content_html": "It sets forth the group(s) of people with shared characteristics that you’ve identified as potential customers for your products.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. That is a target market."
    },
    {
     "id": 1344720,
     "content_html": "It defines where your offering fits in the marketplace and why it is better than competitors’ offerings.",
     "correctness": "1.0",
     "feedback_html": "A positioning statement defines where your offering fits in the marketplace and why it is better than competitors&#8217; offerings."
    },
    {
     "id": 1344717,
     "content_html": "It is a visual tool designed to demonstrate the perception of your offerings by the average target market consumer vis-à-vis your competitors’ offerings.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. That is a perceptual map."
    }
   ],
