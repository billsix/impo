  {
   "id": 677177,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best describes wholesalers?",
   "answers": [
    {
     "id": 1345960,
     "content_html": "Businesses that buy in bulk at discounted prices and sell to retailers",
     "correctness": "1.0",
     "feedback_html": "Wholesalers are businesses that buy products in bulk and sell to retailers."
    },
    {
     "id": 1345959,
     "content_html": "Online stores in offline spaces",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Online stores with offline spaces are a trend in retailing."
    },
    {
     "id": 1345958,
     "content_html": "The final link between manufacturers and consumers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Retailers are the final link between manufacturers and consumers."
    },
    {
     "id": 1345957,
     "content_html": "Businesses that produce goods and services",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Manufacturers are businesses that produce goods and services."
    }
   ],
