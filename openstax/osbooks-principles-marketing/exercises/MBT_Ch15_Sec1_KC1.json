 "questions": [
  {
   "id": 677082,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Companies typically use personal selling as the promotional strategy of choice when which of these is true?",
   "answers": [
    {
     "id": 1345579,
     "content_html": "The product is higher in price.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Price is only one factor in deciding to use a personal selling strategy."
    },
    {
     "id": 1345578,
     "content_html": "The product requires the sales professional to spend significant time educating the customer.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Time educating the customer is only one factor in deciding to use a personal selling strategy."
    },
    {
     "id": 1345577,
     "content_html": "The product has a lot of variation.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product variation is only one factor in deciding to use a personal selling strategy."
    },
    {
     "id": 1345580,
     "content_html": "All of these statements are true.",
     "correctness": "1.0",
     "feedback_html": "Personal selling is used by companies when they have a product that needs explanation and education, it is higher in price, and it can be varied according to the needs of the customer."
    }
   ],
