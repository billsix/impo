 "questions": [
  {
   "id": 676840,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During which stage of the B2B buying process will the B2B buyer negotiate the order?",
   "answers": [
    {
     "id": 1344611,
     "content_html": "Stage 4: Supplier search",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 4 of the B2B buying process is supplier search, in which members of the buying center will seek out information on the products they are looking for and the vendors that can supply them."
    },
    {
     "id": 1344610,
     "content_html": "Stage 5: Proposal solicitation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 5 of the B2B buying process is proposal solicitation, in which qualified vendors are asked to submit proposals."
    },
    {
     "id": 1344609,
     "content_html": "Stage 6: Supplier selection",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stage 6 of the B2B buying process is supplier selection, in which the buying center chooses a supplier."
    },
    {
     "id": 1344612,
     "content_html": "Stage 7: Order-routine specification",
     "correctness": "1.0",
     "feedback_html": "In Stage 7: Order-routine specification, the B2B buyer negotiates the order, listing the technical specifications, the quantity needed, the expected time of delivery, etc."
    }
   ],
