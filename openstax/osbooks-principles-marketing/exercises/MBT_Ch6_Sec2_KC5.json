 "questions": [
  {
   "id": 676881,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Critical data that already exists within a company’s databases is called ________.",
   "answers": [
    {
     "id": 1344775,
     "content_html": "big data",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Big data is larger than one company&#8217;s databases and includes the volume, variety, and velocity of data being generated."
    },
    {
     "id": 1344776,
     "content_html": "internal data",
     "correctness": "1.0",
     "feedback_html": "Internal data is data that already exists within a company&#8217;s database. Internal data includes sales records, product research, pricing comparisons, and other data compiled previously."
    },
    {
     "id": 1344774,
     "content_html": "external data",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. External data originates from outside the organization and therefore is not part of the company&#8217;s database."
    },
    {
     "id": 1344773,
     "content_html": "competitive data",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Competitive data exists outside the company and most likely at the competitor&#8217;s website or other competitor company source."
    }
   ],
