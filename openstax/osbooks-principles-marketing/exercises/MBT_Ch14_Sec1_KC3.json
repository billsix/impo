 "questions": [
  {
   "id": 677059,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a new marketer in a firm, you are asked to provide the advantages of using advertising in an upcoming promotion strategy. Which of the following would be included in your list of advantages?",
   "answers": [
    {
     "id": 1345488,
     "content_html": "Advertising’s per-exposure cost is an advantage.",
     "correctness": "1.0",
     "feedback_html": "Advertising has a low per-exposure cost."
    },
    {
     "id": 1345487,
     "content_html": "Advertising is nonpaid, so it does not cost the company.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising is a paid promotion and can be quite costly to the organization."
    },
    {
     "id": 1345486,
     "content_html": "Advertising’s message is easy to change.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising messages cannot be changed as quickly as some other promotion mix elements."
    },
    {
     "id": 1345485,
     "content_html": "Advertising’s effectiveness is easy to capture early.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The effects of advertising on sales and profits can take some time to capture."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
