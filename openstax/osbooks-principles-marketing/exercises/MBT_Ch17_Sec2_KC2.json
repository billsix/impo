 "questions": [
  {
   "id": 677133,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A(n) ________ marketing channel partners with intermediaries including distributors, wholesalers, agents, or retailers to sell and distribute its products.",
   "answers": [
    {
     "id": 1345783,
     "content_html": "omnichannel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An omnichannel marketing system allows consumers to buy and receive products and services seamlessly across a variety of channels, including online and in-store."
    },
    {
     "id": 1345784,
     "content_html": "indirect",
     "correctness": "1.0",
     "feedback_html": "An indirect marketing channel relies on a partnership with intermediaries to sell and distribute its products."
    },
    {
     "id": 1345782,
     "content_html": "multichannel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A multichannel marketing system exists when a company uses a variety of channels, such as stores and online, to distribute products and services."
    },
    {
     "id": 1345781,
     "content_html": "vertical channel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A vertical channel system is when companies in the marketing channel work together in a coordinated, collaborative, and customer-centric way."
    }
   ],
