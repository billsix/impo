 "questions": [
  {
   "id": 676815,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The tendency of people to interpret information in a way that supports what they already believe is known as ________.",
   "answers": [
    {
     "id": 1344511,
     "content_html": "cognitive dissonance",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cognitive dissonance refers to the mental conflict that occurs when a person&#8217;s behaviors and beliefs do not align."
    },
    {
     "id": 1344510,
     "content_html": "selective attention",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Selective attention is the process through which you pay attention to only those stimuli that you consider relevant to your wants and needs and screen out the rest."
    },
    {
     "id": 1344509,
     "content_html": "selective retention",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Selective retention is a bias in which you are more likely to remember messages that are closely related to your interests, values, and beliefs rather than those that are contrary to those values and beliefs."
    },
    {
     "id": 1344512,
     "content_html": "selective distortion",
     "correctness": "1.0",
     "feedback_html": "Selective distortion is the tendency of people to interpret information in a way that fits their preconceived notions."
    }
   ],
