 "questions": [
  {
   "id": 676941,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a benefit of product line filling? ",
   "answers": [
    {
     "id": 1345015,
     "content_html": "Less money spent on research and development",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Research and development are a separate activity from product line development. "
    },
    {
     "id": 1345016,
     "content_html": "Protection against competitors",
     "correctness": "1.0",
     "feedback_html": "Product line filling has the benefit of protecting a brand from competitors that might enter the market with a similar offering and utilizes the brand’s capacity to produce more products."
    },
    {
     "id": 1345014,
     "content_html": "Creates a product line assortment",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Product line development itself creates an assortment of products. "
    },
    {
     "id": 1345013,
     "content_html": "Stretches the product line",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. While product filling certainly stretches the product line, it is not a benefit of product line filling. "
    }
   ],
   "hints": [],
