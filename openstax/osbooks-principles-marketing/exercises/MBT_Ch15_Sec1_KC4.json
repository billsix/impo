 "questions": [
  {
   "id": 677085,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a reason for personal selling to be used?",
   "answers": [
    {
     "id": 1345591,
     "content_html": "When the product is complicated",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is often used when the product is complex and requires education and explanation."
    },
    {
     "id": 1345592,
     "content_html": "When the product has a lot of competition",
     "correctness": "1.0",
     "feedback_html": "Most products in the market have a lot of competition. The level of competition has nothing to do with the use of personal selling."
    },
    {
     "id": 1345590,
     "content_html": "When the product needs to be demonstrated",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is a one-on-one activity used when the product needs explanation and demonstration."
    },
    {
     "id": 1345589,
     "content_html": "When the product is highly technical",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is used in situations when the product his highly technical and requires education and demonstration."
    }
   ],
   "hints": [],
