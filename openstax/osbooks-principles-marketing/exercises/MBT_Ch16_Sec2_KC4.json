 "questions": [
  {
   "id": 677120,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When a company’s website adapts to whatever screen consumers are using and users don’t need to pinch, expand, or scroll the screen to view content, this is known as ________.",
   "answers": [
    {
     "id": 1345731,
     "content_html": "website design",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although website design is important in communicating important information, engaging customers, and facilitating a transaction, it does not relate to the responsiveness of web design."
    },
    {
     "id": 1345730,
     "content_html": "responsive marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Responsive marketing is a concept covered in this chapter."
    },
    {
     "id": 1345729,
     "content_html": "content marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Content marketing relates to creating and distributing online content that is valuable and relevant to a company&#8217;s target customers."
    },
    {
     "id": 1345732,
     "content_html": "responsive web design",
     "correctness": "1.0",
     "feedback_html": "Responsive web design is a website development approach that results in a website&#8217;s display dynamically changing to adapt to whatever device a consumer uses. This approach is important to ensuring that consumers have a good user experience regardless of the device they are using."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
