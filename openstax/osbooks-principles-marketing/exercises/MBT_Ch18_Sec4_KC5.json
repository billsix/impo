   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is TRUE of social commerce?",
   "answers": [
    {
     "id": 1345955,
     "content_html": "Social media is on the decline.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social media continues to be on the rise"
    },
    {
     "id": 1345954,
     "content_html": "Very few brands and companies utilize social media.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Many brands and companies utilize social media"
    },
    {
     "id": 1345956,
     "content_html": "Social media is one way to incorporate omnichannel marketing.",
     "correctness": "1.0",
     "feedback_html": "Social media is one way in which companies can utilize an omnichannel marketing strategy, one in which utilizes many different channels to reach customers."
    },
    {
     "id": 1345953,
     "content_html": "Social media decreases personalization with customers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social media actually increases engagement and personalization with customers."
    }
