 "questions": [
  {
   "id": 677091,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "84 Lumber has personnel who work to set appointments and check inventory levels. What type of person does this for the sales force?",
   "answers": [
    {
     "id": 1345616,
     "content_html": "Support personnel",
     "correctness": "1.0",
     "feedback_html": "Companies often have support personnel to assist with elements of the sale. This can include checking on inventory and setting appointments for outside sales professionals."
    },
    {
     "id": 1345615,
     "content_html": "Missionary sales",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Missionary sales professionals are responsible for going out and meeting with customers."
    },
    {
     "id": 1345614,
     "content_html": "Technical specialist",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Technical specialists help with specifications and custom fitting products to the needs of the customer."
    },
    {
     "id": 1345613,
     "content_html": "Order getter",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Order getters are responsible for answering phones and taking orders when customers are ready to fill inventory."
    }
   ],
