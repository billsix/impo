 "questions": [
  {
   "id": 676890,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ashia is planning a business dinner with her new clients in Chile. She has never visited Chile before and is not familiar with their customs. Which of the following would you NOT advise Ashia to do?",
   "answers": [
    {
     "id": 1344811,
     "content_html": "Tell Ashia she should consider talking with a colleague who has traveled to Chile before.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Ashia should consider discussing Chilean culture with a colleague who is familiar with the culture."
    },
    {
     "id": 1344810,
     "content_html": "Tell Ashia to study some of the most important Chilean customs so as not to embarrass herself or offend her dinner guest.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Ashia should study some of the most important Chilean customs to show respect to her dinner guests."
    },
    {
     "id": 1344809,
     "content_html": "Tell Ashia that if she is in doubt, she should follow her dinner guests’ lead on what is appropriate.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Ashia should, if in doubt during her dinner, follow the lead of her dinner guests."
    },
    {
     "id": 1344812,
     "content_html": "Tell Ashia not to worry about it because the Chilean businesspeople should adapt to her customs because her customs are the best ones to follow.",
     "correctness": "1.0",
     "feedback_html": "This advice to Ashia could not only be offensive to her dinner guest but would also cause poor business relationships."
    }
   ],
