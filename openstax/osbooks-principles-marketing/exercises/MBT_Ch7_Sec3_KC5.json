 "questions": [
  {
   "id": 676901,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After being hired at ABC Corporation, you realize that all decisions for each facility in the world are made at the headquarters you work at in Pensacola, Florida. Which type of firm best describes the one you are working at?",
   "answers": [
    {
     "id": 1344855,
     "content_html": "Exporting firm",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An exporting firm simply manufactures product in one country and sells in another."
    },
    {
     "id": 1344856,
     "content_html": "International firm",
     "correctness": "1.0",
     "feedback_html": "An international firm has centralized decision-making, meaning decisions are made in the home country headquarters."
    },
    {
     "id": 1344854,
     "content_html": "Transnational firm",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A transnational firm makes decisions locally, in each country&#8217;s facilities."
    },
    {
     "id": 1344853,
     "content_html": "Importing firm",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An importing firm is one in which the company brings in product from another country to sell."
    }
   ],
   "hints": [],
