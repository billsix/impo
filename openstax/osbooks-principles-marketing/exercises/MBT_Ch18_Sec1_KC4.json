   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A company that utilizes more than one channel in its distribution is using which type of strategy?",
   "answers": [
    {
     "id": 1345891,
     "content_html": "Direct channel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A direct channel is one that does not utilize any intermediaries."
    },
    {
     "id": 1345890,
     "content_html": "Direct-to-consumer channel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A direct-to-consumer channel is one that does not utilize any intermediaries."
    },
    {
     "id": 1345892,
     "content_html": "Omnichannel",
     "correctness": "1.0",
     "feedback_html": "An omnichannel strategy is one that utilizes multiple channels."
    },
    {
     "id": 1345889,
     "content_html": "None of the above is correct.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. One of the options provided is the correct answer."
