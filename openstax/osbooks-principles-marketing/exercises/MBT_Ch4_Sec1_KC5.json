 "questions": [
  {
   "id": 676826,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "DaVonte has a home repair business. He goes to a home improvement store to purchase a large quantity of lumber for his next repair project. While he is there, he picks up batteries for the smoke detector in his house. In this scenario, the lumber is a ________ purchase, and the batteries are a ________ purchase.",
   "answers": [
    {
     "id": 1344555,
     "content_html": "B2C; B2B",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A B2C purchase is a transaction conducted between a business and a consumer and a B2B purchase is between businesses. The purchase from his repair business to a home improvement store is not a B2C transaction and the battery purchase is not a B2B purchase."
    },
    {
     "id": 1344554,
     "content_html": "B2B; B2G",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A B2B purchase is a transaction conducted between two businesses. While the purchase from his repair business to a home improvement store is a B2B transaction, there is no such thing as a B2G transaction."
    },
    {
     "id": 1344553,
     "content_html": "B2C; B2G",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A B2C purchase is a transaction conducted between a business and a consumer. The purchase from his repair business to a home improvement store is not a B2C transaction and there is no such thing as a B2G."
    },
    {
     "id": 1344556,
     "content_html": "B2B; B2C",
     "correctness": "1.0",
     "feedback_html": "DaVonte&#8217;s purchase of the lumber in connection with his business is a B2B transaction; the purchase of batteries for the smoke detector in his house is a B2C transaction."
    }
   ],
