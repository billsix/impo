 "questions": [
  {
   "id": 676805,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The observation is made that a single data point in isolation is not very useful. What can we do with a KPI data point to make it useful?",
   "answers": [
    {
     "id": 1344471,
     "content_html": "Compare the KPI data point with a related goal/objective (forecast).",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Comparing the KPI data point with a related goal or objective is just one way to make a single data point useful."
    },
    {
     "id": 1344470,
     "content_html": "Compare the KPI data point with our historical performance.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Comparing the KPI data point with historical performance is just one way to make a single data point useful."
    },
    {
     "id": 1344469,
     "content_html": "Compare the KPI data point with industry averages.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Comparing the KPI data point with industry averages is just one way to make a single data point useful."
    },
    {
     "id": 1344472,
     "content_html": "These are all useful things to do with a KPI data point.",
     "correctness": "1.0",
     "feedback_html": "A single data point in isolation tells us very little. However, we can compare the data point to other data points (for example, historical results, forecasts, operating tolerances, or industry averages) to judge our effectiveness."
    }
   ],
