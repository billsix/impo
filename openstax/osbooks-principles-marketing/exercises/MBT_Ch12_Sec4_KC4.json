 "questions": [
  {
   "id": 677030,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is true of price skimming?",
   "answers": [
    {
     "id": 1345371,
     "content_html": "It captures the most market share in the introduction stage of a product.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Penetration pricing attempts to capture the most market share in the introduction of a product."
    },
    {
     "id": 1345372,
     "content_html": "It is setting an initially high price of a product.",
     "correctness": "1.0",
     "feedback_html": "Price skimming sets an initially high price to capture the portion of the market willing to pay the price."
    },
    {
     "id": 1345370,
     "content_html": "It is setting an initially low price of a product.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Penetration pricing sets an initially low price to capture the greatest possible market share."
    },
    {
     "id": 1345369,
     "content_html": "It determines break-even units.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The break-even formula is used to determine the number of units that must be sold to cover the costs associated with producing the product."
    }
   ],
