 "questions": [
  {
   "id": 677089,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Special-Lite makes industrial doors for many commercial applications. Once the sales professional meets with the customer to discuss the products they wish to buy, the sale moves into production, and a special person within the company is assigned to make sure the doors meet the requirements specified in the blueprints. This person is a(n) ________.",
   "answers": [
    {
     "id": 1345607,
     "content_html": "order getter",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The order getter is only responsible for meeting with a customer and writing up the order for the product."
    },
    {
     "id": 1345606,
     "content_html": "order taker",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Order takers are only responsible for filling out the order information for customers."
    },
    {
     "id": 1345608,
     "content_html": "technical specialist",
     "correctness": "1.0",
     "feedback_html": "The person who is responsible for making sure the product meets the needs of the customer is the technical specialist."
    },
    {
     "id": 1345605,
     "content_html": "telemarketer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Telemarketers serve the primary function of generally discussing products with customers."
    }
   ],
   "hints": [],
