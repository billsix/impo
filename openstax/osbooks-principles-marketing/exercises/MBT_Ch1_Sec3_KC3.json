 "questions": [
  {
   "id": 676769,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If you wanted to fill a gap in the marketplace, you would have to carefully consider ________ to see what is already available on the market.",
   "answers": [
    {
     "id": 1344328,
     "content_html": "the competition",
     "correctness": "1.0",
     "feedback_html": "The competition has to be assessed to see how well and to what degree the need you hope to fulfill is currently being addressed."
    },
    {
     "id": 1344327,
     "content_html": "the customers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The customers&#8217; needs are essential, but they are not directly responsible for what the marketplace is currently offering."
    },
    {
     "id": 1344326,
     "content_html": "the public",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The public is a large audience that may not directly be related to your operations but that, nonetheless, may be impacted by the effects of your operation."
    },
    {
     "id": 1344325,
     "content_html": "the resellers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Resellers are important in bringing the product to the customer, but they do not determine what is already available on the market."
    }
   ],
