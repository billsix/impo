 "questions": [
  {
   "id": 676758,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following provides the most complete definition of marketing?",
   "answers": [
    {
     "id": 1344283,
     "content_html": "Marketing creates value.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although marketing does create value, it must also create, communicate, and more."
    },
    {
     "id": 1344284,
     "content_html": "Marketing is made up of every process involved in moving a product or service from your organization to the consumer.",
     "correctness": "1.0",
     "feedback_html": "Marketing is a complex activity and includes creating, communicating, delivering, and exchanging offerings that have value for customers, clients, partners, and society at large."
    },
    {
     "id": 1344282,
     "content_html": "Marketing includes distribution decisions.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although marketing includes distribution decisions, that is only one of many things that it must accomplish."
    },
    {
     "id": 1344281,
     "content_html": "Marketing is about building relationships.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although building relationships is an essential component of marketing, it is not the only essential component."
    }
   ],
