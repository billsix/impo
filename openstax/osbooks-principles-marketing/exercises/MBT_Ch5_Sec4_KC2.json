 "questions": [
  {
   "id": 676858,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Wall Enterprises is considering developing a new product for a market segment that has been identified by marketing research. However, based on the research, it appears that the market segment may be smaller than originally anticipated. Which essential factor of market segmentation does this reflect?",
   "answers": [
    {
     "id": 1344683,
     "content_html": "Accessible",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Accessibility refers to the ability to reach customers in the chosen segment at an affordable cost, given the strengths and abilities of your marketing department."
    },
    {
     "id": 1344682,
     "content_html": "Differentiable",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Differentiability means that the market should be internally homogenous but externally heterogeneous so that marketing actions can be applied to them without overlap."
    },
    {
     "id": 1344684,
     "content_html": "Substantial",
     "correctness": "1.0",
     "feedback_html": "A market segment should be substantial because it&#8217;s inefficient to waste resources to market the product or service to a segment too small to justify a company&#8217;s time."
    },
    {
     "id": 1344681,
     "content_html": "Actionable",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. If a target market is actionable, it should respond to a certain marketing strategy and yield outcomes that can be easily quantified."
    }
   ],
