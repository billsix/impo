 "questions": [
  {
   "id": 677128,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A(n) ________ is someone who acts as an extension of the manufacturer. While they never take possession of the product or service they represent, they earn a commission or collect a fee for facilitating the transaction between the customer and the manufacturer.",
   "answers": [
    {
     "id": 1345763,
     "content_html": "retailer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Retailers buy from wholesalers and distributors and sell directly to end users or consumers."
    },
    {
     "id": 1345762,
     "content_html": "wholesaler",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Wholesalers buy in bulk from manufacturers then sell to other intermediaries, such as retailers, in smaller quantities. They take possession of the products and services before selling them."
    },
    {
     "id": 1345761,
     "content_html": "distributor",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A distributor aligns itself closely with a manufacturer by buying exclusively from the manufacturer before selling to other intermediaries."
    },
    {
     "id": 1345764,
     "content_html": "agent",
     "correctness": "1.0",
     "feedback_html": "Agents serve as representatives of manufacturers. While they never take possession of a product or service, they earn a commission or collect a fee for facilitating the transaction between the customers and the manufacturer."
    }
   ],
   "hints": [],
