   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Traditionally, in China, the bride’s wedding gown is red because the color is associated with good luck, happiness, and prosperity. Which influence on consumer buying behavior does this illustrate?",
   "answers": [
    {
     "id": 1344504,
     "content_html": "Culture",
     "correctness": "1.0",
     "feedback_html": "Culture refers to the values, ideas, and attitudes that are learned and shared among the members of a group."
    },
    {
     "id": 1344503,
     "content_html": "Social class",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social class refers to those who occupy a similar socioeconomic status."
    },
    {
     "id": 1344502,
     "content_html": "Lifestyle",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Your lifestyle reflects your attitudes and values, such as living a healthy lifestyle."
    },
    {
     "id": 1344501,
     "content_html": "Personality",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personality is the characteristic patterns of thoughts, feelings, and behaviors that make a person unique."
    }
   ],
