 "questions": [
  {
   "id": 677074,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Mikel does not have a lot of money for marketing his new business. But he wants to raise awareness of his company and decides to commit to handing out free water at a local 5K run. Which of the following is Mikel participating in?",
   "answers": [
    {
     "id": 1345548,
     "content_html": "Events",
     "correctness": "1.0",
     "feedback_html": "Events are a type of public relations in which a company participates to increase brand awareness."
    },
    {
     "id": 1345547,
     "content_html": "Lobbying",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Lobbying involves attempts to influence public policy and law."
    },
    {
     "id": 1345546,
     "content_html": "Press relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Press relations creates positive relationships with news media."
    },
    {
     "id": 1345545,
     "content_html": "Public affairs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Public affairs involves engaging with public officials."
    }
   ],
