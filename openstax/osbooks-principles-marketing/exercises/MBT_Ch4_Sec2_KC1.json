   "id": 676827,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The largest business and organizational market in the United States is ________.",
   "answers": [
    {
     "id": 1344559,
     "content_html": "producers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although producers buy significant quantities of products to be used in the manufacturing process, they do not make up the largest single business and organizational market in the United States."
    },
    {
     "id": 1344558,
     "content_html": "institutions",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Although institutions buy significant quantities of products to be used in the manufacturing process, they do not make up the largest single business and organizational market in the United States."
    },
    {
     "id": 1344560,
     "content_html": "governments",
     "correctness": "1.0",
     "feedback_html": "Government markets make up the largest single business and organizational market in the United States."
    },
    {
     "id": 1344557,
     "content_html": "resellers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although resellers buy significant quantities of products, they do not make up the largest single business and organizational market in the United States."
    }
   ],
