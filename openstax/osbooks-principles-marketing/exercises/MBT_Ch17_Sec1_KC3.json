 "questions": [
  {
   "id": 677129,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Without intermediaries, the number of transactions between the total number of manufacturers and the total number of consumers would ________.",
   "answers": [
    {
     "id": 1345767,
     "content_html": "decrease",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The total number of transactions does not decrease when intermediaries are removed from the distribution channel."
    },
    {
     "id": 1345766,
     "content_html": "stay the same",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The total number of transactions does not stay the same when intermediaries are removed from the distribution channel."
    },
    {
     "id": 1345768,
     "content_html": "increase",
     "correctness": "1.0",
     "feedback_html": "When intermediaries are removed from the marketing channel, manufacturers must then be solely responsible for distributing products directly to all customers. Thus, the number of transactions would increase."
    },
    {
     "id": 1345765,
     "content_html": "decrease temporarily",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The total number of transactions does not decrease temporarily when intermediaries are removed from the distribution channel."
    }
   ],
   "hints": [],
