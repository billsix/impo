 "questions": [
  {
   "id": 677127,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A(n) ________ is a group of people, organizations, processes, and activities that work together to deliver products and services to the consumer.",
   "answers": [
    {
     "id": 1345759,
     "content_html": "wholesaler",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A wholesaler is an intermediary that buys a variety of products in bulk to sell to retailers or other intermediaries for a profit."
    },
    {
     "id": 1345758,
     "content_html": "manufacturer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A manufacturer is a person or company that produces finished goods using raw materials, tools, technology, and other processes."
    },
    {
     "id": 1345757,
     "content_html": "intermediary",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An intermediary is a person or company through whom a product passes on its path to reaching the consumer."
    },
    {
     "id": 1345760,
     "content_html": "marketing channel",
     "correctness": "1.0",
     "feedback_html": "A marketing channel is a collection of people, organizations, processes, and activities that work together to deliver products and services to the consumer."
    }
   ],
   "hints": [],
