  {
   "id": 676894,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The assumption that all Chinese individuals are extremely gifted in mathematics is known as a ________.",
   "answers": [
    {
     "id": 1344828,
     "content_html": "stereotype",
     "correctness": "1.0",
     "feedback_html": "Stereotypes are assumptions or generalizations made about an entire group of people."
    },
    {
     "id": 1344827,
     "content_html": "lifestyle",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A lifestyle is the way in which a person or group of people live."
    },
    {
     "id": 1344826,
     "content_html": "culture",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Culture is the language, symbols, mannerisms, and other aspects of groups of people."
    },
    {
     "id": 1344825,
     "content_html": "sociocultural factor",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sociocultural factors include values, behaviors, culture, lifestyle, and language that shape a person&#8217;s or group&#8217;s way of living."
    }
   ],
