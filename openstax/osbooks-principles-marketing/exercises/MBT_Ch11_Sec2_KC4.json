 "questions": [
  {
   "id": 677005,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In the Service Marketing Triangle, ________ occurs when employees and customers associate and communicate.",
   "answers": [
    {
     "id": 1345271,
     "content_html": "internal marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Internal service marketing involves motivating employees to work as a team to make customers satisfied."
    },
    {
     "id": 1345270,
     "content_html": "external marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. External service marketing refers to the promotion of an organization&#8217;s services in the external environment where the company promotes its services to customers."
    },
    {
     "id": 1345272,
     "content_html": "interactive marketing",
     "correctness": "1.0",
     "feedback_html": "Interactive marketing occurs when employees and customers interact. It is there where the promises made during external marketing are either kept, broken, or exceeded by employees."
    },
    {
     "id": 1345269,
     "content_html": "customer satisfaction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer satisfaction is a component of the service-profit chain model, not the Service Marketing Triangle."
    }
   ],
