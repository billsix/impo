   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Adding fixed costs to variable costs yields which of the following?",
   "answers": [
    {
     "id": 1345352,
     "content_html": "Total costs",
     "correctness": "1.0",
     "feedback_html": "Total costs are equal to fixed costs &#43; variable costs."
    },
    {
     "id": 1345351,
     "content_html": "Profit",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Profit is not calculated by adding fixed costs to variable costs."
    },
    {
     "id": 1345350,
     "content_html": "Value",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Value is not calculated by adding fixed costs to variable costs."
    },
    {
     "id": 1345349,
     "content_html": "Inflation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inflation is not calculated by adding fixed costs to variable costs."
    }
   ],
