 "questions": [
  {
   "id": 676993,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the first stage in the consumer adoption process?",
   "answers": [
    {
     "id": 1345224,
     "content_html": "Product awareness",
     "correctness": "1.0",
     "feedback_html": "Product awareness is the first stage in the consumer adoption process, in which a company creates awareness that the product is available."
    },
    {
     "id": 1345223,
     "content_html": "Product evaluation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product evaluation is the third stage in the consumer adoption process, in which consumers examine, compare, and evaluate the product prior to purchase."
    },
    {
     "id": 1345222,
     "content_html": "Product trial",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product trial is the fourth stage in the consumer adoption process, in which the consumer tries the product out."
    },
    {
     "id": 1345221,
     "content_html": "Product interest",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product interest is a stage in the consumer adoption process in which the product has already piqued the consumer&#8217;s interest."
    }
   ],
