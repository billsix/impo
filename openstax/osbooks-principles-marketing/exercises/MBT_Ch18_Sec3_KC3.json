 "questions": [
  {
   "id": 677169,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You are interested in opening a small retail location that sells handmade jewelry in the small, rural town you reside in. Which of the following would be your best choice of location?",
   "answers": [
    {
     "id": 1345927,
     "content_html": "Department store",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Department store locations are chosen by retailers that have multiple product lines."
    },
    {
     "id": 1345926,
     "content_html": "Regional shopping center",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Most small, rural towns do not have regional shopping centers."
    },
    {
     "id": 1345928,
     "content_html": "Central business district",
     "correctness": "1.0",
     "feedback_html": "A small, rural town is most likely to have a central business district, or &#8220;downtown.&#8221;"
    },
    {
     "id": 1345925,
     "content_html": "Automatic vending",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Automatic vending are non-store retailers with no human interaction."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "A small, rural town is most likely to have a central business district, or “downtown.”"
    }
