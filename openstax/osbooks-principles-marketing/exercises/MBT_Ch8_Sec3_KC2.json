 "questions": [
  {
   "id": 676918,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following are not examples of tangible or external expressions of culture?",
   "answers": [
    {
     "id": 1344923,
     "content_html": "Actions and behaviors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Actions and behaviors are examples of external expressions of culture."
    },
    {
     "id": 1344922,
     "content_html": "Traditions and customs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Traditions and customs are examples of external expressions of culture."
    },
    {
     "id": 1344924,
     "content_html": "Values and attitudes",
     "correctness": "1.0",
     "feedback_html": "Values and attitudes are not examples of external expressions of culture. They are examples of internal expressions of culture."
    },
    {
     "id": 1344921,
     "content_html": "Music and visual arts",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Music and visual arts are examples of external expressions of culture."
    }
   ],
