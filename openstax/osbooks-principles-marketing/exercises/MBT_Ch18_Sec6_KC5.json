 "questions": [
  {
   "id": 677186,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which regulation requires goods sold to be safe and include clear directions?",
   "answers": [
    {
     "id": 1345996,
     "content_html": "Sale of Goods Act",
     "correctness": "1.0",
     "feedback_html": "The Sale of Goods Act requires the accurate, safe, and clear use of directions on goods and services sold."
    },
    {
     "id": 1345995,
     "content_html": "Food and Drug Act",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The Food and Drugs Act prohibits the sale of misbranded or adulterated food and drugs."
    },
    {
     "id": 1345994,
     "content_html": "Caveat Emptor",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. <emphasis effect=\"italics\">Caveat emptor</emphasis> translates to &#8220;let the buyer beware.&#8221;"
    },
    {
     "id": 1345993,
     "content_html": "Better Business Bureau",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The Better Business Bureau provides the public with information on business and charities and handles consumer complaints."
    }
   ],
