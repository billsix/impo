   "id": 676855,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jose’s firm is looking to market its products in Venezuela, but the marketing department is concerned about the current inflation rate in the country. This would be considered a(n) ________ factor.",
   "answers": [
    {
     "id": 1344671,
     "content_html": "geographic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Geographic factors would take into account things like topography and infrastructure."
    },
    {
     "id": 1344670,
     "content_html": "political",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Political factors would take into account things like the stability of the government, its regulations on trade, bureaucracy, etc."
    },
    {
     "id": 1344672,
     "content_html": "economic",
     "correctness": "1.0",
     "feedback_html": "Economic factors consider things like inflation, per capita income, unemployment, etc."
    },
    {
     "id": 1344669,
     "content_html": "cultural",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cultural factors are things like common language, religions, values, and attitudes."
    }
   ],
