 "questions": [
  {
   "id": 677071,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Liam is interested in the ratings of a recent television advertisement. They are interested in calculating the impressions of this ad. Liam knows that the target population of this ad is 500,000, and the ad runs three times. Which information is Liam missing to calculate impressions?",
   "answers": [
    {
     "id": 1345535,
     "content_html": "Converts",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Liam does not need to know the converts to make the calculation."
    },
    {
     "id": 1345536,
     "content_html": "Rating",
     "correctness": "1.0",
     "feedback_html": "Impressions &#61; Rating &#215; Target Population &#215; Number of Ads. In this scenario, Liam is missing the rating information."
    },
    {
     "id": 1345534,
     "content_html": "Conversion rate",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Liam does not need to know the conversion rate to make the calculation."
    },
    {
     "id": 1345533,
     "content_html": "Number of weeks the ad ran",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Liam does not need this information to make the calculation."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Impressions = Rating × Target Population × Number of Ads. In this scenario, Liam is missing the rating information."
    }
   ],
   "community_solutions": []
  }
 ],
