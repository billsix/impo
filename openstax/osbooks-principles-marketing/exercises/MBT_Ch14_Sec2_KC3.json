   "id": 677064,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If the target market for a product or service is millennials, which advertising media would you most likely choose?",
   "answers": [
    {
     "id": 1345508,
     "content_html": "Digital media",
     "correctness": "1.0",
     "feedback_html": "Millennials are more likely to see advertisements in digital form, such as social media, rather than more traditional media."
    },
    {
     "id": 1345507,
     "content_html": "Outdoor advertising",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Millennials are not as likely to see outdoor advertisements as they are to see some other forms of advertising."
    },
    {
     "id": 1345506,
     "content_html": "Newspapers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Millennials are not as likely to see newspaper advertisements as they are to see some other forms of advertising."
    },
    {
     "id": 1345505,
     "content_html": "Billboards",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Millennials are not as likely to see billboard advertisements as they are to see some other forms of advertising."
    }
