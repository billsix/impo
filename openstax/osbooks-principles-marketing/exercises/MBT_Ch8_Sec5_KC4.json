 "questions": [
  {
   "id": 676930,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When marketing specifically to consumers with disabilities, you can express inclusivity in advertising by using ________.",
   "answers": [
    {
     "id": 1344971,
     "content_html": "all individuals, even those who do not have a disability",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Use an approach that ensures the company&#8217;s efforts express humanity, authenticity, and inclusivity, which can involve consulting or hiring individuals who have a disability rather than using actors or models who do not."
    },
    {
     "id": 1344970,
     "content_html": "impersonal and abstract images",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Use an approach that ensures the company&#8217;s efforts express humanity, authenticity, and inclusivity in all areas of marketing communications including models and images."
    },
    {
     "id": 1344972,
     "content_html": "individuals who have a disability",
     "correctness": "1.0",
     "feedback_html": "Use an approach that ensures the company&#8217;s efforts express humanity, authenticity, and inclusivity, which can involve consulting or hiring individuals who have a disability rather than using actors or models who do not."
    },
    {
     "id": 1344969,
     "content_html": "only nonvisual advertising media",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Use an approach that ensures the company&#8217;s efforts express humanity, authenticity, and inclusivity in all areas of marketing communications including media formats."
    }
   ],
