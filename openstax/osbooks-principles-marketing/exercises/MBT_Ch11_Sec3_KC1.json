 "questions": [
  {
   "id": 677007,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which gap in the Gap Model of Service Quality represents the difference between what customers expect and what the company thinks they expect?",
   "answers": [
    {
     "id": 1345279,
     "content_html": "Communication gap",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The communication gap is the difference between the delivery of the customer experience and what is communicated to the customer."
    },
    {
     "id": 1345278,
     "content_html": "Customer gap",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The customer gap is the difference between the customer&#8217;s expectations of the service or experience and their perception of the experience."
    },
    {
     "id": 1345280,
     "content_html": "Knowledge gap",
     "correctness": "1.0",
     "feedback_html": "The knowledge gap represents the difference between what customers expect and what the company <i>thinks</i> they expect."
    },
    {
     "id": 1345277,
     "content_html": "Policy gap",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The policy gap is the difference between management&#8217;s perception of the customer&#8217;s needs and the translation of that understanding into service delivery policies and standards."
    }
   ],
   "hints": [],
