 "questions": [
  {
   "id": 677052,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The first step in the IMC planning process is ________.",
   "answers": [
    {
     "id": 1345459,
     "content_html": "determine the objectives",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The objectives cannot be determined without a complete understanding of the target audience."
    },
    {
     "id": 1345458,
     "content_html": "determine the budget",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Determining the budget is the fourth step once you have a good understanding of what the IMC plan needs to be."
    },
    {
     "id": 1345460,
     "content_html": "identify the target audience",
     "correctness": "1.0",
     "feedback_html": "The process should begin with a complete understanding of the target audience for the promotional efforts."
    },
    {
     "id": 1345457,
     "content_html": "select the promotional tools",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The promotional mix is defined as one of the last steps in the planning process."
    }
   ],
