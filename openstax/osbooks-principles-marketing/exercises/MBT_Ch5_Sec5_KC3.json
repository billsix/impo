 "questions": [
  {
   "id": 676864,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Lefty’s is a retail shop that makes specific products like left-handed scissors and left-handed notebooks for the population of left-handed people. What target marketing strategy does Lefty’s use?",
   "answers": [
    {
     "id": 1344707,
     "content_html": "Undifferentiated marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The point of undifferentiated marketing is to reach as many people as possible, hoping they&#8217;ll get on board with your products or services."
    },
    {
     "id": 1344706,
     "content_html": "Differentiated marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A differentiated marketing strategy focuses on the differences between segments and designs a specific marketing mix for each segment."
    },
    {
     "id": 1344708,
     "content_html": "Concentrated marketing",
     "correctness": "1.0",
     "feedback_html": "Concentrated marketing (or niche marketing) is a subset of a market on which a particular product or service is focused. In Lefty&#8217;s case, it is focusing on left-handed people."
    },
    {
     "id": 1344705,
     "content_html": "Micromarketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Micromarketing targets a specific group of individuals within a niche market based on specific information that has been collected about them."
    }
   ],
