 "questions": [
  {
   "id": 676817,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Janelle and her sister are planning a reception for their parents’ 50th wedding anniversary. They have looked at several venues, comparing size, location and accommodations, photo opportunities, and parking. What stage in the consumer decision process model does this best illustrate?",
   "answers": [
    {
     "id": 1344519,
     "content_html": "Need recognition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The need recognition stage is when you sense a difference between your actual state and your desired state."
    },
    {
     "id": 1344518,
     "content_html": "Information search",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The information search stage would involve doing research about the venues on the Internet and perhaps asking friends or family for suggestions."
    },
    {
     "id": 1344520,
     "content_html": "Evaluation of alternatives",
     "correctness": "1.0",
     "feedback_html": "They are evaluating the &#8220;bundle of attributes&#8221; of each venue."
    },
    {
     "id": 1344517,
     "content_html": "Purchase decision",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. This stage involves actually reaching a decision on the booking of the venue."
    }
   ],
   "hints": [],
