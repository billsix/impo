 "questions": [
  {
   "id": 676802,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What are key performance indicators (KPIs)?",
   "answers": [
    {
     "id": 1344459,
     "content_html": "Industry economic forecasts gathered during external analysis",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. KPIs do not include industry economic forecasts."
    },
    {
     "id": 1344458,
     "content_html": "A collection of all the detailed statistics we can find regarding firm performance",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. KPIs include some firm performance statistics, but not all of them."
    },
    {
     "id": 1344457,
     "content_html": "A competitive analysis that allows a company to understand the strategic direction of competitors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. KPIs are not concerned with a firm&#8217;s competitive analysis."
    },
    {
     "id": 1344460,
     "content_html": "Specific variables that allow us to monitor the health/performance of the organization",
     "correctness": "1.0",
     "feedback_html": "KPIs consist of a very focused selection of core variables that allow us to monitor the health/performance of the organization. We need enough indicators to evaluate the various critical aspects of the organization. We need to avoid having so many that the clutter obscures symptoms that should be highlighted."
    }
   ],
