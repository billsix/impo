 "questions": [
  {
   "id": 676823,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jason, a purchasing agent for an electronics firm, places an order with a supplier for diodes to be used in the manufacturing process. This is an example of a transaction in the ________ market.",
   "answers": [
    {
     "id": 1344544,
     "content_html": "B2B",
     "correctness": "1.0",
     "feedback_html": "A B2B (or &#8220;business-to-business&#8221;) transaction is one that is conducted between one business and another."
    },
    {
     "id": 1344543,
     "content_html": "B2C",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A B2C (or &#8220;business-to-consumer&#8221;) transaction is one that is conducted between a business and an individual consumer."
    },
    {
     "id": 1344542,
     "content_html": "B2G",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A B2G (or &#8220;business-to-government&#8221;) transaction is one that is conducted between a business and federal, state, or local government agencies."
    },
    {
     "id": 1344541,
     "content_html": "C2C",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A C2C (or &#8220;consumer-to-consumer&#8221;) transaction is one that is conducted between consumers, such as eBay or Facebook Marketplace."
    }
   ],
