 "questions": [
  {
   "id": 676822,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The demand for smartphones and similar devices has created a demand for other needed components, such as touch-sensitive glass screens, microchips, and circuit boards. This is an example of ________ demand.",
   "answers": [
    {
     "id": 1344539,
     "content_html": "direct",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Direct demand refers to demand for goods meant for final consumption."
    },
    {
     "id": 1344538,
     "content_html": "irregular",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Irregular demand is demand that is not consistent, such as seasonal products like winter clothing and air conditioners."
    },
    {
     "id": 1344540,
     "content_html": "derived",
     "correctness": "1.0",
     "feedback_html": "Derived demand is a market demand for a good or service that results from a demand for a related good or service."
    },
    {
     "id": 1344537,
     "content_html": "negative",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Negative demand is a type of demand that is created if a product is disliked in general."
    }
   ],
