 "questions": [
  {
   "id": 677027,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Luis is planning to introduce a new product to the market. Their aim is to gain as much of the market share as possible in the early introduction stage, so they are thinking of setting an initially low price. Which pricing strategy is Luis using?",
   "answers": [
    {
     "id": 1345359,
     "content_html": "Break-even analysis",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Break-even analysis allows marketers to determine how many units must be sold to cover all costs associated with the product."
    },
    {
     "id": 1345358,
     "content_html": "Price skimming",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Price skimming refers to a new product pricing strategy that charges an initially high price and then progressively lowers the price to capture incremental shares of the market."
    },
    {
     "id": 1345360,
     "content_html": "Penetration pricing",
     "correctness": "1.0",
     "feedback_html": "Penetration pricing is setting an initially low price to capture as much market share as possible."
    },
    {
     "id": 1345357,
     "content_html": "Psychological pricing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Psychological pricing refers to pricing strategies that utilize the subconscious of the consumer to set prices."
    }
   ],
