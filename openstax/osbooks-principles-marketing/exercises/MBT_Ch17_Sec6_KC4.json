 "questions": [
  {
   "id": 677155,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ ensures that every element of logistics as part of the entire supply chain is part of a system that works cohesively to ensure that the wants and needs of final customers are met.",
   "answers": [
    {
     "id": 1345871,
     "content_html": "A marketing channel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing channels are the intermediaries who help distribute products to consumers."
    },
    {
     "id": 1345870,
     "content_html": "Information management",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Information management is a broad term covering all types of information."
    },
    {
     "id": 1345869,
     "content_html": "Integrated marketing communication",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Integrated marketing communications entails developing a clear, consistent, cohesive, and synergistic message that is delivered across all promotional channels."
    },
    {
     "id": 1345872,
     "content_html": "Integrated logistics management",
     "correctness": "1.0",
     "feedback_html": "Integrated logistics management ensures that every element of logistics as part of the entire supply chain is part of a system that works cohesively to ensure that the wants and needs of final customers are met."
    }
   ],
