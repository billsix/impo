 "questions": [
  {
   "id": 677116,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following represents an advantage of using online direct marketing tools?",
   "answers": [
    {
     "id": 1345715,
     "content_html": "Online direct marketing allows marketers to target consumers globally because of worldwide access to the internet.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although answer a is correct, all of the options are correct as well. Advantages of online direct marketing are that it has global reach, is highly targeted, and can be much easier to measure ROI."
    },
    {
     "id": 1345714,
     "content_html": "Online direct marketing is highly targeted in that marketers can reach customers through a variety of digital channels that are inexpensive compared to other promotion tools.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although answer b is correct, all of the options are correct as well. Advantages of online direct marketing are that it has global reach, is highly targeted, and can be much easier to measure ROI."
    },
    {
     "id": 1345713,
     "content_html": "Online direct marketing allows for easier measurement of ROI on campaigns.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although answer c is correct, all of the options are correct as well. Advantages of online direct marketing are that it has global reach, is highly targeted, and can be much easier to measure ROI."
    },
    {
     "id": 1345716,
     "content_html": "All of these are advantages of online direct marketing.",
     "correctness": "1.0",
     "feedback_html": "Advantages of online direct marketing are that it has global reach, is highly targeted, and can be much easier to measure ROI."
    }
