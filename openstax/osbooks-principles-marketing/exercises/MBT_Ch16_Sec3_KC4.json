 "questions": [
  {
   "id": 677125,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the metrics could be used to measure the performance of a social media campaign?",
   "answers": [
    {
     "id": 1345752,
     "content_html": "Social engagement",
     "correctness": "1.0",
     "feedback_html": "Social engagement relates to the actions that users take when they engage with content on social media. Online marketers measure clicks, likes, shares, and comments to help online marketers assess the quality of their content."
    },
    {
     "id": 1345751,
     "content_html": "Page views",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Analyzing total page views is an important tool for assessing the quality of a page."
    },
    {
     "id": 1345750,
     "content_html": "Bounce rate",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The bounce rate measures the percentage of times visitors leaves your site after visiting only one page."
    },
    {
     "id": 1345749,
     "content_html": "Cost per click",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cost per click measures what it costs when a visitor clicks on search ad."
    }
   ],
