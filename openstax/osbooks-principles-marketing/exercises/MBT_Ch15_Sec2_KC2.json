 "questions": [
  {
   "id": 677088,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The management of Javier’s Bicycles has an approach where the call center makes appointments and the sales professionals go out to meet with the potential customers and discuss the various products available. This is an example of ________.",
   "answers": [
    {
     "id": 1345603,
     "content_html": "inside order takers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inside order takers rely on customers calling into the company to place an order."
    },
    {
     "id": 1345604,
     "content_html": "team selling",
     "correctness": "1.0",
     "feedback_html": "When several people within the organization are responsible for making the sale, this is considered a team selling approach"
    },
    {
     "id": 1345602,
     "content_html": "technical specialists",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The technical specialist is responsible for knowing how best to use the product and custom fit the product to the needs of the customer."
    },
    {
     "id": 1345601,
     "content_html": "internal marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Internal marketing is how a firm will market to the company&#8217;s employees."
    }
   ],
