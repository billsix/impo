 "questions": [
  {
   "id": 676974,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Saundra went to the grocery store and purchased the same laundry detergent she’s been buying for years, but she noticed that the packaging had been changed and the label indicated that the laundry detergent was “new and improved.” What category of new products would the laundry detergent likely fall under?",
   "answers": [
    {
     "id": 1345147,
     "content_html": "New-to-the-world products",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. New-to-the-world products are inventions that create a new market."
    },
    {
     "id": 1345146,
     "content_html": "New-to-the-firm products",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. New-to-the-firm products aren&#8217;t new to the world, but they are new to the firm. These are often &#8220;me-too&#8221; types of products that are added to a product line."
    },
    {
     "id": 1345145,
     "content_html": "Repositioned products",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Repositioned products are those products that are retargeted for a new use or application."
    },
    {
     "id": 1345148,
     "content_html": "Improvements and revisions to existing products",
     "correctness": "1.0",
     "feedback_html": "The laundry detergent is supposedly a current product made better."
    }
   ],
