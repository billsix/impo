 "questions": [
  {
   "id": 676900,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A company wants to expand into a particular global market, but local firms are better equipped to handle some business processes, such as logistics. Additionally, it is particularly difficult to enter this market. Which of the following would you recommend to the expanding company?",
   "answers": [
    {
     "id": 1344851,
     "content_html": "Franchising",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Franchising is a business strategy in which the owner (the franchisor) allows another person or entity (the franchisee) to operate a business using the franchisor&#8217;s products, branding, and knowledge in exchange for a fee."
    },
    {
     "id": 1344850,
     "content_html": "Exporting",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Exporting involves a firm making a product or service in one country and selling it in others."
    },
    {
     "id": 1344849,
     "content_html": "Licensing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Licensing is a contract in which one organization permits another to use its name brand or trademark on its own items."
    },
    {
     "id": 1344852,
     "content_html": "Joint venture",
     "correctness": "1.0",
     "feedback_html": "A joint venture is a business arrangement whereby two or more companies create a single enterprise or project."
    }
   ],
