 "questions": [
  {
   "id": 677045,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Putting thoughts, ideas, or information together in symbolic form is called ________.",
   "answers": [
    {
     "id": 1345432,
     "content_html": "encoding",
     "correctness": "1.0",
     "feedback_html": "Encoding is the process of taking ideas and information and putting them into symbolic form."
    },
    {
     "id": 1345431,
     "content_html": "noise",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Noise is anything that gets in the way of the receiver getting the message."
    },
    {
     "id": 1345430,
     "content_html": "decoding",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Decoding is the process of transforming the encoded message into understanding by the receiver."
    },
    {
     "id": 1345429,
     "content_html": "sender",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The sender in the communication process is the source of the message."
    }
