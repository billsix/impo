 "questions": [
  {
   "id": 677014,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Marquis has decided to purchase a new kitchen table. He looks at various brands online and decides to purchase one that is $500 more than the others because it is a brand his parents had when he was growing up and they offer free delivery. These factors indicate Marquis has perceived ________ in the higher-priced table.",
   "answers": [
    {
     "id": 1345308,
     "content_html": "value",
     "correctness": "1.0",
     "feedback_html": "Perceived value is perceived benefits less perceived costs."
    },
    {
     "id": 1345307,
     "content_html": "artificial time constraints",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Artificial time constraints are a buyer&#8217;s belief that they must purchase now."
    },
    {
     "id": 1345306,
     "content_html": "costs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although there are perceived costs in Marquis&#8217;s choices, a well-known brand and free delivery are benefits."
    },
    {
     "id": 1345305,
     "content_html": "profit",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Profit is the financial gain of a company."
    }
   ],
   "hints": [],
