 "questions": [
  {
   "id": 676809,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Samantha sees a TV commercial announcing that a mattress she’s been considering is on sale through the holiday weekend and makes plans to visit the store the next day in order to take advantage of the sale. In terms of the buyer’s black box, how would this TV commercial be characterized?",
   "answers": [
    {
     "id": 1344487,
     "content_html": "Product choice",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Samantha has already decided on the product she wants to purchase."
    },
    {
     "id": 1344486,
     "content_html": "Brand choice",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Samantha has already decided on the brand of mattress she wants to purchase."
    },
    {
     "id": 1344485,
     "content_html": "Social stimuli",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social stimuli would involve the opinions of friends and family, your reference groups, and societal roles and status."
    },
    {
     "id": 1344488,
     "content_html": "Purchase timing",
     "correctness": "1.0",
     "feedback_html": "Purchase timing is the outcome of the thinking that takes place in the buyer&#8217;s black box. Samantha is stimulated to buy the mattress during the holiday weekend in order to take advantage of the sale."
    }
   ],
