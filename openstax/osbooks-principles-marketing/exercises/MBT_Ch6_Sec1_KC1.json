 "questions": [
  {
   "id": 676872,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Anaya is collecting information from a variety of sources to make a decision on where to market her new line of designer scarves. Anaya is conducting ________.",
   "answers": [
    {
     "id": 1344739,
     "content_html": "market intelligence",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Market intelligence is the data that would be collected, but it does not include the decision-making process."
    },
    {
     "id": 1344738,
     "content_html": "big data",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Big data is the ever-growing cache of data that is available and is described by the three Vs &#8212; volume, velocity, and variety."
    },
    {
     "id": 1344737,
     "content_html": "management information system",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A management information system is used to collect, analyze, and report interesting findings from internal and external data of the company."
    },
    {
     "id": 1344740,
     "content_html": "marketing research",
     "correctness": "1.0",
     "feedback_html": "Marketing research is the process of collecting information from a variety of sources in order to make a good managerial decision."
    }
   ],
