 "questions": [
  {
   "id": 676811,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The decisions and actions people undertake to buy products or services for personal use are known as ________.",
   "answers": [
    {
     "id": 1344495,
     "content_html": "the consumer market",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The consumer market is comprised of the purchases that you and all other final consumers make."
    },
    {
     "id": 1344494,
     "content_html": "the buyer’s black box",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The buyer&#8217;s black box is a model of consumer buying behavior that suggests that buying behavior is based on stimuli coming from the external environment."
    },
    {
     "id": 1344496,
     "content_html": "consumer buying behavior",
     "correctness": "1.0",
     "feedback_html": "Consumer buying behavior encompasses the actions you take before buying a product or service."
    },
    {
     "id": 1344493,
     "content_html": "complex buying behavior",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Complex buying behavior involves high involvement in the buying process decision and doesn&#8217;t perceive much brand differentiation."
    }
   ],
