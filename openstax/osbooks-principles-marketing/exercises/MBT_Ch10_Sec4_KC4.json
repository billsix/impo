 "questions": [
  {
   "id": 676990,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Your company has added so many features to the new product you’re launching that the price point when it hits the market is going to be significantly higher than originally anticipated. Which factor contributing to the failure of new products is at play here?",
   "answers": [
    {
     "id": 1345211,
     "content_html": "Lack of product differentiation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although this is a factor contributing to the failure of new products, there is a better answer."
    },
    {
     "id": 1345210,
     "content_html": "Prolonged development/delayed market entry",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although this is a factor contributing to the failure of new products, there is a better answer."
    },
    {
     "id": 1345209,
     "content_html": "Targeting the wrong market",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although this is a factor contributing to the failure of new products, there is a better answer."
    },
    {
     "id": 1345212,
     "content_html": "Poor pricing or cost structure",
     "correctness": "1.0",
     "feedback_html": "In an effort to bring &#8220;something new&#8221; to the market, companies often include features that make the product more costly to produce."
    }
   ],
