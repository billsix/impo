 "questions": [
  {
   "id": 676787,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following defines the reason why the business exists?",
   "answers": [
    {
     "id": 1344399,
     "content_html": "Vision statement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The vision statement answers the question, Where do we see the business going?"
    },
    {
     "id": 1344400,
     "content_html": "Mission statement",
     "correctness": "1.0",
     "feedback_html": "The mission statement sums up in a few sentences what the company does, who it serves, and what differentiates it from its competitors."
    },
    {
     "id": 1344398,
     "content_html": "Gap analysis",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A gap analysis is an internal analysis of the company or organization to identify and review its deficiencies."
    },
    {
     "id": 1344397,
     "content_html": "Goals and objectives",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Goals and objectives provide a sense of direction."
    }
   ],
