 "questions": [
  {
   "id": 676869,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Build-A-Bear put a twist on buying cuddly toys by providing consumers with the ability to modify and personalize their toys. What type of positioning strategy did Build-A-Bear use?",
   "answers": [
    {
     "id": 1344727,
     "content_html": "Undifferentiated positioning",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An undifferentiated marketing strategy focuses on an entire market rather than a segment of it."
    },
    {
     "id": 1344728,
     "content_html": "Differentiated positioning",
     "correctness": "1.0",
     "feedback_html": "Differentiated positioning is based on the differentiating characteristics or qualities that make your product/service/brand better than those of your competitors."
    },
    {
     "id": 1344726,
     "content_html": "Head-to-head positioning",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. With head-to-head positioning, you&#8217;re directly competing on similar product attributes in the market."
    },
    {
     "id": 1344725,
     "content_html": "Niche positioning",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. You may be thinking of niche marketing strategy, which focuses on a unique target market."
    }
   ],
