   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The North Face adds a new parka to its line of North Face–branded winter coats. This is an example of a ________.",
   "answers": [
    {
     "id": 1345084,
     "content_html": "line extension",
     "correctness": "1.0",
     "feedback_html": "A line extension retains the product category and brand."
    },
    {
     "id": 1345083,
     "content_html": "brand extension",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A brand extension would involve a new product category under the existing brand name. "
    },
    {
     "id": 1345082,
     "content_html": "multibrand",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Multibranding would involve a new brand name in the same coat category. "
    },
    {
     "id": 1345081,
     "content_html": "new brand",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. New brands would involve a new name and new category. "
    }
