 "questions": [
  {
   "id": 676816,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Attitudes are a composite of a consumer’s beliefs, feelings about, and ________ toward a product or service.",
   "answers": [
    {
     "id": 1344515,
     "content_html": "predispositions",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A predisposition is an inclination in advance to react in a particular way."
    },
    {
     "id": 1344516,
     "content_html": "behavioral intentions",
     "correctness": "1.0",
     "feedback_html": "The behavioral intention aspect of an attitude is what you as a consumer plan to do&#8212;buy the brand or not buy the brand."
    },
    {
     "id": 1344514,
     "content_html": "preconceived notions",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Preconceived notions are opinions formed beforehand without adequate evidence."
    },
    {
     "id": 1344513,
     "content_html": "attributions",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Attributions deal with how individuals perceive the causes of everyday experiences as being either external or internal."
    }
   ],
