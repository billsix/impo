 "questions": [
  {
   "id": 677175,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Of the following, which is the most likely reason for an increase in online shopping?",
   "answers": [
    {
     "id": 1345952,
     "content_html": "A pandemic",
     "correctness": "1.0",
     "feedback_html": "Pandemics, such as the one in COVID-19 pandemic, forced many consumers to stay home. This caused a significant rise in online shopping."
    },
    {
     "id": 1345951,
     "content_html": "The shift from two-income to one-income families",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Since the 1960s, the number of two-income families has risen or remained stable."
    },
    {
     "id": 1345950,
     "content_html": "More people retiring than ever before",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While more baby boomers are retiring, this generation still shops in person when possible."
    },
    {
     "id": 1345949,
     "content_html": "The rise in regional shopping centers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Regional shopping centers have been in decline for several decades."
    }
   ],
   "hints": [],
