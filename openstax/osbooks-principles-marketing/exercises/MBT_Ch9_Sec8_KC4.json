   "stimulus_html": "",
   "stem_html": "Where can discarded packaging be found? ",
   "answers": [
    {
     "id": 1345131,
     "content_html": "Water sources",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Packaging can be found in water sources. It can also be found elsewhere. "
    },
    {
     "id": 1345130,
     "content_html": "Landfills",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Packaging can be found in landfills. It can also be found elsewhere.  "
    },
    {
     "id": 1345129,
     "content_html": "On the ground",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Packaging can be found as litter on the ground. It can also be found elsewhere.  "
    },
    {
     "id": 1345132,
     "content_html": "All of these are correct.",
     "correctness": "1.0",
     "feedback_html": "Discarded packaging can be found in water sources, in landfills, and on the ground."
    }
   ],
