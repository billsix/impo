 "questions": [
  {
   "id": 677142,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "XYZ Appliance is evaluating wholesalers to determine which one would be the right match for its distribution strategy. Which of the following wholesalers would be the best match for XYZ Appliance?",
   "answers": [
    {
     "id": 1345819,
     "content_html": "Wholesaler A is brand new to the large appliance market.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Wholesaler A is too new to the market."
    },
    {
     "id": 1345818,
     "content_html": "Wholesaler B has 20 years of experience in wholesaling food products and is the most expensive.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Wholesaler B operates outside of the large appliance market."
    },
    {
     "id": 1345820,
     "content_html": "Wholesaler C has five years of experience in the large appliance market, has a solid reputation, and is profitable.",
     "correctness": "1.0",
     "feedback_html": "Manufacturers should select channel members based on years of experience, reputation, experience within the market, and profitability. In the scenario above, selecting a channel member based on experience, reputation, and profitability makes the most sense."
    },
    {
     "id": 1345817,
     "content_html": "Wholesaler D has two years of experience in the small appliance market and is the cheapest.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Wholesaler D has less experience than Wholesaler C and isn&#8217;t experienced in the large appliance market."
    }
   ],
