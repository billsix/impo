 "questions": [
  {
   "id": 677146,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ measures the length of time from when a customer places an order to when it reaches them.",
   "answers": [
    {
     "id": 1345835,
     "content_html": "Average delivery days",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Average delivery days is a metric that measures the average number of days it takes shippers to deliver goods to consumers."
    },
    {
     "id": 1345836,
     "content_html": "Time to ship",
     "correctness": "1.0",
     "feedback_html": "Time to ship is a metric that measures the length of time from when a customer places an order to when it reaches them."
    },
    {
     "id": 1345834,
     "content_html": "Inventory turnover rate",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inventory turnover rate measures how quickly inventory is turned over, or sold."
    },
    {
     "id": 1345833,
     "content_html": "Total number of orders",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Total number of orders represents that total number of orders placed at any given time."
    }
   ],
