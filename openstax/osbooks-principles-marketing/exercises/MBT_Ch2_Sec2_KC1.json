 "questions": [
  {
   "id": 676792,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Marcus is preparing a SWOT analysis for the health club he owns. One of the factors he has identified is the fact that the health club is the only facility in the area that offers water aerobics classes. In terms of a SWOT analysis, how would this factor be characterized?",
   "answers": [
    {
     "id": 1344420,
     "content_html": "Strength",
     "correctness": "1.0",
     "feedback_html": "The fact that the health club is the only facility in the area to offer water aerobics classes would be categorized as a strength in terms of a SWOT analysis."
    },
    {
     "id": 1344419,
     "content_html": "Weakness",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A weakness is a factor within the company&#8217;s internal environment that is a hindrance to success."
    },
    {
     "id": 1344418,
     "content_html": "Opportunity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An opportunity is an opening for something positive to happen if you can capitalize on it."
    },
    {
     "id": 1344417,
     "content_html": "Threat",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A threat is an external factor that can negatively impact business."
    }
   ],
   "hints": [],
