 "questions": [
  {
   "id": 677154,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best explains the importance and use of logistics information?",
   "answers": [
    {
     "id": 1345867,
     "content_html": "Companies use logistics information to sell to other companies that target similar consumers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Companies use customer relationship management systems to sell to other companies that target similar customers."
    },
    {
     "id": 1345866,
     "content_html": "Companies use logistics information to market additional products to consumers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Companies use customer relationship management systems to market additional products to consumers."
    },
    {
     "id": 1345868,
     "content_html": "Companies use logistics information to develop demand forecasts, conduct supply planning, and optimize supply chain effectiveness.",
     "correctness": "1.0",
     "feedback_html": "Companies use logistics information to develop demand forecasts and conduct supply planning. It can also be used to analyze and assess the effectiveness and efficiency of the supply chain to ensure optimization."
    },
    {
     "id": 1345865,
     "content_html": "Companies rarely use logistics information to guide decision-making.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Companies rely on logistics information to guide decision-making. It&#8217;s critical to their ability to deliver products to customers effectively and efficiently."
    }
   ],
