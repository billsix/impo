 "questions": [
  {
   "id": 677106,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sally loves to receive her coupons from American Eagle. She typically looks in her email every day to see what promotions the company will be sending. The American Eagle sales promotions are helping to accomplish which important task?",
   "answers": [
    {
     "id": 1345676,
     "content_html": "Increased customer satisfaction",
     "correctness": "1.0",
     "feedback_html": "Sally is happy and satisfied when she gets email and promotions from American Eagle."
    },
    {
     "id": 1345675,
     "content_html": "Providing information",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While the promotion might have information, that is not why Sally enjoys getting the emails."
    },
    {
     "id": 1345674,
     "content_html": "Increasing brand awareness",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sally already has awareness about the brand."
    },
    {
     "id": 1345673,
     "content_html": "Developing junk mail",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sally does not consider the emails from American Eagle as junk mail."
    }
   ],
