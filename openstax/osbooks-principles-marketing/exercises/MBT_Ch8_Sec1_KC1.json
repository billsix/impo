  {
   "id": 676907,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Choosing between standardization and adaption strategies includes ________.",
   "answers": [
    {
     "id": 1344880,
     "content_html": "balancing internal capabilities, like operations, with external forces, like competition",
     "correctness": "1.0",
     "feedback_html": "Choosing between standardization and adaptation strategies includes balancing internal capabilities like operations, sales, and customer service with external forces like competition and consumer demographic changes."
    },
    {
     "id": 1344879,
     "content_html": "assessing only external forces, like technology, and consumer demographic changes",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Assessing external forces is only half of the requirement."
    },
    {
     "id": 1344878,
     "content_html": "adjusting only a company’s resources, assets, and conditions to the market",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Adjusting a company&#8217;s resources, assets, and conditions is only half of the requirement."
    },
    {
     "id": 1344877,
     "content_html": "assessing and reducing the company’s consumer base to be more effective",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Assessing and reducing the company&#8217;s consumer base are not related to standardization or adaptation strategies."
    }
   ],
