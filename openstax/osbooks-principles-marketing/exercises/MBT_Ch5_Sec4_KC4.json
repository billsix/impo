 "questions": [
  {
   "id": 676860,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Idris has been researching a potential market segment for his company’s new product. He is concerned that, although the product holds considerable promise, the advertising campaign would be beyond the company’s budget. Which essential factor of market segmentation appears to be lacking in Idris’s analysis?",
   "answers": [
    {
     "id": 1344691,
     "content_html": "Differentiable",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Differentiability means that the market should be internally homogenous but externally heterogeneous so that marketing actions can be applied to them without overlap."
    },
    {
     "id": 1344690,
     "content_html": "Substantial",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A substantial market segment means that there are sufficient potential consumers in the segment that justify spending resources to market the product or service."
    },
    {
     "id": 1344689,
     "content_html": "Measurable",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A measurable market segment means that you can accurately determine the size of the market segment in terms of either sales volume or number of customers."
    },
    {
     "id": 1344692,
     "content_html": "Accessible",
     "correctness": "1.0",
     "feedback_html": "Accessibility refers to the ability to reach customers in the chosen segment at an affordable cost, given the strengths and abilities of your marketing department."
    }
   ],
