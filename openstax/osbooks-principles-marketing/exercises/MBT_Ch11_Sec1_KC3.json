 "questions": [
  {
   "id": 676999,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You go to the spa to get a massage, but your regular massage therapist is off for the day. The massage therapist to whom you’re assigned does an adequate job, but they don’t have the same technique as your regular massage therapist. What characteristic of service does this example illustrate?",
   "answers": [
    {
     "id": 1345247,
     "content_html": "Service inseparability",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Service inseparability means that the production and consumption of a service (in this case, a massage) cannot be separated from the provider of that service."
    },
    {
     "id": 1345246,
     "content_html": "Service perishability",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The concept of service perishability states that services cannot be stored in inventory for future use or sale."
    },
    {
     "id": 1345248,
     "content_html": "Service variability",
     "correctness": "1.0",
     "feedback_html": "Service variability may be defined as the changes in the quality of the same service provided by different service providers."
    },
    {
     "id": 1345245,
     "content_html": "Service intangibility",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Service intangibility refers to the fact that you can&#8217;t see or touch a service before it is performed."
    }
   ],
   "hints": [],
