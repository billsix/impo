 "questions": [
  {
   "id": 677098,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Part of Malika’s job with H2O Pool Supplies is to identify potential new customers. She is required to spend 20% of her time working to bring in new customers. What type of objective is Malika working toward?",
   "answers": [
    {
     "id": 1345643,
     "content_html": "Serving existing customers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. If Malika were focused on serving existing customers, she would not be working to find new customers."
    },
    {
     "id": 1345642,
     "content_html": "Increasing profits",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. If Malika were focusing on increasing profits, it is less expensive to work with current customers than to get new customers."
    },
    {
     "id": 1345641,
     "content_html": "Enhancing customer satisfaction",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A focus on customer satisfaction would be with existing customers."
    },
    {
     "id": 1345644,
     "content_html": "Developing new customers",
     "correctness": "1.0",
     "feedback_html": "Malika is focused on bringing in new customers."
    }
   ],
   "hints": [],
