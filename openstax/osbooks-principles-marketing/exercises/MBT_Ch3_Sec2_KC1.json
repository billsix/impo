 "questions": [
  {
   "id": 676812,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You’re at the shopping mall looking for a new pair of shoes when you smell the wonderful aroma of freshly baked pretzels. Before you know it, you’ve bought a giant pretzel with cheese sauce. What type of factors influenced your purchase?",
   "answers": [
    {
     "id": 1344499,
     "content_html": "Psychological factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Psychological factors encompass such things as perception, beliefs, attitudes, motivation, and learning."
    },
    {
     "id": 1344498,
     "content_html": "Social factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social factors encompass such elements as family, reference groups, and societal roles and status."
    },
    {
     "id": 1344500,
     "content_html": "Situational factors",
     "correctness": "1.0",
     "feedback_html": "Situational factors influencing consumers are external factors that affect how consumers encounter and interact with a product, forming their opinions at that moment in time. Environmental factors such as aroma, lighting, music, and noise can either encourage or discourage the purchase of a product."
    },
    {
     "id": 1344497,
     "content_html": "Personal factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal factors encompass such elements as occupation, age and life stage, your economic situation, lifestyle, personality, and self-concept."
    }
   ],
