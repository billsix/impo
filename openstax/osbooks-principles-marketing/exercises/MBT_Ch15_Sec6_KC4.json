 "questions": [
  {
   "id": 677110,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an example of a trade promotion?",
   "answers": [
    {
     "id": 1345692,
     "content_html": "Allowances and discounts",
     "correctness": "1.0",
     "feedback_html": "Allowances and discounts are typically provided to the trade and used to push the product to the customer."
    },
    {
     "id": 1345691,
     "content_html": "Coupons",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Coupons provide a saving off of the purchase of a specific product and are typically consumer oriented."
    },
    {
     "id": 1345690,
     "content_html": "Loyalty programs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Loyalty programs are consumer oriented and focused on building repeat purchases."
    },
    {
     "id": 1345689,
     "content_html": "Premiums",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Premiums are items offered free or at a minimum cost alongside the purchase of a product."
    }
   ],
