 "questions": [
  {
   "id": 677131,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As intermediaries move products and services from manufacturers to consumers, what key services do they offer?",
   "answers": [
    {
     "id": 1345775,
     "content_html": "Pricing and promoting across geographical areas",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While pricing and promotion across geographical areas is an important overall function of marketing, it does not reflect one of the key services covered in the chapter."
    },
    {
     "id": 1345774,
     "content_html": "Surveying customers to ensure they are satisfied with their product or service experience",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While surveying customers is important to assessing satisfaction, it does not reflect one of the key services covered in the chapter."
    },
    {
     "id": 1345773,
     "content_html": "Competing with one another to reduce prices for consumers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Competition does not reflect one of the key services covered in the chapter."
    },
    {
     "id": 1345776,
     "content_html": "Accumulating, bulk-breaking, adjusting for assortment discrepancies, and providing financing",
     "correctness": "1.0",
     "feedback_html": "Accumulating, bulk-breaking, adjusting for assortment discrepancies, and providing financing are the valuable services that intermediaries provide."
    }
   ],
