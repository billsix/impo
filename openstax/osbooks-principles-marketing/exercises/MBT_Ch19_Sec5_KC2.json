 "questions": [
  {
   "id": 677196,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a best practice of purpose-driven brands?",
   "answers": [
    {
     "id": 1346036,
     "content_html": "Standing up for what’s right",
     "correctness": "1.0",
     "feedback_html": "Purpose-driven brands stand up for what is right."
    },
    {
     "id": 1346035,
     "content_html": "Good advertising",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising may be a way to share organizational purpose, but it is not a best practice of purpose."
    },
    {
     "id": 1346034,
     "content_html": "Telling everyone about their purpose",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Being transparent about purpose allows people to know about a company&#8217;s purpose, but that is not a best practice in and of itself."
    },
    {
     "id": 1346033,
     "content_html": "Being profitable",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. For-profit organizations have an obligation to its shareholders to be profitable. However, this is not a key component of purpose-driven brands."
    }
   ],
