 "questions": [
  {
   "id": 676880,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following would be a good source of competitive intelligence?",
   "answers": [
    {
     "id": 1344771,
     "content_html": "Experiments",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Experiments are a way to collect data externally, but they are not a good source of competitive intelligence."
    },
    {
     "id": 1344770,
     "content_html": "Product sales of a company’s products",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A company&#8217;s own product sales would be internal data and therefore not part of competitive intelligence."
    },
    {
     "id": 1344769,
     "content_html": "Consumer responses to a poll on a company’s new products",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Consumer responses to a poll on potential new products would be interesting but would not be considered competitive intelligence."
    },
    {
     "id": 1344772,
     "content_html": "Competitor’s website",
     "correctness": "1.0",
     "feedback_html": "A competitor&#8217;s website is an opportunity to learn more about the company and its resources, products, promotional plans, and pricing."
    }
   ],
