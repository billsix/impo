 "questions": [
  {
   "id": 676929,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a useful step to improve a marketer’s ability to reach a generational target audience?",
   "answers": [
    {
     "id": 1344967,
     "content_html": "Use deeper and more extensive combinations of sociodemographic variables.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Using deeper and more extensive combinations of sociodemographic variables is only part of the way to reach a generational target audience."
    },
    {
     "id": 1344966,
     "content_html": "Add variables such as income, education, or social markers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Using variables such as income, education, or other social markers is only part of the way to reach a generational target audience."
    },
    {
     "id": 1344965,
     "content_html": "Use focus groups to provide direct input and deeper insights and ideas.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Using focus groups is only part of the way to reach a generational target audience."
    },
    {
     "id": 1344968,
     "content_html": "All of these are useful steps.",
     "correctness": "1.0",
     "feedback_html": "All of these are important steps to consider to be more successful in advertising to consumers based on their generations."
    }
   ],
