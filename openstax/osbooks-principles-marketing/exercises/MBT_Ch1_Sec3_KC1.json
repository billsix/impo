 "questions": [
  {
   "id": 676767,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The extent to which the supply chain adds value to our marketing strategy is best addressed by our evaluation of which of the 5Ms?",
   "answers": [
    {
     "id": 1344320,
     "content_html": "Materials",
     "correctness": "1.0",
     "feedback_html": "Materials considers the availability of the resources needed for product. It is the element that looks at the supply."
    },
    {
     "id": 1344319,
     "content_html": "Money",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Money is concerned with cash flow, money management, and adherence to a budget."
    },
    {
     "id": 1344318,
     "content_html": "Machinery",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Machinery is concerned with the equipment and physical assets needed for production."
    },
    {
     "id": 1344317,
     "content_html": "Minutes",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Minutes is concerned with time management and scheduling concerns."
    }
   ],
