 "questions": [
  {
   "id": 676952,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a benefit of a brand?",
   "answers": [
    {
     "id": 1345059,
     "content_html": "Consumers always choose name brands.",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. While consumers often prefer name brands, it is not always the case. "
    },
    {
     "id": 1345060,
     "content_html": "Brands can command higher prices.",
     "correctness": "1.0",
     "feedback_html": "Brands often evoke positive feelings that allow a company to charge more for its product or service. "
    },
    {
     "id": 1345058,
     "content_html": "Shareholders demand strong brands.",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. While shareholders may recognize the financial benefits of branding, shareholders are not a benefit of strong brands. "
    },
    {
     "id": 1345057,
     "content_html": "Every company must have a brand.",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. While companies have products and services, they can be privately branded or generic. "
    }
   ],
