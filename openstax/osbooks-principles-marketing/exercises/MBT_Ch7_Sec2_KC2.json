   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Generally speaking, when a country’s political stability improves, so does its ________.",
   "answers": [
    {
     "id": 1344823,
     "content_html": "international business",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. International business is the exchange of goods and services between nations."
    },
    {
     "id": 1344822,
     "content_html": "purchasing power",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Purchasing power refers to the number of goods one unit of currency can purchase."
    },
    {
     "id": 1344824,
     "content_html": "economy",
     "correctness": "1.0",
     "feedback_html": "As stability increases in a country, the economy often improves."
    },
    {
     "id": 1344821,
     "content_html": "consumer income",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Consumer income is the amount of money a household or individual earns."
    }
