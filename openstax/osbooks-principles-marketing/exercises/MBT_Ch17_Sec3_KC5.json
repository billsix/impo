 "questions": [
  {
   "id": 677141,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which overarching factor involves analyzing the revenues and costs associated with a channel?",
   "answers": [
    {
     "id": 1345815,
     "content_html": "Unit value",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Unit value relates to the value of one unit of a product."
    },
    {
     "id": 1345814,
     "content_html": "Fixed costs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Fixed costs are costs that do not change month over month."
    },
    {
     "id": 1345813,
     "content_html": "Variable costs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Variable costs are costs that change as production changes."
    },
    {
     "id": 1345816,
     "content_html": "Profitability",
     "correctness": "1.0",
     "feedback_html": "Profitability is a factor that companies consider when choosing a distribution channel. Companies are attracted to channels that help them maximize profits and operate more efficiently."
    }
   ],
