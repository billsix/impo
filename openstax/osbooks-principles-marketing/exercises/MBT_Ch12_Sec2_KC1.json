 "questions": [
  {
   "id": 677017,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the critical Cs of pricing includes taking into the consideration the value of the product to retailers and suppliers?",
   "answers": [
    {
     "id": 1345319,
     "content_html": "Cost",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cost refers to the financial resources producing a product will entail."
    },
    {
     "id": 1345318,
     "content_html": "Competition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Competition refers to how buyers see a product&#8217;s price in comparison with the competition."
    },
    {
     "id": 1345320,
     "content_html": "Channels of distribution",
     "correctness": "1.0",
     "feedback_html": "Channels of distribution include the importance of understanding the value of a product through the lens of suppliers and retailers."
    },
    {
     "id": 1345317,
     "content_html": "Customers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The customer dimension of the critical Cs of pricing refers to the value that buyers will receive from an exchange process."
    }
   ],
