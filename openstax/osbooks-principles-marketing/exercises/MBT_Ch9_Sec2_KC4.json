 "questions": [
  {
   "id": 676940,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Product line depth refers to ________.",
   "answers": [
    {
     "id": 1345011,
     "content_html": "product characteristics",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Product characteristics are the physical features of the product. "
    },
    {
     "id": 1345010,
     "content_html": "the number of product lines",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. The number of product lines is the product line mix. "
    },
    {
     "id": 1345009,
     "content_html": "product assortment",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. The product assortment is the type of products in a product line. "
    },
    {
     "id": 1345012,
     "content_html": "the number of products in the product line",
     "correctness": "1.0",
     "feedback_html": "Product line depth refers to the number of products in a product line. Products must be similar or complementary to be part of the same product line."
    }
   ],
