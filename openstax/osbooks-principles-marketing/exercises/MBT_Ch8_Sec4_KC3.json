 "questions": [
  {
   "id": 676924,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Acculturation is the process by which a person’s family cultural patterns change because of direct and constant contact with ________.",
   "answers": [
    {
     "id": 1344947,
     "content_html": "their home culture",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Acculturation indicates a movement or transitional state. Staying within one&#8217;s home or birth culture is reinforcing a stable state."
    },
    {
     "id": 1344948,
     "content_html": "a different culture",
     "correctness": "1.0",
     "feedback_html": "Acculturation is the process by which a person&#8217;s family cultural patterns change because of direct and constant contact with a different culture."
    },
    {
     "id": 1344946,
     "content_html": "many cultures simultaneously",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Acculturation requires the adoption of cultural traits. Exposure to other cultures is good but does not address adoption of traits."
    },
    {
     "id": 1344945,
     "content_html": "a high degree of global travel",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Acculturation requires the adoption of cultural traits. Exposure to other cultures through travel is good but does not address adoption of traits."
    }
   ],
