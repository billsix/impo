  {
   "id": 676925,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When it comes to cultural identity, which of the following do the overwhelming majority of Black people believe is a major contributor and attribute?",
   "answers": [
    {
     "id": 1344951,
     "content_html": "Cultural duality and relationships",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An overwhelming majority of Black people believe that factors other than cultural duality and relationships are a major part of the Black identity."
    },
    {
     "id": 1344950,
     "content_html": "Education and income level",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An overwhelming majority of Black people believe that factors other than education and income level are a major part of the Black identity."
    },
    {
     "id": 1344949,
     "content_html": "Immigration status and conventionality",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An overwhelming majority of Black people believe that factors other than immigration status and conventionality are a major part of the Black identity."
    },
    {
     "id": 1344952,
     "content_html": "Race and community",
     "correctness": "1.0",
     "feedback_html": "An overwhelming majority of Black people believe that race and community engagement are a major part of the Black identity."
    }
   ],
