 "questions": [
  {
   "id": 676969,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a trend in sustainable packaging? ",
   "answers": [
    {
     "id": 1345127,
     "content_html": "Increasing the amount of packaging",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Companies are trying to reduce packaging, not increase it. "
    },
    {
     "id": 1345126,
     "content_html": "Using boxes",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. While companies may use boxes, this is not a trend in sustainable packaging. "
    },
    {
     "id": 1345128,
     "content_html": "Using only necessary resources",
     "correctness": "1.0",
     "feedback_html": "Companies are trying to reduce packaging to only the necessary parts in their sustainability efforts."
    },
    {
     "id": 1345125,
     "content_html": "Using plastic",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Plastic is harmful to the environment. "
    }
   ],
