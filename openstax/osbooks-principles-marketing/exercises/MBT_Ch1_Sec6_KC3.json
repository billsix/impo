 "questions": [
  {
   "id": 676784,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An ongoing positive relationship between a customer and a business is known as ________.",
   "answers": [
    {
     "id": 1344387,
     "content_html": "customer equity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer equity is the potential profit a company earns from all of its customers, both current and potential."
    },
    {
     "id": 1344388,
     "content_html": "customer loyalty",
     "correctness": "1.0",
     "feedback_html": "Customer loyalty is a customer&#8217;s willingness to repeatedly return to a company to conduct business."
    },
    {
     "id": 1344386,
     "content_html": "customer retention",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer retention is a company&#8217;s ability to transform new customers into returning customers."
    },
    {
     "id": 1344385,
     "content_html": "customer lifetime value (CLV)",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer lifetime value (CLV) is a measure of how much a business can plan to earn from a typical customer for as long as they remain a customer."
    }
   ],
