 "questions": [
  {
   "id": 677119,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a characteristic of a good mobile strategy?",
   "answers": [
    {
     "id": 1345728,
     "content_html": "Mobile websites should have a responsive design so visitors have a good user experience.",
     "correctness": "1.0",
     "feedback_html": "An important element of a good mobile strategy is ensuring that your website has a responsive design. Simply put, this means ensuring that menus and content are easy to read and that the user has a good experience on the site regardless of the device."
    },
    {
     "id": 1345727,
     "content_html": "Emails should be sent to consumers on a weekly basis in order to stay engaged with mobile users.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Email frequency depends on the company and its marketing goals."
    },
    {
     "id": 1345726,
     "content_html": "Avoid using push notification features to avoid overcommunicating with your users.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Push notifications are a great way to stay connected with users when they aren&#8217;t using the app."
    },
    {
     "id": 1345725,
     "content_html": "Measure whether or not a mobile device user has seen a push notification.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Unfortunately, marketers aren&#8217;t able to determine whether someone has seen a push notification on their device. Therefore, this does not qualify as a characteristic of a good mobile strategy. Push notifications are a great way to stay connected with users when they aren&#8217;t using the app."
    }
   ],
