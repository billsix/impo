 "questions": [
  {
   "id": 676996,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which group of consumers tends to be unwilling to take a chance on a new product or innovation until the majority of consumers has already adopted the product?",
   "answers": [
    {
     "id": 1345235,
     "content_html": "Innovators",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Innovators usually buy new products as soon as they hit the market."
    },
    {
     "id": 1345234,
     "content_html": "Early majority",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Consumers in the early adopter category typically purchase the new product fairly early after its introduction in the market but not as quickly as innovators."
    },
    {
     "id": 1345233,
     "content_html": "Laggards",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Laggards are skeptical of new ideas, and by the time they adopt an innovation, there is likely a new one beginning to emerge in the market."
    },
    {
     "id": 1345236,
     "content_html": "Late majority",
     "correctness": "1.0",
     "feedback_html": "Consumers in the late majority category are typically slow to catch on to the popularity of new products or services."
    }
   ],
