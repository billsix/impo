 "questions": [
  {
   "id": 676933,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jorge visited his favorite retailer to find that the store had transformed into a space with product demonstrations, product trials, and technology, which improved his overall perception of the brand. This is called a(n) ________",
   "answers": [
    {
     "id": 1344983,
     "content_html": "product",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A product is a tangible good."
    },
    {
     "id": 1344982,
     "content_html": "service",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A service is an intangible situation."
    },
    {
     "id": 1344984,
     "content_html": "experience",
     "correctness": "1.0",
     "feedback_html": "An experience combines marketing, technology, and service to alter the consumer's perception."
    },
    {
     "id": 1344981,
     "content_html": "advertisement",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Advertising is a type of promotion."
    }
   ],
