   "id": 676878,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Xin wants to determine the best price for a new product. What source of data would be the most appropriate to use?",
   "answers": [
    {
     "id": 1344764,
     "content_html": "Price of a competitor’s products",
     "correctness": "1.0",
     "feedback_html": "Of the available answers, pricing of the competition would be a good source of information to have before setting Xin&#8217;s price."
    },
    {
     "id": 1344763,
     "content_html": "Inventory expenses",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inventory expenses are internal data and would not be a good information source for pricing."
    },
    {
     "id": 1344762,
     "content_html": "Journal articles",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Journal articles are valuable but would not be a good information source for pricing."
    },
    {
     "id": 1344761,
     "content_html": "Online news site",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Online news sites are valuable but would not be a good information source for pricing."
    }
