   "id": 677174,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Software-based systems that allow for secure transactions by storing passwords and payment information are known as ________.",
   "answers": [
    {
     "id": 1345947,
     "content_html": "e-commerce",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. E-commerce is the ability of a consumer to browse and order products online."
    },
    {
     "id": 1345946,
     "content_html": "online stores in offline spaces",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Online stores in offline spaces refers to the ability of a consumer to purchase products online and pick up in person."
    },
    {
     "id": 1345945,
     "content_html": "social commerce",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social commerce is a blend of e-commerce and social media, where retailers often use influencers to market products."
    },
    {
     "id": 1345948,
     "content_html": "digital wallets",
     "correctness": "1.0",
     "feedback_html": "Digital wallets store consumers&#8217; passwords and payment information for safety and ease of ordering online."
    }
   ],
