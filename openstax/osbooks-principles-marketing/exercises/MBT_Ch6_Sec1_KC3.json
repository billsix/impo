 "questions": [
  {
   "id": 676874,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ryan and Christie are uploading their recent pictures to Instagram, tagging the photographer and the venue. What is this content adding to?",
   "answers": [
    {
     "id": 1344747,
     "content_html": "Market intelligence",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Market intelligence is the data that would be collected, but does not include the decision-making process."
    },
    {
     "id": 1344748,
     "content_html": "Big data",
     "correctness": "1.0",
     "feedback_html": "Individuals uploading personal data into social media is part of the volume, velocity, and variety of data that makes up big data."
    },
    {
     "id": 1344746,
     "content_html": "Management information system",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A management information system is used to collect, analyze, and report interesting findings from internal and external data of the company."
    },
    {
     "id": 1344745,
     "content_html": "Marketing research",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Information uploaded by users does not automatically become part of marketing research."
    }
   ],
