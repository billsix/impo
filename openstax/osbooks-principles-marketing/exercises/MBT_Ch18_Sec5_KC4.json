 "questions": [
  {
   "id": 677180,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which type of wholesaler utilizes independent contractors as liaisons between manufacturers and retailers?",
   "answers": [
    {
     "id": 1345972,
     "content_html": "Manufacturer’s agents",
     "correctness": "1.0",
     "feedback_html": "Manufacturer&#8217;s agents are independent contractors who act as salespersons for multiple manufacturers to sell similar (but not competing) products to retailers."
    },
    {
     "id": 1345971,
     "content_html": "Rack jobbers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Rack jobbers display and merchandise products in stores and are considered limited-line wholesalers."
    },
    {
     "id": 1345970,
     "content_html": "Truck jobbers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Truck jobbers carry product on trucks and sell directly from there."
    },
    {
     "id": 1345969,
     "content_html": "Full-line wholesalers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Full-line wholesalers offer the most services to retailers."
    }
   ],
