 "questions": [
  {
   "id": 676931,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is an emerging sociodemographic trend that will impact future marketing?",
   "answers": [
    {
     "id": 1344975,
     "content_html": "Rapid population growth in the United States",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The current projection supports an opposite trend that the population will stagnate."
    },
    {
     "id": 1344976,
     "content_html": "Consumer spending dominated by baby boomers",
     "correctness": "1.0",
     "feedback_html": "It is projected that consumer spending will continued to be dominated by baby boomers. While this isn&#8217;t a new trend, it is certainly a trend that will continue through the 2030s as this generation ages out."
    },
    {
     "id": 1344974,
     "content_html": "Redistribution of economic wealth",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The redistribution of economic wealth is not a trend."
    },
    {
     "id": 1344973,
     "content_html": "Hemispherical global migration caused by global warming",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. There are no current projections that support significant global migrations of people caused by global warming."
    }
   ],
