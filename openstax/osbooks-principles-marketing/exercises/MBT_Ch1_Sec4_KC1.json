   "stimulus_html": "",
   "stem_html": "The product concept focuses on ________.",
   "answers": [
    {
     "id": 1344340,
     "content_html": "the quality of the product a company intends to sell",
     "correctness": "1.0",
     "feedback_html": "The product concept is concerned most with the quality of the product a company intends to sell."
    },
    {
     "id": 1344339,
     "content_html": "the operations of manufacturing the product a company intends to sell",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The production concept is concerned with the operations of manufacturing the product a company intends to sell."
    },
    {
     "id": 1344338,
     "content_html": "the selling strategies a company will use to sell the product",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The selling concept is concerned with the selling strategies a company will use to sell the product."
    },
    {
     "id": 1344337,
     "content_html": "the needs of the customer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The marketing concept is concerned with meeting the needs of the customer."
    }
