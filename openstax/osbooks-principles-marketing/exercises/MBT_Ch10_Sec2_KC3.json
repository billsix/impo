 "questions": [
  {
   "id": 676979,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "At what stage in the new product development process would you launch the product, complete with full-scale production, distribution, advertising, and sales promotion?",
   "answers": [
    {
     "id": 1345167,
     "content_html": "Test-marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Test-marketing aims to explore consumer response to a product or service by making it available on a limited basis."
    },
    {
     "id": 1345166,
     "content_html": "Product development",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In the product development phase, R&#38;D develops one or more physical versions of the product concept, called prototypes."
    },
    {
     "id": 1345165,
     "content_html": "Business analysis",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Business analysis helps marketers determine the costs involved in the proposed new product development, as well as forecast the profits to be made in future years."
    },
    {
     "id": 1345168,
     "content_html": "Commercialization",
     "correctness": "1.0",
     "feedback_html": "Commercialization is where the &#8220;rubber hits the road&#8221; and the company introduces the product to the market on a full-scale basis, involving production, marketing, distribution, and customer support."
    }
   ],
   "hints": [],
   "formats": [
