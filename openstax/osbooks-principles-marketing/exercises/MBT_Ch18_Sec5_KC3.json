 "questions": [
  {
   "id": 677179,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The type of wholesaler that offers the most complete range of services is known as a ________.",
   "answers": [
    {
     "id": 1345967,
     "content_html": "rack jobber",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Rack jobbers display and merchandise products in stores but are considered limited-line wholesalers."
    },
    {
     "id": 1345966,
     "content_html": "cash-and-carry wholesaler",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cash-and-carry wholesalers offer limited products, usually with no delivery, for cash payments."
    },
    {
     "id": 1345965,
     "content_html": "limited-service wholesaler",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Limited-service wholesalers offer limited services to retailers."
    },
    {
     "id": 1345968,
     "content_html": "general-merchandise wholesaler",
     "correctness": "1.0",
     "feedback_html": "General-merchandise wholesalers offer the most complete range of services."
    }
   ],
