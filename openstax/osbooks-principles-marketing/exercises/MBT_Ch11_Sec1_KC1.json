 "questions": [
  {
   "id": 676997,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You purchased an airline ticket to go on vacation, but on the way to the airport, you get a flat tire and miss your flight. Which characteristic of service does this example illustrate?",
   "answers": [
    {
     "id": 1345239,
     "content_html": "Service variability",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Service variability may be defined as the changes in the quality of the same service provided by different service providers."
    },
    {
     "id": 1345238,
     "content_html": "Service inseparability",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Service inseparability means that the production and consumption of a service cannot be separated from the provider of that service."
    },
    {
     "id": 1345240,
     "content_html": "Service perishability",
     "correctness": "1.0",
     "feedback_html": "The concept of service perishability states that services (such as airline tickets) cannot be stored in inventory for future use or sale."
    },
    {
     "id": 1345237,
     "content_html": "Service intangibility",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Service intangibility refers to the fact that you can&#8217;t see or touch a service before it is performed."
    }
   ],
