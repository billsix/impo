   "stimulus_html": "",
   "stem_html": "Daved is a marketer looking to see how successful his new marketing campaign was. Which of the following would you suggest to Daved?",
   "answers": [
    {
     "id": 1345500,
     "content_html": "Posttest",
     "correctness": "1.0",
     "feedback_html": "Posttests are utilized after a campaign has launched."
    },
    {
     "id": 1345499,
     "content_html": "Pretest",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Pretests are utilized before a campaign has launched full-scale."
    },
    {
