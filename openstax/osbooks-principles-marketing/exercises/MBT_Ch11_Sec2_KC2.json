 "questions": [
  {
   "id": 677003,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The extent to which employees are happy or content with their work environment is known as which of the following in the service-profit chain model?",
   "answers": [
    {
     "id": 1345264,
     "content_html": "Employee satisfaction",
     "correctness": "1.0",
     "feedback_html": "Employee satisfaction is the extent to which employees are happy and/or content with their jobs and work environment."
    },
    {
     "id": 1345263,
     "content_html": "Internal service quality",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Internal service quality is defined as the quality of the services frontline employees receive from the rest of the organization."
    },
    {
     "id": 1345262,
     "content_html": "External value proposition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. External value proposition is the promise of value that a customer can expect a business to deliver."
    },
    {
     "id": 1345261,
     "content_html": "Customer loyalty",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer loyalty means that the customer deliberately chooses to do repeat business with the company."
    }
   ],
