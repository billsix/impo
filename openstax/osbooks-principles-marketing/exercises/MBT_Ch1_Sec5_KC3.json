   "id": 676779,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following terms refers to the promised value of a product or service?",
   "answers": [
    {
     "id": 1344367,
     "content_html": "Valuation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Valuation is the process of estimating an item&#8217;s worth."
    },
    {
     "id": 1344366,
     "content_html": "Value proposal",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Value proposal is not a marketing term."
    },
    {
     "id": 1344365,
     "content_html": "Value assessment",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Value assessment is not a marketing term."
    },
    {
     "id": 1344368,
     "content_html": "Value proposition",
     "correctness": "1.0",
     "feedback_html": "The value that a product promises to deliver is called the value proposition."
    }
