 "questions": [
  {
   "id": 676807,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You’re considering buying a widescreen TV. You’ve researched different features, looked up and reviewed models on the Internet, and even asked a few friends for their recommendations. What type of buying behavior are you exhibiting?",
   "answers": [
    {
     "id": 1344479,
     "content_html": "Dissonance-reducing buying behavior",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Dissonance-reducing buying behavior occurs when you&#8217;re highly involved in the purchase but see little difference among brands."
    },
    {
     "id": 1344478,
     "content_html": "Variety-seeking buying behavior",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Variety-seeking buying behavior has low involvement in the purchase."
    },
    {
     "id": 1344480,
     "content_html": "Complex buying behavior",
     "correctness": "1.0",
     "feedback_html": "Complex buying behavior involves high involvement in the buying decision and the perception of significant differences between brands."
    },
    {
     "id": 1344477,
     "content_html": "Habitual buying behavior",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Habitual buying behavior has low involvement in the purchase decision, and you don&#8217;t perceive much brand differentiation."
    }
   ],
