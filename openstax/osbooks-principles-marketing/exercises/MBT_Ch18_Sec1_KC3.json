 "questions": [
  {
   "id": 677159,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a new entrepreneur, you are deciding whether to offer your customers a loyalty card that is linked digitally to technology. Which function of retailing would you be engaged in?",
   "answers": [
    {
     "id": 1345887,
     "content_html": "Providing services to consumers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Loyalty cards are not considered a service to consumers."
    },
    {
     "id": 1345886,
     "content_html": "Holding inventory",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inventory is the merchandise a business holds until ready for sale."
    },
    {
     "id": 1345885,
     "content_html": "Providing convenient location and hours of operation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Providing a convenient location and hours of operation are not considered communication."
    },
    {
     "id": 1345888,
     "content_html": "Providing consumer communication",
     "correctness": "1.0",
     "feedback_html": "Loyalty cards are one way retailers can communicate with consumers."
    }
   ],
