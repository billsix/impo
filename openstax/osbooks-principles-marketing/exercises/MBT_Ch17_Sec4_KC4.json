  {
   "id": 677145,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a key metric that assesses the percentage of orders that are processed, fulfilled, and shipped to consumers without any errors?",
   "answers": [
    {
     "id": 1345832,
     "content_html": "Order accuracy rate",
     "correctness": "1.0",
     "feedback_html": "Order accuracy rate is the percentage of orders that are processed, fulfilled, and shipped to consumers without any errors."
    },
    {
     "id": 1345831,
     "content_html": "Inventory turnover rate",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inventory turnover rate measures how quickly inventory is turned over, or sold."
    },
    {
     "id": 1345830,
     "content_html": "Total number of orders",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Total number of orders represents the total number of orders placed at any given time."
    },
    {
     "id": 1345829,
     "content_html": "Average delivery days",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Average delivery days is a metric that measures the average number of days it takes shippers to deliver goods to consumers."
    }
   ],
