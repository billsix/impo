 "questions": [
  {
   "id": 676829,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Alejandro, the owner of a Mexican restaurant, decides to revise the restaurant’s menu. He intends to use the same printing company but has to make several changes in the menu. What type of buying situation does this best illustrate?",
   "answers": [
    {
     "id": 1344567,
     "content_html": "Systems selling",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Systems selling involves selling a single, complete solution to a need or problem rather than purchasing several component parts."
    },
    {
     "id": 1344566,
     "content_html": "Straight rebuy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A straight rebuy is making a routine purchase of a standard product or products with no modifications from a familiar supplier."
    },
    {
     "id": 1344568,
     "content_html": "Modified rebuy",
     "correctness": "1.0",
     "feedback_html": "In a modified rebuy, the purchaser is buying goods that have been purchased previously but changes either the supplier or certain elements of the previous order."
    },
    {
     "id": 1344565,
     "content_html": "New-task buy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In a new-task buy, the customer has no previous experience with the purchase."
    }
   ],
