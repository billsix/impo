 "questions": [
  {
   "id": 677165,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Retailers providing high-quality goods at discounted prices are called ________",
   "answers": [
    {
     "id": 1345911,
     "content_html": "superstores",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Superstores are large retailers that have characteristics of both supermarkets and department stores."
    },
    {
     "id": 1345910,
     "content_html": "discount stores",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Discount stores are retailers that sells a broad range of products at lower prices than competitors and focus on price over quality."
    },
    {
     "id": 1345912,
     "content_html": "off-price retailers",
     "correctness": "1.0",
     "feedback_html": "Off-price retailers are those providing high-quality goods at discounted prices."
    },
    {
     "id": 1345909,
     "content_html": "warehouse clubs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Warehouse clubs offer consumers bulk items at discounted prices, but require a membership."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
