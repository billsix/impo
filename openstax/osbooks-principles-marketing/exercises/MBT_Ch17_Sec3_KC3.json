 "questions": [
  {
   "id": 677139,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Total Appliance offers buyers installation services for refrigerators, dishwashers, washers, and dryers for $50. In addition, it also offers buyers a free annual tune-up of any major appliance purchased through its retail outlet. Which buyer requirement does Total Appliance fulfill?",
   "answers": [
    {
     "id": 1345807,
     "content_html": "Variety",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Variety relates to the different competing and complementary products consumers can choose from."
    },
    {
     "id": 1345808,
     "content_html": "Post-sale service",
     "correctness": "1.0",
     "feedback_html": "A post-sale service is a buyer requirement that is fulfilled after the purchase of a product."
    },
    {
     "id": 1345806,
     "content_html": "Pre-sale service",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Pre-sale service is any service offered to consumers prior to the purchase."
    },
    {
     "id": 1345805,
     "content_html": "Convenience",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Convenience relates to how easy it is for consumers to purchase your product."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
