 "questions": [
  {
   "id": 677036,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Daphne often buys store or generic brand items at the grocery store because they are so much cheaper than name-brand items. Which pricing tactic is generally used for store or generic brands?",
   "answers": [
    {
     "id": 1345395,
     "content_html": "Bundle pricing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Bundle pricing is a tactic that has a lower price for a bundle of items than when those items are purchased separately."
    },
    {
     "id": 1345394,
     "content_html": "Cost-based pricing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cost-based pricing sets prices to cover the costs associated with production."
    },
    {
     "id": 1345393,
     "content_html": "Psychological pricing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Psychological pricing uses the consumer&#8217;s psyche to set prices."
    },
    {
     "id": 1345396,
     "content_html": "Economy pricing",
     "correctness": "1.0",
     "feedback_html": "Economy pricing is a tactic in which products are priced much lower than their name-brand competitors."
    }
   ],
