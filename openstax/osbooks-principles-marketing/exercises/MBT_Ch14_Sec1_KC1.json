   "stimulus_html": "",
   "stem_html": "Promoting a product in a television commercial aligns with which of the promotion mix elements?",
   "answers": [
    {
     "id": 1345480,
     "content_html": "Advertising",
     "correctness": "1.0",
     "feedback_html": "One media channel used in advertising is commercials."
    },
    {
     "id": 1345479,
     "content_html": "Public affairs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Public affairs is a form of public relations."
