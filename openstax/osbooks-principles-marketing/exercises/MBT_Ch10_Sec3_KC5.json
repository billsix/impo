   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following metrics would likely NOT be used to evaluate the effectiveness of new products?",
   "answers": [
    {
     "id": 1345195,
     "content_html": "R&amp;D spending as a percentage of sales",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. R&#38;D spending as a percentage of sales is a metric used to evaluate the effectiveness of new products."
    },
    {
     "id": 1345194,
     "content_html": "Time to value (TTV)",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Time to value (TTV) is a metric used to evaluate the effectiveness of new products."
    },
    {
     "id": 1345193,
     "content_html": "Return on investment (ROI)",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Return on investment is a metric used to evaluate the effectiveness of new products."
    },
    {
     "id": 1345196,
     "content_html": "Annual recurring revenue (ARR)",
     "correctness": "1.0",
     "feedback_html": "Annual recurring revenue (ARR) is the annual value of revenue generated from subscriptions and contracts."
    }
