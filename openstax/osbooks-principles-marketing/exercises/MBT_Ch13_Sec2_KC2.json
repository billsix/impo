 "questions": [
  {
   "id": 677043,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is considered noise in the communication process?",
   "answers": [
    {
     "id": 1345423,
     "content_html": "The sender sings a jingle.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The sender singing a jingle is part of the encoding process."
    },
    {
     "id": 1345424,
     "content_html": "A special news bulletin interrupts a paid ad.",
     "correctness": "1.0",
     "feedback_html": "Noise is anything that gets in the way of the sender and the message intended for the receiver."
    },
    {
     "id": 1345422,
     "content_html": "The consumer calls the 800 telephone number displayed in the advertisement.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. When the consumer calls the 800 telephone number, that is part of the feedback loop."
    },
    {
     "id": 1345421,
     "content_html": "The consumer clips the coupon from a mailer.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. When the consumer clips the coupon, they are decoding the message."
    }
   ],
   "hints": [],
