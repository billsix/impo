 "questions": [
  {
   "id": 676836,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A worldwide shortage of microchips has prompted Vorderman Enterprises to use a new vendor who has higher prices but can deliver the product on time. Which factor appears to be at play in this B2B transaction?",
   "answers": [
    {
     "id": 1344595,
     "content_html": "External factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. External factors include economic factors, political and legal factors, competition, and the social environment."
    },
    {
     "id": 1344594,
     "content_html": "Political and legal factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Political and legal factors include such things as the political system, laws, rules, and regulations."
    },
    {
     "id": 1344593,
     "content_html": "Economic factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Economic factors include things such as the level of primary demand, the economic outlook, and the cost of money."
    },
    {
     "id": 1344596,
     "content_html": "Conditional factors",
     "correctness": "1.0",
     "feedback_html": "The availability of the product or service plays a significant role in the buying decision, and availability is a conditional factor."
    }
   ],
