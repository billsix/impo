 "questions": [
  {
   "id": 677166,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Some manufacturers operate their own retail locations; when they are left with excess inventory, they often provide these to what type of retail locations?",
   "answers": [
    {
     "id": 1345916,
     "content_html": "Factory outlets",
     "correctness": "1.0",
     "feedback_html": "Factory outlets are retailers that are operated by manufacturers to sell overstock items at discounted prices."
    },
    {
     "id": 1345915,
     "content_html": "Warehouse clubs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Warehouse clubs offer consumers bulk items at discounted prices, but require a membership."
    },
    {
     "id": 1345914,
     "content_html": "Department stores",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Department stores sell a wide range of products from various manufacturers."
    },
    {
     "id": 1345913,
     "content_html": "Discount stores",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Discount stores are retailers that sell a broad range of products at lower prices than competitors and focus on price over quality."
    }
   ],
   "hints": [],
