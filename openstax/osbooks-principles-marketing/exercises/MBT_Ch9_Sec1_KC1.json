 "questions": [
  {
   "id": 676932,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is the best example of a pure service?",
   "answers": [
    {
     "id": 1344980,
     "content_html": "Haircut",
     "correctness": "1.0",
     "feedback_html": "A haircut is a service because it cannot be touched, owned, or stored for later use."
    },
    {
     "id": 1344979,
     "content_html": "Meal at a restaurant",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A meal at a restaurant is a hybrid of product and service. The food is a product, and the staff provides a service role."
    },
    {
     "id": 1344978,
     "content_html": "Frozen waffles",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Frozen waffles are a product that can be touched, owned, and stored for later use."
    },
    {
     "id": 1344977,
     "content_html": "Sports car",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A sports car is a product that can be touched, owned, and stored for later use. "
    }
   ],
   "hints": [],
