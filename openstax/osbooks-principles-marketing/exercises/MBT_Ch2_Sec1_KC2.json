 "questions": [
  {
   "id": 676788,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following strategies covers the entire organization when the business includes multiple divisions or operating units?",
   "answers": [
    {
     "id": 1344403,
     "content_html": "Functional strategy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Functional strategy is the plan to achieve the corporate- and business-level objectives in functional areas such as marketing, human resources, production, etc."
    },
    {
     "id": 1344402,
     "content_html": "Strategic business unit strategy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A strategic business unit strategy is essentially the same as a business-level strategy for a single business or operating unit."
    },
    {
     "id": 1344404,
     "content_html": "Corporate-level strategy",
     "correctness": "1.0",
     "feedback_html": "Corporate-level strategy covers the entire business in a complex organization in which there are multiple businesses, divisions, or operating units."
    },
    {
     "id": 1344401,
     "content_html": "Business-level strategy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Business-level strategy is the strategic plan created for a single business or operating unit&#8212;generally developed by middle management to support the corporate-level strategy."
    }
   ],
   "hints": [],
