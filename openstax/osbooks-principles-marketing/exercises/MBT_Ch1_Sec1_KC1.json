 "questions": [
  {
   "id": 676757,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Coca-Cola’s mission is to refresh the world, and to that end, it has ensured that you can buy a Coke product at numerous locations—vending machines, convenience stores, restaurant fountains, stadiums, etc. What type of utility has marketing created through this process?",
   "answers": [
    {
     "id": 1344279,
     "content_html": "Form utility",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Form utility refers to the appeal of a finished product; for example, a baker combining eggs, flour, sugar, and milk to create a cake."
    },
    {
     "id": 1344278,
     "content_html": "Time utility",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Time utility involves making products or services available to consumers when they&#8217;re ready to buy, such as stores that are open 24-7."
    },
    {
     "id": 1344280,
     "content_html": "Place utility",
     "correctness": "1.0",
     "feedback_html": "Place utility addresses convenience in terms of where a consumer can purchase your company&#8217;s product."
    },
    {
     "id": 1344277,
     "content_html": "Possession utility",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Possession utility means the satisfaction the consumer feels from buying a product or service."
    }
   ],
   "hints": [],
