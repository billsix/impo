 "questions": [
  {
   "id": 677167,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "After trying to sell a line of clothing at your retail location, you decide to change the price from $25 to $15. Which pricing strategy have you used?",
   "answers": [
    {
     "id": 1345919,
     "content_html": "Markup",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A markup is a price added to the cost at which retailers purchased goods."
    },
    {
     "id": 1345918,
     "content_html": "Original markup",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The original markup is the percentage added to the cost at which retailers purchased the goods at before actually selling those items."
    },
    {
     "id": 1345917,
     "content_html": "Maintained markup",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Maintained markup is the percentage added to the cost at which retailers purchased goods at after the sale of those items."
    },
    {
     "id": 1345920,
     "content_html": "Markdown",
     "correctness": "1.0",
     "feedback_html": "A markdown is a price decrease for a product that is at the end of its life cycle or season."
    }
   ],
