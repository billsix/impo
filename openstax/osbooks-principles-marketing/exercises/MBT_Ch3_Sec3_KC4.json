 "questions": [
  {
   "id": 676820,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is a heuristic?",
   "answers": [
    {
     "id": 1344531,
     "content_html": "It is the mental conflict that occurs when a person’s behaviors and beliefs do not align.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The mental conflict that occurs when a person&#8217;s behaviors and beliefs do not align is known as cognitive dissonance."
    },
    {
     "id": 1344532,
     "content_html": "It is a mental shortcut that allows people to solve problems and make judgments more quickly and efficiently.",
     "correctness": "1.0",
     "feedback_html": "Heuristics are types of preexisting value judgments that are used when people make purchase decisions."
    },
    {
     "id": 1344530,
     "content_html": "It is a function of the closeness between your expectations of a product or service and its actual performance.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Satisfaction is the function of the closeness between your expectations of a product or service and its actual performance."
    },
    {
     "id": 1344529,
     "content_html": "It is the process of assigning the cause of behavior to either internal or external characteristics.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Attribution is the process of assigning the cause of behavior to either internal or external characteristics."
    }
   ],
