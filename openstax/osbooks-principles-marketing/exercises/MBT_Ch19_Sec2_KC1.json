   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Traditional marketing takes a customer approach, while sustainable marketing takes a(n) ________ approach.",
   "answers": [
    {
     "id": 1346008,
     "content_html": "shareholder",
     "correctness": "1.0",
     "feedback_html": "Sustainable marketing considers all parties."
    },
    {
     "id": 1346007,
     "content_html": "value",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Value is a traditional marketing approach."
    },
    {
     "id": 1346006,
     "content_html": "economic",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Economics is focused on profitability."
    },
    {
     "id": 1346005,
     "content_html": "cost-savings",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cost savings are important to companies, but they are not part of a sustainable marketing approach."
    }
