 "questions": [
  {
   "id": 676777,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ needs are those that provide the “wow” factor in a customer’s purchase.",
   "answers": [
    {
     "id": 1344359,
     "content_html": "Stated",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s incorrect. Stated needs are those clearly specified by the customer."
    },
    {
     "id": 1344358,
     "content_html": "Real",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s incorrect. Real needs define the parameters that are immediate to defining and fulfilling the need."
    },
    {
     "id": 1344357,
     "content_html": "Unstated",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s incorrect. Unstated needs are what the customer expects but doesn&#8217;t ask for."
    },
    {
     "id": 1344360,
     "content_html": "Delight",
     "correctness": "1.0",
     "feedback_html": "A delight need is an added value you may get from the seller without prior expectation or request for the same."
    }
   ],
