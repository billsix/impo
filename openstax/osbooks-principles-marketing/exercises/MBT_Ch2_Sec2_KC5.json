 "questions": [
  {
   "id": 676796,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which strategy involves the creation of new or improved products to replace existing ones in order to improve a company’s competitive position and sales?",
   "answers": [
    {
     "id": 1344435,
     "content_html": "Market development",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A market development strategy involves searching for new market segments and uses for a company&#8217;s existing products."
    },
    {
     "id": 1344434,
     "content_html": "Product diversification",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A product diversification strategy involves expanding into a new segment of an industry in which the company is already operating."
    },
    {
     "id": 1344433,
     "content_html": "Horizontal diversification",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Horizontal diversification involves producing new and perhaps unrelated products or services for existing customers in order to garner a larger customer base."
    },
    {
     "id": 1344436,
     "content_html": "Product development",
     "correctness": "1.0",
     "feedback_html": "A company that pursues a product development strategy introduces new (and/or improved) products into the market to replace existing ones in order to improve its competitive position and sales."
    }
   ],
