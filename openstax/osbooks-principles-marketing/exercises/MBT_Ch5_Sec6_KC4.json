 "questions": [
  {
   "id": 676870,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When Artesha is on the road for her job and wants some fast food for lunch, she is looking for speed of service, value, and cleanliness of the restaurant. The factors would be referred to as ________.",
   "answers": [
    {
     "id": 1344731,
     "content_html": "her buyer persona",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A buyer persona is a semi-fictional representation of an organization&#8217;s ideal customer based on market research and real data about existing customers."
    },
    {
     "id": 1344730,
     "content_html": "a perceptual map",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A perceptual map is a visual diagram that shows how the average target market consumer perceives your product versus those of your competitors"
    },
    {
     "id": 1344732,
     "content_html": "her determinant attributes",
     "correctness": "1.0",
     "feedback_html": "Determinant attributes are those attributes or factors that a customer uses in making their purchase decision."
    },
    {
     "id": 1344729,
     "content_html": "a positioning statement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A positioning statement is a description of your product and target audience and explains how to fill a market need."
    }
   ],
   "hints": [],
