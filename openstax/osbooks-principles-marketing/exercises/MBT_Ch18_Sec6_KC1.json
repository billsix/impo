  {
   "id": 677182,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What does <i>caveat emptor</i> translate to in English?",
   "answers": [
    {
     "id": 1345980,
     "content_html": "Buyer beware",
     "correctness": "1.0",
     "feedback_html": "Caveat emptor is Latin for &#8220;let the buyer beware.&#8221;"
    },
    {
     "id": 1345979,
     "content_html": "Manufacturer beware",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The phrase is actually words of warning for another party."
    },
    {
     "id": 1345978,
     "content_html": "Retailer beware",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The phrase is actually words of warning for another party."
    },
    {
     "id": 1345977,
     "content_html": "Consumer protection",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The phrase is about the consumer, but it means something different."
    }
   ],
