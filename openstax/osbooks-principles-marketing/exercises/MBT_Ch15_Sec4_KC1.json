 "questions": [
  {
   "id": 677097,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Lev is the sales manager for John Paul Mitchell Systems. He is responsible for the North American sales division. Lev is currently reviewing the total number of salons and looking to estimate the size of his sales force. What sales force management function is Lev performing?",
   "answers": [
    {
     "id": 1345639,
     "content_html": "Setting sales goals",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Setting sales goals typically looks at the dollar amount of sales the company should anticipate."
    },
    {
     "id": 1345638,
     "content_html": "Looking at territories",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. If Lev were determining territories, he would be reviewing the geographical locations as well as the types of salons the sales professionals would be working with."
    },
    {
     "id": 1345640,
     "content_html": "Estimating the number of sales professionals he will need",
     "correctness": "1.0",
     "feedback_html": "Lev needs to know how many sales professionals he will need to hire."
    },
    {
     "id": 1345637,
     "content_html": "Writing job descriptions",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Writing job descriptions requires the sales manager to document what the roles and expectations are for the sales force."
    }
   ],
