 "questions": [
  {
   "id": 676950,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "LaToya has found a new market for her restaurant by expanding to catering. The restaurant is in the ________ stage of the product life cycle.",
   "answers": [
    {
     "id": 1345051,
     "content_html": "introduction ",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Pricing strategies are most common during the introduction stage of the product life cycle. "
    },
    {
     "id": 1345050,
     "content_html": "growth",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Expanding distribution, improving product quality, and messaging are most common during the growth stage of the product life cycle."
    },
    {
     "id": 1345052,
     "content_html": "maturity",
     "correctness": "1.0",
     "feedback_html": "Product and market modification are most common during the maturity stage of the product life cycle. LaToya is engaging in both product and market modification."
    },
    {
     "id": 1345049,
     "content_html": "decline",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Harvesting and divesture are most common during the decline stage of the product life cycle."
    }
   ],
