   "stimulus_html": "",
   "stem_html": "________ is/are the benefit(s) to the customer or consumer relative to the cost of the product or service.",
   "answers": [
    {
     "id": 1344372,
     "content_html": "Value",
     "correctness": "1.0",
     "feedback_html": "The benefit(s) to the customer or consumer relative to the cost is known as value."
    },
    {
     "id": 1344371,
     "content_html": "The exchange process",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The exchange process is obtaining a desired product or service from someone by delivering something of value in exchange."
    },
    {
     "id": 1344370,
     "content_html": "Stated needs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Stated needs are those clearly specified by the customer."
    },
    {
     "id": 1344369,
     "content_html": "Expectations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Expectations are a strong belief that something will happen or be the case in the future."
    }
