   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When a marketer uses multiple promotional methods to send a consistent message to the consumer, they are demonstrating the use of ________.",
   "answers": [
    {
     "id": 1345455,
     "content_html": "advertising",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising is only one promotional method."
    },
    {
     "id": 1345454,
     "content_html": "public relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Public relations is only one promotional method."
    },
    {
     "id": 1345456,
     "content_html": "integrated marketing communications",
     "correctness": "1.0",
     "feedback_html": "Using multiple promotional methods to send a consistent message is the goal of integrated marketing communications."
    },
    {
     "id": 1345453,
     "content_html": "personal selling",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is only one promotional method."
    }
