 "questions": [
  {
   "id": 676912,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Diversity marketing is a strategic approach that includes ________.",
   "answers": [
    {
     "id": 1344899,
     "content_html": "identifying different subsegments of consumers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Diversity marketing involves more than a strategy around different subsegments of consumers."
    },
    {
     "id": 1344898,
     "content_html": "creating advertisements to connect with specific consumers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Diversity marketing involves more than creating advertisements to connect with specific consumers."
    },
    {
     "id": 1344897,
     "content_html": "consumers that share cultural and sociodemographic characteristics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Diversity marketing involves more than targeting consumers that share cultural and sociodemographic characteristics."
    },
    {
     "id": 1344900,
     "content_html": "All of these statements are true.",
     "correctness": "1.0",
     "feedback_html": "Diversity marketing includes identifying different subsegments of consumers that share cultural and sociodemographic characteristics and creating advertisements to connect with them."
    }
   ],
