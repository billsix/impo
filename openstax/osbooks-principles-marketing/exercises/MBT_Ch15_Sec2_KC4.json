 "questions": [
  {
   "id": 677090,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Pfizer uses sales professionals to visit with physician offices and inform the physicians of the new medications and the uses for the medications and to encourage them to prescribe the new medications to their patients. This form of sales professional is often called ________?",
   "answers": [
    {
     "id": 1345611,
     "content_html": "technical specialist",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Technical specialists are responsible for making sure the product will work in certain applications and for helping to customize products where necessary."
    },
    {
     "id": 1345610,
     "content_html": "order taker",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Order takers are only responsible for taking orders."
    },
    {
     "id": 1345609,
     "content_html": "order getter",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The order getter is only responsible for taking orders when customers need more product."
    },
    {
     "id": 1345612,
     "content_html": "missionary sales",
     "correctness": "1.0",
     "feedback_html": "Missionary sales is responsible for educating and informing while also encouraging the use of a product."
    }
   ],
