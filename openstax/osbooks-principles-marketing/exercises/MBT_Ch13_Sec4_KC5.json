 "questions": [
  {
   "id": 677056,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The CFO for Wendy’s tells the CMO that after doing the annual budget, there is only $700,000 left for marketing promotions. Which form of budgeting is Wendy’s using?",
   "answers": [
    {
     "id": 1345475,
     "content_html": "Objective and task",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Objective and task would allow the marketer to identify the promotional objectives along with the tasks and set the budget according to what needs to be done to achieve the objectives."
    },
    {
     "id": 1345474,
     "content_html": "Competitive parity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. With this promotional method, the CMO would budget exactly what the company&#8217;s competitors have budgeted for marketing promotions."
    },
    {
     "id": 1345476,
     "content_html": "Affordable",
     "correctness": "1.0",
     "feedback_html": "Wendy&#8217;s would be using all that their budget could afford for the marketing promotions."
    },
    {
     "id": 1345473,
     "content_html": "Percent of sales",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. If the Wendy&#8217;s CFO were allocating the marketing promotional budget according to the sales level and choosing a percent of sales as the promotional budget, then they would be using percent-of-sales budgeting."
    }
   ],
