 "questions": [
  {
   "id": 676861,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which essential factor in selecting a target market refers to the ability to accurately determine the size of the market in terms of either sales volume or number of customers?",
   "answers": [
    {
     "id": 1344695,
     "content_html": "Actionable",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An actionable market segment should be able to respond to a certain marketing strategy and have outcomes that can be easily quantified."
    },
    {
     "id": 1344694,
     "content_html": "Differentiable",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Differentiability means that the market should be internally homogenous but externally heterogeneous so that marketing actions can be applied to them without overlap."
    },
    {
     "id": 1344696,
     "content_html": "Measurable",
     "correctness": "1.0",
     "feedback_html": "A measurable market segment means that you can accurately determine the size of the segment in terms of either sales volume or number of customers."
    },
    {
     "id": 1344693,
     "content_html": "Substantial",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A substantial market segment means that there are sufficient potential consumers in the segment that justify spending resources to market the product or service."
    }
   ],
