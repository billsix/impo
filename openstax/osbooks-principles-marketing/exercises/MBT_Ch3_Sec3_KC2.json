 "questions": [
  {
   "id": 676818,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ra’Shana’s car broke down on the way to work, and she realizes that she needs to quickly find a repair shop to take care of her vehicle. Which stage of the consumer decision process model does this represent?",
   "answers": [
    {
     "id": 1344524,
     "content_html": "Need recognition",
     "correctness": "1.0",
     "feedback_html": "Ra&#8217;Shana has detected a difference between her actual state (not having a functional car) and her desired state (having a car that runs)."
    },
    {
     "id": 1344523,
     "content_html": "Information search",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. If Ra&#8217;Shana were in the information search stage, she would be actively looking for information on repair shops that could do the car repairs."
    },
    {
     "id": 1344522,
     "content_html": "Evaluation of alternatives",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The evaluation of alternatives would involve looking at several different attributes of various repair shops (i.e., price, location, reputation, etc.)."
    },
    {
     "id": 1344521,
     "content_html": "Purchase decision",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The purchase decision stage involves actually reaching a decision on the purchase of a product or service&#8212;in this case, the repair shop to fix Ra&#8217;Shana&#8217;s car."
    }
   ],
