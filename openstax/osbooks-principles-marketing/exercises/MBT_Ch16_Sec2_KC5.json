 "questions": [
  {
   "id": 677121,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following represents a challenge for mobile marketing?",
   "answers": [
    {
     "id": 1345735,
     "content_html": "Mobile device usage is on the decline.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Mobile device usage continues to grow."
    },
    {
     "id": 1345736,
     "content_html": "It’s challenging to measure mobile marketing campaigns.",
     "correctness": "1.0",
     "feedback_html": "Measuring mobile campaigns can be challenging because it&#8217;s difficult to measure whether a consumer has seen a push notification or in-app message."
    },
    {
     "id": 1345734,
     "content_html": "Responsive design is difficult to implement.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Responsive design is not difficult to implement."
    },
    {
     "id": 1345733,
     "content_html": "People are using email less and less.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Billions of people check email on a daily basis, and it remains a popular communication tool to market to consumers."
    }
   ],
