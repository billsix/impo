  {
   "id": 676982,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Data measurements that businesses use to evaluate the success of new products are called ________.",
   "answers": [
    {
     "id": 1345179,
     "content_html": "ROI",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. ROI is an acronym for return on investment, which is a ratio between net income and investment."
    },
    {
     "id": 1345178,
     "content_html": "product adoption rates",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product adoption rates are measures of how many people adopt a new product and become regular users."
    },
    {
     "id": 1345177,
     "content_html": "R&amp;D",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. R&#38;D is an acronym for research and development."
    },
    {
     "id": 1345180,
     "content_html": "product metrics",
     "correctness": "1.0",
     "feedback_html": "Product metrics are data measurements that businesses use to evaluate the success of a product."
    }
   ],
