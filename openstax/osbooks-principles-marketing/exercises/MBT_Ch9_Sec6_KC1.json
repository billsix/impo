   "stimulus_html": "",
   "stem_html": "Domino's Pizza recently added sandwiches to its menu. This is an example of a ________. ",
   "answers": [
    {
     "id": 1345079,
     "content_html": "line extension",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A line extension would involve adding a product to its existing line of pizzas. "
    },
    {
     "id": 1345080,
     "content_html": "brand extension",
     "correctness": "1.0",
     "feedback_html": "Domino's is leveraging its brand to a new category of products."
    },
    {
     "id": 1345078,
     "content_html": "multibrand",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Multibranding would involve a new brand name in the same pizza category. "
    },
    {
     "id": 1345077,
     "content_html": "new brand",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. New brands would involve a new name and new category. "
    }
