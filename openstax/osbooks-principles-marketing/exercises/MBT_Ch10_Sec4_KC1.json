 "questions": [
  {
   "id": 676987,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The degree to which a new product is built on the firm’s existing technological resources is known as ________.",
   "answers": [
    {
     "id": 1345199,
     "content_html": "market attractiveness",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Market attractiveness is a measure of potential value and considers factors like short- and long-term profit, market growth rate, how much competition currently exists in the market, the cost of entry into the market, and how much the product satisfies the needs of customers in the target market."
    },
    {
     "id": 1345198,
     "content_html": "marketing synergy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing synergy refers to how much of a fit there is between the firm&#8217;s current marketing capabilities and the needs of the new product development project."
    },
    {
     "id": 1345200,
     "content_html": "technological synergy",
     "correctness": "1.0",
     "feedback_html": "Technological synergy is how much of a match there is between the existing technological skills of the firm and the technological skills needed to execute the new product initiative."
    },
    {
     "id": 1345197,
     "content_html": "cost-benefit analysis",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cost-benefit analysis is simply an assessment of whether the value of the benefits exceed the costs involved."
    }
   ],
