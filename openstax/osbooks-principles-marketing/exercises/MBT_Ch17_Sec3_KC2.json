 "questions": [
  {
   "id": 677138,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "ABC Toys desires to distribute products across global markets. It is likely using what type of distribution strategy?",
   "answers": [
    {
     "id": 1345803,
     "content_html": "Exclusive",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Exclusive distribution is reserved for brands that want to limit the availability of their products."
    },
    {
     "id": 1345802,
     "content_html": "Selective",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A selective distribution strategy does not seek to reach all outlets in the market but somewhere between more than one outlet but less than all outlets."
    },
    {
     "id": 1345801,
     "content_html": "Unlimited",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. There isn&#8217;t a distribution strategy known as unlimited."
    },
    {
     "id": 1345804,
     "content_html": "Intensive",
     "correctness": "1.0",
     "feedback_html": "An intensive distribution strategy is used when a company wants to distribute through every possible retail outlet where a consumer might find its products."
    }
   ],
   "hints": [],
