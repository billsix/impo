 "questions": [
  {
   "id": 676935,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Potbelly Sandwich Shops use paper bags to hold customers' sandwiches. What type of industrial product is the bag?",
   "answers": [
    {
     "id": 1344991,
     "content_html": "Raw materials",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Raw materials are a part of the product itself."
    },
    {
     "id": 1344990,
     "content_html": "Manufactured materials and parts",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Manufactured materials and parts are products that are used to create the product. "
    },
    {
     "id": 1344989,
     "content_html": "Capital items",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Capital items are significant investments used to make a product and appear on a balance sheet as an asset."
    },
    {
     "id": 1344992,
     "content_html": "Supplies and services",
     "correctness": "1.0",
     "feedback_html": "A bag is a supply that does not retain value on a balance sheet."
    }
   ],
