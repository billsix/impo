 "questions": [
  {
   "id": 677041,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When a singer who is voted off <em>The Voice</em> television series appears on <em>Today</em> to discuss the experience, it is an example of ________.",
   "answers": [
    {
     "id": 1345415,
     "content_html": "advertising",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising is a paid form of nonpersonal communication."
    },
    {
     "id": 1345416,
     "content_html": "public relations",
     "correctness": "1.0",
     "feedback_html": "Public relations encompasses nonpaid activities that promote a product, service, idea, or person."
    },
    {
     "id": 1345414,
     "content_html": "sales promotion",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sales promotion is a form of communication directed at a buyer to induce sales in the short term."
    },
    {
     "id": 1345413,
     "content_html": "direct marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Direct marketing is focused on selling a product directly to a consumer through digital means as well as mail and telephone."
    }
   ],
