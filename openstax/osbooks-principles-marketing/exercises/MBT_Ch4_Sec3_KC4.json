   "id": 676835,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Interest rates have gone up significantly in the past few months, prompting Johnson Manufacturing to reconsider purchasing a new building. Which factor appears to be at play in this B2B transaction?",
   "answers": [
    {
     "id": 1344591,
     "content_html": "Political and legal factors",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Political and legal factors include the political system, laws, rules, and regulations."
    },
    {
     "id": 1344592,
     "content_html": "Economic factors",
     "correctness": "1.0",
     "feedback_html": "Economic factors include the level of primary demand, the economic outlook, and the cost of money (i.e., interest rates)."
    },
    {
     "id": 1344590,
     "content_html": "Workforce skills",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Workforce skills are an important consideration in many B2B purchases, since the workers are the ones who are going to be using the new equipment. However, that is not the case in this scenario."
    },
    {
     "id": 1344589,
     "content_html": "Competition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Competition can influence B2B buying behavior in that competitive pressures can create a strong sense of urgency."
    }
   ],
