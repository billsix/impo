 "questions": [
  {
   "id": 676875,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is not a reason why marketing research is important for the success of a business?",
   "answers": [
    {
     "id": 1344752,
     "content_html": "It provides a guarantee of customer satisfaction.",
     "correctness": "1.0",
     "feedback_html": "Although marketing research is helpful in providing the data necessary for successful business ventures, there is no guarantee that it will cause customer satisfaction."
    },
    {
     "id": 1344751,
     "content_html": "It identifies opportunities in the market to explore.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing research can expose opportunities for a business to explore."
    },
    {
     "id": 1344750,
     "content_html": "It helps to quantify customer perceptions.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing research can help to quantify customer perceptions."
    },
    {
     "id": 1344749,
     "content_html": "It uncovers weaknesses within a company.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing research can uncover weaknesses within a company."
    }
   ],
