 "questions": [
  {
   "id": 677111,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following elements of the marketing communications mix consists of a collection of incentive tools, mostly short term, designed to stimulate quicker or greater purchase of particular products or services by consumers or the trade?",
   "answers": [
    {
     "id": 1345695,
     "content_html": "Advertising",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising is a paid form of mass communication."
    },
    {
     "id": 1345694,
     "content_html": "Personal selling",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Personal selling is a one-on-one form of paid promotion."
    },
    {
     "id": 1345693,
     "content_html": "Public relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Public relations is nonpaid mass communication."
    },
    {
     "id": 1345696,
     "content_html": "Sales promotion",
     "correctness": "1.0",
     "feedback_html": "Sales promotion is a short-term incentive to consumers and the trade."
    }
   ],
