   "id": 677170,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Pablo is trying to determine their gross margin at the end of the quarter. Which is the correct equation?",
   "answers": [
    {
     "id": 1345931,
     "content_html": "Units sold times selling price",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Gross margin &#61; net sales &#8211; cost of goods sold"
    },
    {
     "id": 1345930,
     "content_html": "Units purchased times purchase price",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Gross margin &#61; net sales &#8211; cost of goods sold"
    },
    {
     "id": 1345932,
     "content_html": "Net sales less cost of goods sold",
     "correctness": "1.0",
     "feedback_html": "Gross margin &#61; net sales &#8211; cost of goods sold"
    },
    {
     "id": 1345929,
     "content_html": "Unit cost plus the sale price",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Gross margin &#61; net sales &#8211; cost of goods sold"
    }
   ],
