   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What is the difference between multichannel and omnichannel marketing systems?",
   "answers": [
    {
     "id": 1345795,
     "content_html": "Multichannel marketing systems are designed primarily for online distribution.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Multichannel systems are not designed primarily for online distribution."
    },
    {
     "id": 1345794,
     "content_html": "Omnichannel marketing systems are designed primarily for in-store distribution.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Omnichannel systems are not primarily designed for in-store distribution."
    },
    {
     "id": 1345796,
     "content_html": "Omnichannel marketing systems are more flexible and seamless in how consumers can buy and receive products and services.",
     "correctness": "1.0",
     "feedback_html": "Omnichannel marketing systems allow consumers to buy and receive products and services seamlessly across a variety of channels, including online and in-store."
    },
