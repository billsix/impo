 "questions": [
  {
   "id": 676768,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ consist of third-party sellers such as retailers, wholesalers, and other resellers in the distribution channel.",
   "answers": [
    {
     "id": 1344323,
     "content_html": "Suppliers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Suppliers provide companies with the parts and products needed to produce their product."
    },
    {
     "id": 1344324,
     "content_html": "Market intermediaries",
     "correctness": "1.0",
     "feedback_html": "Market intermediaries are retailers, wholesalers, and others in the distribution channel who help deliver products to the end user."
    },
    {
     "id": 1344322,
     "content_html": "Partners",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Partners are companies or internal departments with whom we form an alliance to work in cooperation toward a common goal."
    },
    {
     "id": 1344321,
     "content_html": "Customers",
     "correctness": "0.0",
     "feedback_html": "Customers are the purchasers of our product."
    }
   ],
