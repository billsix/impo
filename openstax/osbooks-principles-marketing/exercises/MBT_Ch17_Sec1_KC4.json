 "questions": [
  {
   "id": 677130,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "What do intermediaries do to add value in the marketing channel?",
   "answers": [
    {
     "id": 1345772,
     "content_html": "They perform important activities that manufacturers are not experts at performing.",
     "correctness": "1.0",
     "feedback_html": "Intermediaries add value by performing important activities that manufacturers are not expert at performing. This helps create efficiency in the marketing channel, which helps meet the wants and needs of targeted customers."
    },
    {
     "id": 1345771,
     "content_html": "They increase the price of products and services for customers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Increasing product price is not adding value to the marketing channel."
    },
    {
     "id": 1345770,
     "content_html": "They increase the amount of time it takes for products and services to reach consumers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Adding time for products to reach consumers is not a value added to the marketing channel."
    },
    {
     "id": 1345769,
     "content_html": "They make improvements to the product so that it functions better.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Intermediaries to not directly work on product improvement."
    }
   ],
