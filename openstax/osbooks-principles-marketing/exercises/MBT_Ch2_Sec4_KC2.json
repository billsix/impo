 "questions": [
  {
   "id": 676803,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "How frequently should we monitor KPIs?",
   "answers": [
    {
     "id": 1344464,
     "content_html": "Continuously",
     "correctness": "1.0",
     "feedback_html": "We should always monitor KPIs on a continuous basis. Some information is only available periodically when financials are produced and production statistics are rolled up. The use of real-time dashboards can make it possible to monitor KPIs in real time. The faster we can get the data, the faster we can make adjustments (when required)."
    },
    {
     "id": 1344463,
     "content_html": "Monthly when the financial statements are produced",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. KPIs should be monitored more frequently than monthly."
    },
    {
     "id": 1344462,
     "content_html": "Annually when the yearly financial statements are produced",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. KPIs should be monitored more frequently than once a year."
    },
    {
     "id": 1344461,
     "content_html": "When things just don’t “feel” quite right",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. It&#8217;s not enough to monitor KPIs only when things don&#8217;t &#8220;feel&#8221; quite right."
    }
   ],
