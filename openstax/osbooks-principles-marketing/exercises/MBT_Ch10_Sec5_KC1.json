 "questions": [
  {
   "id": 676992,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Garrett is the type of consumer who has to have the absolute “latest and greatest” technology products on the market. He is often the very first of his group of friends to acquire the newest smartphone or other gadget. Garrett would be considered a(n) ________.",
   "answers": [
    {
     "id": 1345219,
     "content_html": "early adopter",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Early adopters are opinion leaders with neighbors and friends, but they typically look to a different type of consumer."
    },
    {
     "id": 1345218,
     "content_html": "laggard",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Laggards are skeptical of new ideas."
    },
    {
     "id": 1345217,
     "content_html": "late majority",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Consumers in the late majority category are typically slow to catch on to the popularity of new products."
    },
    {
     "id": 1345220,
     "content_html": "innovator",
     "correctness": "1.0",
     "feedback_html": "Innovators typically buy new products as soon as they hit the market."
    }
   ],
