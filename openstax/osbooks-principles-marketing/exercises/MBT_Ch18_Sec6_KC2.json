 "questions": [
  {
   "id": 677183,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Justia saw on the news that chicken was recently recalled by the US Food and Drug Administration (FDA). The news anchor specified which sell-by dates, manufacturer, and retailers were affected. Justia doesn’t understand how the FDA can know, with such specificity, which chickens were affected. How would you describe to Justia this specificity?",
   "answers": [
    {
     "id": 1345983,
     "content_html": "Increased competition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Increased competition does not indicate traceability."
    },
    {
     "id": 1345982,
     "content_html": "E-commerce",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. E-commerce is the ability to shop online."
    },
    {
     "id": 1345981,
     "content_html": "Caveat emptor",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Caveat emptor translates to &#8220;let the buyer beware.&#8221;"
    },
    {
     "id": 1345984,
     "content_html": "Product traceability",
     "correctness": "1.0",
     "feedback_html": "Product traceability allows products to be traced throughout the distribution channel to the manufacturer."
    }
   ],
   "hints": [],
