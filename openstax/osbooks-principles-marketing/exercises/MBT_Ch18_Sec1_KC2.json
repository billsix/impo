 "questions": [
  {
   "id": 677158,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a function of retailing?",
   "answers": [
    {
     "id": 1345884,
     "content_html": "Buying in large quantities and selling to other businesses for the purpose of reselling them to consumers",
     "correctness": "1.0",
     "feedback_html": "Wholesalers are in business to buy in large quantities and sell to other businesses."
    },
    {
     "id": 1345883,
     "content_html": "Providing assortment and variety of products",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Providing assortment and variety of products IS a function of retailers."
    },
    {
     "id": 1345882,
     "content_html": "Holding inventory",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Holding inventory IS a function of retailers."
    },
    {
     "id": 1345881,
     "content_html": "Providing convenient location and store hours",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Providing convenient location and hours IS a function of retailers."
    }
   ],
