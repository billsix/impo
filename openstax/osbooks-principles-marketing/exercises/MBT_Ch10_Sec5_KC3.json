 "questions": [
  {
   "id": 676994,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The extent to which the beneficial results of using a new product are observable or describable to others is referred to as ________.",
   "answers": [
    {
     "id": 1345227,
     "content_html": "divisibility",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Divisibility is the degree to which the product can be tried or tested on a limited basis."
    },
    {
     "id": 1345226,
     "content_html": "product awareness",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product awareness is the first stage in the consumer adoption process, in which the consumer becomes aware of the existence of the new product."
    },
    {
     "id": 1345225,
     "content_html": "marketing synergy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing synergy means that there is a strong fit between the needs of the project and the firm&#8217;s sales, distribution system, advertising resources, marketing research and customer service capabilities."
    },
    {
     "id": 1345228,
     "content_html": "communicability",
     "correctness": "1.0",
     "feedback_html": "Communicability is the extent to which the benefits of a new product are likely to be noticed and discussed by consumers."
    }
   ],
   "hints": [],
