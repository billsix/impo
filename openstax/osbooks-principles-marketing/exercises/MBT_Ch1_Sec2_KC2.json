   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the 4Ps focuses on determining how much consumers would be willing to pay for a product or service?",
   "answers": [
    {
     "id": 1344303,
     "content_html": "Product",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Product refers to a good or service that a company offers to its customers."
    },
    {
     "id": 1344304,
     "content_html": "Price",
     "correctness": "1.0",
     "feedback_html": "Price is the amount consumers pay for a product or service."
    },
    {
     "id": 1344302,
     "content_html": "Place",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Place refers to marketing&#8217;s efforts to ensure that the product or service desired by customers is available at a location convenient for them."
    },
    {
     "id": 1344301,
     "content_html": "Promotion",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Promotion includes advertising, public relations, and other strategies such as television and print advertisements, social media advertising, etc."
    }
