 "questions": [
  {
   "id": 676937,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Oreo's selection of flavors would be considered a ________.",
   "answers": [
    {
     "id": 1344999,
     "content_html": "product",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A single flavor of Oreos would be a product."
    },
    {
     "id": 1345000,
     "content_html": "product line",
     "correctness": "1.0",
     "feedback_html": "Oreo's selection of flavors represents a product line because it encompasses multiple similar products."
    },
    {
     "id": 1344998,
     "content_html": "product mix",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A product mix would contain all of Nabisco's cookies."
    },
    {
     "id": 1344997,
     "content_html": "product category",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A product category would encompass all cookies, not just Oreos."
    }
   ],
