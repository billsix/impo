 "questions": [
  {
   "id": 676972,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Many years ago, liquid soap was introduced in place of traditional bar soaps. This innovation changed an intrinsic feature of the product, but it’s used for the same purpose. This is an example of ________.",
   "answers": [
    {
     "id": 1345139,
     "content_html": "discontinuous innovation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. With discontinuous innovation, products are significantly different from existing products, so they require a substantial altering of consumer habits to use the products."
    },
    {
     "id": 1345138,
     "content_html": "continuous innovation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. With continuous innovation, the existing product undergoes marginal changes and doesn&#8217;t alter consumer habits."
    },
    {
     "id": 1345140,
     "content_html": "dynamically continuous innovation",
     "correctness": "1.0",
     "feedback_html": "With dynamically continuous innovation, some changes in consumer habits are necessary, but the changes aren&#8217;t as dramatic as with discontinuous innovation and are not as insignificant as in continuous innovation."
    },
    {
     "id": 1345137,
     "content_html": "noncontinuous innovation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. There is no such innovation as noncontinuous innovation."
    }
   ],
   "hints": [],
