 "questions": [
  {
   "id": 676851,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which B2B market segmentation strategy clusters groups of customers on the basis of what features they normally look for in a product?",
   "answers": [
    {
     "id": 1344655,
     "content_html": "Firmographics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Firmographics segments customers based on sets of characteristics such as industry, location, size, legal structure, and performance."
    },
    {
     "id": 1344654,
     "content_html": "Behavioral",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Behavioral segmentation looks at the behavior of an organization&#8217;s customers toward its products or services."
    },
    {
     "id": 1344653,
     "content_html": "Technographics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Technographic segmentation allows a marketer to organize prospects by their technology ownership and usage and narrow the market to those prospects that may be willing to invest in new technological solutions."
    },
    {
     "id": 1344656,
     "content_html": "Needs based",
     "correctness": "1.0",
     "feedback_html": "Needs-based segmentation is based on the premise that a marketer should focus their limited resources on those customers that need the product and have the ability to purchase it."
    }
   ],
