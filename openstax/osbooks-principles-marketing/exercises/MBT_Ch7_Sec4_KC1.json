 "questions": [
  {
   "id": 676902,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A company that uses the same marketing strategy in all markets is most likely utilizing which of the following?",
   "answers": [
    {
     "id": 1344860,
     "content_html": "Standardized",
     "correctness": "1.0",
     "feedback_html": "A standardized strategy employs the same strategy for every market."
    },
    {
     "id": 1344859,
     "content_html": "Adapted",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An adapted strategy utilizes different strategies based on market demand."
    },
    {
     "id": 1344858,
     "content_html": "Invention",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. An invention strategy utilizes new products for various markets."
    },
    {
     "id": 1344857,
     "content_html": "Modified",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A modified strategy is one in which the company modifies its strategy based on each market."
    }
   ],
