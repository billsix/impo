 "questions": [
  {
   "id": 676760,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The total potential profits a company earns from its current and potential customers is known as ________.",
   "answers": [
    {
     "id": 1344292,
     "content_html": "customer equity",
     "correctness": "1.0",
     "feedback_html": "Customer equity is the total potential profits a company earns from its current and potential customers."
    },
    {
     "id": 1344291,
     "content_html": "the value proposition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The value proposition is a succinct statement of why a customer would choose your product or service."
    },
    {
     "id": 1344290,
     "content_html": "customer value",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer value is the difference between the perceived benefits and costs incurred by the customer in acquiring your products or services."
    },
    {
     "id": 1344289,
     "content_html": "the marketing process",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The marketing process is the series of steps that assist businesses in planning, analyzing, implementing, and adjusting their marketing strategy."
    }
   ],
