 "questions": [
  {
   "id": 676852,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The Hofstede cultural dimension that assesses the degree to which a society avoids risk or ambiguity is known as ________.",
   "answers": [
    {
     "id": 1344659,
     "content_html": "masculinity/femininity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Masculinity/femininity refers to the degree to which gender-specific roles are valued in the society."
    },
    {
     "id": 1344660,
     "content_html": "uncertainty avoidance",
     "correctness": "1.0",
     "feedback_html": "Societies with a high degree of uncertainty avoidance compensate for this uncertainty by establishing rules, policies, and procedures, whereas societies with low uncertainty avoidance more readily accept change."
    },
    {
     "id": 1344658,
     "content_html": "power distance index",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Power distance refers to how much power inequality exists within a culture and the degree to which people are accepting of this inequality."
    },
    {
     "id": 1344657,
     "content_html": "individualism versus collectivism",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Individualism versus collectivism refers to whether the culture emphasizes the needs and goals of the group as a whole or whether individual needs are paramount."
    }
   ],
