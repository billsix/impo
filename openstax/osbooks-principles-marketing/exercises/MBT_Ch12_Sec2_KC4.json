 "questions": [
  {
   "id": 677020,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is false with regard to pricing?",
   "answers": [
    {
     "id": 1345331,
     "content_html": "Customers are interested in the price of the product, not the cost to a company.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customers are most interested in the price they will pay, not the cost to the producer."
    },
    {
     "id": 1345332,
     "content_html": "Cost only includes the materials needed to produce a product.",
     "correctness": "1.0",
     "feedback_html": "Cost does not only include the materials needed to produce a produce, but all other costs associated with doing business."
    },
    {
     "id": 1345330,
     "content_html": "If cost is not considered in pricing, the company will likely be unsuccessful.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Costs are an important factor in pricing decisions. If a company cannot cover costs, it will not be able to make a profit."
    },
    {
     "id": 1345329,
     "content_html": "Costs include both variable and fixed costs.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Costs do include both variable and fixed costs."
    }
   ],
   "hints": [],
