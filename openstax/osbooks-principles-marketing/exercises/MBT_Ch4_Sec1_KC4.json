 "questions": [
  {
   "id": 676825,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Many of the world’s high-tech companies are located in Silicon Valley, California, including the headquarters of more than 30 businesses in the Fortune 1000. Which difference between B2B and B2C markets does this illustrate?",
   "answers": [
    {
     "id": 1344551,
     "content_html": "More reliance on personal selling",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although there is more reliance on personal selling in the B2B market vs. mass marketing in the B2C market, the scenario does not illustrate that fact."
    },
    {
     "id": 1344550,
     "content_html": "Derived demand versus direct demand",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although direct demand is a characteristic of B2C markets vs. derived demand in B2B markets, the scenario does not illustrate that fact."
    },
    {
     "id": 1344552,
     "content_html": "Fewer customers, often geographically concentrated in areas",
     "correctness": "1.0",
     "feedback_html": "The B2B market is more geographically concentrated in areas based on cost, access, and availability of resources."
    },
    {
     "id": 1344549,
     "content_html": "Larger purchases/fewer buyers than the B2C market",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although it is true that there are fewer buyers who make larger purchases in the B2B market vs. the B2C market, the scenario does not illustrate that fact."
    }
   ],
