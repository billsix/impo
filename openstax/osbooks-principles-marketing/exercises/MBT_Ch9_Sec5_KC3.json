   "id": 676954,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a means of brand positioning? ",
   "answers": [
    {
     "id": 1345067,
     "content_html": "Value",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Value is one of the ways that brands can position themselves. "
    },
    {
     "id": 1345066,
     "content_html": "Benefits",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Benefits are one way that brands can position themselves. "
    },
    {
     "id": 1345068,
     "content_html": "Brand equity",
     "correctness": "1.0",
     "feedback_html": "Brand equity is the additional value that a brand has over its competitors, while values, benefits, and attributes are all associated with brand positioning."
    },
    {
     "id": 1345065,
     "content_html": "Attributes",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Attributes are one way that brands can position themselves. "
    }
