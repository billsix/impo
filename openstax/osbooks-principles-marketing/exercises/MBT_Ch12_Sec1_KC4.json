 "questions": [
  {
   "id": 677015,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Kilee sees an advertisement for a new computer. The advertisement portrays an initial price of $699 that has a large red “X” through it with a new price of $499. The advertisement is utilizing which pricing concept?        ",
   "answers": [
    {
     "id": 1345311,
     "content_html": "Artificial time constraints",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Artificial time constraints are used to make buyers feel time is of the essence and they should purchase immediately."
    },
    {
     "id": 1345310,
     "content_html": "Price appearance",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Price appearance is the literal way in which a price is posted, such as the use of dollar signs and decimals."
    },
    {
     "id": 1345309,
     "content_html": "Price gouging",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Price gouging is an unethical pricing strategy that takes advantage of inflated demand."
    },
    {
     "id": 1345312,
     "content_html": "Price anchoring",
     "correctness": "1.0",
     "feedback_html": "Price anchoring is a strategy that utilizes a psychological theory that buyers frame their price reference around the first piece of information they see."
    }
   ],
