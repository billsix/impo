 "questions": [
  {
   "id": 677044,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A popular form of communicating is through television advertisements. Which element of the communication process is the television advertisement?",
   "answers": [
    {
     "id": 1345427,
     "content_html": "Noise",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Noise is anything that might get in the way of the receiver getting the message."
    },
    {
     "id": 1345426,
     "content_html": "Sender",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The sender is the source of the message, usually the company."
    },
    {
     "id": 1345428,
     "content_html": "Medium",
     "correctness": "1.0",
     "feedback_html": "Television advertising is the medium through which the message is delivered."
    },
    {
     "id": 1345425,
     "content_html": "Feedback loop",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The feedback loop is the process by which the sender knows the receiver has received the message."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
    {
     "images": [],
     "solution_type": "detailed",
     "content_html": "Television advertising is the medium through which the message is delivered."
    }
   ],
   "community_solutions": []
