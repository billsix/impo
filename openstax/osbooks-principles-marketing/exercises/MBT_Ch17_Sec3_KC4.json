 "questions": [
  {
   "id": 677140,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "MilkyIce markets ice cream products through grocery retailers in the United States. Which of the following product-related factors would have the biggest impact on MilkyIce’s channel choice?",
   "answers": [
    {
     "id": 1345811,
     "content_html": "Standardization",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Standardization relates to the uniformity and consistency of a product."
    },
    {
     "id": 1345810,
     "content_html": "Bulk and weight",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Bulk and weight relate to the size and heaviness of a product."
    },
    {
     "id": 1345812,
     "content_html": "Perishability",
     "correctness": "1.0",
     "feedback_html": "Perishability is an important factor in channel decisions for companies who sell products that have a short shelf life."
    },
    {
     "id": 1345809,
     "content_html": "Unit value",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Unit value relates to the value of an individual unit of product."
    }
   ],
