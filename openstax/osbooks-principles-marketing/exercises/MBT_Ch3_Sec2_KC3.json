  {
   "id": 676814,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jazmine purchases a wireless alarm system for her apartment. According to Maslow’s hierarchy of needs, which level of needs does this purchase reflect?",
   "answers": [
    {
     "id": 1344507,
     "content_html": "Physiological",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Physiological needs are the most basic and include things like adequate food, water, and shelter."
    },
    {
     "id": 1344508,
     "content_html": "Safety/security",
     "correctness": "1.0",
     "feedback_html": "The safety and security level of Maslow&#8217;s hierarchy of needs reflects the need to be safe from physical and psychological harm."
    },
    {
     "id": 1344506,
     "content_html": "Self-esteem",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Esteem, the fourth level in Maslow&#8217;s hierarchy of needs, includes such needs as recognition from others, taking pride in your education or work, awards, and/or prestige."
    },
    {
     "id": 1344505,
     "content_html": "Social",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Social needs include the need for emotional attachments, friendship, love, or belonging to community or church groups."
    }
   ],
