 "questions": [
  {
   "id": 677053,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "According to the 5A framework, when Jennifer uses the Panera Bread coupon sent through a text message to her mobile device, which stage of the customer journey is she in?",
   "answers": [
    {
     "id": 1345463,
     "content_html": "Advocacy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. If she were exhibiting the advocacy stage, she would be telling her friends and family about Panera Bread."
    },
    {
     "id": 1345462,
     "content_html": "Aware",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In the awareness stage, Jennifer would just be learning about Panera Bread and probably would not be connected with the company through her mobile device."
    },
    {
     "id": 1345461,
     "content_html": "Appeal",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In the appeal stage, Panera Bread would be working to get connected to Jennifer."
    },
    {
     "id": 1345464,
     "content_html": "Act",
     "correctness": "1.0",
     "feedback_html": "Jennifer is acting on the promotional method Panera Bread used to reach her in the customer journey."
    }
   ],
