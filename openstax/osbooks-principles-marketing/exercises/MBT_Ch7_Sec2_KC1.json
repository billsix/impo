   "id": 676892,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "During the Russian invasion of Ukraine in 2022, the Russian ruble’s value decreased to less than one United States penny. This conversion from ruble to dollar is known as the ________.",
   "answers": [
    {
     "id": 1344820,
     "content_html": "exchange rate",
     "correctness": "1.0",
     "feedback_html": "An exchange rate is the rate at which one country&#8217;s currency can be exchanged for that of another country"
    },
    {
     "id": 1344819,
     "content_html": "business landscape",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The business landscape is the internal and external environment of the business."
    },
    {
     "id": 1344818,
     "content_html": "purchasing power",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Purchasing power is the number of goods that one unit of currency can purchase."
    },
    {
     "id": 1344817,
     "content_html": "consumer income",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Consumer income is the amount of money a household or individual earns."
    }
   ],
