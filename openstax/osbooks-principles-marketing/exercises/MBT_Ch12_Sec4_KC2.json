 "questions": [
  {
   "id": 677028,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Alexandra is working on the pricing strategy for her new food truck items. She is interested in knowing how many hamburgers she will need to sell in order to break even. Which formula should she use?",
   "answers": [
    {
     "id": 1345363,
     "content_html": "<span data-math=\"\\text{Fixed}\\;\\text{Costs + Variable}\\;\\text{Costs}\"></span>",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. It is not the break-even formula."
    },
    {
     "id": 1345362,
     "content_html": "<span data-math=\"\\text{Fixed}\\;\\text{Costs}-\\text{Variable}\\;\\text{Costs}\"></span>",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. It is not the break-even formula."
    },
    {
     "id": 1345361,
     "content_html": "<span data-math=\"\\text{Fixed}\\;\\text{Costs/(Unit}\\;\\text{Price + Variable}\\;\\text{Unit}\\;\\text{Cost})\"></span>",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. It is not the break-even formula."
    },
    {
     "id": 1345364,
     "content_html": "<span data-math=\"\\text{Fixed}\\;\\text{Costs/(Unit}\\;\\text{Price}-\\text{Variable}\\;\\text{Unit}\\;\\text{Cost})\"></span>",
     "correctness": "1.0",
     "feedback_html": "The break-even unit formula is Fixed Costs / (Unit Price &#43; Variable Unit Cost)"
    }
   ],
