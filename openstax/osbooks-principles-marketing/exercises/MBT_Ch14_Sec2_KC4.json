 "questions": [
  {
   "id": 677065,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jamal is trying to explain the difference between reach and frequency to his classmates. Which of the following best describes <i>reach</i>?",
   "answers": [
    {
     "id": 1345511,
     "content_html": "Interactions with an advertisement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. <i>Engagement</i> refers to any interaction with advertising content."
    },
    {
     "id": 1345510,
     "content_html": "Estimated number of times a potential customer will see an advertisement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. <i>Frequency</i> refers to the number of times a person is exposed to an advertisement or the number of times the advertisement is repeated within a given period of time."
    },
    {
     "id": 1345509,
     "content_html": "How quickly the audience will be reached with an advertisement",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. <i>Impact</i> refers to how quickly members of the audience receive an advertising message."
    },
    {
     "id": 1345512,
     "content_html": "Estimated number of potential customers to see an advertisement",
     "correctness": "1.0",
     "feedback_html": "<i>Reach</i> refers to the estimated number of potential customers that can be reached with an advertising campaign."
    }
   ],
   "hints": [],
