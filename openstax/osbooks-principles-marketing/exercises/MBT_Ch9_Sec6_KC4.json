   "id": 676960,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Jorge only purchases Apple computers and will not accept a substitute. Jorge can be considered a ________.",
   "answers": [
    {
     "id": 1345091,
     "content_html": "switcher",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Customers who frequently change brands are switchers. "
    },
    {
     "id": 1345090,
     "content_html": "shifting loyal",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. A shifting loyal changes loyalty from time to time. "
    },
    {
     "id": 1345089,
     "content_html": "split loyal",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Split loyal customers have a few brands that they frequently purchase in a category. "
    },
    {
     "id": 1345092,
     "content_html": "hard-core loyal",
     "correctness": "1.0",
     "feedback_html": "Hard-core loyal customers primarily purchase one brand in the category."
    }
   ],
