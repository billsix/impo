 "questions": [
  {
   "id": 677018,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Amir is the head of marketing and is explaining to colleagues that the company’s new boutique bed and breakfast near the ocean should not be priced similarly to the local Super 8 motel. Amir explains that the new bed and breakfast is of the highest quality, has posh amenities, and is therefore being marketed to upper- and upper-middle-class couples. Amir is explaining which of the critical Cs of pricing?",
   "answers": [
    {
     "id": 1345323,
     "content_html": "Cost",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. In the critical Cs of pricing, cost refers to determining the cost to produce a product."
    },
    {
     "id": 1345322,
     "content_html": "Competition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Analyzing competition refers to determining the positioning in a customer&#8217;s mind that two competing products hold."
    },
    {
     "id": 1345321,
     "content_html": "Customer",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The dimension of customers in the critical Cs of pricing refers to the value the customers will receive in an exchange."
    },
    {
     "id": 1345324,
     "content_html": "Compatibility",
     "correctness": "1.0",
     "feedback_html": "Compatibility refers to the consistency of pricing decisions with the other marketing mix elements."
    }
   ],
   "hints": [],
