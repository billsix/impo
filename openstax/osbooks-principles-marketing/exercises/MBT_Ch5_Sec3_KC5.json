 "questions": [
  {
   "id": 676856,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which Hofstede cultural dimension assesses the degree to which gender-specific roles are valued in a society?",
   "answers": [
    {
     "id": 1344675,
     "content_html": "Power distance index",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Power distance assesses the degree of power inequality within the culture and the degree to which people are accepting of this inequality."
    },
    {
     "id": 1344676,
     "content_html": "Masculinity/femininity",
     "correctness": "1.0",
     "feedback_html": "Masculinity/femininity assesses &#8220;masculine&#8221; values (such as achievement, ambition, and acquisition) versus &#8220;feminine&#8221; values like quality of life and service to others."
    },
    {
     "id": 1344674,
     "content_html": "Uncertainty avoidance",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Uncertainty avoidance assesses the degree to which the society is accepting of risk or ambiguity."
    },
    {
     "id": 1344673,
     "content_html": "Individualism versus collectivism",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Individualism versus collectivism refers to whether the culture emphasizes the needs and goals of the group as a whole or whether individual needs are paramount."
    }
   ],
   "hints": [],
   "formats": [
    "multiple-choice"
   ],
   "combo_choices": [],
   "collaborator_solutions": [
