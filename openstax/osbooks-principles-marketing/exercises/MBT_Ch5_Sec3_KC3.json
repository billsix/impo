 "questions": [
  {
   "id": 676854,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Alexis is making a sales presentation in Japan, and she realizes suddenly realizes that she is the only woman in the meeting. This suggests that Japan has a high ________.",
   "answers": [
    {
     "id": 1344667,
     "content_html": "degree of uncertainty avoidance",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Uncertainty avoidance refers to the degree to which a society avoids risk or ambiguity."
    },
    {
     "id": 1344666,
     "content_html": "individualism ranking",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Individualism versus collectivism refers to whether the culture emphasizes the needs and goals of the group as a whole or whether individual needs are paramount."
    },
    {
     "id": 1344665,
     "content_html": "power distance index",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Power distance refers to how much power inequality exists within a culture and the degree to which people are accepting of this inequality."
    },
    {
     "id": 1344668,
     "content_html": "masculinity ranking",
     "correctness": "1.0",
     "feedback_html": "In countries with a high masculinity ranking, men are intended to lead; women are supposed to follow."
    }
   ],
