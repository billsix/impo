 "questions": [
  {
   "id": 676963,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following functional benefits of packaging is at play when the package becomes a part of the product? ",
   "answers": [
    {
     "id": 1345103,
     "content_html": "Storage",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Storage protects the product from harm. "
    },
    {
     "id": 1345102,
     "content_html": "Convenience",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Convenience provides a means for transporting the product. "
    },
    {
     "id": 1345101,
     "content_html": "Safety",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Packaging can provide safety from personal harm from the product. "
    },
    {
     "id": 1345104,
     "content_html": "Usability",
     "correctness": "1.0",
     "feedback_html": "A package as product indicates usability."
    }
   ],
