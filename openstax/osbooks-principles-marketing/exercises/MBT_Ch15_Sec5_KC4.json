 "questions": [
  {
   "id": 677105,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sales promotion consists of a collection of incentive tools designed to do what for the product?",
   "answers": [
    {
     "id": 1345672,
     "content_html": "Stimulate demand",
     "correctness": "1.0",
     "feedback_html": "Sales promotion is primarily to stimulate demand in the short term."
    },
    {
     "id": 1345671,
     "content_html": "Create brand awareness",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sales promotion can increase brand awareness, but that is not the primary purpose."
    },
    {
     "id": 1345670,
     "content_html": "Provide free publicity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sales promotion does not provide free publicity."
    },
    {
     "id": 1345669,
     "content_html": "Inform",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Sales promotion does not inform, but it can lead to the consumer obtaining more information."
    }
   ],
