 "questions": [
  {
   "id": 676961,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following brand metrics measures intended behavior? ",
   "answers": [
    {
     "id": 1345095,
     "content_html": "Brand lift",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Brand lift measures how much consumer sentiment changes after a campaign. "
    },
    {
     "id": 1345094,
     "content_html": "Brand engagement",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Brand engagement measures how deeply the customer identifies with the brand. "
    },
    {
     "id": 1345096,
     "content_html": "Brand preference",
     "correctness": "1.0",
     "feedback_html": "Brand preference measures intended behavior."
    },
    {
     "id": 1345093,
     "content_html": "Brand equity",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Brand equity is a measure of the value of the brand over a substitute. "
    }
   ],
