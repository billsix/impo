 "questions": [
  {
   "id": 677022,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Sam is explaining to her friend Beth that prices for video conferencing software is increasing because more people are working from home. This relationship can be described by ________.",
   "answers": [
    {
     "id": 1345339,
     "content_html": "prestige pricing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Prestige pricing refers to the relationship between some high-priced items and increased demand."
    },
    {
     "id": 1345338,
     "content_html": "customer-driven pricing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Customer-driven pricing is when companies choose to set their prices based on customer-driven objectives (i.e., what the customer is willing to pay for a product or service)."
    },
    {
     "id": 1345340,
     "content_html": "the demand curve",
     "correctness": "1.0",
     "feedback_html": "The demand curve describes the relationship of demand and price for most goods and services."
    },
    {
     "id": 1345337,
     "content_html": "the income effect",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The income effect on pricing refers to buyers&#8217; belief in how much discretionary income they will have to spend."
    }
   ],
