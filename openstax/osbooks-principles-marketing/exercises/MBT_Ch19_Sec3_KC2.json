 "questions": [
  {
   "id": 677192,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which benefit of sustainability occurs when brands show their shareholders an economic return on sustainability programs?",
   "answers": [
    {
     "id": 1346019,
     "content_html": "Increased brand recognition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Increased brand recognition occurs when brands are known for their sustainability efforts."
    },
    {
     "id": 1346018,
     "content_html": "Reduced costs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Reduced costs are a benefit of sustainability but fall outside of economic return on programs."
    },
    {
     "id": 1346017,
     "content_html": "Waste minimization",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Waste may be minimized with sustainability efforts."
    },
    {
     "id": 1346020,
     "content_html": "Enhanced return on investment",
     "correctness": "1.0",
     "feedback_html": "Return on investment occurs when brands can show that the sustainability investment had a positive economic return."
    }
   ],
