 "questions": [
  {
   "id": 676821,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Nathan and his husband have decided to purchase a new car. They have narrowed their list to a few models and visited a few dealerships to see the models and test-drive them. Which stage of the consumer decision process does this illustrate?",
   "answers": [
    {
     "id": 1344535,
     "content_html": "Need recognition",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Need recognition involves perceiving a difference between your actual state and your desired state."
    },
    {
     "id": 1344534,
     "content_html": "Information search",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. It appears that Nathan and his husband have already done an information search and narrowed their alternatives down to a few models."
    },
    {
     "id": 1344536,
     "content_html": "Evaluation of alternatives",
     "correctness": "1.0",
     "feedback_html": "It appears that Nathan and his husband have already done an information search and are now evaluating their new car alternatives."
    },
    {
     "id": 1344533,
     "content_html": "Purchase decision",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Nathan and his husband are still visiting dealerships and taking test drives. They have not yet reached their purchase decision."
    }
   ],
