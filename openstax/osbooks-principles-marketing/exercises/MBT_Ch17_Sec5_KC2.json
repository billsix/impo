 "questions": [
  {
   "id": 677148,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following best demonstrates the role that marketing plays in supply chain management?",
   "answers": [
    {
     "id": 1345844,
     "content_html": "In order for companies to deliver on their value proposition to consumers, they must ensure that the activities and members in the supply chain share the common goal of delivering value to consumers.",
     "correctness": "1.0",
     "feedback_html": "In order for companies to deliver on their value proposition to consumers, they must ensure that the activities and members in the supply chain share the common goal of delivering value to consumers."
    },
    {
     "id": 1345843,
     "content_html": "Companies need to raise the price of their products with the supply chain in mind so that they earn a profit.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. There a variety of factors that influence the price companies set for a product."
    },
    {
     "id": 1345842,
     "content_html": "Companies must market their products to supply chain members in order to win partnership with them.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Companies need to do more than just market their products to supply chain members."
    },
    {
     "id": 1345841,
     "content_html": "Companies should only work with supply chain members who can save time and money in the distribution of products. Savings are most important to customers.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While working with supply chain members that can save time and money in the distribution of products is important, it does not account for the wants and needs of the customer."
    }
   ],
