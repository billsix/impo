 "questions": [
  {
   "id": 677092,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Lucia works for ABC Home Centers. The company sells roofing and windows to customers looking to make home improvements. Lucia’s main job with the company is to identify people who might be in the market for home improvement products. As part of Lucia’s job, she calls people to see if they would be interested in finding out more about ABC’s products. What stage of the sales process is Lucia doing?",
   "answers": [
    {
     "id": 1345619,
     "content_html": "Closing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Closing is when the sales professional asks for the sale."
    },
    {
     "id": 1345618,
     "content_html": "Handling objections",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Handling objections is the element of the sale when the sales professional works to show the customer why the products will be a good fit for their needs."
    },
    {
     "id": 1345617,
     "content_html": "Presentation",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The presentation is when the sales professional demonstrates and discusses the features and benefits of the product."
    },
    {
     "id": 1345620,
     "content_html": "Prospecting and qualifying",
     "correctness": "1.0",
     "feedback_html": "Lucia is trying to find the qualified people to buy the products."
    }
   ],
