 "questions": [
  {
   "id": 676775,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following accurately represents the evolution of marketing?",
   "answers": [
    {
     "id": 1344352,
     "content_html": "Production, product, sales, marketing, societal",
     "correctness": "1.0",
     "feedback_html": "This order accurately represents the evolution of marketing."
    },
    {
     "id": 1344351,
     "content_html": "Product, sales, production, marketing, societal",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The production era preceded the sales era is concerned with the operations of manufacturing the product a company intends to sell."
    },
    {
     "id": 1344350,
     "content_html": "Marketing, production, sales, societal, product",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The marketing era preceded the societal era."
    },
    {
     "id": 1344349,
     "content_html": "Societal, production, sales, marketing, product",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The societal era is the most current era, and so it should appear last in the sequence."
    }
   ],
