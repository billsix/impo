   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The United States, Canada, and Mexico are part of a trade bloc known as ________.",
   "answers": [
    {
     "id": 1344835,
     "content_html": "ASEAN",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. ASEAN is a trade bloc of Asian countries."
    },
    {
     "id": 1344836,
     "content_html": "USMCA",
     "correctness": "1.0",
     "feedback_html": "The USMCA is a trade bloc agreement between the United States, Mexico, and Canada."
    },
    {
     "id": 1344834,
     "content_html": "tariffs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Tariffs are taxes on imports."
    },
    {
     "id": 1344833,
     "content_html": "embargoes",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Embargoes are halts of trade of certain products or with certain countries."
    }
   ],
