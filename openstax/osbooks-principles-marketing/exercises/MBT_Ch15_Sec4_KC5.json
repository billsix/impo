 "questions": [
  {
   "id": 677101,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Ranee is concerned with making sure she has a set number of appointments with customers each week. Ranee is most likely being evaluated based on what?",
   "answers": [
    {
     "id": 1345656,
     "content_html": "Percent of time spent on selling activities",
     "correctness": "1.0",
     "feedback_html": "Ranee needs to spend time on selling activities."
    },
    {
     "id": 1345655,
     "content_html": "Percent of time spent generating leads",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A focus on generating leads would not include meeting with current customers."
    },
    {
     "id": 1345654,
     "content_html": "Time it takes her to develop a proposal",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Evaluation based on developing proposals would not include setting appointments with current customers each week."
    },
    {
     "id": 1345653,
     "content_html": "Percent of time working in the CRM",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Working in the CRM is time spent at a computer."
    }
   ],
