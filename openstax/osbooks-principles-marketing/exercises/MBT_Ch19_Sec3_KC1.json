 "questions": [
  {
   "id": 677191,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is the sustainability strategy benefit when a company becomes known for its sustainability efforts and it becomes a competitive advantage?",
   "answers": [
    {
     "id": 1346016,
     "content_html": "Increased brand recognition",
     "correctness": "1.0",
     "feedback_html": "Increased brand recognition occurs when brands are known for their sustainability efforts."
    },
    {
     "id": 1346015,
     "content_html": "Reduced costs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Reduced costs are a benefit, but they occur when the brand saves money on packaging, energy costs, etc."
    },
    {
     "id": 1346014,
     "content_html": "Waste minimization",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Waste may be minimized with sustainability efforts."
    },
    {
     "id": 1346013,
     "content_html": "Enhanced return on investment",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Enhanced return on investment often occurs with sustainability efforts, but that is not something that the consumer recognizes."
    }
   ],
