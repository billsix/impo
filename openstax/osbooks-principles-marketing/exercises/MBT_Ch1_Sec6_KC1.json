 "questions": [
  {
   "id": 676782,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Customer relationship management is accomplished by all of the following EXCEPT ________.",
   "answers": [
    {
     "id": 1344379,
     "content_html": "establishing and tracking customer interactions",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Establishing and tracking customer interactions is essential to achieving customer relationship management."
    },
    {
     "id": 1344378,
     "content_html": "finding ways of improving customer satisfaction from prior customer experiences",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Finding ways of improving customer satisfaction is one way of achieving customer relationship management."
    },
    {
     "id": 1344377,
     "content_html": "communicating with customers in a personalized way",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Communicating with customers in a personalized way"
    },
    {
     "id": 1344380,
     "content_html": "offering the lowest price of all the companies on the market",
     "correctness": "1.0",
     "feedback_html": "All the other choices are ways of achieving customer relationship management. Offering the lowest price of all companies on the market is not."
    }
   ],
