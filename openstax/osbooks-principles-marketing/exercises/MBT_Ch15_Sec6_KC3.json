   "id": 677109,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following allows consumers to do things in order to have a chance of winning?",
   "answers": [
    {
     "id": 1345687,
     "content_html": "Coupons",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Coupons provide a saving off of the purchase of a specific product."
    },
    {
     "id": 1345688,
     "content_html": "Sweepstakes",
     "correctness": "1.0",
     "feedback_html": "Sweepstakes give consumers a chance to win when they purchase something or follow the rules of the sweepstakes."
    },
    {
     "id": 1345686,
     "content_html": "Contests",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Contests make consumers use their skills to compete for prizes."
    },
    {
     "id": 1345685,
     "content_html": "Rebates",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Rebates provide money back after the purchase."
    }
