 "questions": [
  {
   "id": 677026,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When the price of a product increases and the demand for its substitute product increases, this is explained by ________.",
   "answers": [
    {
     "id": 1345355,
     "content_html": "elasticity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A product&#8217;s degree of elasticity explains the change in demand based on the change in price."
    },
    {
     "id": 1345354,
     "content_html": "inelasticity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Inelasticity suggests there is no change in demand."
    },
    {
     "id": 1345353,
     "content_html": "a change in income",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The income effect on pricing refers to buyers&#8217; belief in how much discretionary income they will have to spend. However, it does affect the demand for products."
    },
    {
     "id": 1345356,
     "content_html": "cross-elasticity of demand",
     "correctness": "1.0",
     "feedback_html": "Cross-elasticity of demand refers to the increase in demand for a substitute product when the price of a product increases."
    }
   ],
