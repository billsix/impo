 "questions": [
  {
   "id": 676978,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "You’ve gathered customers in the target market and presented them with a description of the product concept you have selected. This process is known as ________.",
   "answers": [
    {
     "id": 1345163,
     "content_html": "prototyping",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A prototype is an early model of a new product that R&#38;D develops in order to be able to test the design."
    },
    {
     "id": 1345164,
     "content_html": "concept testing",
     "correctness": "1.0",
     "feedback_html": "Concept testing is a research method that involves determining how customers feel about the new product before actually launching it."
    },
    {
     "id": 1345162,
     "content_html": "test-marketing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Test-marketing is a strategy used by companies to check the viability of their new product before it is launched into the market on a large scale."
    },
    {
     "id": 1345161,
     "content_html": "crowdsourcing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Crowdsourcing is the process of accessing groups of people and tapping into their knowledge to create something of value."
    }
   ],
