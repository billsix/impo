  {
   "id": 676889,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Being aware of and appreciating variations in culture is known as ________.",
   "answers": [
    {
     "id": 1344808,
     "content_html": "cultural sensitivity",
     "correctness": "1.0",
     "feedback_html": "Cultural sensitivity involves a person&#8217;s ability to be aware of and appreciate cultural differences."
    },
    {
     "id": 1344807,
     "content_html": "cultural barriers",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cultural barriers are differences in culture that prohibit common ground."
    },
    {
     "id": 1344806,
     "content_html": "cultural differences",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cultural differences are variations among cultures."
    },
    {
     "id": 1344805,
     "content_html": "marketing regulations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Marketing regulations are differences in rules and policies related to marketing in various countries."
    }
   ],
