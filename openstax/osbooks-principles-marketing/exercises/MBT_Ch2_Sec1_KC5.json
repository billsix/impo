 "questions": [
  {
   "id": 676791,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In “SMART goals,” what does the “R” stand for?",
   "answers": [
    {
     "id": 1344415,
     "content_html": "Relatable",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Relatable goals are not what the &#8220;R&#8221; stands for."
    },
    {
     "id": 1344414,
     "content_html": "Rational",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Although rational goals are admirable, that is not what the &#8220;R&#8221; in the acronym SMART stands for."
    },
    {
     "id": 1344413,
     "content_html": "Required",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Required goals are not what the &#8220;R&#8221; stands for."
    },
    {
     "id": 1344416,
     "content_html": "Realistic",
     "correctness": "1.0",
     "feedback_html": "Goals should be realistic and have a reasonable chance of being met."
    }
   ],
