 "questions": [
  {
   "id": 677173,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Cam posts numerous times on TikTok and Instagram. As a result, she is asked to work as an influencer for a major retailer. Which trend in retailing is Cam a part of?",
   "answers": [
    {
     "id": 1345943,
     "content_html": "Online stores in offline spaces",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Online stores in offline spaces refers to the ability of a consumer to purchase products online and pick up in person."
    },
    {
     "id": 1345942,
     "content_html": "E-commerce",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. E-commerce refers to a consumer&#8217;s ability to shop from home and order products online."
    },
    {
     "id": 1345944,
     "content_html": "Social commerce",
     "correctness": "1.0",
     "feedback_html": "Social commerce is a blend of e-commerce and social media, where retailers often use influencers to market products."
    },
    {
     "id": 1345941,
     "content_html": "Same-day delivery",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Same-day delivery refers to a consumer&#8217;s ability to order and receive a product on the same day."
    }
   ],
