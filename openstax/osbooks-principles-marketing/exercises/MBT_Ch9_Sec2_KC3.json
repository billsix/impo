   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If Domino's were to add a Chicago-style stuffed pizza to its menu, this would represent an expansion of the ________ of its pizza offerings.",
   "answers": [
    {
     "id": 1345008,
     "content_html": "product line depth",
     "correctness": "1.0",
     "feedback_html": "An addition of a type of pizza would represent product line depth."
    },
    {
     "id": 1345007,
     "content_html": "product mix width",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. The product mix width represents all the products that the brand carries."
    },
    {
     "id": 1345006,
     "content_html": "product items",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Product items is not a marketing concept."
    },
    {
     "id": 1345005,
     "content_html": "product differentiation",
     "correctness": "0.0",
     "feedback_html": "That’s not correct. Product differentiation is a concept that highlights a reason to purchase. "
    }
