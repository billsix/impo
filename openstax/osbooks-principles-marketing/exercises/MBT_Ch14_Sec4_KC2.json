   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a way companies attempt to influence public policy and law?",
   "answers": [
    {
     "id": 1345543,
     "content_html": "Press relations",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Press relations creates positive relationships with news media."
    },
    {
     "id": 1345542,
     "content_html": "Events",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Events are used to raise awareness and increase brand image."
    },
    {
     "id": 1345544,
     "content_html": "Lobbying",
     "correctness": "1.0",
     "feedback_html": "Lobbying involves attempts to influence public policy and law."
    },
    {
     "id": 1345541,
     "content_html": "Publicity",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Publicity is used to raise awareness of a product, organization, or person."
    }
