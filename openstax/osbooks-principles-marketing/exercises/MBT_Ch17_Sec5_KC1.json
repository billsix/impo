 "questions": [
  {
   "id": 677147,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "________ entails managing all the members and activities from the procurement and transformation of raw materials into finished goods through their distribution to targeted consumers.",
   "answers": [
    {
     "id": 1345839,
     "content_html": "Logistics",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Logistics is a function that involves the coordination of all supply chain activities, such as warehousing, inventory management, and transportation."
    },
    {
     "id": 1345838,
     "content_html": "Integrated logistics management",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Integrated logistics management involves the cohesive, synergistic integration of all logistics activities."
    },
    {
     "id": 1345840,
     "content_html": "Supply chain management",
     "correctness": "1.0",
     "feedback_html": "Supply chain management entails managing all the members and activities from the procurement and transformation of raw materials into finished goods through their distribution to targeted consumers."
    },
    {
     "id": 1345837,
     "content_html": "Warehousing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Warehousing involves the stocking, maintaining, and controlling of products while they await the next step in their journey to the end consumer."
    }
   ],
