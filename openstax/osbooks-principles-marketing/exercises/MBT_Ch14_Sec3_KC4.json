 "questions": [
  {
   "id": 677070,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Indicators that measure the effectiveness of an advertising campaign are known as ________.",
   "answers": [
    {
     "id": 1345531,
     "content_html": "KMAs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. KMA is not an indicator of advertising campaign effectiveness."
    },
    {
     "id": 1345530,
     "content_html": "Recalls",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Recalls are not a measure of campaign effectiveness."
    },
    {
     "id": 1345529,
     "content_html": "ROIs",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. ROI stands for return-on-investment, which focuses on every dollar spent on advertising, not just campaign effectiveness."
    },
    {
     "id": 1345532,
     "content_html": "KPIs",
     "correctness": "1.0",
     "feedback_html": "KPIs, or key performance indicators, measure the effectiveness of an advertising campaign."
    }
   ],
