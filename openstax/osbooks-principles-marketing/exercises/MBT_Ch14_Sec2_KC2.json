   "id": 677063,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As a marketer in charge of a new advertising campaign, what is the first step you will utilize in planning?",
   "answers": [
    {
     "id": 1345503,
     "content_html": "Determine a budget",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Determining the budget is not the first step in advertising planning."
    },
    {
     "id": 1345502,
     "content_html": "Decide on a push or pull strategy",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Deciding on a push or pull strategy is not the first step in advertising planning."
    },
    {
     "id": 1345504,
     "content_html": "State the objectives",
     "correctness": "1.0",
     "feedback_html": "The first step in advertising planning is determining objectives."
    },
    {
     "id": 1345501,
     "content_html": "Execute the plan",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Executing the plan happens later in advertising planning."
    }
