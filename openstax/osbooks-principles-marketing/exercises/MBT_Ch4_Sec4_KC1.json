 "questions": [
  {
   "id": 676837,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A blueprint that outlines the product the company will be building, what it is going to look like, and its specific requirements and functions is known as a ________.",
   "answers": [
    {
     "id": 1344599,
     "content_html": "project scope",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A project scope statement provides a detailed description of the work that must be done to deliver the output of a project on time and within the allotted budget."
    },
    {
     "id": 1344598,
     "content_html": "bill of materials",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A bill of materials is a comprehensive list of raw materials, subassemblies, subcomponents, etc. and the quantities of each needed to manufacture an end product."
    },
    {
     "id": 1344600,
     "content_html": "product specification",
     "correctness": "1.0",
     "feedback_html": "The purpose of a product specification is to provide a description and statement of the requirements of a product, the components of a product, the capability or performance of a product, and/or the service or work to be performed to create a product."
    },
    {
     "id": 1344597,
     "content_html": "participant matrix",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. A participant matrix is a project management tool used to analyze a project participant to determine the actions which are necessary to align their goals with the project."
    }
   ],
