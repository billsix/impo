 "questions": [
  {
   "id": 677061,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a false statement about advertising?",
   "answers": [
    {
     "id": 1345495,
     "content_html": "It is still as important to the promotion mix as other elements.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising is still important to the promotion mix despite changes in consumers&#8217; habits."
    },
    {
     "id": 1345496,
     "content_html": "It is the least costly of all promotion mix elements.",
     "correctness": "1.0",
     "feedback_html": "Advertising is still one of the costlier elements of the promotion mix."
    },
    {
     "id": 1345494,
     "content_html": "It should always be a well-thought-out strategy.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising should always be well thought out and have the right message at the right time for the right audience."
    },
    {
     "id": 1345493,
     "content_html": "It assists in consumer awareness and brand loyalty.",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Advertising does assist in consumer awareness and brand loyalty."
    }
   ],
   "hints": [],
   "formats": [
