 "questions": [
  {
   "id": 677037,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The goal of an integrated marketing communications (IMC) program is to ________.",
   "answers": [
    {
     "id": 1345400,
     "content_html": "have all of a company’s marketing and promotional activities project a consistent image and message to its target market",
     "correctness": "1.0",
     "feedback_html": "The goal of IMC is to communicate a clear and consistent message through various promotional mix methods that will reach the various segments of the target market."
    },
    {
     "id": 1345399,
     "content_html": "control all facets of a product’s distribution",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. IMC does not control distribution."
    },
    {
     "id": 1345398,
     "content_html": "communicate with customers only through television commercials",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. While television advertising is one of the many tactics of the advertising promotional method, IMC focuses on many different methods in order to reach the consumer."
    },
    {
     "id": 1345397,
     "content_html": "have complete control over all facets of the marketing mix",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. The marketing mix is product, price, place, and promotion; IMC is focused specifically on promotion."
    }
   ],
