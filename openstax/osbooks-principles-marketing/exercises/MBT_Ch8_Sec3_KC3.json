 "questions": [
  {
   "id": 676919,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Marketers must be careful when using symbols as cultural expressions because ________.",
   "answers": [
    {
     "id": 1344927,
     "content_html": "there are too many to choose from among different cultures",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Quantity isn&#8217;t a concern in the usage of symbols."
    },
    {
     "id": 1344928,
     "content_html": "they can have different meanings among different cultures",
     "correctness": "1.0",
     "feedback_html": "Marketers must be careful using symbols as cultural expressions because they can have different meanings among different cultures. "
    },
    {
     "id": 1344926,
     "content_html": "they can have similar meanings among different cultures",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Similar meanings between symbols is not the concern."
    },
    {
     "id": 1344925,
     "content_html": "they are verbal and nonverbal forms of communication",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Symbols may also communicate messages visually, not verbally."
    }
   ],
