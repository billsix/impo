 "questions": [
  {
   "id": 677031,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "David hopes to capture as much of the market as possible with the company’s new product. Which pricing strategy should David use?",
   "answers": [
    {
     "id": 1345375,
     "content_html": "Price skimming",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Price skimming sets the highest price possible to capture the portion of the market willing to pay those prices."
    },
    {
     "id": 1345374,
     "content_html": "Cost-based pricing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Cost-based pricing sets prices to cover the costs associated with production."
    },
    {
     "id": 1345373,
     "content_html": "Psychological pricing",
     "correctness": "0.0",
     "feedback_html": "That&#8217;s not correct. Psychological pricing uses the consumer&#8217;s psyche to set prices."
    },
    {
     "id": 1345376,
     "content_html": "Penetration pricing",
     "correctness": "1.0",
     "feedback_html": "Penetration pricing attempts to capture the greatest market share possible when introducing a new product."
    }
   ],
