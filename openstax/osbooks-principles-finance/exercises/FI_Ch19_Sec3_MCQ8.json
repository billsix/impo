   "id": 198099,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A large retailer has more than $100 million of cash and cash equivalents on its balance sheet. Which of the following would not be part of the cash equivalents?",
   "answers": [
    {
     "id": 691725,
     "content_html": "cash in banks (checking account balances)"
    },
    {
     "id": 691726,
     "content_html": "US Treasury bond maturing in two years"
    },
    {
     "id": 691727,
     "content_html": "receivables from a bank that processes credit card payments"
    },
    {
     "id": 691728,
     "content_html": "commercial paper"
    }
   ],
