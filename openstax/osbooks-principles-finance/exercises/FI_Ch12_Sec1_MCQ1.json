 "questions": [
  {
   "id": 192843,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about Treasury bills is false?",
   "answers": [
    {
     "id": 689301,
     "content_html": "T-bills sell at a discount from face value and pay the face value at maturity."
    },
    {
     "id": 689302,
     "content_html": "T-bills have maturities of 2, 3, 5, 7, or 10 years."
    },
    {
     "id": 689303,
     "content_html": "T-bill auctions take place weekly."
    },
    {
     "id": 689304,
     "content_html": "T-bill denominations are relatively small compared to other money market instruments, with initial auction sizes of as little as $10,000 per T-bill."
    }
   ],
