  {
   "id": 199043,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A foreign exchange forward contract ________.",
   "answers": [
    {
     "id": 692385,
     "content_html": "is a standardized contract that is inflexible"
    },
    {
     "id": 692386,
     "content_html": "occurs when a company swaps its translation exposure for transaction exposure"
    },
    {
     "id": 692387,
     "content_html": "is a contractual agreement between two parties to exchange a specified amount of currencies on a future date"
    },
    {
     "id": 692388,
     "content_html": "states the date on which a trade will take place, but the price for the trade will be determined at the time the trade occurs"
    }
   ],
