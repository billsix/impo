 "questions": [
  {
   "id": 199351,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Your friend Jamal borrows $5,000 from you, agreeing to pay you back with 8% annual interest, with the first payment due to you one year from today. You ask that you be fully repaid over the next four years. However, to lower his annual payment, Jamal asks you to extend the period over five full years instead. What will be the approximate <b>difference</b> in his total payments to you, including interest and principal, if the debt is amortized over five years rather than four?",
   "answers": [
    {
     "id": 692513,
     "content_html": "Jamal will pay $544 less."
    },
    {
     "id": 692514,
     "content_html": "Jamal will pay $544 more."
    },
    {
     "id": 692515,
     "content_html": "Jamal will pay $223 less."
    },
    {
