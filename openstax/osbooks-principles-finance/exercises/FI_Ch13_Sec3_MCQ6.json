   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The results of a standardized test indicate that you are in the 85th percentile. What is the best interpretation of this result?",
   "answers": [
    {
     "id": 690714,
     "content_html": "You scored in the top 85% of all students taking the test."
    },
