  {
   "id": 197434,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A company is said to be in financial distress if ________.",
   "answers": [
    {
     "id": 691249,
     "content_html": "it is not fully exploiting the interest tax shield"
    },
    {
     "id": 691250,
     "content_html": "it needs to raise capital to finance a new project"
    },
    {
     "id": 691251,
     "content_html": "it has difficulty meeting its debt obligations"
    },
    {
     "id": 691252,
     "content_html": "its cost of equity capital exceeds its cost of debt capital"
    }
   ],
