   "stimulus_html": "",
   "stem_html": "As the number of stocks in a portfolio increases, _______________.",
   "answers": [
    {
     "id": 690179,
     "content_html": "firm-specific risk increases"
    },
    {
     "id": 690180,
     "content_html": "systematic risk becomes zero"
    },
    {
     "id": 690181,
     "content_html": "systematic risk decreases and returns increase"
    },
    {
     "id": 690182,
     "content_html": "firm-specific risk is reduced but systematic risk remains"
