 "questions": [
  {
   "id": 197428,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In perfect capital markets, ________.",
   "answers": [
    {
     "id": 691225,
     "content_html": "a company’s WACC does not change as it changes its capital structure"
    },
    {
     "id": 691226,
     "content_html": "a company can lower its WACC by using more debt in its capital structure"
    },
    {
     "id": 691227,
     "content_html": "a company can lower its WACC by using more equity in its capital structure"
    },
    {
     "id": 691228,
     "content_html": "a company’s cost of debt capital is exactly equal to its cost of equity capital when the company uses 50% debt and 50% equity in its capital structure"
    }
   ],
