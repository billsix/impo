 "questions": [
  {
   "id": 190556,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The unemployment rate equals _______________.",
   "answers": [
    {
     "id": 687913,
     "content_html": "the number of people unemployed divided by the labor force"
    },
    {
     "id": 687914,
     "content_html": "the number of people seeking work divided by the adult population"
    },
    {
     "id": 687915,
     "content_html": "the number of people unemployed divided by the number of people employed"
    },
    {
     "id": 687916,
     "content_html": "the number of people unemployed plus the number of people working part-time divided by the adult population"
    }
   ],
