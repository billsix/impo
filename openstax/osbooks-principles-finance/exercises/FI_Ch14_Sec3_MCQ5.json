 "questions": [
  {
   "id": 180782,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is the best interpretation for the slope of the linear regression model?",
   "answers": [
    {
     "id": 675228,
     "content_html": "The slope is the expected mean value of <i>y</i> when the <i>x</i>-variable is equal to zero."
    },
    {
     "id": 675229,
     "content_html": "The slope indicates the change in <i>y</i> for every unit increase in <i>x</i>."
    },
    {
     "id": 675230,
     "content_html": "The slope indicates the strength of the linear relationship between <i>x</i> and <i>y</i>."
    },
    {
     "id": 675231,
     "content_html": "The slope indicates the direction of the linear relationship between <i>x</i> and <i>y</i>."
    }
   ],
