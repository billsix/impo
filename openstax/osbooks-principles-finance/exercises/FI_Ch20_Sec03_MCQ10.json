 "questions": [
  {
   "id": 198268,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In January, the exchange rate between the South Korean won and the US dollar was <span data-math=\"{\\rm{KWN\\;1,100 = USD\\;1}}\"></span>. Three months later, the exchange rate was <span data-math=\"{\\rm{KWN\\;1,200 = USD\\;1}}\"></span>. This means that ________.",
   "answers": [
    {
     "id": 691997,
     "content_html": "it will cost US companies more to purchase raw materials from South Korea"
    },
    {
     "id": 691998,
     "content_html": "it will cost Korean companies more to purchase raw materials from the United States"
    },
    {
     "id": 691999,
     "content_html": "US companies that sell their products in South Korea will find their revenue has increased"
    },
    {
     "id": 692000,
     "content_html": "Korean companies that sell their products in the United States will find that their revenue has decreased"
    }
   ],
