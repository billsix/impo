   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "What is the formula for the calculation of earnings per share?",
   "answers": [
    {
     "id": 690986,
     "content_html": "(net income + preferred dividends) / weighted average common shares outstanding"
    },
    {
     "id": 690987,
     "content_html": "net income / weighted average common shares outstanding"
    },
    {
     "id": 690988,
     "content_html": "(net income – preferred dividends) / weighted average common shares outstanding"
    },
    {
     "id": 690989,
     "content_html": "(net income – preferred dividends) / treasury shares outstanding"
    }
