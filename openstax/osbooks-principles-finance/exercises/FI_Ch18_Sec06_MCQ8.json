 "questions": [
  {
   "id": 197205,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Amelia wants to use a formula in Excel to estimate her utilities expense for each month. She normally pays her utilities within 30 days. What formula or link might she use in Excel to estimate her cash outflow for utilities?",
   "answers": [
    {
     "id": 690882,
     "content_html": "Sum the past three months’ cost of goods sold from the forecasted income statement"
    },
    {
     "id": 690883,
     "content_html": "Link to the prior month’s accounts payable from the forecasted balance sheet"
    },
    {
     "id": 690884,
     "content_html": "Link to the prior month’s utilities expense from the forecasted balance sheet"
    },
    {
     "id": 690885,
     "content_html": "Link to the prior month’s ending cash balance from the cash flow forecast"
    }
   ],
