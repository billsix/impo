  {
   "id": 199047,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "A swap occurs when ________.",
   "answers": [
    {
     "id": 692401,
     "content_html": "a company exchanges obligations with another company to make specified payment streams"
    },
    {
     "id": 692402,
     "content_html": "a company purchases commodities from a company in another country, exposing it to both commodity and currency risk"
    },
    {
     "id": 692403,
     "content_html": "a company chooses a local supplier over an international supplier to avoid currency exposure"
    },
    {
     "id": 692404,
     "content_html": "a company chooses a foreign supplier so that its commodity risk will be offset by its currency risk"
    }
   ],
