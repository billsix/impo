   "id": 191902,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "An important advantage of a sole proprietorship is that _______________.",
   "answers": [
    {
     "id": 689130,
     "content_html": "it is easier to raise capital under such a structure than under other organizational forms"
    },
    {
     "id": 689131,
     "content_html": "it allows for an unlimited life of the business"
    },
    {
     "id": 689132,
     "content_html": "it is relatively easy to create"
    },
    {
     "id": 689133,
     "content_html": "Both a and b are correct."
    }
