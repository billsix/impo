 "questions": [
  {
   "id": 191887,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following statements regarding data is generally NOT true?",
   "answers": [
    {
     "id": 689106,
     "content_html": "Financial data is important for internal and external analysis of business firms."
    },
    {
     "id": 689107,
     "content_html": "Outsiders use publicly available data about firms to make investment and regulatory decisions."
    },
    {
     "id": 689108,
     "content_html": "“Gut feelings” decision-making tends to be more consistent with value maximization."
    },
    {
     "id": 689109,
     "content_html": "Suppliers need financial information to determine if they should supply trade credit, and customers need to know if a firm’s products are reliable and appropriately priced."
    }
   ],
