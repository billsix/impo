  {
   "id": 180786,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "As predictions are made for <i>x</i>-values that are further and further away from the mean of <i>x</i>, which is true about the prediction intervals for these <i>x</i>-values?",
   "answers": [
    {
     "id": 675244,
     "content_html": "The prediction intervals will become smaller."
    },
    {
     "id": 675245,
     "content_html": "The prediction intervals will become larger."
    },
    {
     "id": 675246,
     "content_html": "The prediction intervals will remain the same."
    },
    {
     "id": 675247,
     "content_html": "There is not enough information to determine the answer."
    }
