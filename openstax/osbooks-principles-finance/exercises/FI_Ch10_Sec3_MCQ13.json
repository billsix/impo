   "stimulus_html": "",
   "stem_html": "An inverted yield curve is an indication that ________.",
   "answers": [
    {
     "id": 690115,
     "content_html": "long-term yields and interest rates are higher than short-term rates"
    },
    {
     "id": 690116,
     "content_html": "the economy is in the process of a significant recovery"
    },
    {
     "id": 690117,
     "content_html": "short-term yields and interest rates are higher than long-term rates"
    },
    {
     "id": 690118,
     "content_html": "the yields to maturity on all bonds are less than market interest rates"
    }
