 "questions": [
  {
   "id": 198266,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "In January, the exchange rate between the South Korean won and the US dollar was <span data-math=\"{\\rm{KWN\\;1,100 = USD\\;1}}\"></span>. Three months later, the exchange rate was <span data-math=\"{\\rm{KWN\\;1,200 = USD\\;1}}\"></span>. This means that ________.",
   "answers": [
    {
     "id": 691989,
     "content_html": "the Korean won appreciated relative to the US dollar"
    },
    {
     "id": 691990,
     "content_html": "the Korean won depreciated relative to the US dollar"
    },
    {
     "id": 691991,
     "content_html": "the US dollar depreciated relative to the Korean won"
    },
    {
     "id": 691992,
     "content_html": "both the Korean won and the US dollar appreciated"
    }
   ],
