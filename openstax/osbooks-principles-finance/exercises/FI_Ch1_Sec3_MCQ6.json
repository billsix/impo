   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is generally NOT true about cloud data storage versus on-site data storage?",
   "answers": [
    {
     "id": 689114,
     "content_html": "Cloud data storage provides storage cost advantages."
    },
    {
     "id": 689115,
     "content_html": "Cloud data storage causes increased energy consumption."
    },
    {
     "id": 689116,
     "content_html": "Cloud data storage comes with specialized data protection services."
    },
    {
     "id": 689117,
     "content_html": "Cloud data storage comes with specialized maintenance services."
    }
