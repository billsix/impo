   "stimulus_html": "",
   "stem_html": "How are standard deviation and variance related?",
   "answers": [
    {
     "id": 690698,
     "content_html": "The two measures are equal to one another."
    },
    {
     "id": 690699,
     "content_html": "Variance is the square root of the standard deviation."
    },
    {
     "id": 690700,
     "content_html": "Standard deviation is the square root of the variance."
    },
    {
     "id": 690701,
     "content_html": "The two squared measures are equal to one another."
    }
