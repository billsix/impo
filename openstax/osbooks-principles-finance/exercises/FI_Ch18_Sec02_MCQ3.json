   "id": 197194,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Jamal wants to forecast sales for the first quarter of next year. His first assumption is that sales will likely grow by 3% in the coming year. If Jamal’s monthly sales were $10,000, $9,000, and $11,000 in the first quarter of this year, what should his sales forecast be for the first quarter of next year? ",
   "answers": [
    {
     "id": 690838,
     "content_html": "$30,000"
    },
    {
     "id": 690839,
     "content_html": "$30,900"
    },
    {
     "id": 690840,
     "content_html": "$33,000"
    },
    {
     "id": 690841,
     "content_html": "$33,500"
    }
   ],
