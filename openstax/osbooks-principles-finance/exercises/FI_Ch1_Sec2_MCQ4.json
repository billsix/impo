 "questions": [
  {
   "id": 189855,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements is false?",
   "answers": [
    {
     "id": 687733,
     "content_html": "Financial planning is an important tool of for-profit organizations such as corporations and partnerships but is not important for not-for-profit enterprises such charitable organizations or governments."
    },
    {
     "id": 687734,
     "content_html": "Good financial planning considers past, present, and pro forma income statements."
    },
    {
     "id": 687735,
     "content_html": "Balance sheets are critical elements of the financial planning process and help demonstrate expected sources and uses of funds."
    },
    {
     "id": 687736,
     "content_html": "Forecasting in the form of expected sales, cost of funds, and micro- and macroeconomic conditions are essential elements of financial planning."
    }
   ],
