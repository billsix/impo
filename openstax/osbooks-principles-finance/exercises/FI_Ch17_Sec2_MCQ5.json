 "questions": [
  {
   "id": 197421,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following would be the most reasonable approach to calculating the cost of debt for a company?",
   "answers": [
    {
     "id": 691197,
     "content_html": "Using the coupon rate on the company’s existing bonds"
    },
    {
     "id": 691198,
     "content_html": "Using the interest amount reported on the income statement"
    },
    {
     "id": 691199,
     "content_html": "Using the yield to maturity on the company’s existing bonds"
    },
    {
     "id": 691200,
     "content_html": "Multiplying the amount of debt on the company’s balance sheet by the risk-free rate"
    }
   ],
