   "id": 190631,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The corporate press release is _______________.",
   "answers": [
    {
     "id": 688058,
     "content_html": "no longer an important component of modern investor relations strategy"
    },
    {
     "id": 688059,
     "content_html": "not yet a thing of the past, though it is highly likely to be replaced by social media in the near future"
    },
    {
     "id": 688060,
     "content_html": "written by the chief financial officer in conjunction with the audit committee"
    },
    {
     "id": 688061,
     "content_html": "best written to be easy to understand, free of corporate jargon, and as concise as possible"
    }
   ],
