 "questions": [
  {
   "id": 197218,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Amelia wants to use a formula in Excel to estimate her sales for each month. She believes her sales for the next year will be about 7% higher than this year’s. She also has a big new ad campaign running late this year that she thinks will add another $5,000 to January sales. Which of the following is an appropriate Excel formula for Amelia’s January sales?",
   "answers": [
    {
     "id": 690902,
     "content_html": "=(lastyearsalesA2*1.07)+5000"
    },
    {
     "id": 690903,
     "content_html": "=(lastyearsales+5000*1.07)"
    },
    {
     "id": 690904,
     "content_html": "=lastyearsalesA2+5000*.07"
    },
    {
     "id": 690905,
     "content_html": "=lastyearsalesA2*5000*1.07"
    }
   ],
