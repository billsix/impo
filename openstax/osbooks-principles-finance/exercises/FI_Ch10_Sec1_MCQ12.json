   "stimulus_html": "",
   "stem_html": "The coupon rate of a bond is typically ________.",
   "answers": [
    {
     "id": 688744,
     "content_html": "fixed at the time of bond issuance"
    },
    {
     "id": 688745,
     "content_html": "subject to change based on the federal funds rate"
    },
    {
     "id": 688746,
     "content_html": "zero in the case of zero-coupon bonds"
    },
    {
     "id": 688747,
     "content_html": "Both A and C"
