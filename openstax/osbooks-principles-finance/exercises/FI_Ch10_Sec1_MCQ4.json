  {
   "id": 191744,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "When solving bond problems relating to a bond that pays interest on a quarterly basis, the ________ before being applied.",
   "answers": [
    {
     "id": 688728,
     "content_html": "quoted annual yield to maturity should be multiplied by 4"
    },
    {
     "id": 688729,
     "content_html": "quoted number of years until maturity should be divided by 4"
    },
    {
     "id": 688730,
     "content_html": "quoted annual coupon payments should be divided by 4"
    },
    {
     "id": 688731,
     "content_html": "stated face value should be divided by 4"
    }
   ],
