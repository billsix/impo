   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "An S corporation _______________.",
   "answers": [
    {
     "id": 688070,
     "content_html": "is taxed in the same manner as a C corporation"
    },
    {
     "id": 688071,
     "content_html": "is eligible for more efficient financing in the face of company growth than a C corporation"
    },
    {
     "id": 688072,
     "content_html": "is usually more difficult to form than a C corporation"
    },
    {
     "id": 688073,
     "content_html": "is not taxed at the corporate level, unlike a C corporation"
    }
