   "stimulus_html": "",
   "stem_html": "If an equally weighted portfolio contains 10 stocks, then _______________.",
   "answers": [
    {
     "id": 690219,
     "content_html": "the stocks in the portfolio will each have a weight of 0.10"
    },
    {
     "id": 690220,
     "content_html": "the return of the portfolio must be multiplied by 10 to get the annualized return"
    },
    {
     "id": 690221,
     "content_html": "the standard deviation of the portfolio will be one-tenth the standard deviation of one of the stocks"
    },
    {
     "id": 690222,
     "content_html": "the standard deviation of the portfolio will be 10 times the standard deviation of one of the stocks"
    }
   ],
