   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is the best example of firm-specific risk?",
   "answers": [
    {
     "id": 690151,
     "content_html": "A global pandemic causes major disruptions in the economy."
    },
    {
     "id": 690152,
     "content_html": "The Federal Reserve increases the money supply dramatically, leading to massive inflation."
    },
    {
     "id": 690153,
     "content_html": "AAA Pharmaceuticals withdraws a medication as it studies whether strokes five people suffered after taking the medication were related to the medication."
    },
    {
     "id": 690154,
     "content_html": "As an arctic blast descends on North America, most of the United States is blanketed in snow or ice."
    }
