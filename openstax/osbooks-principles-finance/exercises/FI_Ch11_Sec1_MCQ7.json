 "questions": [
  {
   "id": 670559,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following statements about enterprise value metrics is NOT true?",
   "answers": [
    {
     "id": 1338923,
     "content_html": "EV to revenue can be used to assess companies with negative cash flows or firms that are currently experiencing financial losses."
    },
    {
     "id": 1338924,
     "content_html": "ROE is a profitability ratio that measures the return on the equity in a company in comparison to its financing over a short period of time."
    },
    {
     "id": 1338925,
     "content_html": "EBIT allows investors to assess the core operations of the business without worrying about the costs of the capital structure."
    },
    {
     "id": 1338926,
     "content_html": "EBITDAR is a metric that is used in businesses that have substantial rental and least expenses."
    }
   ],
