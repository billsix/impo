 "questions": [
  {
   "id": 194775,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "If a company is considering two mutually exclusive projects, which of the following statements is true?",
   "answers": [
    {
     "id": 689913,
     "content_html": "The company must do both projects if it chooses to do one of the projects."
    },
    {
     "id": 689914,
     "content_html": "The IRR method should be used to compare the projects."
    },
    {
     "id": 689915,
     "content_html": "Doing one of the projects means the other project cannot be done."
    },
    {
     "id": 689916,
     "content_html": "The company does not need to compare the projects because it can choose to do both."
    }
   ],
   "hints": [],
