   "id": 194613,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "How is converting financial data to percentages helpful in financial analysis?",
   "answers": [
    {
     "id": 689683,
     "content_html": "It makes the figures easier to calculate."
    },
    {
     "id": 689684,
     "content_html": "It masks actual financial data so the competition can’t see it."
    },
    {
     "id": 689685,
     "content_html": "It saves time."
    },
    {
     "id": 689686,
     "content_html": "It makes comparisons to companies of varying sizes possible."
    }
