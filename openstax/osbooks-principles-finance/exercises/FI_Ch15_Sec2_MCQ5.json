   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following would be the best example of systematic risk?",
   "answers": [
    {
     "id": 690171,
     "content_html": "An error in the company’s computer system miscalculates the amount of inventory that Monique’s Boutique is holding."
    },
    {
     "id": 690172,
     "content_html": "BlueJay Air has a reduction in new reservations following a crash of one of its jets."
    },
    {
     "id": 690173,
     "content_html": "The spokesperson for Serena’s Sports Shoes is involved in an ethical scandal."
    },
    {
     "id": 690174,
     "content_html": "Interest rates rise after the Federal Reserve announces it will slow down the rate of growth of the money supply."
    }
