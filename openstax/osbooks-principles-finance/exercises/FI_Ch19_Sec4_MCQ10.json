 "questions": [
  {
   "id": 198105,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Jackson’s Moonshine LLC has a receivables collection period of 47 days. Which the following would be reasonable conclusions?",
   "answers": [
    {
     "id": 691745,
     "content_html": "Jackson’s Moonshine LLC is most likely experiencing serious liquidity issues."
    },
    {
     "id": 691746,
     "content_html": "Jackson’s Moonshine LLC is most overinvested in marketable securities."
    },
    {
     "id": 691747,
     "content_html": "If the industry average is 31 days, Jackson’s management should attempt strategies that will lower their receivables collection period."
    },
    {
     "id": 691748,
     "content_html": "If the industry average is 53 days, Jackson’s management should attempt strategies that will raise their receivables collection period."
    }
   ],
