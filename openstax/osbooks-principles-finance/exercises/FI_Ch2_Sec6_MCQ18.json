 "questions": [
  {
   "id": 190630,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "International firms are _______________.",
   "answers": [
    {
     "id": 688054,
     "content_html": "headquartered in a non-US country but have homogeneous profit centers with little differentiation in product or service"
    },
    {
     "id": 688055,
     "content_html": "based in the United States but operate through the use of heavy investments outside the country via multinational profit centers"
    },
    {
     "id": 688056,
     "content_html": "larger and more complex than their domestic counterparts"
    },
    {
     "id": 688057,
     "content_html": "more likely to be formed as partnerships or sole proprietorships than as corporations"
    }
   ],
