 "questions": [
  {
   "id": 198107,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Two Way Power Ltd. (2WP) stocks an inventory item, BB3, that is projected to be in great demand over the next 12 months. In discussing its sales forecasts with its suppliers, a reasonable estimate shows that 2WP could lose about $30,000 of sales in month 3 due to inventory financing difficulties. Which, if any, of the following inventory costs would be affected by this development?",
   "answers": [
    {
     "id": 691754,
     "content_html": "purchase cost"
    },
    {
     "id": 691755,
     "content_html": "carrying costs"
    },
    {
     "id": 691756,
     "content_html": "ordering costs"
    },
    {
     "id": 691757,
     "content_html": "stockout costs"
    },
    {
     "id": 691758,
     "content_html": "none of these costs because loss of sales is not an inventory cost"
    }
   ],
