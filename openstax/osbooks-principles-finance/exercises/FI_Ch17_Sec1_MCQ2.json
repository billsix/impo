 "questions": [
  {
   "id": 197414,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "The capital structure of a company refers to ________.",
   "answers": [
    {
     "id": 691169,
     "content_html": "whether the company purchases assets or liabilities with its equity"
    },
    {
     "id": 691170,
     "content_html": "the proportion of debt and equity the company uses in financing is assets"
    },
    {
     "id": 691171,
     "content_html": "the ability of the company to use its assets to generate equity for the owners"
    },
    {
     "id": 691172,
     "content_html": "whether the company uses short-term assets or long-term assets to create its product"
    }
   ],
