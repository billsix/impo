   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In an organization with each of these financial positions, which title is most likely to be associated with a job description that is less of a “hands-on” manager and that engages more in visionary and strategic planning?",
   "answers": [
    {
     "id": 687729,
     "content_html": "comptroller (or controller)"
    },
    {
     "id": 687730,
     "content_html": "treasurer"
    },
    {
     "id": 687731,
     "content_html": "vice president of finance"
    },
    {
     "id": 687732,
     "content_html": "chief financial officer (CFO)"
    }
