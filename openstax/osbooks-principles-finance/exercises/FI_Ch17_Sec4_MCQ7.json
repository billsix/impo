   "id": 197425,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "<i>Unlevered equity</i> refers to ________.",
   "answers": [
    {
     "id": 691213,
     "content_html": "the equity in a firm with no debt"
    },
    {
     "id": 691214,
     "content_html": "a firm’s equity minus the firm’s debt"
    },
    {
     "id": 691215,
     "content_html": "the equity in a firm in the absence of taxation and transaction costs"
    },
    {
     "id": 691216,
     "content_html": "the portion of a firm’s capital structure that is financed by its owners"
    }
   ],
