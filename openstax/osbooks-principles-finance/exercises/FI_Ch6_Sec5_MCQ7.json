 "questions": [
  {
   "id": 197248,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Most analysts believe which of the following is true about earnings per share?",
   "answers": [
    {
     "id": 690994,
     "content_html": "Consistent improvement in earnings per share year after year is an indication of continuous improvement in the company’s earning power."
    },
    {
     "id": 690995,
     "content_html": "Consistent improvement in earnings per share year after year is an indication of continuous decline in the company’s earning power."
    },
    {
     "id": 690996,
     "content_html": "Consistent improvement in earnings per share year after year is an indication of fraud within the company."
    },
    {
     "id": 690997,
     "content_html": "Consistent improvement in earnings per share year after year is an indication that the company will never suffer a year of net loss rather than net income."
    }
   ],
