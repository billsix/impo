   "stimulus_html": "",
   "stem_html": "The term efficient markets refers to the idea that _______________.",
   "answers": [
    {
     "id": 691433,
     "content_html": "publicly traded companies always file their financial reports on time"
    },
    {
     "id": 691434,
     "content_html": "investors are able to identify underpriced stocks for purchase"
    },
    {
     "id": 691435,
     "content_html": "stocks trade with minimal costs and prices are current and fair to all traders"
    },
    {
     "id": 691436,
     "content_html": "financial information on companies and their stock is only available to efficient traders"
    }
   ],
