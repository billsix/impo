 "questions": [
  {
   "id": 197432,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "As a company increases the weight of debt in its capital structure, ________.",
   "answers": [
    {
     "id": 691241,
     "content_html": "its cost of debt capital falls"
    },
    {
     "id": 691242,
     "content_html": "the weight of equity capital also increases"
    },
    {
     "id": 691243,
     "content_html": "the value of the interest tax shield decreases"
    },
    {
     "id": 691244,
     "content_html": "its possibility of financial distress increases"
    }
   ],
