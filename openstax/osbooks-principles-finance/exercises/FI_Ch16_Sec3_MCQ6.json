 "questions": [
  {
   "id": 194765,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "The IRR method assumes that ________.",
   "answers": [
    {
     "id": 689873,
     "content_html": "cash flows are reinvested at the firm’s cost of attracting funds when they are received"
    },
    {
     "id": 689874,
     "content_html": "cash flows of a project are never reinvested"
    },
    {
     "id": 689875,
     "content_html": "cash flows are reinvested at the internal rate of return when they are received"
    },
    {
     "id": 689876,
     "content_html": "the NPV of a project is negative"
    }
   ],
