   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "“An effective business leader will recognize the social and environmental responsibilities of their business as well as the eventual goal of achieving long-term, sustainable global development.” This statement refers to _______________.",
   "answers": [
    {
     "id": 688022,
     "content_html": "employing an experienced environmental consulting firm"
    },
    {
     "id": 688023,
     "content_html": "the advantages of having an audit committee"
    },
    {
     "id": 688024,
     "content_html": "having a diversified and well-experienced board of directors"
    },
    {
     "id": 688025,
     "content_html": "practicing strong corporate governance"
    }
   ],
