 "questions": [
  {
   "id": 198248,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following does a financial manager want to do to maximize the value of the firm?",
   "answers": [
    {
     "id": 691917,
     "content_html": "Decrease the speed of money coming into the firm"
    },
    {
     "id": 691918,
     "content_html": "Speed up cash going out and slow down cash coming in"
    },
    {
     "id": 691919,
     "content_html": "Decrease the riskiness of cash inflows and cash outflows"
    },
    {
     "id": 691920,
     "content_html": "Increase the volatility and speed of cash going out of the firm"
    }
   ],
