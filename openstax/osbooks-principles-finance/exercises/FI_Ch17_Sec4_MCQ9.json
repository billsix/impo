   "stem_html": "The interest tax shield occurs because ________.",
   "answers": [
    {
     "id": 691233,
     "content_html": "interest payments are a tax-deductible expense"
    },
    {
     "id": 691234,
     "content_html": "interest payments are made from after-tax income"
    },
    {
     "id": 691235,
     "content_html": "investors require a lower rate of return the higher the company’s tax rate"
    },
    {
