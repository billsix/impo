   "stem_html": "An account receivable is created when ________.",
   "answers": [
    {
     "id": 691733,
     "content_html": "a customer pays its bill"
    },
    {
     "id": 691734,
     "content_html": "a company accepts a credit card, such as VISA or MasterCard"
    },
    {
     "id": 691735,
     "content_html": "a company sells to a customer on an open account"
    },
    {
