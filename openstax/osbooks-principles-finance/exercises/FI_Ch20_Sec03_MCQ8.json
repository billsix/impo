   "stimulus_html": "",
   "stem_html": "The three main categories of foreign exchange risk a company faces are ________.",
   "answers": [
    {
     "id": 691973,
     "content_html": "economic risk, business risk, and exposure risk"
    },
    {
     "id": 691974,
     "content_html": "exposure risk, fluctuation risk, and forward risk"
    },
    {
     "id": 691975,
     "content_html": "transaction risk, translation risk, and economic risk"
    },
    {
     "id": 691976,
     "content_html": "appreciation risk, depreciation risk, and duplication risk"
    }
