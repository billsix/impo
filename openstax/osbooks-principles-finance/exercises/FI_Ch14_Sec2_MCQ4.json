  {
   "id": 180781,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A linear model is developed for the relationship between salary of finance professionals and years of experience. The data was collected based on years of experience ranging from 1 to 15. Assuming the correlation is significant, should the linear model be used to predict the salary for a person with 25 years of experience?",
   "answers": [
    {
     "id": 675224,
     "content_html": "It is acceptable to predict the salary for a person with 25 years of experience."
    },
    {
     "id": 675225,
     "content_html": "A linear model cannot be created for these two variables."
    },
    {
     "id": 675226,
     "content_html": "It is not recommended to predict the salary for a person with 25 years of experience."
    },
    {
     "id": 675227,
     "content_html": "There is not enough information to determine the answer."
    }
   ],
