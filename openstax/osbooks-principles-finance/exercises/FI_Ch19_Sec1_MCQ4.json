 "questions": [
  {
   "id": 198080,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a goal of working capital management?",
   "answers": [
    {
     "id": 691701,
     "content_html": "meet the operational needs of the company"
    },
    {
     "id": 691702,
     "content_html": "satisfy obligations (current liabilities) as they come due"
    },
    {
     "id": 691703,
     "content_html": "maintain an optimal level of current assets"
    },
    {
     "id": 691704,
     "content_html": "maximize the investment in current assets"
    }
   ],
