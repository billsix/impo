 "questions": [
  {
   "id": 197738,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "In which of the following ways does preferred stock differ from common stock?",
   "answers": [
    {
     "id": 691465,
     "content_html": "Preferred stock carries voting rights for its ownership."
    },
    {
     "id": 691466,
     "content_html": "Preferred stock must be purchased through a broker dealer."
    },
    {
     "id": 691467,
     "content_html": "Preferred stock may have a cumulative dividend feature."
    },
    {
     "id": 691468,
     "content_html": "In the event of corporate liquidation, preferred stockholders are paid last. "
    }
   ],
