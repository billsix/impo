  {
   "id": 197157,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is the best definition of a <i>z</i>-score?",
   "answers": [
    {
     "id": 690706,
     "content_html": "the distance of a data value from the mean"
    },
    {
     "id": 690707,
     "content_html": "the number of standard deviations that a data value is from the mean"
    },
    {
     "id": 690708,
     "content_html": "the distance of a data value from the mean divided by the sample size"
    },
    {
     "id": 690709,
     "content_html": "the number of quartiles that a data value is from the mean "
    }
   ],
