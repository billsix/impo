   "id": 180938,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "A linear regression model is developed, and for <span data-math=\"x = 10\"></span>, the corresponding predicted <i>y</i>-value is 22.7. The actual observed value for <span data-math=\"x = 10\"></span> is <span data-math=\"y = 31.3\"></span>. Is the residual for this data point positive, negative, or zero?",
   "answers": [
    {
     "id": 675292,
     "content_html": "positive"
    },
    {
     "id": 675293,
     "content_html": "negative"
    },
    {
     "id": 675294,
     "content_html": "zero"
    },
    {
     "id": 675295,
     "content_html": "not enough information to determine"
    }
   ],
