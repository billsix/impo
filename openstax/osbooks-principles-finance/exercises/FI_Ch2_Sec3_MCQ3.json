 "questions": [
  {
   "id": 191905,
   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Which of the following is NOT a reason why a company needs good corporate governance?",
   "answers": [
    {
     "id": 689142,
     "content_html": "to avoid mismanagement of the company"
    },
    {
     "id": 689143,
     "content_html": "to enable the company to raise capital more efficiently and mitigate financial and operational risk to stakeholders"
    },
    {
     "id": 689144,
     "content_html": "to analyze the company’s operations and systems of internal control in order to detect and prevent various forms of fraud and other accounting irregularities"
    },
    {
     "id": 689145,
     "content_html": "to increase the company’s overall accountability and prevent significant organizational problems"
    }
   ],
