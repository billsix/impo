   "is_answer_order_important": true,
   "stimulus_html": "",
   "stem_html": "Determining bond prices often involves using which two TVM (time value of money) equations?",
   "answers": [
    {
     "id": 690099,
     "content_html": "The future value of a lump sum and the present value of a lump sum"
    },
    {
     "id": 690100,
     "content_html": "The present value of an annuity and the future value of a lump sum"
    },
    {
     "id": 690101,
     "content_html": "The future value of an annuity and the present value of a lump sum"
    },
    {
     "id": 690102,
     "content_html": "None of the above"
    }
