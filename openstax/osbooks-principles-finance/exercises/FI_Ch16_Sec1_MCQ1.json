 "questions": [
  {
   "id": 194757,
   "is_answer_order_important": false,
   "stimulus_html": "",
   "stem_html": "Which of the following is a disadvantage of using the payback method?",
   "answers": [
    {
     "id": 689841,
     "content_html": "It only considers cash flows that occur after the project breaks even."
    },
    {
     "id": 689842,
     "content_html": "It ignores the time value of money."
    },
    {
     "id": 689843,
     "content_html": "It is difficult to calculate."
    },
    {
     "id": 689844,
     "content_html": "You must know the company’s cost of raising funds to be able to use it."
    }
   ],
